<%# Geographic Analysis - Department and Commune Breakdown %>
<%# Unified Law Enforcement Styling %>

<div class="container-fluid py-4">
  <%# Header with gradient %>
  <div class="card border-0 analytics-header mb-4">
    <div class="card-body py-4">
      <div class="d-flex align-items-center">
        <%= link_to officers_analytics_path, class: "btn btn-sm analytics-back-btn me-3" do %>
          <i class="ri-arrow-left-line"></i>
        <% end %>
        <div class="text-white">
          <h2 class="mb-1 analytics-header-title"><i class="ri-earth-line me-2"></i>Geographic Analysis</h2>
          <p class="mb-0 analytics-header-subtitle">Crime distribution by department and commune with period comparison</p>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <%# Period Comparison %>
    <div class="col-12">
      <div class="card analytics-chart-card">
        <div class="card-header">
          <h5><i class="ri-exchange-line me-2 text-law-blue"></i>Period Comparison</h5>
        </div>
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-md-4 text-center">
              <div class="small text-muted mb-1">Previous Period</div>
              <div class="fs-1 fw-bold text-secondary"><%= @period_comparison[:previous] %></div>
              <div class="small text-muted">
                <%= @period_comparison[:current_period]&.dig(:start)&.strftime("%b %d") rescue "N/A" %> -
                <%= @period_comparison[:current_period]&.dig(:end)&.strftime("%b %d") rescue "N/A" %>
              </div>
            </div>
            <div class="col-md-4 text-center">
              <%
                trend_icon = case @period_comparison[:trend]
                             when "up" then "ri-arrow-up-line text-law-red"
                             when "down" then "ri-arrow-down-line text-law-green"
                             else "ri-subtract-line text-secondary"
                             end
                trend_color = case @period_comparison[:trend]
                              when "up" then "law-red"
                              when "down" then "law-green"
                              else "secondary"
                              end
              %>
              <div class="display-4">
                <i class="<%= trend_icon %>"></i>
              </div>
              <div class="fs-4 fw-bold text-<%= trend_color %>">
                <%= @period_comparison[:change_pct] >= 0 ? '+' : '' %><%= @period_comparison[:change_pct] %>%
              </div>
              <div class="small text-muted">Change</div>
            </div>
            <div class="col-md-4 text-center">
              <div class="small text-muted mb-1">Current Period</div>
              <div class="fs-1 fw-bold text-law-blue"><%= @period_comparison[:current] %></div>
              <div class="small text-muted">Selected range</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%# Department Breakdown %>
    <div class="col-lg-6">
      <div class="card analytics-chart-card h-100">
        <div class="card-header">
          <h5><i class="ri-building-2-line me-2 text-law-blue"></i>By Department</h5>
        </div>
        <div class="card-body">
          <% if @department_data.any? %>
            <div class="chart-container" style="height: 300px;">
              <canvas id="departmentChart"></canvas>
            </div>
            <div class="mt-3">
              <% max = @department_data.first[:count] rescue 1 %>
              <% @department_data.first(8).each do |dept| %>
                <div class="mb-2">
                  <div class="d-flex justify-content-between mb-1">
                    <span class="small fw-semibold"><%= dept[:name] %></span>
                    <span class="small"><%= dept[:count] %></span>
                  </div>
                  <div class="progress" style="height: 8px;">
                    <div class="progress-bar bg-law-blue" style="width: <%= (dept[:count].to_f / max * 100).round %>%"></div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="analytics-empty-state">
              <i class="ri-building-2-line"></i>
              <p>No department data</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Top Communes %>
    <div class="col-lg-6">
      <div class="card analytics-chart-card h-100">
        <div class="card-header">
          <h5><i class="ri-map-pin-2-line me-2 text-law-red"></i>Top Communes</h5>
        </div>
        <div class="card-body p-0">
          <% if @commune_data.any? %>
            <div class="table-responsive">
              <table class="table analytics-table mb-0">
                <thead>
                  <tr>
                    <th class="ps-3">#</th>
                    <th>Commune</th>
                    <th class="text-end pe-3">Reports</th>
                  </tr>
                </thead>
                <tbody>
                  <% @commune_data.each_with_index do |(commune, count), idx| %>
                    <%
                      badge_color = case idx
                                    when 0 then "law-red"
                                    when 1..2 then "law-tan"
                                    when 3..5 then "law-blue"
                                    else "secondary"
                                    end
                    %>
                    <tr>
                      <td class="ps-3">
                        <span class="badge bg-<%= badge_color %>"><%= idx + 1 %></span>
                      </td>
                      <td><%= commune %></td>
                      <td class="text-end pe-3"><strong><%= count %></strong></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="analytics-empty-state">
              <i class="ri-map-pin-2-line"></i>
              <p>No commune data</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Key Insights %>
    <div class="col-12">
      <div class="card analytics-chart-card" style="background: var(--law-gray-light, #F8F8F8);">
        <div class="card-body">
          <h6 class="mb-3"><i class="ri-focus-3-line me-2 text-law-blue"></i>Resource Allocation Insights</h6>
          <div class="row g-3">
            <div class="col-md-4">
              <div class="analytics-insight-card">
                <div class="d-flex align-items-center">
                  <div class="insight-icon me-3" style="background: var(--law-red-10, rgba(217, 7, 24, 0.1));">
                    <i class="ri-map-pin-line text-law-red fs-4"></i>
                  </div>
                  <div>
                    <div class="insight-value text-law-red" style="font-size: 1rem;"><%= @commune_data.first&.first || "N/A" %></div>
                    <div class="small text-muted">Highest Crime Commune</div>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="analytics-insight-card">
                <div class="d-flex align-items-center">
                  <div class="insight-icon me-3" style="background: var(--law-tan-10, rgba(191, 131, 96, 0.1));">
                    <i class="ri-building-line text-law-tan fs-4"></i>
                  </div>
                  <div>
                    <div class="insight-value text-law-tan" style="font-size: 1rem;"><%= @department_data.first&.dig(:name) || "N/A" %></div>
                    <div class="small text-muted">Highest Crime Department</div>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="analytics-insight-card">
                <div class="d-flex align-items-center">
                  <div class="insight-icon me-3" style="background: var(--law-green-10, rgba(73, 166, 79, 0.1));">
                    <i class="ri-team-line text-law-green fs-4"></i>
                  </div>
                  <div>
                    <div class="insight-value text-law-green"><%= @department_data.count %></div>
                    <div class="small text-muted">Departments with Reports</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Law enforcement color palette
  const lawColors = {
    blue: '#092C73',
    blueLight: '#0A3A9E',
    red: '#D90718',
    green: '#49A64F',
    tan: '#BF8360'
  };

  const deptData = <%= raw @department_data.to_json %>;
  if (deptData.length > 0) {
    new Chart(document.getElementById('departmentChart'), {
      type: 'bar',
      data: {
        labels: deptData.map(d => d.name),
        datasets: [{
          data: deptData.map(d => d.count),
          backgroundColor: lawColors.blue
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        indexAxis: 'y',
        plugins: { legend: { display: false } },
        scales: { x: { beginAtZero: true } }
      }
    });
  }
});
</script>
