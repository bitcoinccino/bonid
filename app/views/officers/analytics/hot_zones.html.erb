<%# Hot Zone Analysis - Crime Location Heat Map %>
<%# Unified Law Enforcement Styling %>

<div class="container-fluid py-4">
  <%# Header with gradient %>
  <div class="card border-0 analytics-header mb-4">
    <div class="card-body py-4">
      <div class="d-flex align-items-center">
        <%= link_to officers_analytics_path, class: "btn btn-sm analytics-back-btn me-3" do %>
          <i class="ri-arrow-left-line"></i>
        <% end %>
        <div class="text-white">
          <h2 class="mb-1 analytics-header-title"><i class="ri-map-pin-line me-2"></i>Hot Zone Analysis</h2>
          <p class="mb-0 analytics-header-subtitle">Crime concentration by location - identify high-risk areas</p>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <%# Map Placeholder %>
    <div class="col-lg-8">
      <div class="card analytics-chart-card">
        <div class="card-header">
          <h5><i class="ri-fire-line me-2 text-law-red"></i>Crime Heat Map</h5>
        </div>
        <div class="card-body">
          <div id="heatMap" class="d-flex align-items-center justify-content-center rounded" style="height: 400px; background: var(--law-gray-light, #F8F8F8);">
            <div class="analytics-empty-state">
              <i class="ri-map-2-line"></i>
              <p>Interactive map coming soon</p>
              <small class="text-muted">Requires Leaflet.js or Mapbox integration</small>
            </div>
          </div>
          <div class="mt-3">
            <div class="d-flex justify-content-center gap-4">
              <span><span class="badge bg-law-green">&nbsp;&nbsp;</span> Low (1-5)</span>
              <span><span class="badge bg-warning">&nbsp;&nbsp;</span> Medium (6-15)</span>
              <span><span class="badge bg-law-red">&nbsp;&nbsp;</span> High (16+)</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%# Top Hot Zones List %>
    <div class="col-lg-4">
      <div class="card analytics-chart-card h-100">
        <div class="card-header">
          <h5><i class="ri-alert-line me-2 text-law-red"></i>Top Hot Zones</h5>
        </div>
        <div class="card-body p-0">
          <% if @zone_data.any? %>
            <div class="list-group list-group-flush">
              <% @zone_data.sort_by { |z| -z[:count] }.first(10).each_with_index do |zone, idx| %>
                <%
                  severity_class = case zone[:count]
                                   when 0..5 then "law-green"
                                   when 6..15 then "warning"
                                   else "law-red"
                                   end
                %>
                <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                  <div>
                    <span class="badge bg-<%= severity_class %> me-2"><%= idx + 1 %></span>
                    <strong><%= zone[:commune_name] %></strong>
                    <div class="small text-muted"><%= zone[:department] %></div>
                  </div>
                  <div class="text-end">
                    <span class="fs-5 fw-bold text-<%= severity_class %>"><%= zone[:count] %></span>
                    <div class="small text-muted">reports</div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="analytics-empty-state">
              <i class="ri-map-pin-line"></i>
              <p>No location data available</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Department Breakdown %>
    <div class="col-lg-6">
      <div class="card analytics-chart-card">
        <div class="card-header">
          <h5><i class="ri-building-line me-2 text-law-blue"></i>By Department</h5>
        </div>
        <div class="card-body">
          <% if @department_breakdown.any? %>
            <% max_count = @department_breakdown.first&.last || 1 %>
            <% @department_breakdown.first(8).each do |dept, count| %>
              <div class="mb-3">
                <div class="d-flex justify-content-between mb-1">
                  <span class="small fw-semibold"><%= dept %></span>
                  <span class="small text-muted"><%= count %> reports</span>
                </div>
                <div class="progress" style="height: 8px;">
                  <div class="progress-bar bg-law-blue" style="width: <%= (count.to_f / max_count * 100).round %>%"></div>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="analytics-empty-state py-4">
              <i class="ri-building-line"></i>
              <p>No department data</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Zone Statistics %>
    <div class="col-lg-6">
      <div class="card analytics-chart-card">
        <div class="card-header">
          <h5><i class="ri-bar-chart-box-line me-2 text-law-tan"></i>Zone Statistics</h5>
        </div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-6">
              <div class="analytics-insight-card text-center">
                <div class="insight-value text-law-blue"><%= @zone_data.count %></div>
                <div class="insight-title">Active Zones</div>
              </div>
            </div>
            <div class="col-6">
              <div class="analytics-insight-card text-center">
                <div class="insight-value text-law-red"><%= @zone_data.sum { |z| z[:count] } %></div>
                <div class="insight-title">Total Reports</div>
              </div>
            </div>
            <div class="col-6">
              <div class="analytics-insight-card text-center">
                <% high_risk = @zone_data.count { |z| z[:count] > 15 } %>
                <div class="insight-value text-law-red"><%= high_risk %></div>
                <div class="insight-title">High-Risk Zones</div>
              </div>
            </div>
            <div class="col-6">
              <div class="analytics-insight-card text-center">
                <% avg = @zone_data.any? ? (@zone_data.sum { |z| z[:count] }.to_f / @zone_data.count).round(1) : 0 %>
                <div class="insight-value text-law-tan"><%= avg %></div>
                <div class="insight-title">Avg per Zone</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
