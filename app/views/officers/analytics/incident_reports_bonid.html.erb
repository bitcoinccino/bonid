<%# Incident Reports - BonID (Citizens) Analytics %>
<%# Unified Law Enforcement Styling with Rich Charts %>

<div class="container-fluid py-4">
  <%# Header with gradient %>
  <div class="card border-0 analytics-header mb-4">
    <div class="card-body py-4">
      <div class="d-flex align-items-center">
        <%= link_to officers_analytics_path, class: "btn btn-sm analytics-back-btn me-3" do %>
          <i class="ri-arrow-left-line"></i>
        <% end %>
        <div class="text-white">
          <h2 class="mb-1 analytics-header-title"><i class="ri-id-card-line me-2"></i>BonID Incident Reports</h2>
          <p class="mb-0 analytics-header-subtitle">Reports involving Haitian citizens (BonID holders)</p>
        </div>
      </div>
    </div>
  </div>

  <%# Summary Stats %>
  <div class="row g-4 mb-4">
    <div class="col-md-3">
      <div class="card analytics-stat-card h-100">
        <div class="card-body text-center py-3">
          <div class="stat-icon stat-icon-blue mx-auto mb-2">
            <i class="ri-file-list-3-line fs-4 text-law-blue"></i>
          </div>
          <div class="stat-value text-law-blue"><%= @total_count %></div>
          <div class="stat-label">Total Reports</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card analytics-stat-card h-100">
        <div class="card-body text-center py-3">
          <div class="stat-icon stat-icon-green mx-auto mb-2">
            <i class="ri-checkbox-circle-line fs-4 text-law-green"></i>
          </div>
          <div class="stat-value text-law-green"><%= @by_status["approved"] || 0 %></div>
          <div class="stat-label">Approved</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card analytics-stat-card h-100">
        <div class="card-body text-center py-3">
          <div class="stat-icon stat-icon-tan mx-auto mb-2">
            <i class="ri-time-line fs-4" style="color: var(--law-tan);"></i>
          </div>
          <div class="stat-value" style="color: var(--law-tan);"><%= @by_status["submitted"] || 0 %></div>
          <div class="stat-label">Pending</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card analytics-stat-card h-100">
        <div class="card-body text-center py-3">
          <div class="stat-icon stat-icon-red mx-auto mb-2">
            <i class="ri-close-circle-line fs-4 text-law-red"></i>
          </div>
          <div class="stat-value text-law-red"><%= @by_status["rejected"] || 0 %></div>
          <div class="stat-label">Rejected</div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <%# Status Distribution Doughnut %>
    <div class="col-lg-4">
      <div class="card analytics-chart-card h-100">
        <div class="card-header">
          <h5><i class="ri-donut-chart-line me-2 text-law-blue"></i>Status Distribution</h5>
        </div>
        <div class="card-body">
          <% if @by_status.any? %>
            <div class="chart-container" style="height: 220px;">
              <canvas id="statusChart"></canvas>
            </div>
            <div class="mt-3">
              <% status_colors = { "approved" => "law-green", "submitted" => "warning", "rejected" => "law-red", "draft" => "secondary" } %>
              <% @by_status.each do |status, count| %>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="badge bg-<%= status_colors[status] || 'secondary' %>"><%= status&.titleize %></span>
                  <strong><%= count %></strong>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="analytics-empty-state py-4">
              <i class="ri-donut-chart-line"></i>
              <p>No status data available</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Crime Type Doughnut Chart %>
    <div class="col-lg-4">
      <div class="card analytics-chart-card h-100">
        <div class="card-header">
          <h5><i class="ri-pie-chart-line me-2 text-law-red"></i>By Crime Type</h5>
        </div>
        <div class="card-body">
          <% if @by_crime_type.any? %>
            <div class="chart-container" style="height: 220px;">
              <canvas id="crimeTypeChart"></canvas>
            </div>
            <div class="mt-3">
              <% @by_crime_type.first(5).each do |crime, count| %>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="small fw-semibold text-truncate" style="max-width: 150px;"><%= crime.to_s.titleize %></span>
                  <strong><%= count %></strong>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="analytics-empty-state py-4">
              <i class="ri-pie-chart-line"></i>
              <p>No crime data available</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Severity Distribution %>
    <div class="col-lg-4">
      <div class="card analytics-chart-card h-100">
        <div class="card-header">
          <h5><i class="ri-alert-line me-2 text-law-tan"></i>By Severity</h5>
        </div>
        <div class="card-body">
          <% if @by_severity&.any? %>
            <div class="chart-container" style="height: 220px;">
              <canvas id="severityChart"></canvas>
            </div>
            <div class="mt-3">
              <% severity_colors = { "Low" => "law-green", "Medium" => "law-blue", "High" => "warning", "Severe" => "law-red", "Critical" => "dark" } %>
              <% @by_severity.each do |level, count| %>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="badge bg-<%= severity_colors[level] || 'secondary' %>"><%= level %></span>
                  <strong><%= count %></strong>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="analytics-empty-state py-4">
              <i class="ri-alert-line"></i>
              <p>No severity data available</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Monthly Trend Line Chart %>
    <div class="col-lg-8">
      <div class="card analytics-chart-card h-100">
        <div class="card-header">
          <h5><i class="ri-line-chart-line me-2 text-law-blue"></i>Monthly Trend</h5>
        </div>
        <div class="card-body">
          <% if @monthly_trend.any? %>
            <div class="chart-container" style="height: 280px;">
              <canvas id="monthlyTrendChart"></canvas>
            </div>
          <% else %>
            <div class="analytics-empty-state py-4">
              <i class="ri-line-chart-line"></i>
              <p>No trend data available</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Top Crime Types Bar Chart %>
    <div class="col-lg-4">
      <div class="card analytics-chart-card h-100">
        <div class="card-header">
          <h5><i class="ri-bar-chart-horizontal-line me-2 text-law-green"></i>Top Crimes</h5>
        </div>
        <div class="card-body">
          <% if @by_crime_type.any? %>
            <div class="chart-container" style="height: 280px;">
              <canvas id="topCrimesChart"></canvas>
            </div>
          <% else %>
            <div class="analytics-empty-state py-4">
              <i class="ri-bar-chart-horizontal-line"></i>
              <p>No crime data available</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Recent Reports List %>
    <div class="col-12">
      <div class="card analytics-chart-card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5><i class="ri-file-list-3-line me-2 text-law-blue"></i>Recent Reports</h5>
          <%= link_to officers_incident_reports_path, class: "btn btn-sm", style: "background: var(--law-green); color: white;" do %>
            View All <i class="ri-arrow-right-s-line"></i>
          <% end %>
        </div>
        <div class="card-body p-0">
          <% if @reports.any? %>
            <div class="table-responsive">
              <table class="table table-hover analytics-table mb-0">
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Crime Type</th>
                    <th>Severity</th>
                    <th>Citizen</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% @reports.limit(10).each do |report| %>
                    <% citizen = report.person_involvements.find { |pi| pi.user_id.present? } %>
                    <tr>
                      <td><%= report.occurred_at&.strftime("%b %d, %Y") %></td>
                      <td><%= report.crime_type&.titleize %></td>
                      <td>
                        <% severity_badge = case report.crime_severity_level
                           when 1 then ["Low", "bg-success"]
                           when 2 then ["Medium", "bg-primary"]
                           when 3 then ["High", "bg-warning text-dark"]
                           when 4 then ["Severe", "bg-danger"]
                           when 5 then ["Critical", "bg-dark"]
                           else ["N/A", "bg-secondary"]
                           end %>
                        <span class="badge <%= severity_badge[1] %>"><%= severity_badge[0] %></span>
                      </td>
                      <td>
                        <% if citizen %>
                          <i class="ri-id-card-line me-1 text-law-blue"></i>
                          <%= citizen.name || citizen.user&.full_name %>
                        <% else %>
                          <span class="text-muted">-</span>
                        <% end %>
                      </td>
                      <td>
                        <% status_class = case report.status
                           when "approved" then "bg-success"
                           when "submitted" then "bg-warning text-dark"
                           when "rejected" then "bg-danger"
                           else "bg-secondary"
                           end %>
                        <span class="badge <%= status_class %>"><%= report.status&.titleize %></span>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="analytics-empty-state py-4">
              <i class="ri-file-list-3-line"></i>
              <p>No reports involving citizens found</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Law enforcement color palette
  const lawColors = {
    blue: '#092C73',
    red: '#D90718',
    green: '#49A64F',
    tan: '#BF8360',
    dark: '#111827'
  };

  const chartColors = [
    lawColors.blue,
    lawColors.green,
    lawColors.red,
    lawColors.tan,
    lawColors.dark,
    '#6366F1',
    '#EC4899',
    '#14B8A6',
    '#F59E0B',
    '#8B5CF6'
  ];

  // Status Distribution Doughnut Chart
  <% if @by_status.any? %>
  const statusData = <%= raw @by_status.to_json %>;
  const statusColors = {
    'approved': lawColors.green,
    'submitted': '#F59E0B',
    'rejected': lawColors.red,
    'draft': '#6B7280'
  };
  new Chart(document.getElementById('statusChart'), {
    type: 'doughnut',
    data: {
      labels: Object.keys(statusData).map(s => s.charAt(0).toUpperCase() + s.slice(1)),
      datasets: [{
        data: Object.values(statusData),
        backgroundColor: Object.keys(statusData).map(k => statusColors[k] || '#6B7280'),
        borderWidth: 0
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      cutout: '60%',
      plugins: {
        legend: { display: false }
      }
    }
  });
  <% end %>

  // Crime Type Doughnut Chart
  <% if @by_crime_type.any? %>
  const crimeTypeData = <%= raw @by_crime_type.first(8).to_json %>;
  new Chart(document.getElementById('crimeTypeChart'), {
    type: 'doughnut',
    data: {
      labels: Object.keys(crimeTypeData).map(c => c.split('_').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ')),
      datasets: [{
        data: Object.values(crimeTypeData),
        backgroundColor: chartColors.slice(0, Object.keys(crimeTypeData).length),
        borderWidth: 0
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      cutout: '60%',
      plugins: {
        legend: { display: false }
      }
    }
  });
  <% end %>

  // Severity Doughnut Chart
  <% if @by_severity&.any? %>
  const severityData = <%= raw @by_severity.to_json %>;
  const severityColors = {
    'Low': lawColors.green,
    'Medium': lawColors.blue,
    'High': '#F59E0B',
    'Severe': lawColors.red,
    'Critical': lawColors.dark
  };
  new Chart(document.getElementById('severityChart'), {
    type: 'doughnut',
    data: {
      labels: Object.keys(severityData),
      datasets: [{
        data: Object.values(severityData),
        backgroundColor: Object.keys(severityData).map(k => severityColors[k] || '#6B7280'),
        borderWidth: 0
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      cutout: '60%',
      plugins: {
        legend: { display: false }
      }
    }
  });
  <% end %>

  // Monthly Trend Line Chart
  <% if @monthly_trend.any? %>
  const trendCtx = document.getElementById('monthlyTrendChart');
  if (trendCtx) {
    new Chart(trendCtx, {
      type: 'line',
      data: {
        labels: <%= raw @monthly_trend.keys.to_json %>,
        datasets: [{
          label: 'Reports',
          data: <%= raw @monthly_trend.values.to_json %>,
          borderColor: lawColors.blue,
          backgroundColor: 'rgba(9, 44, 115, 0.1)',
          tension: 0.4,
          fill: true,
          pointBackgroundColor: lawColors.blue,
          pointBorderColor: '#fff',
          pointBorderWidth: 2,
          pointRadius: 4
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false }
        },
        scales: {
          y: {
            beginAtZero: true,
            grid: { color: 'rgba(0,0,0,0.05)' }
          },
          x: {
            grid: { display: false }
          }
        }
      }
    });
  }
  <% end %>

  // Top Crimes Horizontal Bar Chart
  <% if @by_crime_type.any? %>
  const topCrimesData = <%= raw @by_crime_type.first(7).to_json %>;
  new Chart(document.getElementById('topCrimesChart'), {
    type: 'bar',
    data: {
      labels: Object.keys(topCrimesData).map(c => {
        const words = c.split('_').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
        return words.length > 15 ? words.substring(0, 15) + '...' : words;
      }),
      datasets: [{
        data: Object.values(topCrimesData),
        backgroundColor: chartColors.slice(0, Object.keys(topCrimesData).length),
        borderRadius: 4
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      indexAxis: 'y',
      plugins: {
        legend: { display: false }
      },
      scales: {
        x: {
          beginAtZero: true,
          grid: { color: 'rgba(0,0,0,0.05)' }
        },
        y: {
          grid: { display: false }
        }
      }
    }
  });
  <% end %>
});
</script>
