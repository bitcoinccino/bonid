<%# Demographics Analysis - Gender and Role Breakdown %>
<%# Unified Law Enforcement Styling %>

<div class="container-fluid py-4">
  <%# Header with gradient %>
  <div class="card border-0 analytics-header mb-4">
    <div class="card-body py-4">
      <div class="d-flex align-items-center">
        <%= link_to officers_analytics_path, class: "btn btn-sm analytics-back-btn me-3" do %>
          <i class="ri-arrow-left-line"></i>
        <% end %>
        <div class="text-white">
          <h2 class="mb-1 analytics-header-title"><i class="ri-user-heart-line me-2"></i>Demographics Analysis</h2>
          <p class="mb-0 analytics-header-subtitle">Gender distribution and role breakdown of persons involved</p>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <%# Gender Distribution %>
    <div class="col-lg-6">
      <div class="card analytics-chart-card h-100">
        <div class="card-header">
          <h5><i class="ri-group-line me-2 text-law-blue"></i>Gender Distribution</h5>
        </div>
        <div class="card-body">
          <% if @gender_data.any? %>
            <div class="chart-container" style="height: 250px;">
              <canvas id="genderChart"></canvas>
            </div>
            <div class="mt-3">
              <% total = @gender_data.values.sum %>
              <% @gender_data.each do |gender, count| %>
                <%
                  pct = total > 0 ? (count.to_f / total * 100).round(1) : 0
                  icon = case gender.to_s.downcase
                         when "male" then "ri-men-line"
                         when "female" then "ri-women-line"
                         else "ri-user-line"
                         end
                  color = case gender.to_s.downcase
                          when "male" then "law-blue"
                          when "female" then "law-red"
                          else "secondary"
                          end
                %>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span><i class="<%= icon %> me-2 text-<%= color %>"></i><%= gender&.titleize || "Unknown" %></span>
                  <span><strong><%= count %></strong> (<%= pct %>%)</span>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="analytics-empty-state">
              <i class="ri-user-heart-line"></i>
              <p>No gender data available</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Role Breakdown %>
    <div class="col-lg-6">
      <div class="card analytics-chart-card h-100">
        <div class="card-header">
          <h5><i class="ri-shield-user-line me-2 text-law-tan"></i>Role Breakdown</h5>
        </div>
        <div class="card-body">
          <% if @role_breakdown.any? %>
            <div class="chart-container" style="height: 250px;">
              <canvas id="roleChart"></canvas>
            </div>
            <div class="mt-3">
              <% @role_breakdown.sort_by { |_, v| -v }.each do |role, count| %>
                <%
                  color = case role.to_s.downcase
                          when "suspect" then "law-red"
                          when "victim" then "law-tan"
                          when "witness" then "law-blue"
                          when "accomplice" then "dark"
                          else "secondary"
                          end
                  icon = case role.to_s.downcase
                         when "suspect" then "ri-criminal-line"
                         when "victim" then "ri-heart-pulse-line"
                         when "witness" then "ri-eye-line"
                         when "accomplice" then "ri-user-follow-line"
                         else "ri-user-line"
                         end
                %>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span>
                    <span class="badge bg-<%= color %> me-2"><i class="<%= icon %>"></i></span>
                    <%= role&.titleize || "Unknown" %>
                  </span>
                  <strong><%= count %></strong>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="analytics-empty-state">
              <i class="ri-shield-user-line"></i>
              <p>No role data available</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Insights Panel %>
    <div class="col-12">
      <div class="card analytics-chart-card" style="background: var(--law-gray-light, #F8F8F8);">
        <div class="card-body">
          <h6 class="mb-3"><i class="ri-information-line me-2 text-law-blue"></i>Key Insights</h6>
          <div class="row g-3">
            <% total_persons = @role_breakdown.values.sum rescue 0 %>
            <% suspects = @role_breakdown["suspect"] || 0 %>
            <% victims = @role_breakdown["victim"] || 0 %>
            <div class="col-md-4">
              <div class="analytics-insight-card text-center">
                <div class="insight-value text-law-blue"><%= total_persons %></div>
                <div class="insight-title">Total Persons Involved</div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="analytics-insight-card text-center">
                <div class="insight-value text-law-red"><%= suspects %></div>
                <div class="insight-title">Suspects Identified</div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="analytics-insight-card text-center">
                <div class="insight-value text-law-tan"><%= victims %></div>
                <div class="insight-title">Victims Recorded</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Law enforcement color palette
  const lawColors = {
    blue: '#092C73',
    red: '#D90718',
    green: '#49A64F',
    tan: '#BF8360',
    dark: '#111827'
  };

  // Gender Chart
  const genderData = <%= raw @gender_data.to_json %>;
  if (Object.keys(genderData).length > 0) {
    new Chart(document.getElementById('genderChart'), {
      type: 'pie',
      data: {
        labels: Object.keys(genderData).map(g => g ? g.charAt(0).toUpperCase() + g.slice(1) : 'Unknown'),
        datasets: [{
          data: Object.values(genderData),
          backgroundColor: [lawColors.blue, lawColors.red, '#6B7280']
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { position: 'bottom' } }
      }
    });
  }

  // Role Chart
  const roleData = <%= raw @role_breakdown.to_json %>;
  if (Object.keys(roleData).length > 0) {
    const roleColors = {
      'suspect': lawColors.red,
      'victim': lawColors.tan,
      'witness': lawColors.blue,
      'accomplice': lawColors.dark,
      'informant': lawColors.green
    };
    new Chart(document.getElementById('roleChart'), {
      type: 'bar',
      data: {
        labels: Object.keys(roleData).map(r => r ? r.charAt(0).toUpperCase() + r.slice(1) : 'Unknown'),
        datasets: [{
          data: Object.values(roleData),
          backgroundColor: Object.keys(roleData).map(r => roleColors[r] || '#6B7280')
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        indexAxis: 'y',
        plugins: { legend: { display: false } },
        scales: { x: { beginAtZero: true } }
      }
    });
  }
});
</script>
