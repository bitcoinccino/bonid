<%# app/views/officers/passwords/new.html.erb %>

<div class="officer-form-card">
  <%# Icon %>
  <div class="form-icon">
    <%= image_tag "pnh.png", alt: "PNH" %>
  </div>

  <%# Title %>
  <h1>Reset Password</h1>
  <p class="form-subtitle">
    Enter your email and we'll send you instructions to reset your password.
  </p>

  <%# Form %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, data: { turbo: false } }) do |f| %>
    <div class="mb-4">
      <%= f.label :email, "Email Address", class: "form-label" %>
      <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            placeholder: "officer@example.com",
            class: "form-control" %>
    </div>

    <%= f.submit "Send Reset Instructions", class: "btn-officer-primary" %>
  <% end %>

  <%# Links %>
  <div class="form-divider">
    <span>or</span>
  </div>

  <div class="text-center">
    <%= link_to new_officer_session_path, class: "btn-officer-outline" do %>
      <i class="ri-arrow-left-line me-2"></i> Back to Sign In
    <% end %>
  </div>
</div>
