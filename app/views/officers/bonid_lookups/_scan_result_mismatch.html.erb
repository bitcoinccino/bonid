<%# Officer reported visual mismatch — potential identity fraud alert %>
<div class="card border-0" data-result-type="mismatch" style="border-left: 4px solid var(--law-red) !important;">
  <%# Header %>
  <div class="card-header text-white py-2 border-0" style="background: var(--law-red);">
    <div class="d-flex align-items-center">
      <i class="ri-alarm-warning-line me-2" style="font-size: 1.1rem;"></i>
      <span style="font-family: 'Montserrat', sans-serif; font-weight: 600; font-size: 0.9rem;">
        IDENTITY MISMATCH
      </span>
    </div>
  </div>

  <div class="card-body p-3">
    <%# Alert banner %>
    <div class="d-flex align-items-center gap-2 mb-3 py-2 px-3 rounded" style="background: rgba(217, 7, 24, 0.06); font-size: 0.85rem;">
      <i class="ri-error-warning-line" style="color: var(--law-red); font-size: 1.1rem;"></i>
      <span style="color: var(--dark-gray);">
        <strong>Photo does not match.</strong> This incident has been logged for review.
      </span>
    </div>

    <%# Suspect identity card — greyed out to signal mismatch %>
    <div class="d-flex align-items-start gap-3 mb-3 p-3 rounded" style="background: #f8f9fa; opacity: 0.85;">
      <%# Greyed photo %>
      <div class="flex-shrink-0 text-center">
        <% if user.photo.attached? %>
          <%= image_tag user.photo.variant(resize_to_limit: [100, 100]),
                        class: "rounded border border-3",
                        style: "width: 80px; height: 96px; object-fit: cover; border-color: var(--law-red) !important; filter: grayscale(50%);" %>
        <% else %>
          <div class="rounded d-flex align-items-center justify-content-center"
               style="width: 80px; height: 96px; background: var(--law-red-10); border: 3px solid var(--law-red);">
            <i class="ri-user-line" style="font-size: 2rem; color: var(--law-red);"></i>
          </div>
        <% end %>
        <span class="badge bg-danger d-block mt-1" style="font-size: 0.65rem;">
          <i class="ri-close-circle-line me-1"></i>MISMATCH
        </span>
      </div>

      <%# Identity info — struck through %>
      <div class="flex-grow-1">
        <h6 class="mb-1" style="font-family: 'Montserrat', sans-serif; font-weight: 600; font-size: 0.95rem; color: var(--dark-gray); text-decoration: line-through;">
          <%= user.full_name %>
        </h6>
        <code class="d-inline-block px-2 py-1 rounded" style="font-size: 0.75rem; background: var(--law-red-10); color: #721c24;">
          <%= submission.bonid %>
        </code>
      </div>
    </div>

    <%# Recommended actions — numbered steps, not a wall of text %>
    <div class="mb-3 p-3 rounded" style="background: rgba(229, 161, 0, 0.06);">
      <div class="mb-2" style="font-family: 'Montserrat', sans-serif; font-size: 0.8rem; font-weight: 600; color: var(--dark-gray);">
        <i class="ri-shield-check-line me-1" style="color: #E5A100;"></i>Next Steps
      </div>
      <div style="font-size: 0.8rem; color: var(--mid-gray);">
        <div class="d-flex align-items-start gap-2 mb-1">
          <span class="badge rounded-circle bg-secondary flex-shrink-0" style="width: 20px; height: 20px; font-size: 0.65rem; line-height: 20px; padding: 0;">1</span>
          <span>Request additional identification</span>
        </div>
        <div class="d-flex align-items-start gap-2 mb-1">
          <span class="badge rounded-circle bg-secondary flex-shrink-0" style="width: 20px; height: 20px; font-size: 0.65rem; line-height: 20px; padding: 0;">2</span>
          <span>Verify through alternative means</span>
        </div>
        <div class="d-flex align-items-start gap-2 mb-1">
          <span class="badge rounded-circle bg-secondary flex-shrink-0" style="width: 20px; height: 20px; font-size: 0.65rem; line-height: 20px; padding: 0;">3</span>
          <span>File an incident report if fraud is suspected</span>
        </div>
        <div class="d-flex align-items-start gap-2">
          <span class="badge rounded-circle bg-danger flex-shrink-0" style="width: 20px; height: 20px; font-size: 0.65rem; line-height: 20px; padding: 0;">!</span>
          <span><strong>Do not release</strong> without proper verification</span>
        </div>
      </div>
    </div>

    <%# Action Chips %>
    <div class="d-flex gap-2 mb-3">
      <%= link_to new_officers_incident_report_path(suspected_fraud: true),
                  class: "btn flex-grow-1 text-white",
                  style: "background: var(--law-red); font-family: 'Montserrat', sans-serif; font-weight: 500; font-size: 0.85rem;" do %>
        <i class="ri-file-warning-line me-1"></i>File Fraud Report
      <% end %>

      <button type="button" class="btn btn-outline-secondary"
              data-action="click->qr-scanner#rescan"
              style="font-family: 'Montserrat', sans-serif; font-weight: 500; font-size: 0.85rem;">
        <i class="ri-qr-scan-2-line me-1"></i>New Lookup
      </button>
    </div>

    <%# Timestamp %>
    <div class="text-center" style="font-size: 0.7rem; color: var(--mid-gray);">
      <i class="ri-time-line me-1"></i>
      Logged at <%= Time.current.strftime("%H:%M:%S on %b %d, %Y") %>
    </div>
  </div>
</div>
