<%# Suffix lookup result — requires visual confirmation by officer, with criminal record alert state %>
<%= render 'officers/bonid_lookups/photo_modal' %>
<%
  involvements = user.person_involvements.includes(incident_report: :officer).order(created_at: :desc).limit(10)
  has_criminal_history = involvements.any?
  latest_involvement = involvements.first
  latest_crime_type  = latest_involvement&.incident_report&.crime_type&.humanize
  latest_severity    = latest_involvement&.incident_report&.crime_severity_level
  display_name = [user.first_name, user.last_name].compact.join(' ').presence || user.full_name
  verification_status = submission.verified? ? 'Verified' : (submission.status&.humanize || 'Pending')
  expiring_soon = submission.expires_at && submission.expires_at < 30.days.from_now && submission.expires_at > Time.current

  # Detect high-risk statuses for alert state
  high_risk_statuses = %w[wanted fugitive armed dangerous escaped_custody]
  high_risk_involvements = has_criminal_history ? involvements.select { |i|
    high_risk_statuses.include?(i.status) && %w[suspect accomplice].include?(i.role)
  } : []
  is_high_risk = high_risk_involvements.any?
  is_armed     = high_risk_involvements.any? { |i| %w[armed dangerous].include?(i.status) }

  # Dynamic colors — amber for standard pending, red for high-risk
  accent_color    = is_high_risk ? "var(--law-red)" : "#E5A100"
  photo_border    = is_high_risk ? "var(--law-red)" : "var(--law-blue)"
  header_bg       = is_high_risk ? "var(--law-red)" : "#E5A100"
  header_text     = is_high_risk ? "text-white" : "text-dark"
  header_label    = is_high_risk ? "CRIMINAL RECORD — VERIFY IDENTITY" : "VISUAL VERIFICATION REQUIRED"
  header_icon     = is_high_risk ? "ri-alarm-warning-line" : "ri-eye-line"
%>

<%# Pinned danger banner for armed/wanted/escaped individuals %>
<% if is_high_risk %>
  <%= render 'officers/bonid_lookups/danger_banner', involvements: involvements %>
<% end %>

<div class="card border-0" data-result-type="pending_confirmation" style="border-left: 4px solid <%= accent_color %> !important;">
  <%# Dynamic header %>
  <div class="card-header <%= header_text %> py-2 border-0"
       style="background: <%= header_bg %>;<%= is_high_risk ? ' animation: pulse-danger 2s ease-in-out infinite;' : '' %>">
    <div class="d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center">
        <i class="<%= header_icon %> me-2" style="font-size: 1.1rem;"></i>
        <span style="font-family: 'Montserrat', sans-serif; font-weight: 600; font-size: 0.9rem;">
          <%= header_label %>
        </span>
      </div>
      <% if is_high_risk %>
        <span class="badge bg-light text-danger" style="font-size: 0.7rem;">
          <i class="ri-alert-line me-1"></i>HIGH RISK
        </span>
      <% elsif has_criminal_history %>
        <span class="badge bg-danger" style="font-size: 0.7rem;">
          <i class="ri-alert-line me-1"></i><%= involvements.count %> Record(s)
        </span>
      <% else %>
        <span class="badge bg-light text-success" style="font-size: 0.7rem;">
          <i class="ri-check-line me-1"></i>No Records
        </span>
      <% end %>
    </div>
  </div>

  <div class="card-body p-3">
    <%# Verification alert — changes tone for high-risk %>
    <% if is_high_risk %>
      <div class="d-flex align-items-center gap-2 mb-3 py-2 px-3 rounded" style="background: rgba(217, 7, 24, 0.08); font-size: 0.85rem;">
        <i class="ri-alarm-warning-line" style="color: var(--law-red); font-size: 1.1rem;"></i>
        <span style="color: var(--dark-gray);">
          <strong>Verify identity carefully.</strong> This person has active criminal records.
        </span>
      </div>
    <% else %>
      <div class="d-flex align-items-center gap-2 mb-3 py-2 px-3 rounded" style="background: rgba(229, 161, 0, 0.08); font-size: 0.85rem;">
        <i class="ri-eye-line" style="color: #E5A100; font-size: 1.1rem;"></i>
        <span style="color: var(--dark-gray);">
          <strong>Compare the photo</strong> with the person in front of you.
        </span>
      </div>
    <% end %>

    <%# === THE IDENTITY CARD === %>
    <div class="d-flex align-items-start gap-3 mb-3">
      <%# Large Photo — primary verification element, border shifts for high-risk %>
      <div class="flex-shrink-0 text-center">
        <% if user.photo.attached? %>
          <%= image_tag user.photo.variant(resize_to_limit: [200, 200]),
                        class: "rounded border border-3",
                        style: "width: 120px; height: 150px; object-fit: cover; border-color: #{photo_border} !important; cursor: pointer;",
                        data: {
                          photo_enlarge: true,
                          photo_url: url_for(user.photo.variant(resize_to_limit: [800, 800])),
                          person_name: display_name,
                          crime_type: latest_crime_type,
                          severity_level: latest_severity,
                          status: verification_status
                        },
                        title: "Tap to enlarge for verification" %>
        <% else %>
          <div class="rounded d-flex align-items-center justify-content-center"
               style="width: 120px; height: 150px; background: #f0f0f0; border: 3px solid <%= photo_border %>;">
            <i class="ri-user-line" style="font-size: 3rem; color: var(--mid-gray);"></i>
          </div>
        <% end %>
        <div class="small text-muted mt-1" style="font-size: 0.7rem;">
          <i class="ri-zoom-in-line me-1"></i>Tap to enlarge
        </div>
        <% if submission.verified? %>
          <span class="badge text-white d-block mt-1" style="background: var(--law-green); font-size: 0.7rem;">
            <i class="ri-verified-badge-line me-1"></i>Verified
          </span>
        <% end %>
        <% if is_high_risk %>
          <span class="badge text-white d-block mt-1" style="background: var(--law-red); font-size: 0.7rem;">
            <i class="ri-alarm-warning-line me-1"></i>Alert
          </span>
        <% end %>
        <% if expiring_soon %>
          <span class="badge bg-warning text-dark d-block mt-1" style="font-size: 0.65rem;">EXPIRING SOON</span>
        <% end %>
      </div>

      <%# Name + Quick Details %>
      <div class="flex-grow-1">
        <h5 class="mb-1" style="font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 1.15rem; color: var(--dark-gray); line-height: 1.2;">
          <%= user.full_name %>
        </h5>

        <div class="mb-2">
          <code class="d-inline-block px-2 py-1 rounded" style="font-size: 0.78rem; background: <%= is_high_risk ? 'var(--law-red-10)' : 'rgba(229, 161, 0, 0.1)' %>; color: <%= is_high_risk ? '#721c24' : '#8B6914' %>; letter-spacing: 0.5px;">
            <%= submission.bonid %>
          </code>
        </div>

        <div style="font-size: 0.8rem; color: var(--mid-gray);">
          <div class="d-flex flex-wrap gap-3">
            <span>
              <i class="ri-calendar-line me-1" style="font-weight: 400;"></i>
              <strong>DOB</strong> <%= user.dob&.strftime("%b %d, %Y") || "N/A" %>
            </span>
            <span>
              <i class="ri-user-line me-1" style="font-weight: 400;"></i>
              <strong>Sex</strong> <%= user.sex&.capitalize || "N/A" %>
            </span>
          </div>

          <div class="d-flex flex-wrap gap-3 mt-1">
            <span>
              <i class="ri-cake-2-line me-1" style="font-weight: 400;"></i>
              <strong>Age</strong> <%= user.age || "N/A" %>
            </span>
            <span>
              <i class="ri-heart-line me-1" style="font-weight: 400;"></i>
              <strong>Status</strong> <%= user.marital_status&.capitalize || "N/A" %>
            </span>
          </div>

          <% if user.address %>
            <div class="mt-1">
              <i class="ri-map-pin-line me-1" style="font-weight: 400;"></i>
              <%= user.formatted_address&.truncate(60) || "N/A" %>
            </div>
          <% end %>

          <% if user.phone.present? %>
            <div class="mt-1">
              <i class="ri-phone-line me-1" style="font-weight: 400;"></i>
              <%= user.phone %>
            </div>
          <% end %>

          <% if submission.expires_at %>
            <div class="mt-1">
              <i class="ri-time-line me-1" style="font-weight: 400;"></i>
              Expires <%= submission.expires_at.strftime("%b %d, %Y") %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Health info %>
    <% if user.health_profile&.blood_type.present? %>
      <div class="d-flex flex-wrap gap-2 mb-3 pb-3 border-bottom" style="font-size: 0.8rem;">
        <span class="badge bg-danger">
          <i class="ri-drop-line me-1"></i><%= user.health_profile.blood_type %>
        </span>
        <% if user.health_profile.organ_donor %>
          <span class="badge bg-info">
            <i class="ri-heart-line me-1"></i>Organ Donor
          </span>
        <% end %>
      </div>
    <% end %>

    <%# === CRIMINAL / INCIDENT HISTORY === %>
    <div class="mb-3 pb-3 border-bottom">
      <div class="d-flex align-items-center justify-content-between mb-2">
        <span style="font-family: 'Montserrat', sans-serif; font-size: 0.8rem; font-weight: 600; color: <%= is_high_risk ? 'var(--law-red)' : 'var(--law-blue)' %>;">
          <i class="<%= is_high_risk ? 'ri-alarm-warning-line' : 'ri-file-list-3-line' %> me-1" style="font-weight: 400;"></i>
          <%= is_high_risk ? 'Criminal History' : 'Incident History' %>
        </span>
        <% if has_criminal_history %>
          <span class="badge bg-danger" style="font-size: 0.65rem;"><%= involvements.count %> Record(s)</span>
        <% else %>
          <span class="badge bg-success" style="font-size: 0.65rem;">Clean Record</span>
        <% end %>
      </div>

      <% if has_criminal_history %>
        <div style="max-height: 160px; overflow-y: auto;">
          <% involvements.limit(5).each do |involvement| %>
            <%
              role_color = case involvement.role
                           when "suspect" then "danger"
                           when "victim" then "warning"
                           when "witness" then "info"
                           when "accomplice" then "dark"
                           else "secondary"
                           end
              status_color = case involvement.status
                             when "wanted", "fugitive", "escaped_custody", "armed", "dangerous" then "danger"
                             when "in_custody", "detained_awaiting_charges", "under_investigation" then "warning"
                             when "convicted", "awaiting_trial" then "dark"
                             when "released_on_bail", "probation", "paroled" then "info"
                             when "acquitted", "released_no_charges" then "success"
                             else "secondary"
                             end
              severity = involvement.incident_report&.crime_severity_level || 0
              severity_color = case severity
                               when 5, 4 then "danger"
                               when 3 then "warning"
                               when 2 then "info"
                               else "secondary"
                               end
              is_danger_status = high_risk_statuses.include?(involvement.status)
            %>
            <div class="py-2 <%= is_high_risk ? 'px-2 rounded mb-1' : '' %>" style="font-size: 0.75rem;<%= is_danger_status ? ' background: rgba(217, 7, 24, 0.05);' : '' %>">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <span class="badge bg-<%= role_color %> me-1"><%= involvement.role&.humanize %></span>
                  <strong><%= involvement.incident_report&.crime_type&.humanize || "Incident" %></strong>
                  <% if severity > 0 %>
                    <span class="badge bg-<%= severity_color %> ms-1">Lvl <%= severity %></span>
                  <% end %>
                </div>
                <small class="text-muted text-nowrap ms-2">
                  <%= involvement.incident_report&.occurred_at&.strftime("%b %d, %Y") || involvement.incident_report&.created_at&.strftime("%b %d, %Y") %>
                </small>
              </div>
              <% if involvement.status.present? && (involvement.role_suspect? || involvement.role_accomplice?) %>
                <div class="mt-1 d-flex align-items-center gap-2">
                  <span class="badge bg-<%= status_color %>" style="font-size: 0.65rem;">
                    <i class="<%= is_danger_status ? 'ri-alarm-warning-line' : 'ri-information-line' %> me-1"></i>
                    <%= involvement.status&.humanize %>
                  </span>
                  <% if involvement.incident_report&.officer %>
                    <span style="font-size: 0.65rem; color: var(--mid-gray);">
                      <i class="ri-user-star-line me-1"></i><%= involvement.incident_report.officer.full_name&.truncate(20) %>
                    </span>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
        <% if involvements.count > 5 %>
          <div class="text-muted small mt-1" style="font-size: 0.7rem;">
            <i class="ri-information-line me-1"></i>Showing 5 of <%= involvements.count %> records
          </div>
        <% end %>
      <% else %>
        <div class="text-muted small py-1" style="font-size: 0.8rem;">
          <i class="ri-checkbox-circle-line me-1 text-success"></i>No incident records found.
        </div>
      <% end %>
    </div>

    <%# Armed caution banner before confirmation %>
    <% if is_armed %>
      <div class="d-flex align-items-center gap-2 mb-3 py-2 px-3 rounded" style="background: rgba(217, 7, 24, 0.08); font-size: 0.8rem;">
        <i class="ri-alarm-warning-line" style="color: var(--law-red); font-size: 1rem;"></i>
        <span style="color: var(--dark-gray);"><strong>Exercise extreme caution.</strong> Do not approach alone.</span>
      </div>
    <% end %>

    <%# Visual Confirmation — officer must confirm photo match %>
    <div class="mb-3">
      <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="visualConfirmation"
               onchange="const btn = document.getElementById('confirmBtn'); if(btn) btn.disabled = !this.checked;"
               style="width: 1.2em; height: 1.2em;">
        <label class="form-check-label" for="visualConfirmation"
               style="font-family: 'Montserrat', sans-serif; font-size: 0.85rem; font-weight: 500;">
          <i class="ri-checkbox-circle-line me-1" style="color: var(--law-green);"></i>
          I confirm this photo matches the person in front of me
        </label>
      </div>

      <div class="d-flex gap-2">
        <button type="button"
                id="confirmBtn"
                disabled
                class="btn flex-grow-1 text-white"
                data-action="click->qr-scanner#confirmIdentity"
                data-confirm-url="<%= confirm_officers_bonid_lookup_path(submission.id) %>"
                data-confirmed="true"
                style="background: var(--law-green); font-family: 'Montserrat', sans-serif; font-weight: 500; font-size: 0.85rem;">
          <i class="ri-check-line me-1"></i>Confirm Identity
        </button>

        <button type="button"
                class="btn"
                data-action="click->qr-scanner#confirmIdentity"
                data-confirm-url="<%= confirm_officers_bonid_lookup_path(submission.id) %>"
                data-confirmed="false"
                style="font-family: 'Montserrat', sans-serif; font-weight: 500; font-size: 0.85rem;
                       background: var(--law-red-10); color: var(--law-red); border: 1px solid var(--law-red);">
          <i class="ri-close-line me-1"></i>Not a Match
        </button>
      </div>
    </div>

    <%# High-risk critical actions — below confirmation, above fold %>
    <% if is_high_risk %>
      <div class="d-flex gap-2">
        <a href="tel:911" class="btn flex-grow-1 text-white"
           style="background: var(--law-red); font-family: 'Montserrat', sans-serif; font-weight: 600; font-size: 0.85rem;">
          <i class="ri-phone-line me-1"></i>Call for Backup
        </a>

        <% if latest_involvement&.incident_report %>
          <%= link_to officers_incident_report_path(latest_involvement.incident_report),
                      class: "btn",
                      style: "font-family: 'Montserrat', sans-serif; font-weight: 500; font-size: 0.85rem; background: var(--law-red-10); color: var(--law-red); border: 1px solid var(--law-red);" do %>
            <i class="ri-folder-open-line me-1"></i>View Case File
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<%# Alert trigger — vibration + audio for high-risk encounters %>
<% if is_high_risk %>
  <script>
    (function() {
      if (navigator.vibrate) {
        navigator.vibrate(<%= is_armed ? '[200, 100, 200, 100, 400]' : '[200, 100, 200]' %>);
      }
      try {
        var ctx = new (window.AudioContext || window.webkitAudioContext)();
        function beep(freq, duration, delay) {
          var osc = ctx.createOscillator();
          var gain = ctx.createGain();
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.frequency.value = freq;
          gain.gain.value = 0.3;
          osc.start(ctx.currentTime + delay);
          osc.stop(ctx.currentTime + delay + duration);
        }
        beep(880, 0.15, 0);
        beep(880, 0.15, 0.25);
        <% if is_armed %>beep(1200, 0.3, 0.5);<% end %>
      } catch(e) {}
    })();
  </script>

  <style>
    @keyframes pulse-danger {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.85; }
    }
  </style>
<% end %>
