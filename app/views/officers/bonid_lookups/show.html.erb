<%# Officer BonID Lookup Detail %>

<div class="container-fluid py-4">
  <%# Page Header %>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0" style="font-family: 'Montserrat', sans-serif; font-size: 1.1rem; font-weight: 600; color: var(--law-blue);">
      <i class="ri-file-search-line me-2" style="font-size: 1.125rem; font-weight: 400;"></i>Lookup Details
    </h4>
    <%= link_to officers_bonid_lookups_path, class: "btn btn-outline-secondary", style: "font-family: 'Montserrat', sans-serif; font-size: 0.85rem; font-weight: 500;" do %>
      <i class="ri-arrow-left-line me-1" style="font-size: 1rem; font-weight: 400;"></i>Back
    <% end %>
  </div>

  <div class="row">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 py-3">
          <h5 class="mb-0" style="font-family: 'Montserrat', sans-serif; font-size: 0.95rem; font-weight: 600; color: var(--law-blue);">
            <i class="ri-information-line me-2"></i>Scan Information
          </h5>
        </div>
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-sm-4" style="font-size: 0.85rem;">Scanned At</dt>
            <dd class="col-sm-8" style="font-size: 0.85rem;"><%= @lookup.scanned_at&.strftime("%B %d, %Y at %H:%M") %></dd>

            <dt class="col-sm-4" style="font-size: 0.85rem;">BonID</dt>
            <dd class="col-sm-8" style="font-size: 0.85rem;"><code><%= @lookup.identity_submission&.bonid || "N/A" %></code></dd>

            <dt class="col-sm-4" style="font-size: 0.85rem;">Citizen Name</dt>
            <dd class="col-sm-8" style="font-size: 0.85rem;"><%= @lookup.identity_submission&.user&.full_name || "Unknown" %></dd>

            <dt class="col-sm-4" style="font-size: 0.85rem;">Method</dt>
            <dd class="col-sm-8" style="font-size: 0.85rem;">
              <% if @lookup.manual? %>
                <span class="badge bg-secondary">Manual Entry</span>
              <% else %>
                <span class="badge" style="background: var(--law-green);">QR Scan</span>
              <% end %>
            </dd>

            <dt class="col-sm-4" style="font-size: 0.85rem;">Verified By</dt>
            <dd class="col-sm-8" style="font-size: 0.85rem;"><%= @lookup.verified_by || "Officer" %></dd>

            <dt class="col-sm-4" style="font-size: 0.85rem;">IP Address</dt>
            <dd class="col-sm-8" style="font-size: 0.85rem; color: var(--mid-gray);"><%= @lookup.ip_address || "N/A" %></dd>
          </dl>
        </div>
      </div>
    </div>
  </div>
</div>
