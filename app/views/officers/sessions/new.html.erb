

<%# app/views/officers/sessions/new.html.erb %>

<div class="officer-form-card">
  <%# Logo %>
  <div class="form-icon">
    <%= image_tag "pnh.png", alt: "PNH" %>
  </div>

  <%# Form %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { data: { turbo: false } }) do |f| %>
    <div class="mb-3">
      <%= f.label :email, "Email Address", class: "form-label" %>
      <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            placeholder: "a.paraison@pnh.gouv.ht",
            class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= f.label :password, "Password", class: "form-label" %>
      <%= f.password_field :password,
            autocomplete: "current-password",
            placeholder: "Enter your password",
            class: "form-control" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="mb-3 form-check">
        <%= f.check_box :remember_me, class: "form-check-input" %>
        <%= f.label :remember_me, "Remember me", class: "form-check-label" %>
      </div>
    <% end %>

    <%= f.submit "Sign In", class: "btn-officer-primary mt-2" %>
  <% end %>

  <%# Links %>
  <div class="text-center mt-4">
    <%= link_to "Forgot your password?", new_officer_password_path, class: "form-link" %>
  </div>

  <div class="form-divider">
    <span>or</span>
  </div>

  <%# Login with BonID %>
  <div class="text-center">
    <%= link_to "#", class: "btn-officer-outline text-muted bg-secondary-subtle border-0", style: "pointer-events: none;", "aria-disabled": true, tabindex: -1 do %>
      <i class="ri-login-box-line me-2"></i> Login with BonID
    <% end %>
  </div>

  <%# Back to Home %>
  <div class="text-center mt-3">
    <%= link_to root_path, class: "btn-officer-outline" do %>
      <i class="ri-arrow-left-line me-2"></i> Back to Home
    <% end %>
  </div>
</div>

