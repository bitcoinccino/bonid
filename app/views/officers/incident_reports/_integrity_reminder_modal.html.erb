<%# app/views/officers/incident_reports/_integrity_reminder_modal.html.erb %>
<%# Integrity reminder shown before submitting an incident report %>

<div class="modal fade" id="integrityReminderModal" tabindex="-1" aria-labelledby="integrityReminderModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content border-0" style="border-radius: 16px; overflow: hidden;">

      <%# Header %>
      <div class="modal-header text-white py-3" style="background: linear-gradient(135deg, var(--law-blue) 0%, #001a5c 100%); border-bottom: none;">
        <h5 class="modal-title d-flex align-items-center" id="integrityReminderModalLabel" style="font-family: 'Montserrat', sans-serif; font-weight: 600;">
          <i class="ri-shield-star-line me-2" style="font-size: 1.5rem;"></i>
          Rappel d'Intégrité - Avant Soumission
        </h5>
      </div>

      <%# Body %>
      <div class="modal-body p-4">
        <%# Oath Reminder %>
        <div class="alert mb-3 py-3" style="background: linear-gradient(135deg, #fef3cd 0%, #fff8e1 100%); border: none; border-left: 4px solid var(--law-tan);">
          <div class="d-flex align-items-center">
            <i class="ri-hand-heart-line me-3" style="font-size: 1.75rem; color: var(--law-tan);"></i>
            <div>
              <strong style="font-family: 'Montserrat', sans-serif; color: #856404;">Votre Serment d'Officier</strong>
              <p class="mb-0 small" style="color: #856404; font-style: italic;">
                "Je jure de servir avec honneur, intégrité et dévouement."
              </p>
            </div>
          </div>
        </div>

        <%# Key Reminders %>
        <div class="mb-3">
          <h6 class="fw-bold mb-3" style="font-family: 'Montserrat', sans-serif; color: var(--law-blue);">
            <i class="ri-error-warning-line me-1"></i>
            Avant de soumettre ce rapport, confirmez que:
          </h6>

          <div class="list-group list-group-flush">
            <div class="list-group-item d-flex align-items-start px-0 py-2 border-0">
              <i class="ri-checkbox-circle-fill me-2 mt-1" style="color: var(--law-green);"></i>
              <span class="small">Les <strong>informations sont exactes</strong> et vérifiées visuellement.</span>
            </div>
            <div class="list-group-item d-flex align-items-start px-0 py-2 border-0">
              <i class="ri-checkbox-circle-fill me-2 mt-1" style="color: var(--law-green);"></i>
              <span class="small">L'<strong>identité de chaque personne</strong> a été confirmée via BonID/BonTouris.</span>
            </div>
            <div class="list-group-item d-flex align-items-start px-0 py-2 border-0">
              <i class="ri-checkbox-circle-fill me-2 mt-1" style="color: var(--law-green);"></i>
              <span class="small">Je n'ai <strong>pas falsifié</strong> ou manipulé les données.</span>
            </div>
            <div class="list-group-item d-flex align-items-start px-0 py-2 border-0">
              <i class="ri-checkbox-circle-fill me-2 mt-1" style="color: var(--law-green);"></i>
              <span class="small">Les personnes impliquées sont <strong>correctement identifiées</strong> selon leur rôle réel.</span>
            </div>
            <div class="list-group-item d-flex align-items-start px-0 py-2 border-0">
              <i class="ri-checkbox-circle-fill me-2 mt-1" style="color: var(--law-green);"></i>
              <span class="small">J'ai <strong>traité chaque personne avec respect</strong> et dignité.</span>
            </div>
            <div class="list-group-item d-flex align-items-start px-0 py-2 border-0">
              <i class="ri-checkbox-circle-fill me-2 mt-1" style="color: var(--law-green);"></i>
              <span class="small">J'ai <strong>informé chaque personne de ses droits</strong> lors de l'interpellation.</span>
            </div>
            <div class="list-group-item d-flex align-items-start px-0 py-2 border-0">
              <i class="ri-checkbox-circle-fill me-2 mt-1" style="color: var(--law-green);"></i>
              <span class="small">L'usage de la force était <strong>uniquement en cas de nécessité absolue</strong>.</span>
            </div>
          </div>
        </div>

        <%# Citizen Rights Reminder %>
        <div class="alert mb-3 py-2" style="background: #e3f2fd; border: none; border-left: 4px solid var(--law-blue);">
          <div class="d-flex align-items-start">
            <i class="ri-user-star-line me-2 mt-1" style="font-size: 1.25rem; color: var(--law-blue);"></i>
            <div class="small">
              <strong style="color: var(--law-blue);">Droit du Citoyen:</strong>
              <span style="color: #1565c0;">Les citoyens et touristes ont le <strong>droit de déposer une plainte</strong> s'ils estiment ne pas avoir été bien servis par un officier.</span>
            </div>
          </div>
        </div>

        <%# Legal Warning %>
        <div class="alert alert-danger mb-0 py-2" style="font-size: 0.85rem;">
          <div class="d-flex align-items-start">
            <i class="ri-alarm-warning-line me-2 mt-1" style="font-size: 1.25rem;"></i>
            <div>
              <strong>Avertissement Légal:</strong>
              <span>Ce rapport sera utilisé comme preuve devant les tribunaux haïtiens. La falsification de documents officiels constitue un <strong>délit pénal</strong> passible de poursuites criminelles et d'emprisonnement.</span>
            </div>
          </div>
        </div>
      </div>

      <%# Footer with Actions %>
      <div class="modal-footer justify-content-between py-3" style="background: #f8f9fa;">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" style="font-family: 'Montserrat', sans-serif; font-weight: 500;">
          <i class="ri-arrow-left-line me-1"></i>
          Réviser le Rapport
        </button>

        <button type="button" class="btn text-white" id="confirmIntegrityBtn" style="background: linear-gradient(135deg, var(--law-green) 0%, #1a5c1a 100%); font-family: 'Montserrat', sans-serif; font-weight: 600;">
          <i class="ri-shield-check-line me-1"></i>
          Je Confirme et Soumets
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('incident-report-form');
    const modal = document.getElementById('integrityReminderModal');
    const confirmBtn = document.getElementById('confirmIntegrityBtn');

    if (form && modal && confirmBtn) {
      // Store the original submit event
      let formSubmitAllowed = false;

      // Intercept form submission
      form.addEventListener('submit', function(e) {
        if (!formSubmitAllowed) {
          e.preventDefault();

          // Validate form first
          if (!form.checkValidity()) {
            form.reportValidity();
            return;
          }

          // Show integrity reminder modal
          const bsModal = new bootstrap.Modal(modal);
          bsModal.show();
        }
      });

      // Handle confirm button click
      confirmBtn.addEventListener('click', function() {
        formSubmitAllowed = true;

        // Close modal
        const bsModal = bootstrap.Modal.getInstance(modal);
        bsModal.hide();

        // Submit the form
        form.submit();
      });

      // Reset flag when modal is closed without confirming
      modal.addEventListener('hidden.bs.modal', function() {
        // If user closed modal without confirming, keep formSubmitAllowed false
        // This allows them to try submitting again
      });
    }
  });
</script>
