<%# app/views/officers/incident_reports/edit.html.erb %>

<div class="container-fluid py-4">
  <%# Page Header %>
  <div class="row mb-4">
    <div class="col-12">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2">
          <li class="breadcrumb-item"><%= link_to "Dashboard", officers_dashboard_path %></li>
          <li class="breadcrumb-item"><%= link_to "Incident Reports", officers_incident_reports_path %></li>
          <li class="breadcrumb-item"><%= link_to @incident_report.report_id, officers_incident_report_path(@incident_report) %></li>
          <li class="breadcrumb-item active">Edit</li>
        </ol>
      </nav>
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <h2 class="mb-1 fw-bold">Edit Incident Report</h2>
          <p class="text-muted mb-0 font-monospace"><%= @incident_report.report_id %></p>
        </div>
        <%= link_to officers_incident_report_path(@incident_report), class: "btn btn-outline-secondary" do %>
          <i class="ri-arrow-left-line me-1"></i> Back to Report
        <% end %>
      </div>
    </div>
  </div>

  <%# Form - each section has its own card %>
  <div class="row">
    <div class="col-12">
      <%= render "form", incident_report: @incident_report, departments: @departments %>
    </div>
  </div>
</div>
