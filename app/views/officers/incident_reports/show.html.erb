<%# app/views/officers/incident_reports/show.html.erb %>
<%# Certificate-Style Incident Report View - Matching Officer Profile Styling %>

<%# Helper to mask BonID: DV-1989-M-SE-P8697XDS → DV-••••-•-••-P••••XDS %>
<%
  def mask_bonid(bonid)
    return bonid if bonid.blank?
    parts = bonid.split('-')
    return bonid if parts.length < 5

    # Format: INITIALS-YEAR-SEX-DEPT-P+DIGITS+CHECKSUM
    tail = parts.last
    masked_parts = [
      parts[0],                                            # Initials
      '••••',                                              # Year masked
      '•',                                                 # Sex masked
      '••',                                                # Department masked
      "#{tail[0]}••••#{tail[-3..]}"                        # P + masked digits + checksum
    ]
    masked_parts.join('-')
  end

  # Helper to mask BonTouris: T-JS-1990-M-US-P-988455 → T-JS-••••-•-US-P-988455
  def mask_bontouris(bonid)
    return bonid if bonid.blank?
    parts = bonid.split('-')
    return bonid if parts.length < 6

    # Format: T-INITIALS-YEAR-SEX-COUNTRY-P-XXXXXX
    masked_parts = [
      parts[0],                          # T
      parts[1],                          # Initials
      '••••',                            # Year masked
      '•',                               # Sex masked
      parts[-3],                         # Country code (US)
      parts[-2],                         # P
      parts[-1]                          # Unique number
    ]
    masked_parts.join('-')
  end

  # Get officer verified BonID submission
  officer = @incident_report.officer
  verified_submission = officer&.user&.identity_submissions&.approved&.last
%>

<div id="print-area" class="certificate-font py-4">
  <div class="container">

    <%# Header Bar - Action Buttons (hidden on print) %>
    <div class="d-print-none d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
      <%= link_to officers_incident_reports_path,
                  class: "btn btn-outline-secondary rounded-pill fw-semibold d-inline-flex align-items-center gap-2" do %>
        <i class="ri-arrow-left-line"></i>
        Back to Reports
      <% end %>

      <div class="d-flex align-items-center gap-3">
        <% if @incident_report.status_draft? || @incident_report.status_submitted? || @incident_report.status_rejected? || @incident_report.status.nil? %>
          <%= link_to edit_officers_incident_report_path(@incident_report),
                      class: "btn btn-light rounded-circle shadow-sm p-3",
                      title: "Modifier le rapport",
                      style: "width: 56px; height: 56px; display: flex; align-items: center; justify-content: center;" do %>
            <i class="ri-edit-line fs-4" style="color: var(--law-blue);"></i>
          <% end %>
        <% end %>
        <button class="btn btn-light rounded-circle shadow-sm p-3" id="share-certificate" title="Share Report"
                style="width: 56px; height: 56px; display: flex; align-items: center; justify-content: center;">
          <i class="ri-share-forward-line fs-4" style="color: var(--law-blue);"></i>
        </button>
        <button class="btn btn-light rounded-circle shadow-sm p-3" id="print-certificate" title="Print Report"
                style="width: 56px; height: 56px; display: flex; align-items: center; justify-content: center;">
          <i class="ri-printer-line fs-4" style="color: var(--law-blue);"></i>
        </button>
        <%= link_to download_pdf_officers_incident_report_path(@incident_report),
                    class: "btn btn-light rounded-circle shadow-sm p-3",
                    title: "Download PDF",
                    style: "width: 56px; height: 56px; display: flex; align-items: center; justify-content: center;" do %>
          <i class="ri-file-pdf-line fs-4" style="color: var(--law-blue);"></i>
        <% end %>
      </div>
    </div>

    <%# ── Draft banner — visible only for unsent drafts ── %>
    <% if @incident_report.status_draft? %>
      <div class="rounded-3 mb-4 p-3 d-flex align-items-center gap-3 flex-wrap d-print-none"
           style="background: #fef3c7; border: 1px solid #fbbf24; color: #78350f;">
        <i class="ri-draft-line fs-4 flex-shrink-0"></i>
        <div class="flex-grow-1">
          <p class="fw-bold mb-0 small text-uppercase" style="letter-spacing: 0.5px;">⚠ BROUILLON — Non soumis</p>
          <p class="mb-0 small">Ce rapport n'est pas encore officiel et n'a pas été transmis à votre superviseur.</p>
        </div>
        <%= link_to preview_officers_incident_report_path(@incident_report),
                    class: "btn btn-sm fw-bold rounded-pill flex-shrink-0",
                    style: "background: var(--law-blue); color: white; white-space: nowrap;" do %>
          <i class="ri-quill-pen-fill me-1"></i>Aperçu & Signature →
        <% end %>
      </div>
    <% end %>

    <%# Certificate Card %>
    <div class="card shadow-lg border-0 certificate-card rounded-4 overflow-hidden">
      <div class="card-body p-4 p-md-5 position-relative">

        <%# ═══════════════════════════════════════════════════════════════════════ %>
        <%# HEADER SECTION - Partner Logo Centered %>
        <%# ═══════════════════════════════════════════════════════════════════════ %>
        <div class="text-center mb-4">
          <%# Partner Logo - Centered, No Border, Larger Size %>
          <% if officer&.partner&.logo&.attached? %>
            <div class="d-flex align-items-center justify-content-center mb-3">
              <%= image_tag url_for(officer.partner.logo),
                            style: "width: 100px; height: auto;",
                            loading: "lazy" %>
            </div>
          <% end %>

          <%# Specialty & Unit %>
          <div class="mb-1" style="font-family: 'Montserrat', sans-serif; font-size: 0.85rem; color: var(--mid-gray);">
            <% if officer&.unit_type.present? %>
              <span class="fw-medium" style="color: var(--law-blue);">Specialty:</span> <%= officer.unit_type %>
              <% if officer&.unit_name.present? %>
                <span class="mx-2">|</span>
              <% end %>
            <% end %>
            <% if officer&.unit_name.present? %>
              <span class="fw-medium" style="color: var(--law-blue);">Unit:</span> <%= officer.unit_name %>
            <% end %>
          </div>

          <%# Jurisdiction (Direction Départementale) %>
          <% if officer&.department_directorate.present? %>
            <div class="mb-3" style="font-family: 'Montserrat', sans-serif; font-size: 0.8rem; color: var(--mid-gray);">
              <i class="ri-map-pin-2-line me-1" style="font-weight: 400;"></i><strong style="color: var(--law-blue);"><%= OfficerConstants::DEPARTMENTS[officer.department_directorate] %></strong>
            </div>
          <% else %>
            <div class="mb-3"></div>
          <% end %>

          <h2 class="fw-bold mb-0 font-heading-semibold" style="color: var(--law-blue); font-size: 1.1rem; letter-spacing: 1px;">
            RAPPORT D'INCIDENT OFFICIEL
          </h2>
        </div>

        <hr class="my-4" style="border-color: var(--law-blue); border-width: 1px;">

        <%# ═══════════════════════════════════════════════════════════════════════ %>
        <%# REPORT DETAILS SECTION %>
        <%# ═══════════════════════════════════════════════════════════════════════ %>
        <div class="row g-4 mb-5">
          <div class="col-12 text-center">
            <%# Report ID Badge %>
            <div class="d-inline-block border rounded-3 p-3 bg-white shadow-sm mb-3" style="border-color: var(--law-blue) !important;">
              <p class="fw-bold mb-1 small" style="color: var(--law-blue);">Numéro de Rapport</p>
              <span class="fw-bold font-monospace fs-5" style="color: var(--law-blue);"><%= @incident_report.report_id %></span>
            </div>

            <% if @incident_report.bonid_case_number.present? %>
              <div class="d-inline-block border rounded-3 p-3 bg-white shadow-sm mb-3 ms-md-3" style="border-color: #FFD700 !important;">
                <p class="fw-bold mb-1 small" style="color: var(--law-blue);">Numéro de Dossier</p>
                <span class="fw-bold font-monospace fs-5" style="color: var(--law-blue);"><%= @incident_report.bonid_case_number %></span>
              </div>
            <% end %>
          </div>

          <%# Crime Details %>
          <div class="col-md-6">
            <div class="border rounded-3 p-3 h-100" style="border-color: rgba(9, 44, 115, 0.2) !important; background: rgba(9, 44, 115, 0.02);">
              <h6 class="fw-bold mb-2 font-heading-semibold" style="color: var(--law-blue);">
                <i class="ri-alert-line me-1" style="color: var(--law-red);"></i>Type de Crime
              </h6>
              <p class="mb-2 fw-semibold"><%= @incident_report.crime_type&.humanize %></p>
              <% if @incident_report.crime_severity_level.present? %>
                <%
                  severity = @incident_report.crime_severity_level
                  severity_class = case severity
                                   when 5 then "bg-danger"
                                   when 4 then "bg-danger"
                                   when 3 then "bg-warning text-dark"
                                   when 2 then "bg-info"
                                   else "bg-secondary"
                                   end
                  severity_text = case severity
                                  when 5 then "Critique (5)"
                                  when 4 then "Sévère (4)"
                                  when 3 then "Élevé (3)"
                                  when 2 then "Moyen (2)"
                                  when 1 then "Faible (1)"
                                  else "Non classé"
                                  end
                %>
                <span class="badge <%= severity_class %>"><%= severity_text %></span>
              <% end %>
              <% if @incident_report.penal_code_articles.present? %>
                <p class="mt-2 mb-0 small text-muted">
                  <i class="ri-scales-3-line me-1"></i>Articles <%= @incident_report.penal_code_articles %> (Code Pénal)
                </p>
              <% end %>
            </div>
          </div>

          <%# Date & Location %>
          <div class="col-md-6">
            <div class="border rounded-3 p-3 h-100" style="border-color: rgba(9, 44, 115, 0.2) !important; background: rgba(9, 44, 115, 0.02);">
              <h6 class="fw-bold mb-2 font-heading-semibold" style="color: var(--law-blue);">
                <i class="ri-calendar-line me-1"></i>Date et Lieu
              </h6>
              <p class="mb-2">
                <strong>Date:</strong> <%= @incident_report.occurred_at&.strftime("%d %B %Y à %H:%M") || "Non spécifié" %>
              </p>
              <% if @incident_report.address.present? %>
                <p class="mb-0">
                  <strong>Lieu:</strong><br>
                  <%= @incident_report.address.street_address %><br>
                  <span class="text-muted small">
                    <%= [
                      @incident_report.address.commune&.name,
                      @incident_report.address.communal_section&.name,
                      @incident_report.address.department&.name,
                      @incident_report.address.postal_code
                    ].compact.join(", ") %>
                  </span>
                </p>
              <% end %>
            </div>
          </div>

          <%# Description %>
          <% if @incident_report.description.present? %>
            <div class="col-12">
              <div class="border rounded-3 p-3" style="border-color: rgba(9, 44, 115, 0.2) !important; background: rgba(9, 44, 115, 0.02);">
                <h6 class="fw-bold mb-2 font-heading-semibold" style="color: var(--law-blue);">
                  <i class="ri-file-text-line me-1"></i>Description de l'Incident
                </h6>
                <p class="mb-0"><%= @incident_report.description %></p>
              </div>
            </div>
          <% end %>
        </div>

        <hr class="my-4" style="border-color: var(--law-blue); opacity: 0.3;">

        <%# ═══════════════════════════════════════════════════════════════════════ %>
        <%# PERSONS INVOLVED SECTION %>
        <%# ═══════════════════════════════════════════════════════════════════════ %>
        <% if @incident_report.person_involvements.any? %>
          <div class="mb-5">
            <h5 class="text-center fw-bold mb-4 font-heading-semibold" style="color: var(--law-blue); font-size: 0.95rem;">
              <i class="ri-group-line me-2"></i>PERSONNES IMPLIQUÉES
            </h5>

            <div class="row g-3 justify-content-center">
              <% @incident_report.person_involvements.each do |pi| %>
                <%
                  # Determine if tourist or citizen
                  is_tourist = pi.visitor_submission.present?
                  user = pi.user || pi.visitor_submission

                  # Get photo
                  photo_attached = (pi.user&.photo&.attached?) || (pi.visitor_submission&.selfie&.attached?)

                  # Get name
                  person_name = if pi.user.present?
                    [pi.user.first_name, pi.user.last_name].compact.join(' ')
                  elsif pi.visitor_submission.present?
                    [pi.visitor_submission.first_name, pi.visitor_submission.last_name].compact.join(' ')
                  else
                    pi.name || "Inconnu"
                  end

                  # Get and mask BonID/BonTouris
                  # For tourists, get full BonTouris from visitor_submission.bonid
                  # For citizens, use pi.bonid or user.bonid
                  full_id = if is_tourist
                    pi.visitor_submission&.bonid || pi.bonid
                  else
                    pi.bonid || pi.user&.bonid
                  end

                  masked_id = if is_tourist
                    mask_bontouris(full_id)
                  else
                    mask_bonid(full_id)
                  end

                  # Get country for tourists
                  tourist_country = pi.visitor_submission&.nationality
                %>
                <div class="col-md-6 col-lg-4">
                  <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid var(--law-blue) !important;">
                    <div class="card-body p-3">
                      <div class="d-flex align-items-center gap-3">
                        <%# Photo %>
                        <div class="flex-shrink-0">
                          <% if photo_attached %>
                            <% if pi.user&.photo&.attached? %>
                              <%= image_tag url_for(pi.user.photo),
                                            class: "rounded-circle",
                                            style: "width: 60px; height: 60px; object-fit: cover; border: 1px solid var(--law-blue);",
                                            loading: "lazy" %>
                            <% elsif pi.visitor_submission&.selfie&.attached? %>
                              <%= image_tag url_for(pi.visitor_submission.selfie),
                                            class: "rounded-circle",
                                            style: "width: 60px; height: 60px; object-fit: cover; border: 1px solid var(--law-blue);",
                                            loading: "lazy" %>
                            <% end %>
                          <% else %>
                            <div class="rounded-circle d-flex align-items-center justify-content-center"
                                 style="width: 60px; height: 60px; background: rgba(9, 44, 115, 0.1); border: 1px solid var(--law-blue);">
                              <i class="ri-user-line fs-4" style="color: var(--law-blue);"></i>
                            </div>
                          <% end %>
                        </div>

                        <%# Info %>
                        <div class="flex-grow-1">
                          <h6 class="mb-1 fw-semibold" style="color: var(--law-blue);">
                            <%= person_name %>
                          </h6>

                          <%# Masked BonID/BonTouris %>
                          <% if masked_id.present? %>
                            <p class="mb-1 small font-monospace" style="color: var(--mid-gray); font-size: 0.75rem;">
                              <%= masked_id %>
                            </p>
                          <% end %>

                          <div class="d-flex flex-wrap gap-1">
                            <%# Citizen/Tourist Badge %>
                            <% if is_tourist %>
                              <span class="badge" style="background-color: var(--law-tan); font-size: 0.65rem;">
                                <i class="ri-plane-line me-1"></i>Tourist
                                <% if tourist_country.present? %>
                                  · <%= tourist_country %>
                                <% end %>
                              </span>
                            <% else %>
                              <span class="badge" style="background-color: var(--law-green); font-size: 0.65rem;">
                                <i class="ri-user-heart-line me-1"></i>Citizen
                              </span>
                            <% end %>

                            <%# Role Badge %>
                            <%
                              role_class = case pi.role
                                           when "suspect", "accomplice" then "bg-danger"
                                           when "victim" then "bg-warning text-dark"
                                           when "witness" then "bg-info"
                                           else "bg-secondary"
                                           end
                            %>
                            <span class="badge <%= role_class %>" style="font-size: 0.65rem;"><%= pi.role&.titleize || "Inconnu" %></span>

                            <%# Status Badge %>
                            <% if pi.status.present? %>
                              <%
                                status_class = case pi.status
                                               when "wanted", "fugitive", "at_large", "armed", "dangerous" then "bg-danger"
                                               when "in_custody", "detained" then "bg-success"
                                               when "deceased" then "bg-dark"
                                               else "bg-secondary"
                                               end
                              %>
                              <span class="badge <%= status_class %>" style="font-size: 0.65rem;"><%= pi.status&.titleize %></span>
                            <% end %>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <hr class="my-4" style="border-color: var(--law-blue); opacity: 0.3;">

        <%# ═══════════════════════════════════════════════════════════════════════ %>
        <%# EVIDENCE SECTION (if any) %>
        <%# ═══════════════════════════════════════════════════════════════════════ %>
        <% if @incident_report.media.attached? %>
          <div class="mb-5 d-print-none">
            <h5 class="text-center fw-bold mb-3 font-heading-semibold" style="color: var(--law-blue); font-size: 0.95rem;">
              <i class="ri-camera-line me-2"></i>PREUVES & MÉDIAS
            </h5>
            <div class="row g-2 justify-content-center">
              <% @incident_report.media.limit(6).each do |file| %>
                <div class="col-4 col-md-2 position-relative">
                  <% if file.content_type.start_with?("image/") %>
                    <%= link_to rails_blob_path(file, disposition: "inline"), target: "_blank" do %>
                      <%= image_tag url_for(file),
                                    class: "img-fluid rounded border",
                                    style: "width: 100%; height: 80px; object-fit: cover;",
                                    loading: "lazy" %>
                    <% end %>
                    <% if file.blob.metadata&.dig("watermarked") %>
                      <span class="badge position-absolute top-0 start-0 text-white"
                            style="font-size: 0.5rem; background: var(--law-green); border-radius: 0 0 4px 0;"
                            title="Watermarked: <%= file.blob.metadata.dig('watermark_timestamp') %>">
                        <i class="ri-shield-check-line"></i>
                      </span>
                    <% end %>
                  <% else %>
                    <%= link_to rails_blob_path(file, disposition: "inline"), class: "d-block p-2 border rounded text-center", target: "_blank" do %>
                      <i class="ri-video-line fs-4" style="color: var(--law-blue);"></i>
                    <% end %>
                  <% end %>
                </div>
              <% end %>
            </div>
            <% if @incident_report.media.count > 6 %>
              <p class="text-center text-muted small mt-2">+ <%= @incident_report.media.count - 6 %> autres fichiers</p>
            <% end %>
          </div>
          <hr class="my-4 d-print-none" style="border-color: var(--law-blue); opacity: 0.3;">
        <% end %>

        <%# ═══════════════════════════════════════════════════════════════════════ %>
        <%# OFFICER SIGNATURE SECTION %>
        <%# ═══════════════════════════════════════════════════════════════════════ %>
        <div class="mb-5">
          <h5 class="text-center fw-bold mb-4 font-heading-semibold" style="color: var(--law-blue); font-size: 0.95rem;">
            <i class="ri-user-star-line me-2"></i>OFFICIER RESPONSABLE
          </h5>

          <div class="d-flex flex-column align-items-center">
            <%# Officer Info %>
            <div class="text-center">
              <div class="d-flex align-items-center gap-3 justify-content-center">
                <%# Officer Photo from Verified BonID Submission %>
                <% if verified_submission&.photo&.attached? %>
                  <%= image_tag url_for(verified_submission.photo),
                                class: "rounded-circle shadow-sm",
                                style: "width: 100px; height: 100px; object-fit: cover; border: 1px solid rgba(9, 44, 115, 0.15);",
                                loading: "lazy" %>
                <% elsif officer&.photo&.attached? %>
                  <%= image_tag url_for(officer.photo),
                                class: "rounded-circle shadow-sm",
                                style: "width: 100px; height: 100px; object-fit: cover; border: 1px solid rgba(9, 44, 115, 0.15);",
                                loading: "lazy" %>
                <% else %>
                  <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm"
                       style="width: 100px; height: 100px; background: rgba(9, 44, 115, 0.08); border: 1px solid rgba(9, 44, 115, 0.15);">
                    <i class="ri-user-star-line fs-1" style="color: var(--law-blue);"></i>
                  </div>
                <% end %>

                <div>
                  <h5 class="mb-1 fw-bold" style="color: var(--law-blue);"><%= @incident_report.officer_name %></h5>
                  <p class="mb-1 small" style="color: var(--mid-gray);">
                    <i class="ri-medal-line me-1"></i>Rank: <%= officer&.rank || "Officer" %>
                  </p>
                  <p class="mb-1 small" style="color: var(--mid-gray);">
                    <i class="ri-shield-star-line me-1"></i>Badge: <%= officer&.badge_id %>
                  </p>
                  <%# Officer BonID (masked) %>
                  <% if verified_submission&.bonid.present? %>
                    <div class="mt-2 p-2 rounded" style="background: rgba(9, 44, 115, 0.06);">
                      <small style="font-size: 0.7rem; color: var(--mid-gray);">BonID</small>
                      <div style="font-family: monospace; font-size: 0.75rem; font-weight: 500; color: var(--law-blue); letter-spacing: 0.5px;">
                        <%= mask_bonid(verified_submission.bonid) %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>

              <%# Signature from BonID - Larger Size %>
              <div class="mt-4">
                <% if verified_submission&.signature&.attached? %>
                  <div class="border rounded p-3 bg-white text-center" style="border-color: rgba(9, 44, 115, 0.1) !important; max-width: 280px; margin: 0 auto;">
                    <%= image_tag verified_submission.signature,
                                  style: "max-width: 100%; max-height: 100px;",
                                  alt: "Officer signature" %>
                  </div>
                  <p class="text-muted small mt-1 text-center">
                    <i class="ri-shield-check-line me-1" style="color: var(--law-green);"></i>Signature vérifiée
                  </p>
                <% elsif verified_submission&.signature_data.present? %>
                  <div class="border rounded p-3 bg-white text-center" style="border-color: rgba(9, 44, 115, 0.1) !important; max-width: 280px; margin: 0 auto;">
                    <%= image_tag verified_submission.signature_data,
                                  style: "max-width: 100%; max-height: 100px;",
                                  alt: "Officer signature" %>
                  </div>
                  <p class="text-muted small mt-1 text-center">
                    <i class="ri-shield-check-line me-1" style="color: var(--law-green);"></i>Signature vérifiée
                  </p>
                <% else %>
                  <div style="width: 280px; border-bottom: 1px solid var(--law-blue); margin: 0 auto;"></div>
                  <p class="text-muted small mt-1 text-center">Signature de l'Officier</p>
                <% end %>
              </div>
            </div>

          </div>
        </div>

        <hr class="my-4" style="border-color: var(--law-blue); opacity: 0.3;">

        <%# ═══════════════════════════════════════════════════════════════════════ %>
        <%# INTEGRITY STRIP — QR + HMAC checksum + validity badge %>
        <%# ═══════════════════════════════════════════════════════════════════════ %>
        <div class="d-flex align-items-start gap-3 p-3 rounded-3 mb-4"
             style="background: #f8fafc; border: 1px solid rgba(9,44,115,0.15);">
          <%# QR code pointing to public verify URL %>
          <% qr_b64 = @incident_report.report_qr_png_base64 %>
          <% if qr_b64.present? %>
            <img src="data:image/png;base64,<%= qr_b64 %>"
                 style="width:90px;height:90px;flex-shrink:0;border:1px solid #e2e8f0;border-radius:4px;"
                 alt="Scanner pour vérifier" title="Scanner pour vérifier ce rapport en ligne" />
          <% elsif @incident_report.qr_code.present? %>
            <%# Fallback to stored qr_code if regeneration fails %>
            <img src="data:image/png;base64,<%= @incident_report.qr_code %>"
                 style="width:90px;height:90px;flex-shrink:0;border:1px solid #e2e8f0;border-radius:4px;"
                 alt="Scanner pour vérifier" />
          <% end %>
          <div style="flex:1;font-family:'Montserrat',sans-serif;">
            <div style="font-size:0.55rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--law-blue);margin-bottom:3px;">
              Vérification / Report Verification
            </div>
            <div style="font-size:0.68rem;color:#333;word-break:break-all;margin-bottom:6px;">
              <%= @incident_report.verify_url %>
            </div>
            <div style="font-size:0.6rem;color:#666;">
              Checksum HMAC-SHA256:
              <span style="font-family:monospace;font-weight:700;color:#000;letter-spacing:1px;">
                <%= @incident_report.report_checksum %>
              </span>
            </div>
            <% if @incident_report.report_signed_at %>
              <div style="font-size:0.6rem;color:#666;margin-top:3px;">
                Signé le: <%= @incident_report.report_signed_at.strftime("%d %B %Y à %H:%M UTC") %>
              </div>
            <% end %>
            <% if @incident_report.report_valid? %>
              <span style="display:inline-block;font-size:0.55rem;font-weight:700;text-transform:uppercase;padding:2px 8px;border-radius:20px;margin-top:5px;background:#d1fae5;color:#065f46;border:1px solid #6ee7b7;">
                ✓ Intégrité confirmée / Integrity verified
              </span>
            <% else %>
              <span style="display:inline-block;font-size:0.55rem;font-weight:700;text-transform:uppercase;padding:2px 8px;border-radius:20px;margin-top:5px;background:#fee2e2;color:#991b1b;border:1px solid #fca5a5;">
                ⚠ Signature invalide — document suspect
              </span>
            <% end %>
            <%# Digital attestation footer — shows who signed and when %>
            <% if @incident_report.signed_by_badge_id.present? %>
              <div style="font-size:0.6rem;color:#555;margin-top:6px;padding-top:5px;border-top:1px solid #e2e8f0;">
                <i class="ri-quill-pen-fill" style="color:var(--law-blue);"></i>
                Attesté par: <strong style="font-family:monospace;"><%= @incident_report.signed_by_badge_id %></strong>
                <% if @incident_report.officer_attested_at %>
                  — <%= @incident_report.officer_attested_at.strftime("%d %B %Y à %H:%M UTC") %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

        <%# ═══════════════════════════════════════════════════════════════════════ %>
        <%# FOOTER %>
        <%# ═══════════════════════════════════════════════════════════════════════ %>
        <div class="text-center mt-5 pt-4" style="border-top: 1px solid var(--law-blue);">
          <%# Haiti Flag - Centered %>
          <div class="d-flex justify-content-center mb-3">
            <%= image_tag "haiti_flag.png",
                          alt: "Drapeau d'Haïti",
                          style: "width: 60px; height: auto;" %>
          </div>
          <p class="text-muted small mb-1">
            Document généré le <%= Time.current.strftime("%d %B %Y à %H:%M") %>
          </p>
          <p class="fw-bold small mb-0" style="color: var(--law-blue);">
            Document Officiel - Police Nationale d'Haïti
          </p>
          <p class="text-muted small mb-0" style="font-size: 0.7rem;">
            L'UNION FAIT LA FORCE
          </p>
        </div>

      </div>
    </div>
  </div>
</div>

<%# Fonts %>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
/* CSS Variables matching Officer Profile */
:root {
  --law-blue: #092C73;
  --law-red: #D90718;
  --law-green: #49A64F;
  --law-tan: #BF8360;
  --law-gray: #F2F2F2;
  --dark-gray: #343A40;
  --mid-gray: #6C757D;
}

/* Certificate Base Styles */
.certificate-font { font-family: 'Inter', sans-serif; }
.font-heading-semibold { font-family: 'Montserrat', sans-serif; font-weight: 600; letter-spacing: 0.3px; }
.font-body { font-family: 'Inter', sans-serif; }

/* Certificate Card */
.certificate-card {
  background: linear-gradient(180deg, #fff 0%, #f9f9f9 100%);
  border: 1px solid var(--law-blue) !important;
}


/* Action Buttons */
.action-btn {
  transition: all 0.2s ease-in-out;
}

.action-btn:hover {
  transform: translateY(-2px);
  background-color: #f8f9fa;
}

/* Responsive */
@media (max-width: 768px) {
  .certificate-card .card-body {
    padding: 1.5rem !important;
  }
}

/* Print Styles */
@media print {
  .d-print-none {
    display: none !important;
  }

  body {
    background: white !important;
  }

  .certificate-card {
    box-shadow: none !important;
    border: 1px solid var(--law-blue) !important;
  }

  .container {
    max-width: 100% !important;
    padding: 0 !important;
  }

  #print-area {
    padding: 0 !important;
  }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const shareBtn = document.getElementById("share-certificate");
  const printBtn = document.getElementById("print-certificate");

  if (shareBtn) {
    shareBtn.addEventListener("click", async () => {
      if (navigator.share) {
        try {
          await navigator.share({
            title: "Rapport d'Incident PNH - <%= @incident_report.report_id %>",
            text: "Rapport d'incident officiel de la Police Nationale d'Haïti",
            url: window.location.href
          });
        } catch (e) {
          console.warn(e);
        }
      } else {
        navigator.clipboard.writeText(window.location.href);
        shareBtn.innerHTML = '<i class="ri-check-line text-success fs-4"></i>';
        setTimeout(() => {
          shareBtn.innerHTML = '<i class="ri-share-forward-line fs-4" style="color: var(--law-blue);"></i>';
        }, 2000);
      }
    });
  }

  if (printBtn) {
    printBtn.addEventListener("click", () => window.print());
  }
});
</script>
