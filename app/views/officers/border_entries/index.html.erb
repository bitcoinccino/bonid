<div class="container-fluid mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold text-officer-blue mb-0">Visitor Border Logs</h4>
    <%= link_to "Scan Visitor QR", officers_scan_path, class: "btn btn-primary" %>
  </div>

  <div class="table-responsive bg-white shadow-sm rounded-3 p-3">
    <table class="table table-striped align-middle">
      <thead class="table-light">
        <tr>
          <th>Visitor BonID</th>
          <th>Entry Mode</th>
          <th>Port of Entry</th>
          <th>Entered At</th>
          <th>Exited At</th>
          <th>Officer Unit</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @border_entries.each do |entry| %>
          <tr>
            <td><%= entry.visitor_submission.bonid %></td>
            <td><%= entry.entry_mode.capitalize %></td>
            <td><%= entry.port_of_entry %></td>
            <td><%= l(entry.entered_at, format: :short) %></td>
            <td><%= entry.exited_at ? l(entry.exited_at, format: :short) : "—" %></td>
            <td><%= entry.officer_unit_name %></td>
            <td>
              <% unless entry.exited_at %>
                <%= button_to "Mark Exit",
                      mark_exit_officers_border_entry_path(entry),
                      method: :patch,
                      class: "btn btn-sm btn-outline-danger" %>
              <% else %>
                <span class="badge bg-success">Exited</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
