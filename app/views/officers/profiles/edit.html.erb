<%# app/views/officers/profiles/edit.html.erb %>

<% verified_submission = @officer.user&.identity_submissions&.approved&.last %>

<%# Helper to mask BonID: DV-1989-M-SE-P8697XDS → DV-••••-•-••-P••••XDS %>
<%
  def mask_bonid(bonid)
    return bonid if bonid.blank?
    parts = bonid.split('-')
    return bonid if parts.length < 5

    # Format: INITIALS-YEAR-SEX-DEPT-P+DIGITS+CHECKSUM
    tail = parts.last  # e.g. "P8697XDS"
    masked_parts = [
      parts[0],                                            # Initials (DV)
      '••••',                                              # Year masked
      '•',                                                 # Sex masked
      '••',                                                # Department masked
      "#{tail[0]}••••#{tail[-3..]}"                        # P + masked digits + checksum
    ]
    masked_parts.join('-')
  end
%>

<div class="container-fluid py-4">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0" style="font-family: 'Montserrat', sans-serif; font-size: 1.1rem; font-weight: 600; color: var(--law-blue);">
          <i class="ri-user-settings-line me-2" style="font-size: 1.125rem; font-weight: 400;"></i>My Profile
        </h4>
        <%= link_to officers_dashboard_path, class: "btn btn-outline-secondary", style: "font-family: 'Montserrat', sans-serif; font-size: 0.85rem; font-weight: 500;" do %>
          <i class="ri-arrow-left-line me-1" style="font-size: 1rem; font-weight: 400;"></i>Back to Dashboard
        <% end %>
      </div>
    </div>
  </div>

  <div class="row">
    <%# Left Column - Identity Card (Read-only from BonID) %>
    <div class="col-lg-4 mb-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-4">
          <%# Profile Photo from BonID - Centered %>
          <div class="d-flex justify-content-center mb-3">
            <% if verified_submission&.photo&.attached? %>
              <%= image_tag verified_submission.photo.variant(resize_to_limit: [150, 150]),
                            class: "rounded-circle",
                            style: "width: 120px; height: 120px; min-width: 120px; object-fit: cover; border: 3px solid rgba(9, 44, 115, 0.15);" %>
            <% else %>
              <div class="rounded-circle d-flex align-items-center justify-content-center"
                   style="width: 120px; height: 120px; background: rgba(9, 44, 115, 0.08); border: 3px solid rgba(9, 44, 115, 0.15);">
                <i class="ri-user-line" style="font-size: 2.5rem; color: var(--law-blue); font-weight: 400;"></i>
              </div>
            <% end %>
          </div>

          <div style="font-family: 'Montserrat', sans-serif; font-size: 0.95rem; font-weight: 600; color: var(--dark-gray);"><%= @officer.full_name %></div>
          <div style="font-family: 'Montserrat', sans-serif; font-size: 0.8rem; color: var(--mid-gray); font-style: italic;"><%= @officer.rank %></div>
          <span class="badge mt-2" style="background-color: var(--law-blue); font-size: 0.7rem; font-weight: 500;"><%= @officer.badge_id %></span>

          <%# BonID Status & Details %>
          <div class="pt-3 mt-3" style="border-top: 1px solid rgba(9, 44, 115, 0.1);">
            <% if @officer.user&.bonid_verified? %>
              <div class="d-flex align-items-center justify-content-center">
                <i class="ri-shield-check-fill me-2" style="font-size: 1.125rem; color: var(--law-green); font-weight: 400;"></i>
                <span style="font-family: 'Montserrat', sans-serif; font-size: 0.85rem; font-weight: 500; color: var(--law-green);">BonID Verified</span>
              </div>

              <%# BonID Number (Partially Masked) %>
              <% if verified_submission&.bonid.present? %>
                <div class="mt-3 p-2 rounded" style="background: rgba(9, 44, 115, 0.06);">
                  <small style="font-size: 0.7rem; color: var(--mid-gray);">BonID Number</small>
                  <div style="font-family: monospace; font-size: 0.8rem; font-weight: 500; color: var(--law-blue); letter-spacing: 0.5px;">
                    <%= mask_bonid(verified_submission.bonid) %>
                  </div>
                </div>
              <% end %>

              <%# Expiration Date %>
              <% if verified_submission&.expires_at.present? %>
                <div class="mt-2">
                  <small style="font-size: 0.75rem; color: var(--mid-gray);">
                    <i class="ri-calendar-check-line me-1" style="font-weight: 400;"></i>
                    Expires: <%= verified_submission.expires_at.strftime("%b %d, %Y") %>
                  </small>
                </div>
              <% end %>
            <% else %>
              <div class="d-flex align-items-center justify-content-center">
                <i class="ri-shield-line me-2" style="font-size: 1.125rem; color: var(--officer-warning); font-weight: 400;"></i>
                <span style="font-family: 'Montserrat', sans-serif; font-size: 0.85rem; font-weight: 500; color: var(--officer-warning);">Verification Pending</span>
              </div>
              <small style="font-size: 0.75rem; color: var(--mid-gray);">Complete BonID verification</small>
            <% end %>
          </div>
        </div>
      </div>

      <%# Blood Type & Health Info %>
      <% health_profile = @officer.user&.health_profile %>
      <% if health_profile&.blood_type.present? %>
        <div class="card border-0 shadow-sm mt-4">
          <div class="card-body">
            <h6 class="mb-3" style="font-family: 'Montserrat', sans-serif; font-size: 0.85rem; font-weight: 500; color: var(--law-red);">
              <i class="ri-heart-pulse-line me-2" style="font-weight: 400;"></i>Emergency Info
            </h6>
            <div class="d-flex align-items-center justify-content-between">
              <div>
                <small style="font-size: 0.7rem; color: var(--mid-gray);">Blood Type</small>
                <div style="font-family: 'Montserrat', sans-serif; font-size: 1.25rem; font-weight: 600; color: var(--law-red);"><%= health_profile.blood_type %></div>
              </div>
              <div class="rounded-circle d-flex align-items-center justify-content-center"
                   style="width: 44px; height: 44px; background: rgba(217, 7, 24, 0.08);">
                <i class="ri-drop-fill" style="font-size: 1.25rem; color: var(--law-red); font-weight: 400;"></i>
              </div>
            </div>
            <% if health_profile.organ_donor %>
              <div class="mt-2 pt-2" style="border-top: 1px solid rgba(9, 44, 115, 0.1);">
                <small style="font-size: 0.75rem; color: var(--law-green);">
                  <i class="ri-heart-add-line me-1" style="font-weight: 400;"></i>Registered Organ Donor
                </small>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Partner Info %>
      <div class="card border-0 shadow-sm mt-4">
        <div class="card-body">
          <h6 class="mb-3" style="font-family: 'Montserrat', sans-serif; font-size: 0.85rem; font-weight: 500; color: var(--law-blue);">
            <i class="ri-building-line me-2" style="font-weight: 400;"></i>Assignment
          </h6>
          <div class="d-flex align-items-center">
            <% if @officer.partner&.logo&.attached? %>
              <%= image_tag @officer.partner.logo.variant(resize_to_limit: [40, 40]),
                            class: "rounded me-3",
                            style: "width: 40px; height: 40px; object-fit: cover;" %>
            <% else %>
              <div class="rounded d-flex align-items-center justify-content-center me-3"
                   style="width: 40px; height: 40px; background: rgba(9, 44, 115, 0.08);">
                <i class="ri-shield-star-line" style="color: var(--law-blue); font-weight: 400;"></i>
              </div>
            <% end %>
            <div>
              <div style="font-family: 'Montserrat', sans-serif; font-size: 0.85rem; font-weight: 500; color: var(--dark-gray);"><%= @officer.partner&.name || "PNH" %></div>
              <small style="font-size: 0.75rem; color: var(--mid-gray);"><%= @officer.unit_name %></small>
              <% if @officer.department_directorate.present? %>
                <small style="font-size: 0.7rem; color: var(--mid-gray); display: block; margin-top: 2px;">
                  <i class="ri-map-pin-2-line me-1" style="font-weight: 400;"></i><%= @officer.department_directorate %> — <%= OfficerConstants::DEPARTMENTS[@officer.department_directorate] %>
                </small>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <%# Digital Signature from BonID %>
      <div class="card border-0 shadow-sm mt-4">
        <div class="card-body">
          <h6 class="mb-3" style="font-family: 'Montserrat', sans-serif; font-size: 0.85rem; font-weight: 500; color: var(--law-blue);">
            <i class="ri-pen-nib-line me-2" style="font-weight: 400;"></i>Digital Signature
          </h6>
          <% if verified_submission&.signature&.attached? %>
            <div class="border rounded p-3 bg-white text-center" style="border-color: rgba(9, 44, 115, 0.1) !important;">
              <%= image_tag verified_submission.signature,
                            style: "max-width: 100%; max-height: 80px;",
                            alt: "Officer signature" %>
            </div>
            <small class="d-block mt-2" style="font-size: 0.7rem; color: var(--mid-gray);">
              <i class="ri-shield-check-line me-1" style="font-weight: 400;"></i>Signature from verified BonID
            </small>
          <% elsif verified_submission&.signature_data.present? %>
            <div class="border rounded p-3 bg-white text-center" style="border-color: rgba(9, 44, 115, 0.1) !important;">
              <%= image_tag verified_submission.signature_data,
                            style: "max-width: 100%; max-height: 80px;",
                            alt: "Officer signature" %>
            </div>
            <small class="d-block mt-2" style="font-size: 0.7rem; color: var(--mid-gray);">
              <i class="ri-shield-check-line me-1" style="font-weight: 400;"></i>Signature from verified BonID
            </small>
          <% else %>
            <div class="border rounded p-3 text-center" style="background: rgba(9, 44, 115, 0.04); border-color: rgba(9, 44, 115, 0.1) !important;">
              <i class="ri-pen-nib-line d-block mb-2" style="font-size: 1.75rem; color: var(--mid-gray); font-weight: 400;"></i>
              <small style="font-size: 0.75rem; color: var(--mid-gray);">No signature on file</small>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Right Column - Editable Officer Details %>
    <div class="col-lg-8">
      <%# Unit options JSON for JavaScript %>
      <script type="application/json" id="unit-options-json">
        <%= OfficerConstants::UNIT_OPTIONS.to_json.html_safe %>
      </script>

      <%= form_with model: @officer, url: officers_profile_path, method: :patch, local: true do |f| %>
        <%# Officer Details (Editable) %>
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-white border-0 py-3">
            <h5 class="mb-0" style="font-family: 'Montserrat', sans-serif; font-size: 0.95rem; font-weight: 500; color: var(--law-blue);">
              <i class="ri-shield-star-line me-2" style="font-weight: 400;"></i>Officer Details
            </h5>
          </div>
          <div class="card-body" data-controller="officer-unit">
            <div class="row g-3">
              <div class="col-md-6">
                <%= f.label :badge_id, "Badge ID", class: "form-label", style: "font-family: 'Montserrat', sans-serif; font-size: 0.85rem; font-weight: 500; color: var(--dark-gray);" %>
                <%= f.text_field :badge_id, class: "form-control", readonly: true, style: "background-color: var(--law-gray); font-size: 0.875rem;" %>
                <small style="font-size: 0.7rem; color: var(--mid-gray);">Assigned by administration</small>
              </div>
              <div class="col-md-6">
                <%= f.label :rank, "Rank", class: "form-label", style: "font-family: 'Montserrat', sans-serif; font-size: 0.85rem; font-weight: 500; color: var(--dark-gray);" %>
                <%= f.select :rank,
                    options_for_select(OfficerConstants::RANKS, @officer.rank),
                    { include_blank: "Select Rank" },
                    class: "form-select", required: true, style: "font-size: 0.875rem;" %>
              </div>
              <div class="col-md-6">
                <%= f.label :unit_name, "Unit", class: "form-label", style: "font-family: 'Montserrat', sans-serif; font-size: 0.85rem; font-weight: 500; color: var(--dark-gray);" %>
                <%= f.select :unit_name,
                    options_for_select(OfficerConstants::UNIT_OPTIONS.keys, @officer.unit_name),
                    { include_blank: "Select Unit" },
                    class: "form-select", required: true, style: "font-size: 0.875rem;",
                    data: { officer_unit_target: "unitSelect", action: "change->officer-unit#updateSpecialties" } %>
              </div>
              <div class="col-md-6">
                <%= f.label :unit_type, "Specialty", class: "form-label", style: "font-family: 'Montserrat', sans-serif; font-size: 0.85rem; font-weight: 500; color: var(--dark-gray);" %>
                <%= f.select :unit_type,
                    options_for_select(OfficerConstants::UNIT_OPTIONS[@officer.unit_name] || [], @officer.unit_type),
                    { include_blank: "Select Specialty" },
                    class: "form-select", required: true, style: "font-size: 0.875rem;",
                    data: { officer_unit_target: "specialtySelect" } %>
              </div>
              <div class="col-12">
                <%= f.label :department_directorate, "Jurisdiction (Direction Départementale)", class: "form-label", style: "font-family: 'Montserrat', sans-serif; font-size: 0.85rem; font-weight: 500; color: var(--dark-gray);" %>
                <%= f.select :department_directorate,
                    options_for_select(
                      OfficerConstants::DEPARTMENTS.map { |abbr, name| ["#{abbr} — #{name}", abbr] },
                      @officer.department_directorate
                    ),
                    { include_blank: "Select Directorate" },
                    class: "form-select", style: "font-size: 0.875rem;" %>
                <small style="font-size: 0.7rem; color: var(--mid-gray);">Geographic command structure (e.g. DDO for Port-au-Prince)</small>
              </div>
            </div>
          </div>
        </div>

        <%# Submit Button %>
        <div class="d-flex justify-content-end gap-2">
          <%= link_to "Cancel", officers_dashboard_path, class: "btn btn-outline-secondary", style: "font-family: 'Montserrat', sans-serif; font-size: 0.875rem; font-weight: 500;" %>
          <%= f.submit "Save Changes", class: "btn text-white", style: "background-color: var(--law-blue); font-family: 'Montserrat', sans-serif; font-size: 0.875rem; font-weight: 500;" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
