<%# app/views/officers/onboarding/new.html.erb %>

<div class="officer-form-card" style="max-width: 520px;">
  <%# Icon %>
  <div class="form-icon">
    <%= image_tag "pnh.png", alt: "PNH" %>
  </div>

  <%# Title %>
  <h1>Complete Your Profile</h1>
  <p class="form-subtitle">
    Welcome, <%= @officer.first_name.presence || @officer.email %>! Please provide your official officer details to access the PNH IDPol Portal.
  </p>

  <%# Error Messages %>
  <% if @officer.errors.any? %>
    <div class="alert alert-danger mb-4" role="alert">
      <strong>Please fix the following errors:</strong>
      <ul class="mb-0 ps-3 mt-2">
        <% @officer.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Form %>
  <%= form_for @officer, url: officers_onboarding_path, html: { data: { turbo: false } } do |f| %>

    <%# Section: Personal Info %>
    <div class="mb-4">
      <h6 class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.75rem; letter-spacing: 1px;">
        <i class="ri-user-line me-1"></i> Personal Information
      </h6>

      <div class="row g-3">
        <div class="col-md-6">
          <%= f.label :first_name, "First Name", class: "form-label" %>
          <%= f.text_field :first_name,
                class: "form-control",
                placeholder: "Jean" %>
        </div>
        <div class="col-md-6">
          <%= f.label :last_name, "Last Name", class: "form-label" %>
          <%= f.text_field :last_name,
                class: "form-control",
                placeholder: "Pierre" %>
        </div>
      </div>

      <div class="mt-3">
        <%= f.label :phone_number, "Phone Number", class: "form-label" %>
        <%= f.telephone_field :phone_number,
              class: "form-control",
              placeholder: "+509 XXXX-XXXX" %>
      </div>
    </div>

    <%# Section: Official Details %>
    <div class="mb-4">
      <h6 class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.75rem; letter-spacing: 1px;">
        <i class="ri-shield-star-line me-1"></i> Official Details
      </h6>

      <div class="row g-3">
        <div class="col-md-6">
          <%= f.label :badge_id, "Badge ID", class: "form-label" %>
          <%= f.text_field :badge_id,
                class: "form-control",
                placeholder: "PNH-XXXXX",
                style: "text-transform: uppercase;" %>
          <small class="text-muted">Your official badge number</small>
        </div>
        <div class="col-md-6">
          <%= f.label :rank, "Rank", class: "form-label" %>
          <%= f.select :rank,
                options_for_select([
                  ["Select Rank", ""],
                  ["Agent", "Agent"],
                  ["Brigadier", "Brigadier"],
                  ["Sergent", "Sergent"],
                  ["Adjudant", "Adjudant"],
                  ["Sous-Lieutenant", "Sous-Lieutenant"],
                  ["Lieutenant", "Lieutenant"],
                  ["Capitaine", "Capitaine"],
                  ["Commandant", "Commandant"],
                  ["Colonel", "Colonel"],
                  ["Commissaire", "Commissaire"],
                  ["Commissaire Divisionnaire", "Commissaire Divisionnaire"],
                  ["Inspecteur Général", "Inspecteur Général"],
                  ["Directeur Général", "Directeur Général"]
                ], @officer.rank),
                {},
                class: "form-control form-select" %>
        </div>
      </div>

      <div class="row g-3 mt-1">
        <div class="col-md-6">
          <%= f.label :unit_name, "Unit", class: "form-label" %>
          <%= f.select :unit_name,
                options_for_select(
                  [["Select Unit", ""]] + OfficerConstants::UNIT_OPTIONS.keys.map { |k| [k, k] },
                  @officer.unit_name
                ),
                {},
                class: "form-control form-select",
                data: { controller: "unit", action: "change->unit#updateTypes" } %>
        </div>
        <div class="col-md-6">
          <%= f.label :unit_type, "Unit Type", class: "form-label" %>
          <%= f.select :unit_type,
                options_for_select(
                  [["Select Unit Type", ""]] + OfficerConstants::UNIT_OPTIONS.values.flatten.uniq.map { |t| [t, t] },
                  @officer.unit_type
                ),
                {},
                class: "form-control form-select",
                data: { unit_target: "typeSelect" } %>
        </div>
      </div>
    </div>

    <%# Submit %>
    <%= f.submit "Complete Profile", class: "btn-officer-primary mt-2" %>
  <% end %>

  <%# Info Box %>
  <div class="mt-4 p-3 rounded" style="background: rgba(9, 44, 115, 0.05); border: 1px solid rgba(9, 44, 115, 0.1);">
    <div class="d-flex align-items-start gap-2">
      <i class="ri-lock-line text-primary mt-1"></i>
      <div>
        <strong class="text-dark" style="font-size: 0.875rem;">Your information is secure</strong>
        <p class="text-muted mb-0" style="font-size: 0.8rem;">
          All officer data is encrypted and only accessible to authorized personnel. Your BonID verification ensures identity integrity.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  // Simple unit type filtering
  document.addEventListener('DOMContentLoaded', function() {
    const unitOptions = <%= raw OfficerConstants::UNIT_OPTIONS.to_json %>;
    const unitSelect = document.querySelector('[data-controller="unit"]');
    const typeSelect = document.querySelector('[data-unit-target="typeSelect"]');

    if (unitSelect && typeSelect) {
      unitSelect.addEventListener('change', function() {
        const selectedUnit = this.value;
        const types = unitOptions[selectedUnit] || [];

        // Clear and rebuild type options
        typeSelect.innerHTML = '<option value="">Select Unit Type</option>';
        types.forEach(function(type) {
          const option = document.createElement('option');
          option.value = type;
          option.textContent = type;
          typeSelect.appendChild(option);
        });
      });
    }
  });
</script>
