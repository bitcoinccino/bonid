<%= form_with model: officer, url: partner_portal_officer_invitations_path, local: true do |f| %>
  <div class="mb-3">
    <%= f.label :email, "Officer Email", class: "form-label" %>
    <%= f.email_field :email, class: "form-control", required: true %>
  </div>

  <div class="d-grid">
    <%= f.submit "Invite Officer", class: "btn btn-primary" %>
  </div>
<% end %>
