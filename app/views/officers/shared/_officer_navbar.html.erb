<%# app/views/officers/shared/_officer_navbar.html.erb %>
<nav class="navbar navbar-expand-lg partner-navbar fixed-top shadow-sm">
  <div class="container-fluid px-3 justify-content-between align-items-center">
    <%# Brand + Mobile Toggle %>
    <div class="d-flex align-items-center gap-3">
      <button class="btn d-lg-none text-white sidebar-toggle-btn"
              type="button"
              onclick="document.dispatchEvent(new CustomEvent('partner-sidebar:toggle'))"
              aria-label="Toggle sidebar">
        <i class="ri-menu-line ri-xl"></i>
      </button>
      <%= link_to officers_dashboard_path, class: "navbar-brand d-flex align-items-center gap-2 text-white text-decoration-none" do %>
        <%= image_tag "pnh.png", alt: "BAFE Logo", class: "rounded-circle", style: "width: 36px; height: 36px; object-fit: cover;" %>
        <span class="fw-bold fs-5 font-heading">BAFE</span>
      <% end %>
    </div>

    <%# Smart Search Bar (Desktop only) %>
    <form class="d-none d-lg-flex mx-auto" role="search" style="width: 480px;" action="<%= officers_scan_path %>" method="get">
      <div class="input-group smart-search rounded-pill shadow-sm overflow-hidden bg-white">
        <span class="input-group-text border-0 bg-transparent ps-3">
          <i class="ri-search-line text-muted"></i>
        </span>
        <input type="search"
               name="q"
               class="form-control border-0 ps-0 bg-transparent"
               placeholder="Search BonID or name"
               aria-label="Search BonID or name"
               style="color: var(--dark-gray);">
      </div>
    </form>

    <%# Officer Avatar & Dropdown %>
    <% if current_officer %>
      <div class="dropdown partner-admin-dropdown">
        <a class="d-flex align-items-center text-white text-decoration-none dropdown-toggle"
           href="#"
           id="officerDropdown"
           role="button"
           data-bs-toggle="dropdown"
           aria-expanded="false">
          <%
            # Check photo sources in priority order: verified submission, user, officer
            verified_submission = current_officer&.user&.identity_submissions&.approved&.last
            navbar_photo = if verified_submission&.photo&.attached?
                             verified_submission.photo.variant(resize_to_limit: [36, 36])
                           elsif current_officer&.user&.photo&.attached?
                             current_officer.user.photo.variant(resize_to_limit: [36, 36])
                           elsif current_officer&.photo&.attached?
                             current_officer.photo.variant(resize_to_limit: [36, 36])
                           end
          %>
          <% if navbar_photo %>
            <%= image_tag(
              url_for(navbar_photo),
              class: "rounded-circle shadow-sm",
              style: "width: 36px; height: 36px; object-fit: cover; border: 2px solid var(--white);",
              alt: "#{current_officer.full_name} photo"
            ) %>
          <% else %>
            <div class="bg-light rounded-circle d-flex justify-content-center align-items-center shadow-sm"
                 style="width: 36px; height: 36px; border: 2px solid var(--white); background-color: rgba(255,255,255,0.2) !important;">
              <i class="ri-user-line ri-lg text-white"></i>
            </div>
          <% end %>
        </a>
        <ul class="dropdown-menu dropdown-menu-end mt-2 shadow-sm partner-admin-menu" aria-labelledby="officerDropdown">
          <li class="px-3 py-2 border-bottom">
            <div class="fw-semibold"><%= current_officer.full_name %></div>
            <small class="text-muted"><%= current_officer.rank %> - <%= current_officer.badge_id %></small>
          </li>
          <li>
            <%= link_to officers_dashboard_path, class: "dropdown-item" do %>
              <i class="ri-dashboard-line me-2"></i> Dashboard
            <% end %>
          </li>
          <li>
            <%= link_to officers_profile_edit_path, class: "dropdown-item" do %>
              <i class="ri-user-line me-2"></i> Profile
            <% end %>
          </li>
          <li><hr class="dropdown-divider"></li>
          <li>
            <%= button_to destroy_officer_session_path,
                method: :delete,
                form: { data: { turbo: false } },
                class: "dropdown-item text-danger" do %>
              <i class="ri-logout-box-r-line me-2"></i> Log Out
            <% end %>
          </li>
        </ul>
      </div>
    <% end %>
  </div>
</nav>
