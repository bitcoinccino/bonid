<%- if controller_name != 'sessions' %>
  <%= link_to "Log in", new_officer_session_path %><br />
<% end %>

<%# Officers cannot sign up directly, so hide registration link %>

<%- if devise_mapping.recoverable? && controller_name != 'passwords' %>
  <%= link_to "Forgot your password?", new_officer_password_path %><br />
<% end %>

<%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
  <%= link_to "Didn't receive confirmation instructions?", new_officer_confirmation_path %><br />
<% end %>

<%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
  <%= link_to "Didn't receive unlock instructions?", new_officer_unlock_path %><br />
<% end %>
