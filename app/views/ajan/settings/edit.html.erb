<%# app/views/ajan/settings/edit.html.erb %>
<% content_for(:title, "Pòtay Ajan — Paramèt") %>

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
  <div>
    <h1 class="h3 fw-bold mb-1">Paramèt</h1>
    <p class="text-muted mb-0">Jere kont ou</p>
  </div>
</div>

<div class="card border-0 shadow-sm" style="max-width: 560px;">
  <div class="card-body p-4">
    <h5 class="fw-bold mb-1">
      <i class="ri-mail-line me-2 text-primary"></i>Chanje Imel
    </h5>
    <p class="text-muted small mb-4">
      Imel sa a se kote w ap resevwa kòd yon fwa pou konekte nan pòtay la.
    </p>

    <%= form_with url: ajan_settings_path, method: :patch, local: true, scope: :user do |f| %>
      <div class="mb-3">
        <label class="form-label small fw-semibold text-uppercase text-muted">Imel Aktyèl</label>
        <input type="email" class="form-control" value="<%= @agent.email %>" disabled>
      </div>

      <div class="mb-4">
        <label for="user_email" class="form-label small fw-semibold text-uppercase text-muted">Nouvo Imel</label>
        <%= f.email_field :email, class: "form-control", required: true, autocomplete: "email", placeholder: "nouvo.imel@egzanp.ht" %>
      </div>

      <div class="d-flex justify-content-end gap-2">
        <%= link_to "Anile", ajan_tablo_path, class: "btn btn-outline-secondary" %>
        <%= f.submit "Chanje Imel", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
