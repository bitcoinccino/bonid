<% content_for(:title, "Biwo Elektoral") %>
<div class="card shadow-sm border-0">
  <div class="card-body p-4">
    <h1 class="h4 fw-bold mb-3">Biwo Elektoral</h1>
    <p class="text-muted">
      BED ak BEK (Biwo Elektoral Depatmantal / Kominal) — biwo k ap resevwa votè yo pou enskripsyon.
    </p>

    <% if @electoral_offices.any? %>
      <ul class="list-group">
        <% @electoral_offices.each do |office| %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <div>
              <div class="fw-semibold"><%= office.name %></div>
              <small class="text-muted">
                <%= office.office_type&.upcase %>
                <% if office.address&.locality.present? %>
                  · <%= office.address.locality %>
                <% end %>
              </small>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="alert alert-warning mb-0">Pa gen biwo elektoral ki anrejistre pou kounye a.</div>
    <% end %>
  </div>
</div>
