<% content_for(:title, "Sant Vòt") %>
<div class="card shadow-sm border-0">
  <div class="card-body p-4">
    <h1 class="h4 fw-bold mb-3">Sant Vòt</h1>
    <p class="text-muted">Sant vòt (biwo vòt jou eleksyon) nan rezo a.</p>

    <% if @polling_centers.any? %>
      <ul class="list-group">
        <% @polling_centers.each do |pc| %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <div>
              <div class="fw-semibold"><%= pc.name %></div>
              <small class="text-muted"><%= pc.city %>, <%= pc.state_province %></small>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="alert alert-warning mb-0">Pa gen sant vòt anrejistre.</div>
    <% end %>
  </div>
</div>
