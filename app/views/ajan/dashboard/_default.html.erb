<%# app/views/ajan/dashboard/_default.html.erb %>
<%# Fallback dashboard body — shown for sectors without a dedicated view. %>

<div class="card shadow-sm border-0">
  <div class="card-body p-4">
    <h2 class="h5 fw-bold mb-3">Byenveni nan Pòtay Ajan</h2>
    <p class="text-muted mb-3">
      Sektè <strong><%= current_sector %></strong> an poko gen tablo dedye. Ou ka kòmanse ak aksyon yo anba a.
    </p>

    <div class="d-flex flex-wrap gap-2">
      <%= link_to ajan_scan_path, class: "btn btn-primary", style: "background: #00209F; border-color: #00209F;" do %>
        <i class="ri-qr-scan-2-line me-1"></i> Eskane BonID
      <% end %>
      <%= link_to ajan_verify_path, class: "btn btn-outline-primary" do %>
        <i class="ri-shield-check-line me-1"></i> Verifye Idantite
      <% end %>
    </div>
  </div>
</div>
