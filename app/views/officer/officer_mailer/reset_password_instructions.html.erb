<!-- app/views/officers/mailer/reset_password_instructions.html.erb -->
<!DOCTYPE html>
<html>
<head>
  <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  <style>
    body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
    .container { max-width: 600px; margin: 0 auto; padding: 20px; }
    .logo { width: 80px; height: 80px; object-fit: cover; border-radius: 50%; }
    .btn { display: inline-block; padding: 10px 20px; background: #1e40af; color: #fff; text-decoration: none; border-radius: 25px; }
    .text-primary { color: #1e40af !important; }
  </style>
</head>
<body>
  <div class="container">
    <% if @resource.partner&.logo&.attached? %>
      <%= image_tag @resource.partner.logo.variant(resize_to_limit: [80, 80]).processed, class: "logo", alt: "Police National D'Haiti logo" %>
    <% else %>
      <div style="width: 80px; height: 80px; background: #f0f0f0; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
        <i style="font-size: 2rem; color: #6b7280;">PNH</i>
      </div>
    <% end %>
    <h1 class="text-primary">Reset Your Password</h1>
    <p>Hello <%= @resource.email %>,</p>
    <p>Someone has requested a link to change your password for your PNH officer account. You can do this through the link below.</p>
    <p><%= link_to "Reset Password", edit_officer_password_url(@resource, reset_password_token: @token), class: "btn" %></p>
    <p>If you didn't request this, please ignore this email.</p>
    <p>Your password won't change until you access the link above and create a new one.</p>
  </div>
</body>
</html>