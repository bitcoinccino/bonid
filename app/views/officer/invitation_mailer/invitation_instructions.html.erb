<!-- app/views/officer/invitation_mailer/invitation_instructions.html.erb -->
<h2>👮 Welcome to BonID Officer Portal</h2>

<p>Hello <%= @resource.full_name || "Officer" %>,</p>

<p>
  You have been invited to access the BonID Officer Portal under 
  <strong><%= @partner&.name || "your organization" %></strong>.
</p>

<p>
  Click the button below to accept your invitation and set your password:
</p>

<p>
  <a href="<%= accept_officer_invitation_url(invitation_token: @token) %>" class="btn">
    Accept Invitation
  </a>
</p>

<p>This link will expire after a limited time for security reasons.</p>
