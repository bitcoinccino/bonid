<%# app/views/partner_portal/services/new.html.erb %>
<% content_for(:title) { "Nouvo Sèvis — #{@current_partner.name}" } %>

<%# ── Immersive Top Bar (fixed) ── %>
<div class="ib-topbar">
  <div class="ib-topbar-left">
    <%= link_to partner_portal_services_path, class: "ib-topbar-back" do %>
      <i class="ri-arrow-left-line"></i> Sèvis
    <% end %>
    <span class="ib-topbar-title">
      <i class="ri-add-circle-line"></i> Nouvo Sèvis
    </span>
    <span class="ib-topbar-badge ib-topbar-badge--draft">Bouyon</span>
  </div>

  <div class="ib-topbar-right">
    <button type="submit" form="service-form" class="ib-save-btn">
      <i class="ri-save-line"></i> Kreye
    </button>
  </div>
</div>

<%= render "form_builder",
           service: @service,
           url: partner_portal_services_path,
           method: :post %>
