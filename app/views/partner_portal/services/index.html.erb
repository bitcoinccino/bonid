<%# app/views/partner_portal/services/index.html.erb %>
<% content_for(:title) { "Sèvis — #{@current_partner.name}" } %>

<style>
  .ps-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem; }
  .ps-header h1 { font-family: 'Montserrat', sans-serif; font-size: 1.4rem; font-weight: 700; color: #1a1a2e; margin: 0; }
  .ps-header h1 i { color: var(--bs-primary, #00209F); }
  .ps-add-btn {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.5rem 1.25rem; font-family: 'Montserrat', sans-serif;
    font-size: 0.82rem; font-weight: 700; color: #fff;
    background: var(--bs-primary, #00209F); border: none; border-radius: 0.5rem;
    text-decoration: none !important; transition: background 0.15s;
  }
  .ps-add-btn:hover { background: #001570; color: #fff; }

  .ps-table { width: 100%; border-collapse: separate; border-spacing: 0; background: #fff; border: 1px solid #E5E7EB; border-radius: 0.875rem; overflow: hidden; }
  .ps-table th { font-family: 'Montserrat', sans-serif; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: #6B7280; padding: 0.75rem 1rem; border-bottom: 2px solid #F1F5F9; text-align: left; }
  .ps-table td { padding: 0.875rem 1rem; font-size: 0.85rem; color: #374151; border-bottom: 1px solid #F1F5F9; vertical-align: middle; }
  .ps-table tr:last-child td { border-bottom: none; }
  .ps-table tr:hover td { background: #F8FAFC; }

  .ps-svc-name { font-weight: 600; color: #1a1a2e; display: flex; align-items: center; gap: 0.5rem; }
  .ps-svc-name i { color: var(--bs-primary, #00209F); font-size: 1.1rem; }
  .ps-svc-desc { font-size: 0.75rem; color: #6B7280; margin-top: 0.15rem; }

  .ps-badge { font-size: 0.65rem; font-weight: 600; padding: 3px 8px; border-radius: 6px; display: inline-block; }
  .ps-badge--active { background: #ECFDF5; color: #065F46; }
  .ps-badge--pending { background: #FEF3C7; color: #92400E; }
  .ps-badge--inactive { background: #F3F4F6; color: #6B7280; }
  .ps-badge--free { background: #EFF6FF; color: #1D4ED8; }
  .ps-badge--fixed { background: #F0FDF4; color: #166534; }
  .ps-badge--variable { background: #FFF7ED; color: #9A3412; }
  .ps-badge--verification { background: #ECFDF5; color: #065F46; }
  .ps-badge--document { background: #EFF6FF; color: #1E40AF; }
  .ps-badge--application { background: #FFF7ED; color: #9A3412; }
  .ps-badge--appointment { background: #F5F3FF; color: #5B21B6; }
  .ps-badge--published { background: #ECFDF5; color: #059669; }
  .ps-badge--draft-status { background: #FEF3C7; color: #D97706; }
  .ps-badge--archived { background: #F3F4F6; color: #6B7280; }

  .ps-version { font-size: 0.68rem; color: #6B7280; font-weight: 500; }
  .ps-draft-dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #D97706; margin-left: 4px; }

  .ps-actions { display: flex; gap: 0.25rem; }
  .ps-actions a, .ps-actions button { padding: 0.35rem 0.5rem; font-size: 0.78rem; border-radius: 0.375rem; border: none; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 0.25rem; }
  .ps-btn-edit { background: #EFF6FF; color: #1D4ED8; }
  .ps-btn-edit:hover { background: #DBEAFE; }
  .ps-btn-toggle { background: #F3F4F6; color: #374151; }
  .ps-btn-toggle:hover { background: #E5E7EB; }
  .ps-btn-publish { background: #ECFDF5; color: #059669; }
  .ps-btn-publish:hover { background: #D1FAE5; }
  .ps-btn-delete { background: #FEF2F2; color: #DC2626; }
  .ps-btn-delete:hover { background: #FEE2E2; }

  .ps-empty { text-align: center; padding: 3rem 1rem; background: #fff; border: 1px solid #E5E7EB; border-radius: 0.875rem; }
  .ps-empty i { font-size: 2.5rem; color: #CBD5E1; display: block; margin-bottom: 0.75rem; }
  .ps-empty h3 { font-family: 'Montserrat', sans-serif; font-size: 1rem; font-weight: 600; color: #374151; margin-bottom: 0.5rem; }
  .ps-empty p { font-size: 0.85rem; color: #6B7280; margin-bottom: 1rem; }

  .ps-field-count { font-size: 0.68rem; color: #6B7280; }

  .ps-status-stack { display: flex; align-items: center; gap: 0.35rem; }
  .ps-badge i { font-size: 0.7rem; }

  @media (max-width: 768px) {
    .ps-table th:nth-child(2), .ps-table td:nth-child(2),
    .ps-table th:nth-child(3), .ps-table td:nth-child(3),
    .ps-table th:nth-child(4), .ps-table td:nth-child(4) { display: none; }
  }
</style>

<div class="ps-header">
  <h1><i class="ri-service-line me-2"></i>Sèvis</h1>
  <%= link_to new_partner_portal_service_path, class: "ps-add-btn" do %>
    <i class="ri-add-line"></i> Nouvo Sèvis
  <% end %>
</div>

<% if @services.any? %>
  <table class="ps-table">
    <thead>
      <tr>
        <th>Sèvis</th>
        <th>Kategori</th>
        <th>Pri</th>
        <th>Chan</th>
        <th>Estati</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @services.each do |service| %>
        <tr>
          <td>
            <div class="ps-svc-name">
              <i class="<%= service.service_icon || 'ri-file-text-line' %>"></i>
              <%= service.name %>
            </div>
            <% if service.description.present? %>
              <div class="ps-svc-desc"><%= truncate(service.description, length: 60) %></div>
            <% end %>
          </td>
          <td>
            <% cat_labels = { "verification" => "Verifikasyon", "document" => "Dokiman", "application" => "Aplikasyon", "appointment" => "Randevou", "transaction" => "Tranzaksyon", "survey" => "Sondaj" } %>
            <span class="ps-badge ps-badge--<%= service.service_category || 'application' %>">
              <%= cat_labels[service.service_category] || "Aplikasyon" %>
            </span>
          </td>
          <td>
            <span class="ps-badge ps-badge--<%= service.pricing_type || 'free' %>">
              <%= service.price_display %>
            </span>
          </td>
          <td>
            <span class="ps-field-count">
              <%= service.fields.size %> chan<% if service.steps.any? %> · <%= service.steps.size %> etap<% end %>
            </span>
          </td>
          <td>
            <div class="ps-status-stack">
              <% if service.draft? %>
                <span class="ps-badge ps-badge--draft-status">
                  <i class="ri-draft-line"></i> Bouyon
                </span>
              <% elsif service.published? %>
                <span class="ps-badge ps-badge--published">
                  <i class="ri-check-line"></i> Pibliye
                </span>
                <% if service.has_draft_changes? %>
                  <span class="ps-draft-dot" title="Gen chanjman bouyon ki poko pibliye"></span>
                <% end %>
              <% end %>
            </div>
          </td>
          <td>
            <div class="ps-actions">
              <% if service.draft? %>
                <%= button_to publish_partner_portal_service_path(service),
                      method: :patch, class: "ps-btn-publish",
                      data: { turbo_confirm: "Pibliye sèvis sa a? Sitwayen yo ap kapab wè li." },
                      title: "Pibliye" do %>
                  <i class="ri-upload-2-line"></i>
                <% end %>
              <% end %>

              <%= link_to edit_partner_portal_service_path(service), class: "ps-btn-edit" do %>
                <i class="ri-pencil-line"></i>
              <% end %>

              <%= button_to toggle_partner_portal_service_path(service),
                    method: :patch, class: "ps-btn-toggle",
                    title: service.active? ? "Dezaktive" : "Aktive" do %>
                <i class="<%= service.active? ? 'ri-eye-off-line' : 'ri-eye-line' %>"></i>
              <% end %>

              <%= button_to partner_portal_service_path(service),
                    method: :delete, class: "ps-btn-delete",
                    data: { turbo_confirm: "Ou sèten ou vle retire sèvis sa a?" } do %>
                <i class="ri-delete-bin-line"></i>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="ps-empty">
    <i class="ri-service-line"></i>
    <h3>Ou poko gen sèvis</h3>
    <p>Kreye premye sèvis ou pou sitwayen yo ka jwenn li.</p>
    <%= link_to new_partner_portal_service_path, class: "ps-add-btn" do %>
      <i class="ri-add-line"></i> Kreye Premye Sèvis
    <% end %>
  </div>
<% end %>
