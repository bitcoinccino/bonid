<div class="container-fluid py-4">

  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <h4 class="pp-page-title">
        <i class="ri-building-2-line me-2 pp-text-brand"></i><%= @center.name %>
      </h4>
      <p class="pp-page-subtitle">
        <% if @center.domestic? %>
          <span class="badge bg-success-subtle text-success me-1">Domestik</span>
        <% else %>
          <span class="badge bg-info-subtle text-info me-1">Dyaspora</span>
        <% end %>
        <span class="badge bg-<%= { 'open' => 'success', 'planned' => 'secondary', 'closed' => 'dark' }[@center.status] %> me-1">
          <%= @center.status.capitalize %>
        </span>
      </p>
    </div>
    <div class="d-flex gap-2">
      <%= link_to partner_portal_polling_centers_path, class: "btn btn-link" do %>
        ← Lis
      <% end %>
      <%= link_to edit_partner_portal_polling_center_path(@center), class: "btn btn-outline-primary" do %>
        <i class="ri-edit-2-line me-1"></i>Modifye
      <% end %>
      <%= button_to partner_portal_polling_center_path(@center),
                    method: :delete,
                    class: "btn btn-outline-danger",
                    form: { data: { turbo_confirm: "Èske ou sèten? Sa ap efase #{@center.polling_stations.count} BV." } } do %>
        <i class="ri-delete-bin-line me-1"></i>Efase
      <% end %>
    </div>
  </div>

  <div class="row g-4">
    <%# Center details %>
    <div class="col-lg-5">
      <div class="pp-card card">
        <div class="card-body">
          <h6 class="text-uppercase small fw-semibold text-muted mb-3">Detay Sant</h6>
          <table class="table table-sm mb-0">
            <tbody>
              <tr><td class="text-muted">Adrès</td><td><%= @center.formatted_address.presence || "—" %></td></tr>
              <% if @center.domestic? %>
                <tr><td class="text-muted">Depatman</td><td><%= @center.department&.name || "—" %></td></tr>
                <tr><td class="text-muted">Komin</td><td><%= @center.commune&.name || "—" %></td></tr>
                <tr><td class="text-muted">Seksyon</td><td><%= @center.communal_section&.name || "—" %></td></tr>
              <% else %>
                <tr><td class="text-muted">Misyon</td><td><code><%= @center.diplomatic_mission_id %></code></td></tr>
              <% end %>
              <tr><td class="text-muted">Telefòn</td>
                <td>
                  <% if @center.contact_phone.present? %>
                    <%= link_to @center.contact_phone, "tel:#{@center.contact_phone}" %>
                  <% else %>—<% end %>
                </td></tr>
              <tr><td class="text-muted">Lè Kontak</td><td><%= @center.contact_hours.presence || "—" %></td></tr>
              <tr><td class="text-muted">Priyorite</td><td><%= @center.priority %></td></tr>
              <% if @center.notes.present? %>
                <tr><td class="text-muted">Nòt</td><td class="small"><%= @center.notes %></td></tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <%# BV list %>
    <div class="col-lg-7">
      <div class="pp-card card">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="text-uppercase small fw-semibold text-muted mb-0">
              Biwo Vòt (BV) — <%= @stations.size %>
            </h6>
            <%= link_to new_partner_portal_polling_center_station_path(@center),
                        class: "btn pp-btn-brand btn-sm" do %>
              <i class="ri-add-line me-1"></i>Ajoute BV
            <% end %>
          </div>

          <% if @stations.any? %>
            <table class="table table-hover table-sm mb-0">
              <thead class="table-light">
                <tr>
                  <th>BV #</th>
                  <th>Kapasite</th>
                  <th>Anrejistre</th>
                  <th>Estati</th>
                  <th class="text-end">Aksyon</th>
                </tr>
              </thead>
              <tbody>
                <% @stations.each do |station| %>
                  <tr>
                    <td class="fw-semibold">BV #<%= station.bv_number %></td>
                    <td><%= number_with_delimiter(station.capacity) %></td>
                    <td>
                      <%= number_with_delimiter(station.registered_count) %>
                      <% if station.capacity.positive? %>
                        <span class="text-muted small">(<%= ((station.registered_count.to_f / station.capacity) * 100).round(1) %>%)</span>
                      <% end %>
                    </td>
                    <td>
                      <span class="badge bg-<%= { 'open' => 'success', 'full' => 'warning', 'closed' => 'dark' }[station.status] %>">
                        <%= station.status.capitalize %>
                      </span>
                    </td>
                    <td class="text-end">
                      <%= link_to "Modifye",
                                  edit_partner_portal_polling_center_station_path(@center, station),
                                  class: "btn btn-link btn-sm p-0 me-2" %>
                      <%= button_to partner_portal_polling_center_station_path(@center, station),
                                    method: :delete,
                                    class: "btn btn-link btn-sm p-0 text-danger",
                                    form: { class: "d-inline", data: { turbo_confirm: "Efase BV ##{station.bv_number}?" } } do %>
                        Efase
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <div class="text-center py-4 text-muted">
              <i class="ri-inbox-line fs-1 d-block mb-2"></i>
              Pa gen BV. Klike "Ajoute BV" pou kreye premye a.
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

</div>
