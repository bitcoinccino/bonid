<%= form_with model: officer,
              url: partners_officer_invitations_path,
              method: :post,
              data: { turbo_stream: true },
              html: { id: "single-invite-form", autocomplete: "off", class: "mb-0" } do |f| %>

  <div class="mb-4">
    <%= f.label :email, "Officer Email", class: "form-label fw-semibold" %>
    <%= f.email_field :email, class: "form-control rounded-3", placeholder: "officer@example.com", required: true, autofocus: true %>
    <div class="form-text text-muted mt-1">
      The officer will receive an email invitation to register and complete their BonID.
    </div>
  </div>

  <div class="d-flex align-items-center gap-3 flex-wrap">
    <%= f.submit "Send Invite", class: "btn btn-primary rounded-pill px-4" %>
    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
  </div>
<% end %>
