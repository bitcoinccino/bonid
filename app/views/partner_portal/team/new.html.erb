<div class="container-fluid py-4">
  <div class="row justify-content-center">
    <div class="col-lg-6">
      <div class="mb-4">
        <a href="<%= partner_portal_team_index_path %>" class="text-decoration-none text-muted">
          <i class="ri-arrow-left-line me-1"></i> Retounen nan Ekip
        </a>
      </div>

      <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-primary border-0 rounded-top-4 px-4 py-3">
          <h4 class="fw-bold text-white mb-0">
            <i class="ri-user-add-line me-2"></i> Envite Manm Ekip
          </h4>
        </div>

        <div class="card-body p-4">
          <%# === BONID REQUIREMENT NOTICE === %>
          <div class="alert alert-info border-0 rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-start">
              <i class="ri-shield-check-line ri-lg me-2 mt-1"></i>
              <div>
                <strong>BonID Verifye Obligatwa</strong><br>
                <small>
                  Antre 6 dènye karaktè BonID moun nan. Non ak imèl yo pral chaje
                  otomatikman depi sou dosye verifye yo — pa gen mwayen pou mete fo enfòmasyon.
                </small>
              </div>
            </div>
          </div>

          <%= form_tag lookup_partner_portal_team_index_path, method: :post, class: "needs-validation", novalidate: true do %>
            <%# === BONID LAST 6 === %>
            <div class="mb-4">
              <label for="bonid" class="form-label fw-semibold">6 Dènye Karaktè BonID</label>
              <div class="input-group">
                <span class="input-group-text"><i class="ri-fingerprint-line"></i></span>
                <%= text_field_tag :bonid, params[:bonid],
                    class: "form-control form-control-lg font-monospace text-center",
                    placeholder: "A3F-B2C",
                    required: true,
                    autofocus: true,
                    autocomplete: "off",
                    maxlength: 7,
                    style: "font-size: 20px; min-height: 56px; letter-spacing: 2px; text-transform: uppercase;" %>
              </div>
              <div class="form-text">
                Mande moun nan 6 dènye karaktè BonID yo, oswa eskane kòd QR yo.
              </div>
            </div>

            <%# === SUBMIT === %>
            <div class="d-grid">
              <button type="submit" class="btn btn-primary btn-lg" style="min-height: 48px;">
                <i class="ri-search-line me-1"></i> Chèche Moun Nan
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
