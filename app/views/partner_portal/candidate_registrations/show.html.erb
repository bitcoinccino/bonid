<%# Candidate Registration Detail — CEP Review %>

<div class="container-fluid py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">

      <%= link_to partner_portal_candidate_registrations_path, class: "text-decoration-none mb-3 d-inline-block pp-text-sm" do %>
        <i class="ri-arrow-left-line me-1"></i> Retounen nan lis la
      <% end %>

      <div class="pp-card card">
        <div class="card-body p-4">

          <%# Header %>
          <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
              <h4 class="pp-page-title"><%= @candidate.full_name %></h4>
              <div class="d-flex gap-2">
                <span class="badge bg-light text-dark border pp-badge-sm">
                  <%= @candidate.position.capitalize %>
                </span>
                <span class="badge bg-<%= @candidate.registration_status_color %> pp-badge-sm">
                  <%= @candidate.registration_status_label %>
                </span>
              </div>
            </div>
          </div>

          <%# Details %>
          <table class="table table-sm pp-table-detail">
            <tbody>
              <tr>
                <td>Non konplè</td>
                <td><%= @candidate.full_name %></td>
              </tr>
              <% if @candidate.bonid.present? %>
                <tr>
                  <td>BonID</td>
                  <td><code><%= mask_bonid(@candidate.bonid) %></code></td>
                </tr>
              <% end %>
              <tr>
                <td>Pozisyon</td>
                <td><%= @candidate.position.capitalize %></td>
              </tr>
              <tr>
                <td>Sikonskripsyon</td>
                <td><%= @candidate.election_constituency&.constituency_name || "—" %></td>
              </tr>
              <tr>
                <td>Pati</td>
                <td><%= @candidate.party_name.presence || "Endepandan" %></td>
              </tr>
              <% if @candidate.party_acronym.present? %>
                <tr>
                  <td>Akwonim Pati</td>
                  <td><%= @candidate.party_acronym %></td>
                </tr>
              <% end %>
              <% if @candidate.platform_statement.present? %>
                <tr>
                  <td>Platfòm</td>
                  <td><%= simple_format(@candidate.platform_statement) %></td>
                </tr>
              <% end %>
              <tr>
                <td>Dat soumèt</td>
                <td><%= @candidate.submitted_at&.strftime("%d/%m/%Y %H:%M") || "—" %></td>
              </tr>
              <% if @candidate.approved_at.present? %>
                <tr>
                  <td>Dat apwouve</td>
                  <td><%= @candidate.approved_at.strftime("%d/%m/%Y %H:%M") %></td>
                </tr>
              <% end %>
              <% if @candidate.rejection_reason.present? %>
                <tr>
                  <td>Rezon rejeksyon</td>
                  <td class="pp-text-danger"><%= @candidate.rejection_reason %></td>
                </tr>
              <% end %>
            </tbody>
          </table>

          <%# Review status — read-only.
              Approval authority lives with the CEP; this portal is for
              filing and tracking only. %>
          <% if @candidate.registration_pending? %>
            <hr>
            <div class="alert alert-info small mb-0">
              <i class="ri-time-line me-1"></i>
              <strong>Nan men CEP a.</strong>
              Dosye kandida a soumèt epi ap tann revizyon pa Konsèy Elektoral Pwovizwa.
              W ap resevwa yon notifikasyon lè deseksyon an pran.
            </div>
          <% end %>

          <%# Due-process path — rejected candidates can challenge via BCEN.
              Only open while no dispute has been filed for this candidacy;
              prior filings are summarized (by recepisse) below. %>
          <% if @candidate.registration_status == "rejected" %>
            <hr>
            <%# Match filings by recepisse_number (always unique per candidacy).
                BonID is an additional signal but not all candidates have one. %>
            <% existing_disputes = if @candidate.recepisse_number.present?
                 ElectionDispute
                   .where(election_id: @candidate.election_id)
                   .where("subject ILIKE ?", "%#{@candidate.recepisse_number}%")
                   .order(filed_at: :desc)
               else
                 ElectionDispute.none
               end %>

            <% if existing_disputes.any? %>
              <div class="alert alert-warning small">
                <strong><i class="ri-scales-3-line me-1"></i>Kontestasyon deja depoze</strong>
                <ul class="mb-0 mt-2">
                  <% existing_disputes.each do |d| %>
                    <li>
                      <code><%= d.reference_code %></code> —
                      <%= d.status.titleize %>
                      <% if d.decided? %>
                        (<%= d.decision_type&.titleize %>,
                        <%= d.decided_at&.strftime("%d %b %Y") %>)
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% else %>
              <div class="alert alert-danger small mb-0">
                <div class="mb-2">
                  <strong><i class="ri-error-warning-line me-1"></i>Dosye rejte.</strong>
                  Si w panse desizyon an pa jis, ou gen dwa depoze yon kontestasyon
                  devan Biwo Kontestasyon Elektoral Nasyonal (BCEN).
                </div>
                <%= link_to new_dispute_partner_portal_candidate_registration_path(@candidate),
                            class: "btn btn-danger btn-sm" do %>
                  <i class="ri-scales-3-line me-1"></i>File Kontestasyon
                <% end %>
              </div>
            <% end %>
          <% end %>

        </div>
      </div>

    </div>
  </div>
</div>
