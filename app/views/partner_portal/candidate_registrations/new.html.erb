</div>

<%# Review-step summary — reads form values on step change and fills the review blocks. %>
<script>
  (function () {
    function textOf(name) {
      var el = document.querySelector('[name="election_candidate[' + name + ']"]');
      if (!el) return "";
      if (el.tagName === "SELECT") {
        return el.options[el.selectedIndex]?.text || "";
      }
      return el.value || "";
    }
    function checked(name) {
      var el = document.querySelector('[name="election_candidate[' + name + ']"]');
      return el && el.checked;
    }
    function countDocs() {
      var fields = ["doc_cin_oni","doc_birth_certificate","doc_casier_judiciaire",
        "doc_dgi_receipt","doc_residence_attestation","doc_passport_photos",
        "doc_profession_proof","doc_property_proof","doc_immigration_cert",
        "doc_discharge","doc_party_mandate","doc_support_petition"];
      return fields.filter(checked).length;
    }
    function fillReview() {
      var id = document.getElementById("review-identity");
      if (id) id.textContent = [textOf("full_name"), textOf("cin_number"), textOf("date_of_birth"), textOf("sex")].filter(Boolean).join(" · ") || "—";

      var cand = document.getElementById("review-candidacy");
      if (cand) cand.textContent = [textOf("position"), textOf("candidacy_type"), textOf("party_name") || textOf("party_acronym")].filter(Boolean).join(" · ") || "—";

      var res = document.getElementById("review-residence");
      if (res) res.textContent = [textOf("residence_department"), textOf("residence_commune"), textOf("residence_address")].filter(Boolean).join(" · ") || "—";

      var plat = document.getElementById("review-platform");
      if (plat) {
        var stmt = textOf("platform_statement");
        var snippet = stmt.length > 140 ? stmt.slice(0, 140) + "…" : stmt;
        plat.textContent = (checked("fee_reduced") ? "Frè redui · " : "") + (snippet || "Pa gen platfòm");
      }

      var docs = document.getElementById("review-docs");
      if (docs) docs.textContent = countDocs() + " / 12 dokiman tcheke";
    }
    document.addEventListener("wizard:stepChanged", function (e) {
      if (e.detail && e.detail.step === 6) fillReview();
    });
  })();
</script>

<%# Reset wizard to step 1 on server-side validation errors. %>
<% if @candidate.errors.any? %>
  <script>
    sessionStorage.removeItem("wizard-step:" + window.location.pathname);
  </script>
<% end %>
