<!-- app/views/partner_portal/partner_admin/registrations/new.html.erb -->
<section class="container py-5" role="main" aria-labelledby="invite-partner-admin">
  <div class="text-center mb-4">
    <h1 id="invite-partner-admin" class="h4 fw-bold text-primary">
      Invite Partner Admin
    </h1>
    <p class="text-muted small">Send an invitation link for the partner admin to activate their BonID account.</p>
  </div>

  <div class="row justify-content-center">
    <div class="col-md-6">
      <%= simple_form_for :user,
          url: partner_admin_registration_path(partner_id: @partner&.id),
          html: { class: "card shadow-sm p-4" } do |f| %>
        <%= f.input :email, label: "Admin Email", placeholder: "example@partner.org", required: true %>
        <div class="text-center mt-3">
          <%= f.button :submit, "Send Invitation", class: "btn btn-primary w-100" %>
        </div>
      <% end %>
    </div>
  </div>
</section>
