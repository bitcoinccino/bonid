<%# app/views/partner_portal/shared/navbars/_navbar_default.html.erb %>
<%# BonGouv navbar — dynamic partner branding with USWDS banner pattern %>
<nav class="navbar navbar-expand-lg partner-navbar fixed-top shadow-sm"
     style="background: #0d132d; border: none;">
  <div class="container-fluid px-3 justify-content-between align-items-center partner-navbar-inner">
    <%# Brand + Mobile Toggle %>
    <div class="d-flex align-items-center gap-3">
      <button class="btn d-lg-none text-white sidebar-toggle-btn"
              type="button"
              onclick="document.dispatchEvent(new CustomEvent('partner-sidebar:toggle'))"
              aria-label="Toggle sidebar">
        <i class="ri-menu-line ri-xl"></i>
      </button>

      <%# Partner logo + name + abbreviation (desktop only) %>
      <% if @current_partner.present? %>
        <div class="d-none d-lg-flex align-items-center gap-3">
          <% has_logo = @current_partner.logo.attached? rescue false %>
          <% if has_logo %>
            <%= image_tag(
              url_for(@current_partner.logo.variant(resize_to_limit: [40, 40])),
              style: "width: 40px; height: 40px; object-fit: cover; border-radius: 50%;",
              alt: @current_partner.name
            ) %>
          <% else %>
            <div style="width: 40px; height: 40px; border-radius: 8px; background: rgba(255,255,255,0.15); border: 2px solid rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 15px; font-weight: 700;">
              <%= @current_partner.name.to_s.strip.first(1).upcase %>
            </div>
          <% end %>
          <% partner_name = @current_partner.name.to_s.strip %>
          <% abbr_match = partner_name.match(/\s*\(([A-Z]{2,})\)\s*/) %>
          <div style="display: flex; flex-direction: column; line-height: 1.2;">
            <span style="color: #fff; font-size: 14px; font-weight: 600; letter-spacing: -0.01em; max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
              <%= abbr_match ? partner_name.sub(abbr_match[0], "").strip : partner_name %>
            </span>
            <% if abbr_match %>
              <span style="color: rgba(255,255,255,0.5); font-size: 11px; font-weight: 600; letter-spacing: 0.05em;">
                <%= abbr_match[1] %>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <%# Right side: greeting + dropdown %>
    <div class="d-flex align-items-center gap-3">
      <span class="d-none d-md-inline" style="font-size: 0.82rem; color: rgba(255,255,255,0.7);">
        Byenveni, <strong style="color: #fff;"><%= current_partner_admin&.first_name || @current_partner&.contact_person || "Admin" %></strong>
      </span>

      <% if current_partner_admin %>
        <div class="dropdown partner-admin-dropdown">
          <a class="d-flex align-items-center text-white text-decoration-none dropdown-toggle"
             href="#"
             id="partnerAdminDropdown"
             role="button"
             data-bs-toggle="dropdown"
             aria-expanded="false">
            <% has_dropdown_logo = @current_partner&.logo&.attached? rescue false %>
            <% if has_dropdown_logo %>
              <%= image_tag(
                url_for(@current_partner.logo.variant(resize_to_limit: [36, 36])),
                style: "width: 36px; height: 36px; object-fit: cover; border-radius: 50%;",
                alt: @current_partner&.name
              ) %>
            <% else %>
              <div class="rounded-circle d-flex justify-content-center align-items-center"
                   style="width: 36px; height: 36px; background: rgba(255,255,255,0.15); color: #fff; font-size: 14px; font-weight: 700;">
                <%= (@current_partner&.name || "A").strip.first(1).upcase %>
              </div>
            <% end %>
          </a>
          <ul class="dropdown-menu dropdown-menu-end mt-2 shadow-sm partner-admin-menu" aria-labelledby="partnerAdminDropdown">
            <li class="px-3 py-2 border-bottom">
              <div class="fw-semibold"><%= current_partner_admin&.first_name || @current_partner&.contact_person || "Partner Admin" %></div>
              <small class="text-muted"><%= @current_partner&.name || "Partner" %></small>
            </li>
            <li>
              <%= link_to partner_portal_dashboard_path, class: "dropdown-item" do %>
                <i class="ri-dashboard-line me-2"></i> Dashboard
              <% end %>
            </li>
            <li>
              <%= link_to edit_partner_portal_partner_admin_profile_path, class: "dropdown-item" do %>
                <i class="ri-user-line me-2"></i> Profile
              <% end %>
            </li>
            <li>
              <%= link_to partner_portal_settings_path, class: "dropdown-item" do %>
                <i class="ri-settings-3-line me-2"></i> Settings
              <% end %>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <%= button_to destroy_partner_admin_session_path, method: :delete, class: "dropdown-item text-danger" do %>
                <i class="ri-logout-box-r-line me-2"></i> Log Out
              <% end %>
            </li>
          </ul>
        </div>
      <% end %>
    </div>
  </div>
</nav>
