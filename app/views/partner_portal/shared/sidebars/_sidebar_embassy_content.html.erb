<%# app/views/partner_portal/shared/sidebars/_sidebar_embassy_content.html.erb %>
<%# Sidebar for Embassy / Consulate / MHAVE partners %>

<%# Mobile backdrop %>
<div class="partner-sidebar-backdrop d-lg-none"
     data-action="click->partner-sidebar#close"
     id="partnerSidebarBackdrop"
     style="display:none"></div>

<%# Sidebar %>
<div class="partner-sidebar" id="partnerSidebar" data-controller="partner-sidebar">
  <%# Mobile close button %>
  <button type="button"
          class="sidebar-close-btn d-lg-none"
          data-action="click->partner-sidebar#close"
          aria-label="Close sidebar">
    <i class="ri-close-line"></i>
  </button>

  <%# Navigation links %>
  <ul class="nav flex-column sidebar-nav">

    <%# ── OPERASYON — Daily workflow ────────────────────── %>
    <li class="sidebar-section-label">Operasyon</li>

    <li class="nav-item">
      <%= link_to partner_portal_dashboard_path,
                  class: "nav-link #{'active' if current_page?(partner_portal_dashboard_path)}" do %>
        <i class="ri-home-4-line"></i>
        <span>Akèy</span>
      <% end %>
    </li>

    <li class="nav-item">
      <%= link_to partner_portal_scans_path,
                  class: "nav-link #{'active' if request.path.include?('scans') || request.path.include?('bonid_lookups')}" do %>
        <i class="ri-qr-scan-2-line"></i>
        <span>Eskanè</span>
      <% end %>
    </li>

    <li class="nav-item">
      <%= link_to partner_portal_services_path,
                  class: "nav-link #{'active' if request.path.include?('services')}" do %>
        <i class="ri-service-line"></i>
        <span>Sèvis</span>
      <% end %>
    </li>

    <%# Diaspora Registry — MHAVE's core mission %>
    <li class="nav-item">
      <a href="#" class="nav-link disabled" aria-disabled="true">
        <i class="ri-global-line"></i>
        <span>Dyaspora</span>
        <span class="badge bg-info-subtle text-info rounded-pill ms-auto" style="font-size:0.55rem;">Byento</span>
      </a>
    </li>

    <%# Document requests — CIN, passport, consular ID consolidated %>
    <li class="nav-item">
      <a href="#" class="nav-link disabled" aria-disabled="true">
        <i class="ri-file-list-3-line"></i>
        <span>Dokiman</span>
        <span class="badge bg-info-subtle text-info rounded-pill ms-auto" style="font-size:0.55rem;">Byento</span>
      </a>
    </li>

    <%# ── ELEKSYON — Voting (August 2026) ───────────────── %>
    <li class="sidebar-section-label">Eleksyon</li>

    <%# Voter eligibility check — uses existing voter_eligibility controller %>
    <li class="nav-item">
      <%= link_to partner_portal_voter_eligibility_path,
                  class: "nav-link #{'active' if request.path.include?('voter_eligibility')}" do %>
        <i class="ri-checkbox-circle-line"></i>
        <span>Elijibilite</span>
      <% end %>
    </li>

    <%# Electoral calendar — view CEP's 13-phase timeline %>
    <li class="nav-item">
      <%= link_to partner_portal_electoral_calendar_path,
                  class: "nav-link #{'active' if request.path.include?('electoral_calendar')}" do %>
        <i class="ri-calendar-check-line"></i>
        <span>Kalandriye</span>
      <% end %>
    </li>

    <%# Consulate voting station status %>
    <li class="nav-item">
      <a href="#" class="nav-link disabled" aria-disabled="true">
        <i class="ri-government-line"></i>
        <span>Estasyon</span>
        <span class="badge bg-info-subtle text-info rounded-pill ms-auto" style="font-size:0.55rem;">Byento</span>
      </a>
    </li>

    <%# ── RAPO — Reporting & intelligence ──────────────── %>
    <li class="sidebar-section-label">Rapo</li>

    <li class="nav-item">
      <%= link_to partner_portal_analytics_path,
                  class: "nav-link #{'active' if request.path.include?('analytics')}" do %>
        <i class="ri-bar-chart-box-line"></i>
        <span>Analitik</span>
      <% end %>
    </li>

    <li class="nav-item">
      <%= link_to partner_portal_partner_audit_logs_path,
                  class: "nav-link #{'active' if request.path.include?('partner_audit_logs')}" do %>
        <i class="ri-shield-check-line"></i>
        <span>Jounal</span>
        <% mismatch_count = @current_partner&.partner_audit_logs&.where(event: "identity_mismatch")&.where("created_at >= ?", 24.hours.ago)&.count || 0 %>
        <% if mismatch_count > 0 %>
          <span class="badge bg-danger rounded-pill ms-auto"><%= mismatch_count %></span>
        <% end %>
      <% end %>
    </li>

    <%# ── JESYON — Admin & configuration ───────────────── %>
    <li class="sidebar-section-label">Jesyon</li>

    <li class="nav-item">
      <%= link_to partner_portal_team_index_path,
                  class: "nav-link #{'active' if request.path.include?('team')}" do %>
        <i class="ri-team-line"></i>
        <span>Ekip</span>
      <% end %>
    </li>

    <li class="nav-item">
      <%= link_to partner_portal_api_keys_path,
                  class: "nav-link #{'active' if request.path.include?('api_keys')}" do %>
        <i class="ri-code-s-slash-line"></i>
        <span>API</span>
      <% end %>
    </li>

    <li class="nav-item">
      <%= link_to partner_portal_billing_path,
                  class: "nav-link #{'active' if request.path.include?('billing') || request.path.include?('credits')}" do %>
        <i class="ri-wallet-3-line"></i>
        <span>Faktirasyon</span>
        <span class="badge bg-success-subtle text-success rounded-pill ms-auto" style="font-size: 0.65rem;">
          <%= number_with_delimiter(@current_partner&.credit_balance.to_i) %> kredi
        </span>
      <% end %>
    </li>

    <li class="sidebar-divider"></li>

    <li class="nav-item">
      <%= link_to partner_portal_settings_path,
                  class: "nav-link #{'active' if request.path.include?('settings')}" do %>
        <i class="ri-settings-3-line"></i>
        <span>Paramèt</span>
      <% end %>
    </li>
  </ul>

  <%# Logout button %>
  <div class="sidebar-logout">
    <%= button_to destroy_partner_admin_session_path,
                  method: :delete,
                  class: "logout-btn" do %>
      <i class="ri-logout-box-r-line"></i>
      <span>Dekonekte</span>
    <% end %>
  </div>
</div>
