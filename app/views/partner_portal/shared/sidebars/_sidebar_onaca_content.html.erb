<%# app/views/partner_portal/shared/sidebars/_sidebar_onaca_content.html.erb %>
<%# Sidebar for Office National du Cadastre (ONACA) %>

<%# Mobile backdrop %>
<div class="partner-sidebar-backdrop d-lg-none"
     data-action="click->partner-sidebar#close"
     id="partnerSidebarBackdrop"
     style="display:none"></div>

<%# Sidebar %>
<div class="partner-sidebar" id="partnerSidebar" data-controller="partner-sidebar">
  <%# Mobile close button %>
  <button type="button"
          class="sidebar-close-btn d-lg-none"
          data-action="click->partner-sidebar#close"
          aria-label="Close sidebar">
    <i class="ri-close-line"></i>
  </button>

  <%# Navigation links %>
  <ul class="nav flex-column sidebar-nav">

    <%# ── OPERATIONS ────────────────────────────── %>
    <li class="sidebar-section-label">Operasyon</li>

    <li class="nav-item">
      <%= link_to partner_portal_dashboard_path,
                  class: "nav-link #{'active' if current_page?(partner_portal_dashboard_path)}" do %>
        <i class="ri-dashboard-line"></i>
        <span>Dashboard</span>
      <% end %>
    </li>

    <%# Sèvis (Service Builder) %>
    <li class="nav-item">
      <%= link_to partner_portal_services_path,
                  class: "nav-link #{'active' if request.path.include?('services')}" do %>
        <i class="ri-service-line"></i>
        <span>Sèvis</span>
      <% end %>
    </li>

    <li class="nav-item">
      <%= link_to partner_portal_scans_path,
                  class: "nav-link #{'active' if request.path.include?('scans')}" do %>
        <i class="ri-qr-scan-2-line"></i>
        <span>Scan BonID</span>
      <% end %>
    </li>

    <%# Land Titles — uses existing verifications filtered to property %>
    <li class="nav-item">
      <%= link_to partner_portal_verifications_path(record_type: "property"),
                  class: "nav-link #{'active' if request.path.include?('verifications') && params[:record_type] == 'property'}" do %>
        <i class="ri-map-pin-line"></i>
        <span>Tit Tere</span>
      <% end %>
    </li>

    <%# Land Transactions %>
    <li class="nav-item">
      <%= link_to partner_portal_verifications_path(record_type: "land_transaction"),
                  class: "nav-link #{'active' if params[:record_type] == 'land_transaction'}" do %>
        <i class="ri-exchange-line"></i>
        <span>Tranzaksyon Tere</span>
      <% end %>
    </li>

    <li class="nav-item">
      <%= link_to partner_portal_team_index_path,
                  class: "nav-link #{'active' if request.path.include?('team')}" do %>
        <i class="ri-team-line"></i>
        <span>Ekip</span>
      <% end %>
    </li>

    <%# ── CADASTRE ──────────────────────────────── %>
    <li class="sidebar-section-label">Kadast</li>

    <%# Property Records — existing schema route %>
    <li class="nav-item">
      <%= link_to partner_portal_schemas_path,
                  class: "nav-link #{'active' if request.path.include?('schemas')}" do %>
        <i class="ri-file-code-line"></i>
        <span>Schema Propriyete</span>
      <% end %>
    </li>

    <%# Survey Queue — placeholder %>
    <li class="nav-item">
      <a href="#" class="nav-link disabled" aria-disabled="true">
        <i class="ri-ruler-line"></i>
        <span>Apantaj</span>
        <span class="badge bg-secondary ms-auto" style="font-size: 0.6rem;">Byento</span>
      </a>
    </li>

    <li class="nav-item">
      <%= link_to partner_portal_analytics_path,
                  class: "nav-link #{'active' if request.path.include?('analytics')}" do %>
        <i class="ri-bar-chart-box-line"></i>
        <span>Analitik</span>
      <% end %>
    </li>

    <%# ── API & BILLING ─────────────────────────── %>
    <li class="sidebar-section-label">API & Faktirasyon</li>

    <li class="nav-item">
      <%= link_to partner_portal_api_keys_path,
                  class: "nav-link #{'active' if request.path.include?('api_keys')}" do %>
        <i class="ri-code-s-slash-line"></i>
        <span>API</span>
      <% end %>
    </li>

    <li class="nav-item">
      <%= link_to partner_portal_settings_path,
                  class: "nav-link #{'active' if request.path.include?('settings')}" do %>
        <i class="ri-settings-3-line"></i>
        <span>Paramèt</span>
      <% end %>
    </li>

    <li class="sidebar-divider"></li>

    <li class="nav-item">
      <%= link_to partner_portal_credits_path,
                  class: "nav-link #{'active' if request.path.include?('credits')}" do %>
        <i class="ri-coin-line"></i>
        <span>Kredi</span>
        <% if @current_partner&.credit_balance.to_d > 0 %>
          <span class="badge bg-success rounded-pill ms-auto" style="font-size: 0.65rem;">
            $<%= number_with_precision(@current_partner.credit_balance, precision: 2) %>
          </span>
        <% end %>
      <% end %>
    </li>

    <li class="nav-item">
      <%= link_to partner_portal_billing_path,
                  class: "nav-link #{'active' if request.path.include?('billing')}" do %>
        <i class="ri-money-dollar-circle-line"></i>
        <span>Faktirasyon</span>
      <% end %>
    </li>
  </ul>

  <%# Logout button %>
  <div class="sidebar-logout">
    <%= button_to destroy_partner_admin_session_path,
                  method: :delete,
                  class: "logout-btn" do %>
      <i class="ri-logout-box-r-line"></i>
      <span>Dekonekte</span>
    <% end %>
  </div>
</div>
