<%# app/views/partner_portal/shared/sidebars/_sidebar_cep_content.html.erb %>
<%# Sidebar for Conseil Electoral Provisoire (CEP) %>

<%# Mobile backdrop %>
<div class="partner-sidebar-backdrop d-lg-none"
     data-action="click->partner-sidebar#close"
     id="partnerSidebarBackdrop"
     style="display:none"></div>

<%# Sidebar %>
<div class="partner-sidebar" id="partnerSidebar" data-controller="partner-sidebar">
  <%# Mobile close button %>
  <button type="button"
          class="sidebar-close-btn d-lg-none"
          data-action="click->partner-sidebar#close"
          aria-label="Close sidebar">
    <i class="ri-close-line"></i>
  </button>

  <%# Navigation links %>
  <ul class="nav flex-column sidebar-nav">

    <%# ── OPERATIONS ────────────────────────────── %>
    <li class="sidebar-section-label">Operasyon</li>

    <li class="nav-item">
      <%= link_to partner_portal_dashboard_path,
                  class: "nav-link #{'active' if current_page?(partner_portal_dashboard_path)}" do %>
        <i class="ri-dashboard-line"></i>
        <span>Dashboard</span>
      <% end %>
    </li>

    <li class="nav-item">
      <%= link_to partner_portal_team_index_path,
                  class: "nav-link #{'active' if request.path.include?('team')}" do %>
        <i class="ri-team-line"></i>
        <span>Ekip</span>
      <% end %>
    </li>

    <%# ── ELECTIONS ──────────────────────────────── %>
    <li class="sidebar-section-label">Eleksyon</li>

    <% cep_election = BonvoteElection.order(created_at: :desc).first %>
    <% cep_election_id = cep_election&.id || "1" %>
    <% current_phase = cep_election ? ElectoralCalendar.current_phase(cep_election) : nil %>

    <%# Current Phase Indicator %>
    <% if current_phase %>
      <li class="nav-item px-3 mb-2">
        <div class="pp-phase-indicator">
          <div class="pp-phase-label">Faz aktyèl</div>
          <div class="pp-phase-name"><%= current_phase.phase_label %></div>
          <div class="progress">
            <div class="progress-bar" role="progressbar" style="width: <%= current_phase.progress_percentage %>%;"></div>
          </div>
        </div>
      </li>
    <% end %>

    <%# Jere Eleksyon + Kalandriye: hidden from sidebar 2026-04-20.
        Not core to v1 (verify + register voters). One seeded election
        record is enough; full CRUD + phase calendar return later.
        Controllers stay routed. %>

    <%# Tablo CEP / Seremoni Siyati / Rezilta: removed from CEP sidebar
        2026-04-20 per BonVote v1 scope (verify + register voters only).
        Controllers stay routed behind `FEATURE_BONVOTE_TALLY` for a
        possible future pilot; no nav surface in v1. %>

    <%# Electoral Roll %>
    <li class="nav-item">
      <%= link_to partner_portal_voter_registry_path,
                  class: "nav-link #{'active' if request.path.include?('voter_registry')}" do %>
        <i class="ri-file-list-3-line"></i>
        <span>Lis Elektoral</span>
        <% voter_count = cep_election ? VoterEligibilityRecord.where(bonvote_election: cep_election).eligible.count : 0 %>
        <% if voter_count > 0 %>
          <span class="badge bg-primary rounded-pill ms-auto" style="font-size: 0.6rem;"><%= number_with_delimiter(voter_count) %></span>
        <% end %>
      <% end %>
    </li>

    <%# Electoral Offices (BED / BEK) — CEP's permanent field offices.
        Distinct from Sant Vòt (election-day venues): BED/BEK are year-round
        and where citizens go for registration help, dispute filing, etc. %>
    <li class="nav-item">
      <%= link_to partner_portal_electoral_offices_path,
                  class: "nav-link #{'active' if request.path.include?('electoral_offices')}" do %>
        <i class="ri-building-line"></i>
        <span>Biwo Elektoral</span>
        <% bek_count = ElectoralOffice.count rescue 0 %>
        <% if bek_count > 0 %>
          <span class="badge bg-primary rounded-pill ms-auto" style="font-size: 0.6rem;"><%= bek_count %></span>
        <% end %>
      <% end %>
    </li>

    <%# Diplomatic Vote (diaspora verify+register via embassies/consulates).
        Core to BonVote v1 — diaspora registration is a headline feature.
        Label in English "Diplomatic Vote" per product decision 2026-04-20
        so the purpose reads clearly to international partners. %>
    <li class="nav-item">
      <%= link_to partner_portal_diplomatic_missions_path,
                  class: "nav-link #{'active' if request.path.include?('diplomatic_missions')}" do %>
        <i class="ri-global-line"></i>
        <span>Diplomatic Vote</span>
      <% end %>
    </li>

    <%# Kandida, Pati Politik: hidden from sidebar 2026-04-20 per
        BonVote v1 scope — verify + register voters only. Controllers
        stay routed. %>

    <%# Sant Vòt (polling centers — election-day venues).
        Structurally linked to BEK (commune office oversees its polling
        centers). Active in v1 for configuration even though vote-casting
        remains paused behind FEATURE_BONVOTE_TALLY. %>
    <li class="nav-item">
      <%= link_to partner_portal_polling_centers_path,
                  class: "nav-link #{'active' if request.path.include?('polling_centers')}" do %>
        <i class="ri-map-pin-line"></i>
        <span>Sant Vòt</span>
      <% end %>
    </li>

    <li class="nav-item">
      <%= link_to partner_portal_analytics_path,
                  class: "nav-link #{'active' if request.path.include?('analytics')}" do %>
        <i class="ri-bar-chart-box-line"></i>
        <span>Analitik</span>
      <% end %>
    </li>

    <li class="nav-item">
      <%= link_to election_verify_receipt_path,
                  target: "_blank",
                  rel: "noopener",
                  class: "nav-link" do %>
        <i class="ri-shield-check-line"></i>
        <span>Verifye Resi</span>
      <% end %>
    </li>

    <%# ── API & BILLING ─────────────────────────── %>
    <li class="sidebar-section-label">API & Faktirasyon</li>

    <li class="nav-item">
      <%= link_to partner_portal_api_keys_path,
                  class: "nav-link #{'active' if request.path.include?('api_keys')}" do %>
        <i class="ri-code-s-slash-line"></i>
        <span>API</span>
      <% end %>
    </li>

    <li class="nav-item">
      <%= link_to partner_portal_settings_path,
                  class: "nav-link #{'active' if request.path.include?('settings')}" do %>
        <i class="ri-settings-3-line"></i>
        <span>Paramèt</span>
      <% end %>
    </li>

    <li class="sidebar-divider"></li>

    <li class="nav-item">
      <%= link_to partner_portal_credits_path,
                  class: "nav-link #{'active' if request.path.include?('credits')}" do %>
        <i class="ri-coin-line"></i>
        <span>Kredi</span>
        <% if @current_partner&.credit_balance.to_d > 0 %>
          <span class="badge bg-success rounded-pill ms-auto" style="font-size: 0.65rem;">
            $<%= number_with_precision(@current_partner.credit_balance, precision: 2) %>
          </span>
        <% end %>
      <% end %>
    </li>

    <li class="nav-item">
      <%= link_to partner_portal_billing_path,
                  class: "nav-link #{'active' if request.path.include?('billing')}" do %>
        <i class="ri-money-dollar-circle-line"></i>
        <span>Faktirasyon</span>
      <% end %>
    </li>
  </ul>

  <%# Logout button %>
  <div class="sidebar-logout">
    <%= button_to destroy_partner_admin_session_path,
                  method: :delete,
                  class: "logout-btn" do %>
      <i class="ri-logout-box-r-line"></i>
      <span>Dekonekte</span>
    <% end %>
  </div>
</div>
