<%# app/views/partner_portal/shared/sidebars/_sidebar_cep_content.html.erb %>
<%# Sidebar for Conseil Electoral Provisoire (CEP) %>

<%# Mobile backdrop %>
<div class="partner-sidebar-backdrop d-lg-none"
     data-action="click->partner-sidebar#close"
     id="partnerSidebarBackdrop"
     style="display:none"></div>

<%# Sidebar %>
<div class="partner-sidebar" id="partnerSidebar" data-controller="partner-sidebar">
  <%# Mobile close button %>
  <button type="button"
          class="sidebar-close-btn d-lg-none"
          data-action="click->partner-sidebar#close"
          aria-label="Close sidebar">
    <i class="ri-close-line"></i>
  </button>

  <%# Navigation links %>
  <ul class="nav flex-column sidebar-nav">

    <%# ── OPERATIONS ────────────────────────────── %>
    <li class="sidebar-section-label">Operasyon</li>

    <li class="nav-item">
      <%= link_to partner_portal_dashboard_path,
                  class: "nav-link #{'active' if current_page?(partner_portal_dashboard_path)}" do %>
        <i class="ri-dashboard-line"></i>
        <span>Dashboard</span>
      <% end %>
    </li>

    <li class="nav-item">
      <%= link_to partner_portal_team_index_path,
                  class: "nav-link #{'active' if request.path.include?('team')}" do %>
        <i class="ri-team-line"></i>
        <span>Ekip</span>
      <% end %>
    </li>

    <%# ── ELECTIONS ──────────────────────────────── %>
    <li class="sidebar-section-label">Eleksyon</li>

    <% cep_election = BonvoteElection.order(created_at: :desc).first %>
    <% cep_election_id = cep_election&.id || "1" %>
    <% current_phase = cep_election ? ElectoralCalendar.current_phase(cep_election) : nil %>

    <%# Current Phase Indicator %>
    <% if current_phase %>
      <li class="nav-item px-3 mb-2">
        <div class="pp-phase-indicator">
          <div class="pp-phase-label">Faz aktyèl</div>
          <div class="pp-phase-name"><%= current_phase.phase_label %></div>
          <div class="progress">
            <div class="progress-bar" role="progressbar" style="width: <%= current_phase.progress_percentage %>%;"></div>
          </div>
        </div>
      </li>
    <% end %>

    <%# Eleksyon (Manage Elections) %>
    <li class="nav-item">
      <%= link_to partner_portal_elections_path,
                  class: "nav-link #{'active' if request.path.include?('elections')}" do %>
        <i class="ri-government-line"></i>
        <span>Jere Eleksyon</span>
      <% end %>
    </li>

    <%# Kalandriye (Electoral Calendar) %>
    <li class="nav-item">
      <%= link_to partner_portal_electoral_calendar_path,
                  class: "nav-link #{'active' if request.path.include?('electoral_calendar')}" do %>
        <i class="ri-calendar-event-line"></i>
        <span>Kalandriye</span>
      <% end %>
    </li>

    <% if cep_election %>
      <%# Tablo CEP (Live Dashboard) %>
      <li class="nav-item">
        <%= link_to partner_portal_election_tablo_path(cep_election_id),
                    class: "nav-link #{'active' if request.path.include?('tablo')}" do %>
          <i class="ri-pie-chart-line"></i>
          <span>Tablo CEP</span>
          <% if cep_election.open? %>
            <span class="badge bg-success rounded-pill ms-auto" style="font-size: 0.6rem;">LIVE</span>
          <% end %>
        <% end %>
      </li>

      <%# Seremoni Siyati (Multi-Sig Ceremony) %>
      <li class="nav-item">
        <%= link_to partner_portal_election_multi_sig_path(cep_election_id),
                    class: "nav-link #{'active' if request.path.include?('multi_sig')}" do %>
          <i class="ri-key-2-line"></i>
          <span>Seremoni Siyati</span>
          <% sig_count = ElectionSignature.where(election_id: cep_election_id).count rescue 0 %>
          <% if sig_count > 0 %>
            <span class="badge bg-warning text-dark rounded-pill ms-auto" style="font-size: 0.6rem;"><%= sig_count %>/<%= ElectionSignature::QUORUM %></span>
          <% end %>
        <% end %>
      </li>

      <%# Rezilta (Results) %>
      <li class="nav-item">
        <%= link_to partner_portal_election_results_path(cep_election_id),
                    class: "nav-link #{'active' if request.path.include?('results')}" do %>
          <i class="ri-bar-chart-box-line"></i>
          <span>Rezilta</span>
        <% end %>
      </li>
    <% end %>

    <%# Electoral Roll %>
    <li class="nav-item">
      <%= link_to partner_portal_voter_registry_path,
                  class: "nav-link #{'active' if request.path.include?('voter_registry')}" do %>
        <i class="ri-file-list-3-line"></i>
        <span>Lis Elektoral</span>
        <% voter_count = cep_election ? VoterEligibilityRecord.where(bonvote_election: cep_election).eligible.count : 0 %>
        <% if voter_count > 0 %>
          <span class="badge bg-primary rounded-pill ms-auto" style="font-size: 0.6rem;"><%= number_with_delimiter(voter_count) %></span>
        <% end %>
      <% end %>
    </li>

    <%# Electoral Offices (BED / BEK) — CEP's permanent field offices.
        Distinct from Sant Vòt (election-day venues): BED/BEK are year-round
        and where citizens go for registration help, dispute filing, etc. %>
    <li class="nav-item">
      <%= link_to partner_portal_electoral_offices_path,
                  class: "nav-link #{'active' if request.path.include?('electoral_offices')}" do %>
        <i class="ri-building-line"></i>
        <span>Biwo Elektoral</span>
        <% bek_count = ElectoralOffice.count rescue 0 %>
        <% if bek_count > 0 %>
          <span class="badge bg-primary rounded-pill ms-auto" style="font-size: 0.6rem;"><%= bek_count %></span>
        <% end %>
      <% end %>
    </li>

    <%# Polling Centers (Sant Vòt) — venues + BVs %>
    <li class="nav-item">
      <%= link_to partner_portal_polling_centers_path,
                  class: "nav-link #{'active' if request.path.include?('polling_centers')}" do %>
        <i class="ri-building-2-line"></i>
        <span>Sant Vòt</span>
        <% center_count = cep_election ? PollingCenter.where(bonvote_election: cep_election).count : 0 %>
        <% if center_count > 0 %>
          <span class="badge bg-primary rounded-pill ms-auto" style="font-size: 0.6rem;"><%= number_with_delimiter(center_count) %></span>
        <% end %>
      <% end %>
    </li>

    <%# Diplomatic Missions (Misyon Diplomatik) — per-election diaspora
        embassies/consulates. Static mission registry lives in the
        HaitianDiplomaticMissions concern; what's editable here is the
        per-election ElectionMissionParticipation row layered on top. %>
    <li class="nav-item">
      <%= link_to partner_portal_diplomatic_missions_path,
                  class: "nav-link #{'active' if request.path.include?('diplomatic_missions')}" do %>
        <i class="ri-global-line"></i>
        <span>Misyon Diplomatik</span>
        <% mission_active = cep_election ? ElectionMissionParticipation.for_election(cep_election.id).active.count : 0 %>
        <% if mission_active > 0 %>
          <span class="badge bg-primary rounded-pill ms-auto" style="font-size: 0.6rem;"><%= mission_active %></span>
        <% end %>
      <% end %>
    </li>

    <%# Party Registration (Article 143) %>
    <li class="nav-item">
      <%= link_to partner_portal_party_registrations_path,
                  class: "nav-link #{'active' if request.path.include?('party_registrations')}" do %>
        <i class="ri-flag-line"></i>
        <span>Pati Politik</span>
        <% party_pending = cep_election ? ElectionPartyRegistration.where(election: cep_election).pending_review.count : 0 %>
        <% if party_pending > 0 %>
          <span class="badge bg-warning text-dark rounded-pill ms-auto" style="font-size: 0.6rem;"><%= party_pending %></span>
        <% end %>
      <% end %>
    </li>

    <%# Candidate Registration %>
    <li class="nav-item">
      <%= link_to partner_portal_candidate_registrations_path,
                  class: "nav-link #{'active' if request.path.include?('candidate_registrations')}" do %>
        <i class="ri-user-star-line"></i>
        <span>Kandida</span>
        <% pending_count = cep_election ? ElectionCandidate.where(election: cep_election).pending_review.count : 0 %>
        <% if pending_count > 0 %>
          <span class="badge bg-warning text-dark rounded-pill ms-auto" style="font-size: 0.6rem;"><%= pending_count %></span>
        <% end %>
      <% end %>
    </li>

    <li class="nav-item">
      <%= link_to partner_portal_analytics_path,
                  class: "nav-link #{'active' if request.path.include?('analytics')}" do %>
        <i class="ri-bar-chart-box-line"></i>
        <span>Analitik</span>
      <% end %>
    </li>

    <%# ── API & BILLING ─────────────────────────── %>
    <li class="sidebar-section-label">API & Faktirasyon</li>

    <li class="nav-item">
      <%= link_to partner_portal_api_keys_path,
                  class: "nav-link #{'active' if request.path.include?('api_keys')}" do %>
        <i class="ri-code-s-slash-line"></i>
        <span>API</span>
      <% end %>
    </li>

    <li class="nav-item">
      <%= link_to partner_portal_settings_path,
                  class: "nav-link #{'active' if request.path.include?('settings')}" do %>
        <i class="ri-settings-3-line"></i>
        <span>Paramèt</span>
      <% end %>
    </li>

    <li class="sidebar-divider"></li>

    <li class="nav-item">
      <%= link_to partner_portal_credits_path,
                  class: "nav-link #{'active' if request.path.include?('credits')}" do %>
        <i class="ri-coin-line"></i>
        <span>Kredi</span>
        <% if @current_partner&.credit_balance.to_d > 0 %>
          <span class="badge bg-success rounded-pill ms-auto" style="font-size: 0.65rem;">
            $<%= number_with_precision(@current_partner.credit_balance, precision: 2) %>
          </span>
        <% end %>
      <% end %>
    </li>

    <li class="nav-item">
      <%= link_to partner_portal_billing_path,
                  class: "nav-link #{'active' if request.path.include?('billing')}" do %>
        <i class="ri-money-dollar-circle-line"></i>
        <span>Faktirasyon</span>
      <% end %>
    </li>
  </ul>

  <%# Logout button %>
  <div class="sidebar-logout">
    <%= button_to destroy_partner_admin_session_path,
                  method: :delete,
                  class: "logout-btn" do %>
      <i class="ri-logout-box-r-line"></i>
      <span>Dekonekte</span>
    <% end %>
  </div>
</div>
