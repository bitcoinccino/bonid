<%# app/views/partner_portal/shared/sidebars/_sidebar_default_content.html.erb %>
<%# Default sidebar for non-law enforcement partners %>

<%# Mobile backdrop %>
<div class="partner-sidebar-backdrop d-lg-none"
     data-action="click->partner-sidebar#close"
     id="partnerSidebarBackdrop"></div>

<%# Sidebar %>
<div class="partner-sidebar" id="partnerSidebar" data-controller="partner-sidebar">
  <%# Mobile close button %>
  <button type="button"
          class="sidebar-close-btn d-lg-none"
          data-action="click->partner-sidebar#close"
          aria-label="Close sidebar">
    <i class="ri-close-line"></i>
  </button>

  <%# Partner logo and name %>
  <div class="partner-logo-section">
    <div class="partner-logo-wrapper">
      <% if @current_partner&.logo&.attached? %>
        <%= image_tag url_for(@current_partner.logo.variant(resize_to_limit: [120, 120])),
                      class: "partner-logo-img",
                      alt: "#{@current_partner.name || 'Partner'} logo" %>
      <% else %>
        <div class="partner-logo-placeholder">
          <i class="ri-building-2-line"></i>
        </div>
      <% end %>
    </div>
    <div class="partner-name"><%= @current_partner&.name || "Partner Portal" %></div>
    <div class="partner-sector"><%= PartnerSectorConstants.human_sector_label(@current_partner&.department_sector || @current_partner&.sector || "") %></div>
  </div>

  <%# Navigation links %>
  <ul class="nav flex-column sidebar-nav">
    <%# 1. Dashboard %>
    <li class="nav-item">
      <%= link_to partner_portal_dashboard_path,
                  class: "nav-link #{'active' if current_page?(partner_portal_dashboard_path)}" do %>
        <i class="ri-dashboard-line"></i>
        <span>Dashboard</span>
      <% end %>
    </li>

    <%# 2. Scan BonID %>
    <li class="nav-item">
      <%= link_to partner_portal_scans_path,
                  class: "nav-link #{'active' if request.path.include?('scans')}" do %>
        <i class="ri-qr-scan-2-line"></i>
        <span>Scan BonID</span>
      <% end %>
    </li>

    <%# 3. Verifications %>
    <li class="nav-item">
      <%= link_to partner_portal_verifications_path,
                  class: "nav-link #{'active' if request.path.include?('verifications')}" do %>
        <i class="ri-user-search-line"></i>
        <span>Verifications</span>
      <% end %>
    </li>

    <%# 4. Team / Staff %>
    <li class="nav-item">
      <%= link_to partner_portal_team_path,
                  class: "nav-link #{'active' if request.path.include?('team')}" do %>
        <i class="ri-team-line"></i>
        <span>Team</span>
      <% end %>
    </li>

    <%# 5. Analytics %>
    <li class="nav-item">
      <%= link_to partner_portal_analytics_path,
                  class: "nav-link #{'active' if request.path.include?('analytics')}" do %>
        <i class="ri-bar-chart-box-line"></i>
        <span>Analytics</span>
      <% end %>
    </li>

    <%# 6. API %>
    <li class="nav-item">
      <%= link_to partner_portal_api_keys_path,
                  class: "nav-link #{'active' if request.path.include?('api_keys')}" do %>
        <i class="ri-code-s-slash-line"></i>
        <span>API</span>
      <% end %>
    </li>

    <%# 7. Settings %>
    <li class="nav-item">
      <%= link_to partner_portal_settings_path,
                  class: "nav-link #{'active' if request.path.include?('settings')}" do %>
        <i class="ri-settings-3-line"></i>
        <span>Settings</span>
      <% end %>
    </li>

    <%# Divider %>
    <li class="sidebar-divider"></li>

    <%# 8. Credits / Wallet %>
    <li class="nav-item">
      <%= link_to partner_portal_credits_path,
                  class: "nav-link #{'active' if request.path.include?('credits')}" do %>
        <i class="ri-coin-line"></i>
        <span>Credits</span>
        <% if @current_partner&.credit_balance.to_d > 0 %>
          <span class="badge bg-success rounded-pill ms-auto" style="font-size: 0.65rem;">
            $<%= number_with_precision(@current_partner.credit_balance, precision: 2) %>
          </span>
        <% end %>
      <% end %>
    </li>

    <%# 9. Billing / Faktirasyon %>
    <li class="nav-item">
      <%= link_to partner_portal_billing_path,
                  class: "nav-link #{'active' if request.path.include?('billing')}" do %>
        <i class="ri-money-dollar-circle-line"></i>
        <span>Faktirasyon</span>
      <% end %>
    </li>
  </ul>

  <%# Logout button %>
  <div class="sidebar-logout">
    <%= button_to destroy_partner_admin_session_path,
                  method: :delete,
                  class: "logout-btn" do %>
      <i class="ri-logout-box-r-line"></i>
      <span>Log Out</span>
    <% end %>
  </div>
</div>
