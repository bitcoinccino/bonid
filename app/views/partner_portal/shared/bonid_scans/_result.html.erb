<% if submission.present? && submission.status_approved? %>
  <!-- ✅ Verified BonID Result -->
  <div class="card shadow-sm border-0 rounded-4 p-3 bg-white">
    <div class="d-flex align-items-center gap-3">
      <!-- Selfie -->
      <% if submission.selfie.attached? %>
        <%= image_tag submission.selfie,
                      class: "rounded-circle border border-2 border-success shadow-sm",
                      style: "width: 70px; height: 70px; object-fit: cover;" %>
      <% else %>
        <div class="rounded-circle bg-light d-flex justify-content-center align-items-center"
             style="width: 70px; height: 70px;">
          <i class="ri-user-line ri-2x text-secondary"></i>
        </div>
      <% end %>

      <!-- Info -->
      <div class="flex-grow-1">
        <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-1">
          <i class="ri-id-card-line text-primary"></i>
          <%= submission.user.full_name %>
        </h6>
        <p class="text-muted small mb-1 d-flex align-items-center gap-1">
          <i class="ri-shield-check-line text-success"></i>
          BonID: <strong><%= submission.bonid %></strong>
        </p>
        <p class="text-success fw-semibold small mb-0 d-flex align-items-center gap-1">
          <i class="ri-checkbox-circle-line"></i>
          Verified Identity
        </p>
      </div>

      <!-- Verified Badge -->
      <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 fw-semibold">
        <i class="ri-check-line me-1"></i> VERIFIED
      </span>
    </div>

    <!-- Additional Details -->
    <div class="mt-3 ps-1 small text-muted">
      <p class="mb-1 d-flex align-items-center">
        <i class="ri-map-pin-line text-primary me-1"></i>
        <%= submission.user.full_address || "Address not provided" %>
      </p>
      <p class="mb-0 d-flex align-items-center">
        <i class="ri-calendar-line text-primary me-1"></i>
        DOB: <%= submission.user.dob&.strftime("%b %d, %Y") || "N/A" %>
      </p>
    </div>

    <%# ── Biometric Verification Proof ── %>
    <% liveness_data = submission.metadata&.dig("liveness") %>
    <% face_match_data = submission.metadata&.dig("face_match") %>
    <% if liveness_data.present? || face_match_data.present? %>
      <div class="mt-3 p-3 rounded-3" style="background: #f0f4ff; border: 1px solid rgba(0,32,159,0.12);">
        <div class="d-flex align-items-center gap-2 mb-2">
          <i class="ri-fingerprint-line" style="color: #00209F; font-size: 1.1rem;"></i>
          <span class="fw-semibold small" style="color: #00209F;">Biometric Verification</span>
        </div>

        <div class="d-flex flex-wrap gap-2">
          <%# Liveness badge %>
          <% if liveness_data.present? %>
            <% liveness_passed = liveness_data["passed"] == true %>
            <% liveness_conf = liveness_data["confidence"]&.to_f&.round(1) %>
            <span class="badge rounded-pill px-2 py-1 d-inline-flex align-items-center gap-1"
                  style="font-size: 0.72rem; font-weight: 600;
                         background: <%= liveness_passed ? '#dcfce7' : '#fee2e2' %>;
                         color: <%= liveness_passed ? '#166534' : '#991b1b' %>;
                         border: 1px solid <%= liveness_passed ? '#bbf7d0' : '#fecaca' %>;">
              <i class="<%= liveness_passed ? 'ri-checkbox-circle-fill' : 'ri-close-circle-fill' %>"></i>
              Liveness: <%= liveness_passed ? "Passed" : "Failed" %>
              <% if liveness_conf && liveness_conf > 0 %>
                (<%= liveness_conf %>%)
              <% end %>
            </span>
          <% end %>

          <%# Face match badge %>
          <% if face_match_data.present? %>
            <% face_matched = face_match_data["status"] == "match" %>
            <% similarity = face_match_data["similarity"]&.to_f&.round(1) %>
            <% compared_to = face_match_data["target_image"] %>
            <span class="badge rounded-pill px-2 py-1 d-inline-flex align-items-center gap-1"
                  style="font-size: 0.72rem; font-weight: 600;
                         background: <%= face_matched ? '#dcfce7' : '#fee2e2' %>;
                         color: <%= face_matched ? '#166534' : '#991b1b' %>;
                         border: 1px solid <%= face_matched ? '#bbf7d0' : '#fecaca' %>;">
              <i class="<%= face_matched ? 'ri-user-follow-fill' : 'ri-user-unfollow-fill' %>"></i>
              Face Match: <%= face_matched ? "Confirmed" : "Failed" %>
              <% if similarity && similarity > 0 %>
                (<%= similarity %>%)
              <% end %>
            </span>
          <% end %>

          <%# Document type badge %>
          <% if face_match_data&.dig("target_image").present? %>
            <span class="badge rounded-pill px-2 py-1 d-inline-flex align-items-center gap-1"
                  style="font-size: 0.72rem; font-weight: 500; background: #e0e7ff; color: #3730a3; border: 1px solid #c7d2fe;">
              <i class="ri-file-shield-line"></i>
              vs. <%= face_match_data["target_image"] == "cin_front" ? "CIN" : "Passport" %>
            </span>
          <% end %>
        </div>

        <% if face_match_data&.dig("matched_at").present? %>
          <div class="mt-1" style="font-size: 0.68rem; color: #64748b;">
            Verified: <%= Time.parse(face_match_data["matched_at"]).strftime("%b %d, %Y at %I:%M %p") rescue face_match_data["matched_at"] %>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- ✅ Start KYC Request Button -->
    <div class="mt-4 text-end">
      <%= link_to partner_portal_banking_new_kyc_path(submission.user),
                  class: "btn btn-primary rounded-pill d-inline-flex align-items-center gap-1 px-3 fw-semibold" do %>
        <i class="ri-add-line"></i> Start KYC Request
      <% end %>
    </div>
  </div>

<% elsif submission.present? && submission.status_rejected? %>
  <!-- ❌ Rejected BonID -->
  <div class="alert alert-dismissible fade show alert-danger text-center rounded-4 d-flex align-items-center justify-content-center gap-2">
    <i class="ri-close-circle-line ri-lg"></i>
    <span>This BonID was rejected and is not valid for KYC verification.</span>
  </div>

<% else %>
  <!-- ⚠️ Not Found -->
  <div class="alert alert-dismissible fade show alert-warning text-center rounded-4 d-flex align-items-center justify-content-center gap-2">
    <i class="ri-error-warning-line ri-lg"></i>
    <span>No verified BonID found for the number entered or scanned.</span>
  </div>
<% end %>

<!-- === Local Styles === -->
<style>
  .bg-success-subtle {
    background-color: rgba(26, 147, 111, 0.1);
  }
  .border-success-subtle {
    border-color: rgba(26, 147, 111, 0.3) !important;
  }
  .alert {
    font-size: 0.9rem;
  }
  .ri-lg {
    font-size: 1.3rem;
  }
  .btn-primary {
    background-color: #00209F;
    border-color: #00209F;
  }
  .btn-primary:hover {
    background-color: #062b77;
    border-color: #062b77;
  }
</style>
