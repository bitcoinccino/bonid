<div class="mb-5">
  <h2 class="h5 fw-bold text-primary mb-3">
    <i class="ri-building-line me-2"></i> Organization Information
  </h2>

  <%= f.input :name,
      label: "Organization Name",
      required: true,
      input_html: {
        placeholder: "e.g., Unibank",
        class: "form-control rounded-3",
        style: "height: 46px; padding: 0.625rem 1rem;",
        data: { form_validation_target: "input", form_progress_target: "input" }
      },
      wrapper_html: { class: "mb-4" } %>

  <%= f.label :description, "Organization Description", class: "form-label fw-bold" %>
  <%= f.text_area :description,
      rows: 5,
      class: "form-control rounded-3 mb-2",
      placeholder: "Briefly describe your organization and how you plan to use BonID",
      style: "padding: 0.75rem 1rem; line-height: 1.4; min-height: 120px;",
      data: { form_progress_target: "input" } %>

  <small class="form-text text-muted mb-4 d-block">
    This helps us understand your mission and why you want to join BonID.
  </small>

  <%= f.input :website,
      label: "Website (Optional)",
      input_html: {
        placeholder: "e.g., https://unibank.ht",
        class: "form-control rounded-3",
        style: "height: 46px; padding: 0.625rem 1rem;",
        data: { form_validation_target: "input", form_progress_target: "input" }
      },
      wrapper_html: { class: "mb-4" } %>
</div>
