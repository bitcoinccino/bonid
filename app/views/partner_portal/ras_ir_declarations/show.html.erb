<%# Partner Portal — RAS IR Declaration Detail (DGI-F005) %>
<div class="partner-dashboard">
  <div class="dash-header">
    <div>
      <h4 class="dash-title"><i class="ri-money-dollar-box-line me-2"></i>RAS IR <code class="ms-2"><%= @record.ras_declaration_number %></code></h4>
      <p class="dash-subtitle"><%= @record.ras_raison_sociale %> — <%= @record.ras_annee_fiscale %> / Mwa <%= @record.ras_mois_declaration %></p>
    </div>
    <%= link_to partner_portal_ras_ir_declarations_path, class: "btn btn-outline-secondary" do %><i class="ri-arrow-left-line me-1"></i>Retounen<% end %>
  </div>

  <div class="row g-4">
    <div class="col-lg-8">
      <%# Section III — Identification %>
      <div class="dash-card mb-4">
        <div class="dash-card-header"><h6 class="dash-card-title"><i class="ri-building-line me-2"></i>Section III — Idantifikasyon</h6></div>
        <div class="dash-card-body">
          <div class="row"><div class="col-md-6">
            <table class="table table-borderless table-sm mb-0">
              <tr><td class="text-muted" style="width:40%">Rezon Sosyal</td><td class="fw-semibold"><%= @record.ras_raison_sociale %></td></tr>
              <tr><td class="text-muted">NIF</td><td><code><%= @record.ras_nif %></code></td></tr>
              <tr><td class="text-muted">Sektè</td><td><%= @record.ras_secteur_label %></td></tr>
            </table>
          </div><div class="col-md-6">
            <table class="table table-borderless table-sm mb-0">
              <tr><td class="text-muted" style="width:40%">Adrès</td><td><%= @record.ras_adresse %></td></tr>
              <tr><td class="text-muted">Vil</td><td><%= @record.ras_ville %></td></tr>
              <tr><td class="text-muted">Telefon</td><td><%= @record.ras_telephone || "—" %></td></tr>
            </table>
          </div></div>
        </div>
      </div>

      <%# Section IV — Calcul RAS (14 lines) %>
      <div class="dash-card mb-4">
        <div class="dash-card-header"><h6 class="dash-card-title"><i class="ri-calculator-line me-2"></i>Section IV — Kalkil Retni nan Sous (14 Liy)</h6></div>
        <div class="dash-card-body p-0">
          <table class="table table-striped table-sm mb-0">
            <thead><tr><th style="width:8%">Liy</th><th>Deskripsyon</th><th style="width:12%">To</th><th style="width:18%" class="text-end">Montan (HTG)</th></tr></thead>
            <tbody>
              <% RecordSchemas::RasIrDeclarationSchema::CALCUL_RAS_LINES.each do |num, line| %>
                <% next if line[:key] == "employes" %>
                <% val = @record.data.dig("calcul_ras", line[:key]) %>
                <tr class="<%= 'table-warning' if line[:admin] %><%= ' table-primary fw-bold' if num == 7 %>">
                  <td class="fw-bold"><%= num %></td>
                  <td><%= line[:label] %><% if line[:editable] %> <i class="ri-edit-line text-muted small"></i><% end %></td>
                  <td class="text-muted"><%= line[:rate] %></td>
                  <td class="text-end fw-semibold"><%= val.present? ? number_with_delimiter(val.to_f.round(2)) : "—" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <%# Section VI — Admin %>
      <div class="dash-card mb-4">
        <div class="dash-card-header"><h6 class="dash-card-title"><i class="ri-government-line me-2"></i>Section VI — Kad Administrasyon</h6></div>
        <div class="dash-card-body p-0">
          <table class="table table-sm mb-0">
            <% RecordSchemas::RasIrDeclarationSchema::ADMIN_LINES.each do |key, label| %>
              <% val = @record.data.dig("calcul_ras", key.to_s) %>
              <tr class="<%= 'table-primary fw-bold' if key == :total %>">
                <td><%= label %></td>
                <td class="text-end fw-semibold"><%= val.present? ? number_with_delimiter(val.to_f.round(2)) : "0.00" %> HTG</td>
              </tr>
            <% end %>
          </table>
        </div>
      </div>

      <%# Employee List (Line 11 — Annexe) %>
      <% if @record.ras_employes.any? %>
        <div class="dash-card mb-4">
          <div class="dash-card-header"><h6 class="dash-card-title"><i class="ri-team-line me-2"></i>Liy 11 — Lis Anplwaye (<%= @record.ras_nombre_employes %>)</h6></div>
          <div class="dash-card-body p-0">
            <table class="table table-striped table-sm mb-0">
              <thead><tr><th>#</th><th>Non Anplwaye</th><th>NIF</th><th class="text-end">Salè Brit (HTG)</th><th class="text-end">Retni IR (HTG)</th></tr></thead>
              <tbody>
                <% @record.ras_employes.each_with_index do |emp, idx| %>
                  <tr>
                    <td><%= idx + 1 %></td>
                    <td class="fw-semibold"><%= emp["nom_employe"] %></td>
                    <td><code><%= emp["nif_employe"] || "—" %></code></td>
                    <td class="text-end"><%= number_with_delimiter(emp["salaire_brut"].to_f.round(2)) %></td>
                    <td class="text-end"><%= number_with_delimiter(emp["retenue_ir"].to_f.round(2)) %></td>
                  </tr>
                <% end %>
              </tbody>
              <tfoot>
                <tr class="table-secondary fw-bold">
                  <td colspan="3">Total</td>
                  <td class="text-end"><%= number_with_delimiter(@record.ras_employes.sum { |e| e["salaire_brut"].to_f }.round(2)) %></td>
                  <td class="text-end"><%= number_with_delimiter(@record.ras_employes.sum { |e| e["retenue_ir"].to_f }.round(2)) %></td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      <% end %>

      <%# Paiement + Signature %>
      <div class="dash-card">
        <div class="dash-card-header"><h6 class="dash-card-title"><i class="ri-quill-pen-line me-2"></i>Section V — Siyati & Peman</h6></div>
        <div class="dash-card-body">
          <div class="row"><div class="col-md-6">
            <table class="table table-borderless table-sm mb-0">
              <tr><td class="text-muted">Deklaran</td><td><%= @record.ras_declarant_nom || "—" %></td></tr>
              <tr><td class="text-muted">NIF Deklaran</td><td><code><%= @record.ras_declarant_nif || "—" %></code></td></tr>
              <tr><td class="text-muted">Dat Prezantasyon</td><td><%= @record.ras_date_presentation %></td></tr>
            </table>
          </div><div class="col-md-6">
            <table class="table table-borderless table-sm mb-0">
              <tr><td class="text-muted">Metòd</td><td><%= @record.ras_methode_paiement || "—" %></td></tr>
              <tr><td class="text-muted">Chèk</td><td><%= @record.ras_numero_cheque || "—" %></td></tr>
              <tr><td class="text-muted">Bank</td><td><%= @record.ras_banque || "—" %></td></tr>
            </table>
          </div></div>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="dash-card mb-3" style="border-left:4px solid #198754;">
        <div class="dash-card-body text-center">
          <span class="text-muted small d-block mb-1">Total Retni</span>
          <h3 class="mb-1" style="color:#198754;"><%= number_with_delimiter(@record.ras_total.round(2)) %> HTG</h3>
          <span class="text-muted small">Mwa <%= @record.ras_mois_declaration %> — <%= @record.ras_annee_fiscale %></span>
        </div>
      </div>

      <div class="dash-card mb-3" style="border-left:4px solid #0dcaf0;">
        <div class="dash-card-body">
          <div class="d-flex justify-content-between mb-2"><span class="text-muted">FDU (1%)</span><span class="fw-bold"><%= number_with_delimiter(@record.ras_fdu.round(2)) %> HTG</span></div>
          <div class="d-flex justify-content-between mb-2"><span class="text-muted">CAS (1%)</span><span class="fw-bold"><%= number_with_delimiter(@record.ras_cas.round(2)) %> HTG</span></div>
          <div class="d-flex justify-content-between"><span class="text-muted">DSAV (2/1000)</span><span class="fw-bold"><%= number_with_delimiter(@record.ras_dsav.round(2)) %> HTG</span></div>
        </div>
      </div>

      <div class="dash-card mb-3">
        <div class="dash-card-body">
          <div class="d-flex justify-content-between mb-2"><span class="text-muted">Estati</span><span class="badge bg-success"><%= @record.status&.titleize %></span></div>
          <div class="d-flex justify-content-between mb-2"><span class="text-muted">Tip</span><span><%= @record.ras_type_declaration %></span></div>
          <div class="d-flex justify-content-between mb-2"><span class="text-muted">Anplwaye</span><span class="badge bg-info"><%= @record.ras_nombre_employes %></span></div>
          <div class="d-flex justify-content-between"><span class="text-muted">Konsòmasyon</span><span class="badge <%= @record.consumed? ? 'bg-danger' : 'bg-success' %>"><%= @record.consumed? ? 'Konsome' : 'Disponib' %></span></div>
        </div>
      </div>

      <% if @record.user %>
        <div class="dash-card mb-3" style="border-left:4px solid #00209F;">
          <div class="dash-card-header"><h6 class="dash-card-title"><i class="ri-user-line me-2"></i>Kontribyab</h6></div>
          <div class="dash-card-body text-center">
            <h6><%= @record.user.first_name %> <%= @record.user.last_name %></h6>
            <code><%= mask_bonid(@record.user.bonid) %></code>
          </div>
        </div>
        <%= render "partner_portal/shared/citizen_signature", record: @record %>
      <% end %>
    </div>
  </div>
</div>
