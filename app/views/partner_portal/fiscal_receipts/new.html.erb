<%# Partner Portal — New Fiscal Receipt (DGI Cashier Flow) %>
<%# Step 1: BonID Lookup → Step 2: Receipt Details → Submit %>

<div class="partner-dashboard">

  <%# ── Page Header ── %>
  <div class="dash-header">
    <div>
      <h4 class="dash-title"><i class="ri-add-circle-line me-2"></i>Nouvo Kes Fiskal</h4>
      <p class="dash-subtitle">Kreye yon nouvo kes fiskal pou yon kontribyab</p>
    </div>
    <%= link_to partner_portal_fiscal_receipts_path, class: "btn btn-outline-secondary" do %>
      <i class="ri-arrow-left-line me-1"></i>Retounen
    <% end %>
  </div>

  <%# ══════ STEP 1: BonID Lookup (centered) ══════ %>
  <% unless @citizen %>
    <div class="row justify-content-center">
      <div class="col-lg-6 col-md-8">
        <div class="dash-card" style="border-top: 3px solid #00209F;">
          <div class="dash-card-body p-4">
            <div class="text-center mb-4">
              <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                   style="width:64px;height:64px;background:#EEF2FF;">
                <i class="ri-search-eye-line" style="font-size:1.8rem;color:#00209F;"></i>
              </div>
              <h5 class="fw-bold mb-1">Chèche Kontribyab</h5>
              <p class="text-muted mb-0">Antre BonID kontribyab la pou kòmanse kreye yon kes fiskal.</p>
            </div>

            <%= form_tag new_partner_portal_fiscal_receipt_path, method: :get do %>
              <div class="mb-3">
                <label class="form-label fw-semibold">Nimewo BonID</label>
                <%= text_field_tag :bonid, params[:bonid],
                    class: "form-control form-control-lg text-center",
                    placeholder: "DC-1990-F-OUEST-P4521089",
                    style: "font-family:monospace;font-size:1.05rem;letter-spacing:0.5px;min-height:48px;",
                    autofocus: true %>
              </div>
              <%= submit_tag "Chèche",
                  class: "btn btn-primary btn-lg w-100",
                  style: "min-height:48px;background:#00209F;border-color:#00209F;" %>
            <% end %>

            <% if params[:bonid].present? && @citizen.nil? %>
              <div class="alert alert-warning mt-3 mb-0">
                <i class="ri-error-warning-line me-2"></i>
                Pa gen sitwayen ki gen BonID sa a: <strong><%= params[:bonid] %></strong>
              </div>
            <% end %>

            <div class="text-center mt-3">
              <small class="text-muted">
                <i class="ri-information-line me-1"></i>Ou ka eskane QR kòd BonID kontribyab la tou.
              </small>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%# ══════ STEP 2: Receipt Details (two columns) ══════ %>
  <% if @citizen %>
    <div class="row g-4">

      <%# ── LEFT: Form ── %>
      <div class="col-lg-8">
        <%= form_tag partner_portal_fiscal_receipts_path, method: :post do %>
          <%= hidden_field_tag :bonid, @citizen.bonid %>

          <div class="dash-card mb-4" style="border-top:3px solid #00209F;">
            <div class="dash-card-header">
              <h6 class="dash-card-title">
                <i class="ri-file-text-line me-2"></i>Detay Kes Fiskal
              </h6>
            </div>
            <div class="dash-card-body p-3">
              <div class="row g-3">

                <%# Tax Type %>
                <div class="col-md-6">
                  <label class="form-label fw-semibold">Tip Taks <span class="text-danger">*</span></label>
                  <%= select_tag :tax_type,
                      options_for_select(
                        RecordSchemas::FiscalReceiptSchema::TAX_TYPE_LABELS.map { |key, label| [label, key] },
                        params[:tax_type]
                      ),
                      class: "form-select",
                      required: true,
                      prompt: "— Chwazi tip taks —" %>
                </div>

                <%# Amount HTG %>
                <div class="col-md-6">
                  <label class="form-label fw-semibold">Montan (HTG) <span class="text-danger">*</span></label>
                  <div class="input-group">
                    <span class="input-group-text">HTG</span>
                    <%= number_field_tag :amount_htg, params[:amount_htg],
                        class: "form-control",
                        min: 1, step: 1, required: true,
                        placeholder: "0" %>
                  </div>
                </div>

                <%# Payment Date %>
                <div class="col-md-6">
                  <label class="form-label fw-semibold">Dat Peman</label>
                  <%= date_field_tag :payment_date,
                      params[:payment_date] || Date.current.to_s,
                      class: "form-control" %>
                </div>

                <%# Payment Method %>
                <div class="col-md-6">
                  <label class="form-label fw-semibold">Metòd Peman</label>
                  <%= select_tag :payment_method,
                      options_for_select(
                        RecordSchemas::FiscalReceiptSchema::PAYMENT_METHOD_LABELS.map { |key, label| [label, key] },
                        params[:payment_method] || "cash"
                      ),
                      class: "form-select" %>
                </div>

                <%# DGI Office Code %>
                <div class="col-md-6">
                  <label class="form-label fw-semibold">Kòd Biwo DGI <span class="text-danger">*</span></label>
                  <%= text_field_tag :dgi_office_code, params[:dgi_office_code] || "PAP",
                      class: "form-control",
                      required: true,
                      placeholder: "PAP" %>
                </div>

                <%# Fiscal Year %>
                <div class="col-md-6">
                  <label class="form-label fw-semibold">Ane Fiskal</label>
                  <%= text_field_tag :fiscal_year,
                      params[:fiscal_year] || "#{Time.current.year}-#{Time.current.year + 1}",
                      class: "form-control",
                      placeholder: "2026-2027" %>
                </div>

                <%# NIF (optional) %>
                <div class="col-12">
                  <label class="form-label fw-semibold">NIF (opsyonèl)</label>
                  <%= text_field_tag :payer_nif, params[:payer_nif],
                      class: "form-control",
                      placeholder: "NIF-HT-XXXXXXXXX" %>
                </div>

              </div>
            </div>
          </div>

          <%# Submit %>
          <div class="d-flex gap-3 justify-content-end">
            <%= link_to new_partner_portal_fiscal_receipt_path,
                class: "btn btn-outline-secondary" do %>
              <i class="ri-arrow-left-line me-1"></i>Retounen
            <% end %>
            <button type="submit" class="btn btn-primary"
                    style="min-height:48px;min-width:200px;background:#00209F;border-color:#00209F;"
                    onclick="return confirm('Ou sèten ou vle kreye kes fiskal sa a?')">
              <i class="ri-check-double-line me-2"></i>Kreye Kes Fiskal
            </button>
          </div>
        <% end %>
      </div>

      <%# ── RIGHT: Citizen Card ── %>
      <div class="col-lg-4">
        <div class="dash-card" style="border-top:3px solid #10B981;">
          <div class="dash-card-body p-3 text-center">
            <%# Photo %>
            <div class="mb-3">
              <% if @citizen.photo.attached? %>
                <%= image_tag @citizen.photo,
                    class: "rounded-circle d-block mx-auto border",
                    style: "width:80px;height:80px;object-fit:cover;" %>
              <% else %>
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center"
                     style="width:80px;height:80px;background:#00209F;color:#fff;font-size:1.5rem;font-weight:700;">
                  <%= @citizen.first_name&.first %><%= @citizen.last_name&.first %>
                </div>
              <% end %>
            </div>

            <h5 class="mb-1"><%= @citizen.full_name %></h5>
            <code class="d-block mb-2" style="font-size:0.9rem;color:#00209F;"><%= mask_bonid(@citizen.bonid) %></code>

            <% if @citizen.bonid_verified? %>
              <span class="badge bg-success mb-3"><i class="ri-check-line me-1"></i>Verifye</span>
            <% else %>
              <span class="badge bg-warning text-dark mb-3">Pa Verifye</span>
            <% end %>

            <hr class="my-2">

            <div class="text-start small">
              <% if @citizen.phone.present? %>
                <div class="d-flex justify-content-between mb-1">
                  <span class="text-muted">Telefon</span>
                  <span><%= @citizen.phone %></span>
                </div>
              <% end %>
              <% if @citizen.email.present? %>
                <div class="d-flex justify-content-between mb-1">
                  <span class="text-muted">Imel</span>
                  <span class="text-truncate" style="max-width:150px;"><%= @citizen.email %></span>
                </div>
              <% end %>
              <% if @citizen.formatted_address.present? %>
                <div class="d-flex justify-content-between mb-1">
                  <span class="text-muted">Adrès</span>
                  <span class="text-truncate" style="max-width:150px;"><%= @citizen.formatted_address %></span>
                </div>
              <% end %>
              <div class="d-flex justify-content-between">
                <span class="text-muted">Enskri</span>
                <span><%= @citizen.created_at.strftime("%d/%m/%Y") %></span>
              </div>
            </div>
          </div>
        </div>

        <%# Signature %>
        <%= render "partner_portal/shared/citizen_signature", record: nil, citizen: @citizen rescue nil %>
      </div>
    </div>
  <% end %>
</div>
