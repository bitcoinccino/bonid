<table class="table mb-0">
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Unit</th>
      <th>Joined</th>
    </tr>
  </thead>
  <tbody>
    <% if officers.any? %>
      <% officers.each do |officer| %>
        <tr>
          <td><%= officer.name || "—" %></td>
          <td><%= officer.email %></td>
          <td><%= officer.unit || "—" %></td>
          <td><%= officer.created_at.strftime("%Y-%m-%d") %></td>
        </tr>
      <% end %>
    <% else %>
      <tr>
        <td colspan="4" class="text-center text-muted">No officers found.</td>
      </tr>
    <% end %>
  </tbody>
</table>
