app/views/partner_portal/law_enforcement/dashboard/_officers_table.html.erb
<div class="card mb-4">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0">Officers</h5>
    <%= link_to "View All", officers_dashboard_path, class: "btn btn-sm btn-outline-primary" %>
  </div>
  <div class="card-body p-0">
    <table class="table table-striped mb-0">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Unit</th>
          <th>Joined</th>
        </tr>
      </thead>
      <tbody>
        <% officers.each do |officer| %>
          <tr>
            <td><%= officer.full_name %></td>
            <td><%= officer.email %></td>
            <td><%= officer.officer&.unit_name || "—" %></td>
            <td><%= officer.created_at.strftime("%Y-%m-%d") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
