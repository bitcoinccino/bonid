<h5 class="fw-semibold text-haitian-blue mt-4">Recent Visitor Entries</h5>
<div class="table-responsive bg-white shadow-sm rounded-3 p-3">
  <table class="table table-hover align-middle">
    <thead>
      <tr>
        <th>BonID</th>
        <th>Mode</th>
        <th>Port</th>
        <th>Entered At</th>
        <th>Officer</th>
      </tr>
    </thead>
    <tbody>
      <% border_entries.each do |e| %>
        <tr>
          <td><%= e.visitor_submission.bonid %></td>
          <td><%= e.entry_mode.capitalize %></td>
          <td><%= e.port_of_entry %></td>
          <td><%= l(e.entered_at, format: :short) %></td>
          <td><%= e.officer.full_name %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
