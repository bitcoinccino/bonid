<%# app/views/partner_portal/law_enforcement/officer_invitations/new.html.erb %>

<div class="container-fluid py-4">
  <%# Header %>
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2">
          <li class="breadcrumb-item">
            <%= link_to "Officers", partner_portal_law_enforcement_officers_path %>
          </li>
          <li class="breadcrumb-item active" aria-current="page">Invite Officer</li>
        </ol>
      </nav>
      <h1 class="h3 fw-bold text-dark mb-1">Invite Officer</h1>
      <p class="text-muted mb-0">Invite a verified BonID holder to join the force</p>
    </div>
    <div class="mt-3 mt-md-0">
      <%= link_to partner_portal_law_enforcement_officers_path, class: "btn btn-outline-secondary rounded-pill" do %>
        <i class="ri-arrow-left-line me-1"></i> Back to Officers
      <% end %>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-8">
      <%# Important Notice %>
      <div class="alert alert-info border-0 shadow-sm rounded-3 mb-4">
        <div class="d-flex">
          <div class="flex-shrink-0">
            <i class="ri-shield-check-line fs-4 text-info"></i>
          </div>
          <div class="ms-3">
            <h6 class="fw-semibold mb-1">BonID Verification Required</h6>
            <p class="mb-0 small">
              Only citizens with a <strong>verified BonID</strong> can be invited as officers.
              The person must first register on BonID and have their identity approved before receiving an invitation.
            </p>
          </div>
        </div>
      </div>

      <%# Single Invite Form %>
      <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white border-0 py-3">
          <h5 class="mb-0 fw-semibold">
            <i class="ri-user-add-line text-primary me-2"></i>Single Officer Invitation
          </h5>
        </div>
        <div class="card-body p-4">
          <%= form_with model: @officer,
                        url: partner_portal_law_enforcement_officer_invitations_path,
                        method: :post,
                        local: true,
                        html: { class: "needs-validation", novalidate: true } do |f| %>

            <div class="mb-4">
              <%= f.label :email, class: "form-label fw-semibold" %>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                  <i class="ri-mail-line text-muted"></i>
                </span>
                <%= f.email_field :email,
                                  class: "form-control border-start-0 ps-0",
                                  placeholder: "officer@example.com",
                                  required: true,
                                  autofocus: true %>
              </div>
              <div class="form-text text-muted">
                Enter the email address of the citizen you want to invite. They must already have a verified BonID.
              </div>
            </div>

            <div class="d-flex gap-3">
              <%= f.submit "Send Invitation", class: "btn btn-primary rounded-pill px-4" %>
              <%= link_to "Cancel", partner_portal_law_enforcement_officers_path, class: "btn btn-outline-secondary rounded-pill px-4" %>
            </div>
          <% end %>
        </div>
      </div>

      <%# Bulk Invite Card %>
      <div class="card border-0 shadow-sm rounded-3 mt-4">
        <div class="card-header bg-white border-0 py-3">
          <h5 class="mb-0 fw-semibold">
            <i class="ri-group-line text-success me-2"></i>Bulk Officer Invitation
          </h5>
        </div>
        <div class="card-body p-4">
          <p class="text-muted mb-3">
            Need to invite multiple officers at once? Upload a CSV file with email addresses.
          </p>
          <%= link_to bulk_new_partner_portal_law_enforcement_officer_invitations_path,
                      class: "btn btn-outline-success rounded-pill" do %>
            <i class="ri-upload-2-line me-2"></i>Upload CSV
          <% end %>
        </div>
      </div>
    </div>

    <%# Sidebar Info %>
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm rounded-3 bg-light">
        <div class="card-body p-4">
          <h6 class="fw-semibold mb-3">
            <i class="ri-information-line text-primary me-2"></i>How It Works
          </h6>
          <ol class="ps-3 mb-0 small text-muted">
            <li class="mb-2">Enter the email of the citizen you want to invite</li>
            <li class="mb-2">We verify they have an approved BonID</li>
            <li class="mb-2">If verified, they receive an invitation email</li>
            <li class="mb-2">They click the link to accept and set their password</li>
            <li>Once accepted, they can access the officer portal</li>
          </ol>
        </div>
      </div>

      <div class="card border-0 shadow-sm rounded-3 mt-3">
        <div class="card-body p-4">
          <h6 class="fw-semibold mb-3">
            <i class="ri-shield-user-line text-warning me-2"></i>Why BonID Required?
          </h6>
          <p class="small text-muted mb-0">
            BonID verification ensures that only verified Haitian citizens can serve as officers.
            This maintains the integrity and trustworthiness of the Police Nationale d'Haiti.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
