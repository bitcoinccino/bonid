<%# Officer invitation — candidate picker (name/email/BonID search results) %>
<div class="container-fluid py-4">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2">
          <li class="breadcrumb-item"><%= link_to "Ofisye", partner_portal_law_enforcement_officers_path %></li>
          <li class="breadcrumb-item"><%= link_to "Envite", new_partner_portal_law_enforcement_officer_invitation_path %></li>
          <li class="breadcrumb-item active" aria-current="page">Rezilta</li>
        </ol>
      </nav>
      <h1 class="h3 fw-bold text-dark mb-1">Chwazi moun pou envite</h1>
      <p class="text-muted mb-0"><%= @candidates.size %> rezilta pou « <%= @query %> »</p>
    </div>
    <div class="mt-3 mt-md-0">
      <%= link_to new_partner_portal_law_enforcement_officer_invitation_path, class: "btn btn-outline-secondary rounded-pill" do %>
        <i class="ri-search-line me-1"></i> Nouvo rechèch
      <% end %>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-8">
      <div class="list-group shadow-sm rounded-3">
        <% @candidates.each do |c| %>
          <div class="list-group-item d-flex align-items-center gap-3 p-3">
            <% if c[:photo_url] %>
              <img src="<%= c[:photo_url] %>" alt="<%= c[:full_name] %>"
                   class="rounded-circle border" style="width:56px;height:56px;object-fit:cover;">
            <% else %>
              <div class="rounded-circle bg-primary-subtle d-flex align-items-center justify-content-center"
                   style="width:56px;height:56px;flex-shrink:0;">
                <i class="ri-user-line text-primary"></i>
              </div>
            <% end %>

            <div class="flex-grow-1">
              <div class="fw-semibold"><%= c[:full_name] %></div>
              <div class="text-muted small"><i class="ri-mail-line me-1"></i><%= c[:email] %></div>
              <div class="mt-1">
                <code class="text-primary small"><%= c[:bonid] %></code>
                <% if c[:verified] %>
                  <span class="badge bg-success-subtle text-success ms-1"><i class="ri-checkbox-circle-line me-1"></i>BonID Verifye</span>
                <% else %>
                  <span class="badge bg-warning-subtle text-warning ms-1"><i class="ri-time-line me-1"></i>BonID poko verifye</span>
                <% end %>
              </div>
            </div>

            <div class="flex-shrink-0">
              <% if c[:verified] %>
                <%= form_tag confirm_partner_portal_law_enforcement_officer_invitations_path, method: :post, data: { turbo: false } do %>
                  <%= hidden_field_tag :bonid, c[:bonid] %>
                  <button type="submit" class="btn btn-primary rounded-pill px-3">
                    <i class="ri-user-add-line me-1"></i> Envite
                  </button>
                <% end %>
              <% else %>
                <button class="btn btn-outline-secondary rounded-pill px-3" disabled title="BonID poko verifye">
                  <i class="ri-lock-line me-1"></i> Pa disponib
                </button>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card border-0 shadow-sm rounded-3 bg-light">
        <div class="card-body p-4">
          <h6 class="fw-semibold mb-3"><i class="ri-information-line text-primary me-2"></i>Remak</h6>
          <p class="small text-muted mb-0">
            Sèlman moun ki gen yon <strong>BonID verifye</strong> ka vin ofisye. Si moun ou bezwen an
            poko verifye, mande l konplete BonID li anvan.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
