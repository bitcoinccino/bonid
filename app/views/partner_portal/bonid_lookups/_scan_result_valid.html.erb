<%# Verified BonID Result — Partner Portal Identity Profile Card %>
<%= render 'partner_portal/bonid_lookups/photo_modal' %>

<% display_name = user.full_name %>
<% age_display = user.respond_to?(:age) ? user.age : nil %>
<% is_cep = partner&.department_sector.to_s.downcase == "cep" || partner&.sector.to_s.downcase == "cep" %>

<div class="verified-profile-card" data-result-type="valid">

  <%# ── 1. Green Verified Banner ── %>
  <div class="verified-banner">
    <div class="d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-3">
        <div class="verified-icon-circle">
          <i class="ri-shield-check-fill"></i>
        </div>
        <div>
          <div class="verified-title">Identity Verified</div>
          <div class="verified-subtitle">Digital signature authenticated</div>
        </div>
      </div>
      <div class="verified-checkmark">
        <i class="ri-checkbox-circle-fill"></i>
      </div>
    </div>
  </div>

  <div class="verified-body">

    <%# ── 2. Identity Profile: Photo + Data Grid ── %>
    <div class="profile-layout">

      <%# Photo with Verified badge overlaid %>
      <div class="profile-photo-col">
        <div class="profile-photo-frame">
          <% if user.photo.attached? %>
            <%= image_tag user.photo.variant(resize_to_limit: [200, 240]),
                          class: "profile-photo",
                          data: {
                            photo_enlarge: true,
                            photo_url: url_for(user.photo.variant(resize_to_limit: [800, 800])),
                            person_name: display_name,
                            status: 'Verified'
                          },
                          title: "Click to enlarge photo" %>
          <% else %>
            <div class="profile-photo-placeholder">
              <i class="ri-user-line"></i>
            </div>
          <% end %>

          <div class="photo-status-badge photo-status-verified">
            <i class="ri-verified-badge-fill me-1"></i>Verified
          </div>
        </div>
        <div class="photo-hint">
          <i class="ri-zoom-in-line me-1"></i>Click to enlarge
        </div>
      </div>

      <%# Two-Column Data Grid %>
      <div class="profile-data-col">
        <h4 class="profile-name"><%= display_name %></h4>

        <div class="data-grid">
          <%# Row 1 %>
          <div class="data-grid-row">
            <div class="data-cell">
              <span class="data-label">Date of Birth</span>
              <span class="data-value"><%= user.dob&.strftime("%b %d, %Y") || "N/A" %></span>
            </div>
            <div class="data-cell">
              <span class="data-label">BonID Number</span>
              <span class="data-value data-value--mono data-value--bonid"><%= mask_bonid(submission.bonid) %></span>
            </div>
          </div>

          <%# Row 2 %>
          <div class="data-grid-row">
            <div class="data-cell">
              <span class="data-label">Sex</span>
              <span class="data-value"><%= user.sex&.capitalize || "N/A" %></span>
            </div>
            <div class="data-cell">
              <span class="data-label">Expiration</span>
              <span class="data-value">
                <% if submission.expires_at %>
                  <%= submission.expires_at.strftime("%b %d, %Y") %>
                  <% if submission.expires_at < Time.current %>
                    <span class="status-pill status-pill--expired">Expired</span>
                  <% elsif submission.expires_at < 30.days.from_now %>
                    <span class="status-pill status-pill--warning">Expiring Soon</span>
                  <% else %>
                    <span class="status-pill status-pill--valid">Valid</span>
                  <% end %>
                <% else %>
                  N/A
                <% end %>
              </span>
            </div>
          </div>

          <%# Row 3 %>
          <div class="data-grid-row">
            <div class="data-cell">
              <span class="data-label">Age</span>
              <span class="data-value"><%= age_display || "N/A" %></span>
            </div>
            <div class="data-cell">
              <span class="data-label">Marital Status</span>
              <span class="data-value"><%= user.respond_to?(:marital_status) ? user.marital_status&.capitalize || "N/A" : "N/A" %></span>
            </div>
          </div>
        </div>

        <%# Address — two lines %>
        <% if user.address %>
          <div class="profile-address">
            <i class="ri-map-pin-2-fill address-pin"></i>
            <div>
              <% addr = user.address %>
              <div class="address-primary"><%= [addr.street_address, addr.locality].compact_blank.join(", ") %></div>
              <div class="address-secondary"><%= [addr.commune&.name&.upcase, addr.department&.name&.upcase, addr.country&.upcase || "HAITI"].compact_blank.join(", ") %></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <%# ── 3. Medical / Health Sub-Card ── (hidden for CEP) %>
    <% if !is_cep && user.health_profile&.blood_type.present? %>
      <div class="health-subcard">
        <div class="health-subcard-header">
          <i class="ri-heart-pulse-line me-2"></i>Medical Information
        </div>
        <div class="health-pills">
          <span class="health-pill health-pill--blood">
            <i class="ri-drop-fill me-1"></i>Blood Type: <strong><%= user.health_profile.blood_type %></strong>
          </span>
          <% if user.health_profile.organ_donor %>
            <span class="health-pill health-pill--donor">
              <i class="ri-heart-line me-1"></i>Organ Donor
            </span>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# ── 4. Biometric Verification Proof ── %>
    <% liveness_data = submission.metadata&.dig("liveness") %>
    <% face_match_data = submission.metadata&.dig("face_match") %>
    <% if liveness_data.present? || face_match_data.present? %>
      <div class="biometric-subcard">
        <div class="biometric-subcard-header">
          <i class="ri-fingerprint-line me-2"></i>Biometric Verification
        </div>
        <div class="biometric-content">
          <div class="biometric-badges">
            <% if liveness_data.present? %>
              <% liveness_passed = liveness_data["passed"] == true %>
              <% liveness_conf = liveness_data["confidence"]&.to_f&.round(1) %>
              <div class="biometric-badge <%= liveness_passed ? 'biometric-badge--pass' : 'biometric-badge--fail' %>">
                <i class="<%= liveness_passed ? 'ri-checkbox-circle-fill' : 'ri-close-circle-fill' %>"></i>
                <div>
                  <div class="biometric-badge-label">Liveness Check</div>
                  <div class="biometric-badge-value"><%= liveness_passed ? "Passed" : "Failed" %><% if liveness_conf && liveness_conf > 0 %> &middot; <%= liveness_conf %>%<% end %></div>
                </div>
              </div>
            <% end %>

            <% if face_match_data.present? %>
              <% face_matched = face_match_data["status"] == "match" %>
              <% similarity = face_match_data["similarity"]&.to_f&.round(1) %>
              <% compared_to = face_match_data["target_image"] %>
              <div class="biometric-badge <%= face_matched ? 'biometric-badge--pass' : 'biometric-badge--fail' %>">
                <i class="<%= face_matched ? 'ri-user-follow-fill' : 'ri-user-unfollow-fill' %>"></i>
                <div>
                  <div class="biometric-badge-label">Face vs. <%= compared_to == "cin_front" ? "CIN" : compared_to == "passport" ? "Passport" : "ID" %></div>
                  <div class="biometric-badge-value"><%= face_matched ? "Match" : "No Match" %><% if similarity && similarity > 0 %> &middot; <%= similarity %>%<% end %></div>
                </div>
              </div>
            <% end %>
          </div>

          <% if face_match_data&.dig("matched_at").present? %>
            <div class="biometric-timestamp">
              <i class="ri-time-line me-1"></i>
              Verified <%= Time.parse(face_match_data["matched_at"]).strftime("%b %d, %Y at %I:%M %p") rescue face_match_data["matched_at"] %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# ── 5. DGI Fiscal Receipts (Immigration sector only) ── %>
    <% if partner&.department_sector == "immigration" || partner&.sector == "immigration" %>
      <% citizen_receipts = VerificationRecord.where(record_type: "fiscal_receipt", user: user).order(created_at: :desc) %>
      <div class="receipts-subcard">
        <div class="receipts-subcard-header">
          <div class="d-flex align-items-center gap-2">
            <i class="ri-receipt-line"></i>
            DGI — Kes Fiskal
          </div>
          <% available_count = citizen_receipts.where(status: "verified").where.not("data->'consumption'->>'consumed' = ?", "true").count %>
          <% if available_count > 0 %>
            <span class="receipt-count-badge receipt-count-badge--available"><%= available_count %> disponib</span>
          <% else %>
            <span class="receipt-count-badge receipt-count-badge--none">0 disponib</span>
          <% end %>
        </div>
        <div class="receipts-subcard-body">
          <% if citizen_receipts.any? %>
            <table class="receipts-table">
              <thead>
                <tr>
                  <th>Nimewo Resi</th>
                  <th>Tip Taks</th>
                  <th>Montan</th>
                  <th>Dat</th>
                  <th>Estati</th>
                </tr>
              </thead>
              <tbody>
                <% citizen_receipts.limit(10).each do |receipt| %>
                  <% consumed = receipt.data.dig("consumption", "consumed") == "true" || receipt.data.dig("consumption", "consumed") == true %>
                  <tr class="<%= consumed ? 'receipt-row--consumed' : '' %>">
                    <td class="receipt-number"><%= receipt.receipt_number || receipt.data.dig("receipt", "receipt_number") || "—" %></td>
                    <td><%= (receipt.data.dig("receipt", "tax_type") || "—").titleize %></td>
                    <td class="receipt-amount"><%= number_with_delimiter(receipt.data.dig("receipt", "amount_htg").to_i) %> HTG</td>
                    <td><%= receipt.created_at.strftime("%d/%m/%Y") %></td>
                    <td>
                      <% if consumed %>
                        <span class="status-pill status-pill--expired">
                          <i class="ri-close-circle-line me-1"></i>Konsome
                        </span>
                      <% elsif receipt.status == "verified" %>
                        <span class="status-pill status-pill--valid">
                          <i class="ri-checkbox-circle-line me-1"></i>Disponib
                        </span>
                      <% else %>
                        <span class="status-pill status-pill--warning">
                          <i class="ri-time-line me-1"></i><%= receipt.status&.capitalize %>
                        </span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <div class="receipts-empty">
              <i class="ri-receipt-line"></i>
              <p>Okenn kes fiskal DGI pou sitwayen sa a</p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# ── 6. Citizen Applications OR Start New Service ── (hidden for CEP — CEP runs elections, not services) %>
    <% unless is_cep %>
    <% citizen_apps = ServiceApplication.where(citizen: user, partner: partner)
                        .includes(:partner_schema)
                        .where.not(status: "draft")
                        .order(created_at: :desc) %>
    <% available_services = partner&.partner_schemas&.citizen_services&.where(schema_status: "published")&.order(:name) || [] %>

    <% if citizen_apps.any? %>
      <%# ── Has existing applications — show history + "New Service" button ── %>
      <div class="citizen-history-subcard">
        <div class="citizen-history-header">
          <div class="d-flex align-items-center gap-2">
            <i class="ri-file-list-3-line"></i>
            Aplikasyon Sitwayen
          </div>
          <span class="citizen-history-count"><%= citizen_apps.count %></span>
        </div>
        <div class="citizen-history-body">
          <table class="citizen-history-table">
            <thead>
              <tr>
                <th>Sèvis</th>
                <th>Kòd</th>
                <th>Dat</th>
                <th>Estati</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% citizen_apps.limit(10).each do |app| %>
                <tr>
                  <td class="history-service-name"><%= app.partner_schema&.name || "—" %></td>
                  <td class="history-code"><%= app.verification_code %></td>
                  <td><%= app.created_at.strftime("%d/%m/%Y") %></td>
                  <td>
                    <% case app.status
                       when "submitted" %>
                      <span class="status-pill status-pill--warning"><i class="ri-time-line me-1"></i>Soumèt</span>
                    <% when "under_review" %>
                      <span class="status-pill status-pill--warning"><i class="ri-search-eye-line me-1"></i>Ap Revize</span>
                    <% when "approved" %>
                      <span class="status-pill status-pill--valid"><i class="ri-checkbox-circle-line me-1"></i>Apwouve</span>
                    <% when "rejected" %>
                      <span class="status-pill status-pill--expired"><i class="ri-close-circle-line me-1"></i>Rejte</span>
                    <% else %>
                      <span class="status-pill"><%= app.status_label %></span>
                    <% end %>
                  </td>
                  <td>
                    <%= link_to partner_portal_submission_path(app), class: "history-view-link", data: { turbo: false } do %>
                      <i class="ri-eye-line"></i>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <%# ── "New Service" button at bottom of history ── %>
        <% if available_services.any? %>
          <div class="citizen-history-footer">
            <button type="button" class="btn-new-service-toggle" onclick="this.closest('.citizen-history-subcard').querySelector('.render-service-drawer').classList.toggle('render-service-drawer--open'); this.classList.toggle('btn-new-service-toggle--open');">
              <i class="ri-add-circle-line me-1"></i>Nouvo Sèvis
              <i class="ri-arrow-down-s-line toggle-chevron"></i>
            </button>

            <div class="render-service-drawer">
              <% available_services.each do |schema| %>
                <div class="render-service-card">
                  <div class="render-service-info">
                    <div class="render-service-name"><%= schema.name %></div>
                    <div class="render-service-meta">
                      <span class="render-service-category render-service-category--<%= schema.service_category %>">
                        <% case schema.service_category
                           when "application" %><i class="ri-file-text-line me-1"></i>Aplikasyon
                        <% when "transaction" %><i class="ri-exchange-funds-line me-1"></i>Tranzaksyon
                        <% when "appointment" %><i class="ri-calendar-check-line me-1"></i>Randevou
                        <% when "survey" %><i class="ri-questionnaire-line me-1"></i>Sondaj
                        <% end %>
                      </span>
                      <span class="render-service-price"><%= schema.price_display %></span>
                    </div>
                  </div>
                  <%= link_to agent_form_partner_portal_submissions_path(citizen_id: user.id, schema_id: schema.id),
                              class: "btn-render-service",
                              data: { turbo: false } do %>
                    <i class="ri-play-circle-line me-1"></i>Kòmanse
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

    <% else %>
      <%# ── No existing applications — go straight to available services ── %>
      <% if available_services.any? %>
        <div class="render-service-subcard">
          <div class="render-service-header">
            <div class="d-flex align-items-center gap-2">
              <i class="ri-add-circle-line"></i>
              Kòmanse yon Sèvis
            </div>
          </div>
          <div class="render-service-body">
            <div class="render-service-prompt">
              <i class="ri-information-line"></i>
              Okenn aplikasyon pou sitwayen sa a. Chwazi yon sèvis pou kòmanse.
            </div>
            <% available_services.each do |schema| %>
              <div class="render-service-card">
                <div class="render-service-info">
                  <div class="render-service-name"><%= schema.name %></div>
                  <div class="render-service-meta">
                    <span class="render-service-category render-service-category--<%= schema.service_category %>">
                      <% case schema.service_category
                         when "application" %><i class="ri-file-text-line me-1"></i>Aplikasyon
                      <% when "transaction" %><i class="ri-exchange-funds-line me-1"></i>Tranzaksyon
                      <% when "appointment" %><i class="ri-calendar-check-line me-1"></i>Randevou
                      <% when "survey" %><i class="ri-questionnaire-line me-1"></i>Sondaj
                      <% end %>
                    </span>
                    <span class="render-service-price"><%= schema.price_display %></span>
                    <% if schema.form_code_display.present? %>
                      <span class="render-service-form-code"><%= schema.form_code_display %></span>
                    <% end %>
                  </div>
                </div>
                <%= link_to agent_form_partner_portal_submissions_path(citizen_id: user.id, schema_id: schema.id),
                            class: "btn-render-service",
                            data: { turbo: false } do %>
                  <i class="ri-play-circle-line me-1"></i>Kòmanse
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% else %>
        <%# ── No services created yet ── %>
        <div class="no-services-subcard">
          <div class="no-services-icon">
            <i class="ri-service-line"></i>
          </div>
          <h4 class="no-services-title">Ou poko kreye okenn sèvis</h4>
          <p class="no-services-desc">Kreye yon sèvis (fòm, tranzaksyon, randevou, oswa sondaj) pou kòmanse sèvi sitwayen yo.</p>
          <%= link_to new_partner_portal_partner_schema_path, class: "no-services-cta" do %>
            <i class="ri-add-circle-line me-1"></i>Kreye yon Sèvis
          <% end %>
        </div>
      <% end %>
    <% end %>
    <% end %>

    <%# ── 8. Voter Eligibility Card (auto-checked) ── %>
    <% if local_assigns[:voter_record] && voter_record.present? %>
      <div class="voter-eligibility-subcard voter-eligibility--<%= voter_record.eligible? ? 'eligible' : 'ineligible' %>">
        <div class="voter-eligibility-header">
          <div class="d-flex align-items-center gap-2">
            <% if voter_record.eligible? %>
              <i class="ri-checkbox-circle-fill" style="color: #059669; font-size: 20px;"></i>
              <span style="font-weight: 700; color: #065F46;">Elijib pou Vote</span>
            <% else %>
              <i class="ri-close-circle-fill" style="color: #DC2626; font-size: 20px;"></i>
              <span style="font-weight: 700; color: #991B1B;">Pa Elijib</span>
            <% end %>
          </div>
          <span class="voter-eligibility-badge voter-eligibility-badge--<%= voter_record.channel %>">
            <i class="ri-global-line me-1"></i><%= voter_record.channel&.capitalize || "—" %>
          </span>
        </div>

        <div class="voter-eligibility-body">
          <div class="voter-eligibility-grid">
            <div class="voter-eligibility-item">
              <span class="voter-eligibility-label">Sikonskripsyon</span>
              <span class="voter-eligibility-value"><%= voter_record.constituency_name || "—" %></span>
            </div>
            <div class="voter-eligibility-item">
              <span class="voter-eligibility-label">Depatman</span>
              <span class="voter-eligibility-value"><%= voter_record.department_code || "—" %></span>
            </div>
            <% if voter_record.eligible? %>
              <div class="voter-eligibility-item">
                <span class="voter-eligibility-label">Vote Deja?</span>
                <span class="voter-eligibility-value">
                  <% if voter_record.has_voted? %>
                    <span style="color: #059669; font-weight: 600;">
                      <i class="ri-checkbox-circle-line me-1"></i>Wi — <%= voter_record.voted_at&.strftime("%d/%m/%Y %H:%M") %>
                    </span>
                  <% else %>
                    <span style="color: #D97706; font-weight: 600;">
                      <i class="ri-time-line me-1"></i>Poko vote
                    </span>
                  <% end %>
                </span>
              </div>
            <% else %>
              <div class="voter-eligibility-item">
                <span class="voter-eligibility-label">Rezon</span>
                <span class="voter-eligibility-value" style="color: #DC2626; font-weight: 600;">
                  <%= voter_record.ineligibility_label %>
                </span>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%# ── CEP Election Details (voter detail + roles + team) ── %>
    <% if is_cep %>
      <%= render partial: "partner_portal/bonid_lookups/cep_election_details",
                 locals: { user: user, voter_record: local_assigns[:voter_record], partner: partner } %>
    <% end %>

    <%# ── 9. New Scan Button ── %>
    <div class="verified-actions">
      <button type="button" class="btn-new-scan"
              data-action="click->partner-scanner#rescan">
        <i class="ri-refresh-line me-1"></i>New Scan
      </button>
    </div>

    <%# Scan timestamp %>
    <div class="scan-timestamp">
      <i class="ri-time-line me-1"></i>Verified at <%= Time.current.strftime("%H:%M on %b %d, %Y") %>
    </div>
  </div>
</div>

<%# ── Scoped Styles ── %>
<style>
  .verified-profile-card {
    border-radius: 16px;
    overflow: hidden;
    background: #FFFFFF;
  }

  /* ── 1. Verified Banner ── */
  .verified-banner {
    background: #ECFDF5;
    padding: 14px 20px;
    border-bottom: 1px solid rgba(5,150,105,0.12);
  }
  .verified-icon-circle {
    width: 38px; height: 38px;
    border-radius: 50%;
    background: #059669;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .verified-icon-circle i { font-size: 1.1rem; color: #FFF; }
  .verified-title {
    font-family: 'Inter', 'Montserrat', sans-serif;
    font-weight: 700; font-size: 0.9rem; color: #065F46;
  }
  .verified-subtitle {
    font-size: 0.75rem; color: #047857; font-weight: 500; line-height: 1.4;
  }
  .verified-checkmark i {
    font-size: 1.75rem; color: #059669;
  }

  /* ── 2. Profile Layout ── */
  .verified-body { padding: 24px 20px 16px; }

  .profile-layout {
    display: flex; gap: 20px;
    margin-bottom: 20px;
  }

  /* Photo Column */
  .profile-photo-col {
    flex-shrink: 0; text-align: center;
  }
  .profile-photo-frame {
    position: relative; display: inline-block;
  }
  .profile-photo {
    width: 130px; height: 160px;
    object-fit: cover;
    border-radius: 12px;
    border: 3px solid #059669;
    cursor: zoom-in;
    transition: transform 0.2s ease;
  }
  .profile-photo:hover {
    transform: scale(1.03);
  }
  .profile-photo-placeholder {
    width: 130px; height: 160px;
    border-radius: 12px;
    background: #F1F5F9;
    border: 3px solid #059669;
    display: flex; align-items: center; justify-content: center;
  }
  .profile-photo-placeholder i { font-size: 3rem; color: #94A3B8; }

  /* Verified badge overlaid on photo */
  .photo-status-badge {
    position: absolute; top: -6px; right: -6px;
    font-size: 0.65rem; font-weight: 700;
    padding: 3px 8px; border-radius: 20px;
    display: inline-flex; align-items: center;
    z-index: 2;
  }
  .photo-status-verified {
    background: #059669; color: #FFF;
  }

  .photo-hint {
    font-size: 0.68rem; color: #94A3B8; margin-top: 8px;
    display: flex; align-items: center; justify-content: center;
  }

  /* Data Column */
  .profile-data-col { flex: 1; min-width: 0; }

