<%# Manual Lookup — Visual Verification Required (Partner Portal) %>
<%= render 'partner_portal/bonid_lookups/photo_modal' %>

<% display_name = user.full_name %>
<% age_display = user.respond_to?(:age) ? user.age : nil %>

<div class="pending-verification-card" data-result-type="pending_confirmation">

  <%# ── 1. Soft Amber Banner (not a box) ── %>
  <div class="verification-banner">
    <div class="d-flex align-items-center gap-3">
      <div class="banner-icon">
        <i class="ri-eye-line"></i>
      </div>
      <div>
        <div class="banner-title">Visual Verification Required</div>
        <div class="banner-instruction">Please confirm the person standing in front of you matches this profile.</div>
      </div>
    </div>
  </div>

  <div class="verification-body">

    <%# ── 2. Identity Profile: Photo + Data Grid ── %>
    <div class="profile-layout">

      <%# Photo with Verified badge overlaid %>
      <div class="profile-photo-col">
        <div class="profile-photo-frame">
          <% if user.photo.attached? %>
            <%= image_tag user.photo.variant(resize_to_limit: [200, 240]),
                          class: "profile-photo",
                          data: {
                            photo_enlarge: true,
                            photo_url: url_for(user.photo.variant(resize_to_limit: [800, 800])),
                            person_name: display_name,
                            status: submission.verified? ? 'Verified' : 'Pending'
                          },
                          title: "Click to enlarge for verification" %>
          <% else %>
            <div class="profile-photo-placeholder">
              <i class="ri-user-line"></i>
            </div>
          <% end %>

          <%# Verified badge on top-right of photo %>
          <% if submission.verified? %>
            <div class="photo-status-badge photo-status-verified">
              <i class="ri-verified-badge-fill me-1"></i>Verified
            </div>
          <% end %>
        </div>
        <div class="photo-hint">
          <i class="ri-zoom-in-line me-1"></i>Click to enlarge
        </div>
      </div>

      <%# Two-Column Data Grid %>
      <div class="profile-data-col">
        <%# Full Name — prominent %>
        <h4 class="profile-name"><%= display_name %></h4>

        <div class="data-grid">
          <%# Row 1 %>
          <div class="data-grid-row">
            <div class="data-cell">
              <span class="data-label">Date of Birth</span>
              <span class="data-value"><%= user.dob&.strftime("%b %d, %Y") || "N/A" %></span>
            </div>
            <div class="data-cell">
              <span class="data-label">BonID Number</span>
              <span class="data-value data-value--mono data-value--bonid"><%= mask_bonid(submission.bonid) %></span>
            </div>
          </div>

          <%# Row 2 %>
          <div class="data-grid-row">
            <div class="data-cell">
              <span class="data-label">Sex</span>
              <span class="data-value"><%= user.sex&.capitalize || "N/A" %></span>
            </div>
            <div class="data-cell">
              <span class="data-label">Expiration</span>
              <span class="data-value">
                <% if submission.expires_at %>
                  <%= submission.expires_at.strftime("%b %d, %Y") %>
                  <% if submission.expires_at < Time.current %>
                    <span class="status-pill status-pill--expired">Expired</span>
                  <% elsif submission.expires_at < 30.days.from_now %>
                    <span class="status-pill status-pill--warning">Expiring Soon</span>
                  <% else %>
                    <span class="status-pill status-pill--valid">Valid</span>
                  <% end %>
                <% else %>
                  N/A
                <% end %>
              </span>
            </div>
          </div>

          <%# Row 3 %>
          <div class="data-grid-row">
            <div class="data-cell">
              <span class="data-label">Age</span>
              <span class="data-value"><%= age_display || "N/A" %></span>
            </div>
            <div class="data-cell">
              <span class="data-label">Marital Status</span>
              <span class="data-value"><%= user.respond_to?(:marital_status) ? user.marital_status&.capitalize || "N/A" : "N/A" %></span>
            </div>
          </div>
        </div>

        <%# Address — two lines %>
        <% if user.address %>
          <div class="profile-address">
            <i class="ri-map-pin-2-fill address-pin"></i>
            <div>
              <% addr = user.address %>
              <div class="address-primary"><%= [addr.street_address, addr.locality].compact_blank.join(", ") %></div>
              <div class="address-secondary"><%= [addr.commune&.name&.upcase, addr.department&.name&.upcase, addr.country&.upcase || "HAITI"].compact_blank.join(", ") %></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <%# ── 3. Medical / Health Sub-Card ── %>
    <% if user.health_profile&.blood_type.present? %>
      <div class="health-subcard">
        <div class="health-subcard-header">
          <i class="ri-heart-pulse-line me-2"></i>Medical Information
        </div>
        <div class="health-pills">
          <span class="health-pill health-pill--blood">
            <i class="ri-drop-fill me-1"></i>Blood Type: <strong><%= user.health_profile.blood_type %></strong>
          </span>
          <% if user.health_profile.organ_donor %>
            <span class="health-pill health-pill--donor">
              <i class="ri-heart-line me-1"></i>Organ Donor
            </span>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# ── 4. Action Bar — Checkbox + Buttons ── %>
    <div class="action-bar">
      <%# Confirmation Checkbox (prominent) %>
      <label class="confirm-checkbox-wrapper" for="visualConfirmation">
        <input class="confirm-checkbox-input" type="checkbox" id="visualConfirmation"
               onchange="const btn = document.getElementById('confirmBtn'); if(btn) btn.disabled = !this.checked;">
        <span class="confirm-checkbox-label">
          <i class="ri-shield-check-line me-2"></i>I confirm this photo matches the person in front of me
        </span>
      </label>

      <%# Buttons — equal height, solid colors %>
      <div class="action-buttons">
        <button type="button"
                id="confirmBtn"
                disabled
                class="action-btn action-btn--confirm"
                data-action="click->partner-scanner#confirmIdentity"
                data-confirm-url="<%= confirm_partner_portal_bonid_lookup_path(submission.id) %>"
                data-confirmed="true">
          <i class="ri-check-double-line me-2"></i>Confirm Identity
        </button>

        <button type="button"
                class="action-btn action-btn--reject"
                data-action="click->partner-scanner#confirmIdentity"
                data-confirm-url="<%= confirm_partner_portal_bonid_lookup_path(submission.id) %>"
                data-confirmed="false">
          <i class="ri-close-circle-line me-2"></i>Not a Match
        </button>
      </div>
    </div>

  </div>
</div>

<%# ── Scoped Styles ── %>
<style>
  .pending-verification-card {
    border-radius: 16px;
    overflow: hidden;
    background: #FFFFFF;
    box-shadow: 0 4px 24px rgba(0,0,0,0.06);
  }

  /* ── 1. Verification Banner ── */
  .verification-banner {
    background: #FFFBEB;
    padding: 14px 20px;
    border-bottom: 1px solid rgba(217,119,6,0.12);
  }
  .banner-icon {
    width: 38px; height: 38px;
    border-radius: 50%;
    background: #F59E0B;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .banner-icon i { font-size: 1.1rem; color: #FFF; }
  .banner-title {
    font-family: 'Inter', 'Montserrat', sans-serif;
    font-weight: 700; font-size: 0.9rem; color: #92400E;
  }
  .banner-instruction {
    font-size: 0.75rem; color: #B45309; font-weight: 500; line-height: 1.4;
  }

  /* ── 2. Profile Layout ── */
  .verification-body { padding: 24px 20px 16px; }

  .profile-layout {
    display: flex; gap: 20px;
    margin-bottom: 20px;
  }

  /* Photo Column */
  .profile-photo-col {
    flex-shrink: 0; text-align: center;
  }
  .profile-photo-frame {
    position: relative; display: inline-block;
  }
  .profile-photo {
    width: 130px; height: 160px;
    object-fit: cover;
    border-radius: 12px;
    border: 3px solid #00209F;
    box-shadow: 0 4px 16px rgba(0,32,159,0.15);
    cursor: zoom-in;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .profile-photo:hover {
    transform: scale(1.03);
    box-shadow: 0 8px 24px rgba(0,32,159,0.2);
  }
  .profile-photo-placeholder {
    width: 130px; height: 160px;
    border-radius: 12px;
    background: #F1F5F9;
    border: 3px solid #00209F;
    display: flex; align-items: center; justify-content: center;
  }
  .profile-photo-placeholder i { font-size: 3rem; color: #94A3B8; }

  /* Verified badge overlaid on photo */
  .photo-status-badge {
    position: absolute; top: -6px; right: -6px;
    font-size: 0.65rem; font-weight: 700;
    padding: 3px 8px; border-radius: 20px;
    display: inline-flex; align-items: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    z-index: 2;
  }
  .photo-status-verified {
    background: #059669; color: #FFF;
  }

  .photo-hint {
    font-size: 0.68rem; color: #94A3B8; margin-top: 8px;
    display: flex; align-items: center; justify-content: center;
  }

  /* Data Column */
  .profile-data-col { flex: 1; min-width: 0; }

  .profile-name {
    font-family: 'Inter', 'Montserrat', sans-serif;
    font-weight: 800; font-size: 1.25rem; color: #0F172A;
    margin: 0 0 14px; line-height: 1.3;
  }

  /* Data Grid */
  .data-grid {
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 14px;
  }
  .data-grid-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .data-grid-row + .data-grid-row {
    border-top: 1px solid #E2E8F0;
  }
  .data-cell {
    padding: 10px 14px;
    display: flex; flex-direction: column; gap: 1px;
  }
  .data-cell + .data-cell {
    border-left: 1px solid #E2E8F0;
  }
  .data-label {
    font-size: 0.68rem; font-weight: 500; color: #94A3B8;
    text-transform: uppercase; letter-spacing: 0.04em;
  }
  .data-value {
    font-size: 0.88rem; font-weight: 600; color: #0F172A;
    display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
  }
  .data-value--mono {
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: 0.8rem; letter-spacing: 0.3px;
  }
  .data-value--bonid {
    color: #DC2626;
  }

  /* Status Pills */
  .status-pill {
    font-size: 0.6rem; font-weight: 700;
    padding: 2px 7px; border-radius: 20px;
    display: inline-flex; align-items: center;
  }
  .status-pill--valid { background: #ECFDF5; color: #059669; }
  .status-pill--warning { background: #FFFBEB; color: #D97706; }
  .status-pill--expired { background: #FEF2F2; color: #DC2626; }

  /* Address */
  .profile-address {
    display: flex; align-items: flex-start; gap: 8px;
    background: #F8FAFC; border-radius: 8px;
    padding: 10px 12px;
  }
  .address-pin { font-size: 0.95rem; color: #64748B; margin-top: 1px; flex-shrink: 0; }
  .address-primary { font-size: 0.82rem; font-weight: 500; color: #334155; }
  .address-secondary { font-size: 0.73rem; color: #64748B; margin-top: 1px; }

  /* ── 3. Health Sub-Card ── */
  .health-subcard {
    background: #FAFBFC;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 20px;
  }
  .health-subcard-header {
    font-family: 'Inter', 'Montserrat', sans-serif;
    font-size: 0.72rem; font-weight: 700; color: #475569;
    text-transform: uppercase; letter-spacing: 0.04em;
    padding: 8px 14px;
    background: #F1F5F9;
    border-bottom: 1px solid #E2E8F0;
    display: flex; align-items: center;
  }
  .health-subcard-header i { font-size: 0.85rem; color: #DC2626; }
  .health-pills {
    padding: 10px 14px;
    display: flex; gap: 10px; flex-wrap: wrap;
  }
  .health-pill {
    font-size: 0.78rem; font-weight: 600;
    padding: 6px 14px; border-radius: 20px;
    display: inline-flex; align-items: center;
  }
  .health-pill--blood {
    background: #FEF2F2;
    color: #991B1B;
    border: 1px solid rgba(220,38,38,0.12);
  }
  .health-pill--blood strong {
    margin-left: 2px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
  }
  .health-pill--donor {
    background: #EFF6FF;
    color: #1E40AF;
    border: 1px solid rgba(30,64,175,0.12);
  }

  /* ── 4. Action Bar ── */
  .action-bar {
    border-top: 1px solid #E2E8F0;
    padding-top: 20px;
  }

  /* Prominent Checkbox */
  .confirm-checkbox-wrapper {
    display: flex; align-items: center; gap: 12px;
    background: #F0FDF4;
    border: 1.5px solid #A7F3D0;
    border-radius: 10px;
    padding: 14px 16px;
    margin-bottom: 14px;
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .confirm-checkbox-wrapper:hover {
    border-color: #059669;
    box-shadow: 0 0 0 3px rgba(5,150,105,0.08);
  }
  .confirm-checkbox-input {
    width: 22px; height: 22px;
    border-radius: 6px;
    border: 2px solid #059669;
    cursor: pointer;
    flex-shrink: 0;
    accent-color: #059669;
  }
  .confirm-checkbox-label {
    font-family: 'Inter', 'Montserrat', sans-serif;
    font-size: 0.85rem; font-weight: 600; color: #065F46;
    display: flex; align-items: center;
  }
  .confirm-checkbox-label i { font-size: 1.1rem; color: #059669; }

  /* Equal Height Buttons */
  .action-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .action-btn {
    font-family: 'Inter', 'Montserrat', sans-serif;
    font-weight: 700; font-size: 0.88rem;
    padding: 14px 16px;
    border-radius: 12px;
    border: none;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: all 0.2s ease;
  }
  .action-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .action-btn--confirm {
    background: #059669!important;
    color: #FFF!important;
    box-shadow: 0 4px 12px rgba(5,150,105,0.3);
  }
  .action-btn--confirm:not(:disabled):hover {
    background: #047857!important;
    color: #FFF!important;
    box-shadow: 0 6px 20px rgba(5,150,105,0.4);
    transform: translateY(-1px);
  }
  .action-btn--reject {
    background: #FFF!important;
    color: #DC2626!important;
    border: 2px solid #DC2626!important;
  }
  .action-btn--reject:hover {
    background: #FEF2F2!important;
    color: #DC2626!important;
    box-shadow: 0 4px 12px rgba(220,38,38,0.15);
    transform: translateY(-1px);
  }

  /* ── Mobile ── */
  @media (max-width: 575.98px) {
    .profile-layout { flex-direction: column; align-items: center; }
    .profile-data-col { text-align: center; }
    .profile-name { text-align: center; }
    .data-grid-row { grid-template-columns: 1fr; }
    .data-cell + .data-cell { border-left: none; border-top: 1px solid #E2E8F0; }
    .profile-address { text-align: left; }
    .action-buttons { grid-template-columns: 1fr; }
    .profile-photo { width: 110px; height: 140px; }
    .profile-photo-placeholder { width: 110px; height: 140px; }
  }
</style>
