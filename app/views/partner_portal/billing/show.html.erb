<%# Faktirasyon — Redesigned Billing Dashboard %>

<div class="billing-dash">

  <%# ── Page Header ── %>
  <div class="billing-header">
    <div>
      <h4 class="billing-page-title"><i class="ri-file-list-3-line me-2"></i>Faktirasyon</h4>
      <p class="billing-page-subtitle">Istwa peman ak rechaj kredi ou</p>
    </div>
    <%= link_to partner_portal_credits_path, class: "billing-cta" do %>
      <i class="ri-wallet-3-line me-1"></i>Rechaje Kredi
    <% end %>
  </div>

  <%# ══════════════════════════════════════════════════════════ %>
  <%# ── 1. KPI CARDS — Hero Balance + 2 supporting metrics ── %>
  <%# ══════════════════════════════════════════════════════════ %>
  <div class="billing-kpi-row">

    <%# Hero: Balance (wider, deep blue tint) %>
    <div class="kpi-card kpi-card--hero">
      <div class="kpi-header">
        <span class="kpi-label">Balans Kredi</span>
        <div class="kpi-icon kpi-icon--blue"><i class="ri-wallet-3-line"></i></div>
      </div>
      <div class="kpi-value kpi-value--hero"><%= number_with_delimiter(@stats[:balance]) %></div>
      <div class="kpi-sub kpi-sub--contrast">
        ≈ $<%= number_with_precision(@stats[:balance] * 0.01, precision: 2) %> USD
      </div>
      <div class="kpi-footer">
        <div class="kpi-footer-stat">
          <i class="ri-bar-chart-box-line"></i>
          <span><%= @stats[:total_payments] %> tranzaksyon total</span>
        </div>
        <%= link_to partner_portal_credits_path, class: "kpi-recharge-btn" do %>
          <i class="ri-add-line me-1"></i>Rechaje
        <% end %>
      </div>
    </div>

    <%# Spent This Month %>
    <div class="kpi-card">
      <div class="kpi-header">
        <span class="kpi-label">Depanse Mwa Sa</span>
        <div class="kpi-icon kpi-icon--red"><i class="ri-arrow-down-line"></i></div>
      </div>
      <div class="kpi-value kpi-value--red">-<%= number_with_delimiter(@stats[:spent_this_month]) %></div>
      <div class="kpi-sub">kredi itilize</div>
      <div class="kpi-footer">
        <% if @stats[:failed_payments] > 0 %>
          <div class="kpi-footer-stat kpi-footer-stat--red">
            <i class="ri-error-warning-line"></i>
            <span><%= @stats[:failed_payments] %> peman echwe</span>
          </div>
        <% else %>
          <div class="kpi-footer-stat kpi-footer-stat--green">
            <i class="ri-checkbox-circle-line"></i>
            <span>Tout peman reyisi</span>
          </div>
        <% end %>
      </div>
    </div>

    <%# Recharged This Month %>
    <div class="kpi-card">
      <div class="kpi-header">
        <span class="kpi-label">Rechaje Mwa Sa</span>
        <div class="kpi-icon kpi-icon--green"><i class="ri-arrow-up-line"></i></div>
      </div>
      <div class="kpi-value kpi-value--green">+<%= number_with_delimiter(@stats[:added_this_month]) %></div>
      <div class="kpi-sub">kredi ajoute</div>
      <div class="kpi-footer">
        <div class="kpi-footer-stat kpi-footer-stat--green">
          <i class="ri-checkbox-circle-line"></i>
          <span><%= @stats[:successful_payments] %> peman reyisi</span>
        </div>
      </div>
    </div>
  </div>

  <%# ══════════════════════════════════════════════════════════ %>
  <%# ── 2. TRANSACTION TABLE ── %>
  <%# ══════════════════════════════════════════════════════════ %>
  <div class="billing-card">
    <div class="billing-card-header">
      <h6 class="billing-card-title">
        <i class="ri-file-list-3-line me-2"></i>Istwa Peman
      </h6>

      <div class="billing-toolbar">
        <%# Search %>
        <div class="billing-search">
          <i class="ri-search-line"></i>
          <input type="text" placeholder="Chèche nimewo kòmand..."
                 class="billing-search-input"
                 id="billingSearch"
                 oninput="filterPayments()">
        </div>

        <%# Status Filters (left-aligned feel) %>
        <div class="billing-filters">
          <%= link_to partner_portal_billing_path,
                class: "billing-filter-btn #{@active_filter.blank? ? 'active' : ''}" do %>
            Tout
          <% end %>
          <%= link_to partner_portal_billing_path(status: "completed"),
                class: "billing-filter-btn #{@active_filter == 'completed' ? 'active' : ''}" do %>
            Konplete
          <% end %>
          <%= link_to partner_portal_billing_path(status: "pending"),
                class: "billing-filter-btn #{@active_filter == 'pending' ? 'active' : ''}" do %>
            Annatant
          <% end %>
          <%= link_to partner_portal_billing_path(status: "failed"),
                class: "billing-filter-btn #{@active_filter == 'failed' ? 'active' : ''}" do %>
            Echwe
          <% end %>
        </div>

        <%# Export %>
        <button class="billing-export-btn" disabled title="Bientot disponible">
          <i class="ri-download-2-line me-1"></i>CSV
        </button>
      </div>
    </div>

    <div class="billing-card-body">
      <% if @payments.present? %>
        <div class="billing-table-wrap">
          <table class="billing-table">
            <thead>
              <tr>
                <th>Dat</th>
                <th>Nimewo Kòmand</th>
                <th class="text-center">Kredi</th>
                <th>Montan</th>
                <th class="text-center">Metòd</th>
                <th class="text-center">Estati</th>
              </tr>
            </thead>
            <tbody>
              <% @payments.each do |payment| %>
                <tr class="billing-row" data-order-id="<%= payment.order_id.to_s.downcase %>">
                  <%# Date %>
                  <td>
                    <div class="billing-date"><%= payment.created_at.strftime("%d/%m/%Y") %></div>
                    <div class="billing-time"><%= payment.created_at.strftime("%H:%M") %></div>
                  </td>

                  <%# Order ID with copy %>
                  <td>
                    <div class="order-id-cell">
                      <code class="order-id-code"><%= payment.order_id.to_s.truncate(22) %></code>
                      <button type="button" class="order-copy-btn" data-copy="<%= payment.order_id %>"
                              onclick="copyOrderId(this)" title="Kopye ID">
                        <i class="ri-file-copy-line"></i>
                      </button>
                    </div>
                  </td>

                  <%# Credits %>
                  <td class="text-center">
                    <% if payment.metadata.is_a?(Hash) && payment.metadata["credits"].present? %>
                      <span class="credits-added">+<%= number_with_delimiter(payment.metadata["credits"]) %></span>
                    <% else %>
                      <span class="table-muted">—</span>
                    <% end %>
                  </td>

                  <%# Amount (emphasized) %>
                  <td>
                    <span class="amount-value"><%= payment.formatted_amount %></span>
                  </td>

                  <%# Method with icon %>
                  <td class="text-center">
                    <% if payment.payment_method == "moncash" %>
                      <span class="method-badge method-badge--moncash">
                        <span class="moncash-icon">M</span>MonCash
                      </span>
                    <% else %>
                      <span class="method-badge method-badge--stripe">
                        <i class="ri-bank-card-line me-1"></i>Stripe
                      </span>
                    <% end %>
                  </td>

                  <%# Status (full pill badges) %>
                  <td class="text-center">
                    <% case payment.status
                       when "completed" %>
                      <span class="status-badge status-badge--completed">
                        <i class="ri-checkbox-circle-fill me-1"></i>Konplete
                      </span>
                    <% when "pending" %>
                      <span class="status-badge status-badge--pending">
                        <i class="ri-time-line me-1"></i>Annatant
                      </span>
                    <% when "failed" %>
                      <span class="status-badge status-badge--failed">
                        <i class="ri-close-circle-fill me-1"></i>Echwe
                      </span>
                    <% when "refunded" %>
                      <span class="status-badge status-badge--refunded">
                        <i class="ri-refund-2-line me-1"></i>Ranbouse
                      </span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <%# Footer %>
        <div class="billing-table-footer">
          <span class="table-muted"><%= @payments.length %> tranzaksyon afiche</span>
          <% if @active_filter.present? %>
            <%= link_to partner_portal_billing_path, class: "billing-clear-filter" do %>
              <i class="ri-close-line me-1"></i>Retire Filtè
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="billing-empty">
          <i class="ri-file-list-3-line"></i>
          <p class="billing-empty-title">Pa gen peman ankò</p>
          <p class="billing-empty-desc">
            <% if @active_filter.present? %>
              Pa gen peman "<%= @active_filter %>" pou kounye a.
              <%= link_to "Retire filtè", partner_portal_billing_path, style: "color: #00209F;" %>
            <% else %>
              Rechaje kredi ou pou kòmanse itilize API a.
            <% end %>
          </p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%# ══════════════════════════════════════════════════════════ %>
<%# ── STYLES ── %>
<%# ══════════════════════════════════════════════════════════ %>
<style>
  .billing-dash { max-width: 1140px; margin: 0 auto; padding: 24px 16px; }

  /* ── Header ── */
  .billing-header {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 24px; flex-wrap: wrap; gap: 12px;
  }
  .billing-page-title {
    font-family: 'Inter', 'Montserrat', sans-serif;
    font-weight: 700; font-size: 1.3rem; color: #0F172A;
    margin: 0; display: flex; align-items: center;
  }
  .billing-page-title i { color: #00209F; font-size: 1.1rem; }
  .billing-page-subtitle {
    font-size: 0.8rem; color: #64748B; margin: 4px 0 0;
  }
  .billing-cta {
    font-family: 'Inter', 'Montserrat', sans-serif;
    font-weight: 600; font-size: 0.82rem;
    background: #00209F; color: #FFF;
    padding: 9px 20px; border-radius: 10px;
    text-decoration: none;
    display: inline-flex; align-items: center;
    transition: background 0.15s;
  }
  .billing-cta:hover { background: #001A7A; color: #FFF; }

  /* ── KPI Row ── */
  .billing-kpi-row {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 16px;
    margin-bottom: 24px;
  }

  .kpi-card {
    background: #FFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 20px;
    display: flex; flex-direction: column;
  }
  .kpi-card--hero {
    background: #0A1628;
    border-color: #1E293B;
  }
  .kpi-card--hero .kpi-label { color: rgba(255,255,255,0.5); }
  .kpi-card--hero .kpi-value { color: #FFF; }
  .kpi-card--hero .kpi-footer { border-color: rgba(255,255,255,0.1); }

  .kpi-header {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 12px;
  }
  .kpi-label {
    font-size: 0.68rem; font-weight: 600; color: #94A3B8;
    text-transform: uppercase; letter-spacing: 0.05em;
  }
  .kpi-icon {
    width: 32px; height: 32px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.95rem;
  }
  .kpi-icon--blue { background: rgba(0,32,159,0.15); color: #3B82F6; }
  .kpi-icon--red { background: rgba(220,38,38,0.08); color: #DC2626; }
  .kpi-icon--green { background: rgba(5,150,105,0.08); color: #059669; }
  .kpi-card--hero .kpi-icon--blue { background: rgba(59,130,246,0.2); color: #60A5FA; }

  .kpi-value {
    font-family: 'Inter', 'Montserrat', sans-serif;
    font-weight: 800; font-size: 1.8rem; color: #0F172A;
    line-height: 1;
  }
  .kpi-value--hero { font-size: 2.4rem; }
  .kpi-value--red { color: #DC2626; }
  .kpi-value--green { color: #059669; }

  .kpi-sub {
    font-size: 0.78rem; color: #94A3B8; margin-top: 4px;
  }
  .kpi-sub--contrast {
    font-size: 0.88rem; font-weight: 600;
    color: rgba(255,255,255,0.7);
  }

  .kpi-footer {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid #F1F5F9;
    display: flex; justify-content: space-between; align-items: center;
    margin-top: 14px;
  }
  .kpi-footer-stat {
    display: flex; align-items: center; gap: 4px;
    font-size: 0.7rem; color: #94A3B8;
  }
  .kpi-footer-stat i { font-size: 0.75rem; }
  .kpi-footer-stat--red { color: #DC2626; }
  .kpi-footer-stat--red i { color: #DC2626; }
  .kpi-footer-stat--green { color: #059669; }
  .kpi-footer-stat--green i { color: #059669; }
  .kpi-card--hero .kpi-footer-stat { color: rgba(255,255,255,0.4); }

  .kpi-recharge-btn {
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem; font-weight: 600;
    color: #60A5FA; text-decoration: none;
    background: rgba(96,165,250,0.1);
    padding: 4px 12px; border-radius: 6px;
    display: inline-flex; align-items: center;
    transition: background 0.15s;
  }
  .kpi-recharge-btn:hover { background: rgba(96,165,250,0.2); color: #93C5FD; }

  /* ── Billing Card ── */
  .billing-card {
    background: #FFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    overflow: hidden;
  }
  .billing-card-header {
    padding: 16px 20px;
    border-bottom: 1px solid #F1F5F9;
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 12px;
  }
  .billing-card-title {
    font-family: 'Inter', 'Montserrat', sans-serif;
    font-size: 0.82rem; font-weight: 700; color: #0F172A;
    margin: 0; display: flex; align-items: center;
  }
  .billing-card-title i { color: #64748B; font-size: 0.95rem; }
  .billing-card-body { padding: 0; }

  /* ── Toolbar ── */
  .billing-toolbar {
    display: flex; align-items: center; gap: 10px;
    flex-wrap: wrap;
  }
  .billing-search {
    display: flex; align-items: center;
    background: #F8FAFC; border: 1px solid #E2E8F0;
    border-radius: 8px; padding: 0 10px;
  }
  .billing-search i { font-size: 0.82rem; color: #94A3B8; }
  .billing-search-input {
    border: none; background: transparent;
    font-size: 0.75rem; padding: 6px 8px;
    outline: none; color: #334155; width: 180px;
  }
  .billing-search-input::placeholder { color: #CBD5E1; }

  .billing-filters {
    display: flex; gap: 0;
    border: 1px solid #E2E8F0; border-radius: 8px;
    overflow: hidden;
  }
  .billing-filter-btn {
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem; font-weight: 600;
    padding: 6px 14px;
    color: #64748B; background: #FFF;
    text-decoration: none;
    border-right: 1px solid #E2E8F0;
    transition: all 0.1s;
  }
  .billing-filter-btn:last-child { border-right: none; }
  .billing-filter-btn:hover { background: #F8FAFC; color: #334155; }
  .billing-filter-btn.active {
    background: #0F172A; color: #FFF;
  }

  .billing-export-btn {
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem; font-weight: 600;
    padding: 6px 12px; border-radius: 8px;
    color: #94A3B8; background: #FFF;
    border: 1px solid #E2E8F0;
    cursor: not-allowed; opacity: 0.5;
    display: inline-flex; align-items: center;
  }

  /* ── Table ── */
  .billing-table-wrap { overflow-x: auto; }
  .billing-table {
    width: 100%; border-collapse: collapse;
    font-size: 0.82rem;
  }
  .billing-table thead th {
    font-family: 'Inter', 'Montserrat', sans-serif;
    font-size: 0.68rem; font-weight: 700; color: #64748B;
    text-transform: uppercase; letter-spacing: 0.04em;
    padding: 10px 16px;
    background: #FAFBFC;
    border-bottom: 1px solid #E2E8F0;
    white-space: nowrap;
  }
  .billing-table tbody tr {
    border-bottom: 1px solid #F8FAFC;
    transition: background 0.1s;
  }
  .billing-table tbody tr:last-child { border-bottom: none; }
  .billing-table tbody tr:hover { background: #F8FAFC; }
  .billing-table tbody td {
    padding: 16px;
    vertical-align: middle;
  }

  .billing-date {
    font-size: 0.82rem; font-weight: 500; color: #334155;
  }
  .billing-time {
    font-size: 0.68rem; color: #94A3B8;
  }

  /* ── Order ID ── */
  .order-id-cell {
    display: flex; align-items: center; gap: 6px;
  }
  .order-id-code {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem; font-weight: 500;
    color: #334155;
    background: #F8FAFC;
    padding: 4px 8px; border-radius: 4px;
    border: 1px solid #E2E8F0;
  }
  .order-copy-btn {
    background: none; border: none; cursor: pointer;
    color: #CBD5E1; font-size: 0.82rem; padding: 2px;
    border-radius: 4px; transition: color 0.15s;
  }
  .order-copy-btn:hover { color: #00209F; }

  /* ── Credits ── */
  .credits-added {
    font-family: 'Inter', sans-serif;
    font-weight: 600; font-size: 0.82rem;
    color: #059669;
  }

  /* ── Amount (emphasized) ── */
  .amount-value {
    font-family: 'Inter', 'Montserrat', sans-serif;
    font-weight: 700; font-size: 0.92rem;
    color: #0F172A;
  }

  /* ── Method Badges ── */
  .method-badge {
    font-size: 0.68rem; font-weight: 600;
    padding: 4px 12px; border-radius: 20px;
    display: inline-flex; align-items: center;
    white-space: nowrap;
  }
  .method-badge--moncash {
    background: #FFF7ED; color: #C2410C;
    border: 1px solid rgba(194,65,12,0.12);
  }
  .method-badge--stripe {
    background: #EFF6FF; color: #1D4ED8;
    border: 1px solid rgba(29,78,216,0.12);
  }
  .moncash-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 16px; height: 16px;
    border-radius: 4px;
    background: #C2410C; color: #FFF;
    font-family: 'Inter', sans-serif;
    font-weight: 800; font-size: 0.55rem;
    margin-right: 5px; flex-shrink: 0;
  }

  /* ── Status Badges (high contrast solid pills) ── */
  .status-badge {
    font-size: 0.65rem; font-weight: 700;
    padding: 4px 12px; border-radius: 20px;
    display: inline-flex; align-items: center;
    white-space: nowrap;
  }
  .status-badge--completed {
    background: #ECFDF5; color: #065F46;
    border: 1px solid rgba(5,150,105,0.15);
  }
  .status-badge--pending {
    background: #FFFBEB; color: #92400E;
    border: 1px solid rgba(217,119,6,0.15);
  }
  .status-badge--failed {
    background: #FEF2F2; color: #991B1B;
    border: 1px solid rgba(220,38,38,0.15);
  }
  .status-badge--refunded {
    background: #EFF6FF; color: #1E40AF;
    border: 1px solid rgba(30,64,175,0.15);
  }

  .table-muted { font-size: 0.75rem; color: #94A3B8; }

  /* ── Footer ── */
  .billing-table-footer {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 16px;
    border-top: 1px solid #F1F5F9;
  }
  .billing-clear-filter {
    font-size: 0.75rem; font-weight: 600;
    color: #00209F; text-decoration: none;
    display: inline-flex; align-items: center;
  }
  .billing-clear-filter:hover { text-decoration: underline; }

  /* ── Empty State ── */
  .billing-empty {
    text-align: center; padding: 48px 20px;
  }
  .billing-empty > i {
    font-size: 2.5rem; color: #E2E8F0; display: block; margin-bottom: 12px;
  }
  .billing-empty-title {
    font-family: 'Inter', 'Montserrat', sans-serif;
    font-size: 0.88rem; font-weight: 600; color: #475569; margin: 0 0 4px;
  }
  .billing-empty-desc {
    font-size: 0.78rem; color: #94A3B8; margin: 0;
  }

  /* ── Mobile ── */
  @media (max-width: 991.98px) {
    .billing-kpi-row { grid-template-columns: 1fr; }
    .kpi-card--hero { order: -1; }
    .kpi-value--hero { font-size: 2rem; }
  }
  @media (max-width: 767.98px) {
    .billing-toolbar { flex-direction: column; align-items: stretch; }
    .billing-search-input { width: 100%; }
    .billing-filters { width: 100%; justify-content: stretch; }
    .billing-filter-btn { flex: 1; text-align: center; }
    .billing-header { flex-direction: column; align-items: flex-start; }
    .billing-table tbody td { padding: 12px 10px; }
    .amount-value { font-size: 0.82rem; }
  }
</style>

<%# ══════════════════════════════════════════════════════════ %>
<%# ── SCRIPT ── %>
<%# ══════════════════════════════════════════════════════════ %>
<script>
  function copyOrderId(btn) {
    const text = btn.dataset.copy;
    navigator.clipboard.writeText(text).then(() => {
      const icon = btn.querySelector('i');
      icon.className = 'ri-check-line';
      icon.style.color = '#059669';
      setTimeout(() => {
        icon.className = 'ri-file-copy-line';
        icon.style.color = '';
      }, 1500);
    });
  }

  function filterPayments() {
    const query = document.getElementById('billingSearch').value.trim().toLowerCase();
    document.querySelectorAll('.billing-row').forEach(row => {
      if (!query) {
        row.style.display = '';
        return;
      }
      const orderId = (row.dataset.orderId || '').toLowerCase();
      row.style.display = orderId.includes(query) ? '' : 'none';
    });
  }
</script>
