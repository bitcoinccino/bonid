<%# Shared form — new + edit for ElectionMissionParticipation. The mission
    itself is static (from HaitianDiplomaticMissions concern) and identified
    by `diplomatic_mission_id`; on `new` it's pinned via a hidden field, on
    `edit` it's read-only. %>

<%
  mission = @participation.mission || {}
  region_label = HaitianDiplomaticMissions::REGIONS[mission[:region]] || mission[:region].to_s.titleize
  type_label   = HaitianDiplomaticMissions::MISSION_TYPES[mission[:type]] || mission[:type].to_s.titleize
%>

<%= form_with model: @participation,
              url: @participation.persisted? ? partner_portal_diplomatic_mission_path(@participation) : partner_portal_diplomatic_missions_path,
              method: @participation.persisted? ? :patch : :post,
              local: true do |f| %>

  <% if @participation.errors.any? %>
    <div class="alert alert-danger">
      <strong><%= pluralize(@participation.errors.count, "erè") %>:</strong>
      <ul class="mb-0 small">
        <% @participation.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <%# Mission identity (read-only, derived from static concern). %>
  <div class="pp-card card mb-4 border-0 bg-light">
    <div class="card-body">
      <div class="row g-2">
        <div class="col-md-6">
          <div class="small text-muted text-uppercase fw-semibold">Misyon</div>
          <div class="fw-bold"><%= mission[:name] %></div>
          <div class="small text-muted font-monospace"><%= @participation.diplomatic_mission_id %></div>
        </div>
        <div class="col-md-3">
          <div class="small text-muted text-uppercase fw-semibold">Tip</div>
          <div><%= type_label %></div>
        </div>
        <div class="col-md-3">
          <div class="small text-muted text-uppercase fw-semibold">Rejyon / Peyi</div>
          <div><%= region_label %> · <%= mission[:country] %></div>
        </div>
      </div>
    </div>
  </div>

  <%= f.hidden_field :diplomatic_mission_id %>

  <h6 class="text-uppercase small fw-semibold text-muted mb-3">
    <i class="ri-information-line me-1"></i>Konfigirasyon Eleksyon
  </h6>

  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <%= f.label :status, "Estati", class: "form-label" %>
      <%= f.select :status,
                   ElectionMissionParticipation::STATUSES.map { |s|
                     [ElectionMissionParticipation::STATUS_LABELS[s], s]
                   },
                   {}, class: "form-select", required: true %>
    </div>
    <div class="col-md-4">
      <%= f.label :contact_phone, "Telefòn lokal", class: "form-label" %>
      <%= f.telephone_field :contact_phone, class: "form-control",
                            placeholder: "+1 305 …" %>
    </div>
    <div class="col-md-4">
      <%= f.label :contact_email, "Imel kontak", class: "form-label" %>
      <%= f.email_field :contact_email, class: "form-control",
                        placeholder: "konsila@…" %>
    </div>
    <div class="col-12">
      <%= f.label :notes, "Nòt entèn (admin sèlman)", class: "form-label" %>
      <%= f.text_area :notes, rows: 2, class: "form-control" %>
    </div>
  </div>

  <hr class="my-4">

  <%# === ADRÈS POSTAL === Structured fields rendered per host country's
      UPU S42 format by PostalAddressFormatter at display time. Required
      once the mission goes live (registration_open / voting_open). %>
  <h6 class="text-uppercase small fw-semibold text-muted mb-3">
    <i class="ri-map-pin-line me-1"></i>Adrès Postal Konsila a
    <% if @participation.address_required? %>
      <span class="badge bg-danger-subtle text-danger ms-2">Obligatwa</span>
    <% else %>
      <span class="badge bg-light text-muted ms-2">Opsyonèl pou kounye a</span>
    <% end %>
  </h6>
  <p class="small text-muted mb-3">
    Adrès kote misyon an opere fizikman pou eleksyon sa. Yo pral pran fòmat
    otomatikman daprè règ postal peyi a (UPU S42) lè yo afiche pou sitwayen
    dyaspora a oswa enprime sou resi vòt yo.
  </p>

  <div class="row g-3 mb-4">
    <div class="col-md-8">
      <%= f.label :street_line1, "Adrès / Ri (liy 1)", class: "form-label" %>
      <%= f.text_field :street_line1, class: "form-control",
                       placeholder: address_placeholder(mission[:country], :street) %>
    </div>
    <div class="col-md-4">
      <%= f.label :street_line2, "Adrès (liy 2)", class: "form-label" %>
      <%= f.text_field :street_line2, class: "form-control",
                       placeholder: "Suite, apt, etc." %>
    </div>

    <div class="col-md-5">
      <%= f.label :locality, "Vil / Lokalite", class: "form-label" %>
      <%= f.text_field :locality, class: "form-control",
                       placeholder: address_placeholder(mission[:country], :locality) %>
    </div>
    <div class="col-md-4">
      <%= f.label :region, "Eta / Pwovens / Depatman", class: "form-label" %>
      <%= f.text_field :region, class: "form-control",
                       placeholder: address_placeholder(mission[:country], :region) %>
    </div>
    <div class="col-md-3">
      <%= f.label :postal_code, "Kòd Postal", class: "form-label" %>
      <%= f.text_field :postal_code, class: "form-control",
                       placeholder: address_placeholder(mission[:country], :postal) %>
    </div>

    <div class="col-md-3">
      <%= f.label :latitude, "Latitid (opsyonèl)", class: "form-label" %>
      <%= f.number_field :latitude, step: "any", class: "form-control",
                         placeholder: "25.7617" %>
    </div>
    <div class="col-md-3">
      <%= f.label :longitude, "Lonjitid (opsyonèl)", class: "form-label" %>
      <%= f.number_field :longitude, step: "any", class: "form-control",
                         placeholder: "-80.1918" %>
    </div>
  </div>

  <%# Live preview of how the address will render via the formatter — only
      visible after the record has been saved at least once with data. %>
  <% if @participation.persisted? && @participation.full_address.present? %>
    <div class="alert alert-light border d-flex justify-content-between align-items-start mb-4">
      <div>
        <div class="small text-muted text-uppercase fw-semibold mb-1">
          Aperçu fòmat UPU S42 (<%= mission[:country] %>)
        </div>
        <pre class="mb-0 small" style="white-space: pre-wrap; font-family: inherit;"><%= @participation.full_address %></pre>
      </div>
    </div>
  <% end %>

  <hr class="my-4">

  <%# === ORÈ DOPERASYON === Reusable shared editor; same as ElectoralOffice. %>
  <%= render "partner_portal/shared/hours_editor",
             record: @participation,
             field_prefix: "election_mission_participation[operating_hours]",
             id_prefix: "mission-#{@participation.diplomatic_mission_id.to_s.parameterize}" %>

  <div class="d-flex justify-content-end gap-2">
    <%= link_to "Anile", partner_portal_diplomatic_missions_path, class: "btn btn-link" %>
    <%= f.submit(@participation.new_record? ? "Konfigire Misyon" : "Anrejistre Chanjman",
                 class: "btn pp-btn-brand px-4") %>
  </div>
<% end %>
