<%# Partner Portal — Konfigire yon misyon diplomatik pou eleksyon aktyèl la. %>

<div class="container-fluid py-4">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <h4 class="pp-page-title">
        <i class="ri-add-circle-line me-2 pp-text-brand"></i>Konfigire Misyon Diplomatik
      </h4>
      <p class="pp-page-subtitle">
        Aktive yon anbasad oswa konsila pou eleksyon dyaspora a — defini estati,
        kontak lokal, ak orè operasyon.
      </p>
    </div>
    <%= link_to partner_portal_diplomatic_missions_path, class: "btn btn-outline-secondary" do %>
      <i class="ri-arrow-left-line me-1"></i>Tounen
    <% end %>
  </div>

  <div class="pp-card card">
    <div class="card-body p-4">
      <%= render "form" %>
    </div>
  </div>
</div>
