<%# Partner Portal — Misyon Diplomatik (per-election diaspora missions). CEP-only.
    Lists ALL 38 Haitian embassies/consulates grouped by region with
    per-mission status: "Pa konfigire" if no participation row exists for the
    active election, otherwise the participation status badge. %>

<div class="container-fluid py-4">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <h4 class="pp-page-title">
        <i class="ri-global-line me-2 pp-text-brand"></i>Misyon Diplomatik
      </h4>
      <p class="pp-page-subtitle">
        Anbasad ak konsila — konfigirasyon pou eleksyon dyaspora a
        <% if @election %>
          (<strong><%= @election.title %></strong>)
        <% end %>
      </p>
    </div>
  </div>

  <% unless @election %>
    <div class="alert alert-warning">
      <i class="ri-error-warning-line me-1"></i>
      Pa gen eleksyon aktiv. Kreye yon eleksyon BonVote anvan ou ka konfigire misyon.
    </div>
  <% end %>

  <%# === STATS === %>
  <div class="row g-3 mb-4">
    <% [
      ["Total Misyon",       @counts[:total],             "text-primary"],
      ["Konfigire",          @counts[:configured],        "text-info"],
      ["Enskripsyon Louvri", @counts[:registration_open], "text-warning"],
      ["Vòt Louvri",         @counts[:voting_open],       "text-success"],
      ["Fèmen",              @counts[:closed],            "text-muted"]
    ].each do |label, count, color| %>
      <div class="col">
        <div class="pp-card card border-0">
          <div class="card-body text-center py-3">
            <div class="fs-4 fw-bold <%= color %>"><%= count %></div>
            <div class="small text-muted text-uppercase" style="letter-spacing:.05em;">
              <%= label %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <%# === FILTERS === %>
  <%= form_with url: partner_portal_diplomatic_missions_path, method: :get, local: true,
                class: "row g-2 mb-3" do |f| %>
    <div class="col-md-4">
      <%= text_field_tag :q, params[:q],
                         placeholder: "Chache pa non oswa kòd misyon…",
                         class: "form-control" %>
    </div>
    <div class="col-md-3">
      <%= select_tag :region,
            options_for_select(
              [["Tout rejyon", ""]] + HaitianDiplomaticMissions::REGIONS.map { |k, v| [v, k] },
              @region_filter),
            class: "form-select" %>
    </div>
    <div class="col-md-3">
      <%= select_tag :status,
            options_for_select(
              [["Tout estati", ""], ["Pa konfigire", "unconfigured"]] +
              ElectionMissionParticipation::STATUSES.map { |s|
                [ElectionMissionParticipation::STATUS_LABELS[s], s]
              },
              @status_filter),
            class: "form-select" %>
    </div>
    <div class="col-md-2">
      <%= submit_tag "Filtre", class: "btn btn-outline-primary w-100" %>
    </div>
  <% end %>

  <%# === MISSIONS GROUPED BY REGION === %>
  <% if @missions.any? %>
    <% @missions.group_by { |m| m[:region] }.each do |region, list| %>
      <div class="pp-card card mb-3">
        <div class="card-header bg-light">
          <h6 class="mb-0 fw-semibold">
            <i class="ri-map-2-line me-1"></i>
            <%= HaitianDiplomaticMissions::REGIONS[region] || region.titleize %>
            <span class="badge bg-secondary-subtle text-secondary ms-2"><%= list.size %></span>
          </h6>
        </div>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Misyon</th>
                <th>Tip</th>
                <th>Estati</th>
                <th>Adrès Postal (S42)</th>
                <th>Kontak</th>
                <th class="text-end">Aksyon</th>
              </tr>
            </thead>
            <tbody>
              <% list.each do |m| %>
                <% p = @participations_by_id[m[:id]] %>
                <tr>
                  <td class="fw-semibold">
                    <span class="me-1" aria-hidden="true" style="font-size:1.1em;"><%= country_flag(m[:country]) %></span>
                    <%= m[:name] %>
                    <div class="small text-muted font-monospace"><%= m[:id] %></div>
                  </td>
                  <td>
                    <span class="badge bg-info-subtle text-info">
                      <%= HaitianDiplomaticMissions::MISSION_TYPES[m[:type]] || m[:type].titleize %>
                    </span>
                  </td>
                  <td>
                    <% if p %>
                      <span class="badge <%=
                        case p.status
                        when 'voting_open'        then 'bg-success-subtle text-success'
                        when 'registration_open'  then 'bg-warning-subtle text-warning'
                        when 'closed'             then 'bg-secondary-subtle text-secondary'
                        else 'bg-light text-muted' end %>">
                        <%= p.status_label %>
                      </span>
                    <% else %>
                      <span class="badge bg-light text-muted">Pa konfigire</span>
                    <% end %>
                  </td>
                  <td class="small" style="max-width: 280px;">
                    <% if p && p.full_address.present? %>
                      <div data-controller="copy-address" class="d-flex align-items-start gap-2">
                        <pre class="mb-0 small flex-grow-1"
                             style="white-space: pre-wrap; font-family: inherit;"
                             data-copy-address-target="source"><%= p.full_address %></pre>
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                data-action="click->copy-address#copy"
                                data-copy-address-target="button"
                                title="Kopye adrès la">
                          <i class="ri-clipboard-line"></i>
                        </button>
                      </div>
                      <div class="text-muted small mt-1">
                        <%= country_flag(m[:country]) %> <%= m[:country] %> · UPU S42
                      </div>
                    <% else %>
                      <span class="text-muted">Pa gen adrès</span>
                      <div class="text-muted small"><%= country_flag(m[:country]) %> <%= m[:country] %></div>
                    <% end %>
                  </td>
                  <td class="small">
                    <% if p %>
                      <%= p.contact_phone.presence || "—" %>
                      <% if p.contact_email.present? %>
                        <div class="text-muted"><%= p.contact_email %></div>
                      <% end %>
                    <% else %>
                      —
                    <% end %>
                  </td>
                  <td class="text-end">
                    <% if current_portal_user&.has_role?(:partner_admin) && @election %>
                      <% if p %>
                        <%= link_to "Modifye", edit_partner_portal_diplomatic_mission_path(p),
                                    class: "btn btn-sm btn-outline-secondary" %>
                        <%= button_to "Retire", partner_portal_diplomatic_mission_path(p),
                                      method: :delete,
                                      form: { data: { turbo_confirm: "Retire konfigirasyon pou #{m[:name]}?" } },
                                      class: "btn btn-sm btn-outline-danger" %>
                      <% else %>
                        <%= link_to new_partner_portal_diplomatic_mission_path(mission_id: m[:id]),
                                    class: "btn btn-sm pp-btn-brand" do %>
                          <i class="ri-add-line me-1"></i>Konfigire
                        <% end %>
                      <% end %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="pp-card card">
      <div class="card-body text-center text-muted py-5">
        <i class="ri-inbox-line d-block mb-2" style="font-size: 2rem;"></i>
        Pa gen misyon ki matche filtè a.
      </div>
    </div>
  <% end %>
</div>
