<%# Voter Eligibility Lookup — CEP checks if a BonID holder can vote %>

<div class="container-fluid py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">

      <h4 class="pp-page-title">
        <i class="ri-user-search-line me-2 pp-text-brand"></i>Chèche Votè
      </h4>
      <p class="pp-page-subtitle mb-4">
        Verifye si yon sitwayen elijib pou vote nan eleksyon sa a.
      </p>

      <%# Search Form %>
      <div class="pp-card card mb-4">
        <div class="card-body p-4">
          <%= form_with url: partner_portal_voter_eligibility_lookup_path, method: :post, local: true, class: "d-flex gap-3 align-items-end" do |f| %>
            <div class="flex-grow-1">
              <label class="form-label fw-semibold pp-text-sm">Nimewo BonID</label>
              <%= f.text_field :bonid, value: params[:bonid], class: "form-control form-control-lg pp-font-mono",
                  placeholder: "Antre BonID sitwayen an...", autofocus: true %>
            </div>
            <div>
              <%= f.submit "Chèche", class: "btn pp-btn-brand btn-lg px-4" %>
            </div>
          <% end %>
        </div>
      </div>

      <%# Result %>
      <% if @record %>
        <div class="pp-card card">
          <div class="card-body p-4">
            <% if @record.eligible? %>
              <div class="text-center mb-3">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center pp-bg-success-bg" style="width: 64px; height: 64px;">
                  <i class="ri-checkbox-circle-fill pp-icon-xl pp-text-success"></i>
                </div>
              </div>
              <h5 class="text-center fw-bold text-success mb-3">Elijib pou vote</h5>
            <% else %>
              <div class="text-center mb-3">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center pp-bg-danger-bg" style="width: 64px; height: 64px;">
                  <i class="ri-close-circle-fill pp-icon-xl pp-text-danger"></i>
                </div>
              </div>
              <h5 class="text-center fw-bold text-danger mb-3">Pa elijib</h5>
              <p class="text-center text-muted"><%= @record.ineligibility_label %></p>
            <% end %>

            <table class="table table-sm pp-table-detail mt-3">
              <tbody>
                <tr>
                  <td>BonID</td>
                  <td><code><%= mask_bonid(@record.bonid) %></code></td>
                </tr>
                <tr>
                  <td>Estati</td>
                  <td>
                    <span class="badge bg-<%= @record.eligible? ? 'success' : 'danger' %>"><%= @record.status.capitalize %></span>
                  </td>
                </tr>
                <% if @record.eligible? %>
                  <tr>
                    <td>Sikonskripsyon</td>
                    <td><%= @record.constituency_name %></td>
                  </tr>
                  <tr>
                    <td>Depatman</td>
                    <td><%= @record.department_code %></td>
                  </tr>
                  <tr>
                    <td>Kanal</td>
                    <td><%= @record.channel == "diaspora" ? "Dyaspora" : "Domestik" %></td>
                  </tr>
                  <tr>
                    <td>Deja vote?</td>
                    <td>
                      <% if @record.has_voted? %>
                        <span class="badge bg-info">Wi — <%= l(@record.voted_at, format: :short) %></span>
                      <% else %>
                        <span class="badge bg-secondary">Non</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% elsif params[:bonid].present? %>
        <div class="pp-card card">
          <div class="pp-empty-state">
            <i class="ri-user-unfollow-line"></i>
            <h6>BonID pa jwenn</h6>
            <p>Pa gen okenn sitwayen ki gen BonID sa a nan sistèm nan.</p>
          </div>
        </div>
      <% end %>

    </div>
  </div>
</div>
