<%# Shared Submissions Section — embedded in every sector dashboard %>
<%# 4 sections: 1) Pulse Metrics  2) Quick Actions  3) Category Tabs + Filters  4) Submissions Table %>

<% if @sub_active_services&.any? || (@sub_category_counts && @sub_category_counts[:total] > 0) %>
<section class="dash-submissions-section" aria-label="Soumisyon sitwayen">

  <%# ================================================================ %>
  <%# 1. THE PULSE — Dynamic Metric Bar %>
  <%# ================================================================ %>
  <div class="sub-pulse" role="region" aria-label="Metrik">
    <% if @sub_category == "application" && @sub_pulse %>
      <div class="sub-pulse-card sub-pulse-card--blue">
        <div class="sub-pulse-icon"><i class="ri-time-line"></i></div>
        <div class="sub-pulse-info">
          <span class="sub-pulse-num"><%= @sub_pulse[:pending_review] %></span>
          <span class="sub-pulse-label">Ap Tann Revizyon</span>
        </div>
      </div>
      <div class="sub-pulse-card sub-pulse-card--green">
        <div class="sub-pulse-icon"><i class="ri-check-double-line"></i></div>
        <div class="sub-pulse-info">
          <span class="sub-pulse-num"><%= @sub_pulse[:approved_today] %></span>
          <span class="sub-pulse-label">Apwouve Jodi a</span>
        </div>
      </div>
      <div class="sub-pulse-card sub-pulse-card--red">
        <div class="sub-pulse-icon"><i class="ri-close-circle-line"></i></div>
        <div class="sub-pulse-info">
          <span class="sub-pulse-num"><%= @sub_pulse[:rejected] %></span>
          <span class="sub-pulse-label">Rejte</span>
        </div>
      </div>
      <div class="sub-pulse-card">
        <div class="sub-pulse-icon"><i class="ri-file-list-3-line"></i></div>
        <div class="sub-pulse-info">
          <span class="sub-pulse-num"><%= @sub_pulse[:total] %></span>
          <span class="sub-pulse-label">Total</span>
        </div>
      </div>

    <% elsif @sub_category == "transaction" && @sub_pulse %>
      <div class="sub-pulse-card sub-pulse-card--green">
        <div class="sub-pulse-icon"><i class="ri-money-dollar-circle-line"></i></div>
        <div class="sub-pulse-info">
          <span class="sub-pulse-num"><%= (@sub_pulse[:total_revenue].to_f / 100).round(0).to_s.reverse.gsub(/(\d{3})(?=\d)/, '\1,').reverse %></span>
          <span class="sub-pulse-label">Revni (<%= @sub_pulse[:currency] %>)</span>
        </div>
      </div>
      <div class="sub-pulse-card sub-pulse-card--blue">
        <div class="sub-pulse-icon"><i class="ri-ticket-line"></i></div>
        <div class="sub-pulse-info">
          <span class="sub-pulse-num"><%= @sub_pulse[:tickets_sold] %></span>
          <span class="sub-pulse-label">Tikè Vann</span>
        </div>
      </div>
      <div class="sub-pulse-card sub-pulse-card--teal">
        <div class="sub-pulse-icon"><i class="ri-user-follow-line"></i></div>
        <div class="sub-pulse-info">
          <span class="sub-pulse-num"><%= @sub_pulse[:checked_in] %></span>
          <span class="sub-pulse-label">Tcheke</span>
        </div>
      </div>

    <% elsif @sub_category == "appointment" && @sub_pulse %>
      <div class="sub-pulse-card sub-pulse-card--amber">
        <div class="sub-pulse-icon"><i class="ri-calendar-todo-line"></i></div>
        <div class="sub-pulse-info">
          <span class="sub-pulse-num"><%= @sub_pulse[:today_booked] %></span>
          <span class="sub-pulse-label">Jodi a</span>
        </div>
      </div>
      <div class="sub-pulse-card sub-pulse-card--blue">
        <div class="sub-pulse-icon"><i class="ri-calendar-check-line"></i></div>
        <div class="sub-pulse-info">
          <span class="sub-pulse-num"><%= @sub_pulse[:upcoming] %></span>
          <span class="sub-pulse-label">Ap Vini</span>
        </div>
      </div>
      <div class="sub-pulse-card sub-pulse-card--green">
        <div class="sub-pulse-icon"><i class="ri-user-follow-line"></i></div>
        <div class="sub-pulse-info">
          <span class="sub-pulse-num"><%= @sub_pulse[:checked_in] %></span>
          <span class="sub-pulse-label">Rive</span>
        </div>
      </div>
      <div class="sub-pulse-card sub-pulse-card--red">
        <div class="sub-pulse-icon"><i class="ri-user-unfollow-line"></i></div>
        <div class="sub-pulse-info">
          <span class="sub-pulse-num"><%= @sub_pulse[:no_show] %></span>
          <span class="sub-pulse-label">Pa Rive</span>
        </div>
      </div>

    <% elsif @sub_category == "survey" && @sub_pulse %>
      <div class="sub-pulse-card sub-pulse-card--purple">
        <div class="sub-pulse-icon"><i class="ri-questionnaire-line"></i></div>
        <div class="sub-pulse-info">
          <span class="sub-pulse-num"><%= @sub_pulse[:total_responses] %></span>
          <span class="sub-pulse-label">Repons Total</span>
        </div>
      </div>
      <div class="sub-pulse-card sub-pulse-card--blue">
        <div class="sub-pulse-icon"><i class="ri-calendar-line"></i></div>
        <div class="sub-pulse-info">
          <span class="sub-pulse-num"><%= @sub_pulse[:this_week] %></span>
          <span class="sub-pulse-label">Semèn sa a</span>
        </div>
      </div>
      <div class="sub-pulse-card sub-pulse-card--green">
        <div class="sub-pulse-icon"><i class="ri-pie-chart-line"></i></div>
        <div class="sub-pulse-info">
          <span class="sub-pulse-num"><%= @sub_pulse[:completion_rate] %>%</span>
          <span class="sub-pulse-label">To Konplesyon</span>
        </div>
      </div>

    <% elsif @sub_pulse %>
      <%# Default pulse — all categories %>
      <div class="sub-pulse-card sub-pulse-card--blue">
        <div class="sub-pulse-icon"><i class="ri-inbox-line"></i></div>
        <div class="sub-pulse-info">
          <span class="sub-pulse-num"><%= @sub_pulse[:total] %></span>
          <span class="sub-pulse-label">Total Soumisyon</span>
        </div>
      </div>
      <div class="sub-pulse-card sub-pulse-card--green">
        <div class="sub-pulse-icon"><i class="ri-calendar-check-line"></i></div>
        <div class="sub-pulse-info">
          <span class="sub-pulse-num"><%= @sub_pulse[:today] %></span>
          <span class="sub-pulse-label">Jodi a</span>
        </div>
      </div>
      <div class="sub-pulse-card sub-pulse-card--amber">
        <div class="sub-pulse-icon"><i class="ri-time-line"></i></div>
        <div class="sub-pulse-info">
          <span class="sub-pulse-num"><%= @sub_pulse[:pending] %></span>
          <span class="sub-pulse-label">Annatant</span>
        </div>
      </div>
      <div class="sub-pulse-card sub-pulse-card--teal">
        <div class="sub-pulse-icon"><i class="ri-check-double-line"></i></div>
        <div class="sub-pulse-info">
          <span class="sub-pulse-num"><%= @sub_pulse[:approved] %></span>
          <span class="sub-pulse-label">Apwouve</span>
        </div>
      </div>
    <% end %>
  </div>

  <%# ================================================================ %>
  <%# 2. AKSYON RAPID — Active Service Cards %>
  <%# ================================================================ %>
  <% services_to_show = @sub_active_services %>
  <% if @sub_category.present? %>
    <% services_to_show = services_to_show.select { |s| s.service_category == @sub_category } %>
  <% end %>

  <% if services_to_show.any? %>
    <%
      cat_config = {
        "application" => { color: "blue",   icon: "ri-file-list-3-line",      cta: "Jere",   cta_icon: "ri-settings-3-line" },
        "transaction" => { color: "green",  icon: "ri-exchange-dollar-line",  cta: "Achte",  cta_icon: "ri-shopping-cart-line" },
        "appointment" => { color: "amber",  icon: "ri-calendar-check-line",   cta: "Pran",   cta_icon: "ri-calendar-line" },
        "survey"      => { color: "purple", icon: "ri-questionnaire-line",    cta: "Ranpli", cta_icon: "ri-edit-line" }
      }
    %>
    <div class="sub-services-header">
      <h3 class="sub-services-title"><i class="ri-apps-2-line me-2"></i>Aksyon Rapid</h3>
    </div>
    <div class="sub-service-cards">
      <% services_to_show.first(6).each do |service| %>
        <% cfg = cat_config[service.service_category] || cat_config["application"] %>
        <div class="sub-svc-card sub-svc-card--<%= cfg[:color] %>">
          <div class="sub-svc-icon sub-svc-icon--<%= cfg[:color] %>">
            <i class="<%= cfg[:icon] %>"></i>
          </div>
          <div class="sub-svc-body">
            <h4 class="sub-svc-name"><%= service.name %></h4>
            <div class="sub-svc-meta">
              <span class="sub-svc-price"><%= service.price_display %></span>
              <% if service.capacity.present? %>
                <span class="sub-svc-capacity">
                  <i class="ri-group-line"></i> <%= service.sold_count %>/<%= service.capacity %>
                </span>
              <% end %>
            </div>
          </div>
          <div class="sub-svc-actions">
            <%= link_to partner_portal_submissions_path(service_id: service.id),
                class: "sub-svc-cta sub-svc-cta--#{cfg[:color]}" do %>
              <i class="<%= cfg[:cta_icon] %> me-1"></i><%= cfg[:cta] %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# ================================================================ %>
  <%# 3. LIS SOUMISYON — Category Tabs + Filters + Table %>
  <%# ================================================================ %>
  <% if @sub_category_counts && @sub_category_counts[:total] > 0 %>
    <div class="sub-list-header">
      <h3 class="sub-list-title"><i class="ri-list-check-2 me-2"></i>Lis Soumisyon</h3>
      <% if @sub_category == "survey" || @sub_category == "transaction" %>
        <%= link_to export_partner_portal_submissions_path(category: @sub_category),
            class: "dash-btn dash-btn--outline dash-btn--sm", data: { turbo: false } do %>
          <i class="ri-download-line"></i> CSV
        <% end %>
      <% end %>
    </div>

    <%# Category Tabs %>
    <div class="sub-category-tabs">
      <%= link_to partner_portal_dashboard_path,
          class: "sub-cat-tab #{'sub-cat-tab--active' unless @sub_category.present?}" do %>
        <i class="ri-inbox-line"></i>
        <span>Tout</span>
        <span class="sub-cat-count"><%= @sub_category_counts[:total] %></span>
      <% end %>
      <% if @sub_category_counts[:application] > 0 %>
        <%= link_to partner_portal_dashboard_path(category: "application"),
            class: "sub-cat-tab sub-cat-tab--application #{'sub-cat-tab--active' if @sub_category == 'application'}" do %>
          <i class="ri-file-list-3-line"></i>
          <span>Aplikasyon</span>
          <span class="sub-cat-count"><%= @sub_category_counts[:application] %></span>
        <% end %>
      <% end %>
      <% if @sub_category_counts[:transaction] > 0 %>
        <%= link_to partner_portal_dashboard_path(category: "transaction"),
            class: "sub-cat-tab sub-cat-tab--transaction #{'sub-cat-tab--active' if @sub_category == 'transaction'}" do %>
          <i class="ri-exchange-dollar-line"></i>
          <span>Tranzaksyon</span>
          <span class="sub-cat-count"><%= @sub_category_counts[:transaction] %></span>
        <% end %>
      <% end %>
      <% if @sub_category_counts[:appointment] > 0 %>
        <%= link_to partner_portal_dashboard_path(category: "appointment"),
            class: "sub-cat-tab sub-cat-tab--appointment #{'sub-cat-tab--active' if @sub_category == 'appointment'}" do %>
          <i class="ri-calendar-check-line"></i>
          <span>Randevou</span>
          <span class="sub-cat-count"><%= @sub_category_counts[:appointment] %></span>
        <% end %>
      <% end %>
      <% if @sub_category_counts[:survey] > 0 %>
        <%= link_to partner_portal_dashboard_path(category: "survey"),
            class: "sub-cat-tab sub-cat-tab--survey #{'sub-cat-tab--active' if @sub_category == 'survey'}" do %>
          <i class="ri-questionnaire-line"></i>
          <span>Sondaj</span>
          <span class="sub-cat-count"><%= @sub_category_counts[:survey] %></span>
        <% end %>
      <% end %>
    </div>

    <%# Survey Analytics %>
    <% if @sub_category == "survey" && @sub_survey_aggregations.present? %>
      <div class="sub-analytics-grid">
        <% @sub_survey_aggregations.each do |agg| %>
          <div class="dash-card">
            <div class="dash-card-header"><h3 style="font-size:0.82rem;font-weight:700;margin:0;"><i class="ri-bar-chart-2-line me-1"></i> <%= agg[:label] %></h3></div>
            <div class="dash-card-body">
              <div class="sub-chart-bars">
                <% agg[:options].each do |opt| %>
                  <div class="sub-chart-bar-row">
                    <div class="sub-chart-label"><%= opt[:label] %></div>
                    <div class="sub-chart-track">
                      <div class="sub-chart-fill sub-chart-fill--purple" style="width: <%= opt[:pct] %>%;"></div>
                    </div>
                    <div class="sub-chart-value"><%= opt[:count] %> (<%= opt[:pct] %>%)</div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# ── Status Filter + Search + Date Range ── %>
    <% unless @sub_category == "survey" %>
      <div class="sub-tabs">
        <%= link_to "Tout (#{@sub_status_counts.values.sum})",
            partner_portal_dashboard_path(category: @sub_category),
            class: "sub-tab #{'sub-tab--active' unless params[:sub_status].present?}" %>
        <% statuses = case @sub_category
             when "transaction" then %w[submitted approved]
             when "appointment" then %w[submitted approved]
             else %w[submitted under_review approved rejected]
           end %>
        <% statuses.each do |st| %>
          <% label = { "submitted" => "Soumèt", "under_review" => "Ap Revize", "approved" => "Apwouve", "rejected" => "Rejte" }[st] %>
          <% count = @sub_status_counts[st] || 0 %>
          <%= link_to "#{label} (#{count})",
              partner_portal_dashboard_path(sub_status: st, category: @sub_category),
              class: "sub-tab #{'sub-tab--active' if params[:sub_status] == st}" %>
        <% end %>
      </div>
    <% end %>

    <%# Enhanced Filter Bar %>
    <div class="sub-filter-bar">
      <%= form_tag partner_portal_dashboard_path, method: :get, class: "sub-filter-form" do %>
        <%= hidden_field_tag :sub_status, params[:sub_status] %>
        <%= hidden_field_tag :category, @sub_category %>
        <div class="sub-filter-row">
          <div class="sub-filter-field sub-filter-field--search">
            <i class="ri-search-line"></i>
            <%= text_field_tag :sub_q, params[:sub_q], placeholder: "Chache pa kòd, non sitwayen...", class: "sub-filter-input" %>
          </div>
          <div class="sub-filter-field">
            <%= select_tag :service_id,
                options_for_select(
                  [["Tout Sèvis", ""]] + @sub_services.select { |s| @sub_category.blank? || s.service_category == @sub_category }.map { |s| [s.name, s.id] },
                  params[:service_id]
                ), class: "sub-filter-select" %>
          </div>
          <div class="sub-filter-field sub-filter-field--date">
            <i class="ri-calendar-line"></i>
            <%= date_field_tag :date_from, params[:date_from], class: "sub-filter-date", placeholder: "Depi" %>
          </div>
          <div class="sub-filter-field sub-filter-field--date">
            <i class="ri-calendar-line"></i>
            <%= date_field_tag :date_to, params[:date_to], class: "sub-filter-date", placeholder: "Jiska" %>
          </div>
          <%= submit_tag "Filtre", class: "sub-filter-btn" %>
          <% if params[:sub_q].present? || params[:service_id].present? || params[:date_from].present? || params[:date_to].present? %>
            <%= link_to partner_portal_dashboard_path(category: @sub_category), class: "sub-filter-clear" do %>
              <i class="ri-close-line"></i>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# ── Submissions Table ── %>
    <div class="dash-card">
      <div class="dash-card-body p-0">
        <% if @submissions.any? %>
          <table class="dash-table">
            <thead>
              <tr>
                <th>Kòd</th>
                <% if @sub_category != "survey" %>
                  <th>Sitwayen</th>
                <% end %>
                <th>Sèvis</th>
                <% if @sub_category == "transaction" %>
                  <th>Montan</th>
                  <th>Peman</th>
                  <th>Tcheke</th>
                <% elsif @sub_category == "appointment" %>
                  <th>Dat Randevou</th>
                  <th>Lè</th>
                  <th>Rive</th>
                <% elsif @sub_category == "application" %>
                  <th>Estati</th>
                  <th>Revizyonè</th>
                <% elsif @sub_category == "survey" %>
                  <th>Dat Soumèt</th>
                <% else %>
                  <th>Estati</th>
                  <th>Pri</th>
                <% end %>
                <th>Dat</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% @submissions.each do |sub| %>
                <tr>
                  <td><code class="dash-mono"><%= sub.verification_code %></code></td>

                  <%# Hide citizen name for anonymous surveys %>
                  <% if @sub_category != "survey" %>
                    <td>
                      <div class="dash-cell-name">
                        <strong><%= sub.citizen.last_name %> <%= sub.citizen.first_name %></strong>
                      </div>
                    </td>
                  <% end %>

                  <td>
                    <%= sub.partner_schema.name %>
                    <% unless @sub_category.present? %>
                      <% scat = sub.partner_schema.service_category %>
                      <% cat_colors = { "application" => "info", "transaction" => "success", "appointment" => "warning", "survey" => "muted" } %>
                      <% cat_labels = { "application" => "App", "transaction" => "Txn", "appointment" => "Rdv", "survey" => "Snd" } %>
                      <span class="dash-badge dash-badge--<%= cat_colors[scat] || 'muted' %>" style="font-size:0.58rem;padding:2px 6px;margin-left:4px;">
                        <%= cat_labels[scat] || scat %>
                      </span>
                    <% end %>
                  </td>

                  <% if @sub_category == "transaction" %>
                    <td><strong><%= sub.price_display %></strong></td>
                    <td>
                      <% if sub.total_price_cents.to_i > 0 %>
                        <span class="dash-badge dash-badge--success">Peye</span>
                      <% else %>
                        <span class="dash-badge dash-badge--muted">Gratis</span>
                      <% end %>
                    </td>
                    <td>
                      <% if sub.checked_in_at.present? %>
                        <span class="dash-badge dash-badge--success"><i class="ri-check-line"></i> Wi</span>
                      <% else %>
                        <span class="dash-badge dash-badge--muted">Non</span>
                      <% end %>
                    </td>

                  <% elsif @sub_category == "appointment" %>
                    <td>
                      <% apt_date = sub.form_data&.dig("appointment_date") %>
                      <% if apt_date.present? %>
                        <%= begin; Date.parse(apt_date).strftime("%d/%m/%Y"); rescue; apt_date; end %>
                      <% else %>
                        —
                      <% end %>
                    </td>
                    <td>
                      <% apt_time = sub.form_data&.dig("appointment_time") %>
                      <%= apt_time.present? ? apt_time : "—" %>
                    </td>
                    <td>
                      <% if sub.checked_in_at.present? %>
                        <span class="dash-badge dash-badge--success"><i class="ri-check-line"></i> Rive</span>
                      <% else %>
                        <span class="dash-badge dash-badge--muted">Ap tann</span>
                      <% end %>
                    </td>

                  <% elsif @sub_category == "application" %>
                    <td>
                      <% status_class = { "submitted" => "warning", "under_review" => "info",
                           "approved" => "success", "rejected" => "danger", "draft" => "muted",
                           "cancelled" => "muted" }[sub.status] || "muted" %>
                      <span class="dash-badge dash-badge--<%= status_class %>"><%= sub.status_label %></span>
                    </td>
                    <td>
                      <% if sub.reviewed_by.present? %>
                        <span class="dash-cell-reviewer"><%= sub.reviewed_by.email.split("@").first %></span>
                      <% else %>
                        <span class="text-muted">—</span>
                      <% end %>
                    </td>

                  <% elsif @sub_category == "survey" %>
                    <td class="dash-cell-date"><%= sub.submitted_at&.strftime("%d/%m/%Y %H:%M") || "—" %></td>

                  <% else %>
                    <td>
                      <% status_class = { "submitted" => "warning", "under_review" => "info",
                           "approved" => "success", "rejected" => "danger", "draft" => "muted",
                           "cancelled" => "muted" }[sub.status] || "muted" %>
                      <span class="dash-badge dash-badge--<%= status_class %>"><%= sub.status_label %></span>
                    </td>
                    <td><%= sub.price_display %></td>
                  <% end %>

                  <% unless @sub_category == "survey" %>
                    <td class="dash-cell-date"><%= sub.submitted_at&.strftime("%d/%m/%Y %H:%M") || "—" %></td>
                  <% end %>
                  <td>
                    <%= link_to partner_portal_submission_path(sub), class: "dash-btn dash-btn--sm dash-btn--outline" do %>
                      <i class="ri-eye-line"></i> Wè
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="dash-empty">
            <% case @sub_category
               when "transaction" %>
              <i class="ri-exchange-dollar-line"></i>
              <p>Pa gen tranzaksyon pou moman sa a.</p>
            <% when "appointment" %>
              <i class="ri-calendar-check-line"></i>
              <p>Pa gen randevou pou moman sa a.</p>
            <% when "survey" %>
              <i class="ri-questionnaire-line"></i>
              <p>Pa gen repons sondaj pou moman sa a.</p>
            <% when "application" %>
              <i class="ri-file-list-3-line"></i>
              <p>Pa gen aplikasyon pou moman sa a.</p>
            <% else %>
              <i class="ri-inbox-line"></i>
              <p>Pa gen soumisyon pou moman sa a.</p>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</section>

<%# ================================================================ %>
<%# Submissions Section Styles %>
<%# ================================================================ %>
<style>
  /* ── Pulse Metric Bar ── */
  .sub-pulse {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 14px;
    margin-bottom: 24px;
    margin-top: 1.5rem;
  }
  .sub-pulse-card {
    background: #FFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 16px 18px;
    display: flex;
    align-items: center;
    gap: 14px;
    border-left: 3px solid #CBD5E1;
  }
  .sub-pulse-card--blue   { border-left-color: #00209F; }
  .sub-pulse-card--green  { border-left-color: #059669; }
  .sub-pulse-card--amber  { border-left-color: #D97706; }
  .sub-pulse-card--red    { border-left-color: #DC2626; }
  .sub-pulse-card--teal   { border-left-color: #0891B2; }
  .sub-pulse-card--purple { border-left-color: #7C3AED; }

  .sub-pulse-icon {
    width: 42px; height: 42px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.15rem;
    background: #F1F5F9;
    color: #475569;
