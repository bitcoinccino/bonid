<%# Partner Dashboard Tabs — non-LE partners only %>
<div class="dashboard-fixed-header">
  <div class="tab-header pt-2 pb-2 border-bottom">
    <div class="d-flex flex-wrap gap-2 justify-content-start px-3 overflow-x-auto">
      <button type="button" class="partner-action-btn active"
              data-action="dashboard#switchTab"
              data-dashboard-target="tabButton"
              data-target-tab="#overview"
              aria-controls="overview"
              aria-current="true">
        <i class="ri-dashboard-line me-1"></i> Overview
      </button>
      <button type="button" class="partner-action-btn"
              data-action="dashboard#switchTab"
              data-dashboard-target="tabButton"
              data-target-tab="#recent-verifications"
              aria-controls="recent-verifications">
        <i class="ri-shield-check-line me-1"></i> Recent Verifications
      </button>
      <button type="button" class="partner-action-btn"
              data-action="dashboard#switchTab"
              data-dashboard-target="tabButton"
              data-target-tab="#consent-grants"
              aria-controls="consent-grants">
        <i class="ri-user-heart-line me-1"></i> Consent Grants
      </button>
    </div>
  </div>
</div>

<style>
  .partner-action-btn {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 6px 14px;
    border-radius: 20px;
    border: 1px solid var(--haitian-blue, #00209F);
    background: transparent;
    color: var(--haitian-blue, #00209F);
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .partner-action-btn:hover {
    background: rgba(0, 32, 159, 0.08);
  }
  .partner-action-btn.active {
    background: var(--haitian-blue, #00209F);
    color: #fff;
    border-color: var(--haitian-blue, #00209F);
  }
</style>
