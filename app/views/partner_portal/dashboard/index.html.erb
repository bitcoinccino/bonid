<%# Partner Dashboard — Redesigned 70/30 Layout %>

<div class="partner-dashboard" data-controller="dashboard">

  <%# ── Page Header ── %>
  <div class="dash-header">
    <div>
      <h4 class="dash-title">Dashboard</h4>
      <p class="dash-subtitle">Welcome back, <%= current_portal_user&.first_name || current_partner&.contact_person || "Partner" %></p>
    </div>
    <%= link_to partner_portal_scans_path, class: "dash-cta" do %>
      <i class="ri-qr-scan-2-line me-2"></i>Start New Verification
    <% end %>
  </div>

  <%# ── Metric Cards Row ── %>
  <div class="dash-metrics">
    <div class="metric-card metric-card--blue">
      <div class="metric-icon metric-icon--blue"><i class="ri-qr-scan-2-line"></i></div>
      <div class="metric-info">
        <span class="metric-value"><%= @stats[:qr_scans] %></span>
        <span class="metric-label">Total Scans</span>
      </div>
    </div>

    <div class="metric-card metric-card--green">
      <div class="metric-icon metric-icon--green"><i class="ri-calendar-check-line"></i></div>
      <div class="metric-info">
        <span class="metric-value"><%= @stats[:qr_scans_today] %></span>
        <span class="metric-label">Today</span>
      </div>
    </div>

    <div class="metric-card metric-card--teal">
      <div class="metric-icon metric-icon--teal"><i class="ri-shield-check-line"></i></div>
      <div class="metric-info">
        <span class="metric-value"><%= @stats[:verifications] %></span>
        <span class="metric-label">Verifications</span>
      </div>
    </div>

    <div class="metric-card metric-card--purple">
      <div class="metric-icon metric-icon--purple"><i class="ri-user-heart-line"></i></div>
      <div class="metric-info">
        <span class="metric-value"><%= @stats[:consent_grants] %></span>
        <span class="metric-label">Consents</span>
      </div>
    </div>
  </div>

  <%# ── Two-Column Content (70/30) ── %>
  <div class="dash-content">

    <%# ── LEFT 70%: Activity Feed ── %>
    <div class="dash-main">

      <%# Recent Activity Card %>
      <div class="dash-card">
        <div class="dash-card-header">
          <h6 class="dash-card-title">
            <i class="ri-time-line me-2"></i>Recent Activity
          </h6>
          <div class="d-flex align-items-center gap-2">
            <div class="activity-search">
              <i class="ri-search-line"></i>
              <input type="text" placeholder="Search by name or BonID..."
                     class="activity-search-input"
                     data-action="input->dashboard#filterActivity"
                     data-dashboard-target="searchInput">
            </div>
            <%= link_to partner_portal_scans_path, class: "dash-view-all" do %>
              View All <i class="ri-arrow-right-s-line"></i>
            <% end %>
          </div>
        </div>
        <div class="dash-card-body" data-dashboard-target="activityList">
          <% if @recent_scans.any? %>
            <% @recent_scans.each do |scan| %>
              <% user = scan.identity_submission&.user %>
              <div class="activity-row" data-dashboard-target="activityRow"
                   data-name="<%= user&.full_name&.downcase %>"
                   data-bonid="<%= scan.identity_submission&.bonid&.downcase %>">
                <div class="activity-left">
                  <%# Avatar %>
                  <div class="activity-avatar">
                    <% if user&.photo&.attached? %>
                      <%= image_tag user.photo.variant(resize_to_limit: [36, 36]),
                                    class: "activity-avatar-img" %>
                    <% else %>
                      <span class="activity-avatar-initials">
                        <%= user&.full_name&.split&.map(&:first)&.first(2)&.join&.upcase || "?" %>
                      </span>
                    <% end %>
                  </div>
                  <%# Name + BonID %>
                  <div class="activity-info">
                    <span class="activity-name"><%= user&.full_name || "Unknown" %></span>
                    <code class="activity-bonid"><%= scan.identity_submission&.bonid.present? ? mask_bonid(scan.identity_submission.bonid) : "N/A" %></code>
                  </div>
                </div>
                <div class="activity-right">
                  <%# Method Badge %>
                  <% if scan.manual? %>
                    <span class="activity-badge activity-badge--manual">Manual</span>
                  <% else %>
                    <span class="activity-badge activity-badge--qr">QR Scan</span>
                  <% end %>
                  <%# Timestamp %>
                  <span class="activity-time"><%= time_ago_in_words(scan.created_at) %> ago</span>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="activity-empty">
              <i class="ri-scan-line"></i>
              <p>No scans yet. Start verifying BonIDs!</p>
              <%= link_to partner_portal_scans_path, class: "dash-cta dash-cta--sm" do %>
                <i class="ri-qr-scan-2-line me-1"></i>Start Scanning
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <%# Consent Grants Card %>
      <% if @consent_grants.any? %>
        <div class="dash-card">
          <div class="dash-card-header">
            <h6 class="dash-card-title">
              <i class="ri-user-follow-line me-2"></i>Authorized Citizens
            </h6>
          </div>
          <div class="dash-card-body">
            <% @consent_grants.first(5).each do |grant| %>
              <% citizen = grant.citizen %>
              <div class="activity-row">
                <div class="activity-left">
                  <div class="activity-avatar">
                    <% if citizen&.photo&.attached? %>
                      <%= image_tag citizen.photo.variant(resize_to_limit: [36, 36]),
                                    class: "activity-avatar-img" %>
                    <% else %>
                      <span class="activity-avatar-initials activity-avatar-initials--teal">
                        <%= citizen&.full_name&.split&.map(&:first)&.first(2)&.join&.upcase || "?" %>
                      </span>
                    <% end %>
                  </div>
                  <div class="activity-info">
                    <span class="activity-name"><%= citizen&.full_name || "Unknown" %></span>
                    <div class="activity-scopes">
                      <% (grant.granted_scopes || []).first(2).each do |scope| %>
                        <span class="scope-tag"><%= scope %></span>
                      <% end %>
                    </div>
                  </div>
                </div>
                <div class="activity-right">
                  <span class="activity-badge activity-badge--approved">Approved</span>
                  <span class="activity-time"><%= time_ago_in_words(grant.created_at) %> ago</span>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Transaction Consents Card %>
      <% if @transaction_consents&.any? %>
        <div class="dash-card">
          <div class="dash-card-header">
            <h6 class="dash-card-title">
              <i class="ri-shield-check-line me-2"></i>Transaction Consents
            </h6>
          </div>
          <div class="dash-card-body">
            <% @transaction_consents.each do |consent| %>
              <% citizen = consent.citizen %>
              <% face_data = consent.metadata&.dig("face_comparison") %>
              <div class="activity-row">
                <div class="activity-left">
                  <div class="activity-avatar">
                    <% if citizen&.photo&.attached? %>
                      <%= image_tag citizen.photo.variant(resize_to_limit: [36, 36]),
                                    class: "activity-avatar-img" %>
                    <% else %>
                      <span class="activity-avatar-initials">
                        <%= citizen&.full_name&.split&.map(&:first)&.first(2)&.join&.upcase || "?" %>
                      </span>
                    <% end %>
                  </div>
                  <div class="activity-info">
                    <span class="activity-name"><%= citizen&.full_name || "Unknown" %></span>
                    <div style="display: flex; gap: 4px; flex-wrap: wrap; margin-top: 2px;">
                      <span class="scope-tag"><%= consent.transaction_type&.humanize %></span>
                      <% if consent.amount.present? %>
                        <span class="scope-tag" style="font-weight: 700;"><%= consent.currency %> <%= number_with_delimiter(consent.amount.to_i) %></span>
                      <% end %>
                    </div>
                  </div>
                </div>
                <div class="activity-right" style="flex-direction: column; align-items: flex-end; gap: 4px;">
                  <%# Status badge %>
                  <% case consent.status
                     when "approved" %>
                    <span class="activity-badge activity-badge--approved">Approved</span>
                  <% when "denied" %>
                    <span class="activity-badge" style="background: #FEF2F2; color: #DC2626;">Denied</span>
                  <% when "expired" %>
                    <span class="activity-badge" style="background: #F1F5F9; color: #64748B;">Expired</span>
                  <% else %>
                    <span class="activity-badge" style="background: #FEF3C7; color: #92400E;">Pending</span>
                  <% end %>

                  <%# Biometric verification badges %>
                  <% if consent.biometric_verified_at.present? %>
                    <div style="display: flex; gap: 3px; align-items: center;">
                      <span style="font-size: 0.58rem; font-weight: 600; padding: 1px 5px; border-radius: 10px;
                                   background: #F0FDF4; color: #166534; border: 1px solid #BBF7D0; display: inline-flex; align-items: center; gap: 2px;">
                        <i class="ri-checkbox-circle-fill" style="font-size: 0.55rem;"></i>
                        Live <%= consent.liveness_confidence&.round(0) %>%
                      </span>
                      <% if face_data.present? %>
                        <% doc_label = case face_data["compared_against"]
                                       when "cin_front" then "CIN"
                                       when "passport" then "Passport"
                                       when "bonid_selfie" then "Selfie"
                                       else "ID"
                                       end %>
                        <span style="font-size: 0.58rem; font-weight: 600; padding: 1px 5px; border-radius: 10px;
                                     background: #F0FDF4; color: #166534; border: 1px solid #BBF7D0; display: inline-flex; align-items: center; gap: 2px;">
                          <i class="ri-user-follow-fill" style="font-size: 0.55rem;"></i>
                          vs <%= doc_label %> <%= face_data["similarity"]&.to_f&.round(0) %>%
                        </span>
                      <% end %>
                    </div>
                  <% end %>

                  <span class="activity-time"><%= time_ago_in_words(consent.created_at) %> ago</span>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <%# ── RIGHT 30%: Profile Sidebar ── %>
    <div class="dash-sidebar">

      <%# Partner Profile Card (compact) %>
      <div class="dash-card">
        <div class="dash-card-body" style="padding: 20px;">
          <div class="sidebar-profile">
            <div class="sidebar-avatar">
              <% if current_partner&.logo&.attached? %>
                <%= image_tag current_partner.logo.variant(resize_to_limit: [56, 56]),
                              class: "sidebar-avatar-img" %>
              <% else %>
                <div class="sidebar-avatar-fallback">
                  <i class="ri-building-2-line"></i>
                </div>
              <% end %>
            </div>
            <div class="sidebar-profile-info">
              <strong class="sidebar-org-name"><%= current_partner&.name || "Partner" %></strong>
              <span class="sidebar-sector">
                <%= PartnerSectorConstants.human_sector_label(current_partner&.department_sector || current_partner&.sector || "") %>
              </span>
            </div>
          </div>

          <div class="sidebar-details">
            <% if current_portal_user&.email.present? %>
              <div class="sidebar-detail">
                <i class="ri-mail-line"></i>
                <span><%= current_portal_user.email %></span>
              </div>
            <% end %>
            <% if current_partner&.phone_number.present? %>
              <div class="sidebar-detail">
                <i class="ri-phone-line"></i>
                <span><%= current_partner.phone_number %></span>
              </div>
            <% end %>
            <% if current_partner&.address.present? %>
              <div class="sidebar-detail">
                <i class="ri-map-pin-line"></i>
                <span><%= current_partner.address.formatted_address %></span>
              </div>
            <% end %>
            <div class="sidebar-detail">
              <i class="ri-calendar-line"></i>
              <span>Joined <%= current_portal_user&.created_at&.strftime("%b %Y") || "N/A" %></span>
            </div>
          </div>
        </div>
      </div>

      <%# API Usage Card %>
      <% if @api_stats[:total] > 0 %>
        <div class="dash-card">
          <div class="dash-card-header">
            <h6 class="dash-card-title">
              <i class="ri-code-s-slash-line me-2"></i>API Usage
            </h6>
          </div>
          <div class="dash-card-body">
            <div class="api-stats">
              <div class="api-stat">
                <span class="api-stat-value"><%= @api_stats[:total] %></span>
                <span class="api-stat-label">Total</span>
              </div>
              <div class="api-stat">
                <span class="api-stat-value api-stat-value--green"><%= @api_stats[:success] %></span>
                <span class="api-stat-label">Success</span>
              </div>
              <div class="api-stat">
                <span class="api-stat-value api-stat-value--red"><%= @api_stats[:failed] %></span>
                <span class="api-stat-label">Failed</span>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <%# Credits Widget %>
      <div class="dash-card">
        <div class="dash-card-header">
          <h6 class="dash-card-title">
            <i class="ri-wallet-3-line me-2"></i>Credits
          </h6>
        </div>
        <div class="dash-card-body">
          <div class="credits-display">
            <span class="credits-value">$<%= number_with_precision(@current_partner&.credit_balance, precision: 2) %></span>
            <span class="credits-label">available credits</span>
          </div>
          <%= link_to partner_portal_credits_path, class: "credits-topup" do %>
            <i class="ri-add-line me-1"></i>Top Up
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* ── Page Layout ── */
  .partner-dashboard { max-width: 100%; }

  /* ── Header ── */
  .dash-header {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 24px; flex-wrap: wrap; gap: 12px;
  }
  .dash-title {
    font-family: 'Inter', 'Montserrat', sans-serif;
    font-weight: 700; font-size: 1.35rem; color: #0F172A;
    margin: 0;
  }
  .dash-subtitle {
    font-size: 0.82rem; color: #64748B; margin: 4px 0 0;
  }
  .dash-cta {
    font-family: 'Inter', 'Montserrat', sans-serif;
    font-weight: 600; font-size: 0.85rem;
    background: #00209F; color: #FFF;
    padding: 10px 22px; border-radius: 10px;
    text-decoration: none;
    display: inline-flex; align-items: center;
    transition: background 0.2s;
  }
  .dash-cta:hover { background: #001A7A; color: #FFF; }
  .dash-cta--sm { font-size: 0.8rem; padding: 8px 16px; border-radius: 8px; }

  /* ── Metric Cards ── */
  .dash-metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }
  .metric-card {
    background: #FFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 16px;
    display: flex; align-items: center; gap: 14px;
  }
  .metric-card--blue { border-left: 3px solid #00209F; }
  .metric-card--green { border-left: 3px solid #059669; }
  .metric-card--teal { border-left: 3px solid #0891B2; }
  .metric-card--purple { border-left: 3px solid #7C3AED; }

  .metric-icon {
    width: 42px; height: 42px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.15rem; flex-shrink: 0;
  }
  .metric-icon--blue { background: rgba(0,32,159,0.08); color: #00209F; }
  .metric-icon--green { background: rgba(5,150,105,0.08); color: #059669; }
  .metric-icon--teal { background: rgba(8,145,178,0.08); color: #0891B2; }
  .metric-icon--purple { background: rgba(124,58,237,0.08); color: #7C3AED; }

  .metric-info { display: flex; flex-direction: column; }
  .metric-value {
    font-family: 'Inter', 'Montserrat', sans-serif;
    font-weight: 700; font-size: 1.4rem; color: #0F172A;
    line-height: 1.2;
  }
  .metric-label {
    font-size: 0.72rem; color: #94A3B8; font-weight: 500;
  }

  /* ── Two-Column Content ── */
  .dash-content {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 20px;
    align-items: start;
  }

  /* ── Generic Card ── */
  .dash-card {
    background: #FFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 16px;
  }
  .dash-card-header {
    padding: 14px 18px;
    border-bottom: 1px solid #F1F5F9;
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 10px;
  }
  .dash-card-title {
    font-family: 'Inter', 'Montserrat', sans-serif;
    font-size: 0.82rem; font-weight: 700; color: #0F172A;
    margin: 0;
    display: flex; align-items: center;
  }
  .dash-card-title i { color: #64748B; font-size: 0.95rem; }
  .dash-card-body { padding: 0; }
  .dash-view-all {
    font-size: 0.75rem; font-weight: 600; color: #00209F;
    text-decoration: none;
    display: inline-flex; align-items: center;
  }
  .dash-view-all:hover { text-decoration: underline; }

  /* ── Search ── */
  .activity-search {
    display: flex; align-items: center;
    background: #F8FAFC; border: 1px solid #E2E8F0;
    border-radius: 8px; padding: 0 10px;
  }
  .activity-search i { font-size: 0.85rem; color: #94A3B8; }
  .activity-search-input {
    border: none; background: transparent;
    font-size: 0.75rem; padding: 6px 8px;
    outline: none; color: #334155;
    width: 180px;
  }
  .activity-search-input::placeholder { color: #CBD5E1; }

  /* ── Activity Row ── */
  .activity-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 18px;
    border-bottom: 1px solid #F8FAFC;
    transition: background 0.15s;
  }
  .activity-row:last-child { border-bottom: none; }
  .activity-row:hover { background: #FAFBFD; }

  .activity-left {
    display: flex; align-items: center; gap: 12px;
    min-width: 0;
  }
  .activity-avatar {
    width: 36px; height: 36px;
    border-radius: 50%; flex-shrink: 0;
    overflow: hidden;
  }
  .activity-avatar-img {
    width: 36px; height: 36px;
    object-fit: cover; border-radius: 50%;
  }
  .activity-avatar-initials {
    width: 36px; height: 36px;
    border-radius: 50%;
    background: rgba(0,32,159,0.08); color: #00209F;
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
  }
  .activity-avatar-initials--teal {
    background: rgba(8,145,178,0.08); color: #0891B2;
  }

  .activity-info { min-width: 0; }
  .activity-name {
    font-size: 0.82rem; font-weight: 600; color: #1E293B;
    display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .activity-bonid {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem; font-weight: 500;
    background: #F1F5F9; color: #475569;
    padding: 1px 6px; border-radius: 4px;
  }

  .activity-right {
    display: flex; align-items: center; gap: 10px;
    flex-shrink: 0;
  }
  .activity-badge {
    font-size: 0.65rem; font-weight: 600;
    padding: 3px 8px; border-radius: 20px;
  }
  .activity-badge--qr { background: #ECFDF5; color: #059669; }
  .activity-badge--manual { background: #FEF3C7; color: #92400E; }
  .activity-badge--approved { background: #ECFDF5; color: #059669; }

  .activity-time {
    font-size: 0.7rem; color: #94A3B8; white-space: nowrap;
  }
  .activity-scopes { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 2px; }
  .scope-tag {
    font-size: 0.6rem; font-weight: 500;
    background: #F1F5F9; color: #475569;
    padding: 1px 6px; border-radius: 4px;
  }

  .activity-empty {
    text-align: center; padding: 40px 20px;
  }
  .activity-empty i { font-size: 2.5rem; color: #E2E8F0; display: block; margin-bottom: 12px; }
  .activity-empty p {
    font-size: 0.82rem; color: #94A3B8; margin: 0 0 16px;
  }

  /* ── Sidebar Profile ── */
  .sidebar-profile {
    display: flex; align-items: center; gap: 12px;
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid #F1F5F9;
  }
  .sidebar-avatar {
    width: 48px; height: 48px; flex-shrink: 0;
  }
  .sidebar-avatar-img {
    width: 48px; height: 48px;
    border-radius: 12px; object-fit: cover;
    border: 2px solid #00209F;
  }
  .sidebar-avatar-fallback {
    width: 48px; height: 48px;
    border-radius: 12px;
    background: #00209F; color: #FFF;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.2rem;
  }
  .sidebar-profile-info { min-width: 0; }
  .sidebar-org-name {
    font-family: 'Inter', 'Montserrat', sans-serif;
    font-size: 0.88rem; font-weight: 700; color: #0F172A;
    display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .sidebar-sector {
    font-size: 0.7rem; color: #64748B; font-weight: 500;
  }

  .sidebar-details { display: flex; flex-direction: column; gap: 10px; }
  .sidebar-detail {
    display: flex; align-items: flex-start; gap: 8px;
    font-size: 0.75rem; color: #475569;
  }
  .sidebar-detail i {
    font-size: 0.85rem; color: #00209F; flex-shrink: 0; margin-top: 1px;
  }

  /* ── API Stats ── */
  .api-stats {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 0; padding: 14px;
  }
  .api-stat { text-align: center; }
  .api-stat + .api-stat { border-left: 1px solid #F1F5F9; }
  .api-stat-value {
    font-family: 'Inter', sans-serif;
    font-weight: 700; font-size: 1.1rem; color: #0F172A;
    display: block;
  }
  .api-stat-value--green { color: #059669; }
  .api-stat-value--red { color: #DC2626; }
  .api-stat-label {
    font-size: 0.65rem; color: #94A3B8; font-weight: 500;
  }

  /* ── Credits ── */
  .credits-display {
    text-align: center; padding: 14px;
  }
  .credits-value {
    font-family: 'Inter', 'Montserrat', sans-serif;
    font-weight: 800; font-size: 1.6rem; color: #0F172A;
    display: block;
  }
  .credits-label {
    font-size: 0.7rem; color: #94A3B8; font-weight: 500;
