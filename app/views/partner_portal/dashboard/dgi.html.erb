<%# Partner Dashboard — DGI (Direction Generale des Impots) %>
<%# Agent-first: Scan center + alerts + metric cards + submissions %>

<%
  # ── Precompute stats ──
  pending_review  = VerificationRecord.where(status: "pending").where("data->>'filed_by' = ?", "citizen").count rescue 0
  pending_pay     = DgiPayment.where(status: %w[pending_cash pending]).where(payment_method: %w[cash_window bank_transfer]).count rescue 0
  today_scans     = @current_partner.qr_scan_logs.where("created_at >= ?", Time.current.beginning_of_day).count rescue 0
  total_citizens  = @current_partner.service_applications.select(:citizen_id).distinct.count rescue 0
  total_services  = @current_partner.partner_schemas.citizen_services.where(schema_status: "published").count rescue 0
  today_approved  = @current_partner.service_applications.where("submitted_at >= ?", Time.current.beginning_of_day).where.not(status: "draft").count rescue 0
  mismatch_today  = @current_partner.partner_audit_logs.where(event: "identity_mismatch").where("created_at >= ?", Time.current.beginning_of_day).count rescue 0
%>

<div class="bongouv-dashboard">

  <%# ================================================================ %>
  <%# 1. ALERTS — Actionable notifications at the top %>
  <%# ================================================================ %>
  <% if pending_review > 0 || pending_pay > 0 || mismatch_today > 0 %>
    <div class="dgi-alerts">
      <% if pending_review > 0 %>
        <div class="dgi-alert-item dgi-alert-item--review">
          <div class="dgi-alert-icon"><i class="ri-inbox-line"></i></div>
          <div class="dgi-alert-body">
            <strong><%= pending_review %> deklarasyon</strong> annatant revizyon
          </div>
          <%= link_to "Revize", partner_portal_dgi_review_index_path, class: "dgi-alert-action" %>
        </div>
      <% end %>

      <% if pending_pay > 0 %>
        <div class="dgi-alert-item dgi-alert-item--payment">
          <div class="dgi-alert-icon"><i class="ri-money-dollar-circle-line"></i></div>
          <div class="dgi-alert-body">
            <strong><%= pending_pay %> peman</strong> annatant konfimasyon
          </div>
          <%= link_to "Konfime", partner_portal_dgi_cash_payments_path, class: "dgi-alert-action" %>
        </div>
      <% end %>

      <% if mismatch_today > 0 %>
        <div class="dgi-alert-item dgi-alert-item--danger">
          <div class="dgi-alert-icon"><i class="ri-alarm-warning-line"></i></div>
          <div class="dgi-alert-body">
            <strong><%= mismatch_today %> idantite pa matche</strong> jodi a
          </div>
          <%= link_to "Wè", partner_portal_partner_audit_logs_path(event: "identity_mismatch"), class: "dgi-alert-action" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# ================================================================ %>
  <%# 2. SCAN CENTER — The primary action for every agent %>
  <%# ================================================================ %>
  <div class="dgi-scan-center">
    <div class="dgi-scan-card">
      <div class="dgi-scan-visual">
        <div class="dgi-scan-ring">
          <div class="dgi-scan-ring-inner">
            <i class="ri-qr-scan-2-line"></i>
          </div>
        </div>
        <h2 class="dgi-scan-title">Verifye Sitwayen</h2>
        <p class="dgi-scan-desc">Eskane kòd QR BonID oswa antre 6 dènye karaktè a</p>

        <%# ── Quick manual entry — redirects to scans page with auto-lookup ── %>
        <%= form_tag partner_portal_scans_path, method: :get, class: "dgi-scan-form", data: { turbo: false } do %>
          <div class="dgi-scan-input-wrap">
            <input type="text"
                   name="bonid"
                   class="dgi-scan-input"
                   placeholder="Ex: 697XDS"
                   maxlength="6"
                   pattern="[A-Za-z0-9]{6}"
                   autocomplete="off"
                   autofocus>
            <button type="submit" class="dgi-scan-submit">
              <i class="ri-search-line"></i>
            </button>
          </div>
        <% end %>

        <div class="dgi-scan-divider">
          <span>oswa</span>
        </div>

        <%= link_to partner_portal_scans_path, class: "dgi-scan-qr-btn", data: { turbo: false } do %>
          <i class="ri-camera-line me-2"></i>Ouvri Kamera QR
        <% end %>
      </div>
    </div>
  </div>

  <%# ================================================================ %>
  <%# 3. METRIC CARDS — Agent's daily progress %>
  <%# ================================================================ %>
  <div class="dgi-metrics">
    <div class="dgi-metric-card">
      <div class="dgi-metric-icon dgi-metric-icon--blue">
        <i class="ri-qr-scan-line"></i>
      </div>
      <div class="dgi-metric-data">
        <span class="dgi-metric-num"><%= today_scans %></span>
        <span class="dgi-metric-label">Eskanaj Jodi a</span>
      </div>
    </div>

    <div class="dgi-metric-card">
      <div class="dgi-metric-icon dgi-metric-icon--green">
        <i class="ri-user-follow-line"></i>
      </div>
      <div class="dgi-metric-data">
        <span class="dgi-metric-num"><%= total_citizens %></span>
        <span class="dgi-metric-label">Sitwayen Sèvi</span>
      </div>
    </div>

    <div class="dgi-metric-card">
      <div class="dgi-metric-icon dgi-metric-icon--amber">
        <i class="ri-file-check-line"></i>
      </div>
      <div class="dgi-metric-data">
        <span class="dgi-metric-num"><%= today_approved %></span>
        <span class="dgi-metric-label">Soumisyon Jodi a</span>
      </div>
    </div>

    <div class="dgi-metric-card">
      <div class="dgi-metric-icon dgi-metric-icon--purple">
        <i class="ri-service-line"></i>
      </div>
      <div class="dgi-metric-data">
        <span class="dgi-metric-num"><%= total_services %></span>
        <span class="dgi-metric-label">Sèvis Aktif</span>
      </div>
    </div>
  </div>

  <%# ================================================================ %>
  <%# 4. SUBMISSIONS — Service cards + table (when data exists) %>
  <%# ================================================================ %>
  <%= render "partner_portal/dashboard/submissions_section" %>

</div>

<style>
  /* ================================================================ */
  /* 1. ALERTS                                                        */
  /* ================================================================ */
  .dgi-alerts {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 20px;
  }
  .dgi-alert-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    border-radius: 10px;
    font-size: 0.82rem;
    font-weight: 500;
    color: #0F172A;
  }
  .dgi-alert-item--review {
    background: #FEF3C7;
    border-left: 4px solid #D97706;
  }
  .dgi-alert-item--review .dgi-alert-icon { color: #D97706; }
  .dgi-alert-item--payment {
    background: #DBEAFE;
    border-left: 4px solid #2563EB;
  }
  .dgi-alert-item--payment .dgi-alert-icon { color: #2563EB; }
  .dgi-alert-item--danger {
    background: #FEE2E2;
    border-left: 4px solid #DC2626;
  }
  .dgi-alert-item--danger .dgi-alert-icon { color: #DC2626; }

  .dgi-alert-icon {
    font-size: 1.1rem;
    flex-shrink: 0;
  }
  .dgi-alert-body {
    flex: 1;
    line-height: 1.3;
  }
  .dgi-alert-action {
    padding: 5px 14px;
    font-family: 'Inter', 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 0.72rem;
    color: #00209F;
    background: rgba(255,255,255,0.8);
    border-radius: 6px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s ease;
  }
  .dgi-alert-action:hover {
    background: #FFF;
    color: #00209F;
    text-decoration: none;
  }

  /* ================================================================ */
  /* 2. SCAN CENTER                                                   */
  /* ================================================================ */
  .dgi-scan-center {
    margin-bottom: 24px;
  }
  .dgi-scan-card {
    background: linear-gradient(135deg, #00209F 0%, #001A7A 50%, #0D1B4A 100%);
    border-radius: 20px;
    padding: 40px 32px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  /* Subtle grid pattern */
  .dgi-scan-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
  }

  .dgi-scan-visual {
    position: relative;
    z-index: 1;
    max-width: 400px;
    margin: 0 auto;
  }

  /* Animated ring */
  .dgi-scan-ring {
    width: 100px; height: 100px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.15);
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 20px;
    animation: dgi-ring-pulse 3s ease-in-out infinite;
  }
  .dgi-scan-ring-inner {
    width: 72px; height: 72px;
    border-radius: 50%;
    background: rgba(255,255,255,0.1);
    display: flex; align-items: center; justify-content: center;
    border: 2px solid rgba(255,255,255,0.2);
  }
  .dgi-scan-ring-inner i {
    font-size: 2rem;
    color: #FFF;
  }
  @keyframes dgi-ring-pulse {
    0%, 100% { border-color: rgba(255,255,255,0.15); transform: scale(1); }
    50% { border-color: rgba(255,255,255,0.3); transform: scale(1.05); }
  }

  .dgi-scan-title {
    font-family: 'Inter', 'Montserrat', sans-serif;
    font-weight: 800;
    font-size: 1.4rem;
    color: #FFFFFF !important;
    margin: 0 0 6px;
  }
  .dgi-scan-desc {
    font-size: 0.82rem;
    color: rgba(255,255,255,0.6);
    margin: 0 0 24px;
    line-height: 1.4;
  }

  /* Manual entry form */
  .dgi-scan-form {
    margin: 0 auto;
    max-width: 320px;
  }
  .dgi-scan-input-wrap {
    display: flex;
    background: rgba(255,255,255,0.12);
    border: 2px solid rgba(255,255,255,0.25);
    border-radius: 14px;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }
  .dgi-scan-input-wrap:focus-within {
    border-color: rgba(255,255,255,0.6);
    background: rgba(255,255,255,0.18);
  }
  .dgi-scan-input {
    flex: 1;
    padding: 14px 18px;
    background: transparent;
    border: none;
    color: #FFF;
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    text-align: center;
  }
  .dgi-scan-input::placeholder {
    color: rgba(255,255,255,0.35);
    letter-spacing: 2px;
    font-size: 0.9rem;
  }
  .dgi-scan-input:focus {
    outline: none;
  }
  .dgi-scan-submit {
    padding: 14px 18px;
    background: #FFF;
    border: none;
    color: #00209F;
    font-size: 1.1rem;
    cursor: pointer;
    transition: background 0.15s ease;
    display: flex;
    align-items: center;
  }
  .dgi-scan-submit:hover {
    background: #EFF6FF;
  }

  /* Divider */
  .dgi-scan-divider {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 20px 0;
  }
  .dgi-scan-divider::before,
  .dgi-scan-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(255,255,255,0.15);
  }
  .dgi-scan-divider span {
    font-size: 0.72rem;
    font-weight: 500;
    color: rgba(255,255,255,0.4);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* QR Camera button */
  .dgi-scan-qr-btn {
    display: inline-flex;
    align-items: center;
    padding: 12px 28px;
    background: transparent;
    color: #FFF;
    font-family: 'Inter', 'Montserrat', sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
    border: 2px solid rgba(255,255,255,0.3);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .dgi-scan-qr-btn:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.5);
    color: #FFF;
    text-decoration: none;
  }

  /* ================================================================ */
  /* 3. METRIC CARDS                                                  */
  /* ================================================================ */
  .dgi-metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-bottom: 24px;
  }
  .dgi-metric-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 16px;
    background: #FFF;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .dgi-metric-card:hover {
    border-color: #CBD5E1;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }
  .dgi-metric-icon {
    width: 44px; height: 44px;
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .dgi-metric-icon i { font-size: 1.2rem; }
  .dgi-metric-icon--blue { background: #EFF6FF; color: #2563EB; }
  .dgi-metric-icon--blue i { color: #2563EB; }
  .dgi-metric-icon--green { background: #ECFDF5; color: #059669; }
  .dgi-metric-icon--green i { color: #059669; }
  .dgi-metric-icon--amber { background: #FFFBEB; color: #D97706; }
  .dgi-metric-icon--amber i { color: #D97706; }
  .dgi-metric-icon--purple { background: #F5F3FF; color: #7C3AED; }
  .dgi-metric-icon--purple i { color: #7C3AED; }

  .dgi-metric-data { min-width: 0; }
  .dgi-metric-num {
    display: block;
    font-family: 'Inter', 'Montserrat', sans-serif;
    font-weight: 800;
    font-size: 1.35rem;
    color: #0F172A;
    line-height: 1.2;
  }
  .dgi-metric-label {
    display: block;
    font-size: 0.68rem;
    font-weight: 500;
    color: #94A3B8;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-top: 1px;
  }

  /* ================================================================ */
  /* MOBILE                                                           */
  /* ================================================================ */
  @media (max-width: 768px) {
    .dgi-scan-card { padding: 28px 20px; }
    .dgi-scan-ring { width: 80px; height: 80px; }
    .dgi-scan-ring-inner { width: 56px; height: 56px; }
    .dgi-scan-ring-inner i { font-size: 1.5rem; }
    .dgi-scan-title { font-size: 1.15rem; }
    .dgi-metrics {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    .dgi-metric-card { padding: 14px 12px; gap: 10px; }
    .dgi-metric-icon { width: 38px; height: 38px; }
    .dgi-metric-num { font-size: 1.1rem; }
  }

  @media (max-width: 480px) {
    .dgi-alerts { gap: 6px; }
    .dgi-alert-item { padding: 8px 12px; font-size: 0.75rem; }
    .dgi-scan-input { font-size: 0.95rem; padding: 12px 14px; }
  }
</style>
