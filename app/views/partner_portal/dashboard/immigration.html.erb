<%# Partner Dashboard — DIE (Direction de l'Immigration et de l'Émigration) %>
<div class="bongouv-dashboard">

  <%# DIE Suspension Alert %>
  <div class="dgi-alerts">
    <div class="dgi-alert-item dgi-alert-item--danger">
      <div class="dgi-alert-icon"><i class="ri-error-warning-line"></i></div>
      <div class="dgi-alert-body">
        <strong>Operasyon DIE Sispann</strong> — Pwodiksyon paspò ak sèvis imigrasyon sispann pou kounye a.
        Verifikasyon BonID ak CIN toujou disponib.
      </div>
    </div>
  </div>

  <%= render "partner_portal/dashboard/scan_center" %>
  <%= render "partner_portal/dashboard/submissions_section" %>
</div>
<%= render "partner_portal/dashboard/scan_center_styles" %>
