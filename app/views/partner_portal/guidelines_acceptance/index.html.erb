<%# ═══════════════════════════════════════════════════════════
    JAVASCRIPT
═══════════════════════════════════════════════════════════ %>
<script>
  document.addEventListener("DOMContentLoaded", function() {
    const checkbox = document.getElementById("guidelinesConfirm");
    const btn = document.getElementById("acceptBtn");
    const footer = document.getElementById("glFooter");
    const form = document.getElementById("glAcceptForm");
    const expandAllBtn = document.getElementById("glExpandAll");
    const cards = document.querySelectorAll(".gl-card");
    const collapses = document.querySelectorAll(".gl-cards-grid .collapse");

    // ─── Track which sections have been opened ───
    const readSections = new Set();

    collapses.forEach(function(el) {
      el.addEventListener("shown.bs.collapse", function() {
        const card = this.closest(".gl-card");
        const key = card.dataset.guideline;
        readSections.add(key);

        // Show "Li" (Read) indicator
        const indicator = document.getElementById("gl-read-" + key);
        if (indicator) indicator.classList.remove("d-none");

        // Add read state to card
        card.classList.add("gl-card--read");
      });
    });

    // ─── Expand All ───
    if (expandAllBtn) {
      expandAllBtn.addEventListener("click", function() {
        const allOpen = readSections.size === cards.length;
        collapses.forEach(function(c) {
          const bsCollapse = bootstrap.Collapse.getOrCreateInstance(c, { toggle: false });
          if (allOpen) {
            bsCollapse.hide();
          } else {
            bsCollapse.show();
          }
        });
        this.innerHTML = allOpen
          ? '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><polyline points="17 11 12 6 7 11"></polyline><polyline points="17 18 12 13 7 18"></polyline></svg> Louvri tout seksyon'
          : '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><polyline points="7 13 12 18 17 13"></polyline><polyline points="7 6 12 11 17 6"></polyline></svg> Fèmen tout seksyon';
      });
    }

    // ─── Sticky Footer: show after user scrolls past 200px ───
    function checkScroll() {
      if (window.scrollY > 200) {
        footer.classList.add("gl-footer--visible");
      } else {
        footer.classList.remove("gl-footer--visible");
      }
    }
    window.addEventListener("scroll", checkScroll, { passive: true });
    // Show immediately if page is already scrolled (e.g. back button)
    checkScroll();

    // ─── Checkbox → Enable Button ───
    if (checkbox && btn) {
      checkbox.addEventListener("change", function() {
        btn.disabled = !this.checked;
      });
    }

    // ─── Success Animation on Submit ───
    if (form) {
      form.addEventListener("submit", function(e) {
        if (!checkbox.checked) {
          e.preventDefault();
          return;
        }

        // Show success overlay briefly before actual submit
        e.preventDefault();
        const overlay = document.createElement("div");
        overlay.className = "gl-success-overlay gl-show";
        overlay.innerHTML = [
          '<div class="gl-success-icon"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></div>',
          '<div class="gl-success-text">Direktiv yo aksepte!</div>',
          '<div class="gl-success-sub">N ap redirije ou nan Portal la...</div>'
        ].join("");
        document.body.appendChild(overlay);

        // Submit after animation
        setTimeout(function() {
          form.removeEventListener("submit", arguments.callee);
          form.submit();
        }, 1200);
      });
    }
  });
</script>

