<%# app/views/partner_portal/partner_admin/profiles/edit.html.erb %>

<div class="bongouv-dashboard">
  <div class="container-fluid py-4">
    <div class="row">
      <div class="col-12">

        <%# Header %>
        <div class="bongouv-section-header mb-4">
          <div>
            <h2 class="bongouv-section-title"><i class="ri-user-settings-line me-2" aria-hidden="true"></i>Modifye Pwofil</h2>
            <p style="font-size: 0.75rem; color: #4b5563; margin: 4px 0 0;">Mete ajou enfòmasyon òganizasyon ou</p>
          </div>
          <%= link_to partner_portal_dashboard_path, class: "bongouv-btn bongouv-btn--primary" do %>
            <i class="ri-arrow-left-line me-1"></i> Dashboard
          <% end %>
        </div>

        <%# Profile Form %>
        <%= simple_form_for @partner,
              url: partner_portal_partner_admin_profile_path,
              method: :patch,
              html: {
                multipart: true,
                class: "profile-edit-form"
              } do |f| %>

          <%# Section 1: Organization Info %>
          <div class="bongouv-form-card">
            <div class="bongouv-form-card__header">
              <i class="ri-building-line me-2"></i> Enfòmasyon Òganizasyon
            </div>
            <div class="bongouv-form-card__body">
              <div class="row">
                <%# Logo Upload %>
                <div class="col-md-4 mb-4">
                  <label class="bongouv-label">Logo</label>
                  <div class="bongouv-logo-upload">
                    <% if @partner.logo.attached? %>
                      <%= image_tag @partner.logo.variant(resize_to_limit: [120, 120]),
                                    class: "rounded-circle mb-3 shadow-sm",
                                    style: "width: 100px; height: 100px; object-fit: cover;" %>
                    <% else %>
                      <div class="bongouv-logo-placeholder">
                        <i class="ri-image-add-line ri-2x"></i>
                      </div>
                    <% end %>
                    <%= f.file_field :logo,
                        accept: "image/png,image/jpeg,image/jpg,image/webp",
                        class: "form-control form-control-sm" %>
                    <small class="text-muted d-block mt-2">PNG, JPG (max 2MB)</small>
                  </div>
                </div>

                <%# Name & Contact %>
                <div class="col-md-8">
                  <div class="row">
                    <div class="col-12 mb-3">
                      <%= f.input :name,
                          label: "Non Òganizasyon",
                          required: true,
                          input_html: { class: "form-control rounded-3" } %>
                    </div>
                    <div class="col-md-6 mb-3">
                      <%= f.input :contact_person,
                          label: "Kontak Prensipal",
                          required: true,
                          input_html: { class: "form-control rounded-3" } %>
                    </div>
                    <div class="col-md-6 mb-3">
                      <%= f.input :phone_number,
                          label: "Nimewo Telefòn",
                          required: true,
                          input_html: { placeholder: "+509 1234 5678", class: "form-control rounded-3" } %>
                    </div>
                  </div>
                  <div class="row">
                    <div class="col-md-6 mb-3">
                      <%= f.input :email,
                          label: "Imèl",
                          input_html: { class: "form-control rounded-3" } %>
                    </div>
                    <div class="col-md-6 mb-3">
                      <%= f.input :website,
                          label: "Sit Wèb",
                          required: false,
                          input_html: { placeholder: "https://...", class: "form-control rounded-3" } %>
                    </div>
                  </div>
                </div>
              </div>

              <%# Description %>
              <div class="mb-0">
                <%= f.label :description, "Deskripsyon", class: "bongouv-label" %>
                <span class="text-danger">*</span>
                <%= f.text_area :description,
                    rows: 4,
                    required: true,
                    class: "form-control rounded-3",
                    placeholder: "Dekri misyon òganizasyon ou..." %>
                <small class="form-text text-muted">
                  Deskripsyon sa a ede sitwayen konprann ki moun ou ye lè yo wè demann verifikasyon.
                </small>
              </div>
            </div>
          </div>

          <%# Address fields %>
          <div class="bongouv-form-card">
            <div class="bongouv-form-card__header">
              <i class="ri-map-pin-2-line me-2"></i> Adrès
            </div>
            <div class="bongouv-form-card__body bongouv-hide-address-header">
              <%= render "partner_portal/shared/components/address_info", f: f %>
            </div>
          </div>

          <%# Section 2: Unit Info (Law Enforcement only) %>
          <% if @partner.sector == "law_enforcement" %>
            <div class="bongouv-form-card">
              <div class="bongouv-form-card__header">
                <i class="ri-shield-user-line me-2"></i> Inite
              </div>
              <div class="bongouv-form-card__body">
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <%= f.input :unit_type,
                        label: "Tip Inite",
                        as: :select,
                        collection: [
                          ["UDMO - Patrouille Urbaine", "UDMO"],
                          ["POLIFRONT - Securite Frontaliere", "POLIFRONT"],
                          ["DCPJ - Police Judiciaire", "DCPJ"],
                          ["USGPN - Garde Presidentielle", "USGPN"],
                          ["BRI - Brigade d'Intervention", "BRI"],
                          ["CIMO - Intervention Mobile", "CIMO"],
                          ["Other", "other"]
                        ],
                        prompt: "Chwazi tip inite",
                        input_html: { class: "form-select rounded-3" } %>
                  </div>
                  <div class="col-md-6 mb-3">
                    <%= f.input :unit_name,
                        label: "Non Inite",
                        required: false,
                        input_html: { placeholder: "ex: UDMO Delmas 33", class: "form-control rounded-3" } %>
                  </div>
                </div>
                <%= f.input :department_sector,
                    label: "Depatman/Sektè",
                    as: :select,
                    collection: [
                      ["PNH - Police Nationale d'Haiti", "pnh"],
                      ["DCPJ - Direction Centrale de la Police Judiciaire", "dcpj"],
                      ["FAd'H - Forces Armees d'Haiti", "fadh"],
                      ["Other", "other"]
                    ],
                    prompt: "Chwazi depatman",
                    input_html: { class: "form-select rounded-3" },
                    wrapper_html: { class: "mb-3" } %>
              </div>
            </div>
          <% end %>

          <%# Submit %>
          <div class="d-flex justify-content-between align-items-center mt-4">
            <%= link_to partner_portal_dashboard_path, class: "bongouv-btn bongouv-btn--primary" do %>
              Anile
            <% end %>
            <%= f.button :submit, class: "bongouv-btn bongouv-btn--primary" do %>
              <i class="ri-save-line me-2"></i> Anrejistre
            <% end %>
          </div>
        <% end %>

      </div>
    </div>
  </div>
</div>

