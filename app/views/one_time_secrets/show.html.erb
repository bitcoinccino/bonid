<div style="max-width: 560px; margin: 60px auto; padding: 0 20px; font-family: 'Inter', -apple-system, sans-serif;">

  <div style="text-align: center; margin-bottom: 30px;">
    <div style="display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; background: #00209F; border-radius: 12px; margin-bottom: 12px;">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
    </div>
    <h2 style="color: #1a1a2e; font-size: 22px; font-weight: 600; margin: 0;">One-Time Secret</h2>
    <p style="color: #6b7280; font-size: 14px; margin-top: 6px;">This page can only be viewed once.</p>
  </div>

  <% if @error %>
    <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 20px; text-align: center;">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" style="margin-bottom: 8px;">
        <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
      </svg>
      <p style="color: #dc2626; font-weight: 500; margin: 0;"><%= @error %></p>
    </div>

  <% else %>
    <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 16px; margin-bottom: 20px; text-align: center;">
      <p style="color: #166534; font-weight: 500; margin: 0; font-size: 14px;">
        Credentials for <strong><%= @partner.name %></strong> — save them now.
      </p>
    </div>

    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px;">
      <% @payload.each do |key, value| %>
        <div style="margin-bottom: 16px;">
          <label style="display: block; font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">
            <%= key.to_s.titleize %>
          </label>
          <div style="display: flex; align-items: center; gap: 8px;">
            <code id="secret-<%= key %>" style="flex: 1; display: block; background: #ffffff; border: 1px solid #d1d5db; border-radius: 6px; padding: 10px 12px; font-family: 'SF Mono', 'Fira Code', monospace; font-size: 13px; word-break: break-all; color: #1a1a2e;">
              <%= value %>
            </code>
            <button onclick="copySecret('<%= key %>')" style="flex-shrink: 0; background: #00209F; color: white; border: none; border-radius: 6px; padding: 10px 14px; cursor: pointer; font-size: 12px; font-weight: 500;">
              Copy
            </button>
          </div>
        </div>
      <% end %>
    </div>

    <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; padding: 14px; margin-top: 16px;">
      <p style="color: #92400e; font-size: 13px; margin: 0; line-height: 1.5;">
        <strong>This page will not be available again.</strong>
        Copy these credentials now and store them securely. If you lose them, you will need to regenerate new credentials from your partner portal.
      </p>
    </div>
  <% end %>

  <div style="text-align: center; margin-top: 30px;">
    <p style="color: #9ca3af; font-size: 12px;">Powered by <strong>BonID</strong></p>
  </div>
</div>

<script>
function copySecret(key) {
  const el = document.getElementById('secret-' + key);
  navigator.clipboard.writeText(el.textContent.trim());
  event.target.textContent = 'Copied!';
  setTimeout(() => { event.target.textContent = 'Copy'; }, 2000);
}
</script>
