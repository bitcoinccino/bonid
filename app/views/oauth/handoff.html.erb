<%# Shown when the citizen already approved this partner: brief confirmation, then auto-continue. %>
<% content_for :title, "Returning to #{@partner.name} – BonID" %>
<% content_for :head do %>
  <meta http-equiv="refresh" content="<%= @handoff_delay %>;url=<%= @redirect_url %>">
<% end %>

<section class="container py-5 text-center" role="main" aria-live="polite">
  <div class="card rounded-4 mx-auto bg-white" style="max-width:480px;border:1px solid #e5e7eb;">
    <div class="card-body p-4 p-md-5">
      <% if @partner.logo.attached? %>
        <%= image_tag @partner.logo.variant(resize_to_limit: [96, 96]),
              alt: "#{@partner.name} logo",
              class: "d-block mx-auto mb-3 rounded-3",
              style: "width:48px;height:48px;object-fit:contain;" %>
      <% else %>
        <div class="mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center"
             style="width:48px;height:48px;background:#f0f4ff;">
          <i class="ri-shield-check-line fs-4" style="color:var(--haitian-blue);"></i>
        </div>
      <% end %>

      <h1 class="h5 fw-bold mb-1">Returning to <%= @partner.name %></h1>
      <p class="text-muted small mb-4">You already approved access.</p>

      <div class="spinner-border" role="status" style="color:var(--haitian-blue);">
        <span class="visually-hidden">Returning…</span>
      </div>

      <%# Fallback only: fades in after 5s in case the auto-redirect is blocked. %>
      <p class="handoff-fallback small mt-4 mb-0">
        <%= link_to "Not redirected? Continue", @redirect_url,
              class: "text-muted", data: { turbo: false }, rel: "noreferrer" %>
      </p>
      <style>
        .handoff-fallback { opacity: 0; animation: handoff-fallback-in .3s ease 5s forwards; }
        @keyframes handoff-fallback-in { to { opacity: 1; } }
      </style>
    </div>
  </div>
</section>
