<%# Shown when the citizen already approved this partner: brief confirmation, then auto-continue. %>
<% content_for :title, "Redirecting to #{@partner.name} – BonID" %>
<% content_for :head do %>
  <meta http-equiv="refresh" content="<%= @handoff_delay %>;url=<%= @redirect_url %>">
<% end %>

<section class="container py-5 text-center" role="main" aria-live="polite">
  <div class="card rounded-4 mx-auto bg-white" style="max-width:480px;border:1px solid #e5e7eb;">
    <div class="card-body p-4 p-md-5">
      <% if @partner.logo.attached? %>
        <%= image_tag @partner.logo.variant(resize_to_limit: [96, 96]),
              alt: "#{@partner.name} logo",
              class: "mb-3 rounded-3",
              style: "width:72px;height:72px;object-fit:contain;" %>
      <% else %>
        <div class="mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center"
             style="width:72px;height:72px;background:#f0f4ff;">
          <i class="ri-shield-check-line fs-2" style="color:var(--haitian-blue);"></i>
        </div>
      <% end %>

      <h1 class="h4 fw-bold mb-2">Redirecting you to <%= @partner.name %></h1>
      <p class="text-muted mb-4">
        You've already approved <strong><%= @partner.name %></strong>, so there's nothing else to confirm.
      </p>

      <div class="spinner-border mb-4" role="status" style="color:var(--haitian-blue);">
        <span class="visually-hidden">Redirecting…</span>
      </div>

      <div>
        <%= link_to "Continue to #{@partner.name}", @redirect_url,
              class: "btn btn-primary btn-lg w-100",
              style: "min-height:48px;",
              data: { turbo: false },
              rel: "noreferrer" %>
      </div>
      <p class="small text-muted mt-3 mb-0">
        Changed your mind? You can revoke <%= @partner.name %>'s access anytime from your BonID dashboard.
      </p>
    </div>
  </div>
</section>
