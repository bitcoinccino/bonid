<!-- app/views/oauth/_scope_item.html.erb -->
<% definition = scope_definition(scope) %>

<% unless definition[:hidden] %>
  <div class="card border-<%= scope_color(scope) %>-subtle mb-2 bg-<%= scope_color(scope) %>-subtle bg-opacity-10">
    <div class="card-body p-3">
      <div class="d-flex align-items-start">
        <!-- Icon -->
        <div class="me-3 mt-1">
          <div class="rounded-circle bg-<%= scope_color(scope) %> bg-opacity-10 d-flex align-items-center justify-content-center"
               style="width:40px;height:40px;">
            <i class="ri-<%= scope_icon(scope) %> text-<%= scope_color(scope) %> fs-5"></i>
          </div>
        </div>

        <!-- Content -->
        <div class="flex-grow-1">
          <div class="d-flex align-items-center justify-content-between mb-1">
            <h6 class="mb-0 fw-semibold text-dark">
              <%= scope_label(scope) %>
            </h6>
            <i class="ri-check-line text-<%= scope_color(scope) %>"></i>
          </div>

          <p class="text-muted small mb-0">
            <%= scope_description(scope) %>
          </p>
        </div>
      </div>
    </div>
  </div>
<% end %>
