<h2 style="margin:0 0 10px;
           font-family:'Orbitron','Montserrat',Arial,sans-serif;
           color:#00209F; font-size:20px; letter-spacing:0.08em; text-transform:uppercase;">
  Welcome to Haiti 🇭🇹
</h2>

<p style="margin:0 0 14px;
          font-family:'Inter',Arial,sans-serif;
          color:#1b2559; font-size:14px; line-height:1.65;">
  Dear <strong><%= @visitor.first_name %></strong>,
</p>

<p style="margin:0 0 14px;
          font-family:'Inter',Arial,sans-serif;
          color:#1b2559; font-size:14px; line-height:1.65;">
  Your <strong>BonTouris ID</strong> has been issued and verified by <strong>Verifyem</strong>.
  This certificate is a private digital verification document intended for use
  <strong>while you are inside Haiti</strong>.
</p>

<div style="margin:18px 0 14px;
            padding:14px 14px;
            border-radius:12px;
            background:#f1f4ff;
            border:1px solid rgba(0,32,159,0.18);">
  <table style="width:100%; border-collapse:collapse;">
    <tr>
      <td style="padding:8px 0; width:170px; font-family:'Montserrat','Inter',Arial,sans-serif; font-size:12px; letter-spacing:0.12em; text-transform:uppercase; color:#00209F;">
        BonTouris ID
      </td>
      <td style="padding:8px 0; font-family:'Inter',Arial,sans-serif; font-size:14px; color:#1b2559; font-weight:700;">
        <%= @visitor.bonid %>
      </td>
    </tr>

    <tr>
      <td style="padding:8px 0; font-family:'Montserrat','Inter',Arial,sans-serif; font-size:12px; letter-spacing:0.12em; text-transform:uppercase; color:#00209F;">
        Valid Until
      </td>
      <td style="padding:8px 0; font-family:'Inter',Arial,sans-serif; font-size:14px; color:#1b2559;">
        <%= @visitor.expires_at&.strftime("%B %d, %Y") || "Valid during approved stay" %>
      </td>
    </tr>

    <tr>
      <td style="padding:8px 0; font-family:'Montserrat','Inter',Arial,sans-serif; font-size:12px; letter-spacing:0.12em; text-transform:uppercase; color:#00209F;">
        Purpose
      </td>
      <td style="padding:8px 0; font-family:'Inter',Arial,sans-serif; font-size:14px; color:#1b2559;">
        <%= @visitor.purpose_of_visit %>
      </td>
    </tr>

    <tr>
      <td style="padding:8px 0; font-family:'Montserrat','Inter',Arial,sans-serif; font-size:12px; letter-spacing:0.12em; text-transform:uppercase; color:#00209F;">
        Port of Entry
      </td>
      <td style="padding:8px 0; font-family:'Inter',Arial,sans-serif; font-size:14px; color:#1b2559;">
        <%= @visitor.port_of_entry %>
      </td>
    </tr>
  </table>
</div>

<% if attachments["visitor_qr.png"] %>
  <div style="text-align:center; margin:18px 0 14px;">
    <img
      src="cid:visitor_qr.png"
      alt="BonTouris ID QR Code"
      style="width:180px; height:180px; border-radius:12px; border:1px solid rgba(0,0,0,0.08); background:#fff;"
    />
    <p style="margin:10px auto 0; max-width:420px;
              font-family:'Montserrat','Inter',Arial,sans-serif;
              font-size:12.5px; line-height:1.6;
              color:rgba(27,37,89,0.85);">
      This QR code can be scanned by participating hotels, authorities, and verified service providers in Haiti
      to confirm your BonTouris ID.
    </p>
  </div>
<% end %>

<p style="margin:0 0 10px;
          font-family:'Montserrat','Inter',Arial,sans-serif;
          color:rgba(27,37,89,0.85); font-size:12.5px; line-height:1.6;">
  This document is <strong>not a government-issued ID</strong> and does not replace your passport.
  It is a private digital verification for visitors provided by Verifyem.
</p>

<p style="margin:14px 0 0;
          font-family:'Montserrat','Inter',Arial,sans-serif;
          color:rgba(27,37,89,0.85); font-size:12.5px; line-height:1.6;">
  Happy Safe Traveling — welcome to Haiti 🇭🇹
</p>
