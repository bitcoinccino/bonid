<table role="presentation" width="100%" cellpadding="0" cellspacing="0"
       style="background:#ffffff; border-radius:18px; overflow:hidden;
              box-shadow:0 18px 55px rgba(0,0,0,0.55);">

  <!-- TOP BRAND BAR -->
  <tr>
    <td style="padding:18px 22px; background:#00209F; text-align:center;">
      <div style="font-family:'Orbitron','Montserrat',Arial,sans-serif;
                  letter-spacing:2px; font-weight:800; color:#ffffff; font-size:14px;">
        BONTOURIS ID · VERIFYEM
      </div>
      <div style="margin-top:8px; font-family:'Inter',Arial,sans-serif;
                  color:rgba(255,255,255,0.92); font-size:13px;">
        Welcome to Haiti 🇭🇹
      </div>
    </td>
  </tr>

  <!-- BODY CARD -->
  <tr>
    <td style="padding:18px 22px 22px; background:#ffffff;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
             style="background:#f7f9ff; border:1px solid rgba(0,32,159,0.14);
                    border-radius:14px;">
        <tr>
          <td style="padding:20px;">
            <%= yield %>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- SIGN-OFF -->
  <tr>
    <td style="padding:0 22px 22px; text-align:center; background:#ffffff;">
      <div style="font-family:'Inter',Arial,sans-serif; font-size:13px; color:#1b2559;">
        Happy Safe Traveling ✨
      </div>
    </td>
  </tr>
</table>
