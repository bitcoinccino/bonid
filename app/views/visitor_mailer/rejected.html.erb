<h2 style="margin:0 0 10px;
           font-family:'Orbitron','Montserrat',Arial,sans-serif;
           color:#00209F; font-size:20px; letter-spacing:0.08em; text-transform:uppercase;">
  BonTouris ID — Action Required
</h2>

<p style="margin:0 0 14px;
          font-family:'Inter',Arial,sans-serif;
          color:#1b2559; font-size:14px; line-height:1.65;">
  Hello <strong><%= @visitor.first_name %></strong>,
</p>

<p style="margin:0 0 14px;
          font-family:'Inter',Arial,sans-serif;
          color:#1b2559; font-size:14px; line-height:1.65;">
  We couldn’t approve your BonTouris ID application at this time.
</p>

<div style="margin:18px 0 14px;
            padding:14px 14px;
            border-radius:12px;
            background:#fff5f5;
            border:1px solid rgba(229,62,62,0.25);">
  <div style="font-family:'Montserrat','Inter',Arial,sans-serif;
              font-size:11px; letter-spacing:0.14em; text-transform:uppercase; color:#c53030;">
    Reason
  </div>
  <div style="margin-top:6px;
              font-family:'Inter',Arial,sans-serif;
              font-size:14px; color:#1b2559; line-height:1.6;">
    <strong><%= @reason_label %></strong>
  </div>

  <% if @notes.present? %>
    <div style="margin-top:10px;
                font-family:'Inter',Arial,sans-serif;
                font-size:13px; color:rgba(27,37,89,0.9); line-height:1.6;">
      <strong>Details:</strong><br>
      <%= simple_format(@notes) %>
    </div>
  <% end %>
</div>

<p style="margin:0 0 6px;
          font-family:'Inter',Arial,sans-serif;
          color:#1b2559; font-size:14px; line-height:1.65;">
  You may correct the issue and resubmit your application if eligible.
</p>

<p style="margin:14px 0 0;
          font-family:'Montserrat','Inter',Arial,sans-serif;
          color:rgba(27,37,89,0.85); font-size:12.5px; line-height:1.6;">
  Happy Safe Traveling — welcome to Haiti 🇭🇹
</p>
