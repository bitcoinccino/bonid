<h2 style="margin:0 0 10px;
           font-family:'Orbitron','Montserrat',Arial,sans-serif;
           color:#00209F; font-size:20px; letter-spacing:0.08em; text-transform:uppercase;">
  Documents received
</h2>

<p style="margin:0 0 14px;font-family:'Inter',Arial,sans-serif;color:#1b2559;font-size:14px;line-height:1.65;">
  Hello <strong><%= @visitor.first_name %></strong>,
</p>

<p style="margin:0 0 14px;font-family:'Inter',Arial,sans-serif;color:#1b2559;font-size:14px;line-height:1.65;">
  We received your documents successfully. Your BonTouris ID is now under review.
</p>

<div style="margin:18px 0 0;padding:14px;border-radius:12px;background:#f1f4ff;border:1px solid rgba(0,32,159,0.18);">
  <div style="font-family:'Montserrat','Inter',Arial,sans-serif;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:#00209F;">
    Reference ID
  </div>
  <div style="margin-top:6px;font-family:'Inter',Arial,sans-serif;font-size:14px;color:#1b2559;font-weight:800;">
    <%= @visitor.bonid.presence || "T-#{@visitor.id}" %>
  </div>
</div>

<p style="margin:14px 0 0;font-family:'Montserrat','Inter',Arial,sans-serif;color:rgba(27,37,89,0.85);font-size:12.5px;line-height:1.6;">
  You will receive another email once your BonTouris ID is approved.
</p>
