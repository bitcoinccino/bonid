<%# Waitlist confirmation, in the language the person signed up in
    (mailers.waitlist_confirmation.*). One goal, like the confirmation
    page: share the link. %>
<% c = ->(key, **opts) { t("mailers.waitlist_confirmation.#{key}", **opts) } %>

<h2 style="color: #00209F; font-family: 'Montserrat', Arial, sans-serif; margin: 0 0 16px;">
  <%= c.(:heading) %>
</h2>

<% if @signup.first_name.present? %>
  <p style="margin: 0 0 12px;"><%= c.(:greeting, name: @signup.first_name) %></p>
<% end %>

<p style="margin: 0 0 16px;">
  <%= @commune_name ? c.(:intro_commune, commune: @commune_name) : c.(:intro) %>
</p>

<% if @commune_name && @commune_count.to_i >= Commune::SOCIAL_PROOF_THRESHOLD %>
  <div style="background: #ECFDF5; border: 1px solid #A7F3D0; border-radius: 8px; padding: 12px 16px; margin: 20px 0; text-align: center; color: #065F46; font-weight: 600;">
    <%= c.(:count, count: number_with_delimiter(@commune_count), commune: @commune_name) %>
  </div>
<% end %>

<p style="margin: 0 0 20px; color: #374151;"><%= c.(:mission) %></p>

<div style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 12px; padding: 20px; margin: 24px 0; text-align: center;">
  <p style="font-weight: 600; color: #111827; margin: 0 0 14px;"><%= c.(:share_title) %></p>

  <a href="https://wa.me/?text=<%= ERB::Util.url_encode(c.(:share_text, url: @share_url)) %>"
     style="display: inline-block; background: #25D366; color: #fff !important; padding: 12px 28px; border-radius: 8px; text-decoration: none; font-weight: 700; font-family: 'Montserrat', Arial, sans-serif;">
    <%= c.(:whatsapp) %>
  </a>

  <p style="margin: 14px 0 0;">
    <a href="<%= @share_url %>" style="font-size: 13px; color: #00209F; word-break: break-all;"><%= @share_url %></a>
  </p>
</div>

<p style="margin: 20px 0 0; color: #475467;"><%= c.(:signoff) %></p>
