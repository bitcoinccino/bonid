<div class="modal fade" id="rejectVisitorModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 shadow">

      <!-- HEADER -->
      <div class="modal-header">
        <h5 class="modal-title text-danger">
          <i class="ri-close-circle-line me-1"></i>
          Reject Visitor Application
        </h5>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="Close"></button>
      </div>

      <!-- FORM -->
      <%= form_with model: visitor_submission,
            url: reject_admin_visitor_submission_path(visitor_submission),
            method: :post,
            data: { turbo: true } do |f| %>

        <div class="modal-body">

          <!-- REJECTION REASON -->
          <div class="mb-3">
            <%= f.label :rejection_reason,
                  "Rejection reason",
                  class: "form-label fw-semibold" %>

            <%= f.select :rejection_reason,
                  VisitorSubmission.rejection_reasons_options,
                  { prompt: "Select a reason" },
                  class: "form-select",
                  required: true %>
          </div>

          <!-- OPTIONAL NOTES -->
          <div class="mb-3">
            <%= f.label :rejection_notes,
                  "Additional notes (optional)",
                  class: "form-label fw-semibold" %>

            <%= f.text_area :rejection_notes,
                  class: "form-control",
                  rows: 3,
                  placeholder: "Optional clarification for the applicant" %>
          </div>

          <!-- WARNING -->
          <div class="alert alert-warning small mb-0">
            <i class="ri-alert-line me-1"></i>
            This action is permanent. The visitor will be notified by email.
          </div>

        </div>

        <!-- FOOTER -->
        <div class="modal-footer">
          <button type="button"
                  class="btn btn-outline-secondary"
                  data-bs-dismiss="modal">
            Cancel
          </button>

          <button type="submit"
                  class="btn btn-danger fw-semibold">
            Reject Application
          </button>
        </div>

      <% end %>

    </div>
  </div>
</div>
