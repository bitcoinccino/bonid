<section class="mb-4">
  <div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="h5 text-primary fw-semibold d-flex align-items-center gap-2 mb-0">
      <i class="ri-plane-line"></i> Travel & Stay Information
    </h2>
  </div>

  <div class="card border-0 rounded-4 shadow-sm p-4 bg-white">
    <% visitor = visitor_submission %>

    <p class="text-muted small mb-4">
      This section summarizes the visitor’s declared travel details, entry method,
      and accommodation information provided during the BonTouris ID application.
    </p>

    <div class="row g-4">

      <!-- Entry -->
      <div class="col-md-6">
        <strong>Entry Mode:</strong><br>
        <span><%= visitor.entry_mode&.titleize || "N/A" %></span>
        <br>
        <small class="text-muted">
          Method of arrival into Haiti (air, land, or sea)
        </small>
      </div>

      <div class="col-md-6">
        <strong>Port of Entry:</strong><br>
        <span><%= visitor.port_of_entry.presence || "N/A" %></span>
        <br>
        <small class="text-muted">
          Official airport, seaport, or land border
        </small>
      </div>

      <!-- Transport -->
      <div class="col-md-6">
        <strong>Transport Provider:</strong><br>
        <span><%= visitor.transport_provider.presence || "N/A" %></span>
        <br>
        <small class="text-muted">
          Airline, carrier, or transport operator
        </small>
      </div>

      <div class="col-md-6">
        <strong>Transport Reference:</strong><br>
        <span><%= visitor.transport_reference.presence || "N/A" %></span>
        <br>
        <small class="text-muted">
          Flight number or transport reference code
        </small>
      </div>

      <!-- Purpose -->
      <div class="col-md-6">
        <strong>Purpose of Visit:</strong><br>
        <span class="fw-medium">
          <%= visitor.purpose_of_visit.presence || "N/A" %>
        </span>
        <br>
        <small class="text-muted">
          Declared reason for entering Haiti
        </small>
      </div>

      <div class="col-md-6">
        <strong>Planned Stay Duration:</strong><br>
        <span>
          <%= visitor.stay_duration_days.present? ? "#{visitor.stay_duration_days} days" : "N/A" %>
        </span>
        <br>
        <small class="text-muted">
          Intended length of stay
        </small>
      </div>

      <!-- Accommodation -->
      <div class="col-md-6">
        <strong>Accommodation Type:</strong><br>
        <span><%= visitor.accommodation_type&.titleize || "N/A" %></span>
        <br>
        <small class="text-muted">
          Hotel, private residence, or other arrangement
        </small>
      </div>

      <div class="col-md-6">
        <strong>Accommodation Name:</strong><br>
        <span><%= visitor.accommodation_name.presence || "N/A" %></span>
        <br>
        <small class="text-muted">
          Declared place of stay
        </small>
      </div>

    </div>
  </div>
</section>
