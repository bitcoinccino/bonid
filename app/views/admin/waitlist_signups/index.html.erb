<section class="certificate-font py-5" role="main">
  <div class="container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="h4 fw-bold text-primary mb-1">
          <i class="ri-list-check-3 me-2"></i> Waitlist Signups
        </h2>
        <p class="text-muted small mb-0">
          Track who signed up for BonID, where demand is highest, and manage invitations.
        </p>
      </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
      <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
          <div class="h3 fw-bold text-primary mb-0"><%= @total %></div>
          <div class="text-muted small">Total Signups</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
          <div class="h3 fw-bold text-success mb-0"><%= @citizens %></div>
          <div class="text-muted small">Citizens</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
          <div class="h3 fw-bold text-info mb-0"><%= @businesses %></div>
          <div class="text-muted small">Businesses</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
          <div class="h3 fw-bold text-warning mb-0"><%= @diaspora_count %></div>
          <div class="text-muted small">Diaspora</div>
        </div>
      </div>
    </div>

    <!-- Top Communes -->
    <% if @top_communes.any? %>
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
          <h6 class="fw-bold mb-3"><i class="ri-map-pin-line me-1"></i> Top Communes by Demand</h6>
          <div class="row g-2">
            <% @top_communes.each do |name, count| %>
              <div class="col-6 col-md-4 col-lg-2">
                <div class="bg-light rounded-3 p-2 text-center">
                  <div class="fw-bold text-primary"><%= count %></div>
                  <div class="text-muted small text-truncate"><%= name %></div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Filters -->
    <%= form_with url: admin_waitlist_signups_path, method: :get, class: "mb-4" do |f| %>
      <div class="row g-3">
        <div class="col-md-3">
          <%= f.text_field :search,
                value: params[:search],
                placeholder: "Search by email...",
                class: "form-control form-control-sm" %>
        </div>
        <div class="col-md-2">
          <%= f.select :type,
                options_for_select([["All Types", ""], ["Citizen", "citizen"], ["Business", "business"]], params[:type]),
                {}, class: "form-select form-select-sm", onchange: "this.form.submit()" %>
        </div>
        <div class="col-md-2">
          <%= f.select :status,
                options_for_select([["All Status", ""], ["Waiting", "waiting"], ["Invited", "invited"], ["Converted", "converted"]], params[:status]),
                {}, class: "form-select form-select-sm", onchange: "this.form.submit()" %>
        </div>
        <div class="col-md-2">
          <%= f.select :department_id,
                options_for_select([["All Depts", ""]] + @departments.map { |d| [d.name, d.id] }, params[:department_id]),
                {}, class: "form-select form-select-sm", id: "waitlist-dept-filter", onchange: "loadCommuneFilter(this.value)" %>
        </div>
        <div class="col-md-2">
          <%= f.select :commune_id,
                options_for_select([["All Communes", ""]] + @communes.map { |c| [c.name, c.id] }, params[:commune_id]),
                {}, class: "form-select form-select-sm", id: "waitlist-commune-filter", onchange: "this.form.submit()" %>
        </div>
        <div class="col-md-1">
          <%= f.submit "Filter", class: "btn btn-primary btn-sm w-100" %>
          <% if params[:search].present? || params[:type].present? || params[:status].present? || params[:commune_id].present? || params[:department_id].present? %>
            <%= link_to "Clear", admin_waitlist_signups_path, class: "btn btn-outline-secondary btn-sm w-100 mt-1" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Launch Commune -->
    <% if @selected_commune %>
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
          <div>
            <h6 class="fw-bold mb-1">
              <i class="ri-rocket-2-line me-1"></i> <%= @selected_commune.name %>
              <% if @selected_commune.launched? %>
                <span class="badge bg-success ms-1">Live<%= " · since #{@selected_commune.launched_at.to_date}" if @selected_commune.launched_at %></span>
              <% else %>
                <span class="badge bg-warning text-dark ms-1">Not launched</span>
              <% end %>
            </h6>
            <p class="text-muted small mb-0">
              <%= @selected_commune_waiting %> signup<%= "s" unless @selected_commune_waiting == 1 %> still waiting here.
              <% unless @selected_commune.launched? %>
                Launching opens BonID for everyone in this commune and emails the waiting signups.
              <% end %>
            </p>
          </div>
          <div>
            <% if @selected_commune.launched? %>
              <%= button_to unlaunch_admin_commune_path(@selected_commune),
                    method: :post,
                    class: "btn btn-outline-danger btn-sm",
                    data: { turbo_confirm: "Unlaunch #{@selected_commune.name}? New signups there will have to wait again." } do %>
                <i class="ri-pause-circle-line me-1"></i> Unlaunch
              <% end %>
            <% else %>
              <%= button_to launch_admin_commune_path(@selected_commune),
                    method: :post,
                    class: "btn btn-success btn-sm",
                    data: { turbo_confirm: "Launch #{@selected_commune.name} and notify #{@selected_commune_waiting} waiting signup#{'s' unless @selected_commune_waiting == 1}? This emails real users." } do %>
                <i class="ri-rocket-2-line me-1"></i> Launch this commune
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Bulk Actions -->
    <%= form_with url: bulk_invite_admin_waitlist_signups_path, method: :post, id: "bulk-form" do %>
      <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="form-check">
          <input type="checkbox" class="form-check-input" id="select-all" onclick="toggleAll(this)">
          <label class="form-check-label small text-muted" for="select-all">Select All</label>
        </div>
        <button type="submit" class="btn btn-sm btn-outline-success">
          <i class="ri-mail-send-line me-1"></i> Bulk Invite Selected
        </button>
      </div>

      <!-- Table -->
      <div class="table-responsive rounded-3 shadow-sm">
        <table class="table table-bordered table-hover table-sm align-middle mb-0">
          <thead class="table-light text-center">
            <tr>
              <th width="30"></th>
              <th>Email</th>
              <th>Type</th>
              <th>Commune</th>
              <th>Status</th>
              <th>Referral Code</th>
              <th>Date</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @signups.each do |signup| %>
              <tr>
                <td class="text-center">
                  <% if signup.status == "waiting" %>
                    <input type="checkbox" name="signup_ids[]" value="<%= signup.id %>" class="form-check-input">
                  <% end %>
                </td>
                <td>
                  <strong><%= signup.email %></strong>
                  <% if signup.organization_name.present? %>
                    <br><small class="text-muted"><%= signup.organization_name %></small>
                  <% end %>
                  <% if signup.partner %>
                    <br><small class="text-success">
                      <i class="ri-links-line"></i>
                      <%= link_to "Partner: #{signup.partner.name} (#{signup.partner.status})",
                            admin_partner_path(signup.partner.uuid), class: "text-success" %>
                    </small>
                  <% end %>
                </td>
                <td class="text-center">
                  <% if signup.signup_type == "citizen" %>
                    <span class="badge bg-success-subtle text-success">Citizen</span>
                  <% else %>
                    <span class="badge bg-info-subtle text-info">Business</span>
                  <% end %>
                </td>
                <td>
                  <% if signup.diaspora? %>
                    <span class="badge bg-warning-subtle text-warning">
                      <i class="ri-global-line me-1"></i><%= signup.country_of_residence || "Diaspora" %>
                    </span>
                  <% elsif signup.commune %>
                    <%= signup.commune.name %>
                  <% else %>
                    <span class="text-muted">N/A</span>
                  <% end %>
                </td>
                <td class="text-center">
                  <% case signup.status %>
                  <% when "waiting" %>
                    <span class="badge bg-secondary">Waiting</span>
                  <% when "invited" %>
                    <span class="badge bg-primary">Invited</span>
                  <% when "converted" %>
                    <span class="badge bg-success">Converted</span>
                  <% end %>
                </td>
                <td class="text-center">
                  <code class="small"><%= signup.referral_code %></code>
                </td>
                <td class="text-center small">
                  <%= signup.created_at.strftime("%b %d, %Y") %>
                </td>
                <td class="text-center">
                  <% if signup.status == "waiting" %>
                    <%= button_to "Invite", invite_admin_waitlist_signup_path(signup),
                          method: :post, class: "btn btn-sm btn-outline-primary",
                          data: { turbo_confirm: "Mark #{signup.email} as invited?" } %>
                  <% elsif signup.status == "invited" %>
                    <%= button_to "Convert", convert_admin_waitlist_signup_path(signup),
                          method: :post, class: "btn btn-sm btn-outline-success",
                          data: { turbo_confirm: "Mark #{signup.email} as converted?" } %>
                  <% else %>
                    <span class="text-muted small">Done</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <!-- Pagination -->
    <div class="mt-3">
      <%= paginate @signups if @signups.respond_to?(:total_pages) %>
    </div>
  </div>
</section>

<script>
  function toggleAll(el) {
    document.querySelectorAll('#bulk-form input[type="checkbox"]').forEach(function(cb) {
      cb.checked = el.checked;
    });
  }

  function loadCommuneFilter(deptId) {
    var sel = document.getElementById('waitlist-commune-filter');
    sel.innerHTML = '<option value="">All Communes</option>';
    if (!deptId) { sel.closest('form').submit(); return; }

    fetch('<%= communes_admin_waitlist_signups_path %>?department_id=' + deptId)
      .then(function(r) { return r.json(); })
      .then(function(data) {
        data.forEach(function(c) {
          var opt = document.createElement('option');
          opt.value = c.id;
          opt.textContent = c.name;
          sel.appendChild(opt);
        });
        sel.closest('form').submit();
      });
  }
</script>
