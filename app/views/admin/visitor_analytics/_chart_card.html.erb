<div class="col-md-6 col-lg-4">
  <div class="card shadow-sm rounded-4 p-3" style="height: 340px;">
    <h6 class="fw-semibold mb-3"><%= title %></h6>

    <% if data.present? %>
      <div style="height: 240px;">
        <canvas
          data-controller="chart"
          data-chart-labels-value="<%= data.keys.map(&:to_s).to_json %>"
          data-chart-data-value="<%= data.values.to_json %>">
        </canvas>
      </div>
    <% else %>
      <p class="text-muted small mb-0">No data available</p>
    <% end %>
  </div>
</div>
