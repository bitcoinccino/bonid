<div class="container mt-4">

  <!-- HEADER -->
  <div class="dashboard-header d-flex justify-content-between align-items-center mb-4">
    <span class="badge bg-primary-subtle text-primary fw-semibold px-4 py-2 shadow-sm">
      <%= Time.zone.now.strftime('%B %d, %Y') %>
    </span>
  </div>

  <!-- === STAT CARDS === -->
  <div class="row g-4 mb-5">
    <!-- Total Partners -->
    <div class="col-12 col-md-6 col-lg-3">
      <div class="card stat-card shadow-sm h-100 border-0">
        <div class="card-body text-center py-4">
          <i class="ri-handshake-line text-primary fs-1 mb-2"></i>
          <h6 class="text-muted fw-semibold mb-1">Total Partners</h6>
          <p class="stat-number"><%= number_with_delimiter(@partners_count || 0) %></p>
          <%= link_to "Manage", admin_partners_path, class: "btn btn-outline-primary btn-sm px-3 mt-2" %>
        </div>
      </div>
    </div>

    <!-- Active Applications -->
    <div class="col-12 col-md-6 col-lg-3">
      <div class="card stat-card shadow-sm h-100 border-0">
        <div class="card-body text-center py-4">
          <i class="ri-briefcase-4-line text-info fs-1 mb-2"></i>
          <h6 class="text-muted fw-semibold mb-1">Active Applications</h6>
          <p class="stat-number text-info"><%= number_with_delimiter(@active_partners_count || 0) %></p>
          <%= link_to "Review", admin_partners_path(status: :active), class: "btn btn-outline-info btn-sm px-3 mt-2" %>
        </div>
      </div>
    </div>

    <!-- Rejected Applications -->
    <div class="col-12 col-md-6 col-lg-3">
      <div class="card stat-card shadow-sm h-100 border-0">
        <div class="card-body text-center py-4">
          <i class="ri-close-circle-line text-danger fs-1 mb-2"></i>
          <h6 class="text-muted fw-semibold mb-1">Rejected Applications</h6>
          <p class="stat-number text-danger"><%= number_with_delimiter(@rejected_applications_count || 0) %></p>
          <%= link_to "View", admin_partners_path(status: :rejected), class: "btn btn-outline-danger btn-sm px-3 mt-2" %>
        </div>
      </div>
    </div>

    <!-- Officers -->
    <div class="col-12 col-md-6 col-lg-3">
      <div class="card stat-card shadow-sm h-100 border-0">
        <div class="card-body text-center py-4">
          <i class="ri-shield-user-line text-success fs-1 mb-2"></i>
          <h6 class="text-muted fw-semibold mb-1">Registered Officers</h6>
          <p class="stat-number text-success"><%= number_with_delimiter(@officers_count || 0) %></p>
          <%= link_to "Manage", "#", class: "btn btn-outline-success btn-sm px-3 mt-2" %>
        </div>
      </div>
    </div>
  </div>

  <!-- ====================================== -->
  <!--        ADVANCED ANALYTICS CHARTS       -->
  <!-- ====================================== -->
  <h4 class="fw-bold mb-3 text-haitian-blue">Analytics Overview</h4>

  <%= turbo_frame_tag "dashboard_charts", src: charts_admin_dashboards_path, loading: :lazy do %>
    <%= render "shared/lazy_skeleton" %>
  <% end %>

  <hr class="my-5" />

  <!-- === TABLES === -->
  <div class="row g-4">
    <!-- Recent Partners -->
    <div class="col-12 col-md-6">
      <div class="card shadow-sm border-0 table-card">
        <div class="card-header table-header bg-primary text-white fw-semibold">
          Recent Partners
        </div>
        <div class="card-body p-0">
          <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
              <tr>
                <th>Name</th>
                <th>Sector</th>
                <th>Created</th>
              </tr>
            </thead>
            <tbody>
              <% @recent_partners.each do |p| %>
                <tr>
                  <td><%= link_to (p.name.presence || "N/A"), admin_partner_path(p.uuid), class: "fw-semibold text-dark" %></td>
                  <td><%= p.sector.to_s.titleize.presence || "N/A" %></td>
                  <td><%= p.created_at ? time_ago_in_words(p.created_at) + " ago" : "N/A" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Recent Submissions -->
    <div class="col-12 col-md-6">
      <div class="card shadow-sm border-0 table-card">
        <div class="card-header table-header bg-success text-white fw-semibold">
          Recent Submissions
        </div>
        <div class="card-body p-0">
          <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
              <tr>
                <th>User</th>
                <th>Status</th>
                <th>Submitted</th>
              </tr>
            </thead>
            <tbody>
              <% @recent_submissions.each do |s| %>
                <tr>
                  <td><%= (s.user&.full_name.presence || "N/A") %></td>
                  <td>
                    <span class="badge rounded-pill bg-<%= 
                      s.status.to_s == 'approved' ? 'success' : 
                      s.status.to_s == 'rejected' ? 'danger' : 'secondary' %>">
                      <%= s.status.to_s.titleize %>
                    </span>
                  </td>
                  <td><%= s.created_at ? time_ago_in_words(s.created_at) + " ago" : "N/A" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>