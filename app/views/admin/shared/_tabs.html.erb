<!-- app/views/admin/shared/_tabs.html.erb -->
<ul class="tabs">
  <li class="<%= 'active' if @active == :dashboard %>">
    <%= link_to t('dashboard.title_short'), admin_partner_dashboard_path(partner_id: @partner.id) %>
  </li>
  <li class="<%= 'active' if @active == :officers %>">
    <%= link_to t('dashboard.officers'), admin_partner_officers_path(partner_id: @partner.id) %>
  </li>
  <li class="<%= 'active' if @active == :assignments %>">
    <%= link_to t('dashboard.assignments'), admin_partner_assignments_path(partner_id: @partner.id) %>
  </li>
  <li class="<%= 'active' if @active == :incident_reports %>">
    <%= link_to t('dashboard.incident_reports'), admin_incident_reports_path %>
  </li>
</ul>
<style>
    /* app/assets/stylesheets/admin.css */
.tabs {
  list-style: none;
  display: flex;
  gap: 10px;
  margin-bottom: 20px;
}
.tabs li {
  padding: 10px;
}
.tabs li.active {
  background: #1e40af;
  color: white;
  border-radius: 5px;
}
</style>