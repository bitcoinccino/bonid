<%# app/views/admin/name_change_requests/index.html.erb %>

<section class="container py-5" role="main">
  <%# Flash rendered by admin layout %>

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="h4 fw-bold text-primary mb-1">
        <i class="ri-edit-line me-2"></i>Name Change Requests
      </h2>
      <p class="text-muted small mb-0">
        Review and process citizen name change requests.
      </p>
    </div>
  </div>

  <!-- Status Filter Pills -->
  <div class="d-flex flex-wrap gap-2 mb-4">
    <% total = @counts.values.sum %>
    <%= link_to "All (#{total})",
                admin_name_change_requests_path,
                class: "btn btn-outline-primary btn-sm rounded-pill #{params[:status].blank? ? 'active' : ''}" %>

    <%= link_to "Pending (#{@counts['pending'] || @counts[0] || 0})",
                admin_name_change_requests_path(status: :pending),
                class: "btn btn-outline-warning btn-sm rounded-pill #{params[:status] == 'pending' ? 'active' : ''}" %>

    <%= link_to "Approved (#{@counts['approved'] || @counts[1] || 0})",
                admin_name_change_requests_path(status: :approved),
                class: "btn btn-outline-success btn-sm rounded-pill #{params[:status] == 'approved' ? 'active' : ''}" %>

    <%= link_to "Rejected (#{@counts['rejected'] || @counts[2] || 0})",
                admin_name_change_requests_path(status: :rejected),
                class: "btn btn-outline-danger btn-sm rounded-pill #{params[:status] == 'rejected' ? 'active' : ''}" %>
  </div>

  <!-- Requests Table -->
  <% if @requests.any? %>
    <div class="card shadow-sm border-0 rounded-4">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Citizen</th>
              <th>Current Name</th>
              <th>Requested Name</th>
              <th>Reason</th>
              <th>Status</th>
              <th>Submitted</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @requests.each do |req| %>
              <tr>
                <td>
                  <div class="d-flex align-items-center">
                    <div class="me-2 bg-light rounded-circle d-flex align-items-center justify-content-center overflow-hidden" style="width: 36px; height: 36px;">
                      <% if req.user&.photo&.attached? %>
                        <%= image_tag req.user.photo.variant(resize_to_fill: [36, 36]).processed,
                                      class: "rounded-circle", alt: "Photo",
                                      style: "width: 36px; height: 36px; object-fit: cover;" %>
                      <% else %>
                        <i class="ri-user-line text-muted"></i>
                      <% end %>
                    </div>
                    <div>
                      <div class="fw-semibold small"><%= req.user&.email || "—" %></div>
                      <div class="text-muted" style="font-size: 0.75rem;"><%= req.user&.bonid || "—" %></div>
                    </div>
                  </div>
                </td>
                <td class="small"><%= req.old_full_name %></td>
                <td class="small fw-semibold"><%= req.new_full_name %></td>
                <td class="small"><%= req.reason_label %></td>
                <td>
                  <span class="badge rounded-pill bg-<%= req.pending? ? 'warning' : req.approved? ? 'success' : 'danger' %>">
                    <%= req.status.titleize %>
                  </span>
                </td>
                <td class="small text-muted"><%= time_ago_in_words(req.created_at) %> ago</td>
                <td class="text-end">
                  <%= link_to admin_name_change_request_path(req),
                              class: "btn btn-sm btn-outline-primary rounded-pill" do %>
                    <i class="ri-eye-line me-1"></i>Review
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Pagination -->
    <div class="d-flex justify-content-center mt-4">
      <%= paginate @requests %>
    </div>
  <% else %>
    <div class="text-center text-muted py-5 mt-5">
      <i class="ri-inbox-line display-4 mb-3 opacity-50"></i>
      <h5>No name change requests found</h5>
      <p class="mb-0">There are no requests matching the current filter.</p>
    </div>
  <% end %>
</section>
