<!-- app/views/admin/partner_admin_invitations/new.html.erb -->
<section class="container invite-section py-5" role="main">
  <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
    <div class="d-flex align-items-center mb-4">
      <h1 class="display-6 fw-bold text-primary me-2">
        Invite Partner Admin for <%= @partner.name %>
        <% if @partner.verified_at.present? %>
          <i class="ri-verified-badge-fill ms-2 text-primary" title="Verified Partner"></i>
        <% end %>
      </h1>
    </div>

    <%# Flash rendered by admin layout %>

    <div class="d-flex align-items-center mb-5">
      <% if @partner.logo.attached? %>
        <%= image_tag @partner.logo.variant(resize_to_limit: [80, 80]).processed,
                      class: "rounded-circle border shadow-sm me-3",
                      alt: "#{@partner.name} logo",
                      style: "object-fit: cover; width: 80px; height: 80px;" %>
      <% else %>
        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-3" style="width: 80px; height: 80px;">
          <i class="ri-image-line text-muted" style="font-size: 2rem;"></i>
        </div>
      <% end %>
      <div>
        <h5 class="fw-bold mb-1 text-primary"><%= @partner.name %></h5>
        <p class="text-muted mb-0 small">
          Sector: <%= @partner.sector&.titleize || "N/A" %> |
          <%= @partner.verified_at.present? ? "Verified: #{@partner.verified_at.strftime('%b %d, %Y')}" : "Not Verified" %>
        </p>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-12 col-md-8 col-lg-6">
        <%= form_with url: admin_partner_partner_admin_invitations_path(@partner), method: :post, data: { controller: "form-handler", action: "turbo:submit-start->form-handler#submitStart turbo:submit-end->form-handler#submitEnd turbo:submit-error->form-handler#submitError" } do |f| %>
          <div class="mb-4">
            <%= f.label :email, "Email", class: "form-label fw-bold text-primary" %>
            <%= f.email_field :email, class: "form-control rounded-3", required: true, placeholder: "Enter email address", aria: { describedby: "emailHelp" } %>
            <div id="emailHelp" class="form-text text-muted mt-1">Enter the admin's email address.</div>
          </div>
          <div class="d-flex align-items-center gap-3 flex-wrap">
            <%= f.submit "Send Invitation", class: "btn btn-primary rounded-pill px-4", data: { formHandlerTarget: "submit" } %>
            <div class="spinner-border text-primary d-none" role="status" data-form-handler-target="spinner" aria-hidden="true"></div>
            <%= link_to "Back to Partners", admin_partners_path, class: "btn btn-outline-primary rounded-pill px-4" %>
          </div>
          <div class="mt-3 alert alert-danger d-none" data-form-handler-target="error"></div>
        <% end %>
      </div>
    </div>
  </div>
</section>

<style>
  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    overflow-x: hidden;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
  }
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background-color: #f8fafc;
  }
  .invite-section {
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
  }
  .container {
    max-width: 1200px;
    padding: 0 20px;
  }
  .card {
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transition: transform 0.2s ease;
  }
  .card:hover {
    transform: translateY(-5px);
  }
  :root {
    --haitian-blue: #1e40af;
    --palm-green: #059669;
    --golden-yellow: #f59e0b;
    --mid-gray: #6b7280;
  }
  .text-primary { color: var(--haitian-blue) !important; }
  .alert-success { background-color: #d1fae5; border-color: #a7f3d0; color: #065f46; }
  .alert-danger { background-color: #fee2e2; border-color: #fecaca; color: #991b1b; }
  .form-control {
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 0.9rem;
    transition: border-color 0.2s ease;
  }
  .form-control:focus {
    border-color: var(--haitian-blue);
    box-shadow: 0 0 0 0.2rem rgba(30, 64, 175, 0.25);
  }
  .btn {
    font-weight: 600;
    border-radius: 50rem;
    padding: 8px 12px;
    transition: all 0.2s ease;
  }
  .btn-primary {
    background: var(--haitian-blue);
    border-color: var(--haitian-blue);
  }
  .btn-primary:hover {
    background: #1e3a8a;
    border-color: #1e3a8a;
  }
  .btn-outline-primary {
    border-color: var(--haitian-blue);
    color: var(--haitian-blue);
  }
  .btn-outline-primary:hover {
    background: var(--haitian-blue);
    color: #ffffff;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    tooltipTriggerList.forEach(function (el) {
      new bootstrap.Tooltip(el);
    });
  });
</script>