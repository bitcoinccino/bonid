<section class="container invite-options-section py-5" role="main">
  <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
    <div class="d-flex align-items-center mb-4">
      <h1 class="display-6 fw-bold text-primary me-2">
        Invite Options for <%= @partner.name %>
        <% if @partner.verified_at.present? %>
          <i class="ri-verified-badge-fill ms-2 text-primary" title="Verified Partner"></i>
        <% end %>
      </h1>
    </div>

    <%# Flash rendered by admin layout %>

    <div class="d-flex align-items-center mb-5">
      <% if @partner.logo.attached? %>
        <%= image_tag @partner.logo.variant(resize_to_limit: [80, 80]).processed,
                      class: "rounded-circle border shadow-sm me-3",
                      alt: "#{@partner.name} logo",
                      style: "object-fit: cover; width: 80px; height: 80px;" %>
      <% else %>
        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-3" style="width: 80px; height: 80px;">
          <i class="ri-image-line text-muted" style="font-size: 2rem;"></i>
        </div>
      <% end %>
      <div>
        <h5 class="fw-bold mb-1 text-primary"><%= @partner.name %></h5>
        <p class="text-muted mb-0 small">
          Sector: <%= @partner.sector&.titleize || "N/A" %> |
          <%= @partner.verified_at.present? ? "Verified: #{@partner.verified_at.strftime('%b %d, %Y')}" : "Not Verified" %>
        </p>
      </div>
    </div>

    <div class="row g-4">
      <!-- Admin -->
      <div class="col-md-4">
        <div class="card h-100 p-4 border-0 shadow-sm rounded-3">
          <h5 class="fw-bold text-primary mb-3">
            <i class="ri-user-add-line me-2"></i> Admin
          </h5>
          <p class="text-muted small mb-3">
            Invite or resend an invitation to an admin for <%= @partner.name %>.
          </p>
          <%= form_with url: new_admin_partner_partner_admin_invitation_path(partner_id: @partner.id), method: :get, local: true do |f| %>
            <%= f.submit "Invite Admin", class: "btn btn-primary w-100 rounded-pill" %>
          <% end %>
        </div>
      </div>

      <!-- Reviewer -->
      <div class="col-md-4">
        <div class="card h-100 p-4 border-0 shadow-sm rounded-3">
          <h5 class="fw-bold text-primary mb-3">
            <i class="ri-user-search-line me-2"></i> Reviewer
          </h5>
          <p class="text-muted small mb-3">
            Invite a reviewer to verify identities under <%= @partner.name %>.
          </p>
          <%= form_with url: new_admin_partner_partner_reviewer_invitation_path(partner_id: @partner.id), method: :get, local: true do |f| %>
            <%= f.submit "Invite Reviewer", class: "btn btn-primary w-100 rounded-pill" %>
          <% end %>
        </div>
      </div>

      <!-- Users -->
      <div class="col-md-4">
        <div class="card h-100 p-4 border-0 shadow-sm rounded-3">
          <h5 class="fw-bold text-primary mb-3">
            <i class="ri-user-star-line me-2"></i> End Users
          </h5>
          <p class="text-muted small mb-3">
            Invite users to access <%= @partner.name %>'s BonID services.
          </p>
          <div class="d-flex flex-column gap-2">
            <%= link_to "Single User", invite_single_admin_partner_path(@partner.uuid), class: "btn btn-primary rounded-pill w-100" %>
            <%= link_to "Bulk Invite", invite_bulk_admin_partner_path(@partner.uuid), class: "btn btn-outline-primary rounded-pill w-100" %>
          </div>
        </div>
      </div>
    </div>

    <div class="text-center mt-5">
      <%= link_to admin_partners_path, class: "text-muted text-decoration-none" do %>
        <i class="ri-arrow-left-line me-1"></i> Back to Partners
      <% end %>
    </div>
  </div>
</section>

