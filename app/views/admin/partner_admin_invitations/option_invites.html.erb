<!-- Custom CSS -->
<style>
  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    overflow-x: hidden;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
  }
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background-color: #f8fafc;
  }
  .invite-options-section {
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
  }
  .container {
    max-width: 1200px;
    padding: 0 20px;
  }
  .card {
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transition: transform 0.2s ease;
  }
  .card:hover {
    transform: translateY(-5px);
  }
  :root {
    --haitian-blue: #1e40af;
    --palm-green: #059669;
    --golden-yellow: #f59e0b;
    --mid-gray: #6b7280;
  }
  .bg-primary {39
    background-color: var(--haitian-blue) !important;
  }
  .text-primary {
    color: var(--haitian-blue) !important;
  }
  .bg-success {
    background-color: var(--palm-green) !important;
  }
  .text-secondary {
    color: var(--mid-gray) !important;
  }
  .alert-success {
    background-color: #d1fae5;
    border-color: #a7f3d0;
    color: #065f46;
  }
  .alert-danger {
    background-color: #fee2e2;
    border-color: #fecaca;
    color: #991b1b;
  }
  .form-control, .form-select {
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 0.9rem;
    transition: border-color 0.2s ease;
  }
  .form-control:focus, .form-select:focus {
    border-color: var(--haitian-blue);
    box-shadow: 0 0 0 0.2rem rgba(30, 64, 175, 0.25);
  }
  .btn {
    font-weight: 600;
    border-radius: 50rem;
    padding: 8px 12px;
    transition: all 0.2s ease;
  }
  .btn-primary {
    background: var(--haitian-blue);
    border-color: var(--haitian-blue);
  }
  .btn-primary:hover {
    background: #1e3a8a;
    border-color: #1e3a8a;
  }
  .btn-outline-primary {
    border-color: var(--haitian-blue);
    color: var(--haitian-blue);
  }
  .btn-outline-primary:hover {
    background: var(--haitian-blue);
    color: #ffffff;
  }
  .btn-outline-secondary {
    border-color: var(--mid-gray);
    color: var(--mid-gray);
  }
  .btn-outline-secondary:hover {
    background: var(--mid-gray);
    color: #ffffff;
  }
  @media (max-width: 992px) {
    .invite-options-section {
      padding-top: 2rem;
      padding-bottom: 2rem;
    }
    .card {
      padding: 1.5rem;
    }
    .display-6 {
      font-size: 1.5rem;
    }
    .btn {
      font-size: 0.8rem;
      padding: 6px 10px;
    }
  }
  @media (max-width: 576px) {
    .display-6 {
      font-size: 1.25rem;
    }
    .rounded-circle {
      width: 60px;
      height: 60px;
    }
    .btn {
      font-size: 0.75rem;
      padding: 6px 8px;
    }
  }
</style>

<!-- JavaScript for Tooltips -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    tooltipTriggerList.forEach(function (el) {
      new bootstrap.Tooltip(el);
    });
  });
</script>