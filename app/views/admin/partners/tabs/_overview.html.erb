<div class="card rounded-3 shadow-sm border-0 mb-4">
  <div class="card-header bg-light border-bottom-0 py-3">
    <h5 class="h5 fw-bold text-primary mb-0 d-flex align-items-center gap-2">
      <i class="ri-building-line text-primary fs-5"></i>
      Business Information
    </h5>
  </div>

  <div class="card-body p-4">
    <div class="row g-4">

      <!-- Organization Name -->
      <div class="col-md-6">
        <div class="d-flex align-items-center gap-3">

          <div class="bg-haitian-blue bg-opacity-10 rounded p-2">
            <i class="ri-building-4-line text-primary fs-5"></i>
          </div>

          <div>
            <h6 class="text-muted small text-uppercase fw-normal mb-1">
              Organization Name
            </h6>
            <p class="fs-6 fw-medium text-dark mb-0">
              <%= partner.name.presence || "—" %>
            </p>
          </div>

        </div>
      </div>

      <!-- Sector -->
      <div class="col-md-6">
        <div class="d-flex align-items-center gap-3">

          <div class="bg-haitian-blue bg-opacity-10 rounded p-2">
            <i class="ri-briefcase-line text-primary fs-5"></i>
          </div>

          <div>
            <h6 class="text-muted small text-uppercase fw-normal mb-1">
              Industry / Sector
            </h6>
            <p class="fs-6 fw-medium text-dark mb-0">
              <%= partner.sector&.titleize.presence || "—" %>
            </p>
          </div>

        </div>
      </div>

      <!-- Website -->
      <div class="col-md-6">
        <div class="d-flex align-items-center gap-3">

          <div class="bg-haitian-blue bg-opacity-10 rounded p-2">
            <i class="ri-global-line text-primary fs-5"></i>
          </div>

          <div>
            <h6 class="text-muted small text-uppercase fw-normal mb-1">
              Website
            </h6>

            <% if partner.website.present? %>
              <%= link_to partner.website,
                          target: "_blank",
                          rel: "noopener",
                          class: "fs-6 fw-medium text-primary text-decoration-none hover-underline" do %>
                <%= partner.website %>
              <% end %>
            <% else %>
              <span class="text-muted fs-6">—</span>
            <% end %>

          </div>

        </div>
      </div>

      <!-- Contact Person -->
      <div class="col-md-6">
        <div class="d-flex align-items-center gap-3">

          <div class="bg-haitian-blue bg-opacity-10 rounded p-2">
            <i class="ri-user-line text-primary fs-5"></i>
          </div>

          <div>
            <h6 class="text-muted small text-uppercase fw-normal mb-1">
              Point of Contact
            </h6>
            <p class="fs-6 fw-medium text-dark mb-0">
              <%= partner.contact_person.presence || "—" %>
            </p>
          </div>

        </div>
      </div>

      <!-- Email -->
      <div class="col-md-6">
        <div class="d-flex align-items-center gap-3">

          <div class="bg-haitian-blue bg-opacity-10 rounded p-2">
            <i class="ri-mail-line text-primary fs-5"></i>
          </div>

          <div>
            <h6 class="text-muted small text-uppercase fw-normal mb-1">
              Email
            </h6>
            <p class="fs-6 fw-medium text-dark mb-0">
              <%= partner.email.presence || "—" %>
            </p>
          </div>

        </div>
      </div>

      <!-- Phone -->
      <div class="col-md-6">
        <div class="d-flex align-items-center gap-3">

          <div class="bg-haitian-blue bg-opacity-10 rounded p-2">
            <i class="ri-phone-line text-primary fs-5"></i>
          </div>

          <div>
            <h6 class="text-muted small text-uppercase fw-normal mb-1">
              Phone Number
            </h6>
            <p class="fs-6 fw-medium text-dark mb-0">
              <%= partner.phone_number.presence || "—" %>
            </p>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>
