<ul class="nav nav-tabs border-haitian-blue" id="partnerTabs" role="tablist">

  <% [
    ["Overview", "overview", "ri-dashboard-line"],
    ["Verification", "verification", "ri-shield-check-line"],
    ["Location", "location", "ri-map-pin-line"],
    ["Scan History", "scans", "ri-qr-scan-line"],
    ["Audit Logs", "audit", "ri-file-list-line"],
    ["Metadata", "metadata", "ri-database-2-line"]
  ].each_with_index do |(title, id, icon), index| %>

    <li class="nav-item" role="presentation">
      <button
        class="nav-link fw-semibold text-haitian-blue px-4 <%= index.zero? ? 'active' : '' %>"
        id="<%= id %>-tab"
        data-bs-toggle="tab"
        data-bs-target="#<%= id %>"
        type="button"
        role="tab"
        aria-controls="<%= id %>"
        aria-selected="<%= index.zero? %>">
        <i class="<%= icon %> me-1"></i>
        <%= title %>
      </button>
    </li>

  <% end %>

</ul>
