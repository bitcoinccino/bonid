<!-- app/views/admin/partners/_partner_summary.html.erb -->
<div class="card shadow-sm rounded-4 border-0 mb-4">
  <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">

    <!-- Left: Logo + Info -->
    <div class="d-flex align-items-center gap-3 flex-wrap">
      <% if partner.logo.attached? %>
        <%= image_tag partner.logo.variant(resize_to_limit: [96, 96]),
                      class: "rounded-circle border shadow-sm",
                      alt: "#{partner.name} logo" %>
      <% else %>
        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center shadow-sm"
             style="width:96px;height:96px;">
          <i class="ri-building-line text-secondary ri-2x"></i>
        </div>
      <% end %>

      <div>
        <h2 class="h4 fw-bold text-haitian-blue mb-1 d-flex align-items-center flex-wrap">
          <i class="ri-building-4-line me-1"></i>
          <%= partner.name %>

          <% if partner.verified_at.present? %>
            <span class="badge bg-success ms-2">
              <i class="ri-check-line me-1"></i> Verified
            </span>
          <% else %>
            <span class="badge bg-warning text-dark ms-2">
              <i class="ri-time-line me-1"></i> Pending
            </span>
          <% end %>
        </h2>

        <p class="text-muted mb-1">
          <i class="ri-briefcase-line me-1"></i>
          Sector: <%= partner.sector&.titleize || "N/A" %>
        </p>

        <p class="text-muted mb-0">
          <i class="ri-calendar-check-line me-1"></i>
          Verified:
          <%= partner.verified_at&.strftime("%b %d, %Y") || "Not verified" %>
        </p>
      </div>
    </div>

    <!-- Right: Actions -->
    <% if local_assigns[:show_actions] %>
      <div class="d-flex flex-wrap justify-content-md-end gap-2 mt-2 mt-md-0">
        <% if local_assigns[:edit_path] %>
          <%= link_to "Edit", edit_path, class: "btn btn-outline-primary rounded-pill" %>
        <% end %>
        <% if local_assigns[:back_path] %>
          <%= link_to "Back", back_path, class: "btn btn-light border rounded-pill" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
