
<% unless @partner %>
  <div class="container mt-5">
    <div class="alert alert-dismissible fade show alert-danger text-center">
      Partner not found.
    </div>
    <div class="text-center mt-3">
      <%= link_to admin_partners_path, class: "btn btn-outline-primary" do %>
        <i class="ri-arrow-left-line me-1"></i> Back to Partners
      <% end %>
    </div>
  </div>
  <% return %>
<% end %>

<section class="invite-options-section py-5" role="main">
  <div class="container d-flex flex-column align-items-center">

    <!-- Partner Info Card -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 text-center mb-5 bg-white" style="max-width: 800px; width: 100%;">
      <div class="d-flex flex-column align-items-center">
        <% if @partner.logo&.attached? %>
          <%= image_tag @partner.logo.variant(resize_to_limit: [100, 100]).processed,
                        class: "rounded-circle border shadow-sm mb-3",
                        alt: "#{@partner.name} logo",
                        style: "object-fit: cover; width: 100px; height: 100px;" %>
        <% else %>
          <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mb-3" style="width: 100px; height: 100px;">
            <i class="ri-image-line text-muted" style="font-size: 2rem;"></i>
          </div>
        <% end %>

        <h1 class="h4 fw-bold text-primary mb-2">
          Invite Options for <%= @partner.name || "Unknown Partner" %>
          <% if @partner.verified_at.present? %>
            <i class="ri-verified-badge-fill ms-1 text-primary" title="Verified Partner"></i>
          <% end %>
        </h1>
        <p class="text-muted small mb-0">
          Sector: <%= @partner.sector&.titleize || "N/A" %> |
          <%= @partner.verified_at.present? ? "Verified: #{@partner.verified_at.strftime('%b %d, %Y')}" : "Not Verified" %>
        </p>
      </div>
    </div>

    <%# Flash rendered by admin layout %>

    <!-- Invite Options Grid -->
    <div class="row g-4 justify-content-center w-100" style="max-width: 1000px;">
      <!-- Admin -->
      <div class="col-md-4">
        <div class="card h-100 p-4 text-center border-0 shadow-sm rounded-3">
          <h5 class="fw-bold text-primary mb-3">
            <i class="ri-user-add-line me-2"></i> Admin
          </h5>
          <p class="text-muted small mb-3">
            Invite an admin to manage <%= @partner.name || "this partner" %>'s verification process and team.
          </p>
          <%= form_with url: new_admin_partner_partner_admin_invitation_path(partner_id: @partner.id), method: :get, local: true do |f| %>
            <%= f.submit "Invite Admin", class: "btn btn-primary w-100 rounded-pill" %>
          <% end %>
        </div>
      </div>

      <!-- End Users -->
      <div class="col-md-4">
        <div class="card h-100 p-4 text-center border-0 shadow-sm rounded-3">
          <h5 class="fw-bold text-primary mb-3">
            <i class="ri-user-star-line me-2"></i> End Users
          </h5>
          <p class="text-muted small mb-3">
            Invite users to access <%= @partner.name || "this partner" %>'s BonID services.
          </p>
          <div class="d-flex flex-column gap-2">
            <%= link_to "Single User",
                        invite_single_admin_partner_path(@partner.uuid),
                        class: "btn btn-primary rounded-pill w-100" %>
            <%= link_to "Bulk Invite",
                        invite_bulk_admin_partner_path(@partner.uuid),
                        class: "btn btn-outline-primary rounded-pill w-100" %>
          </div>
        </div>
      </div>
    </div>

    <!-- Back Button -->
    <div class="text-center mt-5">
      <%= link_to admin_partners_path, class: "text-muted text-decoration-none" do %>
        <i class="ri-arrow-left-line me-1"></i> Back to Partners
      <% end %>
    </div>
  </div>
</section>

<!-- Custom CSS -->
<style>
  /* Base Styles */
  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    overflow-x: hidden;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background-color: #f8fafc;
  }

  .invite-options-section {
    min-height: calc(100vh - 80px); /* Account for navbar */
    display: flex;
    align-items: center;
  }

  .container {
    max-width: 1200px;
    padding: 0 20px;
  }

  .card {
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transition: transform 0.2s ease;
  }

  .card:hover {
    transform: translateY(-5px);
  }

  /* Colors */
  :root {
    --haitian-blue: #1e40af;
    --palm-green: #059669;
    --golden-yellow: #f59e0b;
    --mid-gray: #6b7280;
  }

  .bg-primary { background-color: var(--haitian-blue) !important; }
  .text-primary { color: var(--haitian-blue) !important; }
  .bg-success { background-color: var(--palm-green) !important; }
  .text-secondary { color: var(--mid-gray) !important; }
  .alert-success { background-color: #d1fae5; border-color: #a7f3d0; color: #065f46; }
  .alert-danger { background-color: #fee2e2; border-color: #fecaca; color: #991b1b; }

  /* Form Elements */
  .form-control, .form-select {
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 0.9rem;
    transition: border-color 0.2s ease;
  }

  .form-control:focus, .form-select:focus {
    border-color: var(--haitian-blue);
    box-shadow: 0 0 0 0.2rem rgba(30, 64, 175, 0.25);
  }

  /* Buttons */
  .btn {
    font-weight: 600;
    border-radius: 50rem;
    padding: 8px 12px;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background: var(--haitian-blue);
    border-color: var(--haitian-blue);
  }

  .btn-primary:hover {
    background: #1e3a8a;
    border-color: #1e3a8a;
  }

  .btn-outline-primary {
    border-color: var(--haitian-blue);
    color: var(--haitian-blue);
  }

  .btn-outline-primary:hover {
    background: var(--haitian-blue);
    color: #ffffff;
  }

  .btn-outline-secondary {
    border-color: var(--mid-gray);
    color: var(--mid-gray);
  }

  .btn-outline-secondary:hover {
    background: var(--mid-gray);
    color: #ffffff;
  }

  /* Responsive */
  @media (max-width: 992px) {
    .invite-options-section {
      padding-top: 2rem;
      padding-bottom: 2rem;
    }

    .card {
      padding: 1.5rem;
    }

    .display-5 {
      font-size: 1.5rem;
    }

    .btn {
      font-size: 0.8rem;
      padding: 6px 10px;
    }
  }

  @media (max-width: 576px) {
    .display-5 {
      font-size: 1.25rem;
    }

    .rounded {
      width: 60px;
      height: 60px;
    }

    .btn {
      font-size: 0.75rem;
      padding: 6px 8px;
    }
  }
</style>

<!-- JavaScript for Tooltips -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Bootstrap 5 tooltip initialization
    const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    tooltipTriggerList.forEach(function (el) {
      new bootstrap.Tooltip(el);
    });
  });
</script>