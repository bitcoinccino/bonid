<div class="card rounded-4 shadow-sm border-0">
  <div class="card-header bg-light border-bottom">
    <h5 class="fw-bold text-haitian-blue mb-0">
      <i class="ri-qr-scan-line me-1"></i>
      QR Scan History
    </h5>
  </div>

  <div class="card-body p-4">

    <% scans = @partner.qr_scans.order(scanned_at: :desc).limit(200) %>

    <% if scans.any? %>
      <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>Scanned At</th>
              <th>IP</th>
              <th>Source</th>
              <th>Success</th>
              <th>Failure Reason</th>
              <th>Payload</th>
              <th>Raw QR Data</th>
              <th>Location</th>
              <th>Officer</th>
              <th>User</th>
              <th>Created</th>
              <th>Updated</th>
            </tr>
          </thead>

          <tbody>
            <% scans.each do |scan| %>
              <tr>
                <!-- Timestamp -->
                <td>
                  <%= scan.scanned_at&.strftime("%b %d, %Y %I:%M %p") %>
                  <br>
                  <small class="text-muted"><%= time_ago_in_words(scan.scanned_at) %> ago</small>
                </td>

                <!-- IP -->
                <td><%= scan.ip_address.presence || "N/A" %></td>

                <!-- Source -->
                <td>
                  <% source = scan.scan_source.presence || "unknown" %>
                  <span class="badge bg-secondary"><%= source.humanize %></span>
                </td>

                <!-- Success badge -->
                <td>
                  <% if scan.success %>
                    <span class="badge bg-palm-green">Success</span>
                  <% else %>
                    <span class="badge bg-danger">Failed</span>
                  <% end %>
                </td>

                <!-- Failure reason -->
                <td>
                  <% if scan.failure_reason.present? %>
                    <span class="text-danger"><%= scan.failure_reason %></span>
                  <% else %>
                    <span class="text-muted">—</span>
                  <% end %>
                </td>

                <!-- Decoded payload -->
                <td style="max-width: 250px;">
                  <% if scan.payload.present? %>
                    <code class="small d-block bg-light p-2 rounded border">
                      <%= truncate(scan.payload.to_json, length: 120) %>
                    </code>
                  <% else %>
                    <span class="text-muted">N/A</span>
                  <% end %>
                </td>

                <!-- Raw QR Data -->
                <td style="max-width: 250px;">
                  <% if scan.raw_qr_data.present? %>
                    <code class="small d-block bg-light p-2 rounded border">
                      <%= truncate(scan.raw_qr_data.to_s, length: 120) %>
                    </code>
                  <% else %>
                    <span class="text-muted">N/A</span>
                  <% end %>
                </td>

                <!-- Geo -->
                <td>
                  <% if scan.latitude.present? && scan.longitude.present? %>
                    <span class="text-info-blue fw-semibold">Lat:</span>
                    <%= scan.latitude %><br>
                    <span class="text-info-blue fw-semibold">Lng:</span>
                    <%= scan.longitude %>
                  <% else %>
                    <span class="text-muted">N/A</span>
                  <% end %>
                </td>

                <!-- Officer -->
                <td>
                  <% if scan.officer.present? %>
                    <%= link_to scan.officer.email, officers_officer_path(scan.officer), class: "text-haitian-blue fw-semibold small" %>
                  <% else %>
                    <span class="text-muted">—</span>
                  <% end %>
                </td>

                <!-- User -->
                <td>
                  <% if scan.user.present? %>
                    <%= link_to scan.user.email, admin_user_path(scan.user), class: "text-haitian-blue fw-semibold small" %>
                  <% else %>
                    <span class="text-muted">—</span>
                  <% end %>
                </td>

                <!-- Created -->
                <td class="small text-muted">
                  <%= scan.created_at.strftime("%b %d, %Y") %><br>
                  <%= scan.created_at.strftime("%I:%M %p") %>
                </td>

                <!-- Updated -->
                <td class="small text-muted">
                  <%= scan.updated_at.strftime("%b %d, %Y") %><br>
                  <%= scan.updated_at.strftime("%I:%M %p") %>
                </td>

              </tr>
            <% end %>

          </tbody>
        </table>
      </div>

    <% else %>
      <p class="text-muted fst-italic">No QR scans have been recorded for this partner.</p>
    <% end %>

  </div>
</div>
