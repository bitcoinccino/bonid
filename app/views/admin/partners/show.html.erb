<%# Flash rendered by admin layout %>

<section class="certificate-font py-5" role="main">
  <div class="container" style="max-width: 1200px;">

    <!-- ====================================================== -->
    <!-- HEADER PARTIAL                                         -->
    <!-- ====================================================== -->
    <%= render "admin/partners/header", partner: @partner %>

    <!-- ====================================================== -->
    <!-- TABS NAVIGATION                                        -->
    <!-- ====================================================== -->
    <%= render "admin/partners/tabs/tabs", partner: @partner %>

    <!-- ====================================================== -->
    <!-- TAB CONTENT                                            -->
    <!-- ====================================================== -->
    <div class="tab-content mt-4" id="partnerTabsContent">

      <!-- OVERVIEW TAB -->
      <div class="tab-pane fade show active" id="overview" role="tabpanel" aria-labelledby="overview-tab">
        <%= render "admin/partners/tabs/overview", partner: @partner %>
      </div>

      <!-- VERIFICATION TAB -->
      <div class="tab-pane fade" id="verification" role="tabpanel" aria-labelledby="verification-tab">
        <%= render "admin/partners/tabs/verification", partner: @partner %>
      </div>

      <!-- LOCATION TAB -->
      <div class="tab-pane fade" id="location" role="tabpanel" aria-labelledby="location-tab">
        <%= render "admin/partners/tabs/location", partner: @partner %>
      </div>

      <!-- SCAN HISTORY TAB -->
      <div class="tab-pane fade" id="scans" role="tabpanel" aria-labelledby="scans-tab">
        <%= render "admin/partners/tabs/scan_history", partner: @partner %>
      </div>

      <!-- AUDIT LOGS TAB -->
      <div class="tab-pane fade" id="audit" role="tabpanel" aria-labelledby="audit-tab">
        <%= render "admin/partners/tabs/audit_logs", partner: @partner %>
      </div>

      <!-- METADATA TAB -->
      <div class="tab-pane fade" id="metadata" role="tabpanel" aria-labelledby="metadata-tab">
        <%= render "admin/partners/tabs/metadata", partner: @partner %>
      </div>

    </div>

  </div>
</section>

<!-- ====================================================== -->
<!-- REJECT MODAL                                           -->
<!-- ====================================================== -->
<%= render "admin/partners/reject_modal", partner: @partner %>

<script>
  document.addEventListener("turbo:load", () => {

    // Re-enable tooltips
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => {
      new bootstrap.Tooltip(el)
    });

    // Activate correct tab if URL has #hash
    const hash = window.location.hash;
    if (hash) {
      const tabButton = document.querySelector(
        `#partnerTabs button[data-bs-target="${hash}"]`
      );

      if (tabButton) {
        bootstrap.Tab.getOrCreateInstance(tabButton).show();
      }
    }
  });
</script>
