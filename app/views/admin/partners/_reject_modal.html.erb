<div class="modal fade" id="rejectPartnerModal" tabindex="-1" aria-labelledby="rejectPartnerLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 shadow-lg border-0" data-controller="rejection">

      <div class="modal-header bg-danger text-white rounded-top-4">
        <h5 class="modal-title fw-bold">
          <i class="ri-close-circle-line me-1"></i>
          Reject Partner
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <%= form_with model: partner,
                    url: admin_partner_path(partner.uuid),
                    method: :patch,
                    html: { data: { turbo: false } } do |f| %>

        <div class="modal-body p-4">

          <!-- Rejection Reason -->
          <div class="mb-3">
            <%= f.label :rejection_reason, "Rejection Reason", class: "form-label fw-semibold" %>

            <%= f.select :rejection_reason,
                  options_for_select(
                    PartnerRejectionConstants::REJECTION_REASONS.map { |value, label| [label, value] },
                    selected: partner.rejection_reason
                  ),
                  { prompt: "Select a reason" },
                  class: "form-select rounded-3",
                  required: true,
                  data: {
                    action: "input->rejection#toggle change->rejection#toggle",
                    rejection_target: "reasonSelect"
                  } %>
          </div>

          <!-- Additional Comments (hidden unless "other" is selected) -->
          <div class="mb-3 d-none" data-rejection-target="commentsWrapper">
            <%= f.label :rejection_comment, "Additional Comments (Required)", class: "form-label fw-semibold text-danger" %>
            <%= f.text_area :rejection_comment,
                  rows: 4,
                  class: "form-control rounded-3",
                  placeholder: "Please explain why you selected 'Other'",
                  data: { rejection_target: "commentsField" } %>
          </div>
        </div>

        <div class="modal-footer border-0 p-3 justify-content-between">
          <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">
            Cancel
          </button>

          <%= f.submit "Reject Partner",
                class: "btn btn-danger rounded-pill fw-semibold px-4",
                data: { disable_with: "Rejecting..." },
                name: "commit" %>
        </div>
      <% end %>
    </div>
  </div>
</div>