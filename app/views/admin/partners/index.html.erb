<%# Flash rendered by admin layout %>

<section class="certificate-font py-5" role="main">
  <div class="container">

    <!-- Header + Actions -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="h4 fw-bold text-primary mb-1">
          Partner Directory
        </h2>
        <p class="text-muted small mb-0">
          Manage verification, onboarding, API usage & security status.
        </p>
      </div>

      <div class="d-flex gap-2">
        <%= link_to admin_partners_path(format: :csv, **request.query_parameters.except(:format, :page)),
                    class: "btn btn-outline-success btn-sm rounded-pill" do %>
          Export CSV
        <% end %>

        <button class="btn btn-primary btn-sm rounded-pill"
                data-bs-toggle="modal"
                data-bs-target="#newPartnerModal">
          New Partner
        </button>
      </div>
    </div>

    <!-- Filter Tabs + Search -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">

      <!-- Status Tabs -->
      <div class="d-flex flex-wrap gap-2">
        <%= link_to "All", admin_partners_path(search: params[:search]),
                    class: "btn btn-sm rounded-pill #{params[:filter].blank? ? 'btn-primary' : 'btn-outline-primary'}" %>

        <%= link_to "Verified", admin_partners_path(filter: "verified", search: params[:search]),
                    class: "btn btn-sm rounded-pill #{params[:filter] == 'verified' ? 'btn-success' : 'btn-outline-success'}" %>

        <%= link_to "Pending", admin_partners_path(filter: "pending", search: params[:search]),
                    class: "btn btn-sm rounded-pill #{params[:filter] == 'pending' ? 'btn-warning text-dark' : 'btn-outline-warning text-dark'}" %>

        <%= link_to "Rejected", admin_partners_path(filter: "rejected", search: params[:search]),
                    class: "btn btn-sm rounded-pill #{params[:filter] == 'rejected' ? 'btn-danger' : 'btn-outline-danger'}" %>
      </div>

      <!-- Search -->
      <%= form_with url: admin_partners_path, method: :get, local: true, class: "d-flex" do %>
        <%= text_field_tag :search, params[:search],
                           placeholder: "Search partners...",
                           class: "form-control form-control-sm rounded-pill",
                           style: "width: 240px;" %>
      <% end %>
    </div>

    <!-- Partners Table -->
    <% if @partners.any? %>
      <div class="table-responsive rounded-3 shadow-sm overflow-hidden">
        <table class="table table-hover table-sm align-middle mb-0">
          <thead class="table-light text-center text-uppercase small">
            <tr>
              <th>Name</th>
              <th>Sector</th>
              <th>Start Link</th>
              <th>QR</th>
              <th>API Calls</th>
              <th>Last Scan</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @partners.each do |partner| %>
              <tr class="small">
                <td>
                  <div class="d-flex align-items-center">
                    <% if partner.logo.attached? %>
                      <%= image_tag partner.logo.variant(resize_to_limit: [32, 32]).processed,
                                    class: "rounded-circle me-2 shadow-sm", width: 32, height: 32 %>
                    <% else %>
                      <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-2"
                           style="width:32px;height:32px;">
                        <i class="ri-building-line text-muted"></i>
                      </div>
                    <% end %>
                    <%= link_to partner.name, admin_partner_path(partner.uuid),
                                class: "text-decoration-none text-primary fw-semibold" %>
                  </div>
                </td>

                <td class="text-center">
                  <span class="badge bg-secondary-subtle text-dark rounded-pill px-3">
                    <%= partner.sector&.titleize || "—" %>
                  </span>
                </td>

                <td class="text-center text-nowrap">
                  <code class="text-muted small">/start?partner=<%= partner.slug %></code>
                  <button class="btn btn-sm btn-outline-secondary ms-1 border-0"
                          onclick="copyToClipboard('<%= partner.slug %>')"
                          data-bs-toggle="tooltip" title="Copy link">
                  </button>
                </td>

                <td class="text-center">
                  <% if (qr = partner.qr_code_data_url(200, 4)).present? %>
                    <%= image_tag qr, width: 36, class: "rounded shadow-sm" %>
                  <% else %>
                    <span class="text-muted small">—</span>
                  <% end %>
                </td>

                <td class="text-center fw-bold text-primary">
                  <%= number_with_delimiter(partner.api_access_logs.count) %>
                </td>

                <td class="text-center text-muted small text-nowrap">
                  <%= partner.last_scan_at&.strftime("%b %d, %Y %H:%M") || "—" %>
                </td>

               <td class="text-center">
                <% status_label, status_color =
                  case partner.status
                  when "approved"  then ["Approved",  "bg-success"]
                  when "rejected"  then ["Rejected",  "bg-danger"]
                  when "suspended" then ["Suspended", "bg-secondary"]
                  else                  ["Pending Review", "bg-warning text-dark"]
                  end
                %>
                <span class="badge <%= status_color %> rounded-pill px-3">
                  <%= status_label %>
                </span>
              </td>


                <td class="text-center">
                  <%= link_to admin_partner_path(partner.uuid),
                              class: "btn btn-sm btn-primary rounded-pill" do %>
                    View
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Pagination - Works with your current Kaminari setup -->
      <div class="mt-4 text-center">
        <%= paginate @partners %>
      </div>

    <% else %>
      <div class="text-center text-muted py-5 mt-5">
        <i class="ri-user-search-line display-4 mb-3 opacity-50"></i>
        <h5>No partners found</h5>
        <p class="mb-0">Try adjusting your filters or search term.</p>
      </div>
    <% end %>

  </div>
</section>

<!-- Copy to Clipboard + Tooltips -->
<script>
  function copyToClipboard(slug) {
    const url = `${window.location.origin}/start?partner=${slug}`;
    navigator.clipboard.writeText(url).then(() => {
      const toast = document.createElement("div");
      toast.textContent = "Link copied!";
      toast.className = "position-fixed bottom-0 end-0 m-4 p-3 bg-primary text-white rounded-pill shadow-lg";
      toast.style.zIndex = "9999";
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 2000);
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
    tooltipTriggerList.forEach(el => new bootstrap.Tooltip(el));
  });
</script>