<!-- app/views/partners/new.html.erb -->
<section class="container py-5" role="main">
  <div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
      <div class="card shadow-sm rounded-4 border-0 p-4">
        <h1 class="h4 fw-bold text-primary mb-4">
          <i class="ri-building-line me-2"></i> Partner Onboarding
        </h1>

        <%= simple_form_for @partner, url: partners_path, html: { class: "needs-validation", novalidate: true } do |f| %>
          <%= render partial: "partner_portal/shared/components/minimal_form", locals: { f: f } %>

          <div class="d-flex justify-content-end mt-4">
            <%= f.button :submit, "Submit Application", class: "btn btn-primary rounded-pill px-4" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
