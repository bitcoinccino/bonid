<h1 class="mb-4">Partner Access Logs</h1>

<div class="mb-3 d-flex gap-2 flex-wrap align-items-end">
  <%= form_with url: admin_partner_access_logs_path, method: :get, local: true, class: "d-flex gap-2 flex-wrap" do |f| %>
    <div>
      <%= f.label :partner_id, "Partner", class: "form-label small fw-semibold" %>
      <%= f.select :partner_id, options_from_collection_for_select(Partner.all, :id, :name, params[:partner_id]), { include_blank: "All" }, class: "form-select form-select-sm" %>
    </div>

    <div>
      <%= f.label :sector, "Sector", class: "form-label small fw-semibold" %>
      <%= f.text_field :sector, value: params[:sector], placeholder: "All", class: "form-control form-control-sm" %>
    </div>

    <div class="align-self-end">
      <%= f.submit "Filter", class: "btn btn-sm btn-primary" %>
    </div>
  <% end %>

  <!-- CSV Export Button -->
  <div class="align-self-end">
    <%= link_to "Export CSV", admin_partner_access_logs_path(request.params.merge(format: :csv)), class: "btn btn-sm btn-outline-success" %>
  </div>
</div>

<div class="table-responsive">
  <table class="table table-hover table-bordered align-middle">
    <thead class="table-light">
      <tr>
        <th>ID</th>
        <th>Partner</th>
        <th>Admin User</th>
        <th>Sector</th>
        <th>Action</th>
        <th>Metadata</th>
        <th>Created At</th>
      </tr>
    </thead>
    <tbody>
      <% @logs.each do |log| %>
        <tr>
          <td><%= log.id %></td>
          <td><%= log.partner&.name %></td>
          <td><%= log.admin_user&.email %></td>
          <td><%= log.metadata["sector"] %></td>
          <td><%= log.action %></td>
          <td>
            <pre class="small mb-0"><%= JSON.pretty_generate(log.metadata || {}) %></pre>
          </td>
          <td><%= log.created_at.strftime("%b %d, %Y %H:%M") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="d-flex justify-content-center mt-3">
  <%= paginate @logs %>
</div>
