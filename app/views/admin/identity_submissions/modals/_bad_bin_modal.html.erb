<div class="modal fade" id="badBinModal" tabindex="-1" aria-labelledby="badBinModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-3 bg-white">
      <%= form_with url: reject_bin_admin_identity_submission_path(submission.uuid),
                    method: :patch,
                    data: { turbo_frame: "modal-body" },
                    local: true do |form| %>
        <div class="modal-header gradient-bg text-white">
          <h5 class="modal-title" id="badBinModalLabel">
            <i class="ri-delete-bin-line me-2"></i> Move to BadBin
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body" id="modal-body">
          <% if flash[:alert].present? %>
            <div class="alert alert-dismissible fade show alert-danger"><%= flash[:alert] %></div>
          <% end %>

          <p class="text-muted small mb-3">
            Moving this submission to <strong>BadBin</strong> will stage it for rejection. 
            Please select a reason below.
          </p>

          <%= form.label :rejection_reason, "Reason for BadBin", class: "form-label fw-bold mb-2" %>
          <%= form.select :rejection_reason,
                          IdentitySubmission.rejection_reasons_options,
                          { prompt: "Select a reason" },
                          class: "form-select rounded-pill py-2",
                          required: true %>

          <div class="mt-3">
            <%= form.label :other_reason, "Additional Details (optional)", class: "form-label mb-2" %>
            <%= form.text_area :other_reason,
                               rows: 3,
                               class: "form-control rounded-3",
                               placeholder: "Provide more context if needed" %>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
          <%= form.submit "Move to BadBin", class: "btn btn-danger rounded-pill" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
