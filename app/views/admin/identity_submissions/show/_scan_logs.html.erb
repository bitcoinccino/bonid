<!-- app/views/admin/identity_submissions/show/_scan_logs.html.erb -->

<section class="certificate-font py-3" role="region">
  <div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h6 class="fw-bold text-primary mb-1 d-flex align-items-center gap-2">
          <i class="ri-scan-line"></i> QR Scan Logs
        </h6>
        <p class="text-muted small mb-0">
          This section lists every time the citizen’s BonID QR code was scanned — 
          including the scanning partner, officer, device, and approximate location.
          These logs are vital for transparency, security audits, and misuse detection.
        </p>
      </div>

      <% if @qr_scan_logs.any? %>
        <%= link_to admin_qr_scan_logs_path(format: :csv, submission_id: @submission.id),
            class: "btn btn-outline-primary btn-sm d-flex align-items-center gap-1" do %>
          <i class="ri-download-line"></i> Export CSV
        <% end %>
      <% end %>
    </div>

    <!-- Scan Logs Table -->
    <% if @qr_scan_logs.any? %>
      <div class="table-responsive rounded-3 shadow-sm border">
        <table class="table table-sm table-hover align-middle mb-0">
          <thead class="table-primary text-center">
            <tr>
              <th>Date</th>
              <th>Partner</th>
              <th>Officer</th>
              <th>IP Address</th>
              <th>Location / Network</th>
              <th>Device</th>
              <th>Result</th>
            </tr>
          </thead>

          <tbody>
            <% @qr_scan_logs.each do |scan| %>
              <tr>
                <!-- Date -->
                <td class="small text-nowrap text-muted text-center">
                  <%= scan.scanned_at&.strftime("%b %d, %Y %I:%M %p") ||
                      scan.created_at&.strftime("%b %d, %Y %I:%M %p") || "—" %>
                </td>

                <!-- Partner -->
                <td class="small text-center">
                  <%= scan.partner&.name.presence || "Public" %>
                  <% if scan.partner&.verified_at.present? %>
                    <i class="ri-shield-check-line text-success ms-1" title="Verified Partner"></i>
                  <% end %>
                </td>

                <!-- Officer -->
                <td class="small text-center">
                  <% if scan.officer&.email.present? %>
                    <span class="text-dark"><%= scan.officer.email %></span>
                  <% elsif scan.officer_name.present? %>
                    <span class="text-muted"><%= scan.officer_name %></span>
                  <% else %>
                    <span class="text-muted">—</span>
                  <% end %>
                </td>

                <!-- IP -->
                <td class="small text-center">
                  <code><%= scan.ip_address.presence || "N/A" %></code>
                </td>

                <!-- Location / Network -->
                <td class="small text-start">
                  <% location_str = [scan.city, scan.region, scan.country].compact.join(", ") %>
                  <% org_str = scan.organization.presence %>
                  <% if location_str.present? || org_str.present? %>
                    <div><%= location_str.presence || "N/A" %></div>
                    <% if org_str %>
                      <div class="text-muted small fst-italic">
                        <i class="ri-building-line me-1"></i><%= org_str %>
                      </div>
                    <% end %>
                  <% else %>
                    <span class="text-muted">N/A</span>
                  <% end %>
                </td>

                <!-- Device -->
                <td class="small text-muted">
                  <%= truncate(scan.user_agent.to_s, length: 50) %>
                </td>

                <!-- Result -->
                <td class="small text-center">
                  <% if scan.respond_to?(:success?) && scan.success? %>
                    <span class="badge bg-success-subtle text-success">
                      <i class="ri-checkbox-circle-line me-1"></i>Success
                    </span>
                  <% else %>
                    <span class="badge bg-danger-subtle text-danger">
                      <i class="ri-close-circle-line me-1"></i>Failed
                    </span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @submission.qr_scan_logs.count > @qr_scan_logs.size %>
        <p class="small text-muted mt-2">
          Showing <%= @qr_scan_logs.size %> of <%= @submission.qr_scan_logs.count %> total scans.
        </p>
      <% end %>
    <% else %>
      <!-- Empty State -->
      <div class="card border-0 bg-light text-center py-5 mt-4 shadow-sm">
        <i class="ri-information-line display-5 text-secondary"></i>
        <p class="mt-3 mb-1 fw-semibold text-dark">No scans recorded yet</p>
        <p class="text-muted small mb-0">
          This BonID QR code has not been scanned by any partner or officer so far.
          Once a scan occurs, detailed logs will appear here for transparency.
        </p>
      </div>
    <% end %>
  </div>
</section>
