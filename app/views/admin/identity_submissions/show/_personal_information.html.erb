<!-- app/views/admin/identity_submissions/show/_personal_information.html.erb -->

<section class="mb-4">
  <div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="h5 text-primary fw-semibold d-flex align-items-center gap-2 mb-0">
      <i class="ri-user-3-line"></i> Personal Information
    </h2>
  </div>

  <div class="card border-0 rounded-4 shadow-sm p-4 bg-white">
    <% user = submission.user %>

    <p class="text-muted small mb-4">
      This section provides the citizen’s core demographic and identification details, including  
      birth information, government-issued ID, and verified contact information used for BonID validation.
    </p>

    <div class="row g-4">
      <!-- Identity & Contact -->
      <div class="col-md-6">
        <strong>Full Name:</strong><br>
        <span><%= [user.first_name, user.middle_name, user.last_name].compact.join(" ") %></span>
        <br><small class="text-muted">As registered in official identity documents</small>
      </div>

      <div class="col-md-6">
        <strong>BonID:</strong><br>
        <span class="fw-semibold text-haitian-blue"><%= user.bonid || "N/A" %></span>
        <br><small class="text-muted">Unique digital identifier assigned upon verification</small>
      </div>

      <div class="col-md-6">
        <strong>Email:</strong><br>
        <span><%= user.email %></span>
        <br><small class="text-muted">Used for account access and notifications</small>
      </div>

      <div class="col-md-6">
        <strong>Phone:</strong><br>
        <span><%= user.phone.presence || "N/A" %></span>
        <br><small class="text-muted">Primary contact number linked to this profile</small>
      </div>

      <!-- Demographics -->
      <div class="col-md-6">
        <strong>Sex:</strong><br>
        <span><%= user.sex&.upcase || "N/A" %></span>
        <br><small class="text-muted">Declared gender identity</small>
      </div>

      <div class="col-md-6">
        <strong>Date of Birth:</strong><br>
        <span><%= user.dob&.strftime("%b %d, %Y") || "N/A" %></span>
        <br><small class="text-muted">Used for age verification and demographic records</small>
      </div>

      <div class="col-md-6">
        <strong>Marital Status:</strong><br>
        <span><%= user.marital_status&.titleize || "N/A" %></span>
        <br><small class="text-muted">As declared by the citizen during profile creation</small>
      </div>

      <!-- Country of Residence -->
      <div class="col-md-6">
        <strong>Country of Residence:</strong><br>
        <% cor = @identity_submission&.country_of_residence || "HT" %>
        <% country_name = ISO3166::Country[cor]&.translations&.dig("en") || cor %>
        <span><%= country_name %></span>
        <% if cor != "HT" %>
          <span class="badge bg-info text-white ms-1" style="font-size: 0.7rem;">Diaspora</span>
          <% if @identity_submission&.host_country_id_type.present? %>
            <br><small class="text-muted">Host ID: <%= @identity_submission.host_country_id_type %></small>
          <% end %>
        <% end %>
        <% geo = @identity_submission&.metadata&.dig("geo") %>
        <% if geo.present? %>
          <br><small class="<%= geo["match"] ? 'text-success' : 'text-warning' %>">
            <i class="ri-map-pin-line me-1"></i>
            IP: <%= geo["country_from_ip"] || "Unknown" %>
            <%= geo["match"] ? "✓ Match" : "⚠ Mismatch" %>
          </small>
        <% end %>
      </div>

      <!-- Identification Details -->
      <div class="col-md-6">
        <strong>ID Type:</strong><br>
        <span><%= user.id_type&.upcase || "N/A" %></span>
        <br><small class="text-muted">Document type (CIN or Passport)</small>
      </div>

      <div class="col-md-6">
        <strong>ID Number:</strong><br>
        <span class="fw-medium font-monospace"><%= user.id_number.presence || "N/A" %></span>
        <% if user.id_number.present? && user.id_type&.to_s == "cin" %>
          <span class="badge bg-info text-white ms-1" style="font-size: 0.7rem;">
            <%= CinNumberValidator.format_label(user.id_number) %>
          </span>
        <% end %>
        <br><small class="text-muted">Official ID or Passport number provided</small>
        <% if @identity_submission&.document_number.present? && @identity_submission.document_number != user.id_number %>
          <br><small class="text-warning"><i class="ri-alert-line"></i> Submission: <%= @identity_submission.document_number %></small>
        <% end %>
      </div>

      <div class="col-md-6">
        <strong>Issue Date:</strong><br>
        <span><%= user.id_issued_on&.strftime("%b %d, %Y") || "N/A" %></span>
        <br><small class="text-muted">Date the ID document was issued</small>
      </div>

      <div class="col-md-6">
        <strong>Expiration Date:</strong><br>
        <span><%= user.id_expires_on&.strftime("%b %d, %Y") || "N/A" %></span>
        <% if user.id_expires_on.present? %>
          <% if user.id_expires_on < Date.current %>
            <span class="badge bg-danger ms-1" style="font-size: 0.7rem;">EKSPIRE</span>
          <% elsif user.id_expires_on < 6.months.from_now.to_date %>
            <span class="badge bg-warning text-dark ms-1" style="font-size: 0.7rem;">Ekspire byento</span>
          <% else %>
            <span class="badge bg-success ms-1" style="font-size: 0.7rem;">Valid</span>
          <% end %>
        <% end %>
        <br><small class="text-muted">Expiry date of the ID document</small>
      </div>

      <!-- Combined Issuer -->
      <div class="col-12">
        <strong>Issuing Authority / Document Issuer:</strong><br>
        <span class="text-dark fw-medium">
          <%= [user.issuing_authority, user.document_issuer].compact_blank.join(" — ").presence || "N/A" %>
        </span>
        <br><small class="text-muted">Institution responsible for issuing the identity document</small>
      </div>

      <!-- Place of Birth -->
      <div class="col-12">
        <strong>Place of Birth:</strong><br>
        <% if user.birth_commune_id || user.birth_department_id %>
          <span><%= [user.birth_commune&.name, user.birth_department&.name].compact.join(", ") %></span>
        <% else %>
          <span class="text-muted">N/A</span>
        <% end %>
        <br><small class="text-muted">Recorded as per birth certificate or ID</small>
      </div>

      <!-- Address -->
      <div class="col-12">
        <strong>Address:</strong><br>
        <% if user.address %>
          <div class="ps-3 border-start border-3 border-primary mt-1">
            <%= [user.address.communal_section&.name, user.address.street_address].compact.join("<br>").html_safe %><br>
            <%= [user.address.postal_code, user.address.commune&.name&.upcase].compact.join(", ") %><br>
            <%= user.address.country&.upcase %>
          </div>
          <small class="text-muted d-block mt-2">
            Verified geographic residence of the citizen
          </small>
        <% else %>
          <em class="text-muted">No address provided</em>
        <% end %>
      </div>
    </div>
  </div>
</section>

<%# ── OCR Cross-Check Results ── %>
<% ocr = @identity_submission&.metadata&.dig("ocr") %>
<% if ocr.present? %>
<section class="mt-4 p-3 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
  <h6 class="fw-bold mb-3" style="font-family: 'Montserrat', sans-serif; font-size: 0.85rem; color: #0F172A;">
    <i class="ri-scan-2-line me-1" style="color: #00209F;"></i>
    OCR Document Cross-Check
    <% if ocr["error"].present? %>
      <span class="badge bg-danger ms-2" style="font-size: 0.7rem;">Failed</span>
    <% elsif ocr["mismatch_count"].to_i > 0 %>
      <span class="badge bg-warning text-dark ms-2" style="font-size: 0.7rem;">
        <%= ocr["mismatch_count"] %> mismatch<%= ocr["mismatch_count"].to_i > 1 ? "es" : "" %>
      </span>
    <% else %>
      <span class="badge bg-success ms-2" style="font-size: 0.7rem;">All match</span>
    <% end %>
  </h6>

  <% if ocr["error"].present? %>
    <p class="text-danger small mb-0"><i class="ri-error-warning-line me-1"></i><%= ocr["error"] %></p>
  <% else %>
    <div class="table-responsive">
      <table class="table table-sm mb-0" style="font-size: 0.82rem;">
        <thead>
          <tr style="background: #f1f5f9;">
            <th style="width: 25%;">Field</th>
            <th style="width: 30%;">OCR (from document)</th>
            <th style="width: 30%;">Form (citizen entered)</th>
            <th style="width: 15%;">Status</th>
          </tr>
        </thead>
        <tbody>
          <% (ocr["cross_check"] || {}).each do |field, data| %>
            <tr>
              <td class="fw-medium"><%= field.humanize %></td>
              <td class="font-monospace"><%= data["ocr"].presence || "—" %></td>
              <td><%= data["form"].presence || "—" %></td>
              <td>
                <% if data["match"] %>
                  <span class="badge bg-success" style="font-size: 0.7rem;">
                    <i class="ri-check-line"></i> Match
                  </span>
                <% else %>
                  <span class="badge bg-danger" style="font-size: 0.7rem;">
                    <i class="ri-close-line"></i> Mismatch
                  </span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="mt-2 d-flex gap-3">
      <small class="text-muted">
        <i class="ri-robot-line me-1"></i>
        Confidence: <%= ocr["confidence"] ? "#{(ocr["confidence"].to_f * 100).round(1)}%" : "N/A" %>
      </small>
      <small class="text-muted">
        <i class="ri-time-line me-1"></i>
        Processed: <%= ocr["processed_at"] ? Time.parse(ocr["processed_at"]).strftime("%b %d, %Y %H:%M") : "N/A" %>
      </small>
      <small class="text-muted">
        <i class="ri-file-text-line me-1"></i>
        Document: <%= ocr["id_type"]&.upcase || "N/A" %>
      </small>
    </div>
  <% end %>
</section>
<% end %>
