<h4 class="text-primary text-center mb-4">Uploaded Documents</h4>
<div class="accordion accordion-flush mb-4" id="documentsAccordion">
  <% {
    "Primary Documents" => {
      "CIN Front" => :cin_front,
      "CIN Back" => :cin_back,
      "Passport" => :passport,
      "Selfie" => :selfie
    },
    "Secondary Documents" => {
      "Proof of Address" => :proof_of_address
    }
  }.each_with_index do |(group, docs), index| %>
    <div class="accordion-item border rounded-3 mb-3">
      <h2 class="accordion-header" id="heading_<%= index %>">
        <button class="accordion-button collapsed fw-semibold"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapse_<%= index %>"
                aria-expanded="false"
                aria-controls="collapse_<%= index %>">
          <i class="ri-file-list-line me-2"></i> <%= group %>
        </button>
      </h2>
      <div id="collapse_<%= index %>"
           class="accordion-collapse collapse"
           aria-labelledby="heading_<%= index %>"
           data-bs-parent="#documentsAccordion">
        <div class="accordion-body p-4">
          <div class="row g-3">
            <% docs.each do |label, field| %>
              <% if submission.send(field).attached? %>
                <% modal_id = "#{field}_Modal" %>
                <div class="col-md-6 col-12">
                  <div class="card h-100 shadow-sm rounded-3 border-0 document-card bg-white">
                    <div class="card-body text-center p-3">
                      <% file = submission.send(field) %>
                      <div class="mb-2">
                        <% if file.content_type.start_with?("image/") %>
                          <%= image_tag file.variant(resize_to_limit: [120, 120]),
                                        class: "img-fluid rounded shadow-sm",
                                        alt: "#{label} preview" %>
                        <% else %>
                          <i class="ri-file-pdf-2-line fs-1 text-muted"></i>
                        <% end %>
                      </div>
                      <button type="button"
                              class="btn btn-outline-primary rounded-3 w-100 document-label"
                              data-bs-toggle="modal"
                              data-bs-target="#<%= modal_id %>">
                        <%= label %>
                      </button>
                    </div>
                  </div>
                  <%= render partial: "admin/identity_submissions/modals/document_modal",
                             locals: { submission: submission, field: field, label: label, modal_id: modal_id } %>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
