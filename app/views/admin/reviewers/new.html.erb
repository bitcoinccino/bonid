<div class="container py-5" style="max-width: 600px;">
  <h2 class="fw-bold mb-4">Invite Reviewer</h2>

  <div class="card p-4 shadow-sm">
    <%= form_with url: send_invite_admin_reviewers_path, method: :post, local: true do |f| %>

      <div class="mb-3">
        <%= f.label :email, "Reviewer Email", class: "form-label fw-semibold" %>
        <%= f.email_field :email, class: "form-control", required: true %>
      </div>

      <%= f.submit "Send Invite", class: "btn btn-primary" %>
      <%= link_to "Cancel", admin_reviewers_path, class: "btn btn-outline-secondary ms-2" %>

    <% end %>
  </div>
</div>
