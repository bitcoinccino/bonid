<section class="certificate-font py-3" role="region">
  <div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h6 class="fw-bold text-primary mb-1">
          <i class="ri-scan-line me-2"></i> QR Scan Logs
        </h6>
        <p class="text-muted small mb-0">
          Records of when, where, and by whom this BonID QR code was scanned —
          useful for verifying access history and detecting suspicious activity.
        </p>
      </div>
      <% if @qr_scan_logs.any? %>
        <%= link_to "Export CSV",
                    admin_qr_scans_path(format: :csv, submission_id: @submission.id),
                    class: "btn btn-outline-primary btn-sm" %>
      <% end %>
    </div>

    <!-- Scan Logs Table -->
    <% if @qr_scan_logs.any? %>
      <div class="table-responsive rounded-3 shadow-sm">
        <table class="table table-bordered table-hover table-sm align-middle mb-0">
          <thead class="table-light text-center">
            <tr>
              <th>Date</th>
              <th>Partner</th>
              <th>Officer</th>
              <th>IP Address</th>
              <th>Location</th>
              <th>Device</th>
              <th>Result</th>
            </tr>
          </thead>
          <tbody>
            <% @qr_scan_logs.each do |log| %>
              <tr>
                <!-- Date -->
                <td class="small text-nowrap text-muted text-center">
                  <%= log.scanned_at&.strftime("%b %d, %Y %I:%M %p") ||
                      log.created_at&.strftime("%b %d, %Y %I:%M %p") || "—" %>
                </td>

                <!-- Partner -->
                <td class="small text-center"><%= log.partner_name %></td>

                <!-- Officer -->
                <td class="small text-center"><%= log.officer_name %></td>

                <!-- IP -->
                <td class="small text-center"><%= log.ip_address.presence || "N/A" %></td>

                <!-- Location -->
                <td class="small">
                  <%= [log.city, log.region, log.country].compact.join(", ").presence || "N/A" %>
                </td>

                <!-- Device -->
                <td class="small"><%= truncate(log.user_agent.to_s, length: 50) %></td>

                <!-- Result -->
                <td class="small text-center">
                  <% if log.respond_to?(:success?) && log.success? %>
                    <span class="badge bg-success">Success</span>
                  <% else %>
                    <span class="badge bg-danger">Failed</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @submission.qr_scan_logs.count > @qr_scan_logs.size %>
        <p class="small text-muted mt-2">
          Showing <%= @qr_scan_logs.size %> of <%= @submission.qr_scan_logs.count %> total scans.
        </p>
      <% end %>
    <% else %>
      <!-- Empty State -->
      <div class="text-center text-muted mt-4">
        <i class="ri-information-line display-5"></i>
        <p class="mt-3">No scans recorded for this BonID yet.</p>
      </div>
    <% end %>
  </div>
</section>
