<!-- app/views/admin/partner_audit_logs/index.html.erb -->
<h3>Partner Audit Logs</h3>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Time</th>
      <th>Partner</th>
      <th>Event</th>
      <th>Admin</th>
      <th>Sector</th>
      <th>Details</th>
    </tr>
  </thead>
  <tbody>
    <% @logs.each do |log| %>
      <tr>
        <td><%= log.created_at.strftime("%Y-%m-%d %H:%M") %></td>
        <td><%= log.partner.name %></td>
        <td><%= log.event.capitalize %></td>
        <td><%= log.admin_user&.email || "System" %></td>
        <td><%= log.metadata["sector"] %></td>
        <td><%= log.details.presence || "—" %></td>
      </tr>
    <% end %>
  </tbody>
</table>
