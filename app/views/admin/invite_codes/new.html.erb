<section class="certificate-font py-5" role="main">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-6">
        <h2 class="h4 fw-bold text-primary mb-4">
          <i class="ri-key-2-line me-2"></i> New Invite Code
        </h2>

        <%= form_with model: [:admin, @code], class: "card border-0 shadow-sm" do |f| %>
          <div class="card-body">
            <% if @code.errors.any? %>
              <div class="alert alert-danger">
                <% @code.errors.full_messages.each do |msg| %>
                  <div><%= msg %></div>
                <% end %>
              </div>
            <% end %>

            <div class="mb-3">
              <label class="form-label fw-semibold">Type</label>
              <%= f.select :code_type,
                    options_for_select([["Community", "community"], ["Partner", "partner"], ["Personal", "personal"], ["Referral", "referral"]], @code.code_type),
                    {}, class: "form-select" %>
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold">Commune</label>
              <%= f.select :commune_id,
                    options_for_select([["None (Global)", ""]] + @communes.map { |c| [c.name, c.id] }, @code.commune_id),
                    {}, class: "form-select" %>
              <small class="text-muted">Determines the XX in BONID-XX-XXXX</small>
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold">Max Uses</label>
              <%= f.number_field :max_uses, class: "form-control", min: 1 %>
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold">Expires At</label>
              <%= f.datetime_local_field :expires_at, class: "form-control" %>
              <small class="text-muted">Leave blank for no expiration</small>
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold">Note</label>
              <%= f.text_field :note, class: "form-control", placeholder: "Optional internal note..." %>
            </div>

            <div class="d-flex gap-2">
              <%= f.submit "Create Code", class: "btn btn-primary" %>
              <%= link_to "Cancel", admin_invite_codes_path, class: "btn btn-outline-secondary" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
