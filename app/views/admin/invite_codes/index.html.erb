<section class="certificate-font py-5" role="main">
  <div class="container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="h4 fw-bold text-primary mb-1">
          <i class="ri-key-2-line me-2"></i> Invite Codes
        </h2>
        <p class="text-muted small mb-0">
          Generate and manage invite codes per commune. Format: BONID-XX-XXXX
        </p>
      </div>
      <div class="d-flex gap-2">
        <%= link_to admin_invite_codes_path(format: :csv), class: "btn btn-outline-primary btn-sm" do %>
          <i class="ri-download-line me-1"></i> Export
        <% end %>
        <%= link_to new_admin_invite_code_path, class: "btn btn-primary btn-sm" do %>
          <i class="ri-add-line me-1"></i> New Code
        <% end %>
      </div>
    </div>

    <!-- Stats -->
    <div class="row g-3 mb-4">
      <div class="col-4">
        <div class="card border-0 shadow-sm text-center p-3">
          <div class="h3 fw-bold text-primary mb-0"><%= @total %></div>
          <div class="text-muted small">Total Codes</div>
        </div>
      </div>
      <div class="col-4">
        <div class="card border-0 shadow-sm text-center p-3">
          <div class="h3 fw-bold text-success mb-0"><%= @active_count %></div>
          <div class="text-muted small">Active</div>
        </div>
      </div>
      <div class="col-4">
        <div class="card border-0 shadow-sm text-center p-3">
          <div class="h3 fw-bold text-info mb-0"><%= @total_uses %></div>
          <div class="text-muted small">Total Uses</div>
        </div>
      </div>
    </div>

    <!-- Bulk Generate -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body">
        <h6 class="fw-bold mb-3"><i class="ri-stack-line me-1"></i> Bulk Generate</h6>
        <%= form_with url: bulk_generate_admin_invite_codes_path, method: :post, class: "row g-3 align-items-end" do |f| %>
          <div class="col-md-2">
            <label class="form-label small fw-semibold">Department</label>
            <select class="form-select form-select-sm" id="bulk-dept" onchange="loadBulkCommunes(this.value)">
              <option value="">Choose Dept</option>
              <% @departments.each do |d| %>
                <option value="<%= d.id %>"><%= d.name %></option>
              <% end %>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label small fw-semibold">Commune</label>
            <%= f.select :commune_id, [["Choose Commune", ""]], {}, class: "form-select form-select-sm", id: "bulk-commune", disabled: true %>
          </div>
          <div class="col-md-2">
            <label class="form-label small fw-semibold">Count</label>
            <%= f.number_field :count, value: 10, min: 1, max: 100, class: "form-control form-control-sm" %>
          </div>
          <div class="col-md-2">
            <label class="form-label small fw-semibold">Max Uses Each</label>
            <%= f.number_field :max_uses, value: 1, min: 1, class: "form-control form-control-sm" %>
          </div>
          <div class="col-md-2">
            <label class="form-label small fw-semibold">Expires In (Days)</label>
            <%= f.number_field :expires_in, value: 30, min: 1, class: "form-control form-control-sm" %>
          </div>
          <div class="col-md-2">
            <%= f.submit "Generate", class: "btn btn-primary btn-sm w-100" %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Filters -->
    <%= form_with url: admin_invite_codes_path, method: :get, class: "mb-4" do |f| %>
      <div class="row g-3">
        <div class="col-md-3">
          <%= f.text_field :search,
                value: params[:search],
                placeholder: "Search by code...",
                class: "form-control form-control-sm" %>
        </div>
        <div class="col-md-2">
          <select class="form-select form-select-sm" id="filter-dept" onchange="loadFilterCommunes(this.value)">
            <option value="">All Depts</option>
            <% @departments.each do |d| %>
              <option value="<%= d.id %>" <%= 'selected' if params[:department_id] == d.id.to_s %>><%= d.name %></option>
            <% end %>
          </select>
        </div>
        <div class="col-md-2">
          <%= f.select :commune_id,
                options_for_select([["All Communes", ""]] + @communes.map { |c| [c.name, c.id] }, params[:commune_id]),
                {}, class: "form-select form-select-sm", id: "filter-commune", onchange: "this.form.submit()" %>
        </div>
        <div class="col-md-1">
          <%= f.select :active,
                options_for_select([["All Status", ""], ["Active", "1"], ["Inactive", "0"]], params[:active]),
                {}, class: "form-select form-select-sm", onchange: "this.form.submit()" %>
        </div>
        <div class="col-md-2">
          <%= f.select :type,
                options_for_select([["All Types", ""], ["Community", "community"], ["Partner", "partner"], ["Personal", "personal"], ["Referral", "referral"]], params[:type]),
                {}, class: "form-select form-select-sm", onchange: "this.form.submit()" %>
        </div>
        <div class="col-md-2">
          <%= f.submit "Filter", class: "btn btn-primary btn-sm w-100" %>
          <% if params[:search].present? || params[:commune_id].present? || params[:active].present? || params[:type].present? %>
            <%= link_to "Clear", admin_invite_codes_path, class: "btn btn-outline-secondary btn-sm w-100 mt-1" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Table -->
    <div class="table-responsive rounded-3 shadow-sm">
      <table class="table table-bordered table-hover table-sm align-middle mb-0">
        <thead class="table-light text-center">
          <tr>
            <th>Code</th>
            <th>Type</th>
            <th>Commune</th>
            <th>Uses</th>
            <th>Status</th>
            <th>Expires</th>
            <th>Created</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @codes.each do |code| %>
            <tr class="<%= 'table-secondary' unless code.active? %>">
              <td>
                <code class="fw-bold"><%= code.code %></code>
                <% if code.note.present? %>
                  <br><small class="text-muted"><%= code.note %></small>
                <% end %>
              </td>
              <td class="text-center">
                <span class="badge bg-secondary-subtle text-secondary"><%= code.code_type.capitalize %></span>
              </td>
              <td>
                <% if code.commune %>
                  <%= code.commune.name %>
                <% else %>
                  <span class="text-muted">Global</span>
                <% end %>
              </td>
              <td class="text-center">
                <strong><%= code.uses_count %></strong> / <%= code.max_uses || "unlimited" %>
                <% if code.exhausted? %>
                  <br><span class="badge bg-danger-subtle text-danger small">Exhausted</span>
                <% end %>
              </td>
              <td class="text-center">
                <% if code.active? %>
                  <span class="badge bg-success">Active</span>
                <% else %>
                  <span class="badge bg-secondary">Inactive</span>
                <% end %>
              </td>
              <td class="text-center small">
                <% if code.expires_at %>
                  <% if code.expired? %>
                    <span class="text-danger"><%= code.expires_at.strftime("%b %d, %Y") %></span>
                  <% else %>
                    <%= code.expires_at.strftime("%b %d, %Y") %>
                  <% end %>
                <% else %>
                  <span class="text-muted">Never</span>
                <% end %>
              </td>
              <td class="text-center small">
                <%= code.created_at.strftime("%b %d, %Y") %>
              </td>
              <td class="text-center">
                <div class="d-flex gap-1 justify-content-center">
                  <%= button_to code.active? ? "Deactivate" : "Activate",
                        toggle_active_admin_invite_code_path(code),
                        method: :post,
                        class: code.active? ? "btn btn-sm btn-outline-warning" : "btn btn-sm btn-outline-success" %>
                  <% if code.uses_count == 0 %>
                    <%= button_to admin_invite_code_path(code),
                          method: :delete,
                          class: "btn btn-sm btn-outline-danger",
                          data: { turbo_confirm: "Delete #{code.code}? This cannot be undone." } do %>
                      <i class="ri-delete-bin-line"></i>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="mt-3">
      <%= paginate @codes if @codes.respond_to?(:total_pages) %>
    </div>
  </div>
</section>

<script>
  var communesUrl = '<%= communes_admin_waitlist_signups_path %>';

  function loadBulkCommunes(deptId) {
    var sel = document.getElementById('bulk-commune');
    sel.innerHTML = '<option value="">Choose Commune</option>';
    sel.disabled = true;
    if (!deptId) return;

    fetch(communesUrl + '?department_id=' + deptId)
      .then(function(r) { return r.json(); })
      .then(function(data) {
        data.forEach(function(c) {
          var opt = document.createElement('option');
          opt.value = c.id;
          opt.textContent = c.name;
          sel.appendChild(opt);
        });
        sel.disabled = false;
      });
  }

  function loadFilterCommunes(deptId) {
    var sel = document.getElementById('filter-commune');
    sel.innerHTML = '<option value="">All Communes</option>';
    if (!deptId) { sel.closest('form').submit(); return; }

    fetch(communesUrl + '?department_id=' + deptId)
      .then(function(r) { return r.json(); })
      .then(function(data) {
        data.forEach(function(c) {
          var opt = document.createElement('option');
          opt.value = c.id;
          opt.textContent = c.name;
          sel.appendChild(opt);
        });
      });
  }
</script>
