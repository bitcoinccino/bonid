<%= render "admin/shared/admin_topbar" %>

<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-1">Incident Analytics</h1>
      <p class="text-muted mb-0">Crime statistics and trends dashboard</p>
    </div>
    <div class="d-flex gap-2">
      <%= link_to admin_incident_analytics_path(period: "7d"), class: "btn btn-sm #{params[:period] == '7d' ? 'btn-primary' : 'btn-outline-secondary'}" do %>
        7 Days
      <% end %>
      <%= link_to admin_incident_analytics_path(period: "30d"), class: "btn btn-sm #{params[:period].nil? || params[:period] == '30d' ? 'btn-primary' : 'btn-outline-secondary'}" do %>
        30 Days
      <% end %>
      <%= link_to admin_incident_analytics_path(period: "90d"), class: "btn btn-sm #{params[:period] == '90d' ? 'btn-primary' : 'btn-outline-secondary'}" do %>
        90 Days
      <% end %>
      <%= link_to admin_incident_analytics_path(period: "1y"), class: "btn btn-sm #{params[:period] == '1y' ? 'btn-primary' : 'btn-outline-secondary'}" do %>
        1 Year
      <% end %>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="row g-4 mb-4">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="flex-shrink-0">
              <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                <i class="ri-file-list-3-line text-primary fs-4"></i>
              </div>
            </div>
            <div class="flex-grow-1 ms-3">
              <h6 class="text-muted mb-1">Total Incidents</h6>
              <h3 class="mb-0"><%= number_with_delimiter(@stats[:total_incidents]) %></h3>
              <% if @comparison[:change_percentage] != 0 %>
                <small class="<%= @comparison[:change_percentage] > 0 ? 'text-danger' : 'text-success' %>">
                  <i class="ri-arrow-<%= @comparison[:change_percentage] > 0 ? 'up' : 'down' %>-line"></i>
                  <%= @comparison[:change_percentage].abs %>% vs previous period
                </small>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="flex-shrink-0">
              <div class="bg-warning bg-opacity-10 rounded-3 p-3">
                <i class="ri-time-line text-warning fs-4"></i>
              </div>
            </div>
            <div class="flex-grow-1 ms-3">
              <h6 class="text-muted mb-1">Pending Review</h6>
              <h3 class="mb-0"><%= number_with_delimiter(@stats[:review_stats][:pending]) %></h3>
              <small class="text-muted">Awaiting action</small>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="flex-shrink-0">
              <div class="bg-success bg-opacity-10 rounded-3 p-3">
                <i class="ri-checkbox-circle-line text-success fs-4"></i>
              </div>
            </div>
            <div class="flex-grow-1 ms-3">
              <h6 class="text-muted mb-1">Approval Rate</h6>
              <h3 class="mb-0"><%= @stats[:review_stats][:approval_rate] %>%</h3>
              <small class="text-muted"><%= @stats[:review_stats][:total_reviewed] %> reviewed</small>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="flex-shrink-0">
              <div class="bg-info bg-opacity-10 rounded-3 p-3">
                <i class="ri-timer-line text-info fs-4"></i>
              </div>
            </div>
            <div class="flex-grow-1 ms-3">
              <h6 class="text-muted mb-1">Avg Review Time</h6>
              <h3 class="mb-0"><%= @stats[:review_stats][:avg_review_time_hours] || 'N/A' %></h3>
              <small class="text-muted">hours</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <!-- Trend Chart -->
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent border-0">
          <h5 class="mb-0">Incident Trend</h5>
        </div>
        <div class="card-body">
          <canvas id="trendChart" height="300"></canvas>
        </div>
      </div>
    </div>

    <!-- Status Breakdown -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent border-0">
          <h5 class="mb-0">By Status</h5>
        </div>
        <div class="card-body">
          <canvas id="statusChart" height="260"></canvas>
        </div>
      </div>
    </div>

    <!-- Top Crime Types -->
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
          <h5 class="mb-0">Top Crime Types</h5>
          <%= link_to "View All", admin_incident_analytics_crime_types_path, class: "btn btn-sm btn-outline-primary" %>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th>Crime Type</th>
                  <th class="text-end">Count</th>
                  <th class="text-end">%</th>
                </tr>
              </thead>
              <tbody>
                <% total = @stats[:top_crime_types].values.sum.to_f %>
                <% @stats[:top_crime_types].first(10).each do |type, count| %>
                  <tr>
                    <td><%= type %></td>
                    <td class="text-end"><%= number_with_delimiter(count) %></td>
                    <td class="text-end"><%= total > 0 ? (count / total * 100).round(1) : 0 %>%</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Hotspot Communes -->
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
          <h5 class="mb-0">Crime Hotspots</h5>
          <%= link_to "View All", admin_incident_analytics_hotspots_path, class: "btn btn-sm btn-outline-primary" %>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th>Commune</th>
                  <th class="text-end">Incidents</th>
                  <th class="text-end">%</th>
                </tr>
              </thead>
              <tbody>
                <% total = @stats[:hotspot_communes].values.sum.to_f %>
                <% @stats[:hotspot_communes].first(10).each do |commune, count| %>
                  <tr>
                    <td><%= commune %></td>
                    <td class="text-end"><%= number_with_delimiter(count) %></td>
                    <td class="text-end"><%= total > 0 ? (count / total * 100).round(1) : 0 %>%</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Top Officers -->
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
          <h5 class="mb-0">Top Reporting Officers</h5>
          <%= link_to "View All Metrics", admin_incident_analytics_officers_path, class: "btn btn-sm btn-outline-primary" %>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th>Officer</th>
                  <th>Unit</th>
                  <th class="text-end">Reports Submitted</th>
                </tr>
              </thead>
              <tbody>
                <% @stats[:officer_stats].first(10).each do |officer| %>
                  <tr>
                    <td><%= officer[:name] %></td>
                    <td><%= officer[:unit] || 'N/A' %></td>
                    <td class="text-end"><%= number_with_delimiter(officer[:count]) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Trend Chart
  const trendData = <%= raw @trend_data.to_json %>;
  const trendLabels = Object.keys(trendData).map(d => new Date(d).toLocaleDateString());
  const trendValues = Object.values(trendData);

  new Chart(document.getElementById('trendChart'), {
    type: 'line',
    data: {
      labels: trendLabels,
      datasets: [{
        label: 'Incidents',
        data: trendValues,
        borderColor: '#0d6efd',
        backgroundColor: 'rgba(13, 110, 253, 0.1)',
        fill: true,
        tension: 0.3
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false }
      },
      scales: {
        y: { beginAtZero: true }
      }
    }
  });

  // Status Chart
  const statusData = <%= raw @stats[:by_status].to_json %>;
  const statusColors = {
    'draft': '#6c757d',
    'submitted': '#ffc107',
    'under_review': '#17a2b8',
    'approved': '#28a745',
    'rejected': '#dc3545',
    'escalated': '#fd7e14',
    'archived': '#343a40'
  };

  new Chart(document.getElementById('statusChart'), {
    type: 'doughnut',
    data: {
      labels: Object.keys(statusData),
      datasets: [{
        data: Object.values(statusData),
        backgroundColor: Object.keys(statusData).map(s => statusColors[s] || '#6c757d')
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { position: 'bottom' }
      }
    }
  });
});
</script>
