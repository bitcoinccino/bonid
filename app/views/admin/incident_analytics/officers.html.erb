<%= render "admin/shared/admin_topbar" %>

<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
          <li class="breadcrumb-item"><%= link_to "Analytics", admin_incident_analytics_path %></li>
          <li class="breadcrumb-item active">Officer Metrics</li>
        </ol>
      </nav>
      <h1 class="h3 mb-0">Officer Performance Metrics</h1>
    </div>
    <div>
      <%= button_to "Regenerate Metrics", admin_incident_analytics_generate_officer_metrics_path,
          method: :post, class: "btn btn-primary" %>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Rank</th>
              <th>Officer</th>
              <th>Unit</th>
              <th class="text-end">Submitted</th>
              <th class="text-end">Approved</th>
              <th class="text-end">Rejected</th>
              <th class="text-end">Approval Rate</th>
              <th class="text-end">BonID Scans</th>
              <th>Top Crimes</th>
              <th>Period</th>
            </tr>
          </thead>
          <tbody>
            <% @officer_metrics.each_with_index do |metric, index| %>
              <tr>
                <td>
                  <span class="badge <%= index < 3 ? 'bg-success' : 'bg-secondary' %>">
                    #<%= index + 1 %>
                  </span>
                </td>
                <td>
                  <div class="d-flex align-items-center">
                    <div class="avatar avatar-sm me-2">
                      <span class="avatar-text rounded-circle bg-primary">
                        <%= metric.officer&.first_name&.first || '?' %><%= metric.officer&.last_name&.first || '' %>
                      </span>
                    </div>
                    <strong><%= metric.officer&.full_name || 'Unknown' %></strong>
                  </div>
                </td>
                <td><%= metric.officer&.unit_type || 'N/A' %></td>
                <td class="text-end fw-semibold"><%= metric.reports_submitted %></td>
                <td class="text-end text-success"><%= metric.reports_approved %></td>
                <td class="text-end text-danger"><%= metric.reports_rejected %></td>
                <td class="text-end">
                  <span class="badge bg-<%= metric.approval_rate >= 80 ? 'success' : metric.approval_rate >= 50 ? 'warning' : 'danger' %>">
                    <%= metric.approval_rate.round(1) %>%
                  </span>
                </td>
                <td class="text-end"><%= metric.bonid_scans %></td>
                <td>
                  <% if metric.crime_type_breakdown.present? %>
                    <% metric.crime_type_breakdown.sort_by { |_, v| -v }.first(2).each do |type, count| %>
                      <span class="badge bg-light text-dark me-1" title="<%= type %>">
                        <%= type.truncate(15) %>: <%= count %>
                      </span>
                    <% end %>
                  <% end %>
                </td>
                <td>
                  <small class="text-muted">
                    <%= metric.period_start.strftime("%b %d") %> - <%= metric.period_end.strftime("%b %d") %>
                  </small>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<style>
.avatar {
  width: 32px;
  height: 32px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.avatar-text {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  color: white;
}
</style>
