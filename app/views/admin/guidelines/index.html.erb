<div class="guidelines-wrapper d-flex align-items-center justify-content-center">
  <div class="card shadow border-0" style="max-width: 800px; border-radius: 12px; overflow: hidden;">
    <!-- Header -->
    <div class="card-header bg-haitian-blue text-white py-3 text-center">
      <h2 class="mb-0 fw-semibold d-flex justify-content-center align-items-center fs-5">
        <i class="ri-shield-user-line me-2" style="font-size: 1.25rem;"></i> 
        BonID Data Handling Guidelines
      </h2>
    </div>

    <!-- Body -->
    <div class="card-body p-4 p-md-5">
      <!-- Guidelines -->
      <div class="mb-5">
        <h4 class="text-haitian-blue fw-semibold mb-3 fs-5">BonID Protocol for Handling User Data</h4>
        <p class="text-muted mb-4 small">
          As an admin, you are required to follow these guidelines to ensure the security and privacy of user data in compliance with BonID’s protocol.
        </p>
        <ul class="list-group list-group-flush">
          <% @guidelines.each do |guideline| %>
            <li class="list-group-item d-flex align-items-start border-0 py-2">
              <i class="ri-checkbox-circle-fill text-haitian-blue me-3 mt-1" style="font-size: 1.1rem;" aria-hidden="true"></i>
              <span class="text-dark small"><%= guideline %></span>
            </li>
          <% end %>
        </ul>
      </div>

      <!-- Confirmation Form -->
      <%= form_with url: confirm_admin_guidelines_path, method: :post, local: true,
                    html: { class: "needs-validation", novalidate: true, data: { controller: "confirmation" } } do |f| %>
        <div class="form-check mb-4">
          <%= f.check_box :confirmed, id: "confirm_guidelines", class: "form-check-input", required: true,
                          data: { confirmation_target: "checkbox" }, aria_describedby: "confirm_guidelines_label" %>
          <%= f.label :confirmed, "I acknowledge and agree to follow the BonID data handling guidelines.",
                      id: "confirm_guidelines_label", class: "form-check-label ms-2 text-dark fw-medium small" %>
          <div class="invalid-feedback mt-1 small">
            You must confirm to proceed to the admin dashboard.
          </div>
        </div>

        <%= f.submit "Proceed to Dashboard",
                     class: "btn btn-haitian-blue btn-md rounded-pill fw-semibold w-100 w-md-auto px-4 py-2",
                     data: { action: "click->confirmation#validate" } %>
      <% end %>
    </div>
  </div>
</div>

<style>
  /* Full height flex center */
  .guidelines-wrapper {
    min-height: 100vh;
    background-color: #f0f4f9; /* subtle background */
    padding: 2rem 1rem;
  }

  /* Haitian Blue (#00209F) */
  .bg-haitian-blue {
    background-color: #00209F;
  }
  .text-haitian-blue {
    color: #00209F;
  }
  .btn-haitian-blue {
    background-color: #00209F;
    color: #ffffff;
    border: none;
    transition: background-color 0.3s ease;
  }
  .btn-haitian-blue:hover {
    background-color: #001a7d;
    color: #ffffff;
  }

  /* Form elements */
  .form-check-input:checked {
    background-color: #00209F;
    border-color: #00209F;
  }
  .form-check-input:focus {
    box-shadow: 0 0 0 0.25rem rgba(0, 32, 159, 0.25);
    border-color: #00209F;
  }

  @media (max-width: 576px) {
    .card-body { padding: 1.5rem; }
    h2 { font-size: 1.25rem; }
    h4 { font-size: 1rem; }
  }
</style>
