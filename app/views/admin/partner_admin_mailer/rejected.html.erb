<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />

    <style>
      @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@600&family=Inter:wght@400;500&display=swap');

      body {
        font-family: 'Inter', Arial, sans-serif;
        background-color: #f9fafb;
        margin: 0;
        padding: 0;
        color: #333333;
      }

      .container {
        max-width: 600px;
        margin: 20px auto;
        background: #ffffff;
        padding: 30px;
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
      }

      h2 {
        font-family: 'Montserrat', Arial, sans-serif;
        font-weight: 600;
        color: #E53E3E; /* Danger red */
        margin-bottom: 20px;
      }

      .reason-box {
        background: #fff5f5;
        border-left: 4px solid #E53E3E;
        padding: 12px 16px;
        margin: 20px 0;
        border-radius: 6px;
        font-size: 14px;
      }

      p {
        font-size: 15px;
        line-height: 1.6;
      }

      .footer {
        font-size: 12px;
        color: #666666;
        margin-top: 30px;
        border-top: 1px solid #eeeeee;
        padding-top: 10px;
        text-align: center;
      }

      @media only screen and (max-width: 480px) {
        .container { padding: 20px; }
      }
    </style>
  </head>

  <body>
    <div class="container">
      <h2>Your Partner Application Status</h2>

      <p>
        Hello <strong><%= @partner.contact_person.presence || @partner.name %></strong>,
      </p>

      <p>
        Thank you for applying to become a partner on <strong>BonID</strong>.
        After careful review, we are unable to approve your application at this time.
      </p>

      <% if @partner.rejection_reason.present? || @partner.rejection_comment.present? %>
        <div class="reason-box">
          <strong>Reason:</strong><br>
          <%= @partner.rejection_reason %><br>

          <% if @partner.rejection_comment.present? %>
            <em style="font-size: 13px; color: #555;">Additional details:</em><br>
            <%= @partner.rejection_comment %>
          <% end %>
        </div>
      <% end %>

      <p>
        You may update your information and reapply at any time.  
        If you believe this decision was made in error, please reply to this message with supporting details.
      </p>

      <div class="footer">
        This is an automated message from <strong>BonID</strong>.  
        For assistance, contact support at support@bonid.ht.
      </div>
    </div>
  </body>
</html>
