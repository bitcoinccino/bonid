<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />

    <style>
      @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@600&family=Inter:wght@400;500&display=swap');

      body {
        font-family: 'Inter', Arial, sans-serif;
        background-color: #f9fafb;
        margin: 0;
        padding: 0;
        color: #333333;
      }

      .container {
        max-width: 600px;
        margin: 20px auto;
        background: #ffffff;
        padding: 30px;
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
      }

      h2 {
        font-family: 'Montserrat', Arial, sans-serif;
        font-weight: 600;
        color: #00209F; /* Haitian Blue */
        margin-bottom: 20px;
      }

      p {
        font-size: 15px;
        line-height: 1.6;
      }

      .btn {
        display: inline-block;
        background-color: #00209F;
        color: #ffffff !important;
        text-decoration: none;
        padding: 12px 20px;
        border-radius: 6px;
        font-family: 'Montserrat', Arial, sans-serif;
        font-weight: 600;
        margin: 25px auto;
        text-align: center;
      }

      .footer {
        font-size: 12px;
        color: #666666;
        margin-top: 30px;
        border-top: 1px solid #eeeeee;
        padding-top: 10px;
        text-align: center;
      }

      /* Mobile */
      @media only screen and (max-width: 480px) {
        .container {
          padding: 20px;
        }
        .btn {
          width: 100% !important;
          display: block;
        }
      }
    </style>
  </head>

  <body>
    <div class="container">

      <!-- Partner Logo (optional) -->
      <div style="text-align: center; margin-bottom: 15px;">
        <% if @partner.logo.attached? %>
          <%= image_tag url_for(@partner.logo), 
                alt: "#{@partner.name} Logo",
                style: "max-height: 60px; margin-bottom: 15px;" %>
        <% end %>
      </div>

      <h2>Partner Admin Invitation</h2>

      <p>
        You’ve been invited to join <strong><%= @partner.name %></strong> as a Partner Admin on 
        <strong>BonID</strong>.
      </p>

      <p>
        Click below to accept your invitation and set up your account.
      </p>

      <!-- CTA Button -->
      <div style="text-align: center;">
        <a href="<%= @invite_url %>" class="btn">Accept Invitation</a>
      </div>

      <% if @oauth_secret_url.present? %>
      <div style="background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 6px; padding: 16px; margin: 20px 0;">
        <p style="font-weight: 600; margin-top: 0; color: #00209F;">OAuth API Credentials</p>
        <p style="font-size: 13px; margin-bottom: 8px;">
          Your OAuth credentials are available via a secure one-time link. This link can only be viewed once and expires in 72 hours.
        </p>
        <div style="text-align: center; margin: 16px 0;">
          <a href="<%= @oauth_secret_url %>" style="display: inline-block; background-color: #16a34a; color: #ffffff !important; text-decoration: none; padding: 10px 20px; border-radius: 6px; font-weight: 600; font-size: 14px;">
            View Credentials (One-Time)
          </a>
        </div>
        <p style="font-size: 12px; color: #dc2626; margin-bottom: 0;">
          This link will be destroyed after first viewing. Save the credentials immediately.
        </p>
      </div>
      <% end %>

      <p>If you did not request access, you can safely ignore this email.</p>

      <!-- Footer -->
      <div class="footer">
        This is an automated message from <strong>BonID</strong>.  
        Please do not reply to this email.
      </div>

    </div>
  </body>
</html>
