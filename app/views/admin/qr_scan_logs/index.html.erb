<!-- app/views/admin/qr_scan_logs/index.html.erb -->
<section class="certificate-font py-5" role="main">
  <div class="container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="h4 fw-bold text-primary mb-1">
          <i class="ri-qr-code-line me-2"></i> QR Scan Logs
        </h2>
        <p class="text-muted small mb-0">
          Records of when, where, and by whom BonID QR codes were scanned —
          useful for auditing access history and detecting suspicious activity.
        </p>
      </div>
      <div class="d-flex gap-2">
        <%= link_to "Export CSV",
                    admin_qr_scan_logs_path(format: :csv, **filter_params),
                    class: "btn btn-outline-primary btn-sm" %>
      </div>
    </div>

    <!-- Search and Filter -->
    <%= form_with url: admin_qr_scan_logs_path, method: :get, class: "mb-4" do |f| %>
      <div class="row g-3">
        <div class="col-md-4">
          <%= f.text_field :search,
                value: params[:search],
                placeholder: "Search by partner, officer, or user...",
                class: "form-control form-control-sm",
                aria_label: "Search scan logs" %>
        </div>
        <div class="col-md-3">
          <%= f.select :partner_id,
                options_for_select([["All Partners", ""]] + @partners.map { |p| [p.name, p.id] }, params[:partner_id]),
                {},
                class: "form-select form-select-sm",
                onchange: "this.form.submit()",
                aria_label: "Filter by partner" %>
        </div>
        <div class="col-md-3">
          <%= f.text_field :date_range,
                value: params[:date_range],
                placeholder: "YYYY-MM-DD - YYYY-MM-DD",
                class: "form-control form-control-sm date-range-picker",
                aria_label: "Filter by date range" %>
        </div>
        <div class="col-md-2">
          <%= f.submit "Filter", class: "btn btn-primary btn-sm w-100" %>
          <% if params[:search].present? || params[:partner_id].present? || params[:date_range].present? %>
            <%= link_to "Clear", admin_qr_scan_logs_path, class: "btn btn-outline-secondary btn-sm w-100 mt-1" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Scan Logs Table -->
    <div class="table-responsive rounded-3 shadow-sm">
      <table class="table table-bordered table-hover table-sm align-middle mb-0">
        <thead class="table-light text-center">
          <tr>
            <th>BonID</th>
            <th>Citizen</th>
            <th>Partner</th>
            <th>Officer</th>
            <th>IP Address</th>
            <th>Location</th>
            <th>Device</th>
            <th>Scanned At</th>
          </tr>
        </thead>
        <tbody>
          <% @qr_scan_logs.each do |log| %>
            <tr>
              <!-- BonID -->
              <td class="small text-center"><%= log.identity_submission&.bonid || "—" %></td>

              <!-- User -->
              <td class="small">
                <%= log.user&.full_name || "N/A" %><br>
                <small class="text-muted"><%= log.user&.email || "—" %></small>
              </td>

              <!-- Partner -->
             <!-- Partner -->
                        <!-- Partner -->
            <td class="small text-center">
              <%= log.partner&.name || " " %>
            </td>


              <!-- Officer -->
              <td class="small text-center"><%= log.officer_name %></td>

              <!-- IP -->
              <td class="small text-center"><%= log.ip_address.presence || "—" %></td>

              <!-- Location -->
              <td class="small">
                <%= [log.city, log.region, log.country].compact_blank.join(", ").presence || "N/A" %>
              </td>

              <!-- Device -->
              <td class="small"><%= truncate(log.user_agent.to_s, length: 60) %></td>

              <!-- Scanned At -->
              <td class="small text-nowrap text-center">
                <%= log.scanned_at&.strftime("%b %d, %Y %I:%M %p") ||
                    log.created_at&.strftime("%b %d, %Y %I:%M %p") || "—" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if @qr_scan_logs.present? %>
      <%= paginate @qr_scan_logs, theme: "bootstrap4" %>
      <p class="small text-muted mt-2 text-center">
        Showing <%= @qr_scan_logs.offset_value + 1 %> -
        <%= [@qr_scan_logs.offset_value + @qr_scan_logs.limit_value, @qr_scan_logs.total_count].min %>
        of <%= @qr_scan_logs.total_count %> results.
      </p>
    <% end %>

    <!-- Empty State -->
    <% if @qr_scan_logs.blank? %>
      <div class="text-center text-muted mt-5">
        <i class="ri-search-line display-4 mb-3"></i>
        <h5>No QR scan records found.</h5>
        <p class="mb-0">Try adjusting your search or filters above.</p>
      </div>
    <% end %>
  </div>
</section>
