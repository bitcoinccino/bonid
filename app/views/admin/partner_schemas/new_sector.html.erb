<div class="container mt-4">
  <h1 class="h3 fw-bold mb-3">New Schema</h1>

  <%= simple_form_for @schema, url: select_partners_admin_schemas_path, method: :get, html: { class: "needs-validation" } do |f| %>
    <div class="row">
      <div class="col-md-6">
        <%= f.input :sector, collection: Partner::SECTORS.keys,
                    label: "Choose a Sector", input_html: { class: "form-select" } %>
      </div>
    </div>

    <div class="mt-4">
      <%= f.button :submit, "Next: Select Partner", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
