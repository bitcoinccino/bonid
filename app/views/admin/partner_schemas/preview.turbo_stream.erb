app/views/admin/partner_schemas/preview.turbo_stream.erb
<turbo-stream target="schema-preview-frame" action="update">
  <template>
    <div class="card shadow-sm border-0">
      <div class="card-header bg-light">
        <h6 class="fw-bold">Generated VerificationRecord.data</h6>
      </div>
      <div class="card-body">
        <pre id="json-preview" class="bg-dark text-white p-3 rounded small"><%= JSON.pretty_generate(@record_json) %></pre>
        <button class="btn btn-outline-secondary btn-sm mt-2"
                onclick="navigator.clipboard.writeText(document.getElementById('json-preview').innerText)">
          Copy JSON
        </button>
      </div>
    </div>
  </template>
</turbo-stream>
