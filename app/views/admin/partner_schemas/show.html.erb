<div class="container mt-4">
  <h3 class="fw-bold"><%= @schema.name %></h3>
  <p><strong>Partner:</strong> <%= @schema.partner.name %></p>
  <p><strong>Record Type:</strong> <%= @schema.record_type %></p>

  <hr>
  <h5>Structure</h5>
  <pre><%= JSON.pretty_generate(@schema.structure) %></pre>

  <h5>Validation Rules</h5>
  <pre><%= JSON.pretty_generate(@schema.validation_rules) %></pre>

  <div class="mt-3">
    <% if @schema.approved_at.nil? %>
      <%= button_to "Approve", approve_admin_partner_schema_path(@schema), method: :patch, class: "btn btn-success me-2" %>
      <%= button_to "Reject", reject_admin_partner_schema_path(@schema), method: :patch, class: "btn btn-danger" %>
    <% elsif @schema.active? %>
      <%= button_to "Deactivate", deactivate_admin_partner_schema_path(@schema), method: :patch, class: "btn btn-warning" %>
    <% end %>
  </div>
</div>
