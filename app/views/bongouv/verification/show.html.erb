<!DOCTYPE html>
<html lang="ht">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BonGouv — Verifikasyon Dokiman</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/remixicon@4.1.0/fonts/remixicon.css" rel="stylesheet">
  <style>
    body { background: #f0f2f5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
    .verify-card { max-width: 440px; width: 100%; }
    .seal-valid { background: linear-gradient(135deg, #d1fae5 0%, #ecfdf5 100%); border: 2px solid #059669; }
    .seal-invalid { background: linear-gradient(135deg, #fee2e2 0%, #fef2f2 100%); border: 2px solid #dc2626; }
    .seal-notfound { background: linear-gradient(135deg, #e5e7eb 0%, #f9fafb 100%); border: 2px solid #6b7280; }
    .seal-icon { font-size: 3rem; }
    .data-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid rgba(0,0,0,0.06); }
    .data-row:last-child { border-bottom: none; }
    .data-label { color: #6b7280; font-size: 0.85rem; }
    .data-value { font-weight: 600; text-align: right; }
  </style>
</head>
<body>
  <div class="verify-card mx-3">

    <% if @status == :valid && @payment %>
      <%# ═══════════════════════════════════════════ %>
      <%# VALID — Document is Authentic               %>
      <%# ═══════════════════════════════════════════ %>
      <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <!-- Header -->
        <div class="text-center py-4 seal-valid">
          <i class="ri-verified-badge-fill seal-icon" style="color:#059669;"></i>
          <h4 class="fw-bold mt-2 mb-0" style="color:#059669;">DOKIMAN OTANTIK</h4>
          <p class="mb-0 mt-1" style="color:#065f46;font-size:0.85rem;">Siyati dijital verifye avèk siksè</p>
        </div>

        <div class="card-body p-4">
          <!-- Issuer -->
          <div class="text-center mb-3 pb-3 border-bottom">
            <small class="text-muted text-uppercase" style="letter-spacing:1px;font-size:0.7rem;">Emèt Pa</small>
            <h6 class="fw-bold mb-0 mt-1">Direction Générale des Impôts (DGI)</h6>
            <small class="text-muted">Repiblik d Ayiti</small>
          </div>

          <!-- Payment Details -->
          <div class="data-row">
            <span class="data-label">Kontribyab</span>
            <span class="data-value"><%= mask_name(@payment.user.first_name, @payment.user.last_name) %></span>
          </div>
          <div class="data-row">
            <span class="data-label">BonID</span>
            <span class="data-value"><code style="font-size:0.8rem;"><%= mask_bonid_public(@payment.user.bonid) %></code></span>
          </div>
          <div class="data-row">
            <span class="data-label">Fòm</span>
            <span class="data-value"><%= @payment.form_type_label %></span>
          </div>
          <div class="data-row">
            <span class="data-label">Montan Peye</span>
            <span class="data-value" style="color:#059669;font-size:1.1rem;"><%= number_with_delimiter(@payment.total_htg.round(2)) %> HTG</span>
          </div>
          <div class="data-row">
            <span class="data-label">Metòd</span>
            <span class="data-value"><%= @payment.payment_method_label %></span>
          </div>
          <div class="data-row">
            <span class="data-label">Dat Peman</span>
            <span class="data-value"><%= @payment.paid_at&.strftime("%d %b %Y") %></span>
          </div>
          <div class="data-row">
            <span class="data-label">Referans</span>
            <span class="data-value"><code style="font-size:0.75rem;"><%= @payment.order_id %></code></span>
          </div>

          <!-- Cryptographic Proof -->
          <div class="mt-3 p-3 rounded" style="background:#f0fdf4;">
            <div class="d-flex align-items-center gap-2 mb-2">
              <i class="ri-lock-line" style="color:#059669;"></i>
              <small class="fw-bold" style="color:#059669;">Prèv Kriptografik</small>
            </div>
            <small class="text-muted d-block" style="font-size:0.65rem;word-break:break-all;">
              Ed25519 — Siyen: <%= @payment.provider_response&.dig("bongouv_seal", "signed_at") %>
            </small>
            <small class="text-muted d-block" style="font-size:0.65rem;word-break:break-all;">
              Token: <%= @token %>
            </small>
          </div>
        </div>

        <!-- Footer -->
        <div class="text-center py-3" style="background:#f9fafb;">
          <small class="text-muted d-block" style="font-size:0.65rem;">Powered by <strong>BonGouv</strong>, a product of <strong>Verifyem</strong></small>
          <small class="text-muted d-block" style="font-size:0.6rem;">Verifye: <%= Time.current.strftime("%d/%m/%Y %H:%M:%S") %></small>
        </div>
      </div>

    <% elsif @status == :invalid && @payment %>
      <%# ═══════════════════════════════════════════ %>
      <%# INVALID — Signature Failed (Tampered!)      %>
      <%# ═══════════════════════════════════════════ %>
      <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="text-center py-4 seal-invalid">
          <i class="ri-error-warning-fill seal-icon" style="color:#dc2626;"></i>
          <h4 class="fw-bold mt-2 mb-0" style="color:#dc2626;">DOKIMAN PA OTANTIK</h4>
          <p class="mb-0 mt-1" style="color:#991b1b;font-size:0.85rem;">Siyati dijital echwe — dokiman sa a ka falsifye</p>
        </div>
        <div class="card-body p-4 text-center">
          <p class="text-muted">Verifikasyon kriptografik echwe. Sa vle di done nan dokiman sa a te chanje apre li te siyen.</p>
          <div class="alert alert-danger small mb-0">
            <i class="ri-shield-cross-line me-1"></i>
            Pa aksepte dokiman sa a. Kontakte DGI oswa BonGouv pou verifikasyon manyèl.
          </div>
        </div>
        <div class="text-center py-3" style="background:#f9fafb;">
          <small class="text-muted d-block" style="font-size:0.65rem;">Powered by <strong>BonGouv</strong>, a product of <strong>Verifyem</strong></small>
        </div>
      </div>

    <% else %>
      <%# ═══════════════════════════════════════════ %>
      <%# NOT FOUND — No such receipt                  %>
      <%# ═══════════════════════════════════════════ %>
      <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="text-center py-4 seal-notfound">
          <i class="ri-question-line seal-icon" style="color:#6b7280;"></i>
          <h4 class="fw-bold mt-2 mb-0" style="color:#374151;">DOKIMAN PA JWENN</h4>
          <p class="mb-0 mt-1" style="color:#6b7280;font-size:0.85rem;">Token verifikasyon pa valid oswa pa egziste</p>
        </div>
        <div class="card-body p-4 text-center">
          <p class="text-muted">Nou pa jwenn okenn resi ki koresponn ak kòd sa a. Asire w ke w eskane bon QR kòd la.</p>
          <div class="alert alert-secondary small mb-0">
            <i class="ri-information-line me-1"></i>
            Token: <code><%= @token %></code>
          </div>
        </div>
        <div class="text-center py-3" style="background:#f9fafb;">
          <small class="text-muted d-block" style="font-size:0.65rem;">Powered by <strong>BonGouv</strong>, a product of <strong>Verifyem</strong></small>
        </div>
      </div>
    <% end %>

  </div>
</body>
</html>
