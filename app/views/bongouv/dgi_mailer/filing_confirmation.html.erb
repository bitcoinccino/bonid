<%# BonGouv — Filing Confirmation Email %>
<%# Sent to citizen when they submit a DGI form %>

<p style="color: #1a1a2e; line-height: 1.6; margin-top: 0; font-size: 15px;">
  Bonjou <strong><%= @user.first_name %></strong>,
</p>
<p style="color: #4a5568; line-height: 1.6; font-size: 14px;">
  Deklarasyon ou soumèt avèk siksè. Men detay yo:
</p>

<div style="background: #f0f4ff; border: 1px solid #c7d2fe; border-radius: 12px; padding: 24px; text-align: center; margin: 24px 0;">
  <div style="color: #00209F; font-size: 14px; font-weight: 500; margin-bottom: 4px;"><%= @form_label&.dig(:title) %></div>
  <div style="color: #00209F; font-size: 28px; font-weight: 800; line-height: 1; font-family: monospace;">
    <%= @record.data["declaration_number"] %>
  </div>
  <div style="color: #6C757D; font-size: 13px; margin-top: 8px;">
    Estati: <span style="background: #FFF3CD; color: #856404; padding: 2px 10px; border-radius: 10px; font-size: 11px; font-weight: 600;">Annatant Revizyon</span>
  </div>
</div>

<table style="width: 100%; border-collapse: collapse; font-size: 13px; margin: 20px 0;">
  <tr>
    <td style="padding: 8px 0; color: #6C757D; border-bottom: 1px solid #f0f0f0;">Fòm</td>
    <td style="padding: 8px 0; font-weight: 600; border-bottom: 1px solid #f0f0f0; text-align: right;"><%= @form_label&.dig(:subtitle) %></td>
  </tr>
  <tr>
    <td style="padding: 8px 0; color: #6C757D; border-bottom: 1px solid #f0f0f0;">Dat Soumisyon</td>
    <td style="padding: 8px 0; font-weight: 600; border-bottom: 1px solid #f0f0f0; text-align: right;"><%= @record.created_at.strftime("%d %B %Y a %H:%M") %></td>
  </tr>
  <tr>
    <td style="padding: 8px 0; color: #6C757D;">Kontribyab</td>
    <td style="padding: 8px 0; font-weight: 600; text-align: right;"><%= @user.first_name %> <%= @user.last_name %></td>
  </tr>
</table>

<div style="background: #f8f9fa; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; margin: 20px 0;">
  <div style="font-weight: 700; color: #1a1a2e; font-size: 13px; margin-bottom: 8px;">Kisa k ap pase kounye a?</div>
  <ul style="margin: 0; padding-left: 18px; font-size: 13px; color: #4a5568; line-height: 1.8;">
    <li>Yon ajan DGI ap revize deklarasyon ou</li>
    <li>W ap resevwa yon imel lè li apwouve oswa rejte</li>
    <li>Pwosesis la pran jeneralman 1-3 jou ouvrab</li>
  </ul>
</div>

<div style="text-align: center; margin: 28px 0 12px;">
  <a href="<%= citizens_dgi_url(@record) %>"
     style="display: inline-block; background: #00209F; color: #FFFFFF; padding: 14px 36px; border-radius: 25px; text-decoration: none; font-weight: 700; font-size: 15px;">
    Wè Deklarasyon
  </a>
</div>

<p style="color: #9ca3af; font-size: 11px; text-align: center; margin-top: 24px;">
  Powered by <strong>BonGouv</strong>, a product of <strong>Verifyem</strong>
</p>
