<%# app/views/election/verify_receipt/show.html.erb
    Public receipt verifier · Citizen-first verdict, with a collapsible
    technical-details panel for journalists, observers, and auditors. %>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Verifye Resi BonVote — BonID</title>
  <meta name="description" content="Verifye otantisite yon resi BonVote.">
  <%= render "election/shared/bonvote_theme", sparkle_count: 6 %>
  <style>
    .vr-shell { max-width: 560px; margin: 0 auto; padding: 2.5rem 1rem; }

    /* Verdict — the only thing 95% of citizens need */
    .vr-verdict {
      text-align: center;
      padding: 2.5rem 1.5rem;
      border-radius: 1.25rem;
      margin-bottom: 1.5rem;
    }
    .vr-verdict-ok    { background: rgba(40,167,69,0.08); border: 1px solid rgba(40,167,69,0.35); }
    .vr-verdict-bad   { background: rgba(220,53,69,0.08); border: 1px solid rgba(220,53,69,0.35); }
    .vr-verdict-icon  { font-size: 5rem; line-height: 1; }
    .vr-verdict-ok .vr-verdict-icon  { color: #28A745; }
    .vr-verdict-bad .vr-verdict-icon { color: #DC3545; }
    .vr-verdict-title {
      font-size: 1.5rem; font-weight: 800;
      margin-top: 0.75rem; color: #fff;
      letter-spacing: -0.01em;
    }
    .vr-verdict-sub {
      font-size: 0.95rem; color: #B8C2D1;
      margin-top: 0.5rem; line-height: 1.5;
    }

    /* Trust badge — small lock icon under verdict */
    .vr-trust {
      display: inline-flex; align-items: center; gap: 6px;
      margin-top: 1.25rem;
      padding: 0.4rem 0.85rem;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 2rem;
      font-size: 0.72rem;
      color: rgba(255,255,255,0.7);
      font-weight: 600;
    }
    .vr-trust i { color: var(--ht-gold, #EDB95E); }

    /* Receipt-match summary — plain language so the citizen can confirm
       this matches the receipt they're holding */
    .vr-match {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 0.75rem;
      padding: 1rem 1.25rem;
      margin-bottom: 1.25rem;
    }
    .vr-match-row {
      display: flex; justify-content: space-between; gap: 1rem;
      padding: 0.45rem 0; font-size: 0.88rem;
    }
    .vr-match-row + .vr-match-row { border-top: 1px solid rgba(255,255,255,0.05); }
    .vr-match-key { color: #94A3B8; font-weight: 500; }
    .vr-match-val { color: rgba(255,255,255,0.9); font-weight: 600; text-align: right; }

    /* Technical details — collapsed by default */
    .vr-tech {
      background: rgba(0,0,0,0.2);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 0.75rem;
      margin-bottom: 1.25rem;
      overflow: hidden;
    }
    .vr-tech summary {
      padding: 0.75rem 1rem;
      cursor: pointer;
      font-size: 0.78rem;
      color: #94A3B8;
      font-weight: 600;
      list-style: none;
      display: flex; align-items: center; justify-content: space-between;
    }
    .vr-tech summary::-webkit-details-marker { display: none; }
    .vr-tech summary::after {
      content: "+"; font-size: 1.2rem; color: #64748B;
      transition: transform 0.2s;
    }
    .vr-tech[open] summary::after { content: "−"; }
    .vr-tech summary:hover { color: rgba(255,255,255,0.85); }
    .vr-tech-body {
      padding: 0 1rem 1rem;
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 0.72rem;
    }
    .vr-tech-row {
      display: flex; justify-content: space-between; gap: 1rem;
      padding: 0.4rem 0;
      border-top: 1px solid rgba(255,255,255,0.05);
    }
    .vr-tech-key { color: #64748B; flex-shrink: 0; }
    .vr-tech-val { color: rgba(255,255,255,0.85); text-align: right; word-break: break-all; }
    .vr-tech-section { margin-top: 0.75rem; font-size: 0.7rem; color: var(--ht-gold, #EDB95E); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }

    /* Manual paste form */
    .vr-paste {
      margin-top: 1.5rem;
    }
    .vr-paste summary {
      cursor: pointer;
      color: #94A3B8;
      font-size: 0.82rem;
      font-weight: 600;
      list-style: none;
      padding: 0.5rem 0;
      text-align: center;
    }
    .vr-paste summary::-webkit-details-marker { display: none; }
    .vr-paste summary:hover { color: rgba(255,255,255,0.9); }
    .vr-label {
      display: block;
      margin-top: 0.75rem;
      margin-bottom: 0.4rem;
      color: rgba(255,255,255,0.85);
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .vr-input {
      width: 100%;
      padding: 0.85rem 1rem;
      border-radius: 0.5rem;
      background: rgba(0,0,0,0.25);
      border: 1px solid rgba(255,255,255,0.15);
      color: rgba(255,255,255,0.95);
      font-family: 'SF Mono', 'JetBrains Mono', ui-monospace, monospace;
      font-size: 1.05rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }
    .vr-input:focus { outline: none; border-color: var(--ht-gold, #EDB95E); background: rgba(0,0,0,0.4); }
    .vr-input-help {
      margin-top: 0.4rem;
      font-size: 0.72rem;
      color: #94A3B8;
    }
    .vr-advanced {
      margin-top: 1rem;
      padding-top: 0.75rem;
      border-top: 1px dashed rgba(255,255,255,0.08);
    }
    .vr-advanced summary {
      cursor: pointer;
      font-size: 0.72rem;
      color: #64748B;
      list-style: none;
      padding: 0.25rem 0;
    }
    .vr-advanced summary::-webkit-details-marker { display: none; }
    .vr-advanced summary:hover { color: rgba(255,255,255,0.85); }
    .vr-textarea {
      width: 100%;
      min-height: 120px;
      padding: 0.75rem;
      margin-top: 0.5rem;
      border-radius: 0.5rem;
      background: rgba(0,0,0,0.25);
      border: 1px solid rgba(255,255,255,0.12);
      color: rgba(255,255,255,0.9);
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 0.75rem;
    }
    .vr-textarea:focus { outline: none; border-color: var(--ht-gold, #EDB95E); }

    .vr-btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 0.55rem 1.1rem;
      background: var(--ht-blue, #00209F);
      color: #fff; border: none; border-radius: 0.5rem;
      font-weight: 700; font-size: 0.82rem;
      cursor: pointer; text-decoration: none;
      margin-top: 0.75rem;
    }
    .vr-btn:hover { opacity: 0.9; color: #fff; }

    /* Footer links — quiet */
    .vr-footer {
      margin-top: 2rem; text-align: center;
      font-size: 0.75rem; color: #64748B;
    }
    .vr-footer a { color: #94A3B8; text-decoration: none; }
    .vr-footer a:hover { color: var(--ht-gold, #EDB95E); }
    .vr-footer-sep { margin: 0 0.5rem; opacity: 0.4; }

    .vr-intro {
      text-align: center; margin-bottom: 2rem;
    }
    .vr-intro h1 {
      color: #fff; font-weight: 800; font-size: 1.4rem;
      margin-bottom: 0.5rem;
    }
    .vr-intro p {
      color: #94A3B8; font-size: 0.88rem; margin: 0;
    }
  </style>
</head>
<body>
  <div class="vr-shell">

    <% if @result.blank? %>
      <%# Empty state — no payload submitted yet %>
      <div class="vr-intro">
        <h1>
          <i class="ri-shield-check-line" style="color: var(--ht-gold, #EDB95E);"></i>
          Verifye yon Resi
        </h1>
        <p>Eskane kòd QR sou yon resi BonVote ak telefòn ou pou wè si li otantik.</p>
      </div>
    <% else %>
      <% if @result[:ok] %>
        <%# ── Citizen-first verdict ── %>
        <div class="vr-verdict vr-verdict-ok">
          <div class="vr-verdict-icon"><i class="ri-checkbox-circle-fill"></i></div>
          <div class="vr-verdict-title">Resi sa a otantik</div>
          <div class="vr-verdict-sub">
            BonID bay resi sa a. Siyati a koresponn ak kle piblik la.
          </div>
          <div class="vr-trust">
            <i class="ri-lock-2-line"></i>
            Pwoteje ak siyati BonID
          </div>
        </div>

        <%# Plain-language match info — what citizen can compare to receipt %>
        <% payload = @result[:payload] || {} %>
        <% has_match = payload[:ref] || payload[:bv] || payload[:c] %>
        <% if has_match %>
          <div class="vr-match">
            <% if payload[:ref] %>
              <div class="vr-match-row">
                <span class="vr-match-key">Referans</span>
                <span class="vr-match-val"><%= payload[:ref] %></span>
              </div>
            <% end %>
            <% if payload[:c] %>
              <div class="vr-match-row">
                <span class="vr-match-key">Sant Vòt</span>
                <span class="vr-match-val"><%= payload[:c] %></span>
              </div>
            <% end %>
            <% if payload[:bv] %>
              <div class="vr-match-row">
                <span class="vr-match-key">Biwo Vòt</span>
                <span class="vr-match-val">BV #<%= payload[:bv] %></span>
              </div>
            <% end %>
            <% if @result[:election] %>
              <div class="vr-match-row">
                <span class="vr-match-key">Eleksyon</span>
                <span class="vr-match-val"><%= @result[:election].title %></span>
              </div>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <%# Failure — keep technical reason short, plain language %>
        <div class="vr-verdict vr-verdict-bad">
          <div class="vr-verdict-icon"><i class="ri-close-circle-fill"></i></div>
          <div class="vr-verdict-title">Resi sa a pa valid</div>
          <div class="vr-verdict-sub">
            <%= @result[:error].presence || "Siyati a pa koresponn. Resi a ka modifye oswa li pa soti nan BonID." %>
          </div>
        </div>
      <% end %>

      <%# Technical details — collapsed by default. For journalists,
          observers, auditors who need to verify independently. %>
      <details class="vr-tech">
        <summary>
          <span><i class="ri-code-s-slash-line me-1"></i>Detay teknik (pou obsèvatè ak jounalis)</span>
        </summary>
        <div class="vr-tech-body">

          <% if @result[:public_key].present? %>
            <div class="vr-tech-section">Kle piblik</div>
            <div class="vr-tech-row">
              <span class="vr-tech-key">algorithm</span>
              <span class="vr-tech-val">Ed25519 (RFC 8032)</span>
            </div>
            <% if @result[:key_id] %>
              <div class="vr-tech-row">
                <span class="vr-tech-key">key_id</span>
                <span class="vr-tech-val"><%= @result[:key_id] %></span>
              </div>
            <% end %>
            <div class="vr-tech-row">
              <span class="vr-tech-key">fingerprint (SHA-256)</span>
              <span class="vr-tech-val"><%= @result[:fingerprint] %></span>
            </div>
          <% end %>

          <% if @result[:payload].present? %>
            <div class="vr-tech-section">Peyad siyen</div>
            <% @result[:payload].each do |k, v| %>
              <div class="vr-tech-row">
                <span class="vr-tech-key"><%= k %></span>
                <span class="vr-tech-val"><%= v %></span>
              </div>
            <% end %>
          <% end %>

          <% if @result[:signature].present? %>
            <div class="vr-tech-section">Siyati</div>
            <div class="vr-tech-row">
              <span class="vr-tech-val" style="text-align: left;"><%= @result[:signature] %></span>
            </div>
          <% end %>

          <% if @result[:verified_at] %>
            <div class="vr-tech-row" style="margin-top: 0.75rem;">
              <span class="vr-tech-key">verified_at</span>
              <span class="vr-tech-val"><%= @result[:verified_at].iso8601 %></span>
            </div>
          <% end %>
        </div>
      </details>
    <% end %>

    <%# Citizen-friendly verify form — paste/type voter reference. The
        raw-JSON path is hidden in a sub-toggle for observers/auditors. %>
    <details class="vr-paste" <%= "open" if @result.blank? %>>
      <summary>
        <i class="ri-search-line me-1"></i>Verifye yon lòt resi
      </summary>
      <%= form_with url: election_verify_receipt_check_path, method: :post, local: true do |f| %>
        <label class="vr-label" for="voter_reference">Nimewo Votè</label>
        <%= f.text_field :voter_reference,
                         id: "voter_reference",
                         class: "vr-input",
                         placeholder: "BVT-2026-XXXX-YYYY",
                         autocomplete: "off",
                         autocapitalize: "characters",
                         spellcheck: false %>
        <div class="vr-input-help">Antre nimewo votè ki nan resi w la.</div>
        <%= f.submit "Verifye", class: "vr-btn" %>

        <details class="vr-advanced">
          <summary>Mòd avanse (peyad JSON)</summary>
          <%= f.text_area :payload_json,
                          class: "vr-textarea",
                          placeholder: 'Kole peyad JSON resi a isit la...' %>
        </details>
      <% end %>
    </details>

    <div class="vr-footer">
      <a href="<%= receipt_v1_spec_path %>">Espesifikasyon teknik</a>
      <span class="vr-footer-sep">·</span>
      <a href="<%= api_v1_bonvote_election_public_key_path(id: @result&.dig(:election)&.id || 1) %>" target="_blank">Kle piblik eleksyon</a>
      <span class="vr-footer-sep">·</span>
      <a href="https://bonid.ht">BonID</a>
    </div>

  </div>
</body>
</html>
