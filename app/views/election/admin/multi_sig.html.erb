<%# app/views/election/admin/multi_sig.html.erb %>
<%# Multi-Signature Decryption Ceremony — 5 of 9 CEP members required %>

<div class="container-fluid py-4">
  <div class="row justify-content-center">
    <div class="col-lg-7">

      <%# ── Header ── %>
      <div class="text-center mb-4">
        <h4 class="pp-page-title">
          <i class="ri-key-2-line me-2 pp-text-brand"></i>Seremoni Dechifraj
        </h4>
        <p class="pp-page-subtitle">
          <%= Election::MultiSigService::QUORUM_REQUIRED %> nan <%= Election::MultiSigService::TOTAL_SIGNATORIES %>
          siyatè otorize dwe verifye idantite yo pou dechifre rezilta eleksyon an.
        </p>
      </div>

      <%# ── Signature Progress ── %>
      <div class="pp-card card mb-4">
        <div class="card-body p-4 text-center">
          <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
               style="width: 100px; height: 100px; border: 4px solid <%= @sig_status[:met] ? 'var(--status-success)' : 'var(--status-warning)' %>;">
            <div>
              <div class="fw-bold pp-text-3xl" style="color: <%= @sig_status[:met] ? 'var(--status-success)' : 'var(--status-warning)' %>;">
                <%= @sig_status[:total] %>/<%= Election::MultiSigService::QUORUM_REQUIRED %>
              </div>
              <div class="pp-text-xs pp-text-secondary text-uppercase">Siyati</div>
            </div>
          </div>
        </div>
      </div>

      <%# ── Signatory Slots ── %>
      <div class="pp-card card mb-4">
        <div class="card-header px-4 py-3">
          <h6 class="fw-semibold mb-0 pp-text-sm">Siyatè yo</h6>
        </div>
        <div class="card-body p-0">
          <% Election::MultiSigService::SIGNATORY_ROLES.each_with_index do |role, i| %>
            <% signed = @sig_status[:signatories]&.find { |s| s[:role] == role } %>
            <div class="d-flex align-items-center gap-3 px-4 py-3 <%= i < Election::MultiSigService::SIGNATORY_ROLES.size - 1 ? 'border-bottom' : '' %>">

              <%# Status icon %>
              <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                   style="width: 36px; height: 36px; background: <%= signed ? 'var(--status-success-bg)' : 'var(--slate-50)' %>;">
                <% if signed %>
                  <i class="ri-check-line pp-text-success"></i>
                <% else %>
                  <span class="fw-bold pp-text-sm pp-text-muted"><%= i + 1 %></span>
                <% end %>
              </div>

              <%# Role info %>
              <div class="flex-grow-1">
                <div class="fw-semibold pp-text-sm <%= signed ? 'pp-text-success' : '' %>">
                  <%= Election::MultiSigService.role_label(role) %>
                </div>
                <% if signed %>
                  <div class="pp-text-xs pp-text-secondary">
                    <%= signed[:name] %> &middot; <%= Time.parse(signed[:signed_at]).strftime("%H:%M") rescue signed[:signed_at] %>
                  </div>
                <% else %>
                  <div class="pp-text-xs pp-text-muted">Ap tann siyati...</div>
                <% end %>
              </div>

              <%# Liveness badge %>
              <% if signed && signed[:liveness_verified] %>
                <span class="badge bg-success-subtle text-success pp-badge-sm">
                  <i class="ri-user-smile-line me-1"></i> Verifye
                </span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <%# ── Sign Action ── %>
      <% unless @sig_status[:met] %>
        <div class="pp-card card mb-4">
          <div class="card-header px-4 py-3">
            <h6 class="fw-semibold mb-0 pp-text-sm d-flex align-items-center gap-2">
              <i class="ri-key-2-line pp-text-warning"></i>
              Siyen kòm Siyatè Otorize
            </h6>
          </div>
          <div class="card-body p-4">
            <form action="<%= admin_election_election_sign_path(@election_id) %>" method="post">
              <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
              <%= hidden_field_tag :election_id, @election_id %>

              <div class="mb-3">
                <label class="form-label fw-semibold pp-text-sm">Wòl Ou</label>
                <select name="role" required class="form-select">
                  <option value="">— Chwazi wòl ou —</option>
                  <% (@sig_status[:available_roles] || Election::MultiSigService::SIGNATORY_ROLES).each do |role| %>
                    <option value="<%= role %>"><%= Election::MultiSigService.role_label(role) %></option>
                  <% end %>
                </select>
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold pp-text-sm">Kle Dechifraj Ou (Shard)</label>
                <textarea name="key_shard" rows="3" required class="form-control pp-font-mono pp-text-xs"
                          placeholder="Kole kle shard ou a isit..."></textarea>
              </div>

              <div class="alert alert-warning rounded-3 mb-3 pp-text-xs">
                <div class="d-flex align-items-start gap-2">
                  <i class="ri-fingerprint-line pp-text-lg"></i>
                  <div>
                    Verifikasyon byometrik (liveness + figi) obligatwa. Sistèm nan ap verifye idantite ou anvan li aksepte siyati a.
                  </div>
                </div>
              </div>

              <button type="submit" class="btn pp-btn-brand w-100 py-2">
                <i class="ri-shield-keyhole-line me-1"></i> Siyen + Verifye Idantite
              </button>
            </form>
          </div>
        </div>
      <% else %>
        <%# ── Quorum Met ── %>
        <div class="pp-card card mb-4">
          <div class="card-body p-4 text-center">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 pp-bg-success-bg"
                 style="width: 64px; height: 64px;">
              <i class="ri-lock-unlock-line pp-icon-xl pp-text-success"></i>
            </div>
            <h5 class="fw-bold pp-text-success mb-2">Bwat Vòt la Ouvri</h5>
            <p class="pp-text-sm pp-text-secondary mb-3">
              Kowòm atenn. <%= Election::MultiSigService::QUORUM_REQUIRED %> siyatè verifye. Rezilta ofisyèl yo disponib.
            </p>
            <a href="<%= partner_portal_election_results_path(@election_id) %>" class="btn btn-success px-4">
              <i class="ri-bar-chart-box-line me-1"></i> Wè Rezilta Ofisyèl Yo
            </a>
          </div>
        </div>
      <% end %>

      <%# ── Security Notice ── %>
      <div class="text-center py-3">
        <p class="pp-text-xs pp-text-muted mb-0">
          <i class="ri-shield-check-line me-1"></i>
          Seremoni dechifraj sa a anrejistre nan log odit imutab.
          Chak siyati gen verifikasyon byometrik (liveness + konparezon figi).
        </p>
      </div>

    </div>
  </div>
</div>
