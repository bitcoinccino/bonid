<%# app/views/election/admin/tally.html.erb %>
<%# CEP Admin Tally Dashboard — Real-time vote counts + integrity verification %>

<div class="container-fluid py-4">

  <%# ── Header ── %>
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <h4 class="pp-page-title">
        <i class="ri-pie-chart-line me-2 pp-text-brand"></i>Tablo Elektoral
      </h4>
      <p class="pp-page-subtitle"><%= @election_id || "2026-presidential-round1" %> &middot; Dyaspora</p>
    </div>
    <div class="d-flex gap-2 flex-wrap align-items-center">
      <% if @election&.open? %>
        <span class="badge rounded-pill bg-success px-3 py-2 pp-text-xs">
          <span class="d-inline-block rounded-circle bg-white me-1" style="width: 6px; height: 6px;"></span>
          AN DIRÈK
        </span>
      <% end %>
      <%= link_to admin_election_election_oaths_path(@election_id),
                  class: "btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" do %>
        <i class="ri-quill-pen-line"></i>
        Sèman Siyen
      <% end %>
      <% if @election && !@election.certified? %>
        <%= link_to admin_edit_election_election_path(@election_id),
                    class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" do %>
          <i class="ri-settings-3-line"></i>
          Règ Eleksyon
        <% end %>
      <% end %>
      <span class="badge rounded-pill bg-light text-muted border px-3 py-2 pp-text-xs">
        Dènye aktualizasyon: <%= Time.current.strftime("%H:%M:%S") %>
      </span>
    </div>
  </div>

  <%# ── Stats Cards ── %>
  <div class="row g-3 mb-4">
    <% [
      ["Total Vòt", number_with_delimiter(@stats[:total_votes] || 0), "pp-text-brand", "ri-checkbox-circle-fill"],
      ["An Pèson", number_with_delimiter(@stats[:in_person_votes] || 0), "pp-text-warning", "ri-walk-line"],
      ["Vòt Remòt", number_with_delimiter(@stats[:remote_votes] || 0), "pp-text-success", "ri-smartphone-line"],
      ["Vòt Konsila", number_with_delimiter(@stats[:consulate_votes] || 0), "pp-text-info", "ri-building-line"],
      ["Rejte", number_with_delimiter(@stats[:rejected] || 0), "pp-text-danger", "ri-spam-line"],
    ].each do |label, count, color_class, icon| %>
      <div class="col-6 col-md">
        <div class="pp-card card p-3">
          <div class="d-flex align-items-center gap-3">
            <i class="<%= icon %> pp-icon-lg <%= color_class %>"></i>
            <div>
              <div class="fw-bold pp-text-xl <%= color_class %>"><%= count %></div>
              <div class="pp-stat-label"><%= label %></div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <%# ── Integrity Verification ── %>
  <div class="pp-card card mb-4">
    <div class="card-header px-4 py-3">
      <h6 class="fw-semibold mb-0 pp-text-sm d-flex align-items-center gap-2">
        <i class="ri-shield-check-line pp-text-success"></i>
        Entegrite Rejis la
      </h6>
    </div>
    <div class="card-body p-4">
      <div class="row g-3">
        <div class="col-md-6">
          <div class="rounded-3 p-3 pp-bg-slate-50">
            <div class="pp-text-xs fw-semibold pp-text-secondary text-uppercase mb-2">Merkle Root</div>
            <code class="pp-text-xs pp-text-brand d-block" style="word-break: break-all;">
              <%= @integrity[:merkle_root] || "N/A — pa gen vòt anko" %>
            </code>
          </div>
        </div>
        <div class="col-md-6">
          <div class="rounded-3 p-3 pp-bg-slate-50">
            <div class="pp-text-xs fw-semibold pp-text-secondary text-uppercase mb-2">Commitment Agreje (Homomorphic)</div>
            <code class="pp-text-xs pp-text-success d-block" style="word-break: break-all;">
              <%= @integrity[:aggregated_commitment] || "N/A" %>
            </code>
          </div>
        </div>
      </div>
      <div class="mt-3 d-flex gap-3 flex-wrap align-items-center">
        <% if @integrity[:valid] != false %>
          <span class="d-flex align-items-center gap-1 pp-text-sm">
            <span class="d-inline-block rounded-circle bg-success" style="width: 8px; height: 8px;"></span>
            <span class="pp-text-success fw-semibold">Ledger entèg — okenn manipilasyon detekte</span>
          </span>
        <% else %>
          <span class="d-flex align-items-center gap-1 pp-text-sm">
            <span class="d-inline-block rounded-circle bg-danger" style="width: 8px; height: 8px;"></span>
            <span class="pp-text-danger fw-semibold">ALÈT: Pwoblèm entegrite detekte</span>
          </span>
        <% end %>
        <span class="pp-text-xs pp-text-muted">
          Dènye verifikasyon: <%= @integrity[:verified_at] || Time.current.strftime("%d %b %Y %H:%M") %>
        </span>
      </div>
    </div>
  </div>

  <%# ── Votes by Country ── %>
  <div class="pp-card card mb-4">
    <div class="card-header px-4 py-3">
      <h6 class="fw-semibold mb-0 pp-text-sm d-flex align-items-center gap-2">
        <i class="ri-global-line pp-text-info"></i>
        Vòt pa Peyi
      </h6>
    </div>
    <div class="card-body p-4">
      <div class="row g-3">
        <% (@stats[:by_country] || { "US" => 0, "DO" => 0, "CA" => 0, "FR" => 0, "CL" => 0, "BR" => 0 }).sort_by { |_, v| -v }.each do |code, count| %>
          <% country_name = ISO3166::Country[code]&.translations&.dig("en") || code rescue code %>
          <div class="col-md-2 col-6">
            <div class="rounded-3 p-3 pp-bg-slate-50 d-flex justify-content-between align-items-center">
              <div>
                <div class="fw-semibold pp-text-sm"><%= country_name %></div>
                <div class="pp-text-xs pp-text-muted"><%= code %></div>
              </div>
              <div class="fw-bold pp-text-lg pp-text-brand"><%= number_with_delimiter(count) %></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# ── Vòt Nasyonal (Domestic Votes by Department) ── %>
  <% departments = Department.order(:name).index_by { |d| d.id.to_s } %>
  <% by_dept = @stats[:by_department] || {} %>
  <% dept_total = by_dept.values.sum %>
  <div class="pp-card card mb-4">
    <div class="card-header px-4 py-3 d-flex justify-content-between align-items-center">
      <h6 class="fw-semibold mb-0 pp-text-sm d-flex align-items-center gap-2">
        <i class="ri-map-pin-2-line pp-text-warning"></i>
        Vòt Nasyonal — pa Depatman
      </h6>
      <span class="badge bg-light text-muted border pp-badge-sm">
        <%= number_with_delimiter(dept_total) %> vòt
      </span>
    </div>
    <div class="card-body p-4">
      <% if by_dept.any? %>
        <div class="row g-3">
          <% by_dept.sort_by { |_, v| -v }.each do |code, count| %>
            <% dept = departments[code.to_s] %>
            <% pct = dept_total > 0 ? (count.to_f / dept_total * 100).round(1) : 0 %>
            <div class="col-md-6">
              <div class="d-flex align-items-center gap-3 rounded-3 p-3 pp-bg-slate-50">
                <div class="flex-grow-1">
                  <div class="d-flex justify-content-between mb-1">
                    <span class="fw-semibold pp-text-sm"><%= dept&.name || code %></span>
                    <span class="fw-bold pp-text-sm pp-text-brand"><%= number_with_delimiter(count) %></span>
                  </div>
                  <div class="progress" style="height: 6px;">
                    <div class="progress-bar" role="progressbar" style="width: <%= pct %>%; background-color: var(--portal-brand);"></div>
                  </div>
                </div>
                <span class="pp-text-xs pp-text-muted" style="min-width: 40px; text-align: right;"><%= pct %>%</span>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-3">
          <span class="pp-text-sm pp-text-muted">
            <i class="ri-map-pin-line me-1"></i>
            Okenn vòt nasyonal anrejistre ankò
          </span>
        </div>
      <% end %>
    </div>
  </div>

  <%# ── Diplomatic Missions (Voting Stations) ── %>
  <% all_consulates = (@stats[:consulates] || []).sort_by { |c| [-c[:votes], c[:region].to_s, c[:name]] } %>
  <% active_consulates = all_consulates.select { |c| c[:status] == "active" } %>
  <% standby_count = all_consulates.size - active_consulates.size %>
  <div class="pp-card card mb-4">
    <div class="card-header px-4 py-3 d-flex justify-content-between align-items-center">
      <h6 class="fw-semibold mb-0 pp-text-sm d-flex align-items-center gap-2">
        <i class="ri-government-line pp-text-warning"></i>
        Misyon Diplomatik — Estasyon Vòt
      </h6>
      <div class="d-flex gap-2">
        <span class="badge bg-success-subtle text-success pp-badge-sm">
          <%= active_consulates.size %> aktif
        </span>
        <span class="badge bg-light text-muted border pp-badge-sm">
          <%= all_consulates.size %> total
        </span>
      </div>
    </div>
    <div class="card-body p-0">
      <% if active_consulates.any? %>
        <div class="table-responsive">
          <table class="table table-hover pp-table">
            <thead class="table-light">
              <tr>
                <th>Misyon</th>
                <th>Tip</th>
                <th>Peyi</th>
                <th>Rejyon</th>
                <th class="text-end">Vòt</th>
              </tr>
            </thead>
            <tbody>
              <% active_consulates.each do |consulate| %>
                <tr>
                  <td>
                    <div class="fw-semibold"><%= consulate[:name] %></div>
                    <code class="pp-text-xs pp-text-muted"><%= consulate[:id] %></code>
                  </td>
                  <td>
                    <span class="pp-text-xs"><%= HaitianDiplomaticMissions::MISSION_TYPES[consulate[:type]] || consulate[:type]&.titleize %></span>
                  </td>
                  <td><%= consulate[:country] %></td>
                  <td><span class="pp-text-xs"><%= HaitianDiplomaticMissions::REGIONS[consulate[:region]] || consulate[:region]&.titleize %></span></td>
                  <td class="text-end fw-bold pp-text-brand"><%= number_with_delimiter(consulate[:votes]) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center p-4">
          <span class="pp-text-sm pp-text-muted">
            <i class="ri-time-line me-1"></i>
            Okenn estasyon pa resevwa vòt ankò
          </span>
        </div>
      <% end %>
      <% if standby_count > 0 %>
        <div class="px-4 py-3 border-top" style="border-color: var(--slate-100) !important;">
          <span class="pp-text-xs pp-text-muted">
            <i class="ri-map-pin-line me-1"></i>
            <%= standby_count %> lòt misyon diplomatik an standby (pa gen vòt ankò)
          </span>
        </div>
      <% end %>
    </div>
  </div>

  <%# ── Final Decryption Panel ── %>
  <div class="pp-card card mb-4">
    <div class="card-header px-4 py-3">
      <h6 class="fw-semibold mb-0 pp-text-sm d-flex align-items-center gap-2">
        <i class="ri-key-2-line pp-text-warning"></i>
        Dechifraj Final — Rezilta Ofisyèl
      </h6>
    </div>
    <div class="card-body p-4">
      <p class="pp-text-sm pp-text-secondary mb-3">
        Lè vòt fèmen, CEP ka dechifre total agreje a san li pa wè vòt endividyèl yo.
        Sa a mande kle prive CEP a ak akò 5 nan 9 manm komisyon an (multi-sig).
      </p>

      <% if @election_closed %>
        <div class="rounded-3 p-4 pp-bg-slate-50 text-center">
          <p class="pp-text-sm pp-text-secondary mb-3">Pou dechifre rezilta ofisyèl yo, antre kle prive CEP a:</p>
          <form action="<%= admin_election_election_decrypt_path(@election_id) %>" method="post" class="mx-auto" style="max-width: 400px;">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <%= hidden_field_tag :election_id, @election_id %>
            <textarea name="cep_private_key" rows="4" class="form-control pp-font-mono pp-text-xs mb-3"
                      placeholder="-----BEGIN RSA PRIVATE KEY-----"></textarea>
            <button type="submit" class="btn pp-btn-brand px-4">
              <i class="ri-lock-unlock-line me-1"></i> Dechifre Rezilta Yo
            </button>
          </form>
        </div>
      <% else %>
        <div class="text-center p-3">
          <span class="d-inline-flex align-items-center gap-2 rounded-3 px-3 py-2 pp-bg-slate-50 pp-text-sm pp-text-secondary">
            <i class="ri-lock-line"></i>
            Vòt toujou ouvè — dechifraj bloke jiskaske vòt fèmen
          </span>
        </div>
      <% end %>
    </div>
  </div>

  <%# ── Observer Access ── %>
  <div class="pp-card card mb-4">
    <div class="card-header px-4 py-3">
      <h6 class="fw-semibold mb-0 pp-text-sm d-flex align-items-center gap-2">
        <i class="ri-eye-line pp-text-info"></i>
        Aksè Obsèvatè Entènasyonal
      </h6>
    </div>
    <div class="card-body p-4">
      <div class="row g-3">
        <% [
          ["API Verifikasyon", "GET /api/v1/election/audit?election_id=#{@election_id}", "Retounen: merkle_root, total_votes, snapshot dènye jou a"],
          ["Telechaje Rejis Konplè", "GET /api/v1/election/ledger.csv?election_id=#{@election_id}", "CSV ak tout hash — obsèvatè ka verifye endepandaman"],
          ["Snapshot Jounal", "GET /api/v1/election/snapshot?date=#{Date.current.iso8601}", "Snapshot chak jou pou pibliye sou sit piblik la"],
        ].each do |title, endpoint, desc| %>
          <div class="col-md-4">
            <div class="rounded-3 p-3 pp-bg-slate-50">
              <div class="fw-semibold pp-text-xs mb-2"><%= title %></div>
              <code class="pp-text-xs pp-text-brand d-block mb-1" style="word-break: break-all;"><%= endpoint %></code>
              <div class="pp-text-xs pp-text-muted"><%= desc %></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# ── Footer ── %>
  <div class="text-center py-3">
    <p class="pp-text-xs pp-text-muted mb-0">
      <i class="ri-shield-check-line me-1"></i>
      Sistèm elektoral BonID — Pedersen Commitment + Schnorr ZKP + AES-256-GCM<br>
      Vòt endividyèl yo pa janm vizib. Sèlman total agreje a dechifrab pa CEP.<br>
      &copy; 2026 BonID / Verifyem &middot; Conseil &Eacute;lectoral Provisoire
    </p>
  </div>
</div>
