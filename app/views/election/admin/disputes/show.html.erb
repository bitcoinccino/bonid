<%# app/views/election/admin/disputes/show.html.erb %>
<%# BCEN — single-dispute review. Actions advance the status machine
    filed → under_review → hearing_scheduled → decided → closed. %>

<div class="container-fluid py-4">

  <%# ── Header ── %>
  <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
      <h4 class="pp-page-title">
        <i class="ri-scales-3-line me-2 pp-text-brand"></i>
        <%= @dispute.reference_code %>
      </h4>
      <p class="pp-page-subtitle">
        <%= @dispute.dispute_type.titleize %> · Depoze <%= @dispute.filed_at&.strftime("%d %b %Y %H:%M") || "—" %>
      </p>
    </div>
    <div class="d-flex gap-2 align-items-center">
      <% color = case @dispute.status
                 when "filed" then "warning"
                 when "under_review" then "info"
                 when "hearing_scheduled" then "primary"
                 when "decided" then "success"
                 when "appealed" then "warning"
                 when "closed" then "secondary"
                 else "light"
                 end %>
      <span class="badge bg-<%= color %>-subtle text-<%= color %> px-3 py-2">
        <%= @dispute.status.titleize %>
      </span>
      <%= link_to admin_election_election_disputes_path(@election.id),
                  class: "btn btn-sm btn-outline-secondary" do %>
        <i class="ri-arrow-left-line me-1"></i> Retounen
      <% end %>
    </div>
  </div>

  <div class="row g-4">

    <%# ── Left: subject + filer + evidence ── %>
    <div class="col-lg-8">
      <div class="pp-card card mb-3">
        <div class="card-header">
          <h6 class="mb-0 fw-semibold pp-text-sm">Detay Kontestasyon</h6>
        </div>
        <div class="card-body p-4">
          <dl class="row mb-0 pp-text-sm">
            <dt class="col-sm-3 text-muted">Sijè</dt>
            <dd class="col-sm-9 fw-semibold"><%= @dispute.subject %></dd>

            <dt class="col-sm-3 text-muted">Tip</dt>
            <dd class="col-sm-9"><%= @dispute.dispute_type.titleize %></dd>

            <dt class="col-sm-3 text-muted">Priyorite</dt>
            <dd class="col-sm-9">
              <% if @dispute.priority == "urgent" %>
                <span class="badge bg-danger">IJAN</span>
              <% else %>
                <%= @dispute.priority&.titleize || "—" %>
              <% end %>
            </dd>

            <dt class="col-sm-3 text-muted">Sikonskripsyon</dt>
            <dd class="col-sm-9">
              <%= @dispute.constituency&.constituency_name.presence || "—" %>
            </dd>

            <dt class="col-sm-3 text-muted">Depatman</dt>
            <dd class="col-sm-9"><%= @dispute.department_code.presence || "—" %></dd>

            <% if @dispute.description.present? %>
              <dt class="col-sm-3 text-muted mt-2">Deskripsyon</dt>
              <dd class="col-sm-9 mt-2"><%= simple_format(@dispute.description) %></dd>
            <% end %>

            <% if @dispute.evidence_summary.present? %>
              <dt class="col-sm-3 text-muted mt-2">Prèv</dt>
              <dd class="col-sm-9 mt-2"><%= simple_format(@dispute.evidence_summary) %></dd>
            <% end %>
          </dl>
        </div>
      </div>

      <div class="pp-card card">
        <div class="card-header">
          <h6 class="mb-0 fw-semibold pp-text-sm">Moun ki depoze</h6>
        </div>
        <div class="card-body p-4">
          <dl class="row mb-0 pp-text-sm">
            <dt class="col-sm-3 text-muted">Non</dt>
            <dd class="col-sm-9"><%= @dispute.filed_by_name %></dd>
            <dt class="col-sm-3 text-muted">Tip</dt>
            <dd class="col-sm-9"><%= @dispute.filed_by_type.titleize %></dd>
            <% if @dispute.filed_by_bonid.present? %>
              <dt class="col-sm-3 text-muted">BonID</dt>
              <dd class="col-sm-9"><code><%= @dispute.filed_by_bonid %></code></dd>
            <% end %>
            <% if @dispute.filed_by_organization.present? %>
              <dt class="col-sm-3 text-muted">Òganizasyon</dt>
              <dd class="col-sm-9"><%= @dispute.filed_by_organization %></dd>
            <% end %>
          </dl>
        </div>
      </div>

      <% if @dispute.decided? || @dispute.status == "appealed" %>
        <div class="pp-card card mt-3">
          <div class="card-header bg-success-subtle">
            <h6 class="mb-0 fw-semibold pp-text-sm">Desizyon BCEN</h6>
          </div>
          <div class="card-body p-4">
            <div class="mb-2">
              <span class="badge bg-<%= @dispute.decision_type == 'upheld' ? 'success' : (@dispute.decision_type == 'dismissed' ? 'secondary' : 'info') %>-subtle">
                <%= @dispute.decision_type&.titleize %>
              </span>
              <small class="text-muted ms-2">
                <%= @dispute.decided_at&.strftime("%d %b %Y %H:%M") %>
              </small>
            </div>
            <div class="pp-text-sm"><%= simple_format(@dispute.decision) %></div>
            <% if @dispute.appeal_deadline&.future? %>
              <div class="alert alert-warning small mt-3 mb-0">
                <i class="ri-time-line me-1"></i>
                Delè apèl: <%= @dispute.appeal_deadline.strftime("%d %b %Y %H:%M") %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <%# ── Right: actions + timeline ── %>
    <div class="col-lg-4">
      <div class="pp-card card">
        <div class="card-header">
          <h6 class="mb-0 fw-semibold pp-text-sm">Aksyon BCEN</h6>
        </div>
        <div class="card-body p-3 d-grid gap-2">

          <% if @dispute.status == "filed" %>
            <%= button_to admin_start_review_election_election_dispute_path(@election.id, @dispute),
                          method: :post,
                          class: "btn btn-outline-primary btn-sm" do %>
              <i class="ri-search-eye-line me-1"></i> Kòmanse revizyon
            <% end %>
          <% end %>

          <% if @dispute.open? %>
            <button type="button"
                    class="btn btn-primary btn-sm"
                    data-bs-toggle="modal"
                    data-bs-target="#scheduleHearingModal">
              <i class="ri-calendar-event-line me-1"></i> Pwograme odyans
            </button>
            <button type="button"
                    class="btn btn-success btn-sm"
                    data-bs-toggle="modal"
                    data-bs-target="#decideModal">
              <i class="ri-gavel-line me-1"></i> Pran desizyon
            </button>
          <% end %>

          <% if @dispute.decided? %>
            <%= button_to admin_close_election_election_dispute_path(@election.id, @dispute),
                          method: :post,
                          class: "btn btn-outline-secondary btn-sm",
                          data: { turbo_confirm: "Fèmen kontestasyon an?" } do %>
              <i class="ri-lock-line me-1"></i> Fèmen dosye
            <% end %>
          <% end %>

          <% if @dispute.status == "closed" %>
            <div class="alert alert-secondary small mb-0">
              <i class="ri-lock-line me-1"></i>
              Dosye fèmen. Okenn aksyon pa posib.
            </div>
          <% end %>
        </div>
      </div>

      <div class="pp-card card mt-3">
        <div class="card-header">
          <h6 class="mb-0 fw-semibold pp-text-sm">Istwa</h6>
        </div>
        <ul class="list-group list-group-flush pp-text-xs">
          <% if @dispute.filed_at %>
            <li class="list-group-item">
              <span class="text-muted">Depoze:</span>
              <%= @dispute.filed_at.strftime("%d %b %Y %H:%M") %>
            </li>
          <% end %>
          <% if @dispute.assigned_to.present? %>
            <li class="list-group-item">
              <span class="text-muted">Asiyen:</span>
              <%= @dispute.assigned_to %>
            </li>
          <% end %>
          <% if @dispute.hearing_at %>
            <li class="list-group-item">
              <span class="text-muted">Odyans:</span>
              <%= @dispute.hearing_at.strftime("%d %b %Y %H:%M") %>
            </li>
          <% end %>
          <% if @dispute.decided_at %>
            <li class="list-group-item">
              <span class="text-muted">Desizyon:</span>
              <%= @dispute.decided_at.strftime("%d %b %Y %H:%M") %>
            </li>
          <% end %>
          <% if @dispute.appeal_deadline %>
            <li class="list-group-item">
              <span class="text-muted">Delè apèl:</span>
              <%= @dispute.appeal_deadline.strftime("%d %b %Y") %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>

<%# ── Schedule hearing modal ── %>
<% if @dispute.open? %>
  <div class="modal fade" id="scheduleHearingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <%= form_with url: admin_schedule_hearing_election_election_dispute_path(@election.id, @dispute),
                      method: :post, local: true do |f| %>
          <div class="modal-header bg-primary-subtle">
            <h5 class="modal-title fw-bold">
              <i class="ri-calendar-event-line me-1"></i>Pwograme Odyans
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <label class="form-label fw-semibold pp-text-sm">Dat ak lè odyans</label>
            <%= datetime_field_tag :hearing_at,
                  (@dispute.hearing_at || (Time.current + 3.days)).strftime("%Y-%m-%dT%H:%M"),
                  class: "form-control", required: true %>
            <small class="text-muted">Pati yo ap resevwa konvokasyon ofisyèl.</small>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Anile</button>
            <button type="submit" class="btn btn-primary">Pwograme</button>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# ── Decide modal ── %>
  <div class="modal fade" id="decideModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content">
        <%= form_with url: admin_decide_election_election_dispute_path(@election.id, @dispute),
                      method: :post, local: true do |f| %>
          <div class="modal-header bg-success-subtle">
            <h5 class="modal-title fw-bold">
              <i class="ri-gavel-line me-1"></i>Desizyon BCEN
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label fw-semibold pp-text-sm">Tip desizyon</label>
              <%= select_tag :decision_type,
                    options_for_select([
                      ["Akeyi (Upheld)", "upheld"],
                      ["Rejte (Dismissed)", "dismissed"],
                      ["Akeyi pasyèl (Partial)", "partial"],
                      ["Voye nan lòt enstans (Referred)", "referred"]
                    ]),
                    { prompt: "Chwazi tip", class: "form-select", required: true } %>
            </div>
            <div>
              <label class="form-label fw-semibold pp-text-sm">Tèks desizyon (obligatwa)</label>
              <textarea name="decision" class="form-control" rows="6" required
                        placeholder="Ekri motif desizyon BCEN a — baze sou Dekrè Elektoral…"></textarea>
            </div>
            <div class="alert alert-warning small mt-3 mb-0">
              <i class="ri-information-line me-1"></i>
              Apre desizyon an, delè apèl 5 jou ap kòmanse otomatikman.
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Anile</button>
            <button type="submit" class="btn btn-success"
                    data-turbo-confirm="Konfime desizyon an? Sa pa ka anile san pwosè apèl.">
              Anrejistre desizyon
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
