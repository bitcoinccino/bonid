<%# app/views/election/admin/results.html.erb %>
<%# Official Results — shown after Multi-Sig decryption %>

<div class="container-fluid py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">

      <%# ── Header ── %>
      <div class="text-center mb-4">
        <div class="pp-text-xs fw-bold pp-text-brand text-uppercase mb-1" style="letter-spacing: 2px;">
          REPIBLIK D'AYITI &middot; KONSÈY ELEKTORAL PWOVIZWA
        </div>
        <h4 class="pp-page-title">Rezilta Ofisyèl — Dyaspora</h4>
        <p class="pp-page-subtitle">
          Eleksyon Jeneral &middot; 30 Out 2026 &middot; Premye Tou
        </p>
        <div class="mt-2">
          <% if @election&.certified? %>
            <span class="badge bg-success-subtle text-success px-3 py-1 pp-text-xs">
              <i class="ri-shield-check-line me-1"></i>
              SÈTIFYE &middot; OFISYÈL
            </span>
          <% else %>
            <span class="badge bg-success-subtle text-success px-3 py-1 pp-text-xs">
              <span class="d-inline-block rounded-circle bg-success me-1" style="width: 6px; height: 6px;"></span>
              DECHIFRE
            </span>
          <% end %>
        </div>

        <%# Certify CTA — available once quorum is met and election closed.
            Opens a typed-confirmation modal rather than firing a single
            click, because certification is legally frozen and irreversible. %>
        <% if @election && @election.closed? && @sig_status&.dig(:met) %>
          <div class="mt-3">
            <button type="button"
                    class="btn btn-success"
                    data-bs-toggle="modal"
                    data-bs-target="#certifyElectionModal">
              <i class="ri-shield-check-line me-1"></i>
              Sètifye Eleksyon An
            </button>
            <div class="pp-text-xs text-muted mt-1">
              Aksyon sa ap anrejistre genyan yo nan rejis eleksyon ki sètifye yo.
            </div>
          </div>

          <%# ── Certification confirmation modal ── %>
          <div class="modal fade"
               id="certifyElectionModal"
               tabindex="-1"
               aria-labelledby="certifyElectionModalLabel"
               aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content">
                <%= form_with url: admin_election_election_certify_path(@election.id),
                              method: :post,
                              local: true,
                              html: { id: "certifyElectionForm" } do |f| %>
                  <div class="modal-header bg-success-subtle border-0">
                    <h5 class="modal-title fw-bold" id="certifyElectionModalLabel">
                      <i class="ri-shield-check-line me-1"></i>
                      Sètifikasyon Final Eleksyon
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                  </div>

                  <div class="modal-body">
                    <div class="alert alert-warning small mb-3">
                      <i class="ri-alarm-warning-line me-1"></i>
                      <strong>Atansyon:</strong> Yon fwa yon eleksyon sètifye, rezilta yo
                      <em>pa kapab modifye</em>. Genyan yo ap ekri nan rejis la pou toujou.
                      Sa a se yon aksyon legal — pa klike si w pa si.
                    </div>

                    <dl class="small mb-3">
                      <dt class="text-muted">Tit Eleksyon</dt>
                      <dd class="fw-bold"><%= @election.title %></dd>
                      <dt class="text-muted">Dat</dt>
                      <dd><%= @election.election_date&.strftime("%-d %b %Y") %></dd>
                      <dt class="text-muted">Tou</dt>
                      <dd><%= @election.round %><%= " (rannou)" if @election.runoff? %></dd>
                    </dl>

                    <div class="mb-3">
                      <label for="confirmation_phrase" class="form-label fw-semibold">
                        Pou konfime, tape tit eleksyon an egzakteman:
                      </label>
                      <div class="pp-text-xs text-muted mb-2 font-monospace">
                        <%= @election.title %>
                      </div>
                      <input type="text"
                             name="confirmation_phrase"
                             id="confirmation_phrase"
                             class="form-control"
                             autocomplete="off"
                             spellcheck="false"
                             required
                             placeholder="Tape tit la isit la…"
                             data-expected-phrase="<%= @election.title.to_s.strip.downcase %>">
                    </div>

                    <div class="form-check mb-0">
                      <input type="checkbox"
                             class="form-check-input"
                             id="confirmation_ack"
                             name="confirmation_ack"
                             value="1"
                             required>
                      <label class="form-check-label small" for="confirmation_ack">
                        Mwen konprann ke aksyon sa a pa kapab defèt, epi mwen otorize
                        sètifikasyon final rezilta yo.
                      </label>
                    </div>
                  </div>

                  <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                      Anile
                    </button>
                    <%= f.submit "Sètifye Definitivman",
                                 id: "certifyElectionSubmit",
                                 class: "btn btn-success",
                                 disabled: true,
                                 data: { turbo_confirm: "Dènye verifikasyon: ou si ou vle sètifye eleksyon sa a?" } %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>

          <script>
            // Live-validate the typed phrase + ack checkbox. The submit
            // button unlocks only when both match — client-side UX sugar.
            // Server still enforces the same guard for safety.
            (function () {
              var form  = document.getElementById("certifyElectionForm");
              if (!form) return;
              var phraseInput = form.querySelector("#confirmation_phrase");
              var ackInput    = form.querySelector("#confirmation_ack");
              var submitBtn   = form.querySelector("#certifyElectionSubmit");
              var expected    = (phraseInput.dataset.expectedPhrase || "").trim().toLowerCase();

              function normalize(s) { return (s || "").trim().toLowerCase(); }
              function evaluate() {
                submitBtn.disabled = !(normalize(phraseInput.value) === expected && ackInput.checked);
              }
              phraseInput.addEventListener("input",  evaluate);
              ackInput.addEventListener("change",    evaluate);
              evaluate();
            })();
          </script>
        <% end %>
      </div>

      <%# ── Total Participation ── %>
      <div class="pp-card card mb-4">
        <div class="card-body p-4 text-center">
          <div class="pp-text-xs fw-semibold pp-text-secondary text-uppercase mb-1">Patisipasyon Total Dyaspora</div>
          <div class="fw-bold pp-text-4xl pp-text-primary"><%= number_with_delimiter(@stats[:total_votes] || 0) %></div>
          <div class="pp-text-sm pp-text-secondary">
            vòt konte nan <%= (@stats[:by_country] || {}).size %> peyi
          </div>
        </div>
      </div>

      <%# ── Candidate Results ── %>
      <% total = (@results[:candidates] || {}).values.sum.to_f %>
      <% sorted_candidates = (@results[:candidates] || {}).sort_by { |_, v| -v } %>

      <% sorted_candidates.each_with_index do |(candidate, votes), index| %>
        <% percentage = total > 0 ? ((votes.to_f / total) * 100).round(1) : 0 %>
        <% is_winner = index == 0 && percentage > 50 %>

        <div class="pp-card card mb-3 <%= is_winner ? 'border-warning' : '' %>">
          <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start mb-3">
              <div>
                <h5 class="fw-bold mb-0 pp-text-base"><%= candidate %></h5>
              </div>
              <div class="text-end">
                <% if is_winner %>
                  <span class="badge bg-warning text-dark fw-bold pp-badge-sm mb-1">Eli</span><br>
                <% end %>
                <span class="fw-bold pp-text-xl <%= is_winner ? 'pp-text-warning' : index == 1 ? 'pp-text-info' : 'pp-text-secondary' %>">
                  <%= percentage %>%
                </span>
                <div class="pp-text-xs pp-text-secondary"><%= number_with_delimiter(votes) %> vòt</div>
              </div>
            </div>
            <div class="progress" style="height: 8px;">
              <div class="progress-bar <%= is_winner ? 'bg-warning' : index == 1 ? 'bg-primary' : 'bg-secondary' %>"
                   style="width: <%= percentage %>%;"></div>
            </div>
          </div>
        </div>
      <% end %>

      <% if sorted_candidates.empty? %>
        <div class="pp-card card">
          <div class="pp-empty-state">
            <i class="ri-lock-line"></i>
            <h6>Rezilta yo ap trete...</h6>
          </div>
        </div>
      <% end %>

      <%# ── Integrity Certificate ── %>
      <div class="pp-card card mb-4 mt-4">
        <div class="card-header px-4 py-3">
          <h6 class="fw-semibold mb-0 pp-text-sm d-flex align-items-center gap-2">
            <i class="ri-shield-check-line pp-text-success"></i>
            Sètifika Entegrite
          </h6>
        </div>
        <div class="card-body p-4">
          <div class="row g-3">
            <div class="col-md-6">
              <div class="pp-text-xs pp-text-secondary mb-1">Merkle Root</div>
              <code class="pp-text-xs pp-text-brand d-block" style="word-break: break-all;">
                <%= @integrity[:merkle_root] || "N/A" %>
              </code>
            </div>
            <div class="col-md-6">
              <div class="pp-text-xs pp-text-secondary mb-1">Dechifre pa</div>
              <div class="fw-semibold pp-text-sm">
                <%= @sig_status[:signatories]&.map { |s| s[:name] }&.join(", ") || "N/A" %>
              </div>
            </div>
            <div class="col-md-6">
              <div class="pp-text-xs pp-text-secondary mb-1">Dechifre le</div>
              <div class="fw-semibold pp-text-sm">
                <%= @results[:decrypted_at] ? Time.parse(@results[:decrypted_at]).strftime("%d %b %Y à %H:%M:%S") : "N/A" %>
              </div>
            </div>
            <div class="col-md-6">
              <div class="pp-text-xs pp-text-secondary mb-1">Protokòl</div>
              <div class="fw-semibold pp-text-sm pp-text-brand">
                Pedersen + Schnorr ZKP + AES-256-GCM
              </div>
            </div>
          </div>
        </div>
      </div>

      <%# ── Footer ── %>
      <div class="text-center py-3">
        <p class="pp-text-xs pp-text-muted mb-0">
          Rezilta sa yo jere pa Pedersen Commitment ak verifikasyon homomòfik.<br>
          Vòt endividyèl yo pa janm dechifre — sèlman total agreje a vizib.<br>
          &copy; 2026 Konsèy &Eacute;lektoral Pwovizwa &middot; BonID / Verifyem
        </p>
      </div>

    </div>
  </div>
</div>
