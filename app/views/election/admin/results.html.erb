<%# app/views/election/admin/results.html.erb %>
<%# Official Results — shown after Multi-Sig decryption %>

<div class="container-fluid py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">

      <%# ── Header ── %>
      <div class="text-center mb-4">
        <div class="pp-text-xs fw-bold pp-text-brand text-uppercase mb-1" style="letter-spacing: 2px;">
          REPIBLIK D'AYITI &middot; KONSÈY ELEKTORAL PWOVIZWA
        </div>
        <h4 class="pp-page-title">Rezilta Ofisyèl — Dyaspora</h4>
        <p class="pp-page-subtitle">
          Eleksyon Jeneral &middot; 30 Out 2026 &middot; Premye Tou
        </p>
        <div class="mt-2">
          <% if @election&.certified? %>
            <span class="badge bg-success-subtle text-success px-3 py-1 pp-text-xs">
              <i class="ri-shield-check-line me-1"></i>
              SÈTIFYE &middot; OFISYÈL
            </span>
          <% else %>
            <span class="badge bg-success-subtle text-success px-3 py-1 pp-text-xs">
              <span class="d-inline-block rounded-circle bg-success me-1" style="width: 6px; height: 6px;"></span>
              DECHIFRE
            </span>
          <% end %>
        </div>

        <%# Certify CTA — available once quorum is met and election closed. %>
        <% if @election && @election.closed? && @sig_status&.dig(:met) %>
          <div class="mt-3">
            <%= button_to admin_election_election_certify_path(@election.id),
                          method: :post,
                          class: "btn btn-success",
                          data: { turbo_confirm: "Konfime sètifikasyon final? Sa ap anrejistre genyan yo pèmanan." } do %>
              <i class="ri-shield-check-line me-1"></i>
              Sètifye Eleksyon An
            <% end %>
            <div class="pp-text-xs text-muted mt-1">
              Aksyon sa ap anrejistre genyan yo nan rejis eleksyon ki sètifye yo.
            </div>
          </div>
        <% end %>
      </div>

      <%# ── Total Participation ── %>
      <div class="pp-card card mb-4">
        <div class="card-body p-4 text-center">
          <div class="pp-text-xs fw-semibold pp-text-secondary text-uppercase mb-1">Patisipasyon Total Dyaspora</div>
          <div class="fw-bold pp-text-4xl pp-text-primary"><%= number_with_delimiter(@stats[:total_votes] || 0) %></div>
          <div class="pp-text-sm pp-text-secondary">
            vòt konte nan <%= (@stats[:by_country] || {}).size %> peyi
          </div>
        </div>
      </div>

      <%# ── Candidate Results ── %>
      <% total = (@results[:candidates] || {}).values.sum.to_f %>
      <% sorted_candidates = (@results[:candidates] || {}).sort_by { |_, v| -v } %>

      <% sorted_candidates.each_with_index do |(candidate, votes), index| %>
        <% percentage = total > 0 ? ((votes.to_f / total) * 100).round(1) : 0 %>
        <% is_winner = index == 0 && percentage > 50 %>

        <div class="pp-card card mb-3 <%= is_winner ? 'border-warning' : '' %>">
          <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start mb-3">
              <div>
                <h5 class="fw-bold mb-0 pp-text-base"><%= candidate %></h5>
              </div>
              <div class="text-end">
                <% if is_winner %>
                  <span class="badge bg-warning text-dark fw-bold pp-badge-sm mb-1">Eli</span><br>
                <% end %>
                <span class="fw-bold pp-text-xl <%= is_winner ? 'pp-text-warning' : index == 1 ? 'pp-text-info' : 'pp-text-secondary' %>">
                  <%= percentage %>%
                </span>
                <div class="pp-text-xs pp-text-secondary"><%= number_with_delimiter(votes) %> vòt</div>
              </div>
            </div>
            <div class="progress" style="height: 8px;">
              <div class="progress-bar <%= is_winner ? 'bg-warning' : index == 1 ? 'bg-primary' : 'bg-secondary' %>"
                   style="width: <%= percentage %>%;"></div>
            </div>
          </div>
        </div>
      <% end %>

      <% if sorted_candidates.empty? %>
        <div class="pp-card card">
          <div class="pp-empty-state">
            <i class="ri-lock-line"></i>
            <h6>Rezilta yo ap trete...</h6>
          </div>
        </div>
      <% end %>

      <%# ── Integrity Certificate ── %>
      <div class="pp-card card mb-4 mt-4">
        <div class="card-header px-4 py-3">
          <h6 class="fw-semibold mb-0 pp-text-sm d-flex align-items-center gap-2">
            <i class="ri-shield-check-line pp-text-success"></i>
            Sètifika Entegrite
          </h6>
        </div>
        <div class="card-body p-4">
          <div class="row g-3">
            <div class="col-md-6">
              <div class="pp-text-xs pp-text-secondary mb-1">Merkle Root</div>
              <code class="pp-text-xs pp-text-brand d-block" style="word-break: break-all;">
                <%= @integrity[:merkle_root] || "N/A" %>
              </code>
            </div>
            <div class="col-md-6">
              <div class="pp-text-xs pp-text-secondary mb-1">Dechifre pa</div>
              <div class="fw-semibold pp-text-sm">
                <%= @sig_status[:signatories]&.map { |s| s[:name] }&.join(", ") || "N/A" %>
              </div>
            </div>
            <div class="col-md-6">
              <div class="pp-text-xs pp-text-secondary mb-1">Dechifre le</div>
              <div class="fw-semibold pp-text-sm">
                <%= @results[:decrypted_at] ? Time.parse(@results[:decrypted_at]).strftime("%d %b %Y à %H:%M:%S") : "N/A" %>
              </div>
            </div>
            <div class="col-md-6">
              <div class="pp-text-xs pp-text-secondary mb-1">Protokòl</div>
              <div class="fw-semibold pp-text-sm pp-text-brand">
                Pedersen + Schnorr ZKP + AES-256-GCM
              </div>
            </div>
          </div>
        </div>
      </div>

      <%# ── Footer ── %>
      <div class="text-center py-3">
        <p class="pp-text-xs pp-text-muted mb-0">
          Rezilta sa yo jere pa Pedersen Commitment ak verifikasyon homomòfik.<br>
          Vòt endividyèl yo pa janm dechifre — sèlman total agreje a vizib.<br>
          &copy; 2026 Konsèy &Eacute;lektoral Pwovizwa &middot; BonID / Verifyem
        </p>
      </div>

    </div>
  </div>
</div>
