<%# app/views/election/admin/party_registrations/index.html.erb %>
<%# CEP admin — party / grouping registration review queue (Article 143). %>

<div class="container-fluid py-4">

  <%# ── Header ── %>
  <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
      <h4 class="pp-page-title">
        <i class="ri-flag-2-line me-2 pp-text-brand"></i>Pati Politik
      </h4>
      <p class="pp-page-subtitle">
        Enskripsyon pati ak regroupman pou <%= @election.title %>
      </p>
    </div>
    <%= link_to admin_election_election_path(@election.id),
                class: "btn btn-sm btn-outline-secondary" do %>
      <i class="ri-arrow-left-line me-1"></i> Retounen Tablo CEP
    <% end %>
  </div>

  <%# ── Stats ── %>
  <div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
      <div class="pp-card card p-3">
        <div class="pp-stat-label">Total</div>
        <div class="fw-bold pp-text-2xl pp-text-brand"><%= @stats[:total] %></div>
        <div class="pp-text-xs text-muted">
          <%= @stats[:parties] %> pati · <%= @stats[:groupings] %> regroupman
        </div>
      </div>
    </div>
    <div class="col-md-3 col-6">
      <div class="pp-card card p-3">
        <div class="pp-stat-label">Anba revizyon</div>
        <div class="fw-bold pp-text-2xl pp-text-warning">
          <%= @stats[:submitted] + @stats[:under_review] %>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-6">
      <div class="pp-card card p-3">
        <div class="pp-stat-label">Apwouve</div>
        <div class="fw-bold pp-text-2xl pp-text-success"><%= @stats[:approved] %></div>
      </div>
    </div>
    <div class="col-md-3 col-6">
      <div class="pp-card card p-3">
        <div class="pp-stat-label">Rejte</div>
        <div class="fw-bold pp-text-2xl pp-text-danger"><%= @stats[:rejected] %></div>
      </div>
    </div>
  </div>

  <%# ── Filters ── %>
  <div class="pp-card card mb-3">
    <div class="card-body p-3">
      <%= form_with url: admin_election_election_party_registrations_path(@election.id),
                    method: :get, local: true,
                    class: "d-flex gap-2 flex-wrap align-items-center" do %>
        <%= select_tag :status,
                       options_for_select(
                         [["Tout estati", ""]] + ElectionPartyRegistration::STATUSES.map { |s| [s.titleize, s] },
                         params[:status]
                       ),
                       class: "form-select form-select-sm w-auto" %>
        <%= select_tag :registration_type,
                       options_for_select(
                         [["Tout tip", ""]] + ElectionPartyRegistration::REGISTRATION_TYPES.map { |t| [t.titleize, t] },
                         params[:registration_type]
                       ),
                       class: "form-select form-select-sm w-auto" %>
        <%= text_field_tag :search, params[:search],
                           class: "form-control form-control-sm flex-grow-1",
                           placeholder: "Chèche pa non pati, sigl, oswa reprezantan…" %>
        <button class="btn btn-sm btn-primary">Filtre</button>
        <%= link_to "Reset", admin_election_election_party_registrations_path(@election.id),
                    class: "btn btn-sm btn-outline-secondary" %>
      <% end %>
    </div>
  </div>

  <%# ── Table ── %>
  <div class="pp-card card">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th class="pp-text-xs">Pati</th>
            <th class="pp-text-xs">Tip</th>
            <th class="pp-text-xs">Reprezantan</th>
            <th class="pp-text-xs">Dokiman</th>
            <th class="pp-text-xs">Kandida</th>
            <th class="pp-text-xs">Estati</th>
            <th class="pp-text-xs">Soumèt</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @registrations.each do |r| %>
            <tr>
              <td>
                <div class="fw-semibold"><%= r.party_name %></div>
                <% if r.party_acronym.present? %>
                  <div class="pp-text-xs pp-text-secondary"><%= r.party_acronym %></div>
                <% end %>
              </td>
              <td class="pp-text-sm"><%= r.type_label %></td>
              <td>
                <div class="pp-text-sm"><%= r.representative_name %></div>
                <div class="pp-text-xs pp-text-secondary"><%= r.representative_bonid.presence || r.representative_cin.presence || "—" %></div>
              </td>
              <td>
                <div class="progress" style="height: 6px; width: 80px;">
                  <div class="progress-bar bg-success" style="width: <%= r.documents_progress_percentage %>%"></div>
                </div>
                <div class="pp-text-xs pp-text-secondary mt-1">
                  <%= r.documents_submitted_count %>/<%= r.documents_total_count %>
                </div>
              </td>
              <td class="pp-text-sm"><%= r.candidates.count %></td>
              <td>
                <span class="badge bg-<%= r.status_color %>-subtle text-<%= r.status_color %>">
                  <%= r.status_label %>
                </span>
              </td>
              <td class="pp-text-xs pp-text-secondary">
                <%= r.submitted_at&.strftime("%d %b %Y") || "—" %>
              </td>
              <td class="text-end">
                <%= link_to admin_election_election_party_registration_path(@election.id, r),
                            class: "btn btn-sm btn-outline-primary" do %>
                  Wè
                <% end %>
              </td>
            </tr>
          <% end %>
          <% if @registrations.empty? %>
            <tr><td colspan="8" class="text-center text-muted py-4">Pa gen enskripsyon ki koresponn.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <% if @registrations.respond_to?(:total_pages) && @registrations.total_pages > 1 %>
    <div class="mt-3">
      <%= paginate @registrations if respond_to?(:paginate) %>
    </div>
  <% end %>

</div>
