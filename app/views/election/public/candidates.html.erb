<%# app/views/election/public/candidates.html.erb %>
<%# Public roster of approved candidates — shown before and during the
    campaign so citizens know who's on the ballot. Read-only, no auth,
    CDN-cacheable (5 min). Only candidates with registration_status
    "approved" appear — anything still under CEP review stays private. %>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Kandida Ofisyèl — Eleksyon Ayiti 2026</title>
  <meta name="description" content="Lis kandida apwouve pa Konsèy Elektoral Pwovizwa pou Eleksyon Jeneral 2026.">
  <%= render "election/shared/bonvote_theme", sparkle_count: 0 %>
  <style>
    .candidate-card {
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 12px;
      padding: 1.25rem;
      background: rgba(255,255,255,0.04);
      transition: transform 0.15s;
    }
    .candidate-card:hover { transform: translateY(-2px); }
    .candidate-photo {
      width: 64px; height: 64px; border-radius: 50%;
      object-fit: cover; background: rgba(255,255,255,0.1);
      flex-shrink: 0;
    }
    .candidate-photo-placeholder {
      width: 64px; height: 64px; border-radius: 50%;
      background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.4);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.5rem; flex-shrink: 0;
    }
    .section-header {
      border-left: 4px solid #0066cc;
      padding-left: 1rem;
      margin: 2.5rem 0 1rem;
    }
    .constituency-group { margin-bottom: 2rem; }
    .constituency-label {
      font-size: 0.75rem; text-transform: uppercase;
      letter-spacing: 1px; opacity: 0.7;
      margin-bottom: 0.75rem;
    }
  </style>
</head>
<body>
  <div class="container py-5" style="max-width: 1100px;">

    <header class="text-center mb-5">
      <div class="pp-text-xs fw-bold text-uppercase mb-2" style="letter-spacing: 2px; opacity: 0.7;">
        Repiblik d'Ayiti · Konsèy Elektoral Pwovizwa
      </div>
      <h1 class="fw-bold mb-2" style="font-size: clamp(1.8rem, 4vw, 2.6rem);">
        Kandida Ofisyèl
      </h1>
      <p class="lead mb-0" style="opacity: 0.85;">
        <%= @election&.title || "Eleksyon Jeneral 2026" %>
      </p>
      <% if @election&.election_date %>
        <p class="small mb-0" style="opacity: 0.7;">
          <%= @election.election_date.strftime("%-d %B %Y") %>
        </p>
      <% end %>
      <div class="mt-3">
        <span class="badge bg-success-subtle text-success px-3 py-2">
          <%= @total_approved %> kandida apwouve pa CEP
        </span>
      </div>
    </header>

    <% if @total_approved.zero? %>
      <div class="text-center py-5" style="opacity: 0.7;">
        <i class="ri-user-search-line" style="font-size: 3rem;"></i>
        <p class="mt-3">Pa gen kandida ki apwouve pou moman an.</p>
        <p class="small">CEP a ap revize dosye kandida yo. Retounen pi ta.</p>
      </div>
    <% end %>

    <%# ── Presidents ── %>
    <% if @presidents.any? %>
      <section>
        <div class="section-header">
          <h3 class="fw-bold mb-0">Prezidans</h3>
          <div class="small" style="opacity: 0.7;"><%= @presidents.size %> kandida</div>
        </div>
        <div class="row g-3">
          <% @presidents.each do |c| %>
            <div class="col-md-6 col-lg-4">
              <%= render "election/public/candidate_card", candidate: c %>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <%# ── Senators (grouped by department) ── %>
    <% if @senators_by_department.any? %>
      <section>
        <div class="section-header">
          <h3 class="fw-bold mb-0">Senatè</h3>
          <div class="small" style="opacity: 0.7;">
            <%= @senators_by_department.values.sum(&:size) %> kandida
            nan <%= @senators_by_department.size %> depatman
          </div>
        </div>
        <% @senators_by_department.sort.each do |dept, list| %>
          <div class="constituency-group">
            <div class="constituency-label">Depatman: <%= dept %></div>
            <div class="row g-3">
              <% list.each do |c| %>
                <div class="col-md-6 col-lg-4">
                  <%= render "election/public/candidate_card", candidate: c %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </section>
    <% end %>

    <%# ── Deputies (grouped by commune) ── %>
    <% if @deputies_by_commune.any? %>
      <section>
        <div class="section-header">
          <h3 class="fw-bold mb-0">Depite</h3>
          <div class="small" style="opacity: 0.7;">
            <%= @deputies_by_commune.values.sum(&:size) %> kandida
            nan <%= @deputies_by_commune.size %> komin
          </div>
        </div>
        <% @deputies_by_commune.sort.each do |commune, list| %>
          <div class="constituency-group">
            <div class="constituency-label">Komin: <%= commune %></div>
            <div class="row g-3">
              <% list.each do |c| %>
                <div class="col-md-6 col-lg-4">
                  <%= render "election/public/candidate_card", candidate: c %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </section>
    <% end %>

    <footer class="text-center py-4 mt-5 small" style="opacity: 0.6;">
      <p class="mb-0">
        Lis sa a reprezante sèlman kandida yo ki te apwouve pa
        Konsèy Elektoral Pwovizwa pou aparèt sou bilten vòt la.
      </p>
      <p class="mb-0">
        Kandida ki nan revizyon yo pa vizib.
        Dènye aktyalizasyon: <%= Time.current.strftime("%-d %b %Y %H:%M") %> UTC.
      </p>
    </footer>

  </div>
</body>
</html>
