<%# Single approved-candidate card used by the public roster. %>
<div class="candidate-card h-100">
  <div class="d-flex gap-3 align-items-center">
    <% photo = candidate.candidate_photo_url %>
    <% if photo.present? %>
      <img src="<%= photo %>" alt="<%= candidate.full_name %>" class="candidate-photo">
    <% else %>
      <div class="candidate-photo-placeholder">
        <i class="ri-user-line"></i>
      </div>
    <% end %>
    <div class="flex-grow-1" style="min-width: 0;">
      <div class="fw-bold text-truncate" style="font-size: 1rem;">
        <%= candidate.full_name %>
      </div>
      <% if candidate.party_name.present? %>
        <div class="small text-truncate" style="opacity: 0.75;">
          <%= candidate.party_acronym.presence || candidate.party_name %>
        </div>
      <% elsif candidate.candidacy_type == "independent" %>
        <div class="small" style="opacity: 0.65;"><em>Endepandan</em></div>
      <% end %>
      <% if candidate.ballot_number.present? %>
        <div class="small mt-1" style="opacity: 0.6;">
          Nimewo bilten: <strong><%= candidate.ballot_number %></strong>
        </div>
      <% end %>
    </div>
  </div>

  <% if candidate.registration_status == "preliminary_listed" %>
    <%# Article 192 — 48-hour contestation window %>
    <div class="mt-3 pt-3" style="border-top: 1px solid rgba(255,255,255,0.08);">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="badge bg-warning-subtle text-warning">
          <i class="ri-list-check-2"></i> Sou lis preliminè
        </span>
        <% if candidate.contestation_window_open? %>
          <%= link_to citizens_election_contest_candidate_new_path(election_candidate_id: candidate.id),
                      class: "small text-decoration-none",
                      style: "color: #ffb347;" do %>
            Konteste kandidati sa →
          <% end %>
        <% end %>
      </div>
      <% if candidate.contestation_window_open? %>
        <div class="small mt-1" style="opacity: 0.55;">
          Fenèt kontestasyon fèmen <%= time_ago_in_words(candidate.contestation_window_closes_at) %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
