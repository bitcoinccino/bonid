<%# app/views/election/audit/verify.html.erb %>
<%# Public Bulletin Board · Haiti's most important URL on election day.
    No login required. No PII exposed. Zero-leakage verification.
    Standalone layout matching results page styling. %>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= t("bonvote.title") %></title>
  <meta name="description" content="<%= t("bonvote.hero_sub") %>">
  <%= render "election/shared/bonvote_theme", sparkle_count: 10 %>
  <style>
    /* ── Verify page-specific styles ── */

    /* Two-column grid */
    .verify-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      align-items: start;
    }
    .verify-left { min-width: 0; }
    .verify-right { min-width: 0; position: sticky; top: 2rem; }

    /* Tabs */
    .bv-tabs { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 1rem; }
    .bv-tab { display: flex; align-items: center; gap: 4px; padding: 6px 12px; border-radius: 2rem; border: none;
              background: rgba(255,255,255,0.04); color: #64748B; font-size: 0.62rem; font-weight: 700;
              cursor: pointer; font-family: 'Montserrat', sans-serif; transition: all 0.2s; }
    .bv-tab:hover { background: rgba(255,255,255,0.08); color: #94A3B8; }
    .bv-tab.active { background: var(--ht-blue); color: #fff; }
    .bv-tab i { font-size: 0.72rem; }

    /* Tab content */
    .bv-tab-content { display: none; }
    .bv-tab-content.active { display: block; }

    /* Feature list */
    .bv-feature { display: flex; gap: 12px; padding: 12px;
                  background: linear-gradient(135deg, rgba(255,255,255,0.04) 0%, rgba(255,255,255,0.01) 100%);
                  border: 1px solid rgba(237,185,94,0.12);
                  border-radius: 0.6rem; margin-bottom: 8px; }
    .bv-feature i { font-size: 1.2rem; flex-shrink: 0; margin-top: 2px; }
    .bv-feature strong { display: block; font-size: 0.78rem; color: rgba(255,255,255,0.85); margin-bottom: 2px; }
    .bv-feature span { font-size: 0.68rem; color: #94A3B8; line-height: 1.5; }

    /* Steps */
    .bv-step { display: flex; gap: 12px; margin-bottom: 10px; }
    .bv-step-num { width: 28px; height: 28px; border-radius: 50%; background: rgba(0,32,159,0.15);
                   color: var(--ht-blue); display: flex; align-items: center; justify-content: center;
                   font-size: 0.72rem; font-weight: 800; flex-shrink: 0; }
    .bv-step-desc { font-size: 0.68rem; color: #94A3B8; line-height: 1.5; }

    /* Stress table */
    .bv-stress-row { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; padding: 8px 12px;
                     border-bottom: 1px solid rgba(255,255,255,0.04); font-size: 0.72rem; }
    .bv-stress-header { font-weight: 700; color: #64748B; font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.05em; }
    .bv-verdict-instant { color: #28A745; font-weight: 700; font-size: 0.62rem; }
    .bv-verdict-fast { color: #EDB95E; font-weight: 700; font-size: 0.62rem; }

    /* Compare table */
    .bv-compare-header { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; padding: 8px 12px;
                         font-weight: 700; color: #64748B; font-size: 0.62rem; text-transform: uppercase; }
    .bv-compare-row { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; padding: 8px 12px;
                      border-bottom: 1px solid rgba(255,255,255,0.04); font-size: 0.68rem; }
    .bv-compare-label { color: #94A3B8; }
    .bv-compare-good { color: #28A745; font-weight: 700; }
    .bv-compare-bad { color: #f87171; }

    /* FAQ */
    .bv-faq-item { padding: 12px;
                   background: linear-gradient(135deg, rgba(255,255,255,0.04) 0%, rgba(255,255,255,0.01) 100%);
                   border: 1px solid rgba(237,185,94,0.12);
                   border-radius: 0.6rem; margin-bottom: 8px; }
    .bv-faq-q { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
    .bv-faq-q i { font-size: 1rem; }
    .bv-faq-q strong { font-size: 0.78rem; color: rgba(255,255,255,0.85); }
    .bv-faq-a { font-size: 0.68rem; color: #94A3B8; line-height: 1.6; margin: 0; }

    /* Trust badges */
    /* badges now from shared theme */

    /* Search card */
    .bv-search-card { position: relative;
                      background: linear-gradient(135deg, rgba(255,255,255,0.04) 0%, rgba(255,255,255,0.01) 100%);
                      border: 1px solid rgba(237,185,94,0.15); border-radius: 1rem; padding: 1.25rem; overflow: hidden; }
    .bv-search-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, var(--ht-blue), var(--ht-red));
    }
    .bv-search-glow { position: absolute; top: -50%; left: -50%; width: 200%; height: 200%;
                      background: radial-gradient(circle at 30% 30%, rgba(0,32,159,0.08) 0%, transparent 50%);
                      pointer-events: none; }
    .bv-search-label { display: block; font-size: 0.68rem; font-weight: 700; color: rgba(255,255,255,0.7);
                       margin-bottom: 8px; position: relative; z-index: 1; }
    .bv-search-input { width: 100%; padding: 12px 14px; border-radius: 0.5rem; border: 1px solid rgba(255,255,255,0.1);
                       background: rgba(0,0,0,0.3); color: #fff; font-size: 0.78rem; font-family: 'Courier New', monospace;
                       outline: none; position: relative; z-index: 1; margin-bottom: 10px; }
    .bv-search-input:focus { border-color: var(--ht-blue); box-shadow: 0 0 0 3px rgba(0,32,159,0.2); }
    .bv-search-input::placeholder { color: #475569; }
    .bv-search-btn { width: 100%; padding: 12px; border-radius: 0.5rem; border: none; background: var(--ht-blue); color: #fff;
                     font-size: 0.82rem; font-weight: 700; cursor: pointer; font-family: 'Montserrat', sans-serif;
                     display: flex; align-items: center; justify-content: center; gap: 6px; position: relative; z-index: 1;
                     transition: background 0.2s; }
    .bv-search-btn:hover { background: #1a3ab8; }

    /* Ledger card */
    .bv-ledger-card { background: linear-gradient(135deg, rgba(255,255,255,0.04) 0%, rgba(255,255,255,0.01) 100%);
                      border: 1px solid rgba(237,185,94,0.15); border-radius: 1rem; padding: 1.25rem;
                      position: relative; overflow: hidden; }
    .bv-ledger-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, var(--ht-blue), var(--ht-red));
    }

    @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
    @keyframes sealPulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(40,167,69,0.2); } 50% { box-shadow: 0 0 20px 5px rgba(40,167,69,0.1); } }

    /* Pilot feedback radio options */
    .bv-radio-option {
      display: flex; align-items: center; gap: 10px;
      padding: 8px 12px; border-radius: 0.5rem; cursor: pointer;
      background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.06);
      transition: all 0.15s ease; font-size: 0.8rem; color: #CBD5E1;
    }
    .bv-radio-option:hover { background: rgba(99,102,241,0.08); border-color: rgba(99,102,241,0.2); }
    .bv-radio-option:has(input:checked) {
      background: rgba(99,102,241,0.12); border-color: rgba(99,102,241,0.35); color: #E2E8F0;
    }
    .bv-radio-option input[type="radio"] {
      accent-color: #6366F1; width: 16px; height: 16px; margin: 0; cursor: pointer;
    }
    .bv-radio-option span { flex: 1; }

    /* Pulsing arrow for results button */
    @keyframes pulseArrow {
      0%, 100% { transform: translateX(0); opacity: 0.7; }
      50% { transform: translateX(4px); opacity: 1; }
    }
    .bv-results-btn:hover .bv-arrow-pulse { animation: pulseArrow 0.8s ease-in-out infinite; }

    @media (max-width: 900px) {
      .verify-grid { grid-template-columns: 1fr; }
      .verify-right { position: static; }
      /* Stack security feature cards cleanly on mobile */
      .bv-feature { flex-direction: column; gap: 8px; text-align: center; }
      .bv-feature i { margin-top: 0; }
      .bv-tabs { justify-content: center; }
      .bv-tab span { display: none; }
      .bv-tab i { font-size: 0.9rem; }
      .bv-tab { padding: 8px 10px; }
      .bv-stress-row { font-size: 0.62rem; gap: 4px; }
      .bv-compare-row, .bv-compare-header { font-size: 0.58rem; gap: 4px; }
    }
    @media (max-width: 480px) {
      .main-container { padding: 1rem 0.75rem; }
      .bv-search-card { padding: 1rem; }
      .bv-ledger-card { padding: 1rem; }
      .bv-badges { justify-content: center; }
    }
  </style>
</head>
<body>
<%= render "election/shared/bonvote_sparkles", sparkle_count: 10 %>
<%= render "election/shared/bonvote_nav", active: "verify" %>

<%# ── Test Mode Banner (simulation elections only) ── %>
<% if @test_mode %>
  <div style="background: linear-gradient(90deg, #D97706, #B45309); padding: 10px 20px;
              text-align: center; font-size: 0.78rem; font-weight: 700; color: #FFF;
              letter-spacing: 0.05em; position: sticky; top: 0; z-index: 100;
              border-bottom: 2px solid rgba(0,0,0,0.2);">
    <i class="ri-flask-line" style="margin-right: 6px;"></i>
    MÒD TES — PA REZILTA REYÈL
    <span style="display: block; font-size: 0.65rem; font-weight: 500; opacity: 0.85; margin-top: 2px;">
      Tout done sa yo se simulation sèlman. Yo pral efase apre pilòt la.
    </span>
  </div>
<% end %>

<div class="main-container">

  <%# ── Official Header ── %>
  <div style="text-align: center; padding: 3rem 1rem 1.5rem;">
    <div style="display: flex; flex-direction: column; align-items: center; margin-bottom: 0.75rem;">
      <%= image_tag "haiti_flag.png", alt: "Armoiries d'Haïti",
            style: "height: 56px; width: auto; filter: drop-shadow(0 4px 15px rgba(237,185,94,0.25)); margin-bottom: 8px;" %>
      <div class="section-header" style="font-size: 0.72rem; font-weight: 800; letter-spacing: 2px;">
        BONVOTE
      </div>
      <div style="font-size: 0.55rem; color: #64748B; margin-top: 4px;">
        Powered by BonID
      </div>
    </div>

    <%# ── Language Switcher ── %>
    <div style="display: flex; justify-content: center;">
      <div class="lang-switcher">
        <a href="<%= election_audit_verify_path(lang: "ht", h: params[:h]) %>"
           class="lang-pill <%= 'active' if I18n.locale.to_s == 'ht' %>">
          <%= t("bonvote.lang_ht") %>
        </a>
        <a href="<%= election_audit_verify_path(lang: "fr", h: params[:h]) %>"
           class="lang-pill <%= 'active' if I18n.locale.to_s == 'fr' %>">
          <%= t("bonvote.lang_fr") %>
        </a>
        <a href="<%= election_audit_verify_path(lang: "en", h: params[:h]) %>"
           class="lang-pill <%= 'active' if I18n.locale.to_s == 'en' %>">
          <%= t("bonvote.lang_en") %>
        </a>
      </div>
    </div>
  </div>

  <%# ── Two Column Layout ── %>
  <div class="verify-grid">

    <%# ══════ LEFT COLUMN: Tabbed Interface ══════ %>
    <div class="verify-left">

      <h1 style="font-family: 'Playfair Display', Georgia, serif; font-size: clamp(1.3rem, 4vw, 1.8rem);
                 font-weight: 900; margin-bottom: 0.5rem; text-align: center;
                 background: linear-gradient(135deg, #EDB95E 0%, #FFD700 50%, #EDB95E 100%);
                 -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
        <%= t("bonvote.hero_title") %>
      </h1>
      <p style="font-size: 0.78rem; color: #64748B; margin-bottom: 1rem; line-height: 1.6; text-align: center;">
        <%= t("bonvote.hero_sub") %>
      </p>

      <%# Results Link — prominent CTA %>
      <div style="text-align: center; margin-bottom: 1.25rem;">
        <a href="/election/results" target="_blank" class="bv-results-btn"
           style="display: inline-flex; align-items: center; gap: 10px; padding: 14px 32px;
                  background: linear-gradient(135deg, rgba(237,185,94,0.18), rgba(237,185,94,0.08));
                  border: 1.5px solid rgba(237,185,94,0.4); border-radius: 2rem;
                  color: #EDB95E; font-size: 0.92rem; font-weight: 800; text-decoration: none;
                  font-family: 'Montserrat', sans-serif; transition: all 0.2s;
                  box-shadow: 0 4px 20px rgba(237,185,94,0.1);">
          <i class="ri-bar-chart-box-line" style="font-size: 1.15rem;"></i>
          <%= t("bonvote.results_view") %>
          <i class="ri-arrow-right-line bv-arrow-pulse" style="font-size: 1rem; opacity: 0.7;"></i>
        </a>
      </div>

      <%# Tab Navigation %>
      <div class="bv-tabs">
        <button class="bv-tab active" onclick="bonvoteTab('security')" id="tab-security">
          <i class="ri-shield-check-line"></i> <span><%= t("bonvote.tab_security") %></span>
        </button>
        <button class="bv-tab" onclick="bonvoteTab('how')" id="tab-how">
          <i class="ri-flow-chart"></i> <span><%= t("bonvote.tab_how") %></span>
        </button>
        <button class="bv-tab" onclick="bonvoteTab('what')" id="tab-what">
          <i class="ri-question-line"></i> <span><%= t("bonvote.tab_what") %></span>
        </button>
        <button class="bv-tab" onclick="bonvoteTab('advantages')" id="tab-advantages">
          <i class="ri-star-line"></i> <span><%= t("bonvote.tab_advantages") %></span>
        </button>
        <button class="bv-tab" onclick="bonvoteTab('performance')" id="tab-performance">
          <i class="ri-pulse-line"></i> <span><%= t("bonvote.tab_performance") %></span>
        </button>
        <button class="bv-tab" onclick="bonvoteTab('compare')" id="tab-compare">
          <i class="ri-scales-3-line"></i> <span><%= t("bonvote.tab_compare") %></span>
        </button>
        <button class="bv-tab" onclick="bonvoteTab('faq')" id="tab-faq">
          <i class="ri-chat-3-line"></i> <span><%= t("bonvote.tab_faq") %></span>
        </button>
      </div>

      <%# ── TAB 1: Security ── %>
      <div class="bv-tab-content active" id="content-security">
        <h3 style="font-size: 0.95rem; font-weight: 800; color: rgba(255,255,255,0.9); margin-bottom: 6px;">
          <%= t("bonvote.security_title") %>
        </h3>
        <p style="font-size: 0.72rem; color: #94A3B8; margin-bottom: 16px; line-height: 1.5;">
          <%= t("bonvote.security_intro") %>
        </p>

        <div class="bv-feature">
          <i class="ri-key-2-line" style="color: var(--ht-green);"></i>
          <div>
            <strong><%= t("bonvote.pedersen_title") %></strong>
            <span><%= t("bonvote.pedersen_desc") %></span>
          </div>
        </div>
        <div class="bv-feature">
          <i class="ri-shield-keyhole-line" style="color: #7b8fff;"></i>
          <div>
            <strong><%= t("bonvote.schnorr_title") %></strong>
            <span><%= t("bonvote.schnorr_desc") %></span>
          </div>
        </div>
        <div class="bv-feature">
          <i class="ri-lock-line" style="color: #EDB95E;"></i>
          <div>
            <strong><%= t("bonvote.aes_title") %></strong>
            <span><%= t("bonvote.aes_desc") %></span>
          </div>
        </div>
        <div class="bv-feature">
          <i class="ri-fingerprint-line" style="color: var(--ht-blue);"></i>
          <div>
            <strong><%= t("bonvote.biometric_title") %></strong>
            <span><%= t("bonvote.biometric_desc") %></span>
          </div>
        </div>
        <div class="bv-feature">
          <i class="ri-spam-2-line" style="color: #f87171;"></i>
          <div>
            <strong><%= t("bonvote.fraud_title") %></strong>
            <span><%= t("bonvote.fraud_desc") %></span>
          </div>
        </div>

        <div class="bv-badges" style="margin-top: 16px;">
          <div class="bv-badge"><i class="ri-verified-badge-line"></i><span>Merkle Tree</span></div>
          <div class="bv-badge"><i class="ri-key-2-line"></i><span>Pedersen</span></div>
          <div class="bv-badge"><i class="ri-shield-keyhole-line"></i><span>Schnorr ZKP</span></div>
          <div class="bv-badge"><i class="ri-lock-2-line"></i><span>AES-256-GCM</span></div>
        </div>
      </div>

      <%# ── TAB 2: How it Works ── %>
      <div class="bv-tab-content" id="content-how">
        <h3 style="font-size: 0.95rem; font-weight: 800; color: rgba(255,255,255,0.9); margin-bottom: 12px;">
          <%= t("bonvote.how_title") %>
        </h3>

        <% [
          [1, t("bonvote.step1_title"), t("bonvote.step1_desc")],
          [2, t("bonvote.step2_title"), t("bonvote.step2_desc")],
          [3, t("bonvote.step3_title"), t("bonvote.step3_desc")],
          [4, t("bonvote.step4_title"), t("bonvote.step4_desc")],
          [5, t("bonvote.step5_title"), t("bonvote.step5_desc")],
          [6, t("bonvote.step6_title"), t("bonvote.step6_desc")]
        ].each do |num, title, desc| %>
          <div class="bv-step">
            <span class="bv-step-num"><%= num %></span>
            <div>
              <strong style="color: rgba(255,255,255,0.8); font-size: 0.78rem;"><%= title %></strong>
              <span class="bv-step-desc"><%= desc %></span>
            </div>
          </div>
        <% end %>
      </div>

      <%# ── TAB 3: What is BonVote ── %>
      <div class="bv-tab-content" id="content-what">
        <h3 style="font-size: 0.95rem; font-weight: 800; color: rgba(255,255,255,0.9); margin-bottom: 12px;">
          <%= t("bonvote.what_title") %>
        </h3>

        <div class="bv-feature">
          <i class="ri-compass-3-line" style="color: var(--ht-blue);"></i>
          <div>
            <strong><%= t("bonvote.mission_title") %></strong>
            <span><%= t("bonvote.mission_desc") %></span>
          </div>
        </div>
        <div class="bv-feature">
          <i class="ri-smartphone-line" style="color: var(--ht-blue);"></i>
          <div>
            <strong><%= t("bonvote.platform_title") %></strong>
            <span><%= t("bonvote.platform_desc") %></span>
          </div>
        </div>
        <div class="bv-feature">
          <i class="ri-global-line" style="color: var(--ht-blue);"></i>
          <div>
            <strong><%= t("bonvote.diaspora_title") %></strong>
            <span><%= t("bonvote.diaspora_desc") %></span>
          </div>
        </div>
        <div class="bv-feature">
          <i class="ri-verified-badge-line" style="color: var(--ht-blue);"></i>
          <div>
            <strong><%= t("bonvote.ledger_title") %></strong>
            <span><%= t("bonvote.ledger_desc") %></span>
          </div>
        </div>
      </div>

      <%# ── TAB 4: Advantages ── %>
      <div class="bv-tab-content" id="content-advantages">
        <h3 style="font-size: 0.95rem; font-weight: 800; color: rgba(255,255,255,0.9); margin-bottom: 12px;">
          <%= t("bonvote.advantages_title") %>
        </h3>

        <div class="bv-feature">
          <i class="ri-search-eye-line" style="color: var(--ht-green);"></i>
          <div>
            <strong><%= t("bonvote.transparency_title") %></strong>
            <span><%= t("bonvote.transparency_desc") %></span>
          </div>
        </div>
        <div class="bv-feature">
          <i class="ri-global-line" style="color: #7b8fff;"></i>
          <div>
            <strong><%= t("bonvote.inclusion_title") %></strong>
            <span><%= t("bonvote.inclusion_desc") %></span>
          </div>
        </div>
        <div class="bv-feature">
          <i class="ri-money-dollar-circle-line" style="color: var(--ht-green);"></i>
          <div>
            <strong><%= t("bonvote.savings_title") %></strong>
            <span><%= t("bonvote.savings_desc") %></span>
          </div>
        </div>
        <div class="bv-feature">
          <i class="ri-user-add-line" style="color: #EDB95E;"></i>
          <div>
            <strong><%= t("bonvote.participation_title") %></strong>
            <span><%= t("bonvote.participation_desc") %></span>
          </div>
        </div>
        <div class="bv-feature">
          <i class="ri-hand-heart-line" style="color: var(--ht-blue);"></i>
          <div>
            <strong><%= t("bonvote.aid_title") %></strong>
            <span><%= t("bonvote.aid_desc") %></span>
          </div>
        </div>
      </div>

      <%# ── TAB 5: Performance ── %>
      <div class="bv-tab-content" id="content-performance">
        <h3 style="font-size: 0.95rem; font-weight: 800; color: rgba(255,255,255,0.9); margin-bottom: 6px;">
          <%= t("bonvote.performance_title") %>
        </h3>
        <p style="font-size: 0.72rem; color: #94A3B8; margin-bottom: 16px; line-height: 1.5;">
          <%= t("bonvote.performance_intro") %>
        </p>

        <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(237,185,94,0.1); border-radius: 0.6rem; overflow: hidden;">
          <div class="bv-stress-row bv-stress-header">
            <span><%= t("bonvote.scale") %></span>
            <span><%= t("bonvote.perf_measured", default: "Tan (mesuré)") %></span>
            <span><%= t("bonvote.verdict") %></span>
          </div>
          <div class="bv-stress-row">
            <span style="color: #fff;">1,000 <%= t("bonvote.votes") %></span>
            <span style="color: var(--ht-green); font-weight: 700;">1.9 ms</span>
            <span class="bv-verdict-instant"><i class="ri-checkbox-circle-fill" style="margin-right: 2px;"></i> <%= t("bonvote.instant") %></span>
          </div>
          <div class="bv-stress-row">
            <span style="color: #fff;">10,000 <%= t("bonvote.votes") %></span>
            <span style="color: var(--ht-green); font-weight: 700;">17 ms</span>
            <span class="bv-verdict-instant"><i class="ri-checkbox-circle-fill" style="margin-right: 2px;"></i> <%= t("bonvote.instant") %></span>
          </div>
          <div class="bv-stress-row">
            <span style="color: #fff;">100,000 <%= t("bonvote.votes") %></span>
