                    Mèsi! Ou fèk ede Ayiti.
                  </h3>
                  <p style="font-size: 0.75rem; color: rgba(255,255,255,0.5); margin: 0;">
                    Repons ou yo pral ede nou amelyore sistèm vòt la pou tout moun.
                  </p>
                </div>
              </div>
            </div>

          <% else %>
            <%# VOTE NOT FOUND %>
            <div style="background: rgba(248,113,113,0.05); border: 1px solid rgba(248,113,113,0.15);
                        border-radius: 1rem; padding: 1.5rem; text-align: center;">
              <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(248,113,113,0.1);
                          display: flex; align-items: center; justify-content: center; margin: 0 auto 0.75rem;">
                <i class="ri-search-line" style="font-size: 1.4rem; color: #f87171;"></i>
              </div>
              <h3 style="font-size: 1rem; font-weight: 700; color: #f87171; margin: 0 0 0.4rem;">
                <%= t("bonvote.vote_not_found") %>
              </h3>
              <p style="font-size: 0.78rem; color: rgba(255,255,255,0.5); margin: 0; line-height: 1.5;">
                <%= t("bonvote.vote_not_found_desc") %>
              </p>
            </div>
          <% end %>
        </div>
      <% end %>

      <%# Live Ledger Heartbeat %>
      <div style="margin-bottom: 1.5rem;">
        <div class="bv-ledger-card">

          <div style="display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 1rem;">
            <span style="width: 8px; height: 8px; background: #10B981; border-radius: 50%;
                         display: inline-block; animation: blink 1.5s infinite;"></span>
            <span style="font-size: 0.68rem; font-weight: 700; color: var(--ht-green); text-transform: uppercase;
                         letter-spacing: 0.1em;">
              <%= t("bonvote.ledger_live") %>
            </span>
          </div>

          <div style="text-align: center; margin-bottom: 1rem;">
            <div style="font-size: clamp(2rem, 7vw, 3rem); font-weight: 800; color: #ffffff;
                        letter-spacing: -0.02em; line-height: 1;" id="live-total-votes">
              <%= number_with_delimiter(@total_votes || 0) %>
            </div>
            <div style="font-size: 0.7rem; color: #94A3B8; text-transform: uppercase;
                        letter-spacing: 0.08em; margin-top: 4px;">
              <%= t("bonvote.verified_votes") %>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem;">
            <div style="background: rgba(255,255,255,0.02); border-radius: 0.6rem; padding: 0.75rem; text-align: center;
                        border: 1px solid rgba(148,163,184,0.08);">
              <div style="font-size: 1.3rem; font-weight: 800; color: #7b8fff;">
                <%= @countries_count || 0 %>
              </div>
              <div style="font-size: 0.6rem; color: #94A3B8; text-transform: uppercase; letter-spacing: 0.05em;">
                <%= t("bonvote.countries_voting") %>
              </div>
            </div>
            <div style="background: rgba(255,255,255,0.02); border-radius: 0.6rem; padding: 0.75rem; text-align: center;
                        border: 1px solid rgba(148,163,184,0.08);">
              <div style="font-size: 1.3rem; font-weight: 800; color: #EDB95E;">
                <%= @departments_count || 10 %>
              </div>
              <div style="font-size: 0.6rem; color: #94A3B8; text-transform: uppercase; letter-spacing: 0.05em;">
                <%= t("bonvote.departments_haiti") %>
              </div>
            </div>
          </div>

          <div style="background: rgba(255,255,255,0.02); border-radius: 0.5rem; padding: 0.6rem 0.75rem;
                      border: 1px solid rgba(255,255,255,0.04); margin-bottom: 0.75rem;">
            <div style="font-size: 0.6rem; color: rgba(255,255,255,0.35); text-transform: uppercase;
                        letter-spacing: 0.05em; margin-bottom: 6px;">
              <%= t("bonvote.recent_activity") %>
            </div>
            <div style="font-size: 0.72rem; color: rgba(255,255,255,0.5); line-height: 1.8;">
              <% if @recent_ballots.present? %>
                <% @recent_ballots.each do |ballot| %>
                  <% flag_code, location_label = ballot.ticker_location %>
                  <div style="display: flex; align-items: center; gap: 6px;">
                    <img src="https://hatscripts.github.io/circle-flags/flags/<%= flag_code %>.svg" width="16" height="16" alt="<%= flag_code.upcase %>" style="border-radius: 50%; flex-shrink: 0;">
                    <span><%= location_label %> · <span style="color: rgba(255,255,255,0.3);"><%= ballot.time_ago_label %></span></span>
                  </div>
                <% end %>
              <% else %>
                <div style="font-size: 0.65rem; color: rgba(255,255,255,0.25); text-align: center; padding: 6px 0;">
                  <%= t("bonvote.no_activity_yet", default: "Pa gen aktivite ankò") %>
                </div>
              <% end %>
            </div>
          </div>

          <div style="padding-top: 0.75rem; border-top: 1px solid rgba(255,255,255,0.05);">
            <div style="font-size: 0.55rem; color: #475569; text-transform: uppercase;
                        letter-spacing: 0.05em; margin-bottom: 3px;">
              <%= t("bonvote.merkle_root_label") %>
            </div>
            <div style="font-family: 'Courier New', monospace; font-size: 0.52rem; color: #334155;
                        word-break: break-all;">
              <%= @merkle_root || "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" %>
            </div>
          </div>
        </div>
      </div>

      <%# Footer %>
      <div class="bonvote-footer" style="border-radius: 1rem; margin-top: 1.5rem;">
        <p style="font-size: 0.58rem; color: rgba(255,255,255,0.7); line-height: 1.6; margin-bottom: 0.5rem;">
          <%= t("bonvote.footer_managed") %><br>
          <%= t("bonvote.footer_no_pii") %>
        </p>
        <div style="width: 48px; height: 2px; margin: 0 auto 6px; border-radius: 2px;
                    background: linear-gradient(90deg, var(--ht-red) 0%, var(--ht-blue) 100%);"></div>
        <div style="display: flex; justify-content: center; gap: 1rem; margin-bottom: 6px;">
          <a href="/terms" target="_blank">Terms of Use</a>
          <a href="/privacy" target="_blank">Privacy Policy</a>
        </div>
        <div class="footer-brand">&copy; 2026 <%= t("bonvote.footer_copyright") %></div>
      </div>
    </div>

  </div>
</div>

<script>
  function bonvoteTab(name) {
    document.querySelectorAll('.bv-tab').forEach(function(t) { t.classList.remove('active'); });
    document.querySelectorAll('.bv-tab-content').forEach(function(c) { c.classList.remove('active'); });
    document.getElementById('tab-' + name).classList.add('active');
    document.getElementById('content-' + name).classList.add('active');
  }

  function submitPilotFeedback(event) {
    event.preventDefault();
    var form = document.getElementById('pilotFeedbackForm');
    var btn = document.getElementById('pilotSubmitBtn');
    var formData = new FormData(form);

    // Build payload
    var payload = {
      pilot_feedback: {
        election_id: '<%= params[:election_id] || "2026-test-pilot-1" %>',
        receipt_id: '<%= @result[:receipt_id] rescue "" %>',
        ballot_hash: '<%= params[:h] %>',
        time_to_vote: parseInt(formData.get('time_to_vote')),
        photo_clarity: parseInt(formData.get('photo_clarity')),
        trust_level: parseInt(formData.get('trust_level')),
        comment: formData.get('comment') || '',
        lang: '<%= I18n.locale %>',
        channel: '<%= params[:channel] || "remote" %>'
      }
    };

    // Validate all 3 questions answered
    if (!payload.pilot_feedback.time_to_vote || !payload.pilot_feedback.photo_clarity || !payload.pilot_feedback.trust_level) {
      btn.textContent = 'Tanpri reponn tout 3 kesyon yo';
      btn.style.background = 'rgba(248,113,113,0.3)';
      setTimeout(function() {
        btn.textContent = 'Voye Repons yo';
        btn.style.background = 'linear-gradient(135deg, #6366F1, #4F46E5)';
      }, 2000);
      return;
    }

    // Disable button
    btn.disabled = true;
    btn.textContent = 'Ap voye...';
    btn.style.opacity = '0.6';

    fetch('/election/feedback', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(payload)
    })
    .then(function(resp) { return resp.json(); })
    .then(function(data) {
      // Show thank you, hide form
      document.getElementById('pilotFeedbackForm').style.display = 'none';
      document.getElementById('pilotThankYou').style.display = 'block';
    })
    .catch(function(err) {
      btn.disabled = false;
      btn.textContent = 'Erè — eseye ankò';
      btn.style.opacity = '1';
      btn.style.background = 'rgba(248,113,113,0.3)';
      setTimeout(function() {
        btn.textContent = 'Voye Repons yo';
        btn.style.background = 'linear-gradient(135deg, #6366F1, #4F46E5)';
      }, 3000);
    });
  }
</script>

</body>
</html>
