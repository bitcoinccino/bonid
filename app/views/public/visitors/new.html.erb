<div class="container py-4" data-controller="entry-mode">
  <div class="row justify-content-center">
    <div class="col-lg-10">

      <!-- Header -->
      <div class="text-center mb-4">
        <h1 class="fw-bold text-haitian-blue font-heading mb-2" style="font-size: 1.6rem;">
          <%= t("bon_touris.pages.new.title") %>
        </h1>
        <p class="text-muted small mb-0"><%= t("bon_touris.wizard.subtitle") %></p>
      </div>

      <!-- Wizard Progress Bar -->
      <div class="bt-wizard-progress mb-4">
        <div class="bt-wizard-progress__track">
          <div class="bt-wizard-progress__fill" data-wizard-target="progressBar"></div>
        </div>
        <div class="d-flex justify-content-between mt-2">
          <% %w[identity travel contact].each_with_index do |step, i| %>
            <div class="bt-wizard-step-label" data-wizard-target="stepIndicator">
              <div class="step-circle"><%= i + 1 %></div>
              <span class="small fw-semibold"><%= t("bon_touris.wizard.steps.#{step}") %></span>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Form -->
      <div id="visitor_form">
        <%= render "form", visitor_submission: @visitor_submission %>
      </div>

      <!-- Cancel / Back -->
      <div class="text-center mt-4">
        <%= link_to get_started_public_visitors_path,
              class: "btn btn-outline-secondary fw-semibold px-4" do %>
          <i class="ri-arrow-left-line me-1"></i>
          <%= t("bon_touris.pages.new.cancel") %>
        <% end %>
      </div>

    </div>
  </div>
</div>
