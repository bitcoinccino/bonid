<% content_for :auth_left do %>
  <div class="auth-left-inner d-flex flex-column justify-content-center h-100">

    <h2 class="fw-bold mb-3 font-heading">
      <%= t("bon_touris.pages.verify_email.title") %>
    </h2>

    <p class="mb-4">
      <%= t("bon_touris.notices.otp_sent") %><br>
      <strong><%= @visitor.email %></strong>
    </p>

    <p class="small opacity-75">
      <%= t("bon_touris.pages.verify_email.instruction") %>
    </p>

    <p class="small opacity-75 fst-italic">
      <%= t("bon_touris.pages.verify_email.code_expires") %>
    </p>

  </div>
<% end %>

<div class="login-card shadow-lg">

  <div class="login-header mb-4 text-center">
    <h2 class="login-title fw-bold font-heading">
      <%= t("bon_touris.pages.verify_email.title") %>
    </h2>

    <p class="login-subtitle">
      <%= t("bon_touris.pages.verify_email.instruction") %>
    </p>
  </div>

  <%= form_with(
        url: verify_email_public_visitor_path(@visitor),
        method: :post,
        local: true
      ) do %>

    <div class="mb-3">
      <%= label_tag :otp,
        t("bon_touris.forms.otp_label"),
        class: "form-label fw-bold" %>

      <%= text_field_tag :otp, nil,
            class: "form-control form-control-lg text-center",
            maxlength: 6,
            required: true,
            inputmode: "numeric",
            autocomplete: "one-time-code",
            placeholder: t("bon_touris.forms.otp_placeholder") %>
    </div>

    <div class="d-grid mt-4">
      <%= submit_tag t("bon_touris.actions.verify_email"),
            class: "btn btn-haitian-primary btn-lg fw-bold" %>
    </div>

  <% end %>

  <div class="text-center mt-3">
    <%= button_to t("bon_touris.actions.resend_code"),
          resend_otp_public_visitor_path(@visitor),
          method: :post,
          class: "btn btn-link" %>
  </div>
</div>
