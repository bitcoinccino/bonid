<!-- app/views/layouts/pdf.html.erb -->
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>BonID Incident Report</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      font-size: 12px;
      color: #333;
      margin: 20px;
    }
    h1 {
      font-size: 18px;
      color: #1e40af;
      text-align: center;
      margin-bottom: 20px;
    }
    h2 {
      font-size: 14px;
      margin-top: 20px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
    }
    th, td {
      border: 1px solid #ddd;
      padding: 8px;
      text-align: left;
    }
    th {
      background-color: #f2f2f2;
    }
    img {
      max-width: 150px;
    }
    .footer {
      position: fixed;
      bottom: 20px;
      width: 100%;
      text-align: center;
      font-size: 10px;
      color: #666;
    }
  </style>
</head>
<body>
  <%= yield %>
  <div class="footer">
    Generated by BonID Dashboard on <%= Time.now.strftime("%B %d, %Y %I:%M %p") %>
  </div>
</body>
</html>