<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Montserrat:wght@600&display=swap" rel="stylesheet">

    <!-- Remix Icons -->
    <link href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css" rel="stylesheet">

    <style>
      body {
        background: #F5F7FA;
        margin: 0;
        padding: 25px;
        font-family: 'Inter', Arial, sans-serif;
        color: #333;
      }

      .email-wrapper {
        max-width: 640px;
        margin: auto;
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.08);
        padding: 45px 40px;
      }

      .header {
        text-align: center;
        margin-bottom: 25px;
      }

      .brand-icon {
        font-size: 48px;
        color: #00209F; /* Haitian Blue */
        margin-bottom: 12px;
      }

      .brand-title {
        font-family: 'Montserrat', Arial, sans-serif;
        font-size: 22px;
        font-weight: 600;
        color: #00209F;
        letter-spacing: 0.5px;
      }

      .email-body {
        font-size: 15px;
        line-height: 1.7;
        margin-top: 25px;
      }

      .btn-primary {
        display: inline-block;
        background: #00209F; /* Haitian Blue */
        color: #ffffff !important;
        padding: 13px 22px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-family: 'Montserrat', Arial, sans-serif;
        margin: 25px 0;
      }

      .footer {
        margin-top: 45px;
        font-size: 12px;
        color: #7D7D7D;
        border-top: 1px solid #E0E4EA;
        padding-top: 15px;
        text-align: center;
        line-height: 1.6;
      }

      /* Mobile responsive */
      @media only screen and (max-width: 480px) {
        .email-wrapper {
          padding: 25px 20px;
        }
        .btn-primary {
          width: 100% !important;
          text-align: center !important;
        }
      }
    </style>
  </head>

  <body>
    <div class="email-wrapper">

      <!-- HEADER -->
      <div class="header">
        <i class="ri-shield-check-line brand-icon"></i>
        <div class="brand-title">Verifyem • BonID</div>
      </div>

      <!-- BODY -->
      <div class="email-body">
        <%= yield %>
      </div>

      <!-- FOOTER -->
      <div class="footer">
        © <%= Time.current.year %> Verifyem & BonID — All Rights Reserved.<br>
        Powered by the Haitian Digital Identity Network.
      </div>

    </div>
  </body>
</html>
