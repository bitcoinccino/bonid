<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= content_for(:title) || "BonID Law Enforcement Portal" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="turbo-cache-control" content="no-cache" />
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css">
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400..900&display=swap" rel="stylesheet">
</head>

<body class="partners-layout bg-light d-flex flex-column flex-lg-row min-vh-100 partner-law-enforcement-layout <%= 'immersive-builder' if @immersive_form %>"
      data-controller="tooltip bootstrap global-loading">

  <%= render "shared/global_loading" %>
  <turbo-frame id="turbo-redirect"></turbo-frame>

  <%# Global confirmation modal — intercepts all data-turbo-confirm dialogs %>
  <%= render "shared/confirmation_modal" %>

  <% unless @immersive_form %>
    <!-- Sidebar -->
    <%= render "partner_portal/shared/sidebars/sidebar_law_enforcement_content" %>
  <% end %>

  <!-- Main Content -->
  <main class="flex-grow-1 w-100 position-relative">
    <% unless @immersive_form %>
      <%= render "partner_portal/shared/navbars/navbar_law_enforcement" %>
    <% end %>

    <div id="flash-messages">
      <% unless controller.devise_controller? %>
        <%= render "shared/flash" %>
      <% end %>
    </div>

    <div class="<%= @immersive_form ? 'immersive-builder-content' : 'p-4 partner-scroll-region' %>">
      <%= yield %>
    </div>
  </main>
</body>
</html>
