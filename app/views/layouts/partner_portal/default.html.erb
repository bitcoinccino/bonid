<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= content_for(:title) || "BonID Partner Portal" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="turbo-cache-control" content="no-cache" />
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --sidebar-width: 260px;
      --topbar-height: 70px;
      --navbar-height: 70px;

      /* Citizen color scheme */
      --haitian-blue: #00209F;
      --haitian-blue-hover: #032B77;
      --haitian-blue-light: rgba(0, 32, 159, 0.1);
      --haitian-blue-subtle: rgba(0, 32, 159, 0.06);
      --haitian-blue-border: rgba(0, 32, 159, 0.12);

      --palm-green: #1A936F;
      --golden-yellow: #FFD700;
      --dark-gray: #1C1C1C;
      --mid-gray: #6C757D;
      --light-gray: #F8F9FA;
      --white: #FFFFFF;
      --coral-red: #E63946;

      /* Override law-blue so shared sidebar/navbar SCSS uses citizen blue */
      --law-blue: #00209F;
    }

    body {
      font-family: 'Inter', 'Montserrat', system-ui, sans-serif;
      background-color: var(--light-gray);
    }

    /* ============================================================
       NAVBAR — Citizen Haitian Blue
    ============================================================ */
    .partner-navbar {
      background: #0d132d !important;
      height: var(--topbar-height);
      z-index: 1050;
      box-shadow: none;
    }

    /* ============================================================
       SIDEBAR COLOR OVERRIDES — Citizen Blue Theme
    ============================================================ */
    .partner-sidebar .partner-logo-section {
      border-bottom-color: var(--haitian-blue-border) !important;
    }

    .partner-sidebar .partner-logo-img {
      border-color: rgba(0, 32, 159, 0.15) !important;
    }

    .partner-sidebar .partner-logo-placeholder {
      background-color: var(--haitian-blue) !important;
    }

    .partner-sidebar .sidebar-nav .nav-link:hover {
      background-color: var(--haitian-blue-subtle) !important;
      color: var(--haitian-blue) !important;
    }

    .partner-sidebar .sidebar-nav .nav-link:hover > i:first-child {
      color: var(--haitian-blue) !important;
    }

    .partner-sidebar .sidebar-nav .nav-link.active {
      background-color: var(--haitian-blue-light) !important;
      color: var(--haitian-blue) !important;
    }

    .partner-sidebar .sidebar-nav .nav-link.active > i:first-child {
      color: var(--haitian-blue) !important;
    }

    .partner-sidebar .sidebar-nav .sidebar-divider {
      background-color: var(--haitian-blue-border) !important;
    }

    .partner-sidebar .sidebar-nav .dropdown-menu {
      border-color: var(--haitian-blue-border) !important;
    }

    .partner-sidebar .sidebar-nav .dropdown-item:hover,
    .partner-sidebar .sidebar-nav .dropdown-item:focus {
      background-color: var(--haitian-blue-subtle) !important;
      color: var(--haitian-blue) !important;
    }

    .partner-sidebar .sidebar-nav .dropdown-item:hover i {
      color: var(--haitian-blue) !important;
    }

    .partner-sidebar .sidebar-close-btn:hover {
      color: var(--haitian-blue) !important;
    }

    @media (min-width: 992px) {
      .partner-sidebar {
        border-right-color: var(--haitian-blue-border) !important;
      }
    }

    @media (max-width: 991.98px) {
      .partner-sidebar {
        border-right-color: var(--haitian-blue-border) !important;
      }
    }

    /* ============================================================
       NAVBAR DROPDOWN OVERRIDES — Citizen Blue
    ============================================================ */
    .partner-navbar .partner-admin-menu {
      border-color: var(--haitian-blue-border) !important;
    }

    .partner-navbar .partner-admin-menu .dropdown-item:hover,
    .partner-navbar .partner-admin-menu .dropdown-item:focus {
      background-color: rgba(0, 32, 159, 0.08) !important;
      color: var(--haitian-blue) !important;
    }

    .partner-navbar .partner-admin-menu .dropdown-item:hover i,
    .partner-navbar .partner-admin-menu .dropdown-item:focus i {
      color: var(--haitian-blue) !important;
    }

    .partner-navbar .dropdown-divider {
      border-color: var(--haitian-blue-border) !important;
    }

    /* ============================================================
       HEADING FONT
    ============================================================ */
    .font-heading {
      font-family: 'Montserrat', sans-serif !important;
    }

    /* ============================================================
       IMMERSIVE BUILDER — full-screen mode for service form builder
    ============================================================ */
    .immersive-builder .partner-sidebar,
    .immersive-builder .partner-navbar { display: none !important; }

    .immersive-builder > main {
      display: flex !important;
      flex-direction: column !important;
      height: 100vh !important;
      overflow: hidden !important;
    }

    .immersive-builder #flash-messages:empty { display: none; }

    .immersive-builder-content {
      padding: 0 !important;
      max-width: 100%;
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 0;
      overflow: hidden;
    }
  </style>
</head>

<body class="partners-layout bg-light d-flex flex-column flex-lg-row min-vh-100 partner-default-layout <%= 'immersive-builder' if @immersive_form %>"
      data-controller="tooltip bootstrap global-loading">

  <%= render "shared/global_loading" %>
  <turbo-frame id="turbo-redirect"></turbo-frame>

  <%# Global confirmation modal %>
  <%= render "shared/confirmation_modal" if lookup_context.exists?("shared/confirmation_modal", [], true) %>

  <% unless @immersive_form %>
    <!-- Sidebar -->
    <% sidebar_sector = @current_partner&.department_sector || @current_partner&.sector %>
    <%# Map sector variants to their shared sidebar partial %>
    <% sidebar_key = case sidebar_sector&.downcase
         when "commercial_bank", "microfinance", "credit_union", "money_transfer",
              "mobile_wallet", "payment_processor", "remittance", "fintech", "banking"
           "banking"
         when "embassy", "consulate", "international_org", "un_agency"
           "embassy"
         when "pnh", "law_enforcement"
           "law_enforcement"
         else
           sidebar_sector
         end %>
    <% sidebar_partial = "partner_portal/shared/sidebars/sidebar_#{sidebar_key}_content" if sidebar_key.present? %>
    <% if sidebar_partial && lookup_context.exists?(sidebar_partial, [], true) %>
      <%= render sidebar_partial %>
    <% else %>
      <%= render "partner_portal/shared/sidebars/sidebar_default_content" %>
    <% end %>
  <% end %>

  <!-- Main Content -->
  <main class="flex-grow-1 position-relative">
    <% unless @immersive_form %>
      <%= render "partner_portal/shared/navbars/navbar_default" %>
    <% end %>

    <div id="flash-messages">
      <% unless controller.devise_controller? %>
        <%= render "shared/flash" if lookup_context.exists?("shared/flash", [], true) %>
      <% end %>
    </div>

    <div class="<%= @immersive_form ? 'immersive-builder-content' : 'p-4 partner-scroll-region' %>">
      <%= yield %>
    </div>

    <% unless @immersive_form %>
      <footer class="text-center py-3" style="font-size: 0.72rem; color: #94A3B8; border-top: 1px solid #F1F5F9;">
        Powered by <strong style="color: #64748B;">BonGouv</strong>
      </footer>
    <% end %>
  </main>
</body>
</html>
