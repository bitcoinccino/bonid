<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= content_for?(:title) ? yield(:title) : "Partner Portal – Sign In" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", type: "module", "data-turbo-track": "reload", defer: true %>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet" />
</head>

<body class="partner-admin-signin-page">
  <%# Back button %>
  <div class="position-absolute top-0 start-0 mt-4 ms-4 z-3">
    <%= link_to root_path, class: "btn btn-light rounded-circle shadow-sm back-btn", title: "Back to Home" do %>
      <i class="ri-arrow-left-line fw-bold text-primary fs-5"></i>
    <% end %>
  </div>

  <%= yield %>
</body>
</html>

<style>
  html, body {
    margin: 0 !important;
    padding: 0 !important;
  }

  body.partner-admin-signin-page {
    min-height: 100vh !important;
    margin: 0 !important;
    padding: 0 !important;
    font-family: 'Montserrat', 'Inter', sans-serif !important;
    background: #172F55 !important;
    background-color: #172F55 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  .back-btn {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    border: 1px solid rgba(4, 50, 140, 0.1);
    transition: all 0.2s ease-in-out;
  }

  .back-btn:hover {
    background: #f1f5ff;
    transform: translateX(-2px);
  }

  .back-btn .text-primary {
    color: #04328C !important;
  }
</style>
