<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= content_for(:title) || "BonID Reviewer Portal" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", type: "module", "data-turbo-track": "reload", defer: true %>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600&display=swap" rel="stylesheet" />
</head>

<body class="d-flex bg-light min-vh-100 reviewer-layout">
  <%= render "reviewers/shared/sidebar" %>

  <div class="flex-grow-1 d-flex flex-column">
    <%= render "reviewers/shared/navbar" %>
    <main class="flex-grow-1 p-3 p-md-4" style="margin-top: 4rem;">
      <%= yield %>
    </main>
  </div>
</body>
</html>

<style>
   .reviewer-layout {
  font-family: "Montserrat", sans-serif;
  background-color: #f8f9fa;
}

.reviewer-sidebar {
  width: 240px;
  z-index: 1040;
}

.nav-link {
  border-radius: 0.5rem;
  padding: 0.5rem 0.75rem;
  transition: all 0.2s ease;

  &:hover, &.active {
    background-color: rgba(0, 32, 159, 0.1);
    color: #00209F !important;
  }
}

</style>