<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Web fonts (supported in many clients; safe fallbacks included in inline styles) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700&family=Orbitron:wght@600;700;800&display=swap" rel="stylesheet">
  </head>

  <body style="margin:0; padding:0; background:#0a0f1f;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#0a0f1f; padding:24px 0;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:640px; margin:0 auto;">
            <tr>
              <td style="padding:0 16px;">
                <%= render "citizen_mailer/shared/frame" do %>
                  <%= yield %>
                <% end %>
              </td>
            </tr>
          </table>

          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:640px; margin:0 auto;">
            <tr>
              <td style="padding:18px 16px 0;">
                <%= render "citizen_mailer/shared/footer" %>
              </td>
            </tr>
          </table>

        </td>
      </tr>
    </table>
  </body>
</html>
