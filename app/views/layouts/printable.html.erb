<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Printable Incident Report</title>
  <style>
    body {
      font-family: Georgia, serif;
      font-size: 12px;
      color: #000;
      margin: 2rem;
      background-color: #fff;
    }

    h1, h2, h3, h4 {
      text-align: center;
      color: #1e40af;
    }

    .footer {
      position: fixed;
      bottom: 20px;
      width: 100%;
      text-align: center;
      font-size: 10px;
      color: #777;
    }

    @media print {
      .no-print {
        display: none;
      }
    }
  </style>
</head>
<body>
  <%= yield %>
  <div class="footer">
    Printed from BonID – <%= Time.current.strftime("%B %d, %Y %I:%M %p") %>
  </div>
</body>
</html>
