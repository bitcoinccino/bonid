<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>BonID Verification</title>

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "application", media: "all" %>
  <%= javascript_include_tag "application", defer: true %>

  <!-- Icons & Fonts -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

  <style>
    :root {
      --haitian-blue: #00209F;
      --haitian-gold: #FFD700;
      --text-dark: #1a1a1a;
      --text-muted: #6c757d;
      --bg-light: #f8f9fa;
      --border-soft: rgba(0,0,0,0.08);
    }

    /* ===============================
       BASE
    =============================== */
    body {
      margin: 0;
      font-family: "Inter", sans-serif;
      background: var(--bg-light);
      color: var(--text-dark);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    main {
      flex: 1;
      padding: 1.5rem 1rem;
    }

    /* ===============================
       HEADER (MOBILE FIRST)
    =============================== */
    header.public-header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: #ffffff;
      border-bottom: 1px solid var(--border-soft);
      padding: 0.85rem 1rem;
      box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .brand {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.55rem;
      text-decoration: none;
    }

    .brand i {
      font-size: 1.6rem;
      color: var(--haitian-gold);
    }

    .brand span {
      font-family: "Montserrat", sans-serif;
      font-weight: 700;
      font-size: 1.35rem;
      color: var(--haitian-blue);
      letter-spacing: 0.2px;
    }

    .brand-subtitle {
      text-align: center;
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 0.15rem;
    }

    /* ===============================
       FOOTER
    =============================== */
    footer.public-footer {
      background: #ffffff;
      border-top: 1px solid var(--border-soft);
      padding: 1.25rem 1rem;
      text-align: center;
    }

    footer .footer-title {
      font-family: "Montserrat", sans-serif;
      font-weight: 600;
      color: var(--haitian-blue);
      font-size: 0.9rem;
      margin-bottom: 0.25rem;
    }

    footer .footer-text {
      font-size: 0.8rem;
      color: var(--text-muted);
      line-height: 1.4;
    }

    /* ===============================
       DESKTOP ENHANCEMENTS
    =============================== */
    @media (min-width: 768px) {
      header.public-header {
        padding: 1.25rem 1rem;
      }

      main {
        padding: 2.5rem 1rem;
      }

      .brand span {
        font-size: 1.6rem;
      }
    }

    /* ===============================
       PRINT MODE
    =============================== */
    @media print {
      header.public-header,
      footer.public-footer {
        display: none !important;
      }

      body {
        background: #ffffff !important;
      }
    }
  </style>
</head>

<body>

  <!-- ===============================
       PUBLIC HEADER
  =============================== -->
  <header class="public-header">
    <a href="https://bonid.ht" class="brand" target="_blank" rel="noopener">
      <i class="ri-shield-check-line"></i>
      <span>BonID</span>
    </a>
    <div class="brand-subtitle">
      Haiti’s Digital Identity Platform
    </div>
  </header>

  <!-- ===============================
       MAIN CONTENT
  =============================== -->
  <main>
    <%= yield %>
  </main>

  <!-- ===============================
       FOOTER
  =============================== -->
  <footer class="public-footer">
    <div class="footer-title">
      BonID · Verify with Confidence
    </div>
    <div class="footer-text">
      © <%= Time.current.year %> BonID. All rights reserved.
    </div>
  </footer>

</body>
</html>
