<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>
    <%= content_for?(:title) ? yield(:title) : t("bon_touris.brand") %>
  </title>

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- ✅ CSS via Propshaft -->
  <%= stylesheet_link_tag "application", media: "all" %>

  <!-- ✅ JS via Importmap (Rails 8) -->
<%= javascript_include_tag "application", defer: true %>


  <!-- Fonts & Icons -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css"
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;600;700;800&family=Montserrat:wght@600;700&family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet"
  >
</head>

<body class="visitor-layout visitor-auth <%= content_for?(:body_class) ? yield(:body_class) : "" %>">

  <!-- 🌐 Language Switcher -->
  <div class="position-fixed top-0 end-0 p-3 z-3">
    <%= render "shared/language_switcher" %>
  </div>

  <main class="auth-layout">

    <!-- LEFT COLUMN -->
    <aside class="auth-left d-flex align-items-center justify-content-center">
      <div class="auth-left-inner w-100" style="max-width: 640px;">
        <%= yield :auth_left %>
      </div>
    </aside>

    <!-- RIGHT COLUMN -->
    <section class="auth-right d-flex align-items-center justify-content-center">
      <div class="auth-right-inner">

        <%= render "shared/flash" %>

        <%= yield %>

      </div>
    </section>

  </main>
</body>
</html>
