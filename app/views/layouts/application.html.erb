<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= content_for(:title) || "BonID – Haiti's Open Digital Identification" %></title>

  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- =======================================
       GOOGLE FONTS (Inter + Montserrat + Orbitron)
       Glock Grotesque is self-hosted
       ======================================= -->
  <link
    href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400..900&
          family=Inter:wght@300;400;500;600;700&
          family=Montserrat:wght@300;400;500;600;700;800&
          display=swap"
    rel="stylesheet"
  >

  <!-- Stylesheets -->
  <%= stylesheet_link_tag "application",
        media: "all",
        "data-turbo-track": "reload" %>

  <!-- Icons -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css"
  >

  <!-- JavaScript (ESBuild / Turbo / Stimulus) -->
  <%= javascript_include_tag "application",
        "data-turbo-track": "reload",
        type: "module" %>
</head>

<body
  class="
    public-app
    d-flex
    flex-column
    min-vh-100
    <%= 'home-page' if current_page?(root_path) %>
  "
  data-controller="global-loading"
>

  <%= render "shared/global_loading" %>

  <!-- NAVBAR -->
  <%= render "shared/navbar" %>

  <!-- FLASH (exclude Devise pages) -->
  <% unless controller.devise_controller? %>
    <%= render "shared/flash" %>
  <% end %>

  <!-- MAIN CONTENT -->
  <main class="public-content flex-grow-1 flex-shrink-0">
    <%= render "shared/confirmation_modal" unless controller.devise_controller? %>
    <%= yield %>
  </main>

  <!-- FOOTER -->
  <footer>
    <%= render "shared/footer" %>
  </footer>

  <!-- COOKIE BANNER -->
  <%= render "shared/cookie_banner" %>

</body>
</html>

<style>
/* Public layout should never be offset */
body.public-app .public-content {
  margin: 0;
  padding: 0;
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
}
</style>
