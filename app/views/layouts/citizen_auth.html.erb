<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <title><%= content_for?(:title) ? yield(:title) : "BonID – Citizen Access" %></title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "application", media: "all" %>
  <%= javascript_include_tag "application", defer: true %>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css">
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;600;700;800&family=Montserrat:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
</head>

<body class="citizen-auth <%= content_for?(:body_class) ? yield(:body_class) : "" %>">

  <main class="auth-layout">

    <!-- LEFT COLUMN -->
    <aside class="auth-left">
      <div class="auth-left-inner w-100" style="max-width: 640px;">
        <%= yield :auth_left %>
      </div>
    </aside>

    <!-- RIGHT COLUMN -->
    <section class="auth-right">
      <div class="auth-right-inner">

        <%= render "shared/flash" %>

        <%= yield %>

      </div>
    </section>

  </main>

</body>
</html>
