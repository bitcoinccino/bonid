<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <title><%= content_for?(:title) ? yield(:title) : t("citizen_portal.auth.page_title") %></title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= yield :head %>

  <%= stylesheet_link_tag "application", media: "all" %>
  <%= javascript_include_tag "application", defer: true %>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css">
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;600;700;800&family=Montserrat:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
</head>

<body class="citizen-auth <%= content_for?(:body_class) ? yield(:body_class) : "" %>">

  <%# Pages that don't provide :auth_left (OAuth consent/handoff, one-time
      secrets, session revocation) render as a single centered column
      instead of showing an empty blue panel. %>
  <% split = content_for?(:auth_left) %>
  <main class="auth-layout <%= "auth-layout--single" unless split %>">

    <% if split %>
      <!-- LEFT COLUMN -->
      <aside class="auth-left">
        <div class="auth-left-inner w-100" style="max-width: 640px;">
          <%= yield :auth_left %>
        </div>
      </aside>
    <% end %>

    <!-- RIGHT COLUMN -->
    <section class="auth-right">
      <%# Language picker — pre-login pages follow ?lang= (kept in the
          session), so each option reloads this page in that language. %>
      <% languages = [["ht", "Kreyòl Ayisyen"], ["fr", "Français"], ["en", "English"]] %>
      <div class="auth-lang-switch dropdown">
        <button type="button" class="auth-lang-toggle dropdown-toggle"
                data-bs-toggle="dropdown" aria-expanded="false"
                aria-label="<%= t("citizen_portal.settings.language.label") %>">
          <i class="ri-global-line" aria-hidden="true"></i>
          <span><%= I18n.locale.to_s.upcase %></span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
          <% languages.each do |code, name| %>
            <li>
              <a class="dropdown-item <%= "active" if I18n.locale.to_s == code %>"
                 href="<%= url_for(request.query_parameters.merge(lang: code)) %>"
                 lang="<%= code %>"><%= name %></a>
            </li>
          <% end %>
        </ul>
      </div>

      <div class="auth-right-inner">

        <%= render "shared/flash" %>

        <%= yield %>

      </div>
    </section>

  </main>

</body>
</html>
