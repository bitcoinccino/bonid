<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body {
      margin: 0;
      padding: 0;
      background: #f4f6fb;
      font-family: 'Inter', 'Montserrat', Arial, sans-serif;
      color: #1a1a2e;
      -webkit-font-smoothing: antialiased;
    }
  </style>
</head>
<body style="margin: 0; padding: 0; background: #f4f6fb; font-family: 'Inter', 'Montserrat', Arial, sans-serif;">

  <%# ═══════════════════════════════════════════════════════════
       Product config. Verifyem is the parent site; BonID, BonTouris, IDPol,
       BonVote and BonGouv are its products. Set @email_product in the
       mailer (VerifyemMailer defaults to "verifyem", Citizens::BaseMailer
       to "bonid"). The footer line follows the product.
  ═══════════════════════════════════════════════════════════ %>
  <%
    product = @email_product || "bonid"
    config = {
      "verifyem"  => { name: "Verifyem",  monogram: "V",  color: "#00209F", tagline: ["Digital identity platform."] },
      "bonid"     => { name: "BonID",     monogram: "B",  color: "#00209F", tagline: [t("mailers.layout.bonid_tagline_1", default: "A private digital identity, not a government ID."), t("mailers.layout.bonid_tagline_2", default: "Verify once, use anywhere.")] },
      "idpol"     => { name: "IDPol",     monogram: "IP", color: "#092C73", tagline: ["Public safety & law enforcement."] },
      "bonvote"   => { name: "BonVote",   monogram: "BV", color: "#1A936F", tagline: ["Secure digital voting."] },
      "bontouris" => { name: "BonTouris", monogram: "BT", color: "#EDB95E", tagline: ["Visitor verification."] },
      "bongouv"   => { name: "BonGouv",  monogram: "BG", color: "#00209F", tagline: ["Digital government services."] }
    }
    config = config[product] || config["bonid"]
    brand_color = config[:color]
    monogram = config[:monogram]
    product_name = config[:name]
    tagline = config[:tagline]
    mono_font_size = monogram.length > 1 ? "14px" : "18px"
    mono_text_color = product == "bontouris" ? "#1a1a2e" : "#FFFFFF"
  %>

  <table width="100%" cellpadding="0" cellspacing="0" style="background: #f4f6fb; padding: 24px 0;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" style="max-width: 600px; width: 100%; border-radius: 0; overflow: hidden;">

          <%# ═══════════ HEADER ═══════════
               Plain Haitian-blue band (no monogram / product name / "by
               VERIFYEM"). Shows the optional @email_badge on the right. %>
          <tr>
            <td style="background: <%= brand_color %>; padding: <%= @email_badge.present? ? '14px 30px' : '0' %>; height: <%= @email_badge.present? ? 'auto' : '8px' %>; line-height: <%= @email_badge.present? ? 'normal' : '8px' %>; font-size: <%= @email_badge.present? ? 'inherit' : '0' %>; text-align: right;">
              <% if @email_badge.present? %>
                <span style="color: rgba(255,255,255,0.85); font-size: 10px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase; background: rgba(255,255,255,0.15); padding: 4px 10px; border-radius: 12px;"><%= @email_badge %></span>
              <% else %>&nbsp;<% end %>
            </td>
          </tr>

          <%# ═══════════ ACCENT BAR (optional) ═══════════ %>
          <% if @email_alert.present? %>
            <% alert_colors = { "danger" => "#DC3545", "warning" => "#EDB95E", "success" => "#1A936F", "info" => "#00209F" } %>
            <% alert_bg = alert_colors[@email_alert_type || "info"] || "#00209F" %>
            <tr>
              <td style="background: <%= alert_bg %>; padding: 8px 30px; text-align: center;">
                <span style="color: #FFFFFF; font-size: 11px; font-weight: 700; letter-spacing: 0.8px; text-transform: uppercase;"><%= @email_alert %></span>
              </td>
            </tr>
          <% end %>

          <%# ═══════════ BODY ═══════════ %>
          <tr>
            <td style="background: #FFFFFF; padding: 30px; font-size: 14px; line-height: 1.7; color: #4a5568;">
              <%= yield %>
            </td>
          </tr>

          <%# ═══════════ FOOTER ═══════════ %>
          <tr>
            <td style="background: <%= brand_color %>; padding: 24px 30px; text-align: center;">
              <div style="color: rgba(255,255,255,0.85); font-size: 12px; line-height: 1.7;">
                <%= safe_join(Array(tagline), tag.br) %>
              </div>
              <div style="margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.12);">
                <span style="color: rgba(255,255,255,0.35); font-size: 10px;">
                  &copy; <%= Date.today.year %> Verifyem &middot; <%= t("mailers.layout.rights", default: "All rights reserved") %>
                </span>
              </div>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>
