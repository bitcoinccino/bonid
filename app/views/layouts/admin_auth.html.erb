
<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title).presence || "BonID Partner Portal" %></title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Styles -->
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <!-- Icons + Fonts -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css"
          crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600&display=swap"
          rel="stylesheet" />

    <!-- Scripts -->
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>

  <body class="auth-layout d-flex align-items-center justify-content-center min-vh-100">
    <div class="auth-container card shadow-sm p-4 rounded-4 w-100" style="max-width: 420px;">
      <!-- Flash messages -->
      <%= render "shared/flash" %>

      <!-- Devise content -->
      <%= yield %>
    </div>

    <footer class="text-center mt-4 text-muted small">
      © <%= Time.current.year %> BonID — Digital Identity Platform of Haiti
    </footer>

    <style>
      body.auth-layout {
        background: linear-gradient(180deg, #00209F 0%, #04328C 50%, #f8f9fa 100%);
        font-family: 'Montserrat', sans-serif;
      }
      .card {
        background-color: #fff;
        border: none;
      }
      .btn-primary {
        background-color: #04328C;
        border: none;
      }
      .btn-primary:hover {
        background-color: #021b56;
      }
      footer {
        position: fixed;
        bottom: 12px;
        left: 0;
        width: 100%;
      }
    </style>
  </body>
</html>
