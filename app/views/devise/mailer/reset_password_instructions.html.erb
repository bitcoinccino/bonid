<p>
  Hello
  <% if @resource.is_a?(Officer) %>
    <%= @resource.full_name.presence || @resource.email %>,
  <% elsif @resource.partner_admin? %>
    <%= @resource.full_name.presence || @resource.email %>,
  <% else %>
    <%= @resource.email %>,
  <% end %>
</p>

<p>
  Someone has requested a link to change your password for your
  <% if @resource.is_a?(Officer) %>
    BonID Officer account.
  <% elsif @resource.partner_admin? %>
    BonID Partner Admin account.
  <% else %>
    BonID account.
  <% end %>
</p>
