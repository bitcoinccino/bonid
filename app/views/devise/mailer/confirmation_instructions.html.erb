<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #333;">
  <h2 style="color: #04328C;">Welcome to BonID, <%= @resource.first_name.presence || @resource.email %>!</h2>

  <p>Thank you for signing up. To activate your account, please confirm your email address by clicking the button below:</p>

  <p style="margin: 20px 0;">
    <a href="<%= confirmation_url(@resource, confirmation_token: @token) %>" 
       style="display: inline-block; padding: 12px 20px; background-color: #04328C; color: #fff; text-decoration: none; border-radius: 6px; font-weight: bold;">
      Confirm My Account
    </a>
  </p>

  <p>If the button above doesn't work, copy and paste the URL below into your browser:</p>

  <p style="word-break: break-word;">
    <%= confirmation_url(@resource, confirmation_token: @token) %>
  </p>

  <hr style="margin: 30px 0; border: none; border-top: 1px solid #ccc;" />

  <p style="font-size: 13px; color: #888;">
    If you did not create a BonID account, please ignore this email.
  </p>
</div>
