<!-- app/views/users/passwords/edit.html.erb -->
<%= render "shared/navbar" %>

<section class="container d-flex justify-content-center align-items-center min-vh-100" style="max-width: 480px;">
 <div class="p-4 p-md-5 rounded-4 shadow-sm position-relative military-card bg-white w-100 text-center"
 data-controller="form-handler"
 data-action="turbo:submit-start->form-handler#submitStart turbo:submit-end->form-handler#submitEnd turbo:submit-error->form-handler#submitError">

 <%= render "shared/flash" %>

 <!-- PNH Logo -->
 <% if @partner&.logo&.attached? %>
 <%= image_tag @partner.logo.variant(resize_to_limit: [80, 80]).processed,
 class: "rounded-circle border shadow-sm mx-auto mb-3",
 alt: "Police National D'Haiti logo",
 style: "object-fit: cover; width: 80px; height: 80px;" %>
 <% else %>
 <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px;">
 <i class="ri-image-line text-muted" style="font-size: 2rem;"></i>
 </div>
 <% end %>

 <!-- Title -->
 <h4 class="text-uppercase fw-bold text-primary font-heading mb-1" style="letter-spacing: 1px;">
 Reset Your Password
 </h4>
 <p class="text-muted small font-body mb-4">
 Create a new password to regain access to your PNH partner admin account.
 </p>

 <!-- Form -->
 <%= form_for(resource, as: resource_name, url: user_password_path, html: { method: :put, class: "reset-password-form", data: { turbo: "true" } }) do |f| %>
 <%= f.hidden_field :reset_password_token %>

 <% if resource.errors.any? %>
 <div class="alert alert-dismissible fade show alert-danger mb-3" data-form-handler-target="error">
 <%= resource.errors.full_messages.to_sentence %>
 </div>
 <% end %>

 <div class="mb-3 text-start">
 <%= f.label :password, "New Password", class: "form-label small fw-semibold text-uppercase font-body" %>
 <%= f.password_field :password, autocomplete: "new-password", class: "form-control rounded-2", placeholder: "Create a password (8+ characters)", required: true, minlength: 8, autofocus: true %>
 </div>

 <div class="mb-3 text-start">
 <%= f.label :password_confirmation, "Confirm Password", class: "form-label small fw-semibold text-uppercase font-body" %>
 <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control rounded-2", placeholder: "Repeat password", required: true, minlength: 8 %>
 </div>

 <div class="d-grid mb-3">
 <button type="submit"
 class="btn btn-primary rounded-2 fw-bold text-uppercase d-flex justify-content-center align-items-center gap-2"
 data-form-handler-target="submit">
 <span data-form-handler-target="submitText">Update Password</span>
 <div class="spinner-border spinner-border-sm d-none"
 role="status"
 aria-hidden="true"
 data-form-handler-target="spinner"
 style="animation-duration: 1.5s;"></div>
 </button>
 </div>
 <% end %>

 <%= link_to "Back to login", new_user_session_path, class: "text-muted small text-decoration-none" %>
 </div>
</section>

<%= render "shared/footer" %>

<style>
 html, body {
 margin: 0;
 padding: 0;
 width: 100%;
 overflow-x: hidden;
 font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
 }
 body {
 display: flex;
 flex-direction: column;
 min-height: 100vh;
 background-color: #f8fafc;
 }
 .military-card {
 border-radius: 12px;
 box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
 transition: transform 0.2s ease;
 position: relative;
 z-index: 1;
 }
 .military-card:hover {
 transform: translateY(-5px);
 }
 .camo-overlay {
 position: absolute;
 top: 0;
 left: 0;
 width: 100%;
 height: 100%;
 background: linear-gradient(135deg, rgba(30, 64, 175, 0.1) 25%, rgba(5, 150, 105, 0.1) 75%);
 opacity: 0.3;
 z-index: 0;
 pointer-events: none;
 }
 :root {
 --haitian-blue: #1e40af;
 --palm-green: #059669;
 --golden-yellow: #f59e0b;
 --mid-gray: #6b7280;
 }
 .text-primary { color: var(--haitian-blue) !important; }
 .alert-danger { background-color: #fee2e2; border-color: #fecaca; color: #991b1b; }
 .form-control {
 border: 1px solid #d1d5db;
 border-radius: 8px;
 padding: 10px 12px;
 font-size: 0.9rem;
 transition: border-color 0.2s ease;
 z-index: 1;
 }
 .form-control:focus {
 border-color: var(--haitian-blue);
 box-shadow: 0 0 0 0.2rem rgba(30, 64, 175, 0.25);
 }
 .btn-primary {
 background: var(--haitian-blue);
 border-color: var(--haitian-blue);
 }
 .btn-primary:hover {
 background: #1e3a8a;
 border-color: #1e3a8a;
 }
 .reset-password-form { position: relative; z-index: 1; }
</style>

<script>
 document.addEventListener("DOMContentLoaded", function () {
 const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
 tooltipTriggerList.forEach(function (el) {
 new bootstrap.Tooltip(el);
 });
 });
</script>