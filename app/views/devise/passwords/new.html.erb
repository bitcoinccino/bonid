

<section class="container d-flex justify-content-center align-items-center min-vh-100"
         style="max-width: 480px;">
  <div class="p-4 p-md-5 rounded-4 shadow-sm position-relative bg-white w-100 overflow-hidden text-center"
       data-controller="form-handler"
       data-action="turbo:submit-start->form-handler#submitStart
                    turbo:submit-end->form-handler#submitEnd
                    turbo:submit-error->form-handler#submitError">

    <!-- Flash messages -->
    <%= render "shared/flash" %>

    <!-- Icon -->
    <div class="d-flex justify-content-center align-items-center mb-4">
      <i class="ri-lock-password-line ri-3x text-primary bg-light rounded-circle p-2 shadow-sm"></i>
    </div>

    <!-- Title -->
    <h4 class="text-uppercase fw-bold text-primary font-heading mb-1">
      Forgot Your Password?
    </h4>
    <p class="text-muted small font-body mb-4">
      Enter your email and we’ll send you a link to reset your teller password.
    </p>

    <!-- Password Reset Form -->
    <%= form_for(resource,
        as: resource_name,
        url: banking_agent_password_path,
        html: {
          method: :post,
          data: {
            turbo: false, # 🚫 Disable Turbo to prevent 401/422 errors
            controller: "form-handler",
            action: "turbo:submit-start->form-handler#submitStart
                     turbo:submit-end->form-handler#submitEnd
                     turbo:submit-error->form-handler#submitError"
          }
        }) do |f| %>

      <div class="alert alert-dismissible fade show alert-danger d-none" data-form-handler-target="error"></div>

      <!-- Email Input -->
      <div class="mb-3 text-start">
        <%= f.label :email, "Email Address",
                    class: "form-label small fw-semibold text-uppercase font-body" %>
        <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              required: true,
              class: "form-control rounded-2",
              placeholder: "you@example.com" %>
        <small class="form-text text-muted">
          We’ll send the reset link to this address.
        </small>
      </div>

      <!-- Submit Button -->
      <div class="d-grid mb-3">
        <button type="submit"
                class="btn btn-primary rounded-2 fw-bold text-uppercase d-flex justify-content-center align-items-center gap-2"
                data-form-handler-target="submit">
          <span data-form-handler-target="submitText">Send Reset Instructions</span>
          <div class="spinner-border spinner-border-sm d-none"
               role="status"
               aria-hidden="true"
               data-form-handler-target="spinner"></div>
        </button>
      </div>
    <% end %>

    <!-- Back to Login -->
    <div class="text-center mt-3 small">
      <%= link_to "Back to Teller Login",
                  new_banking_agent_session_path,
                  class: "text-muted text-decoration-none" %>
    </div>
  </div>
</section>

<%= render "shared/footer" %>
