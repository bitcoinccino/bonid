<section class="container d-flex justify-content-center align-items-center"
         role="main"
         style="max-width: 480px; min-height: 100vh;">
  <div class="p-4 p-md-5 rounded-4 shadow-sm position-relative bg-white w-100 overflow-hidden text-center"
       data-controller="form-handler"
       data-action="turbo:submit-start->form-handler#submitStart
                    turbo:submit-end->form-handler#submitEnd
                    turbo:submit-error->form-handler#submitError">

    <!-- Flash Messages (success, notice, etc.) -->
    <%= render "shared/flash" %>

    <% resource       ||= resource_class.new %>
    <% resource_name  ||= devise_mapping.name %>
    <% devise_mapping ||= Devise.mappings[resource_name] %>

    <!-- Dynamic Titles -->
    <% title_text, subtitle_text =
        case resource_name
        when :admin_user     then ["Admin Login", "Enter your credentials to access the BonID Admin Dashboard."]
        when :partner_admin  then ["Partner Admin", "Enter your credentials to access the BonID Partner Portal."]
        when :reviewer       then ["Reviewer Login", "Enter your credentials to review BonID submissions."]
        when :citizen        then ["Citizen Login", "Enter your credentials to access your BonID account."]
        when :officer        then ["Officer Login", "Enter your credentials to access the Officer Portal."]
        when :banking_agent  then ["Teller Login", "Welcome back! Please sign in to continue."]
        else                      ["Login", "Enter your credentials to access your account."]
        end %>

    <h2 class="text-uppercase fw-bold text-primary font-heading mb-1" style="letter-spacing: 1px;">
      <%= title_text %>
    </h2>
    <p class="text-muted small font-body mb-4">
      <%= subtitle_text.presence || "Welcome back!" %>
    </p>

    <!-- Login Form -->
    <%= simple_form_for(resource,
        as: resource_name,
        url: session_path(resource_name),
        html: {
          class: "position-relative",
          data: {
            turbo: false,
            controller: "form-handler",
            action: "turbo:submit-start->form-handler#submitStart
                     turbo:submit-end->form-handler#submitEnd
                     turbo:submit-error->form-handler#submitError"
          }
        }) do |f| %>

      <!-- Dismissible Error Alert – NOW WORKS 100% -->
      <div class="alert alert-danger alert-dismissible fade show d-none"
           data-form-handler-target="error"
           role="alert">
        <strong>Invalid Email or password.</strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>

      <!-- Email Field -->
      <div class="mb-3 text-start">
        <%= f.label :email, "Email Address", class: "form-label small fw-semibold text-uppercase font-body" %>
        <%= f.input_field :email,
              autofocus: true,
              autocomplete: "email",
              class: "form-control rounded-2",
              placeholder: "you@example.com",
              required: true %>
      </div>

      <!-- Password Field -->
      <div class="mb-3 text-start">
        <%= f.label :password, "Password", class: "form-label small fw-semibold text-uppercase font-body" %>
        <%= f.input_field :password,
              autocomplete: "current-password",
              class: "form-control rounded-2",
              placeholder: "••••••••",
              type: "password",
              required: true %>
      </div>

      <!-- Submit Button with Spinner -->
      <div class="d-grid mb-3">
        <button type="submit"
                class="btn btn-primary rounded-2 fw-bold text-uppercase d-flex justify-content-center align-items-center gap-2"
                data-form-handler-target="submit">
          <span data-form-handler-target="submitText">Log In</span>
          <div class="spinner-border spinner-border-sm d-none"
               role="status"
               data-form-handler-target="spinner"></div>
        </button>
      </div>
    <% end %>

    <!-- Forgot Password Link -->
    <div class="text-center small mt-3">
      <%= link_to "Forgot Password?", new_password_path(resource_name),
                  class: "text-muted text-decoration-none hover-underline" %>
    </div>
  </div>
</section>