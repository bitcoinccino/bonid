<section class="container d-flex justify-content-center align-items-center min-vh-100" style="max-width: 480px;">
  <div class="p-4 p-md-5 rounded-4 shadow-sm position-relative military-card bg-white w-100 overflow-hidden text-center"
       data-controller="form-handler"
       data-action="turbo:submit-start->form-handler#submitStart turbo:submit-end->form-handler#submitEnd turbo:submit-error->form-handler#submitError">

    <%= render "shared/flash" %>

    <!-- Camouflage Overlay -->
    <div class="camo-overlay"></div>

    <!-- Title -->
    <h2 class="h5 text-uppercase fw-bold text-primary font-heading mb-1" style="letter-spacing: 1px;">Sign Up for BonID</h2>
    <p class="text-muted small font-body mb-4">Create your account to verify your identity with BonID</p>

    <!-- Registration Form -->
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { novalidate: true }) do |f| %>
      
      <% if current_user&.admin? %>
        <!-- If admin is creating a user, let them pick a role -->
        <div class="mb-3 text-start">
          <%= f.label :roles, "Assign Role", class: "form-label fw-bold small text-uppercase font-body" %>
          <%= f.select :roles, 
                options_for_select(Role.pluck(:name).map { |r| [r.titleize, r] }, f.object.roles.first&.name),
                { prompt: "Select role" },
                class: "form-select rounded-3" %>
        </div>
      <% end %>

      <div class="mb-3 text-start">
        <%= f.label :email, "Email", class: "form-label fw-bold small text-uppercase font-body" %>
        <%= f.email_field :email, class: "form-control rounded-3", placeholder: "you@example.com", required: true %>
      </div>

      <div class="mb-3 text-start">
        <%= f.label :password, "Password", class: "form-label fw-bold small text-uppercase font-body" %>
        <%= f.password_field :password, class: "form-control rounded-3", placeholder: "Create a password", required: true %>
      </div>

      <div class="mb-3 text-start">
        <%= f.label :password_confirmation, "Confirm Password", class: "form-label fw-bold small text-uppercase font-body" %>
        <%= f.password_field :password_confirmation, class: "form-control rounded-3", placeholder: "Repeat your password", required: true %>
      </div>

      <div class="form-check mb-4 text-start">
        <%= f.check_box :terms, { required: true, class: "form-check-input", id: "termsCheck" }, '1', '0' %>
        <%= f.label :terms, class: "form-check-label small", for: "termsCheck" do %>
          I agree to BonID's
          <%= link_to "Terms", terms_pdf_path, class: "text-primary text-decoration-underline" %>
          and
          <%= link_to "Privacy Policy", privacy_pdf_path, class: "text-primary text-decoration-underline" %>
        <% end %>
      </div>

      <div class="d-grid">
        <button type="submit"
                class="btn btn-primary fw-bold rounded-3 d-flex justify-content-center align-items-center gap-2"
                data-form-handler-target="submit">
          <span data-form-handler-target="submitText">Sign Up</span>
          <div class="spinner-border spinner-border-sm d-none"
               role="status"
               aria-hidden="true"
               data-form-handler-target="spinner"
               style="animation-duration: 1.4s;"></div>
        </button>
      </div>
    <% end %>

    <!-- Devise Links -->
    <div class="text-center mt-4 small">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</section>

<%= render "shared/footer" %>
