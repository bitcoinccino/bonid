

<div class="pt-5"></div>

<div class="container min-vh-100 d-flex align-items-center justify-content-center bg-light">
  <div class="p-4 bg-white rounded-4 shadow-sm w-100" style="max-width: 520px;">
    
    <!-- Logo and Header -->
    <div class="text-center mb-4">
      <% if asset_exists?("bonid_logo.png") %>
        <%= image_tag "bonid_logo.png", alt: "BonID Logo", class: "mb-2", style: "height: 40px;" %>
      <% end %>
      <h2 class="h4 text-primary fw-bold"><i class="ri-user-settings-line me-2"></i>Edit Profile</h2>
      <p class="text-muted small">Update your BonID account credentials</p>
    </div>

    <!-- Rails Errors -->
    <% if resource.errors.any? %>
      <div class="alert alert-dismissible fade show alert-danger alert-dismissible fade show rounded-3" role="alert">
        <ul class="mb-0 small">
          <% resource.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% end %>

    <!-- Profile Form -->
    <%= form_for(resource,
                as: resource_name,
                url: registration_path(resource_name),
                html: {
                  method: :put,
                  data: {
                    controller: "form-handler",
                    action: "turbo:submit-start->form-handler#submitStart turbo:submit-end->form-handler#submitEnd turbo:submit-error->form-handler#submitError"
                  }
                }) do |f| %>

      <!-- JS Error -->
      <div data-form-handler-target="error" class="alert alert-dismissible fade show alert-danger d-none small"></div>

      <div class="mb-3">
        <%= f.label :email, class: "form-label fw-semibold" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control rounded-3", placeholder: "Email address" %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div class="alert alert-dismissible fade show alert-info rounded-3 mb-3 small">
          Confirmation pending for: <strong><%= resource.unconfirmed_email %></strong>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.label :password, class: "form-label fw-semibold" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "form-control rounded-3", placeholder: "New password" %>
        <small class="form-text text-muted">Leave blank to keep current password</small>
      </div>

      <div class="mb-3">
        <%= f.label :password_confirmation, class: "form-label fw-semibold" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control rounded-3", placeholder: "Confirm new password" %>
      </div>

      <div class="mb-4">
        <%= f.label :current_password, class: "form-label fw-semibold" %>
        <%= f.password_field :current_password, autocomplete: "current-password", class: "form-control rounded-3", placeholder: "Current password" %>
        <small class="form-text text-muted">Required to confirm changes</small>
      </div>

      <div class="d-grid">
        <button type="submit"
                class="btn btn-primary rounded-3 fw-bold"
                data-form-handler-target="submit"
                data-bs-toggle="tooltip"
                title="Save changes">
          <span data-form-handler-target="submitText">Update Profile</span>
          <span class="spinner-border spinner-border-sm ms-2 d-none"
                role="status"
                aria-hidden="true"
                data-form-handler-target="spinner"></span>
        </button>
      </div>
    <% end %>

    <!-- Divider -->
    <hr class="my-5">

    <!-- Cancel Account Form -->
    <%= button_to registration_path(resource_name),
                  method: :delete,
                  form: {
                    data: {
                      controller: "form-handler",
                      action: "turbo:submit-start->form-handler#submitStart turbo:submit-end->form-handler#submitEnd turbo:submit-error->form-handler#submitError"
                    }
                  },
                  class: "d-grid" do %>
      <div class="alert alert-dismissible fade show alert-danger d-none small" data-form-handler-target="error"></div>
      <button type="submit"
              class="btn btn-outline-danger rounded-3 w-100 fw-semibold"
              data-form-handler-target="submit"
              data-bs-toggle="tooltip"
              title="Permanently delete your account"
              data: { confirm: "Are you sure?" }>
        <span data-form-handler-target="submitText">Cancel My Account</span>
        <span class="spinner-border spinner-border-sm ms-2 d-none"
              role="status"
              aria-hidden="true"
              data-form-handler-target="spinner"></span>
      </button>
    <% end %>

    <!-- Back Link -->
    <div class="text-center mt-4">
      <%= link_to "← Back", :back, class: "text-decoration-none text-primary small fw-semibold" %>
    </div>
  </div>
</div>

<%= render "shared/footer" %>
