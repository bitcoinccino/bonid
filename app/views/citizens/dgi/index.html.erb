<script>
  function initCategorySelector() {
    const selector = document.getElementById("dgi-category-selector");
    if (!selector) return;

    const cards = selector.querySelectorAll(".dgi-category-card");
    const panels = {
      "registration": document.getElementById("panel-registration"),
      "tax-filing": document.getElementById("panel-tax-filing"),
      "activity": document.getElementById("panel-activity")
    };

    cards.forEach(function(card) {
      card.addEventListener("click", function() {
        var category = card.dataset.category;

        // Toggle active state on cards
        cards.forEach(function(c) { c.classList.remove("dgi-category-card--active"); });
        card.classList.add("dgi-category-card--active");

        // Show/hide panels
        Object.keys(panels).forEach(function(key) {
          if (panels[key]) {
            panels[key].classList.toggle("d-none", key !== category);
          }
        });
      });
    });
  }
  function initFilingsLink() {
    var link = document.getElementById("show-filings-link");
    if (!link) return;

    link.addEventListener("click", function(e) {
      e.preventDefault();

      // Activate the Aktivite tab
      var selector = document.getElementById("dgi-category-selector");
      if (selector) {
        selector.querySelectorAll(".dgi-category-card").forEach(function(c) {
          c.classList.remove("dgi-category-card--active");
        });
        var activityCard = selector.querySelector('[data-category="activity"]');
        if (activityCard) activityCard.classList.add("dgi-category-card--active");
      }

      // Show activity panel, hide others
      ["panel-registration", "panel-tax-filing"].forEach(function(id) {
        var el = document.getElementById(id);
        if (el) el.classList.add("d-none");
      });
      var activityPanel = document.getElementById("panel-activity");
      if (activityPanel) activityPanel.classList.remove("d-none");

      // Scroll to filings table
      var table = document.getElementById("filings-table");
      if (table) table.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }

  document.addEventListener("turbo:load", initCategorySelector);
  document.addEventListener("DOMContentLoaded", initCategorySelector);
  document.addEventListener("turbo:load", initFilingsLink);
  document.addEventListener("DOMContentLoaded", initFilingsLink);
</script>
