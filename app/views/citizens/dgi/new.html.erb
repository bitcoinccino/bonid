      row.innerHTML =
        '<div class="col-md-4"><input type="text" name="employes['+idx+'][nom_employe]" class="form-control form-control-sm"></div>' +
        '<div class="col-md-3"><input type="text" name="employes['+idx+'][nif_employe]" class="form-control form-control-sm"></div>' +
        '<div class="col-md-2"><input type="number" name="employes['+idx+'][salaire_brut]" class="form-control form-control-sm" min="0" step="0.01"></div>' +
        '<div class="col-md-2"><input type="number" name="employes['+idx+'][retenue_ir]" class="form-control form-control-sm" min="0" step="0.01"></div>' +
        '<div class="col-md-1"><button type="button" class="btn btn-sm btn-outline-danger w-100 remove-employee-btn"><i class="ri-delete-bin-line"></i></button></div>';
      document.getElementById('employeeRows').appendChild(row);
      idx++;
    });
  }
  document.addEventListener('click', function(e) {
