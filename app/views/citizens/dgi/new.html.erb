                  <div class="col-md-6">
                    <label class="form-label fw-semibold">Tip Deklarasyon</label>
                    <%= select_tag :type_declaration,
                        options_for_select([["Orijinal", "originale"], ["Rektifikatif", "rectificative"]], "originale"),
