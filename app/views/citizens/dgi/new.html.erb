                        options_for_select((@secteurs || {}).map { |k, v| ["#{k} — #{v}", k] }),
                        class: "form-select", prompt: "-- Chwazi --" %>
                  </div>
                </div>
              </div>
            </div>
            <div class="d-flex justify-content-between mt-3">
              <%= link_to citizens_dgi_index_path, class: "btn btn-outline-secondary btn-lg", style: "min-height:48px;" do %>
                <i class="ri-arrow-left-line me-1" aria-hidden="true"></i> Retounen
              <% end %>
              <button type="button" class="btn btn-primary btn-lg wizard-next-btn" data-next="2" style="min-height:48px;background:var(--primary);border-color:var(--primary);">
                Kontinye <i class="ri-arrow-right-line ms-1"></i>
              </button>
            </div>
          </div>

          <%# STEP 2: Adrès ak Kontak %>
          <div class="wizard-step-panel" id="wizardStep2" style="display:none;">
            <div class="dash-card">
              <div class="dash-card-header">
                <h6 class="dash-card-title" style="color:#D21034;"><span class="badge rounded-pill me-2" style="background:#D21034;">2</span>Adrès ak Kontak</h6>
                <span class="badge bg-success"><i class="ri-magic-line me-1"></i>BonID Pre-ranpli</span>
              </div>
              <div class="dash-card-body">
                <p class="fw-bold small mb-2" style="color:var(--primary);"><i class="ri-map-pin-line me-1"></i>Adrès Biznis</p>
                <div class="row g-3">
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">Depatman</label>
                    <%= select_tag :departement,
                        options_for_select(RecordSchemas::NifRegistrationSchema::DEPARTEMENTS_HAITI, @auto_fill[:department]),
                        class: "form-select", prompt: "-- Chwazi --", disabled: @auto_fill[:department].present? %>
                    <%= hidden_field_tag :departement, @auto_fill[:department] if @auto_fill[:department].present? %>
                  </div>
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">Komin</label>
                    <%= text_field_tag :commune, @auto_fill[:commune], class: "form-control", placeholder: "ex: Pétion-Ville", readonly: @auto_fill[:commune].present? %>
                  </div>
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">Seksyon Kominal</label>
                    <%= text_field_tag :section_communale, @auto_fill[:section_communale], class: "form-control", placeholder: "ex: 1è Seksyon", readonly: @auto_fill[:section_communale].present? %>
                  </div>
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">Zòn / Lokalite</label>
                    <%= text_field_tag :ville, @auto_fill[:locality], class: "form-control", placeholder: "ex: Boulva 15", readonly: @auto_fill[:locality].present? %>
                  </div>
                  <div class="col-12 bonid-autofill">
                    <label class="form-label fw-semibold">Adrès Ri (Nimewo ak Non Ri)</label>
                    <%= text_field_tag :adresse, @auto_fill[:street_address], class: "form-control", placeholder: "ex: 12 Ri Kapwa", readonly: @auto_fill[:street_address].present? %>
                  </div>
                  <div class="col-md-4 bonid-autofill">
                    <label class="form-label fw-semibold">Kòd Postal</label>
                    <%= text_field_tag :code_postal, @auto_fill[:postal_code], class: "form-control", placeholder: "ex: HT6110", readonly: @auto_fill[:postal_code].present? %>
                  </div>
                  <div class="col-md-4 bonid-autofill">
                    <label class="form-label fw-semibold">Peyi</label>
                    <%= text_field_tag :pays, "Haiti", class: "form-control", readonly: true %>
                                      </div>
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">Telefon</label>
                    <%= text_field_tag :telephone, @auto_fill[:phone], class: "form-control", placeholder: "ex: +509 3XXX XXXX", readonly: @auto_fill[:phone].present? %>
                  </div>
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">Imel</label>
                    <%= email_field_tag :email_contact, @auto_fill[:email], class: "form-control", placeholder: "ex: non@imel.com", readonly: @auto_fill[:email].present? %>
                  </div>
                </div>
              </div>
            </div>
            <div class="d-flex justify-content-between mt-3">
              <button type="button" class="btn btn-outline-secondary btn-lg wizard-prev-btn" data-prev="1" style="min-height:48px;">
                <i class="ri-arrow-left-line me-1"></i> Retounen
              </button>
              <button type="button" class="btn btn-primary btn-lg wizard-next-btn" data-next="3" style="min-height:48px;background:var(--primary);border-color:var(--primary);">
                Kontinye <i class="ri-arrow-right-line ms-1"></i>
              </button>
            </div>
          </div>

          <%# STEP 3: RAS Calculation %>
          <div class="wizard-step-panel" id="wizardStep3" style="display:none;">
            <div class="dash-card">
              <div class="dash-card-header">
                <h6 class="dash-card-title" style="color:#D21034;"><span class="badge rounded-pill me-2" style="background:#D21034;">3</span>Kalkil Retni nan Sous (Seksyon IV)</h6>
              </div>
              <div class="dash-card-body">
                <div class="mb-3 p-2 rounded small" style="background:#f0f4ff;border:1px solid #ccd6f0;">
                  <strong style="color:var(--primary);"><i class="ri-information-line me-1"></i>Tranch Taks Revni:</strong>
                  <% @tranches.each do |t| %>
                    <span class="badge bg-light text-dark border ms-1"><%= t[:label] %></span>
                  <% end %>
                </div>

                <div class="row g-3 mb-3">
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">Salè Total Mansyel <span class="text-danger">*</span></label>
                    <div class="input-group">
                      <span class="input-group-text">HTG</span>
                      <%= number_field_tag :salaires_montant, nil, class: "form-control", min: 0, step: 0.01, required: true, placeholder: "0.00" %>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">Enpo sou Revni Retni (IR)</label>
                    <div class="input-group">
                      <span class="input-group-text">HTG</span>
                      <%= number_field_tag :salaires_impot, nil, class: "form-control", min: 0, step: 0.01, placeholder: "0.00" %>
                    </div>
                  </div>
                </div>

                <div class="row g-3 mb-3">
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">Boni ak Sipleman Brit</label>
                    <div class="input-group">
                      <span class="input-group-text">HTG</span>
                      <%= number_field_tag :bonis_montant, 0, class: "form-control", min: 0, step: 0.01, placeholder: "0.00" %>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">Enpo sou Boni (10%)</label>
                    <div class="input-group">
                      <span class="input-group-text">HTG</span>
                      <%= number_field_tag :bonis_impot, 0, class: "form-control", min: 0, step: 0.01, placeholder: "0.00" %>
                    </div>
                    <small class="text-muted">Kalkile otomatikman si vid.</small>
                  </div>
                </div>

                <div class="row g-3 mb-3">
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">Dividann Brit</label>
                    <div class="input-group">
                      <span class="input-group-text">HTG</span>
                      <%= number_field_tag :dividendes_montant, 0, class: "form-control", min: 0, step: 0.01, placeholder: "0.00" %>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">Enpo sou Dividann (20%)</label>
                    <div class="input-group">
                      <span class="input-group-text">HTG</span>
                      <%= number_field_tag :dividendes_impot, 0, class: "form-control", min: 0, step: 0.01, placeholder: "0.00" %>
                    </div>
                    <small class="text-muted">Kalkile otomatikman si vid.</small>
                  </div>
                </div>

                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">Enterè Reta</label>
                    <div class="input-group">
                      <span class="input-group-text">HTG</span>
                      <%= number_field_tag :interets_retard, 0, class: "form-control", min: 0, step: 0.01, placeholder: "0.00" %>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">Amand</label>
                    <div class="input-group">
                      <span class="input-group-text">HTG</span>
                      <%= number_field_tag :amende, 0, class: "form-control", min: 0, step: 0.01, placeholder: "0.00" %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="d-flex justify-content-between mt-3">
              <button type="button" class="btn btn-outline-secondary btn-lg wizard-prev-btn" data-prev="2" style="min-height:48px;">
                <i class="ri-arrow-left-line me-1"></i> Retounen
              </button>
              <button type="button" class="btn btn-primary btn-lg wizard-next-btn" data-next="4" style="min-height:48px;background:var(--primary);border-color:var(--primary);">
                Kontinye <i class="ri-arrow-right-line ms-1"></i>
              </button>
            </div>
          </div>

          <%# STEP 4: Employees %>
          <div class="wizard-step-panel" id="wizardStep4" style="display:none;">
            <div class="dash-card">
              <div class="dash-card-header">
                <h6 class="dash-card-title" style="color:#D21034;"><span class="badge rounded-pill me-2" style="background:#D21034;">4</span>Lis Anplwaye (Anèks)</h6>
              </div>
              <div class="dash-card-body">
                <p class="text-muted small mb-3">Ajoute anplwaye ki resevwa salè pandan mwa sa a.</p>
                <div id="employeeRows">
                  <% 3.times do |i| %>
                    <div class="row g-2 mb-2 employee-row align-items-end">
                      <div class="col-md-4">
                        <% if i == 0 %><label class="form-label fw-semibold small">Non Anplwaye</label><% end %>
                        <%= text_field_tag "employes[#{i}][nom_employe]", nil, class: "form-control form-control-sm", placeholder: "ex: Jean Pierre" %>
                      </div>
                      <div class="col-md-3">
                        <% if i == 0 %><label class="form-label fw-semibold small">NIF Anplwaye</label><% end %>
                        <%= text_field_tag "employes[#{i}][nif_employe]", nil, class: "form-control form-control-sm", placeholder: "000-000-000" %>
                      </div>
                      <div class="col-md-2">
                        <% if i == 0 %><label class="form-label fw-semibold small">Salè Brit</label><% end %>
                        <%= number_field_tag "employes[#{i}][salaire_brut]", nil, class: "form-control form-control-sm", min: 0, step: 0.01, placeholder: "0.00" %>
                      </div>
                      <div class="col-md-2">
                        <% if i == 0 %><label class="form-label fw-semibold small">IR Retni</label><% end %>
                        <%= number_field_tag "employes[#{i}][retenue_ir]", nil, class: "form-control form-control-sm", min: 0, step: 0.01, placeholder: "0.00" %>
                      </div>
                      <div class="col-md-1">
                        <% if i > 0 %>
                          <button type="button" class="btn btn-sm btn-outline-danger w-100 remove-employee-btn"><i class="ri-delete-bin-line"></i></button>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
                <button type="button" class="btn btn-sm btn-outline-primary mt-2" id="addEmployeeBtn">
                  <i class="ri-add-line me-1"></i>Ajoute Anplwaye
                </button>
              </div>
            </div>
            <div class="d-flex justify-content-between mt-3">
              <button type="button" class="btn btn-outline-secondary btn-lg wizard-prev-btn" data-prev="3" style="min-height:48px;">
                <i class="ri-arrow-left-line me-1"></i> Retounen
              </button>
              <button type="button" class="btn btn-primary btn-lg wizard-next-btn" data-next="5" style="min-height:48px;background:var(--primary);border-color:var(--primary);">
                Kontinye <i class="ri-arrow-right-line ms-1"></i>
              </button>
            </div>
          </div>

          <%# STEP 5: Revize %>
          <div class="wizard-step-panel" id="wizardStep5" style="display:none;" aria-hidden="true">
            <div class="dash-card">
              <div class="dash-card-header">
                <h6 class="dash-card-title" style="color:var(--primary);"><span class="badge rounded-pill me-2" style="background:var(--primary);">5</span>Revize Enfòmasyon Ou</h6>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="wizardPrintBtn" aria-label="Enprime rezime sa a">
                  <i class="ri-printer-line me-1" aria-hidden="true"></i>Enprime
                </button>
              </div>
              <div class="dash-card-body">
                <p class="small text-muted mb-3">Verifye enfòmasyon ou yo anvan ou kontinye. Ou ka retounen nan nenpòt etap pou korije.</p>
                <div class="wizard-summary" id="wizardSummary" role="region" aria-label="Rezime enfòmasyon ou">
                  <h6 class="wizard-summary__heading"><i class="ri-money-dollar-box-line me-2" style="color:var(--primary);" aria-hidden="true"></i>Rezime Deklarasyon RAS IR</h6>
                  <div id="summaryContent"></div>
                </div>
              </div>
            </div>
            <div class="d-flex justify-content-between mt-3">
              <button type="button" class="btn btn-outline-secondary btn-lg wizard-prev-btn" data-prev="4" style="min-height:48px;">
                <i class="ri-arrow-left-line me-1" aria-hidden="true"></i> Retounen
              </button>
              <button type="button" class="btn btn-lg text-white wizard-next-btn" data-next="6" style="min-height:48px;min-width:200px;background:var(--primary);border-color:var(--primary);">
                Kontinye <i class="ri-arrow-right-line ms-1" aria-hidden="true"></i>
              </button>
            </div>
          </div>

          <%# STEP 6: Siyati %>
          <div class="wizard-step-panel" id="wizardStep6" style="display:none;" aria-hidden="true">
            <div class="dash-card">
              <div class="dash-card-header">
                <h6 class="dash-card-title" style="color:#92400e;"><span class="badge rounded-pill me-2" style="background:#92400e;">6</span>Sètifikasyon ak Siyati</h6>
              </div>
              <div class="dash-card-body">
                <%= render "citizens/dgi/siyati_content" %>
              </div>
            </div>
            <div class="d-flex justify-content-between mt-3">
              <button type="button" class="btn btn-outline-secondary btn-lg wizard-prev-btn" data-prev="5" style="min-height:48px;">
                <i class="ri-arrow-left-line me-1" aria-hidden="true"></i> Retounen
              </button>
              <button type="button" class="btn btn-lg text-white wizard-next-btn dgi-submit-btn" data-next="7" disabled style="min-height:48px;min-width:200px;background:var(--primary);border-color:var(--primary);">
                Kontinye <i class="ri-arrow-right-line ms-1" aria-hidden="true"></i>
              </button>
            </div>
          </div>

          <%# STEP 7: Peyman %>
          <div class="wizard-step-panel" id="wizardStep7" style="display:none;" aria-hidden="true">
            <div class="dash-card">
              <div class="dash-card-header">
                <h6 class="dash-card-title" style="color:#D21034;"><span class="badge rounded-pill me-2" style="background:#D21034;">7</span>Peyman ak Soumisyon</h6>
              </div>
              <div class="dash-card-body">
                <%# Fee Breakdown %>
                <div class="wizard-trust-intro mb-3" role="status" style="border-left-color:#92400e;background:#fef3c7;">
                  <h6 class="small fw-bold mb-2"><i class="ri-money-dollar-circle-line me-1"></i>Frè Sèvis</h6>
                  <table class="table table-sm table-borderless small mb-0">
                    <tr><td><i class="ri-government-line me-1" aria-hidden="true"></i>DGI (Deklarasyon RAS IR)</td><td class="text-end fw-semibold">Gratuit</td></tr>
                    <tr><td><i class="ri-service-line me-1" aria-hidden="true"></i>Frè sèvis</td><td class="text-end fw-semibold text-success"><%= DgiPayment.bongouv_fee_for("ras_ir_declaration").to_i %> HTG</td></tr>
                    <tr><td><i class="ri-calculator-line me-1" aria-hidden="true"></i>Retni sou salè</td><td class="text-end fst-italic text-muted">Kalkile apre soumisyon</td></tr>
                  </table>
                  <p class="mb-0 small text-muted mt-2"><i class="ri-information-line me-1" aria-hidden="true"></i>Montan retni kalkile sou lis salè anplwaye yo.</p>
                </div>

              </div>
            </div>
            <div class="d-flex justify-content-between mt-3">
              <button type="button" class="btn btn-outline-secondary btn-lg wizard-prev-btn" data-prev="6" style="min-height:48px;">
                <i class="ri-arrow-left-line me-1" aria-hidden="true"></i> Retounen
              </button>
              <button type="submit" class="btn btn-lg text-white" style="min-height:48px;min-width:200px;background:#D21034;border-color:#D21034;">
                <i class="ri-send-plane-line me-1" aria-hidden="true"></i> Soumèt Deklarasyon RAS IR
              </button>
            </div>
          </div>

        <%# ======================================================= %>
        <%# FERMAGE (DGI-55) — Land Lease Tax — 6 Steps %>
        <%# ======================================================= %>
        <% elsif @form_type == "fermage" %>

          <% frm_steps = ["Fèmye", "Adrès", "Pwopriyete", "Kalkil Taks", "Revize", "Siyati", "Peyman"] %>
          <% frm_hints = ["Enfòmasyon sou fèmye a", "Adrès pwopriyete a", "Detay pwopriyete a", "Kalkil taks fèmaj", "Revize tout enfòmasyon ou", "Sètifye ak siyen fòm lan", "Frè sèvis ak soumisyon"] %>
          <div class="dash-card mb-4">
            <div class="dash-card-body py-3">
              <div class="dgi-wizard-progress" id="wizardProgress">
                <% frm_steps.each_with_index do |label, i| %>
                  <div class="wizard-step-indicator <%= 'active' if i == 0 %>" data-step="<%= i + 1 %>" data-hint="<%= frm_hints[i] %>" role="tab" tabindex="0" aria-current="<%= i == 0 ? 'step' : 'false' %>" aria-label="Etap <%= i + 1 %>: <%= label %>">
                    <div class="wizard-step-dot" aria-hidden="true"><%= i + 1 %></div>
                    <span class="wizard-step-label"><%= label %></span>
                  </div>
                  <% if i < frm_steps.length - 1 %><div class="wizard-step-line"></div><% end %>
                <% end %>
              </div>
              <p class="wizard-step-hint text-center text-muted small mb-0 mt-2" id="wizardStepHint"><%= frm_hints[0] %></p>
            </div>
          </div>

          <%# STEP 1: Fermier Info %>
          <div class="wizard-step-panel" id="wizardStep1" style="display:block;">
            <div class="dash-card">
              <div class="dash-card-header">
                <h6 class="dash-card-title" style="color:#D21034;"><span class="badge rounded-pill me-2" style="background:#D21034;">1</span>Enfòmasyon Fèmye</h6>
                <span class="badge bg-success"><i class="ri-magic-line me-1"></i>BonID Pre-ranpli</span>
              </div>
              <div class="dash-card-body">
                <div class="row g-3">
                  <div class="col-md-8 bonid-autofill">
                    <label class="form-label fw-semibold">Non Fèmye <span class="text-danger">*</span></label>
                    <%= text_field_tag :nom_fermier, @auto_fill[:full_name], class: "form-control", required: true, placeholder: "Non konplè fèmye a", readonly: @auto_fill[:full_name].present? %>
                  </div>
                  <div class="col-md-4 bonid-autofill">
                    <label class="form-label fw-semibold">Nimewo CIN</label>
                    <%= text_field_tag :cin_fermier, @auto_fill[:cin], class: "form-control", placeholder: "00-00-00-0000-00-00000", readonly: @auto_fill[:cin].present? %>
                  </div>
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">NIF</label>
                    <%= text_field_tag :nif_fermier, @auto_fill[:nif], class: "form-control", placeholder: "ex: 000-000-000", readonly: @auto_fill[:nif].present? %>
                  </div>
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">Demeurant à <span class="text-danger">*</span></label>
                    <%= text_field_tag :demeurant_a, @auto_fill[:street_address], class: "form-control", required: true, placeholder: "Adrès rezidans", readonly: @auto_fill[:street_address].present? %>
                  </div>
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">Telefon</label>
                    <%= text_field_tag :telephone, @auto_fill[:phone], class: "form-control", placeholder: "+509 XXXX XXXX", readonly: @auto_fill[:phone].present? %>
                  </div>
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">Imel</label>
                    <%= email_field_tag :email_contact, @auto_fill[:email], class: "form-control", placeholder: "non@imel.com", readonly: @auto_fill[:email].present? %>
                  </div>
                </div>
              </div>
            </div>
            <div class="d-flex justify-content-between mt-3">
              <%= link_to citizens_dgi_index_path, class: "btn btn-outline-secondary btn-lg", style: "min-height:48px;" do %>
                <i class="ri-arrow-left-line me-1"></i> Retounen
              <% end %>
              <button type="button" class="btn btn-primary btn-lg wizard-next-btn" data-next="2" style="min-height:48px;background:var(--primary);border-color:var(--primary);">
                Kontinye <i class="ri-arrow-right-line ms-1"></i>
              </button>
            </div>
          </div>

          <%# STEP 2: Address %>
          <div class="wizard-step-panel" id="wizardStep2" style="display:none;" aria-hidden="true">
            <div class="dash-card">
              <div class="dash-card-header">
                <h6 class="dash-card-title" style="color:#D21034;"><span class="badge rounded-pill me-2" style="background:#D21034;">2</span>Adrès Pwopriyete</h6>
                <span class="badge bg-success"><i class="ri-magic-line me-1"></i>BonID Pre-ranpli</span>
              </div>
              <div class="dash-card-body">
                <p class="fw-bold small mb-2" style="color:var(--primary);"><i class="ri-map-pin-line me-1"></i>Kote pwopriyete a ye</p>
                <div class="row g-3">
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">Depatman <span class="text-danger">*</span></label>
                    <%= select_tag :departement,
                        options_for_select(RecordSchemas::NifRegistrationSchema::DEPARTEMENTS_HAITI, @auto_fill[:department]),
                        class: "form-select", required: true, prompt: "-- Chwazi --", disabled: @auto_fill[:department].present? %>
                    <%= hidden_field_tag :departement, @auto_fill[:department] if @auto_fill[:department].present? %>
                  </div>
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">Komin <span class="text-danger">*</span></label>
