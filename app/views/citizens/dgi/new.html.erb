<% if @draft.present? %>
<script>
document.addEventListener("DOMContentLoaded", function() {
  var draftData = <%= raw @draft_data.to_json %>;
  var draftStep = <%= @draft_step %>;
  var form = document.getElementById("wizardForm");
  if (!form) return;

  // Restore form field values from draft
  Object.keys(draftData).forEach(function(key) {
    // Skip internal draft metadata
    if (key === "draft_step" || key === "draft_updated_at" || key === "filed_by") return;
    var input = form.querySelector('[name="' + key + '"]');
    if (!input) return;
    if (input.type === "file" || input.type === "hidden") return;
    if (input.readOnly || input.disabled) return;

    if (input.tagName === "SELECT") {
      // Try to set select value
      for (var i = 0; i < input.options.length; i++) {
        if (input.options[i].value === draftData[key]) {
          input.selectedIndex = i;
          input.dispatchEvent(new Event("change", { bubbles: true }));
          break;
        }
      }
    } else if (input.type === "radio") {
      var radios = form.querySelectorAll('[name="' + key + '"]');
      radios.forEach(function(r) {
        if (r.value === draftData[key]) {
          r.checked = true;
          r.dispatchEvent(new Event("change", { bubbles: true }));
        }
      });
    } else if (input.type === "checkbox") {
      input.checked = draftData[key] === "1" || draftData[key] === "true";
    } else {
      input.value = draftData[key];
    }
  });

  // Navigate to saved step
  if (draftStep > 1 && window.__wizardShowStep) {
    setTimeout(function() {
      window.__wizardShowStep(draftStep);
    }, 300);
  }
});
</script>
<% end %>

<% if @form_type == "business_registration" %>
<script>
document.addEventListener("DOMContentLoaded", function() {
  // Toggle établissements section
  var etablSection = document.getElementById("etablissementsSection");
  document.querySelectorAll('input[name="autres_etablissements"]').forEach(function(radio) {
    radio.addEventListener("change", function() {
      etablSection.style.display = this.value === "oui" ? "block" : "none";
    });
  });

  // Add new établissement row
  var etablIdx = 3;
  var addEtablBtn = document.getElementById("addEtablissementBtn");
  if (addEtablBtn) {
    addEtablBtn.addEventListener("click", function() {
      var row = document.createElement("div");
      row.className = "border rounded p-3 mb-3 etablissement-row";
      row.innerHTML =
        '<div class="d-flex justify-content-between mb-2"><p class="fw-semibold small mb-0" style="color:#D21034;">Etablisman '+etablIdx+'</p>' +
        '<button type="button" class="btn btn-sm btn-outline-danger remove-etablissement-btn"><i class="ri-delete-bin-line"></i></button></div>' +
        '<div class="row g-2">' +
        '<div class="col-md-6"><label class="form-label small">30a. Non Komèsyal</label><input type="text" name="etablissements['+etablIdx+'][nom_commercial]" class="form-control form-control-sm"></div>' +
        '<div class="col-md-6"><label class="form-label small">30b. Nimewo ak Non Ri</label><input type="text" name="etablissements['+etablIdx+'][adresse]" class="form-control form-control-sm"></div>' +
        '<div class="col-md-4"><label class="form-label small">30c. Zòn</label><input type="text" name="etablissements['+etablIdx+'][zone]" class="form-control form-control-sm"></div>' +
        '<div class="col-md-4"><label class="form-label small">30d. Depatman</label><input type="text" name="etablissements['+etablIdx+'][departement]" class="form-control form-control-sm"></div>' +
        '<div class="col-md-4"><label class="form-label small">30e. Komin</label><input type="text" name="etablissements['+etablIdx+'][commune]" class="form-control form-control-sm"></div>' +
        '</div>';
      document.getElementById("etablissementRows").appendChild(row);
      etablIdx++;
    });
  }
  document.addEventListener("click", function(e) {
    if (e.target.closest(".remove-etablissement-btn")) {
      e.target.closest(".etablissement-row").remove();
    }
  });
});
</script>
<% end %>

<% if @form_type == "ras_ir_declaration" %>
<script>
document.addEventListener("DOMContentLoaded", function() {
  var idx = 3;
