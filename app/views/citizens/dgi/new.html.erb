<%# Citizen Self-Service — DGI Filing Form (Multi-Step Wizard) %>
<%# Uses citizen's own layout (dash-card). BonGouv styles only on DGI index. %>
<%# Follows USWDS "Complete a complex form" patterns: %>
<%#   - Establish trust: intro with requirements, time estimate, data safety %>
<%#   - Progress easily: step indicator, inline validation, help option %>
<%#   - Keep a record: summary before submit, print button, print stylesheet %>
<% payment_methods = current_citizen.bank_profiles.where(currently_open: true).order(:account_source) %>

<%# USWDS time estimates by form type %>
<% time_estimates = {
  "nif_registration" => "5-8 minit",
  "business_registration" => "8-12 minit",
  "patente_declaration" => "5-7 minit",
  "tca_declaration" => "5-7 minit",
  "ras_ir_declaration" => "10-15 minit",
  "fermage" => "5-8 minit"
} %>

<%# USWDS required info list by form type %>
<% required_info = {
  "nif_registration" => ["Non konplè ou", "Dat nesans", "Adrès aktyèl", "Nimewo telefòn", "Tip aktivite"],
  "business_registration" => ["Non antrepriz la", "Fòm jridik", "Enfòmasyon pwopriyetè", "Adrès biznis"],
  "patente_declaration" => ["Nimewo NIF", "Rezon sosyal", "Chif afe anyèl"],
  "tca_declaration" => ["Nimewo NIF", "Rezon sosyal", "Chif afe brit pou mwa a"],
  "ras_ir_declaration" => ["Nimewo NIF", "Rezon sosyal", "Lis anplwaye ak salè"],
  "fermage" => ["Non fèmye", "Adrès pwopriyete", "Montan taks (dwa anyèl, sitaks, DTP, solidarite)"]
} %>

<%# Skip navigation link — USWDS Accessibility %>
<a href="#bongouv-wizard-main" class="bongouv-skip-nav">Ale nan fòmilè a</a>

<%# Draft auto-save endpoint %>
<meta name="draft-save-url" content="<%= save_draft_citizens_dgi_index_path %>">

<%# ================================================================ %>
<%# ONE CARD — banner header + trust intro body %>
<%# ================================================================ %>
<div id="bongouv-wizard-main" class="px-0">

<div class="row justify-content-center">
  <div class="col-lg-8">

  <%# ── Page Header ── %>
  <div class="d-flex justify-content-between align-items-center mb-2">
    <%= link_to citizens_dgi_index_path, class: "dgi-back-link", data: { turbo: false } do %>
      <i class="ri-arrow-left-s-line"></i> Retounen
    <% end %>
    <span id="draftIndicator" class="text-muted" style="font-size:0.7rem; opacity:0.6;">
      <i class="ri-save-line me-1"></i><span>Otomatik sovgade</span>
    </span>
  </div>
  <div class="text-center mb-4">
    <h3 class="citizen-page-title mb-1">
      <i class="ri-file-edit-line me-2"></i><%= @form_label[:title] %>
    </h3>
    <p class="text-muted mb-0" style="font-size: 0.78rem;">
      Direksyon Jeneral Enpo — Depoze fòm fiskal ou anliy.
    </p>
  </div>
  <style>
    .dgi-back-link {
      display: inline-flex; align-items: center; gap: 0.3rem;
      font-size: 0.82rem; font-weight: 500; color: #6B7280;
      text-decoration: none; transition: color 0.15s;
    }
    .dgi-back-link:hover { color: var(--primary); }
  </style>

  <%# ARIA live region for screen reader announcements %>
  <div id="wizardLiveRegion" class="visually-hidden" aria-live="polite" aria-atomic="true">
    Etap 1 nan <%= time_estimates.key?(@form_type) ? (required_info[@form_type]&.length || 3) : 3 %>
  </div>

  <div style="border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.06); margin-bottom: 24px;">
    <% if @resubmission && @draft_data["rejection"].is_a?(Hash) %>
      <div style="background:#fef2f2; padding:12px 24px; border-bottom:1px solid #fecaca; display:flex; align-items:start; gap:8px;">
        <i class="ri-error-warning-line" style="color:#dc2626; margin-top:2px;"></i>
        <div style="font-size:0.82rem; color:#991b1b;">
          <strong>Rezon rejè:</strong>
          <span class="badge" style="background:#dc2626; color:#fff; font-size:0.7rem;"><%= @draft_data.dig("rejection", "code") %></span>
          <%= @draft_data.dig("rejection", "reason") %>
          <% if @draft_data.dig("rejection", "notes").present? %>
            <br><small class="text-muted"><i class="ri-message-2-line me-1"></i><%= @draft_data.dig("rejection", "notes") %></small>
          <% end %>
          <br><small style="color:#6b7280;">Korije erè yo epi soumèt ankò. Pa gen peman adisyonèl.</small>
        </div>
      </div>
    <% elsif @draft.present? %>
      <div style="background:#eff6ff; padding:12px 24px; border-bottom:1px solid #bfdbfe; display:flex; align-items:center; justify-content:space-between;">
        <span style="font-size:0.82rem; color:#1e40af;">
          <i class="ri-draft-line me-1"></i>Ou gen yon bouyon ki sovgade — etap <%= @draft_step %>.
          <small style="color:#6b7280;">Dènye modifikasyon: <%= Time.parse(@draft_data["draft_updated_at"]).strftime("%d/%m/%Y %H:%M") rescue "" %></small>
        </span>
        <%= link_to new_citizens_dgi_path(form_type: @form_type, discard_draft: true), style: "font-size:0.75rem; color:#dc2626; text-decoration:none;", data: { confirm: "Efase bouyon sa a epi rekòmanse?" } do %>
          <i class="ri-delete-bin-line me-1"></i>Efase bouyon
        <% end %>
      </div>
    <% end %>
    <%# Card body — trust intro %>
    <div style="background: #fff; padding: 20px 24px;" role="region" aria-label="Enfòmasyon avan ou kòmanse">
      <h5 class="wizard-trust-intro__heading"><i class="ri-shield-check-line me-2" aria-hidden="true"></i>Sa ou bezwen pou ranpli fòm sa a</h5>
      <ul class="wizard-trust-intro__list">
        <% (required_info[@form_type] || []).each do |item| %>
          <li><i class="ri-check-line" aria-hidden="true"></i><%= item %></li>
        <% end %>
      </ul>
      <p class="wizard-trust-intro__meta">
        <span><i class="ri-time-line" aria-hidden="true"></i>Anviwon <%= time_estimates[@form_type] || "5-10 minit" %></span>
        <span><i class="ri-lock-line" aria-hidden="true"></i>Done ou yo pwoteje ak BonID</span>
        <span><i class="ri-magic-line" aria-hidden="true"></i>Chan yo pre-ranpli ak profil BonID ou</span>
      </p>
    </div>
  </div>

  <%# Print header — hidden on screen, shown in print (USWDS "Keep a record") %>
  <div class="wizard-print-header">
    <p class="wizard-print-header__title">Direction Generale des Impots — <%= @form_label[:title] %></p>
    <p class="wizard-print-header__meta">
      BonGouv | Dat: <%= Date.current.strftime("%d/%m/%Y") %> | Kontribyab: <%= @auto_fill[:first_name] %> <%= @auto_fill[:last_name] %>
    </p>
  </div>

  <div>
      <% form_url = @resubmission ? update_resubmit_citizens_dgi_path(@record) : citizens_dgi_index_path %>
      <%= form_tag form_url, method: :post, id: "wizardForm", multipart: true, aria: { label: @form_label[:title] } do %>
        <%= hidden_field_tag :form_type, @form_type %>

        <%# ======================================================= %>
        <%# NIF REGISTRATION (Formulaire A) — 4 Steps %>
        <%# ======================================================= %>
        <% if @form_type == "nif_registration" %>

          <% nif_steps = ["Pèsonèl", "Adrès", "Aktivite", "Revize", "Siyati", "Peyman"] %>
          <% nif_hints = ["Ranpli enfòmasyon pèsonèl ou", "Adrès aktyèl ak kontak", "Aktivite ekonomik ou", "Revize tout enfòmasyon ou", "Sètifye ak siyen fòm lan", "Frè sèvis ak soumisyon"] %>
          <div class="dash-card mb-4">
            <div class="dash-card-body py-3">
              <div class="dgi-wizard-progress" id="wizardProgress">
                <% nif_steps.each_with_index do |label, i| %>
                  <div class="wizard-step-indicator <%= 'active' if i == 0 %>" data-step="<%= i + 1 %>" data-hint="<%= nif_hints[i] %>" role="tab" tabindex="0" aria-current="<%= i == 0 ? 'step' : 'false' %>" aria-label="Etap <%= i + 1 %>: <%= label %>">
                    <div class="wizard-step-dot" aria-hidden="true"><%= i + 1 %></div>
                    <span class="wizard-step-label"><%= label %></span>
                  </div>
                  <% if i < nif_steps.length - 1 %><div class="wizard-step-line"></div><% end %>
                <% end %>
              </div>
              <p class="wizard-step-hint text-center text-muted small mb-0 mt-2" id="wizardStepHint"><%= nif_hints[0] %></p>
            </div>
          </div>

          <%# STEP 1: Personne %>
          <div class="wizard-step-panel" id="wizardStep1" style="display:block;">
            <div class="dash-card">
              <div class="dash-card-header">
                <h6 class="dash-card-title" style="color:#D21034;"><span class="badge rounded-pill me-2" style="background:#D21034;">1</span>Enfòmasyon Pèsonèl</h6>
                <span class="badge bg-success"><i class="ri-magic-line me-1"></i>BonID Pre-ranpli</span>
              </div>
              <div class="dash-card-body">
                <div class="row g-3">
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">Non <span class="text-danger">*</span></label>
                    <%= text_field_tag :nom, @auto_fill[:last_name], class: "form-control", required: true, placeholder: "ex: Jòj", readonly: @auto_fill[:last_name].present? %>
                                      </div>
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">Prenon <span class="text-danger">*</span></label>
                    <%= text_field_tag :prenom, @auto_fill[:first_name], class: "form-control", required: true, placeholder: "ex: Jean", readonly: @auto_fill[:first_name].present? %>
                                      </div>
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">Dat Nesans <span class="text-danger">*</span></label>
                    <%= date_field_tag :date_naissance, @auto_fill[:date_of_birth], class: "form-control", required: true, readonly: @auto_fill[:date_of_birth].present? %>
                  </div>
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">Kote Ou Fèt <span class="text-danger">*</span></label>
                    <% lieu = [@auto_fill[:birth_commune], @auto_fill[:birth_department]].compact.join(", ") %>
                    <%= text_field_tag :lieu_naissance, lieu, class: "form-control", required: true, placeholder: "ex: Pòtoprens, Lwès", readonly: lieu.present? %>
                  </div>
                  <div class="col-md-4 bonid-autofill">
                    <label class="form-label fw-semibold">Seks</label>
                    <%= select_tag :sexe, options_for_select(RecordSchemas::NifRegistrationSchema::SEXES.map { |k, v| [v, k] }, @auto_fill[:sex]),
                        class: "form-select", prompt: "-- Chwazi --", disabled: @auto_fill[:sex].present? %>
                    <%= hidden_field_tag :sexe, @auto_fill[:sex] if @auto_fill[:sex].present? %>
                  </div>
                  <div class="col-md-4 bonid-autofill">
                    <label class="form-label fw-semibold">Eta Sivil</label>
                    <%= select_tag :etat_civil,
                        options_for_select(RecordSchemas::NifRegistrationSchema::ETATS_CIVILS.map { |k, v| [v, k] }, @auto_fill[:marital_status]),
                        class: "form-select", prompt: "-- Chwazi --", disabled: @auto_fill[:marital_status].present? %>
                    <%= hidden_field_tag :etat_civil, @auto_fill[:marital_status] if @auto_fill[:marital_status].present? %>
                  </div>
                  <div class="col-md-4 bonid-autofill">
                    <label class="form-label fw-semibold">Nasyonalite</label>
                    <%= text_field_tag :nationalite, @auto_fill[:nationality], class: "form-control", placeholder: "ex: Ayisyen", readonly: @auto_fill[:nationality].present? %>
                  </div>
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">Nimewo CIN</label>
                    <%= text_field_tag :numero_cin, @auto_fill[:cin], class: "form-control", placeholder: "00-00-00-0000-00-00000", readonly: @auto_fill[:cin].present? %>
                  </div>
                </div>
              </div>
            </div>
            <div class="d-flex justify-content-between mt-3">
              <%= link_to citizens_dgi_index_path, class: "btn btn-outline-secondary btn-lg", style: "min-height:48px;" do %>
                <i class="ri-arrow-left-line me-1" aria-hidden="true"></i> Retounen
              <% end %>
              <button type="button" class="btn btn-primary btn-lg wizard-next-btn" data-next="2" style="min-height:48px;background:var(--primary);border-color:var(--primary);">
                Kontinye <i class="ri-arrow-right-line ms-1"></i>
              </button>
            </div>
          </div>

          <%# STEP 2: Adresse %>
          <div class="wizard-step-panel" id="wizardStep2" style="display:none;">
            <div class="dash-card">
              <div class="dash-card-header">
                <h6 class="dash-card-title" style="color:#D21034;"><span class="badge rounded-pill me-2" style="background:#D21034;">2</span>Adrès ak Kontak</h6>
                <span class="badge bg-success"><i class="ri-magic-line me-1"></i>BonID Pre-ranpli</span>
              </div>
              <div class="dash-card-body">
                <p class="fw-bold small mb-2" style="color:var(--primary);"><i class="ri-map-pin-line me-1"></i>Adrès</p>
                <div class="row g-3">
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">Depatman <span class="text-danger">*</span></label>
                    <%= select_tag :departement,
                        options_for_select(RecordSchemas::NifRegistrationSchema::DEPARTEMENTS_HAITI, @auto_fill[:department]),
                        class: "form-select", required: true, prompt: "-- Chwazi --", disabled: @auto_fill[:department].present? %>
                    <%= hidden_field_tag :departement, @auto_fill[:department] if @auto_fill[:department].present? %>
                  </div>
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">Komin <span class="text-danger">*</span></label>
                    <%= text_field_tag :commune, @auto_fill[:commune], class: "form-control", required: true, placeholder: "ex: Pétion-Ville", readonly: @auto_fill[:commune].present? %>
                  </div>
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">Seksyon Kominal</label>
                    <%= text_field_tag :section_communale, @auto_fill[:section_communale], class: "form-control", placeholder: "ex: 1è Seksyon", readonly: @auto_fill[:section_communale].present? %>
                  </div>
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">Zòn / Lokalite</label>
                    <%= text_field_tag :ville, @auto_fill[:locality], class: "form-control", placeholder: "ex: Boulva 15", readonly: @auto_fill[:locality].present? %>
                  </div>
                  <div class="col-12 bonid-autofill">
                    <label class="form-label fw-semibold">Adrès Ri (Nimewo ak Non Ri) <span class="text-danger">*</span></label>
                    <%= text_field_tag :rue, @auto_fill[:street_address], class: "form-control", required: true, placeholder: "ex: 12 Ri Kapwa", readonly: @auto_fill[:street_address].present? %>
                  </div>
                  <div class="col-md-4 bonid-autofill">
                    <label class="form-label fw-semibold">Kòd Postal</label>
                    <%= text_field_tag :code_postal, @auto_fill[:postal_code], class: "form-control", placeholder: "ex: HT6110", readonly: @auto_fill[:postal_code].present? %>
                  </div>
                  <div class="col-md-4 bonid-autofill">
                    <label class="form-label fw-semibold">Peyi</label>
                    <%= text_field_tag :pays, @auto_fill[:country] || "Haiti", class: "form-control", readonly: true %>
                                      </div>
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">Telefon <span class="text-danger">*</span></label>
                    <%= text_field_tag :telephone, @auto_fill[:phone], class: "form-control", required: true, placeholder: "ex: +509 3XXX XXXX", readonly: @auto_fill[:phone].present? %>
                  </div>
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">Imel</label>
                    <%= email_field_tag :email_contact, @auto_fill[:email], class: "form-control", placeholder: "ex: non@imel.com", readonly: @auto_fill[:email].present? %>
                  </div>
                </div>
              </div>
            </div>
            <div class="d-flex justify-content-between mt-3">
              <button type="button" class="btn btn-outline-secondary btn-lg wizard-prev-btn" data-prev="1" style="min-height:48px;">
                <i class="ri-arrow-left-line me-1"></i> Retounen
              </button>
              <button type="button" class="btn btn-primary btn-lg wizard-next-btn" data-next="3" style="min-height:48px;background:var(--primary);border-color:var(--primary);">
                Kontinye <i class="ri-arrow-right-line ms-1"></i>
              </button>
            </div>
          </div>

          <%# STEP 3: Activite %>
          <div class="wizard-step-panel" id="wizardStep3" style="display:none;">
            <div class="dash-card">
              <div class="dash-card-header">
                <h6 class="dash-card-title" style="color:#D21034;"><span class="badge rounded-pill me-2" style="background:#D21034;">3</span>Aktivite Ekonomik</h6>
              </div>
              <div class="dash-card-body">
                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">Tip Aktivite</label>
                    <%= select_tag :type_activite,
                        options_for_select(RecordSchemas::NifRegistrationSchema::TYPES_ACTIVITE.map { |k, v| [v, k] }),
                        class: "form-select", prompt: "-- Chwazi --" %>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">Revni Anyel Estime (HTG)</label>
                    <div class="input-group">
                      <span class="input-group-text">HTG</span>
                      <%= number_field_tag :revenu_annuel, nil, class: "form-control", min: 0, step: 0.01, placeholder: "0.00" %>
                    </div>
                  </div>
                  <div class="col-12">
                    <label class="form-label fw-semibold">Deskripsyon Aktivite</label>
                    <%= text_area_tag :description_activite, nil, class: "form-control", rows: 2, placeholder: "ex: Vann pwodwi alimantè nan mache..." %>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">Non Anplwayè (si salarye)</label>
                    <%= text_field_tag :nom_employeur, nil, class: "form-control", placeholder: "ex: Digicel Haiti" %>
                  </div>
                </div>
              </div>
            </div>
            <div class="d-flex justify-content-between mt-3">
              <button type="button" class="btn btn-outline-secondary btn-lg wizard-prev-btn" data-prev="2" style="min-height:48px;">
                <i class="ri-arrow-left-line me-1"></i> Retounen
              </button>
              <button type="button" class="btn btn-primary btn-lg wizard-next-btn" data-next="4" style="min-height:48px;background:var(--primary);border-color:var(--primary);">
                Kontinye <i class="ri-arrow-right-line ms-1"></i>
              </button>
            </div>
          </div>

          <%# STEP 4: Revize %>
          <div class="wizard-step-panel" id="wizardStep4" style="display:none;" aria-hidden="true">
            <div class="dash-card">
              <div class="dash-card-header">
                <h6 class="dash-card-title" style="color:var(--primary);"><span class="badge rounded-pill me-2" style="background:var(--primary);">4</span>Revize Enfòmasyon Ou</h6>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="wizardPrintBtn" aria-label="Enprime rezime sa a">
                  <i class="ri-printer-line me-1" aria-hidden="true"></i>Enprime
                </button>
              </div>
              <div class="dash-card-body">
                <p class="small text-muted mb-3">Verifye enfòmasyon ou yo anvan ou kontinye. Ou ka retounen nan nenpòt etap pou korije.</p>
                <div class="wizard-summary" id="wizardSummary" role="region" aria-label="Rezime enfòmasyon ou">
                  <h6 class="wizard-summary__heading"><i class="ri-file-list-3-line me-2" style="color:var(--primary);" aria-hidden="true"></i>Rezime Enskripsyon NIF</h6>
                  <div id="summaryContent"></div>
                </div>
              </div>
            </div>
            <div class="d-flex justify-content-between mt-3">
              <button type="button" class="btn btn-outline-secondary btn-lg wizard-prev-btn" data-prev="3" style="min-height:48px;">
                <i class="ri-arrow-left-line me-1" aria-hidden="true"></i> Retounen
              </button>
              <button type="button" class="btn btn-lg text-white wizard-next-btn" data-next="5" style="min-height:48px;min-width:200px;background:var(--primary);border-color:var(--primary);">
                Kontinye <i class="ri-arrow-right-line ms-1" aria-hidden="true"></i>
              </button>
            </div>
          </div>

          <%# STEP 5: Siyati %>
          <div class="wizard-step-panel" id="wizardStep5" style="display:none;" aria-hidden="true">
            <div class="dash-card">
              <div class="dash-card-header">
                <h6 class="dash-card-title" style="color:#92400e;"><span class="badge rounded-pill me-2" style="background:#92400e;">5</span>Sètifikasyon ak Siyati</h6>
              </div>
              <div class="dash-card-body">
                <%= render "citizens/dgi/siyati_content" %>
              </div>
            </div>
            <div class="d-flex justify-content-between mt-3">
              <button type="button" class="btn btn-outline-secondary btn-lg wizard-prev-btn" data-prev="4" style="min-height:48px;">
                <i class="ri-arrow-left-line me-1" aria-hidden="true"></i> Retounen
              </button>
              <button type="button" class="btn btn-lg text-white wizard-next-btn dgi-submit-btn" data-next="6" disabled style="min-height:48px;min-width:200px;background:var(--primary);border-color:var(--primary);">
                Kontinye <i class="ri-arrow-right-line ms-1" aria-hidden="true"></i>
              </button>
            </div>
          </div>

          <%# STEP 6: Peyman %>
          <div class="wizard-step-panel" id="wizardStep6" style="display:none;" aria-hidden="true">
            <div class="dash-card">
              <div class="dash-card-header">
                <h6 class="dash-card-title" style="color:#D21034;"><span class="badge rounded-pill me-2" style="background:#D21034;">6</span>Peyman ak Soumisyon</h6>
              </div>
              <div class="dash-card-body">
                <%# Fee Breakdown %>
                <div class="wizard-trust-intro mb-3" role="status" style="border-left-color:#92400e;background:#fef3c7;">
                  <h6 class="small fw-bold mb-2"><i class="ri-money-dollar-circle-line me-1"></i>Frè Sèvis</h6>
                  <table class="table table-sm table-borderless small mb-0">
                    <tr><td><i class="ri-government-line me-1" aria-hidden="true"></i>DGI (Kat Fiskal)</td><td class="text-end fw-semibold">1,000 HTG</td></tr>
                    <tr><td><i class="ri-service-line me-1" aria-hidden="true"></i>Frè sèvis</td><td class="text-end fw-semibold text-success"><%= DgiPayment.bongouv_fee_for("nif_registration").to_i %> HTG</td></tr>
                    <tr class="border-top"><td class="fw-bold">Total</td><td class="text-end fw-bold"><%= number_with_delimiter(DgiPayment.service_fee_for("nif_registration").to_i) %> HTG</td></tr>
                  </table>
                </div>

              </div>
            </div>
            <div class="d-flex justify-content-between mt-3">
              <button type="button" class="btn btn-outline-secondary btn-lg wizard-prev-btn" data-prev="5" style="min-height:48px;">
                <i class="ri-arrow-left-line me-1" aria-hidden="true"></i> Retounen
              </button>
              <button type="submit" class="btn btn-lg text-white" style="min-height:48px;min-width:200px;background:#D21034;border-color:#D21034;">
                <i class="ri-send-plane-line me-1" aria-hidden="true"></i> Soumèt Enskripsyon NIF
              </button>
            </div>
          </div>

        <%# ======================================================= %>
        <%# BUSINESS REGISTRATION (Formulaire B) — 5 Steps %>
        <%# Matches official DGI Formulaire B: Sections 1-5 %>
        <%# ======================================================= %>
        <% elsif @form_type == "business_registration" %>

          <% biz_steps = ["Enfòmasyon", "Pwopriyetè", "Kontak", "Adrès", "Revize", "Siyati", "Peyman"] %>
          <% biz_hints = ["Enfòmasyon jeneral biznis la", "Enfòmasyon pwopriyetè/direktè", "Kontak biznis la", "Adrès ak etablisman", "Revize tout enfòmasyon ou", "Sètifye ak siyen fòm lan", "Frè sèvis ak soumisyon"] %>
          <div class="dash-card mb-4">
            <div class="dash-card-body py-3">
              <div class="dgi-wizard-progress many-steps" id="wizardProgress">
                <% biz_steps.each_with_index do |label, i| %>
                  <div class="wizard-step-indicator <%= 'active' if i == 0 %>" data-step="<%= i + 1 %>" data-hint="<%= biz_hints[i] %>" role="tab" tabindex="0" aria-current="<%= i == 0 ? 'step' : 'false' %>" aria-label="Etap <%= i + 1 %>: <%= label %>" title="<%= label %>">
                    <div class="wizard-step-dot" aria-hidden="true"><%= i + 1 %></div>
                    <span class="wizard-step-label"><%= label %></span>
                  </div>
                  <% if i < biz_steps.length - 1 %><div class="wizard-step-line"></div><% end %>
                <% end %>
              </div>
              <p class="wizard-step-hint text-center text-muted small mb-0 mt-2" id="wizardStepHint"><%= biz_hints[0] %></p>
            </div>
          </div>

          <%# ============================================================ %>
          <%# STEP 1: Section 1 — Informations Générales (15 fields) %>
          <%# ============================================================ %>
          <div class="wizard-step-panel" id="wizardStep1" style="display:block;">
            <div class="dash-card">
              <div class="dash-card-header">
                <h6 class="dash-card-title" style="color:#D21034;"><span class="badge rounded-pill me-2" style="background:#D21034;">1</span>Enfòmasyon Jeneral</h6>
              </div>
              <div class="dash-card-body">
                <div class="row g-3">
                  <%# 1. NIF %>
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">1. NIF (Nimewo Idantifikasyon Fiskal)</label>
                    <%= text_field_tag :nif_entreprise, @auto_fill[:nif], class: "form-control", placeholder: "ex: 000-000-000", readonly: @auto_fill[:nif].present? %>
                  </div>
                  <%# 2. Numéro d'enregistrement %>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">2. Nimewo Anrejistreman</label>
                    <%= text_field_tag :numero_enregistrement, nil, class: "form-control", placeholder: "ex: RC-2024-12345" %>
                  </div>
                  <%# 3. Raison sociale %>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">3. Rezon Sosyal <span class="text-danger">*</span></label>
                    <%= text_field_tag :nom_entreprise, nil, class: "form-control", required: true, placeholder: "ex: Biznis Ayiti SA" %>
                  </div>
                  <%# 4. Nom commercial %>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">4. Non Komèsyal (si genyen)</label>
                    <%= text_field_tag :nom_commercial, nil, class: "form-control", placeholder: "ex: Ti Machann" %>
                  </div>
                  <%# 5. Date de création %>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">5. Dat Kreyasyon <span class="text-danger">*</span></label>
                    <%= date_field_tag :date_creation, nil, class: "form-control", required: true %>
                  </div>
                  <%# 6. Date de début des opérations %>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">6. Dat Kòmansman Operasyon</label>
                    <%= date_field_tag :date_debut_operations, nil, class: "form-control" %>
                  </div>
                  <%# 7. Période financière %>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">7. Peryòd Finansyè</label>
                    <%= text_field_tag :periode_financiere, "#{Time.current.year}-#{Time.current.year + 1}", class: "form-control", placeholder: "ex: 2026-2027" %>
                  </div>
                  <%# 8. Nombre d'employés %>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">8. Kantite Anplwaye</label>
                    <%= number_field_tag :nombre_employes, nil, class: "form-control", min: 0, placeholder: "ex: 10" %>
                  </div>
                  <%# 9. Patente %>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">9. Èske ou gen oswa ap gen yon patant?</label>
                    <div class="d-flex gap-3 mt-1">
                      <div class="form-check">
                        <%= radio_button_tag :a_patente, "oui", false, class: "form-check-input", id: "patenteOui" %>
                        <label class="form-check-label" for="patenteOui">Wi</label>
                      </div>
                      <div class="form-check">
                        <%= radio_button_tag :a_patente, "non", true, class: "form-check-input", id: "patenteNon" %>
                        <label class="form-check-label" for="patenteNon">Non</label>
                      </div>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">Nimewo Patant (si genyen)</label>
                    <%= text_field_tag :numero_patente, nil, class: "form-control", placeholder: "ex: PAT-2026-001" %>
                  </div>
                  <%# 10. Exemption taxe masse salariale %>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">10. Èske ou egzante de Taks sou Mas Salaryal?</label>
                    <div class="d-flex gap-3 mt-1">
                      <div class="form-check">
                        <%= radio_button_tag :exempte_tms, "oui", false, class: "form-check-input", id: "tmsOui" %>
                        <label class="form-check-label" for="tmsOui">Wi</label>
                      </div>
                      <div class="form-check">
                        <%= radio_button_tag :exempte_tms, "non", true, class: "form-check-input", id: "tmsNon" %>
                        <label class="form-check-label" for="tmsNon">Non</label>
                      </div>
                    </div>
                  </div>
                  <%# 11. Forme juridique %>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">11. Fòm Jridik <span class="text-danger">*</span></label>
                    <%= select_tag :forme_juridique,
                        options_for_select([
                          ["Antrepriz Endividyel", "individuelle"],
                          ["Sosyete an Non Kolektif (SNC)", "snc"],
                          ["Sosyete an Komandit Senp (SCS)", "scs"],
                          ["Sosyete Anonim (SA)", "sa"],
                          ["Sosyete a Responsablite Limite (SARL)", "sarl"],
                          ["Kooperativ", "cooperative"],
                          ["Asosyasyon / ONG", "association"],
                          ["Lot", "autre"]
                        ]),
                        class: "form-select", required: true, prompt: "-- Chwazi --" %>
                  </div>
                  <%# 12. Chiffre d'affaires %>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">12. Chif Afe Dènye Eta Finansye</label>
                    <div class="input-group">
                      <span class="input-group-text">HTG</span>
                      <%= number_field_tag :chiffre_affaires, nil, class: "form-control", min: 0, step: 0.01, placeholder: "0.00" %>
                    </div>
                  </div>
                  <%# 13. Vérificateur externe %>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">13. Eta finansye dwe verifye pa oditè ekstèn? <small class="text-muted">(chif afe &gt; 25M)</small></label>
                    <div class="d-flex gap-3 mt-1">
                      <div class="form-check">
                        <%= radio_button_tag :verificateur_externe, "oui", false, class: "form-check-input", id: "verifOui" %>
                        <label class="form-check-label" for="verifOui">Wi</label>
                      </div>
                      <div class="form-check">
                        <%= radio_button_tag :verificateur_externe, "non", true, class: "form-check-input", id: "verifNon" %>
                        <label class="form-check-label" for="verifNon">Non</label>
                      </div>
                    </div>
                  </div>
                  <%# 14. Secteur d'activité primaire %>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">14. Sektè Aktivite Prensipal <span class="text-danger">*</span></label>
                    <%= select_tag :code_secteur,
                        options_for_select(RecordSchemas::BusinessRegistrationSchema::SECTEUR_ACTIVITE_BIZ.map { |k, v| ["#{k} — #{v}", k] }),
                        class: "form-select", required: true, prompt: "-- Chwazi --" %>
                  </div>
                  <%# 15. Secteur(s) d'activité(s) secondaires %>
                  <div class="col-12">
                    <label class="form-label fw-semibold">15. Sektè Aktivite Segondè (si genyen)</label>
                    <%= text_field_tag :secteur_secondaire, nil, class: "form-control", placeholder: "ex: Komès, Sèvis..." %>
                  </div>
                  <%# Objet social %>
                  <div class="col-12">
                    <label class="form-label fw-semibold">Objè Sosyal <span class="text-danger">*</span></label>
                    <%= text_area_tag :objet_social, nil, class: "form-control", rows: 2, required: true, placeholder: "Deskripsyon aktivite prensipal antrepriz la..." %>
                  </div>
                  <%# Capital social %>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">Kapital Sosyal (HTG)</label>
                    <div class="input-group">
                      <span class="input-group-text">HTG</span>
                      <%= number_field_tag :capital_social, nil, class: "form-control", min: 0, step: 0.01, placeholder: "0.00" %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="d-flex justify-content-between mt-3">
              <%= link_to citizens_dgi_index_path, class: "btn btn-outline-secondary btn-lg", style: "min-height:48px;" do %>
                <i class="ri-arrow-left-line me-1" aria-hidden="true"></i> Retounen
              <% end %>
              <button type="button" class="btn btn-primary btn-lg wizard-next-btn" data-next="2" style="min-height:48px;background:var(--primary);border-color:var(--primary);">
                Kontinye <i class="ri-arrow-right-line ms-1"></i>
              </button>
            </div>
          </div>

          <%# ============================================================ %>
          <%# STEP 2: Section 2 — Le propriétaire + Directeur %>
          <%# ============================================================ %>
          <div class="wizard-step-panel" id="wizardStep2" style="display:none;">
            <div class="dash-card">
              <div class="dash-card-header">
                <h6 class="dash-card-title" style="color:#D21034;"><span class="badge rounded-pill me-2" style="background:#D21034;">2</span>Pwopriyetè</h6>
                <span class="badge bg-success"><i class="ri-magic-line me-1"></i>BonID Pre-ranpli</span>
              </div>
              <div class="dash-card-body">
                <div class="alert alert-info mb-3 small">
                  <i class="ri-shield-check-line me-2"></i>Pwopriyetè a dwe soumèt yon Fòmilè A (NIF Individi) apa.
                </div>
                <div class="row g-3">
                  <%# 16. NIF du propriétaire %>
                  <div class="col-md-4 bonid-autofill">
                    <label class="form-label fw-semibold">16. NIF Pwopriyetè</label>
                    <%= text_field_tag :nif_proprietaire, @auto_fill[:nif], class: "form-control", placeholder: "ex: 000-000-000", readonly: @auto_fill[:nif].present? %>
                  </div>
                  <%# 17. Prénom du propriétaire %>
                  <div class="col-md-4 bonid-autofill">
                    <label class="form-label fw-semibold">17. Prenon Pwopriyetè</label>
                    <input type="text" class="form-control" value="<%= @auto_fill[:first_name] %>" readonly>
                                      </div>
                  <%# 18. Nom du propriétaire %>
                  <div class="col-md-4 bonid-autofill">
                    <label class="form-label fw-semibold">18. Non Pwopriyetè</label>
                    <input type="text" class="form-control" value="<%= @auto_fill[:last_name] %>" readonly>
                                      </div>
                  <div class="col-md-4 bonid-autofill">
                    <label class="form-label fw-semibold">Seks</label>
                    <input type="text" class="form-control" value="<%= @auto_fill[:sex] == 'M' ? 'Gason' : 'Fi' %>" readonly>
                                      </div>
                  <div class="col-md-4 bonid-autofill">
                    <label class="form-label fw-semibold">Dat Nesans</label>
                    <input type="text" class="form-control" value="<%= @auto_fill[:date_of_birth] %>" readonly>
                                      </div>
                  <div class="col-md-4 bonid-autofill">
                    <label class="form-label fw-semibold">Nasyonalite</label>
                    <input type="text" class="form-control" value="<%= @auto_fill[:nationality] %>" readonly>
                                      </div>
                </div>

                <%# Director section — if owner is not in Haiti or delegates %>
                <hr class="my-3">
                <div class="alert alert-secondary mb-3 small">
                  <i class="ri-information-line me-2"></i>Si pwopriyetè a pa nan Ayiti, oswa li delege jesyon fiskal la bay yon direktè (anplwaye), ranpli seksyon sa a. Direktè a dwe soumèt yon Fòmilè A apa tou.
                </div>
                <div class="row g-3">
                  <%# 19. NIF du directeur %>
                  <div class="col-md-4">
                    <label class="form-label fw-semibold">19. NIF Direktè</label>
                    <%= text_field_tag :nif_directeur, nil, class: "form-control", placeholder: "ex: 000-000-000" %>
                  </div>
                  <%# 20. Prénom du directeur %>
                  <div class="col-md-4">
                    <label class="form-label fw-semibold">20. Prenon Direktè</label>
                    <%= text_field_tag :prenom_directeur, nil, class: "form-control", placeholder: "ex: Jean" %>
                  </div>
                  <%# 21. Nom du directeur %>
                  <div class="col-md-4">
                    <label class="form-label fw-semibold">21. Non Direktè</label>
                    <%= text_field_tag :nom_directeur, nil, class: "form-control", placeholder: "ex: Jòj" %>
                  </div>
                </div>
              </div>
            </div>
            <div class="d-flex justify-content-between mt-3">
              <button type="button" class="btn btn-outline-secondary btn-lg wizard-prev-btn" data-prev="1" style="min-height:48px;">
                <i class="ri-arrow-left-line me-1"></i> Retounen
              </button>
              <button type="button" class="btn btn-primary btn-lg wizard-next-btn" data-next="3" style="min-height:48px;background:var(--primary);border-color:var(--primary);">
                Kontinye <i class="ri-arrow-right-line ms-1"></i>
              </button>
            </div>
          </div>

          <%# ============================================================ %>
          <%# STEP 3: Section 3 — Information de contact (7 fields) %>
          <%# ============================================================ %>
          <div class="wizard-step-panel" id="wizardStep3" style="display:none;">
            <div class="dash-card">
              <div class="dash-card-header">
                <h6 class="dash-card-title" style="color:#D21034;"><span class="badge rounded-pill me-2" style="background:#D21034;">3</span>Enfòmasyon Kontak</h6>
              </div>
              <div class="dash-card-body">
                <div class="row g-3">
                  <%# 22. Téléphone mobile %>
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">22. Nimewo Telefon Mobil <span class="text-danger">*</span></label>
                    <%= text_field_tag :telephone, @auto_fill[:phone], class: "form-control", required: true, placeholder: "ex: +509 3XXX XXXX", readonly: @auto_fill[:phone].present? %>
                  </div>
                  <%# 23. Téléphone fixe %>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">23. Nimewo Telefon Fiks</label>
                    <%= text_field_tag :telephone_fixe, nil, class: "form-control", placeholder: "ex: +509 2XXX XXXX" %>
                  </div>
                  <%# 24. Fax %>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">24. Nimewo Faks</label>
                    <%= text_field_tag :fax, nil, class: "form-control", placeholder: "ex: +509 2XXX XXXX" %>
                  </div>
                  <%# 25. Email primaire %>
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">25. Adrès Imel Prensipal</label>
                    <%= email_field_tag :email_contact, @auto_fill[:email], class: "form-control", placeholder: "ex: non@imel.com", readonly: @auto_fill[:email].present? %>
                  </div>
                  <%# 26. Email secondaire %>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">26. Adrès Imel Segondè</label>
                    <%= email_field_tag :email_secondaire, nil, class: "form-control", placeholder: "ex: lòt@imel.com" %>
                  </div>
                  <%# 27. NIF comptable externe %>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">27. NIF Kontab Ekstèn</label>
                    <%= text_field_tag :nif_comptable, nil, class: "form-control", placeholder: "ex: 000-000-000" %>
                  </div>
                  <%# 28. Nom comptable externe %>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">28. Non Kontab Ekstèn</label>
                    <%= text_field_tag :nom_comptable, nil, class: "form-control", placeholder: "ex: Pierre Comptable" %>
                  </div>
                  <%# Additional: Sit Wèb %>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">Sit Wèb</label>
                    <%= text_field_tag :site_web, nil, class: "form-control", placeholder: "www.example.com" %>
                  </div>
                </div>
              </div>
            </div>
            <div class="d-flex justify-content-between mt-3">
              <button type="button" class="btn btn-outline-secondary btn-lg wizard-prev-btn" data-prev="2" style="min-height:48px;">
                <i class="ri-arrow-left-line me-1"></i> Retounen
              </button>
              <button type="button" class="btn btn-primary btn-lg wizard-next-btn" data-next="4" style="min-height:48px;background:var(--primary);border-color:var(--primary);">
                Kontinye <i class="ri-arrow-right-line ms-1"></i>
              </button>
            </div>
          </div>

          <%# ============================================================ %>
          <%# STEP 4: Section 4 — Adresse + Établissements %>
          <%# ============================================================ %>
          <div class="wizard-step-panel" id="wizardStep4" style="display:none;">
            <div class="dash-card">
              <div class="dash-card-header">
                <h6 class="dash-card-title" style="color:#D21034;"><span class="badge rounded-pill me-2" style="background:#D21034;">4</span>Adrès ak Etablisman</h6>
                <span class="badge bg-success"><i class="ri-magic-line me-1"></i>BonID Pre-ranpli</span>
              </div>
              <div class="dash-card-body">
                <p class="fw-bold small mb-2" style="color:var(--primary);">29. Adrès Prensipal Antrepriz</p>
                <div class="row g-3">
                  <%# 29a. Département %>
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">29a. Depatman <span class="text-danger">*</span></label>
                    <%= select_tag :departement,
                        options_for_select(RecordSchemas::BusinessRegistrationSchema::DEPARTEMENTS_HAITI, @auto_fill[:birth_department]),
                        class: "form-select", required: true, prompt: "-- Chwazi --", disabled: @auto_fill[:birth_department].present? %>
                    <%= hidden_field_tag :departement, @auto_fill[:birth_department] if @auto_fill[:birth_department].present? %>
                  </div>
                  <%# 29b. Commune %>
                  <div class="col-md-6 bonid-autofill">
                    <label class="form-label fw-semibold">29b. Komin</label>
                    <%= text_field_tag :commune, @auto_fill[:birth_commune], class: "form-control", placeholder: "ex: Pétion-Ville", readonly: @auto_fill[:birth_commune].present? %>
                  </div>
                  <%# 29c. Section communale %>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">29c. Seksyon Kominal</label>
                    <%= text_field_tag :section_communale, nil, class: "form-control", placeholder: "ex: 1è Seksyon" %>
                  </div>
                  <%# 29d. Zone %>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">29d. Zòn</label>
                    <%= text_field_tag :zone, nil, class: "form-control", placeholder: "ex: Boulva 15" %>
                  </div>
                  <%# 29e. Adresse %>
                  <div class="col-12 bonid-autofill">
                    <label class="form-label fw-semibold">29e. Adrès (Nimewo ak Non Ri) <span class="text-danger">*</span></label>
                    <%= text_field_tag :rue, @auto_fill[:street_address], class: "form-control", required: true, placeholder: "ex: 12 Ri Kapwa", readonly: @auto_fill[:street_address].present? %>
                  </div>
                  <%# 29f. Pays de Résidence %>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold">29f. Peyi Rezidans</label>
                    <%= text_field_tag :pays, "Haiti", class: "form-control" %>
                  </div>
                  <%# 29g. Information additionnelle %>
                  <div class="col-12">
                    <label class="form-label fw-semibold">29g. Enfòmasyon Adisyonèl sou Lokalizasyon</label>
                    <%= text_area_tag :info_localisation, nil, class: "form-control", rows: 2, placeholder: "Pwen repè, direksyon, elatriye..." %>
                  </div>
                </div>

                <%# Section 4 — Établissements %>
                <hr class="my-3">
                <p class="fw-bold small mb-2" style="color:var(--primary);">30. Etablisman</p>
                <div class="alert alert-secondary mb-3 small">
                  <i class="ri-information-line me-2"></i>Apa de adrès prensipal la, èske antrepriz la gen lòt etablisman ki bezwen yon patant?
                </div>
                <div class="d-flex gap-3 mb-3">
                  <div class="form-check">
                    <%= radio_button_tag :autres_etablissements, "oui", false, class: "form-check-input", id: "etablOui" %>
                    <label class="form-check-label" for="etablOui">Wi</label>
                  </div>
                  <div class="form-check">
