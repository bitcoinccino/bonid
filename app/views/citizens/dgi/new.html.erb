        <% elsif @form_type == "patente_declaration" %>

          <% pat_steps = ["Idantifikasyon", "Adrès", "Kalkil Taks", "Revize", "Siyati", "Peyman"] %>
          <% pat_hints = ["Enfòmasyon antrepriz ak NIF", "Adrès biznis ak kontak", "Kalkil patant ak chif afe", "Revize tout enfòmasyon ou", "Sètifye ak siyen fòm lan", "Frè sèvis ak soumisyon"] %>
