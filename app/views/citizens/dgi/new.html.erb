<% if @form_type == "fermage" %>
<script>
document.addEventListener("DOMContentLoaded", function() {
  var fields = ["droitAnnuel", "surtaxe", "dtp", "solidarite"];
  var totalEl = document.getElementById("fermageTotal");
  if (!totalEl) return;

  function updateTotal() {
    var total = 0;
    fields.forEach(function(id) {
      var val = parseFloat(document.getElementById(id)?.value || 0);
      if (!isNaN(val)) total += val;
    });
    totalEl.textContent = total.toLocaleString("fr-HT", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " HTG";
  }

  fields.forEach(function(id) {
    var el = document.getElementById(id);
    if (el) {
      el.addEventListener("input", updateTotal);
      el.addEventListener("change", updateTotal);
    }
  });
});
</script>
<% end %>

<%# ================================================================ %>
<%# BONGOUV STYLES — command bar + dashboard (matches DGI index) %>
<%# ================================================================ %>
<style>
  /* ================================================================
     BONGOUV DESIGN TOKENS — USWDS-aligned
     Discrete palettes: color, spacing, typography, radius, shadow
     All component styles reference these tokens exclusively.
     ================================================================ */
  :root {
    /* ---- Color: Primary (Haitian Blue) ---- */
    --bg-primary:           var(--primary);
    --bg-primary-dark:      #001570;
    --bg-primary-light:     #f0f4ff;
    --text-on-primary:      #FFFFFF;
    --text-primary:         var(--primary);

    /* ---- Color: Accent (Haitian Red) ---- */
    --bg-accent:            #D21034;
    --text-accent:          #D21034;

    /* ---- Color: Success / Warning / Error ---- */
    --bg-success-light:     #d1fae5;
    --text-success:         #065f46;
    --text-success-vivid:   #059669;
    --bg-warning-light:     #fef3c7;
    --bg-warning:           #fffbeb;
    --border-warning:       #fde68a;
    --text-warning:         #92400e;
    --text-warning-vivid:   #d97706;
    --bg-error-light:       #fee2e2;
    --text-error:           #991b1b;

    /* ---- Color: Neutral ---- */
    --bg-white:             #FFFFFF;
    --bg-base-lightest:     #F8F9FA;
    --bg-base-lighter:      #f8fafc;
    --border-base:          #E0E0E0;
    --border-light:         #e2e8f0;
    --border-form:          #f3e8c8;
    --text-base:            #1a1a2e;
    --text-base-dark:       #374151;
    --text-muted:           #6c757d;
    --text-icon:            #64748B;
    --text-ink:             #4b5563;

    /* ---- Spacing (USWDS units: 1 unit = 8px) ---- */
    --space-0:              0;
    --space-05:             0.25rem;   /* 4px  — 0.5 units */
    --space-1:              0.5rem;    /* 8px  — 1 unit */
    --space-105:            0.625rem;  /* 10px — 1.25 units */
    --space-2:              1rem;      /* 16px — 2 units */
    --space-205:            1.25rem;   /* 20px — 2.5 units */
    --space-3:              1.5rem;    /* 24px — 3 units */
    --space-4:              2rem;      /* 32px — 4 units */

    /* ---- Typography scale ---- */
    --font-family-ui:       'Inter', 'Montserrat', sans-serif;
    --font-family-heading:  'Montserrat', 'Inter', sans-serif;
    --font-family-sig:      'Dancing Script', 'Brush Script MT', 'Segoe Script', cursive;
    --font-3xs:             0.6rem;    /* flag text */
    --font-2xs:             0.7rem;    /* fees, chips */
    --font-xs:              0.72rem;   /* labels, muted */
    --font-sm:              0.78rem;   /* nav, hints */
    --font-md:              0.8rem;    /* body small */
    --font-base:            0.85rem;   /* base */
    --font-lg:              0.88rem;   /* section headings */
    --font-xl:              0.9rem;    /* card titles */
    --font-2xl:             0.95rem;   /* icons */
    --font-3xl:             1.05rem;   /* page title */
    --font-sig:             1.6rem;    /* signature */
    --font-weight-normal:   400;
    --font-weight-medium:   500;
    --font-weight-semibold: 600;
    --font-weight-bold:     700;

    /* ---- Border radius ---- */
    --radius-sm:            4px;
    --radius-md:            6px;
    --radius-lg:            10px;
    --radius-xl:            12px;
    --radius-pill:          20px;

    /* ---- Focus ---- */
    --focus-color:          var(--bg-primary);
    --focus-width:          2px;
    --focus-offset:         2px;
    --focus-shadow:         0 0 0 3px rgba(0, 32, 159, 0.25);

    /* ---- Touch targets (WCAG 2.1 AA) ---- */
    --touch-target-min:     44px;
    --touch-target-btn:     48px;

    /* ---- Transition ---- */
    --transition-speed:     0.2s;
  }

  /* ================================================================
     SKIP NAVIGATION — USWDS Accessibility
     ================================================================ */
  .bongouv-skip-nav {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 9999;
    padding: var(--space-1) var(--space-2);
    background: var(--bg-primary);
    color: var(--text-on-primary);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-base);
    text-decoration: none;
    border-radius: 0 0 var(--radius-md) 0;
  }
  .bongouv-skip-nav:focus {
    left: 0;
    outline: var(--focus-width) solid var(--bg-accent);
    outline-offset: var(--focus-offset);
  }

  /* ================================================================
     COMMAND BAR
     ================================================================ */
  .bongouv-command-bar {
    background: linear-gradient(135deg, var(--bg-primary) 0%, var(--bg-primary-dark) 100%);
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    padding: var(--space-2) var(--space-3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: var(--space-05) solid var(--bg-accent);
  }
  .bongouv-command-bar__flag {
    font-size: var(--font-3xs);
    letter-spacing: 2.5px;
    color: rgba(255,255,255,0.6);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
  }
  .bongouv-verification-pill {
    padding: var(--space-05) var(--space-105);
    border-radius: var(--radius-pill);
    font-size: 0.75rem;
    font-weight: var(--font-weight-semibold);
    display: inline-flex;
    align-items: center;
  }
  .bongouv-verification-pill--verified { background: var(--bg-success-light); color: var(--text-success); }
  .bongouv-verification-pill--pending  { background: var(--bg-warning-light); color: var(--text-warning); }

  /* ================================================================
     DASHBOARD CONTAINER
     ================================================================ */
  .bongouv-dashboard {
    background: var(--bg-base-lightest);
    border-radius: 0 0 var(--radius-xl) var(--radius-xl);
    padding: var(--space-3);
    font-family: var(--font-family-ui);
    font-size: var(--font-base);
    color: var(--text-base);
  }
  .bongouv-dashboard .form-label {
    font-family: var(--font-family-ui);
    font-size: var(--font-md);
  }
  .bongouv-dashboard .form-control,
  .bongouv-dashboard .form-select {
    font-family: var(--font-family-ui);
    font-size: var(--font-base);
  }
  .bongouv-dashboard .alert {
    font-family: var(--font-family-ui);
    font-size: var(--font-md);
  }

  /* ================================================================
     BONID AUTOFILL — locked fields
     ================================================================ */
  .bonid-autofill {
    position: relative;
  }
  .bonid-autofill .form-control,
  .bonid-autofill .form-select {
    background-color: #f0f4ff !important;
    border-color: #c7d2fe !important;
    color: #4b5563 !important;
    cursor: not-allowed;
    opacity: 0.85;
  }
  .bonid-autofill .form-control:focus,
  .bonid-autofill .form-select:focus {
    box-shadow: none !important;
    border-color: #c7d2fe !important;
  }
    font-size: 0.68rem;
    color: var(--primary);
    font-weight: 500;
    margin-top: 2px;
    display: flex;
    align-items: center;
    gap: 3px;
  }

  /* ================================================================
     STEP HINT
     ================================================================ */
  .wizard-step-hint {
    font-size: var(--font-sm);
    color: var(--text-muted);
    font-style: italic;
  }

  /* ================================================================
     CARDS — USWDS card pattern
     ================================================================ */
  .bongouv-dashboard .dash-card {
    border: 1px solid var(--border-base) !important;
    box-shadow: none !important;
    background: var(--bg-white) !important;
    border-radius: var(--radius-lg) !important;
    overflow: hidden;
    margin-bottom: var(--space-2);
  }
  .bongouv-dashboard .dash-card-header {
    padding: var(--space-2) var(--space-205) !important;
    border-bottom: 1px solid var(--border-base) !important;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-105);
  }
  .bongouv-dashboard .dash-card-body {
    padding: var(--space-205) !important;
  }
  .bongouv-dashboard .dash-card-title {
    font-family: var(--font-family-ui);
    font-size: var(--font-xl) !important;
    font-weight: var(--font-weight-bold) !important;
    color: var(--text-base) !important;
    margin: 0 !important;
    display: flex;
    align-items: center;
  }
  .bongouv-dashboard .dash-card-title i {
    color: var(--text-icon);
    font-size: var(--font-2xl);
  }

  /* ================================================================
     NAV BUTTONS (Help, Return)
     ================================================================ */
  .bongouv-nav-btn {
    display: inline-flex;
    align-items: center;
    padding: var(--space-05) 0.875rem;
    background: rgba(255,255,255,0.15);
    color: var(--text-on-primary);
    border-radius: var(--radius-md);
    font-size: var(--font-sm);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    transition: background var(--transition-speed);
    min-height: 36px;
  }
  .bongouv-nav-btn:hover { background: rgba(255,255,255,0.25); color: var(--text-on-primary); }
  .bongouv-nav-btn:focus-visible {
    outline: var(--focus-width) solid var(--text-on-primary);
    outline-offset: var(--focus-offset);
  }

  /* ================================================================
     CERTIFICATION / SIGNATURE
     ================================================================ */
  .dgi-certification-section {
    background: var(--bg-warning);
    border: 1px solid var(--border-warning);
    border-left: var(--space-05) solid var(--text-warning-vivid);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-205);
  }
  .dgi-certification-section__heading {
    font-size: var(--font-lg);
    font-weight: var(--font-weight-bold);
    color: var(--text-warning);
    margin: 0 0 var(--space-1);
  }
  .dgi-certification-text {
    font-size: var(--font-md);
    color: var(--text-base-dark);
    line-height: 1.5;
    padding: var(--space-105) var(--space-2);
    background: var(--bg-white);
    border: 1px solid var(--border-form);
    border-radius: var(--radius-sm);
  }
  .dgi-certification-text p { margin-bottom: var(--space-1); }
  .dgi-certification-checkbox {
    width: var(--space-205);
    height: var(--space-205);
    margin-top: var(--space-05);
  }
  .form-check-input.dgi-certification-checkbox:checked,
  input[type="checkbox"].dgi-certification-checkbox:checked {
    background-color: #00209F !important;
    border-color: #00209F !important;
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20'%3e%3cpath fill='none' stroke='%23fff' stroke-linecap='round' stroke-linejoin='round' stroke-width='3' d='m6 10 3 3 6-6'/%3e%3c/svg%3e") !important;
  }
  .dgi-certification-checkbox:focus {
    box-shadow: var(--focus-shadow);
  }

  /* ================================================================
     BONID SIGNATURE
     ================================================================ */
  .dgi-bonid-signature {
    padding: var(--space-105) var(--space-2);
    background: var(--bg-base-lighter);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-sm);
  }
  .dgi-bonid-signature__text {
    font-family: var(--font-family-sig);
    font-size: var(--font-sig);
    color: var(--text-base);
    border-bottom: 1px solid var(--text-base-dark);
    padding-bottom: var(--space-05);
    display: inline-block;
  }

  /* ================================================================
     SUBMIT BUTTON DISABLED
     ================================================================ */
  .dgi-submit-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* ================================================================
     FOCUS VISIBLE — USWDS Accessibility
     ================================================================ */
  .wizard-step-panel .form-control:focus-visible,
  .wizard-step-panel .form-select:focus-visible {
    outline: var(--focus-width) solid var(--focus-color);
    outline-offset: 1px;
    box-shadow: none;
  }
  .wizard-prev-btn:focus-visible,
  .wizard-next-btn:focus-visible,
  .dgi-submit-btn:focus-visible,
  button[type="submit"]:focus-visible {
    outline: var(--focus-width) solid var(--focus-color);
    outline-offset: var(--focus-offset);
  }
  .dgi-certification-checkbox:focus-visible {
    outline: var(--focus-width) solid var(--focus-color);
    outline-offset: var(--focus-offset);
    box-shadow: none;
  }

  /* ================================================================
     REDUCED MOTION — USWDS Accessibility
     ================================================================ */
  @media (prefers-reduced-motion: reduce) {
    .bongouv-nav-btn,
    .wizard-step-dot,
    .wizard-step-line,
    .dgi-submit-btn {
      transition: none;
    }
  }

  /* ================================================================
     RESPONSIVE — Mobile-first, WCAG touch targets
     ================================================================ */
  @media (max-width: 767px) {
    .bongouv-command-bar { border-radius: 0; padding: var(--space-105) var(--space-2); }
    .bongouv-dashboard { border-radius: 0; padding: var(--space-2); }
    .bongouv-nav-btn { padding: var(--space-05) var(--space-105); font-size: var(--font-xs); }
    .dgi-certification-section { padding: var(--space-105) 0.875rem; }
    .dgi-certification-checkbox { width: var(--space-3); height: var(--space-3); }
    .wizard-prev-btn,
    .wizard-next-btn,
    .dgi-submit-btn,
    button[type="submit"] { min-height: var(--touch-target-btn); }
    .wizard-step-panel .form-control,
    .wizard-step-panel .form-select { min-height: var(--touch-target-min); font-size: 16px; }
  }
</style>

<%# Certification checkbox enables/disables submit button %>
<script>
document.addEventListener("DOMContentLoaded", function() {
  var checkbox = document.getElementById("certificationAccepted");
  var submitBtn = document.querySelector(".dgi-submit-btn");
  if (checkbox && submitBtn) {
    checkbox.addEventListener("change", function() {
      submitBtn.disabled = !this.checked;
    });
  }
});
</script>
