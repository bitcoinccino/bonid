                    <div class="wizard-step-dot" aria-hidden="true"><%= i + 1 %></div>
                    <span class="wizard-step-label"><%= label %></span>
                  </div>
                  <% if i < pat_steps.length - 1 %><div class="wizard-step-line"></div><% end %>
                <% end %>
              </div>
              <p class="wizard-step-hint text-center text-muted small mb-0 mt-2" id="wizardStepHint"><%= pat_hints[0] %></p>
