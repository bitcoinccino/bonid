<%# app/views/citizens/profiles/edit.html.erb %>

<%# Header chrome matches the Anrejistre wizard (.ballot-wrap / .ballot-head)
    so verification reads as one continuous wizard with the rest of the
    citizen flow. %>
<div class="ballot-wrap px-0" style="padding-bottom: 0;">

  <%# ── Back link — escape hatch back to submissions list ── %>
  <div class="ballot-back-bar">
    <%= link_to citizens_identity_submissions_path, class: "ballot-back-link" do %>
      <i class="ri-arrow-left-line"></i>
    <% end %>
  </div>

  <div class="complaint-form-wrapper">
  <%= simple_form_for @citizen, as: :user,
        url: citizens_profile_path, method: :patch,
        html: { class: "profile-form", data: {
          turbo: false,
          controller: "wizard profile-review",
          wizard_current_step_value: "1",
          action: "wizard:stepChanged->profile-review#onStepChanged"
        } } do |f| %>

    <%# ── Step Indicator ── %>
    <div class="mb-4">
      <div class="d-flex justify-content-between align-items-center mb-2" style="max-width: 600px; margin: 0 auto;">
        <% profile_steps = [
          { icon: "ri-camera-line", label: "Photo" },
          { icon: "ri-user-3-line", label: "Personnel" },
          { icon: "ri-id-card-line", label: "Identité" },
          { icon: "ri-home-4-line", label: "Adresse" },
          { icon: "ri-checkbox-circle-line", label: "Révision" }
        ] %>
        <% profile_steps.each_with_index do |step, i| %>
          <div data-wizard-target="stepIndicator" class="text-center" style="flex: 1;">
            <div class="step-circle mx-auto d-flex align-items-center justify-content-center rounded-circle <%= 'active' if i == 0 %>">
              <i class="<%= step[:icon] %>" style="font-size: 0.9rem;"></i>
            </div>
            <div style="font-size: 0.62rem; color: #98a2b3; margin-top: 4px; font-weight: 500;">
              <%= step[:label] %>
            </div>
          </div>
        <% end %>
      </div>
      <div style="height: 4px; background: #e4e7ec; border-radius: 4px; max-width: 600px; margin: 0 auto;">
        <div data-wizard-target="progressBar"
             style="height: 100%; width: 0%; background: linear-gradient(90deg, var(--primary), #1a4fa8);
                    border-radius: 4px; transition: width 0.4s ease;">
        </div>
      </div>
    </div>

    <%# ── STEP 1 — Profile Photo ── %>
    <div data-wizard-target="step">
      <%# Page header lives inside step 1 only — the wizard hides this div
          on subsequent steps so "Get Verified" + intro copy disappear once
          the citizen moves past the first wizard panel. %>
      <div class="ballot-head text-center">
        <h1 class="ballot-title">
          <i class="ri-user-settings-line me-2"></i>Get Verified
        </h1>
        <p class="ballot-subtitle mb-0">
          Complete the sections below to create your official BonID profile.
        </p>
      </div>

      <%= render "citizens/profiles/profile_photo_fields", f: f %>
      <div class="d-flex justify-content-end">
        <button type="button" class="btn btn-primary fw-semibold px-4 py-2"
                style="font-size: 0.85rem;"
                data-action="click->wizard#next">
          Continue <i class="ri-arrow-right-line ms-1"></i>
        </button>
      </div>
    </div>

    <%# ── STEP 2 — Personal Information ── %>
    <div data-wizard-target="step" class="d-none" style="display:none">
      <%= render "citizens/profiles/personal_fields", f: f %>
      <div class="d-flex justify-content-between">
        <button type="button" class="btn btn-outline-secondary fw-semibold px-4 py-2" style="font-size: 0.85rem;"
                data-action="click->wizard#previous">
          <i class="ri-arrow-left-line me-1"></i> Back
        </button>
        <button type="button" class="btn btn-primary fw-semibold px-4 py-2"
                style="font-size: 0.85rem;"
                data-action="click->wizard#next">
          Continue <i class="ri-arrow-right-line ms-1"></i>
        </button>
      </div>
    </div>

    <%# ── STEP 3 — Identification ── %>
    <div data-wizard-target="step" class="d-none" style="display:none">
      <%= render "citizens/profiles/identification_fields", f: f %>
      <div class="d-flex justify-content-between">
        <button type="button" class="btn btn-outline-secondary fw-semibold px-4 py-2" style="font-size: 0.85rem;"
                data-action="click->wizard#previous">
          <i class="ri-arrow-left-line me-1"></i> Back
        </button>
        <button type="button" class="btn btn-primary fw-semibold px-4 py-2"
                style="font-size: 0.85rem;"
                data-action="click->wizard#next">
          Continue <i class="ri-arrow-right-line ms-1"></i>
        </button>
      </div>
    </div>

    <%# ── STEP 4 — Address ── %>
    <div data-wizard-target="step" class="d-none" style="display:none">
      <%= render "citizens/profiles/address_fields", f: f %>
      <div class="d-flex justify-content-between">
        <button type="button" class="btn btn-outline-secondary fw-semibold px-4 py-2" style="font-size: 0.85rem;"
                data-action="click->wizard#previous">
          <i class="ri-arrow-left-line me-1"></i> Back
        </button>
        <button type="button" class="btn btn-primary fw-semibold px-4 py-2"
                style="font-size: 0.85rem;"
                data-action="click->wizard#next">
          Review <i class="ri-arrow-right-line ms-1"></i>
        </button>
      </div>
    </div>

    <%# ── STEP 5 — Review & Save ── %>
    <div data-wizard-target="step" class="d-none" style="display:none">
      <%= render "citizens/profiles/review_section" %>
      <div class="d-flex justify-content-between align-items-center">
        <button type="button" class="btn btn-outline-secondary fw-semibold px-4 py-2" style="font-size: 0.85rem;"
                data-action="click->wizard#previous">
          <i class="ri-arrow-left-line me-1"></i> Back
        </button>
        <%= f.submit "Save & Continue",
            class: "btn btn-primary fw-semibold py-2 px-4",
            style: "font-size: 0.85rem;",
            data: { disable_with: "Saving..." } %>
      </div>
    </div>

  <% end %>

  <div class="mt-4 text-center small text-muted">
    <i class="ri-lock-2-fill text-success me-2"></i>Encrypted • Haiti Government Compliant
  </div>
  </div>
</div>
