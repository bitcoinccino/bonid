<%# STEP 5 — Review & Save — chrome matches the Anrejistre wizard
    (.ballot-section / .ballot-section-head). %>
<div class="ballot-section card border-0 shadow-sm mb-4">
  <div class="card-body p-4">

    <%# Wizard-style section head: bold title + subdued desc %>
    <div class="ballot-section-head mb-4">
      <h2 class="ballot-section-title"><%= t("citizen_portal.profile.review.title") %></h2>
      <p class="ballot-section-desc mb-0">
        <%= t("citizen_portal.profile.review.desc_html") %>
      </p>
    </div>

    <%# ── Profile Photo ── %>
    <div class="review-head">
      <h3 class="review-head__title"><i class="ri-camera-line" aria-hidden="true"></i><%= t("citizen_portal.profile.review.photo_section") %></h3>
      <button type="button" class="review-edit" data-action="click->wizard#goToStep" data-step="1">
        <i class="ri-pencil-line" aria-hidden="true"></i><%= t("citizen_portal.profile.review.edit") %>
      </button>
    </div>
    <div data-profile-review-target="reviewPhoto" class="mb-4 review-data text-center">
      <%# Guard against an unsaved photo on validation-failure re-renders.
          When the controller hits a 422 and re-renders edit, the new
          ActiveStorage::Blob from the just-attempted upload isn't
          persisted yet, so url_for raises "Cannot get a signed_id for
          a new record" and 500s. Falls back to the "Not uploaded" hint
          so the citizen can re-attach if needed. %>
      <% if @citizen.photo.attached? && @citizen.photo.blob&.persisted? %>
        <%= image_tag url_for(@citizen.photo), class: "review-photo-img d-block mx-auto mb-2" %>
        <span class="text-success"><i class="ri-checkbox-circle-line me-1"></i><%= t("citizen_portal.profile.review.photo_uploaded") %></span>
      <% else %>
        <span class="text-danger"><i class="ri-close-circle-line me-1"></i><%= t("citizen_portal.profile.review.not_uploaded") %></span>
      <% end %>
    </div>

    <hr class="review-divider">

    <%# ── Personal Information ── %>
    <div class="review-head">
      <h3 class="review-head__title"><i class="ri-user-3-line" aria-hidden="true"></i><%= t("citizen_portal.profile.review.personal_section") %></h3>
      <button type="button" class="review-edit" data-action="click->wizard#goToStep" data-step="2">
        <i class="ri-pencil-line" aria-hidden="true"></i><%= t("citizen_portal.profile.review.edit") %>
      </button>
    </div>
    <%# Label above value; one column on phones, two from tablet up.
        profile_review_controller.js rebuilds these with the same markup. %>
    <% empty = t("citizen_portal.profile.review.empty") %>
    <div data-profile-review-target="reviewPersonal" class="review-grid mb-4 review-data">
      <% full_name = [@citizen.prefix, @citizen.first_name, @citizen.middle_name, @citizen.last_name, @citizen.suffix].compact_blank.join(" ") %>
      <%
        raw_phone = @citizen.phone.to_s.gsub(/\D/, "")
        local = raw_phone.sub(/^509/, "")
        prefix = local[0, 2].to_i
        natcom = [28, 29, 35, 40, 41, 42, 43, 44, 45]
        digicel = [31, 32, 33, 34, 36, 37, 38, 39, 46, 47, 48, 49]
        carrier = if natcom.include?(prefix) then "Natcom"
                  elsif digicel.include?(prefix) then "Digicel"
                  else nil end
      %>
      <%= review_item "full_name", full_name, empty %>
      <%= review_item "sex", (@citizen.sex.present? ? t("citizen_portal.profile.sexes.#{@citizen.sex}", default: @citizen.sex.titleize) : nil), empty %>
      <%= review_item "dob", (@citizen.dob ? long_date(@citizen.dob) : nil), empty %>
      <%= review_item "nationality", @citizen.nationality, empty %>
      <%= review_item "phone", @citizen.phone, empty,
            extra: (carrier ? tag.span(carrier, class: "badge bg-light text-dark border ms-1") : nil) %>
      <%= review_item "marital_status", (@citizen.marital_status.present? ? t("citizen_portal.profile.marital_statuses.#{@citizen.marital_status}", default: @citizen.marital_status.titleize) : nil), empty %>
    </div>

    <hr class="review-divider">

    <%# ── Identification ── %>
    <div class="review-head">
      <h3 class="review-head__title"><i class="ri-id-card-line" aria-hidden="true"></i><%= t("citizen_portal.profile.review.id_section") %></h3>
      <button type="button" class="review-edit" data-action="click->wizard#goToStep" data-step="3">
        <i class="ri-pencil-line" aria-hidden="true"></i><%= t("citizen_portal.profile.review.edit") %>
      </button>
    </div>
    <div data-profile-review-target="reviewIdentification" class="review-grid mb-4 review-data">
      <% id_type_label = IdentitySubmission::ID_TYPES[@citizen.id_type&.to_sym] ? @citizen.id_type.upcase : @citizen.id_type&.titleize %>
      <% birth_place = [@citizen.birth_commune&.name, @citizen.birth_department&.name].compact_blank.join(", ") %>
      <% passport = @citizen.id_type.to_s == "passport" %>
      <%= review_item "id_type", id_type_label, empty %>
      <% if passport %>
        <%= review_item "ninu", @citizen.ninu, empty %>
      <% else %>
        <%= review_item "id_number", @citizen.id_number, empty %>
      <% end %>
      <%= review_item "issued", (@citizen.id_issued_on ? long_date(@citizen.id_issued_on) : nil), empty %>
      <%= review_item "expires", (@citizen.id_expires_on ? long_date(@citizen.id_expires_on) : nil), empty %>
      <%= review_item "issuer", @citizen.document_issuer&.titleize, empty %>
      <% if !passport && @citizen.ninu.present? %>
        <%= review_item "ninu", @citizen.ninu, empty %>
      <% end %>
      <%= review_item "birth_place", birth_place, empty %>
    </div>

    <hr class="review-divider">

    <%# ── Address ── %>
    <div class="review-head">
      <h3 class="review-head__title"><i class="ri-home-4-line" aria-hidden="true"></i><%= t("citizen_portal.profile.review.address_section") %></h3>
      <button type="button" class="review-edit" data-action="click->wizard#goToStep" data-step="4">
        <i class="ri-pencil-line" aria-hidden="true"></i><%= t("citizen_portal.profile.review.edit") %>
      </button>
    </div>
    <% addr = @citizen.address %>
    <div data-profile-review-target="reviewAddress" class="mb-3 review-data">
      <% if addr.present? %>
        <p class="mb-0 review-data-address"><%= addr.formatted_haiti_display %></p>
      <% else %>
        <span class="review-empty"><%= t("citizen_portal.profile.review.empty") %></span>
      <% end %>
    </div>

  </div>
</div>
