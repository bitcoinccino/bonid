<%# Personal Information Section — chrome matches the Anrejistre wizard
    (.ballot-section / .ballot-section-head). %>
<% locked = @identity_verified %>
<div class="ballot-section card border-0 shadow-sm mb-4" data-controller="id-switcher">
  <div class="card-body p-4">

    <%# Wizard-style section head: bold title + subdued desc %>
    <div class="ballot-section-head mb-4">
      <h2 class="ballot-section-title"><%= t("citizen_portal.profile.personal.title") %></h2>
      <p class="ballot-section-desc mb-0">
        <%= t("citizen_portal.profile.personal.desc_html") %>
      </p>
    </div>

    <% if locked %>
      <div class="alert alert-warning d-flex align-items-center small mb-4 rounded-3">
        <i class="ri-lock-line me-2"></i>
        <span>
          <%= t("citizen_portal.profile.personal.locked_notice") %>
          <%= link_to t("citizen_portal.profile.personal.request_name_change"), new_citizens_name_change_request_path, class: "citizen-link-alert ms-1" %>
        </span>
      </div>
    <% end %>

    <div class="row g-4">
      <%# Prefix — always editable (honorific, not on gov ID) %>
      <div class="col-6 col-md-6">
        <%= f.input :prefix,
          collection: User::PREFIXES,
          include_blank: t("citizen_portal.profile.personal.prefix"),
          label: t("citizen_portal.profile.personal.prefix"),
          input_html: { class: "form-select" },
          label_html: { class: "form-label" } %>
        <small class="text-muted"><%= t("citizen_portal.profile.personal.prefix_hint") %></small>
      </div>

      <%# Suffix — always editable (honorific, not on gov ID) %>
      <div class="col-6 col-md-6">
        <%= f.input :suffix,
          collection: User::SUFFIXES,
          include_blank: t("citizen_portal.profile.personal.suffix"),
          label: t("citizen_portal.profile.personal.suffix"),
          input_html: { class: "form-select" },
          label_html: { class: "form-label" } %>
        <small class="text-muted"><%= t("citizen_portal.profile.personal.suffix_hint") %></small>
      </div>

      <%# First Name (Required) — LOCKED when verified %>
      <div class="col-12 col-md-4">
        <%= f.input :first_name, required: true,
          disabled: locked,
          label: t("citizen_portal.profile.personal.first_name"),
          input_html: {
            placeholder: t("citizen_portal.profile.personal.first_name_placeholder"),
            class: "form-control #{'bg-light' if locked}",
            autocomplete: "given-name"
          },
          label_html: { class: "form-label" } %>
        <small class="text-muted"><%= locked ? t("citizen_portal.profile.locked_hint") : t("citizen_portal.profile.personal.first_name_hint") %></small>
      </div>

      <%# Middle Name (Optional) — LOCKED when verified %>
      <div class="col-12 col-md-4">
        <%= f.input :middle_name,
          disabled: locked,
          label: t("citizen_portal.profile.personal.middle_name"),
          input_html: {
            placeholder: t("citizen_portal.profile.personal.middle_name_placeholder"),
            class: "form-control #{'bg-light' if locked}",
            autocomplete: "additional-name"
          },
          label_html: { class: "form-label" } %>
        <small class="text-muted"><%= locked ? t("citizen_portal.profile.locked_hint") : t("citizen_portal.profile.personal.middle_name_hint") %></small>
      </div>

      <%# Last Name (Required) — LOCKED when verified %>
      <div class="col-12 col-md-4">
        <%= f.input :last_name, required: true,
          disabled: locked,
          label: t("citizen_portal.profile.personal.last_name"),
          input_html: {
            placeholder: t("citizen_portal.profile.personal.last_name_placeholder"),
            class: "form-control #{'bg-light' if locked}",
            autocomplete: "family-name"
          },
          label_html: { class: "form-label" } %>
        <small class="text-muted"><%= locked ? t("citizen_portal.profile.locked_hint") : t("citizen_portal.profile.personal.last_name_hint") %></small>
      </div>

      <%# Sex — LOCKED when verified %>
      <div class="col-6 col-md-4">
        <%= f.input :sex,
          collection: User.sexes.keys.map { |k| [t("citizen_portal.profile.sexes.#{k}", default: k.titleize), k] },
          include_blank: t("citizen_portal.profile.personal.select_sex"),
          label: t("citizen_portal.profile.personal.sex"),
          disabled: locked,
          input_html: {
            class: "form-select #{'bg-light' if locked}",
            data: locked ? {} : {
              id_switcher_target: "sex",
              action: "change->id-switcher#updateNationality"
            }
          },
          label_html: { class: "form-label" } %>
      </div>

      <%# Nationality — LOCKED when verified %>
      <div class="col-6 col-md-4">
        <%= f.input :nationality,
          disabled: locked,
          label: t("citizen_portal.profile.personal.nationality"),
          input_html: {
            class: "form-control bg-light",
            readonly: true,
            data: locked ? {} : { id_switcher_target: "nationality" }
          },
          label_html: { class: "form-label" } %>
        <small class="text-muted"><%= locked ? t("citizen_portal.profile.locked_hint") : t("citizen_portal.profile.personal.nationality_hint") %></small>
      </div>

      <%# Date of Birth — LOCKED when verified %>
      <div class="col-12 col-md-4">
        <label class="form-label"><%= t("citizen_portal.profile.personal.dob") %></label>
        <% if locked %>
          <input type="text" class="form-control bg-light"
                 value="<%= @citizen.dob&.strftime('%d / %m / %Y') %>"
                 disabled readonly />
          <small class="text-muted"><%= t("citizen_portal.profile.locked_hint") %></small>
        <% else %>
          <input type="date"
                 name="user[dob]"
                 id="citizen_dob"
                 class="form-control"
                 value="<%= @citizen.dob&.strftime('%Y-%m-%d') %>"
                 min="1920-01-01"
                 max="<%= (Date.today - 18.years).strftime('%Y-%m-%d') %>" />
          <small class="text-muted"><%= t("citizen_portal.profile.personal.dob_hint") %></small>
        <% end %>
      </div>

      <%# Phone Number — always editable, Haiti +509 locked %>
      <div class="col-12 col-md-6">
        <label class="form-label"><%= t("citizen_portal.profile.personal.phone") %></label>
        <%
          raw_phone = @citizen.phone.to_s
          local_phone = raw_phone.sub(/^\+?509\s*/, '')
          haiti = ISO3166::Country.new('HT')
          haiti_label = "#{haiti.emoji_flag} +#{haiti.country_code}"
        %>
        <div class="input-group">
          <select class="form-select" style="max-width: 140px; background-color: #f8f9fa;" disabled>
            <option selected><%= haiti_label %></option>
          </select>
          <input type="tel"
                 name="user[phone]"
                 id="citizen_phone"
                 class="form-control"
                 placeholder="37 12 3456"
                 autocomplete="tel"
                 value="<%= local_phone %>"
                 data-country-code="+509" />
        </div>
        <small class="text-muted"><%= t("citizen_portal.profile.personal.phone_hint") %></small>
      </div>

      <%# Marital Status — always editable %>
      <div class="col-12 col-md-6">
        <%= f.input :marital_status,
          collection: User.marital_statuses.keys.map { |k| [t("citizen_portal.profile.marital_statuses.#{k}", default: k.titleize), k] },
          include_blank: t("citizen_portal.profile.personal.select_status"),
          label: t("citizen_portal.profile.personal.marital_status"),
          input_html: { class: "form-select" },
          label_html: { class: "form-label" } %>
      </div>
    </div>

    <%# Privacy Notice — highlighted using the wizard's tip-box idiom %>
    <div class="enroll-helpful-tip mt-4">
      <i class="ri-lock-2-fill"></i>
      <div>
        <%= t("citizen_portal.profile.personal.privacy_html") %>
      </div>
    </div>
  </div>
</div>
