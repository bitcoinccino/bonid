<%# Profile Photo Section — chrome matches the Anrejistre wizard
    (.ballot-section / .ballot-section-head) so the verification flow
    reads as one continuous wizard, not a separate Bootstrap form. %>
<div class="ballot-section card border-0 shadow-sm mb-4" data-controller="form-handler">
  <div class="card-body p-4">

    <%# Wizard-style section head: bold title + subdued desc %>
    <div class="ballot-section-head mb-4">
      <h2 class="ballot-section-title">Profile Photo</h2>
      <p class="ballot-section-desc mb-0">
        Your profile photo is part of your BonID verification. Please upload a
        <strong>clear photo in passport style</strong> showing your full face.
      </p>
    </div>

    <%# Upload Area %>
    <div class="profile-photo-section">
      <label for="citizen_photo" class="profile-photo-wrapper">
        <%# Hidden Input %>
        <%= f.file_field :photo,
              id: "citizen_photo",
              class: "d-none",
              accept: "image/jpeg,image/png",
              required: !f.object.photo.attached?,
              data: {
                action: "change->form-handler#previewImage",
                form_handler_target: "fileInput"
              } %>

        <%# Current / Previewed Photo %>
        <% if f.object.photo.attached? %>
          <%= image_tag url_for(f.object.photo),
                class: "photo-preview profile-photo-img",
                alt: "Profile photo preview",
                data: { form_handler_target: "imagePreview" } %>
        <% else %>
          <div class="photo-placeholder" data-form-handler-target="placeholder">
            <i class="ri-camera-line"></i>
          </div>
          <%= image_tag "", class: "photo-preview d-none", alt: "Profile photo preview", data: { form_handler_target: "imagePreview" } %>
        <% end %>

        <%# Hover Overlay %>
        <div class="photo-overlay">
          <i class="ri-upload-line"></i>
          <span><%= f.object.photo.attached? ? "Change Photo" : "Upload Photo" %></span>
        </div>
      </label>

      <small class="d-block text-muted mt-3">
        Upload a <strong>clear, front-facing photo</strong> (JPEG or PNG, max 5MB).
      </small>
    </div>

    <%# Privacy Notice — highlighted using the wizard's tip-box idiom %>
    <div class="enroll-helpful-tip">
      <i class="ri-lock-2-fill"></i>
      <div>
        <strong>Your photo is encrypted</strong>
        and used only for identity verification within BonID.
      </div>
    </div>
  </div>
</div>
