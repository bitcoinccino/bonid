<template data-social-handles-target="template">
  <div class="border rounded-3 p-3 mb-2 nested-fields social-handle-row" data-new-record="true" data-verified="false">
    <input type="hidden" name="user[social_handles_attributes][NEW_RECORD][active]" value="true" />

    <div class="row g-4 align-items-center">
      <!-- Platform -->
      <div class="col-12 col-md-3">
        <select name="user[social_handles_attributes][NEW_RECORD][platform]"
                class="form-select">
          <option value="">Select Platform</option>
          <% SocialHandle::PLATFORMS.each do |key, label| %>
            <option value="<%= key %>"><%= label %></option>
          <% end %>
        </select>
      </div>

      <!-- Handle -->
      <div class="col-12 col-md-4">
        <input type="text"
               name="user[social_handles_attributes][NEW_RECORD][handle]"
               class="form-control"
               placeholder="@username" />
      </div>

      <!-- Visibility — Segmented Toggle -->
      <div class="col-6 col-md-2">
        <div class="btn-group btn-group-sm w-100 social-vis-toggle" role="group" aria-label="Visibility">
          <input type="radio"
                 class="btn-check"
                 name="user[social_handles_attributes][NEW_RECORD][visibility]"
                 id="vis_private_NEW_RECORD"
                 value="private"
                 autocomplete="off">
          <label class="btn btn-outline-secondary" for="vis_private_NEW_RECORD"
                 title="Only you can see this">
            <i class="ri-lock-line"></i> No
          </label>

          <input type="radio"
                 class="btn-check"
                 name="user[social_handles_attributes][NEW_RECORD][visibility]"
                 id="vis_partners_NEW_RECORD"
                 value="partners_only"
                 checked
                 autocomplete="off">
          <label class="btn btn-outline-secondary" for="vis_partners_NEW_RECORD"
                 title="Shared with verified agencies">
            <i class="ri-team-line"></i> Yes
          </label>
        </div>
      </div>

      <!-- Status + Remove -->
      <div class="col-6 col-md-3">
        <div class="d-flex justify-content-between align-items-center">
          <span class="social-status-unverified" role="button" tabindex="0"
                title="Verify this handle to strengthen your profile">
            <i class="ri-error-warning-line me-1"></i>Verify
          </span>
          <button type="button"
                  class="social-remove-btn"
                  data-action="click->social-handles#remove"
                  title="Remove">
            <i class="ri-close-line"></i>
          </button>
        </div>
      </div>
    </div>
  </div>
</template>
