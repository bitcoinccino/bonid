<template data-social-handles-target="template">
  <div class="border rounded-3 p-3 mb-2 nested-fields social-handle-row" data-new-record="true" data-verified="false">
    <input type="hidden" name="user[social_handles_attributes][NEW_RECORD][active]" value="true" />

    <div class="row g-4 align-items-center">
      <!-- Platform -->
      <div class="col-12 col-md-3">
        <select name="user[social_handles_attributes][NEW_RECORD][platform]"
                class="form-select">
          <option value=""><%= t("citizen_portal.profile.social.select_platform") %></option>
          <% SocialHandle::PLATFORMS.each do |key, label| %>
            <option value="<%= key %>"><%= label %></option>
          <% end %>
        </select>
      </div>

      <!-- Handle -->
      <div class="col-12 col-md-4">
        <input type="text"
               name="user[social_handles_attributes][NEW_RECORD][handle]"
               class="form-control"
               placeholder="<%= t("citizen_portal.profile.social.handle_placeholder") %>" />
      </div>

      <!-- Visibility — Segmented Toggle -->
      <div class="col-6 col-md-2">
        <div class="btn-group btn-group-sm w-100 social-vis-toggle" role="group" aria-label="<%= t("citizen_portal.profile.social.visibility") %>">
          <input type="radio"
                 class="btn-check"
                 name="user[social_handles_attributes][NEW_RECORD][visibility]"
                 id="vis_private_NEW_RECORD"
                 value="private"
                 autocomplete="off">
          <label class="btn btn-outline-secondary" for="vis_private_NEW_RECORD"
                 title="<%= t("citizen_portal.profile.social.private_title") %>">
            <i class="ri-lock-line"></i> <%= t("citizen_portal.profile.social.no") %>
          </label>

          <input type="radio"
                 class="btn-check"
                 name="user[social_handles_attributes][NEW_RECORD][visibility]"
                 id="vis_partners_NEW_RECORD"
                 value="partners_only"
                 checked
                 autocomplete="off">
          <label class="btn btn-outline-secondary" for="vis_partners_NEW_RECORD"
                 title="<%= t("citizen_portal.profile.social.partners_title") %>">
            <i class="ri-team-line"></i> <%= t("citizen_portal.profile.social.yes") %>
          </label>
        </div>
      </div>

      <!-- Status + Remove -->
      <div class="col-6 col-md-3">
        <div class="d-flex justify-content-between align-items-center">
          <span class="social-status-unverified" role="button" tabindex="0"
                title="<%= t("citizen_portal.profile.social.verify_title") %>">
            <i class="ri-error-warning-line me-1"></i><%= t("citizen_portal.profile.social.verify") %>
          </span>
          <button type="button"
                  class="social-remove-btn"
                  data-action="click->social-handles#remove"
                  title="<%= t("citizen_portal.profile.social.remove") %>">
            <i class="ri-close-line"></i>
          </button>
        </div>
      </div>
    </div>
  </div>
</template>
