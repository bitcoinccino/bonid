<%# Physical Characteristics Section %>
<div class="card profile-card">
  <div class="card-header">
    <h5><i class="ri-body-scan-line"></i>Physical Characteristics</h5>
  </div>
  <div class="card-body">
    <%# Info Banner %>
    <div class="alert alert-info d-flex align-items-start">
      <i class="ri-2x ri-user-heart-line me-3"></i>
      <div>
        <strong>Your physical information helps uniquely identify you for secure verification.</strong><br>
        This data is <strong>encrypted</strong> and used only for biometric and visual identity validation.
      </div>
    </div>

    <%# Physical Attributes %>
    <div class="row g-4">
      <%# Height %>
      <div class="col-md-6">
        <%= f.label :height_cm, "Height (cm)", class: "form-label" %>
        <%= f.number_field :height_cm,
              class: "form-control",
              placeholder: "e.g. 175" %>
        <small class="text-muted">Enter your height in centimeters (cm).</small>
      </div>

      <%# Weight %>
      <div class="col-md-6">
        <%= f.label :weight_kg, "Weight (kg)", class: "form-label" %>
        <%= f.number_field :weight_kg,
              class: "form-control",
              placeholder: "e.g. 70" %>
        <small class="text-muted">Enter your current weight in kilograms (kg).</small>
      </div>

      <%# Eye Color %>
      <div class="col-md-6">
        <%= f.label :eye_color, "Eye Color", class: "form-label" %>
        <%= f.select :eye_color,
              PhysicalProfile.eye_colors.keys.map { |c| [c.titleize, c] },
              { include_blank: "Select eye color" },
              class: "form-select" %>
        <small class="text-muted">Select your natural eye color.</small>
      </div>

      <%# Hair Color %>
      <div class="col-md-6">
        <%= f.label :hair_color, "Hair Color", class: "form-label" %>
        <%= f.select :hair_color,
              PhysicalProfile.hair_colors.keys.map { |c| [c.titleize, c] },
              { include_blank: "Select hair color" },
              class: "form-select" %>
        <small class="text-muted">Select your current hair color.</small>
      </div>

      <%# Race %>
      <div class="col-md-6">
        <%= f.label :race, "Race", class: "form-label" %>
        <%= f.select :race,
              PhysicalProfile.races.keys.map { |r| [r.titleize, r] },
              { include_blank: "Select race" },
              class: "form-select" %>
        <small class="text-muted">Choose the race or ethnicity that best describes you.</small>
      </div>

      <%# Body Type %>
      <div class="col-md-6">
        <%= f.label :body_type, "Body Type", class: "form-label" %>
        <%= f.select :body_type,
              PhysicalProfile.body_types.keys.map { |b| [b.titleize, b] },
              { include_blank: "Select body type" },
              class: "form-select" %>
        <small class="text-muted">Choose the body type that best matches your build.</small>
      </div>

      <%# Skin Tone %>
      <div class="col-md-6">
        <%= f.label :skin_tone, "Skin Tone", class: "form-label" %>
        <%= f.select :skin_tone,
              PhysicalProfile.skin_tones.keys.map { |s| [s.titleize, s] },
              { include_blank: "Select skin tone" },
              class: "form-select" %>
        <small class="text-muted">Select your natural skin tone.</small>
      </div>

      <%# Facial Hair %>
      <div class="col-md-6">
        <%= f.label :facial_hair, "Facial Hair", class: "form-label" %>
        <%= f.select :facial_hair,
              PhysicalProfile.facial_hairs.keys.map { |f| [f.titleize, f] },
              { include_blank: "Select facial hair" },
              class: "form-select" %>
        <small class="text-muted">Select the facial hair style you currently have (if any).</small>
      </div>

      <%# Handedness %>
      <div class="col-md-6">
        <%= f.label :handedness, "Handedness", class: "form-label" %>
        <%= f.select :handedness,
              PhysicalProfile.handednesses.keys.map { |h| [h.titleize, h] },
              { include_blank: "Select handedness" },
              class: "form-select" %>
        <small class="text-muted">Indicate whether you're left-handed, right-handed, or ambidextrous.</small>
      </div>
    </div>

    <%# Privacy Footer %>
    <div class="privacy-footer">
      <i class="ri-lock-line me-1"></i>
      Your physical data is securely encrypted and only shared with verified institutions during authorized checks.
    </div>
  </div>
</div>
