<div class="card profile-card mb-4"
     data-controller="emergency-contacts"
     data-emergency-contacts-target="contacts">
  <div class="card-header">
    <h5><i class="ri-contacts-book-2-line"></i>Emergency Contacts</h5>
  </div>
  <div class="card-body">

  <!-- Info Notice -->
  <div class="alert alert-dismissible fade show alert-info small rounded-3 mb-4 d-flex align-items-start shadow-sm">
    <i class="ri-shield-user-line ri-2x text-primary me-3"></i>
    <div>
      <strong>Your emergency contacts help responders reach someone you trust.</strong><br>
      This information is <strong>securely stored</strong> and shared only with authorized responders in emergencies.
    </div>
  </div>

  <%= f.fields_for :emergency_contacts do |ec_form| %>
    <%= render "citizens/profiles/emergency_contact", ec_form: ec_form %>
  <% end %>

  <%= render "citizens/profiles/emergency_contact_template" %>

  <!-- Privacy Footer -->
  <p class="text-muted small text-center mt-3 mb-0">
    <i class="ri-lock-line me-1"></i>
    Emergency contact data is encrypted and visible only to verified emergency responders.
  </p>
  </div>
</div>
