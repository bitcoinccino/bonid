<!-- Birth Address (Department + Commune Only) -->
<div class="card profile-card mb-4"
     data-controller="birth-address">
  <div class="card-header">
    <h5><i class="ri-map-pin-line"></i>Place of Birth</h5>
  </div>
  <div class="card-body">

  <!-- Contextual Info -->
  <div class="alert alert-dismissible fade show alert-info small rounded-3 mb-4 d-flex align-items-start shadow-sm">
    <i class="ri-map-pin-line ri-2x text-primary me-3"></i>
    <div>
      <strong>Your place of birth helps confirm your identity.</strong><br>
      This information is used by BonID to verify your national origin and match records with the
      <strong>National Identification Office (ONI)</strong> and <strong>local Civil Registry (État Civil)</strong>.
    </div>
  </div>

  <div class="row g-4">
    <!-- Department -->
    <div class="col-md-6">
      <%= f.label :birth_department_id, "Birth Department", class: "form-label fw-semibold" %>
      <%= f.select :birth_department_id,
            options_from_collection_for_select(Department.all, :id, :name, f.object.birth_department_id),
            { prompt: "Select Department" },
            {
              class: "form-select rounded-3 shadow-sm",
              data: {
                action: "change->birth-address#loadCommunes",
                birth_address_target: "department"
              }
            } %>
      <small class="form-text text-muted">
        Select the department where you were born (e.g., Ouest, Nord, Artibonite).
      </small>
    </div>

    <!-- Commune -->
    <div class="col-md-6">
      <%= f.label :birth_commune_id, "Birth Commune", class: "form-label fw-semibold" %>
      <%= f.select :birth_commune_id,
            f.object.birth_department_id.present? ?
              options_from_collection_for_select(
                Commune.where(department_id: f.object.birth_department_id),
                :id, :name, f.object.birth_commune_id
              ) : [],
            { prompt: "Select Commune" },
            {
              class: "form-select rounded-3 shadow-sm",
              data: { birth_address_target: "commune" }
            } %>
      <small class="form-text text-muted">
        Select the commune within your birth department (e.g., Delmas, Cap-Haïtien).
      </small>
    </div>
  </div>

  <p class="text-muted small text-center mt-3 mb-0">
    <i class="ri-lock-line me-1"></i>
    This data is securely stored and only used for official identity verification.
  </p>
  </div>
</div>
