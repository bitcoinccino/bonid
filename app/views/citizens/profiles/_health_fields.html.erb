<%# Privacy Footer — compact %>
<div class="d-flex align-items-center mt-3 mb-0" style="padding: 0.5rem 0;">
  <i class="ri-lock-line me-2" style="color: #9ca3af; font-size: 0.85rem;"></i>
  <small style="color: #6c757d; font-size: 0.75rem;">
    BonID follows strict <strong>health data protection</strong> standards.
    Your information will <strong>never be shared without consent</strong>.
  </small>
</div>
