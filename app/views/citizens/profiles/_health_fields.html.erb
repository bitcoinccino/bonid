<%# Health Information Section — Monochrome Redesign %>

<%# Compact Info Banner (dismissible) %>
<div class="alert alert-info alert-dismissible d-flex align-items-start mb-4 rounded-3" role="alert" style="padding: 0.6rem 1rem;">
  <i class="ri-shield-check-line me-2 mt-1" style="color: #00209F; font-size: 1rem;"></i>
  <span style="font-size: 0.82rem; color: #343A40;">
    <strong>Your health information is encrypted and secure.</strong>
    Share your health profile for <strong>faster identity verification</strong> with medical partners. BonID shares your data <strong>only with your explicit consent</strong> through secure, auditable access.
  </span>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="font-size: 0.6rem;"></button>
</div>

<%# Blood Type — Full-width row %>
<div class="mb-3">
  <label class="form-label fw-semibold" style="font-size: 0.85rem; color: #343A40;">
    <i class="ri-drop-line me-1" style="color: #00209F;"></i> Blood Type
  </label>
  <%= f.select :blood_type,
        options_for_select(
          [["Select blood type...", ""]] + HealthProfile::BLOOD_TYPES.map { |bt| [bt, bt] },
          f.object.blood_type
        ),
        {},
        class: "form-select rounded-3" %>
</div>

<%# Organ Donor — Own row for prominence %>
<div class="mb-4 p-3 rounded-3" style="background: #f8f9fa; border: 1px solid #e5e7eb;">
  <div class="form-check form-switch d-flex align-items-center gap-2 mb-0">
    <%= f.check_box :organ_donor, class: "form-check-input", role: "switch", id: "organDonorSwitch" %>
    <label class="form-check-label fw-semibold" for="organDonorSwitch" style="font-size: 0.85rem; color: #343A40;">
      <i class="ri-heart-add-line me-1" style="color: #00209F;"></i> Organ Donor
    </label>
  </div>
  <small class="text-muted d-block mt-1" style="font-size: 0.75rem; padding-left: 2.5rem;">
    Critical for emergency responders. This is visible on your BonID health card.
  </small>
</div>

<%# Allergies — Multi-select with inline chips %>
<div class="mb-3">
  <label class="form-label fw-semibold" style="font-size: 0.85rem; color: #343A40;">
    <i class="ri-alarm-warning-line me-1" style="color: #00209F;"></i> Allergies
  </label>
  <div class="dropdown health-multiselect" data-controller="health-multiselect" data-field="allergies">
    <button class="form-select text-start dropdown-toggle d-flex justify-content-between align-items-center rounded-3 health-chip-trigger"
            type="button"
            data-bs-toggle="dropdown"
            data-bs-auto-close="outside"
            aria-expanded="false"
            data-health-multiselect-target="button">
      <span class="health-chip-area" data-health-multiselect-target="chipArea">
        <span data-health-multiselect-target="label" class="text-muted">None known</span>
      </span>
    </button>
    <ul class="dropdown-menu w-100 p-2" style="max-height: 280px; overflow-y: auto; border: 1px solid #e5e7eb;">
      <% HealthProfile::COMMON_ALLERGIES.each do |allergy| %>
        <li>
          <label class="dropdown-item d-flex align-items-center gap-2 rounded-2 py-2">
            <input type="checkbox"
                   name="user[health_profile_attributes][allergies][]"
                   value="<%= allergy %>"
                   class="form-check-input m-0"
                   <%= f.object.allergies_list.include?(allergy) ? "checked" : "" %>
                   data-action="change->health-multiselect#updateLabel">
            <span><%= allergy %></span>
          </label>
        </li>
      <% end %>
    </ul>
    <input type="hidden" name="user[health_profile_attributes][allergies][]" value="">
  </div>
</div>

