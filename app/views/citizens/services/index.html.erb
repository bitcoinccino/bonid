<%# app/views/citizens/services/index.html.erb %>
<% content_for(:title) { "Sèvis — BonID" } %>

<div class="ballot-wrap px-0" style="padding-bottom: 0;">

<%# ── Page Header (wizard style — matches Kalandriye / Anrejistre / Aktivite) ── %>
<div class="ballot-head text-center">
  <h1 class="ballot-title">
    <i class="ri-apps-2-line me-2"></i>Sèvis
  </h1>
  <p class="ballot-subtitle mb-0">
    Chwazi yon patnè pou w ka aksede sèvis yo.
  </p>
</div>

<div class="row justify-content-center">
  <div class="col-lg-9">

<%# ── Verification Status ── %>
<% unless @verified %>
  <div class="sevis-alert sevis-alert--warning">
    <i class="ri-error-warning-line"></i>
    <span>
      Ou bezwen verifye idantite ou pou w ka itilize sèvis yo.
      <%= link_to "Verifye kounye a", new_citizens_identity_submission_path, class: "citizen-link-alert" %>
    </span>
  </div>
<% end %>

<%# ── Search + Sector Filter ── %>
<form action="<%= citizens_services_path %>" method="get" class="sevis-search-bar" data-turbo="false">
  <div class="sevis-search-row">
    <i class="ri-search-line sevis-search-icon"></i>
    <input type="text" name="search" value="<%= @search %>" placeholder="Chèche yon patnè..." class="sevis-search-input">
  </div>

  <div class="sevis-filter-row">
    <select name="sector" onchange="this.form.submit()">
      <option value="">Tout Sektè</option>
      <% @sector_groups.each do |group| %>
        <option value="<%= group %>" <%= "selected" if @sector_filter == group %>><%= group %></option>
      <% end %>
    </select>

    <% if @search.present? || @sector_filter.present? %>
      <a href="<%= citizens_services_path %>" class="sevis-clear-link">
        <i class="ri-close-line"></i> Efase
      </a>
    <% end %>

    <%# Hidden submit so Enter in the search input still posts on browsers
        that don't auto-submit on implicit form action. The visible "Filtre"
        button was overflowing on narrow phones — sector auto-submits on
        change and the search input auto-submits on Enter, so no button
        is needed in the visual layout. %>
    <button type="submit" class="visually-hidden" tabindex="-1" aria-hidden="true">Submit</button>
  </div>
</form>

<% if @search.present? || @sector_filter.present? %>
  <div class="sevis-results-count">
    <i class="ri-filter-3-line"></i>
    <span>
      <strong><%= @total_count %></strong> rezilta jwenn
      <% if @search.present? %> pou "<strong><%= @search %></strong>"<% end %>
      <% if @sector_filter.present? %> nan <strong><%= @sector_filter %></strong><% end %>
    </span>
  </div>
<% end %>

<% if @grouped_partners.any? %>
  <% @grouped_partners.each do |group_name, partners| %>
    <div class="sevis-group">
      <div class="sevis-group-header">
        <div class="sevis-group-icon" style="background: <%= @sector_colors[group_name] || '#6B7280' %>;">
          <i class="<%= @sector_icons[group_name] || 'ri-building-line' %>"></i>
        </div>
        <h2 class="sevis-group-title"><%= group_name %></h2>
        <span class="sevis-group-count"><%= partners.size %></span>
      </div>

      <div class="sevis-grid">
        <% partners.each do |partner| %>
          <%= link_to citizens_service_path(slug: partner.slug), class: "sevis-card" do %>
            <div class="sevis-card-logo-wrap">
              <% if partner.logo.attached? %>
                <%= image_tag url_for(partner.logo), class: "sevis-card-logo", alt: partner.name %>
              <% else %>
                <div class="sevis-card-logo-placeholder"
                     style="background: <%= @sector_colors[group_name] || '#6B7280' %>;">
                  <%= partner.name.first(2).upcase %>
                </div>
              <% end %>
              <% if partner.verified_at.present? %>
                <div class="sevis-card-verified" title="Patnè Verifye">
                  <i class="ri-verified-badge-fill"></i>
                </div>
              <% end %>
            </div>

            <div class="sevis-card-info">
              <div class="sevis-card-name"><%= partner.name %></div>
              <div class="sevis-card-sector">
                <%= PartnerSectorConstants.human_sector_label(partner.sector) %>
              </div>
            </div>

            <i class="ri-arrow-right-s-line sevis-card-arrow"></i>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# ── Wè Plis / Load More ── %>
  <% shown = @grouped_partners.values.sum(&:size) %>
  <div class="sevis-load-more">
    <% if @has_more %>
      <%= link_to citizens_services_path(page: @page + 1, search: @search.presence, sector: @sector_filter.presence),
            class: "sevis-load-more-btn", data: { turbo_action: "replace" } do %>
        <i class="ri-arrow-down-line"></i> Wè Plis
      <% end %>
    <% end %>
    <div class="sevis-showing-count">
      <%= shown %> sou <%= @total_count %> patnè
    </div>
  </div>
<% else %>
  <div class="sevis-empty">
    <i class="ri-building-line"></i>
    <% if @search.present? || @sector_filter.present? %>
      <h3>Pa gen rezilta</h3>
      <p>Eseye chanje rechèch ou oswa filtre a.</p>
      <a href="<%= citizens_services_path %>" class="sevis-empty-clear">
        <i class="ri-close-line"></i> Efase Filtre
      </a>
    <% else %>
      <h3>Pa gen sèvis disponib pou kounya</h3>
      <p>Retounen pi ta pou w ka jwenn sèvis ki disponib.</p>
    <% end %>
  </div>
<% end %>

  </div>
</div>
</div>
