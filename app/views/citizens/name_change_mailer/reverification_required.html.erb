<table role="presentation" width="100%" cellpadding="0" cellspacing="0">
  <tr>
    <td style="text-align:center; padding-bottom:16px;">
      <div style="font-family:'Montserrat','Inter',Arial,sans-serif; font-size:18px; font-weight:700; color:var(--primary);">
        Chanjman Non Apwouve
      </div>
    </td>
  </tr>

  <tr>
    <td style="padding-bottom:16px;">
      <div style="font-family:'Inter',Arial,sans-serif; font-size:14px; color:#0F172A; line-height:1.6;">
        Bonjou <strong><%= @user.first_name %></strong>,
      </div>
      <div style="font-family:'Inter',Arial,sans-serif; font-size:14px; color:#0F172A; line-height:1.6; margin-top:8px;">
        Demann chanjman non ou soti <strong><%= @ncr.old_full_name %></strong> pou ale
        <strong><%= @ncr.new_full_name %></strong> apwouve pa administratè a.
      </div>
    </td>
  </tr>

  <tr>
    <td style="padding:16px; background:#FEF3C7; border-radius:8px; margin-bottom:16px;">
      <div style="font-family:'Inter',Arial,sans-serif; font-size:14px; color:#92400E; font-weight:600;">
        <span style="font-size:18px;">&#9888;</span> Reverifikasyon Obligatwa
      </div>
      <div style="font-family:'Inter',Arial,sans-serif; font-size:13px; color:#92400E; margin-top:6px; line-height:1.5;">
        Pou chanjman non an pran efè, ou dwe:
      </div>
      <ol style="font-family:'Inter',Arial,sans-serif; font-size:13px; color:#92400E; margin-top:8px; padding-left:20px; line-height:1.8;">
        <li>Upload nouvo CIN oswa Paspò ou ki gen nouvo non an</li>
        <li>Fè verifikasyon figi (liveness check)</li>
        <li>Soumèt yon nouvo demann BonID (reissue)</li>
      </ol>
    </td>
  </tr>

  <tr>
    <td style="text-align:center; padding-top:20px; padding-bottom:16px;">
      <a href="<%= citizens_dashboard_url %>"
         style="display:inline-block; padding:12px 32px; background:var(--primary); color:#ffffff;
                font-family:'Montserrat',Arial,sans-serif; font-size:14px; font-weight:600;
                text-decoration:none; border-radius:8px;">
        Ale nan Dashboard ou
      </a>
    </td>
  </tr>

  <tr>
    <td style="padding-top:16px; border-top:1px solid #e2e8f0;">
      <div style="font-family:'Inter',Arial,sans-serif; font-size:12px; color:#94a3b8; text-align:center; padding-top:12px;">
        Si ou pa mande chanjman sa a, kontakte support@bonid.ht imedyatman.
      </div>
    </td>
  </tr>
</table>
