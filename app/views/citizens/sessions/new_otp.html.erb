<%# app/views/citizens/sessions/new_otp.html.erb %>

<% content_for :auth_left do %>
  <div class="auth-left-inner d-flex flex-column justify-content-between h-100 py-4 py-lg-5 w-100">

    <!-- INTRO -->
    <div class="text-center mb-4 mb-lg-5">
      <h2 class="display-5 fw-bold mb-3 font-heading">
        <%= t("citizen_portal.auth.login.left_title") %>
      </h2>
      <p class="lead opacity-90 mx-auto max-w-text">
        <%= t("citizen_portal.auth.login.left_lead") %>
      </p>
    </div>

    <!-- BENEFITS -->
    <div class="row g-4 justify-content-center mb-4 mb-lg-5">
      <% [
        { icon: "ri-lock-unlock-line",  title: t("citizen_portal.auth.login.no_password"),    desc: t("citizen_portal.auth.login.no_password_desc") },
        { icon: "ri-time-line",         title: t("citizen_portal.auth.login.expires_10m"), desc: t("citizen_portal.auth.login.expires_10m_desc") },
        { icon: "ri-mail-check-line",   title: t("citizen_portal.auth.login.sent_to_you"),    desc: t("citizen_portal.auth.login.sent_to_you_desc") }
      ].each do |item| %>
        <div class="col-12 col-md-4 text-center">
          <i class="<%= item[:icon] %> ri-2x text-haitian-cyan mb-2"></i>
          <div class="fw-semibold small mb-1"><%= item[:title] %></div>
          <div class="small opacity-80"><%= item[:desc] %></div>
        </div>
      <% end %>
    </div>

    <!-- FOOTER NOTE -->
    <p class="small opacity-75 fst-italic text-center">
      <%= t("citizen_portal.auth.login.not_gov_id") %>
    </p>

  </div>
<% end %>


<div class="login-card">
  <%# Partner branding banner (only when coming from a partner OAuth flow) %>
  <% if @partner.present? %>
    <div class="p-3 mb-4 rounded-3" style="background: #f0f4ff; border: 1px solid rgba(0,32,159,0.1);">
      <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
        <%# Partner logo %>
        <div class="d-flex align-items-center justify-content-center rounded-circle overflow-hidden flex-shrink-0"
             style="width: 36px; height: 36px; background: #fff; border: 1px solid #e2e8f0;">
          <% if @partner.logo.attached? %>
            <%= image_tag @partner.logo.variant(resize_to_fill: [72, 72]),
                  style: "width: 100%; height: 100%; object-fit: cover;",
                  alt: @partner.name %>
          <% else %>
            <i class="ri-building-2-line" style="font-size: 0.9rem; color: #64748b;"></i>
          <% end %>
        </div>

        <%# Connection icon %>
        <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
             style="width: 24px; height: 24px; background: #e2e8f0; border: 1px solid #cbd5e1;">
          <i class="ri-link-m" style="font-size: 0.7rem; color: #64748b;"></i>
        </div>

        <%# BonID logo %>
        <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
             style="width: 36px; height: 36px; background: var(--primary); border: 1px solid var(--primary);">
          <i class="ri-shield-check-line" style="font-size: 0.9rem; color: #fff;"></i>
        </div>
      </div>
      <div class="text-center">
        <div class="fw-semibold" style="font-size: 0.82rem; color: #0F172A;">
          <%= @partner.name %>
        </div>
        <div style="font-size: 0.72rem; color: #64748b;">
          <%= t("citizen_portal.auth.partner_uses_bonid") %>
        </div>
      </div>
    </div>
  <% end %>

  <%# Brand header %>
  <div class="auth-brand text-center mb-4">
    <div class="auth-icon-badge mb-3" aria-hidden="true">
      <i class="ri-fingerprint-line"></i>
    </div>
    <h1 class="auth-brand-title"><%= t("citizen_portal.auth.login.title") %></h1>
  </div>

  <%# Flash rendered by citizen_auth layout %>

  <%# OTP Request Form %>
  <%= form_with url: login_path(
                  partner_slug: params[:from_partner] || params[:partner_slug]
                ),
                method: :post,
                scope: :citizen,
                local: true,
                html: { data: { turbo: false }, id: "otp-request-form" } do |f| %>

    <%= hidden_field_tag :partner_slug, params[:from_partner] || params[:partner_slug] %>

    <div class="form-floating mb-3">
      <%= f.text_field :email,
            autofocus: true,
            required: true,
            autocomplete: "email",
            placeholder: t("citizen_portal.auth.login.email_placeholder"),
            class: "form-control" %>
      <%= f.label :email, t("citizen_portal.auth.login.email_label") %>
    </div>

    <%= f.submit t("citizen_portal.auth.login.send_code"),
          class: "btn btn-haitian-primary w-100 mt-2",
          id: "send-code-button",
          data: { disable_with: '<span class="spinner-border spinner-border-sm me-2"></span>'.html_safe + t("citizen_portal.auth.login.sending_html") } %>

    <div class="trust-badge">
      <i class="ri-shield-check-line"></i>
      <span><%= t("citizen_portal.auth.secure") %></span>
    </div>

    <div class="auth-privacy-note">
      <i class="ri-lock-line"></i><%= t("citizen_portal.auth.login.never_share") %>
    </div>
  <% end %>

  <%# Divider %>
  <div class="login-divider my-4">
    <span><%= t("citizen_portal.auth.or") %></span>
  </div>

  <%# Create account %>
  <div class="mb-3">
    <%= link_to signup_path(from_partner: params[:from_partner] || params[:partner_slug]),
          class: "btn btn-ghost-haitian w-100" do %>
      <i class="ri-user-add-line me-2"></i><%= t("citizen_portal.auth.login.create_account") %>
    <% end %>
  </div>

  <div class="auth-help-link">
    <a href="mailto:support@bonid.ht"><%= t("citizen_portal.auth.need_help") %></a>
  </div>
</div>
