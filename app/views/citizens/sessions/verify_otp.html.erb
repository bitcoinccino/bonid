<%# app/views/citizens/sessions/verify_otp.html.erb %>

<%# ================= LEFT COLUMN ================= %>
<% content_for :auth_left do %>
  <div class="auth-left-inner d-flex flex-column justify-content-between h-100 py-4 py-lg-5 w-100">

    <!-- INTRO -->
    <div class="text-center mb-4 mb-lg-5">
      <h2 class="display-5 fw-bold mb-3 font-heading">
        <%= t("citizen_portal.auth.verify.left_title") %>
      </h2>
      <p class="lead opacity-90 mx-auto max-w-text">
        <%= t("citizen_portal.auth.verify.left_lead_html", email: params[:email] || current_citizen&.email || t("citizen_portal.auth.verify.your_email")) %>
      </p>
    </div>

    <!-- TIPS -->
    <div class="row g-4 justify-content-center mb-4 mb-lg-5">
      <% [
        { icon: "ri-spam-2-line",   title: t("citizen_portal.auth.verify.check_spam"), desc: t("citizen_portal.auth.verify.check_spam_desc") },
        { icon: "ri-time-line",     title: t("citizen_portal.auth.login.expires_10m"), desc: t("citizen_portal.auth.verify.expired_request_new") },
        { icon: "ri-refresh-line",  title: t("citizen_portal.auth.verify.resend_anytime"), desc: t("citizen_portal.auth.verify.resend_anytime_desc") }
      ].each do |item| %>
        <div class="col-12 col-md-4 text-center">
          <i class="<%= item[:icon] %> ri-2x text-haitian-cyan mb-2"></i>
          <div class="auth-benefit-title"><%= item[:title] %></div>
          <div class="auth-benefit-desc"><%= item[:desc] %></div>
        </div>
      <% end %>
    </div>

    <!-- FOOTER NOTE -->
    <p class="small opacity-75 fst-italic text-center">
      <%= t("citizen_portal.auth.verify.single_use") %>
    </p>

  </div>
<% end %>

<%# ================= RIGHT COLUMN ================= %>
<div class="login-card">
  <%# Partner branding banner (only when coming from a partner OAuth flow) %>
  <% if @partner.present? %>
    <div class="p-3 mb-4 rounded-3" style="background: #f0f4ff; border: 1px solid rgba(0,32,159,0.1);">
      <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
        <%# Partner logo %>
        <div class="d-flex align-items-center justify-content-center rounded-circle overflow-hidden flex-shrink-0"
             style="width: 36px; height: 36px; background: #fff; border: 1px solid #e2e8f0;">
          <% if @partner.logo.attached? %>
            <%= image_tag @partner.logo.variant(resize_to_fill: [72, 72]),
                  style: "width: 100%; height: 100%; object-fit: cover;",
                  alt: @partner.name %>
          <% else %>
            <i class="ri-building-2-line" style="font-size: 0.9rem; color: #64748b;"></i>
          <% end %>
        </div>

        <%# Connection icon %>
        <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
             style="width: 24px; height: 24px; background: #e2e8f0; border: 1px solid #cbd5e1;">
          <i class="ri-link-m" style="font-size: 0.7rem; color: #64748b;"></i>
        </div>

        <%# BonID logo %>
        <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
             style="width: 36px; height: 36px; background: var(--primary); border: 1px solid var(--primary);">
          <i class="ri-shield-check-line" style="font-size: 0.9rem; color: #fff;"></i>
        </div>
      </div>
      <div class="text-center">
        <div class="fw-semibold" style="font-size: 0.82rem; color: #0F172A;">
          <%= @partner.name %>
        </div>
        <div style="font-size: 0.72rem; color: #64748b;">
          <%= t("citizen_portal.auth.partner_uses_bonid") %>
        </div>
      </div>
    </div>
  <% end %>

  <%# Icon badge %>
  <div class="text-center mb-4">
    <div class="auth-icon-badge">
      <i class="ri-shield-keyhole-line"></i>
    </div>
  </div>

  <%# Flash rendered by citizen_auth layout. JS uses #otp-flash for dynamic alerts (e.g., expired). %>
  <div id="otp-flash"></div>

  <%# OTP Form %>
  <%= form_with url: citizens_verify_otp_path(partner_slug: params[:partner_slug]),
                method: :post,
                local: true,
                html: { data: { turbo: false }, id: "otp-form" } do |f| %>

    <%= hidden_field_tag :partner_slug, params[:partner_slug] %>
    <%= hidden_field_tag :signup,       params[:signup] %>
    <%= hidden_field_tag :email,        params[:email] %>

    <div class="mb-3">
      <%= f.label :otp, t("citizen_portal.auth.verify.code_label"), class: "form-label" %>
      <%= f.text_field :otp,
            required: true,
            autofocus: true,
            maxlength: 6,
            inputmode: "numeric",
            pattern: "\\d{6}",
            autocomplete: "one-time-code",
            placeholder: "• • • • • •",
            class: "form-control text-center fw-bold font-monospace",
            style: "letter-spacing: 0.5em; font-size: 1.75rem;",
            aria: { label: t("citizen_portal.auth.verify.code_aria") },
            id: "otp-input" %>

      <div class="d-flex justify-content-between align-items-center mt-2">
        <small class="text-muted">
          <i class="ri-time-line me-1"></i><%= t("citizen_portal.auth.verify.expires_in") %>
          <span id="otp-timer" class="fw-semibold">10:00</span>
        </small>
        <small class="text-success d-none" id="otp-success">
          <i class="ri-check-line me-1"></i><%= t("citizen_portal.auth.verify.looks_good") %>
        </small>
      </div>
    </div>

    <%= f.submit t("citizen_portal.auth.verify.submit"),
          class: "btn btn-haitian-primary w-100 mt-2",
          id: "verify-button",
          data: { disable_with: '<span class="spinner-border spinner-border-sm me-2"></span>'.html_safe + t("citizen_portal.auth.verify.verifying") } %>

    <div class="trust-badge">
      <i class="ri-shield-check-line"></i>
      <span><%= t("citizen_portal.auth.secure") %></span>
    </div>

    <div class="auth-help-link">
      <%= t("citizen_portal.auth.verify.no_code_html", link: content_tag(:a, t("citizen_portal.auth.verify.resend_it"), href: "#", onclick: "document.getElementById('resend-button')?.click(); return false;")) %>
    </div>
  <% end %>

  <%# Resend %>
  <div class="text-center mt-3 mb-2">
    <div id="resend-container">
      <%= button_to t("citizen_portal.auth.verify.resend_code"),
            citizens_resend_otp_path(
              email: params[:email],
              signup: params[:signup],
              partner_slug: params[:partner_slug]
            ),
            method: :post,
            id: "resend-button",
            class: "btn btn-link fw-semibold text-primary text-decoration-none p-0 small",
            data: { disable_with: t("citizen_portal.auth.verify.sending"), turbo: false } %>
    </div>
    <p class="small text-muted d-none" id="resend-cooldown">
      <i class="ri-time-line me-1"></i><%= t("citizen_portal.auth.verify.wait_html", seconds: content_tag(:span, "60", id: "cooldown-timer", class: "fw-semibold")) %>
    </p>
  </div>

  <%# Divider %>
  <div class="login-divider my-4">
    <span><%= t("citizen_portal.auth.or") %></span>
  </div>

  <%# Back %>
  <div>
    <%= link_to login_path(partner_slug: params[:partner_slug]),
          class: "btn btn-ghost-haitian w-100" do %>
      <i class="ri-arrow-left-line me-2"></i><%= params[:signup] == "true" ? t("citizen_portal.auth.verify.different_email") : t("citizen_portal.auth.verify.back_to_login") %>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // ── Expiry timer ──────────────────────────────────────────────
    let expirySeconds = 600;
    const timerEl  = document.getElementById('otp-timer');
    const verifyBtn = document.getElementById('verify-button');
    const otpInput  = document.getElementById('otp-input');

    const expiryTimer = setInterval(() => {
      expirySeconds--;
      const m = Math.floor(expirySeconds / 60);
      const s = expirySeconds % 60;
      timerEl.textContent = `${m}:${s.toString().padStart(2, '0')}`;

      if (expirySeconds <= 120) timerEl.classList.add('text-warning', 'fw-bold');

      if (expirySeconds <= 0) {
        clearInterval(expiryTimer);
        timerEl.textContent = '<%= j t("citizen_portal.auth.verify.expired") %>';
        timerEl.classList.replace('text-warning', 'text-danger');
        verifyBtn.disabled = true;
        verifyBtn.textContent = '<%= j t("citizen_portal.auth.verify.code_expired_btn") %>';
        otpInput.disabled = true;

        const div = document.createElement('div');
        div.className = 'alert alert-danger mb-3';
        div.innerHTML = '<i class="ri-error-warning-line me-2"></i><%= j t("citizen_portal.auth.verify.code_expired_alert_html") %>';
        const flash = document.getElementById('otp-flash');
        flash.innerHTML = '';
        flash.appendChild(div);
      }
    }, 1000);

    // ── Input formatting ──────────────────────────────────────────
    otpInput.addEventListener('input', (e) => {
      e.target.value = e.target.value.replace(/\D/g, '');
      const ok = e.target.value.length === 6;
      document.getElementById('otp-success')?.classList.toggle('d-none', !ok);
      if (ok) verifyBtn.focus();
    });

    otpInput.addEventListener('paste', (e) => {
      e.preventDefault();
      const nums = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '').substring(0, 6);
      otpInput.value = nums;
      if (nums.length === 6) document.getElementById('otp-success')?.classList.remove('d-none');
    });

    // ── Resend cooldown ───────────────────────────────────────────
    const resendBtn       = document.getElementById('resend-button');
    const resendContainer = document.getElementById('resend-container');
    const cooldownMsg     = document.getElementById('resend-cooldown');
    const cooldownTimer   = document.getElementById('cooldown-timer');

    resendBtn?.addEventListener('click', () => {
      let cd = 60;
      resendContainer.classList.add('d-none');
      cooldownMsg.classList.remove('d-none');

      const interval = setInterval(() => {
        cd--;
        cooldownTimer.textContent = cd;
        if (cd <= 0) {
          clearInterval(interval);
          resendContainer.classList.remove('d-none');
          cooldownMsg.classList.add('d-none');
          expirySeconds = 600;
          timerEl.classList.remove('text-warning', 'text-danger', 'fw-bold');
        }
      }, 1000);
    });
  });
</script>
