<%# app/views/citizens/sessions/new.html.erb %>

<% content_for :auth_left do %>
  <div class="auth-left-inner d-flex flex-column justify-content-between h-100 py-4 py-lg-5 w-100">

    <!-- INTRO -->
    <div class="text-center mb-4 mb-lg-5">
      <h2 class="display-5 fw-bold mb-3 font-heading">
      BonID
      </h2>

      <p class="lead opacity-90 mx-auto max-w-text">
        A private digital identity for citizens in Haiti —
        secure, fast, and accepted everywhere that matters.
      </p>
    </div>

    <!-- CAROUSEL -->
    <div id="bonidCarousel"
         class="carousel slide mb-4 mb-lg-5"
         data-bs-ride="carousel"
         data-bs-interval="9000">

      <div class="carousel-indicators position-static justify-content-center mb-3">
        <% 6.times do |i| %>
          <button type="button"
                  data-bs-target="#bonidCarousel"
                  data-bs-slide-to="<%= i %>"
                  class="<%= i.zero? ? 'active' : '' %>"
                  aria-label="Slide <%= i + 1 %>"></button>
        <% end %>
      </div>

      <div class="carousel-inner">

        <!-- PRIMARY SLIDE -->
        <div class="carousel-item active text-center px-3">
          <i class="ri-shield-user-line ri-4x text-haitian-cyan mb-3"></i>
          <h4 class="fw-bold mb-2">What is BonID?</h4>
          <p class="mx-auto max-w-carousel opacity-90">
            BonID is a private digital identity that lets you prove who you are
            to banks, schools, hospitals, and services
            <strong>without carrying physical documents every time</strong>.
          </p>
        </div>

        <% [
          { icon: "ri-bank-line",        title: "Accepted at Major Institutions",  desc: "Recognized by banks, schools, hospitals, embassies, and police across Haiti." },
          { icon: "ri-qr-code-line",     title: "Secure QR Sharing",               desc: "Share only what's needed using a time-limited, encrypted QR code." },
          { icon: "ri-eye-line",         title: "Full Visibility",                  desc: "See exactly when and where your BonID was used — always in your control." },
          { icon: "ri-lock-2-line",      title: "Privacy by Design",               desc: "Your data is encrypted and never sold or shared without your explicit consent." },
          { icon: "ri-global-line",      title: "Built for Haiti",                  desc: "Works reliably on slow networks and offline — designed for real conditions." }
        ].each do |slide| %>
          <div class="carousel-item text-center px-3">
            <i class="<%= slide[:icon] %> ri-4x text-haitian-cyan mb-3"></i>
            <h5 class="fw-bold mb-2"><%= slide[:title] %></h5>
            <p class="mx-auto max-w-carousel opacity-90">
              <%= slide[:desc] %>
            </p>
          </div>
        <% end %>

      </div>
    </div>

  </div>
<% end %>


<div class="login-card">
  <%# Icon badge %>
  <div class="text-center mb-4">
    <div class="auth-icon-badge">
      <i class="ri-shield-user-line"></i>
    </div>
  </div>

  <%# Form %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { data: { turbo: false } }) do |f| %>
    <div class="form-floating mb-3">
      <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            placeholder: "you@example.com",
            class: "form-control" %>
      <%= f.label :email, "Email Address" %>
    </div>

    <div class="form-floating mb-3">
      <%= f.password_field :password,
            autocomplete: "current-password",
            placeholder: "Enter your password",
            class: "form-control" %>
      <%= f.label :password, "Password" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="mb-3 form-check">
        <%= f.check_box :remember_me, class: "form-check-input" %>
        <%= f.label :remember_me, "Remember me", class: "form-check-label" %>
      </div>
    <% end %>

    <%= f.submit "Log In",
          class: "btn btn-haitian-primary w-100 mt-2",
          data: { disable_with: '<span class="spinner-border spinner-border-sm me-2"></span>Logging in…' } %>

    <div class="trust-badge">
      <i class="ri-shield-check-line"></i>
      <span>Secure &amp; encrypted</span>
    </div>

    <div class="auth-privacy-note">
      <i class="ri-lock-line"></i>We'll never share your email with third parties.
    </div>
  <% end %>

  <%# Forgot password %>
  <div class="text-center mt-4">
    <%= link_to "Forgot your password?", new_citizen_password_path, class: "forgot-link" %>
  </div>

  <%# Divider %>
  <div class="login-divider my-4">
    <span>or</span>
  </div>

  <%# OTP login %>
  <div class="text-center mb-3">
    <%= link_to citizens_otp_sign_in_path(from_partner: params[:from_partner]),
          class: "btn btn-ghost-haitian w-100" do %>
      <i class="ri-mail-send-line me-2"></i>Log in with one-time code
    <% end %>
  </div>

  <%# Create account %>
  <div class="text-center mb-3">
    <%= link_to new_citizen_registration_path(from_partner: params[:from_partner]),
          class: "btn btn-ghost-haitian w-100" do %>
      <i class="ri-user-add-line me-2"></i>Create a BonID account
    <% end %>
  </div>

  <%# Back to Home %>
  <div class="text-center mt-3">
    <%= link_to root_path, class: "btn btn-ghost-haitian w-100" do %>
      <i class="ri-arrow-left-line me-2"></i>Back to Home
    <% end %>
  </div>

  <div class="auth-help-link">
    <a href="mailto:support@bonid.app">Need help?</a>
  </div>
</div>
