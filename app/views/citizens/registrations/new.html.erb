<%# app/views/citizens/registrations/new.html.erb %>

<% content_for :auth_left do %>
  <div class="auth-left-inner d-flex flex-column justify-content-between h-100 py-4 py-lg-5 w-100">

    <!-- INTRO -->
    <div class="text-center mb-4 mb-lg-5">
      <h2 class="display-5 fw-bold mb-3 font-heading">
        <%= t("citizen_portal.auth.signup.left_title") %>
      </h2>

      <p class="lead opacity-90 mx-auto max-w-text">
        <%= t("citizen_portal.auth.signup.left_lead") %>
      </p>
    </div>

    <!-- CAROUSEL -->
    <div id="bonidCarousel"
         class="carousel slide mb-4 mb-lg-5"
         data-bs-ride="carousel"
         data-bs-interval="9000">

      <div class="carousel-indicators position-static justify-content-center mb-3">
        <% 5.times do |i| %>
          <button type="button"
                  data-bs-target="#bonidCarousel"
                  data-bs-slide-to="<%= i %>"
                  class="<%= i.zero? ? 'active' : '' %>"
                  aria-label="<%= t("citizen_portal.auth.signup.slide_aria", n: i + 1) %>"></button>
        <% end %>
      </div>

      <div class="carousel-inner">

        <% [
          { icon: "ri-bank-line",        title: t("citizen_portal.auth.signup.slides.institutions.title"), desc: t("citizen_portal.auth.signup.slides.institutions.desc") },
          { icon: "ri-qr-code-line",     title: t("citizen_portal.auth.signup.slides.qr.title"),           desc: t("citizen_portal.auth.signup.slides.qr.desc") },
          { icon: "ri-eye-line",         title: t("citizen_portal.auth.signup.slides.visibility.title"),   desc: t("citizen_portal.auth.signup.slides.visibility.desc") },
          { icon: "ri-lock-2-line",      title: t("citizen_portal.auth.signup.slides.privacy.title"),      desc: t("citizen_portal.auth.signup.slides.privacy.desc") },
          { icon: "ri-global-line",      title: t("citizen_portal.auth.signup.slides.haiti.title"),        desc: t("citizen_portal.auth.signup.slides.haiti.desc") }
        ].each_with_index do |slide, i| %>
          <div class="carousel-item <%= i.zero? ? 'active' : '' %> text-center px-3">
            <i class="<%= slide[:icon] %> ri-4x text-haitian-cyan mb-3"></i>
            <h5 class="fw-bold mb-2"><%= slide[:title] %></h5>
            <p class="mx-auto max-w-carousel opacity-90">
              <%= slide[:desc] %>
            </p>
          </div>
        <% end %>

      </div>
    </div>

    <!-- REQUIREMENTS -->
    <div class="text-center mt-4">
      <h5 class="fw-bold mb-3"><%= t("citizen_portal.auth.signup.need_title") %></h5>

      <div class="row g-3 justify-content-center mb-4">
        <% [
          ["ri-id-card-line",   t("citizen_portal.auth.signup.need.id")],
          ["ri-camera-line",    t("citizen_portal.auth.signup.need.selfie")],
          ["ri-file-text-line", t("citizen_portal.auth.signup.need.doc")],
          ["ri-mail-line",      t("citizen_portal.auth.signup.need.email")]
        ].each do |icon, label| %>
          <div class="col-6 col-md-3">
            <div class="text-center">
              <div class="req-icon-wrap">
                <i class="<%= icon %>"></i>
              </div>
              <div class="small fw-medium"><%= label %></div>
            </div>
          </div>
        <% end %>
      </div>

      <p class="small opacity-75 fst-italic">
        <%= t("citizen_portal.auth.signup.not_gov_id") %>
      </p>
    </div>

  </div>
<% end %>


<div class="login-card">

  <%# Partner badge — shown at the very top when a partner is present %>
  <% if params[:partner].present? %>
    <% partner = Partner.find_by(slug: params[:partner]) %>
    <% if partner %>
      <div class="text-center mb-4 pb-4" style="border-bottom: 1px solid rgba(0,32,159,0.10);">
        <% if partner.logo.attached? %>
          <%= image_tag url_for(partner.logo),
                alt: partner.name,
                style: "max-height: 64px; max-width: 200px; object-fit: contain; display: block; margin: 0 auto;" %>
        <% else %>
          <div style="width: 64px; height: 64px; background: rgba(0,32,159,0.08); border-radius: 50%;
                      display: flex; align-items: center; justify-content: center; margin: 0 auto;
                      border: 2px solid rgba(0,32,159,0.12);">
            <i class="ri-building-line" style="font-size: 1.5rem; color: var(--primary);"></i>
          </div>
        <% end %>
        <div class="small text-muted mt-2">
          <%= t("citizen_portal.auth.signup.via_html", partner: partner.name) %>
        </div>
      </div>
    <% end %>
  <% else %>
    <%# Icon badge — only shown when no partner %>
    <div class="text-center mb-4">
      <div class="auth-icon-badge">
        <i class="ri-user-add-line"></i>
      </div>
    </div>
  <% end %>

  <%# Flash rendered by citizen_auth layout %>

  <% if params[:partner].blank? %>
    <%# No partner warning %>
    <div class="alert alert-warning text-center py-4" role="alert">
      <i class="ri-error-warning-line fs-3 mb-3 d-block"></i>
      <h5 class="fw-semibold"><%= t("citizen_portal.auth.signup.partner_required") %></h5>
      <p class="mb-3 small">
        <%= t("citizen_portal.auth.signup.partner_required_body") %>
      </p>
      <%= link_to t("citizen_portal.auth.signup.browse_partners"), partners_path, class: "btn btn-haitian-primary w-100" %>
    </div>

  <% else %>
    <%# Errors %>
    <% if resource.errors.any? %>
      <div class="alert alert-danger mb-3">
        <ul class="mb-0 small ps-3">
          <% resource.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%# Registration Form %>
    <%= simple_form_for(resource,
                        as: resource_name,
                        url: registration_path(resource_name, partner: params[:partner]),
                        html: {
                          class: "needs-validation",
                          novalidate: true,
                          data: { turbo: false },
                          id: "registration-form"
                        }) do |f| %>

      <%= hidden_field_tag :partner, params[:partner] %>

      <div class="form-floating mb-3">
        <%= f.input_field :email,
              autofocus: true,
              autocomplete: "email",
              required: true,
              placeholder: t("citizen_portal.auth.signup.email_placeholder"),
              class: "form-control" %>
        <%= f.label :email, t("citizen_portal.auth.login.email_label") %>
      </div>

      <%= f.button :submit, t("citizen_portal.auth.signup.create"),
            class: "btn btn-haitian-primary w-100 mt-2",
            id: "submit-button",
            data: { disable_with: '<span class="spinner-border spinner-border-sm me-2"></span>'.html_safe + t("citizen_portal.auth.signup.creating") } %>

      <div class="trust-badge">
        <i class="ri-shield-check-line"></i>
        <span><%= t("citizen_portal.auth.secure") %></span>
      </div>

      <div class="auth-privacy-note">
        <i class="ri-lock-line"></i><%= t("citizen_portal.auth.login.never_share") %>
      </div>
    <% end %>

    <%# Divider %>
    <div class="login-divider my-4">
      <span><%= t("citizen_portal.auth.or") %></span>
    </div>

    <%# Already have an account %>
    <div class="mb-3">
      <%= link_to login_path(from_partner: params[:partner]),
            class: "btn btn-ghost-haitian w-100" do %>
        <i class="ri-login-box-line me-2"></i><%= t("citizen_portal.auth.signup.have_account") %>
      <% end %>
    </div>

    <div class="auth-help-link">
      <a href="mailto:support@bonid.ht"><%= t("citizen_portal.auth.need_help") %></a>
    </div>
  <% end %>
</div>

