<%# app/views/citizens/service_applications/receipt.html.erb %>
<%# Confirmation page shown immediately after successful submission %>
<% is_txn = @schema.service_category == "transaction" %>
<% content_for(:title) { is_txn ? "Ache Konfime — #{@schema.name}" : "Aplikasyon Soumèt — #{@schema.name}" } %>

<style>
  .rc-container { max-width: 560px; margin: 0 auto; text-align: center; padding: 1.5rem 1rem; }

  .rc-success-icon {
    width: 72px; height: 72px; border-radius: 50%; margin: 0 auto 1rem;
    background: #ECFDF5; display: flex; align-items: center; justify-content: center;
  }
  .rc-success-icon i { font-size: 2.2rem; color: #059669; }

  .rc-title { font-family: 'Montserrat', sans-serif; font-size: 1.3rem; font-weight: 700; color: #1a1a2e; margin-bottom: 0.35rem; }
  .rc-subtitle { font-size: 0.85rem; color: #6B7280; margin-bottom: 1.5rem; }

  .rc-card { background: #fff; border: 1px solid #E5E7EB; border-radius: 12px; padding: 1.25rem; margin-bottom: 1rem; text-align: left; }
  .rc-card-title { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; color: #6B7280; font-weight: 700; margin-bottom: 0.6rem; }

  .rc-row { display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px solid #F1F5F9; font-size: 0.82rem; }
  .rc-row:last-child { border-bottom: none; }
  .rc-row-label { color: #6B7280; }
  .rc-row-value { color: #1a1a2e; font-weight: 600; }

  .rc-code-block {
    padding: 1rem; background: #F0F4FF; border: 1px solid #C7D2FE; border-radius: 10px;
    margin: 1rem 0;
  }
  .rc-code-label { font-size: 0.65rem; text-transform: uppercase; color: #6B7280; font-weight: 600; }
  .rc-code-value { font-family: 'Courier New', monospace; font-size: 1.4rem; font-weight: 700; color: var(--primary); letter-spacing: 3px; margin-top: 0.25rem; }

  .rc-next-steps { text-align: left; margin-top: 1rem; }
  .rc-next-step {
    display: flex; gap: 0.6rem; padding: 0.5rem 0; font-size: 0.8rem; color: #374151;
  }
  .rc-next-step-num {
    width: 22px; height: 22px; border-radius: 50%; background: #EFF6FF;
    color: var(--primary); font-size: 0.65rem; font-weight: 700;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }

  .rc-actions { display: flex; gap: 0.6rem; justify-content: center; margin-top: 1.25rem; flex-wrap: wrap; }
  .rc-btn {
    display: inline-flex; align-items: center; gap: 0.35rem;
    padding: 0.55rem 1.25rem; border-radius: 8px; font-size: 0.82rem; font-weight: 600;
    text-decoration: none; transition: all 0.15s;
  }
  .rc-btn--primary { background: var(--primary); color: #fff; }
  .rc-btn--primary:hover { background: #001570; color: #fff; }
  .rc-btn--secondary { background: #F3F4F6; color: #374151; }
  .rc-btn--secondary:hover { background: #E5E7EB; }
</style>

<div class="rc-container">
  <%# ── Success Icon ── %>
  <div class="rc-success-icon">
    <i class="ri-checkbox-circle-line"></i>
  </div>

  <% if is_txn %>
    <h1 class="rc-title">Ache Konfime!</h1>
    <p class="rc-subtitle">
      Tikè ou pou <strong><%= @schema.name %></strong> avèk <strong><%= @partner.name %></strong> byen resevwa.
    </p>
  <% else %>
    <h1 class="rc-title">Aplikasyon Soumèt!</h1>
    <p class="rc-subtitle">
      Aplikasyon ou pou <strong><%= @schema.name %></strong> avèk <strong><%= @partner.name %></strong> byen resevwa.
    </p>
  <% end %>

  <%# ── Verification Code ── %>
  <div class="rc-code-block">
    <div class="rc-code-label">Kòd Verifikasyon Ou</div>
    <div class="rc-code-value"><%= @application.verification_code %></div>
  </div>

  <%# ── Summary ── %>
  <div class="rc-card">
    <div class="rc-card-title">Rezime</div>
    <div class="rc-row">
      <span class="rc-row-label">Sèvis</span>
      <span class="rc-row-value"><%= @schema.name %></span>
    </div>
    <% if @schema.form_code.present? %>
      <div class="rc-row">
        <span class="rc-row-label">Fòmilè</span>
        <span class="rc-row-value" style="font-family: monospace; letter-spacing: 0.5px;"><%= @schema.form_code_display %></span>
      </div>
    <% end %>
    <div class="rc-row">
      <span class="rc-row-label">Patnè</span>
      <span class="rc-row-value"><%= @partner.name %></span>
    </div>
    <div class="rc-row">
      <span class="rc-row-label">Soumèt</span>
      <span class="rc-row-value"><%= @application.submitted_at&.strftime("%d/%m/%Y à %H:%M") %></span>
    </div>
    <% snap = @application.price_snapshot %>
    <% if @application.total_price_cents.to_i > 0 && snap.present? %>
      <% cur = snap["currency"] || "HTG" %>
      <% fmt = ->(cents) { v = (cents.to_f / 100).round(2); "#{v.to_i == v ? v.to_i : v} #{cur}" } %>

      <%# ── Base price (with quantity if present) ── %>
      <% if snap["quantity"].present? %>
        <div class="rc-row">
          <span class="rc-row-label">
            <%= snap["quantity"]["field"] %>
            <span style="color: #6B7280; font-size: 0.72rem;">
              (<%= fmt.call(snap["base_cents"]) %> × <%= snap["quantity"]["quantity"].to_i %><%= " #{snap["quantity"]["unit"]}" if snap["quantity"]["unit"].present? %>)
            </span>
          </span>
          <span class="rc-row-value"><%= fmt.call(snap["effective_base_cents"]) %></span>
        </div>
      <% elsif snap["base_cents"].to_i > 0 %>
        <div class="rc-row">
          <span class="rc-row-label">Pri Debaz</span>
          <span class="rc-row-value"><%= fmt.call(snap["base_cents"]) %></span>
        </div>
      <% end %>

      <%# ── Mandatory fees ── %>
      <% (snap["fees"] || []).each do |fee| %>
        <div class="rc-row" style="font-size: 0.78rem;">
          <span class="rc-row-label"><%= fee["name"] %><%= " (#{fee["rate"]}%)" if fee["rate"] %></span>
          <span class="rc-row-value"><%= fmt.call(fee["amount_cents"]) %></span>
        </div>
      <% end %>

      <%# ── Optional add-ons ── %>
      <% (snap["addons"] || []).each do |addon| %>
        <div class="rc-row" style="font-size: 0.78rem; font-style: italic;">
          <span class="rc-row-label"><%= addon["field"] %>: <%= addon["option"] %></span>
          <span class="rc-row-value" style="<%= 'color: #059669;' if addon["amount_cents"].to_i < 0 %>"><%= fmt.call(addon["amount_cents"]) %></span>
        </div>
      <% end %>

      <%# ── Repeater price-per-row ── %>
      <% (snap["repeaters"] || []).each do |rep| %>
        <div class="rc-row" style="font-size: 0.78rem;">
          <span class="rc-row-label">
            <%= rep["field"] %>
            <span style="color: #6B7280; font-size: 0.72rem;">
              (<%= fmt.call(rep["per_row_cents"]) %> × <%= rep["row_count"] %>)
            </span>
          </span>
          <span class="rc-row-value"><%= fmt.call(rep["amount_cents"]) %></span>
        </div>
      <% end %>

      <%# ── Total ── %>
      <div class="rc-row" style="border-top: 2px solid #0F172A; padding-top: 0.6rem; margin-top: 0.3rem;">
        <span class="rc-row-label" style="font-weight: 700; color: #0F172A;">Total</span>
        <span class="rc-row-value" style="font-size: 1.05rem; color: var(--primary);"><%= fmt.call(snap["total_cents"]) %></span>
      </div>
    <% elsif @application.total_price_cents.to_i > 0 %>
      <div class="rc-row">
        <span class="rc-row-label">Montan</span>
        <span class="rc-row-value"><%= @application.price_display %></span>
      </div>
    <% end %>
    <% if @application.signed? %>
      <div class="rc-row">
        <span class="rc-row-label">Siyati BonID</span>
        <span class="rc-row-value" style="color: #059669;"><i class="ri-check-line"></i> Aplike</span>
      </div>
    <% end %>
  </div>

  <%# ── Next Steps ── %>
  <div class="rc-card">
    <div class="rc-card-title">Pwochen Etap</div>
    <div class="rc-next-steps">
      <% if is_txn %>
        <div class="rc-next-step">
          <span class="rc-next-step-num">1</span>
          <span>Prezante kòd verifikasyon ou lè ou rive nan evènman an.</span>
        </div>
        <div class="rc-next-step">
          <span class="rc-next-step-num">2</span>
          <span><%= @partner.name %> ap verifye tikè ou ak BonID ou.</span>
        </div>
      <% else %>
        <div class="rc-next-step">
          <span class="rc-next-step-num">1</span>
          <span><%= @partner.name %> ap revize aplikasyon ou.</span>
        </div>
        <div class="rc-next-step">
          <span class="rc-next-step-num">2</span>
          <span>Ou ap resevwa yon notifikasyon lè desizyon an pran.</span>
        </div>
        <% if @schema.auto_stamp? %>
          <div class="rc-next-step">
            <span class="rc-next-step-num">3</span>
            <span>Si apwouve, dokiman ofisyèl la ap jeneye otomatikman ak sèl ofisyèl.</span>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <%# ── Actions ── %>
  <div class="rc-actions">
    <%= link_to citizens_service_application_path(@application), class: "rc-btn rc-btn--primary" do %>
      <i class="ri-eye-line"></i> <%= is_txn ? "Wè Tikè" : "Wè Aplikasyon" %>
    <% end %>
    <%= link_to citizens_service_applications_path, class: "rc-btn rc-btn--secondary" do %>
      <i class="ri-file-list-3-line"></i> <%= is_txn ? "Tout Ache" : "Tout Aplikasyon" %>
    <% end %>
    <%= link_to citizens_services_path, class: "rc-btn rc-btn--secondary" do %>
      <i class="ri-apps-2-line"></i> Jwenn Plis Sèvis
    <% end %>
  </div>
</div>
