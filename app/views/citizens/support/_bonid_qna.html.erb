<%# app/views/citizens/support/_bonid_qna.html.erb %>
<div class="px-0">

  <%# ── Header ── %>
  <div class="text-center mb-4">
    <h3 style="font-family: 'Montserrat', sans-serif; font-size: 1.2rem; font-weight: 700; color: var(--primary);" class="mb-1">
      <i class="ri-question-answer-line me-2"></i><%= t('main.faq.title') %>
    </h3>
    <p class="text-muted mb-0" style="font-size: 0.78rem;">
      <%= t('main.faq.subtitle') %>
    </p>
  </div>

  <%# ── Q&A List ── %>
  <div class="citizen-faq-list mx-auto" style="max-width: 780px;">
    <% t('main.faq.items').each_with_index do |(key, item), index| %>
      <details class="citizen-faq-card mb-3" <%= 'open' if index.zero? %>>
        <summary class="citizen-faq-question"><%= item[:q].html_safe %></summary>
        <div class="citizen-faq-answer"><%= item[:a_html].html_safe %></div>
      </details>
    <% end %>
  </div>

</div>
