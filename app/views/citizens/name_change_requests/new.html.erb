<%# app/views/citizens/name_change_requests/new.html.erb %>

<%# Header chrome matches the Anrejistre wizard (.ballot-wrap / .ballot-head)
    so the name-change flow reads as part of the same citizen wizard. %>
<div class="ballot-wrap px-0" style="padding-bottom: 0;">

  <%# ── Back link — escape hatch back to profile edit ── %>
  <div class="ballot-back-bar">
    <%= link_to edit_citizens_profile_path, class: "ballot-back-link" do %>
      <i class="ri-arrow-left-line"></i>
    <% end %>
  </div>

  <%# ── Page Header (wizard style) ── %>
  <div class="ballot-head text-center">
    <h1 class="ballot-title">
      <i class="ri-edit-line me-2"></i>Request a Name Change
    </h1>
    <p class="ballot-subtitle mb-0">
      Submit a request to update your legal name with supporting documentation.
    </p>
  </div>

  <div class="complaint-form-wrapper">
    <%= simple_form_for @name_change_request,
          url: citizens_name_change_requests_path,
          html: { class: "profile-form", multipart: true, data: { turbo: false } } do |f| %>

      <%# Current Name (read-only) %>
      <div class="ballot-section card border-0 shadow-sm mb-4">
        <div class="card-body p-4">

          <div class="ballot-section-head mb-4">
            <h2 class="ballot-section-title">Current Name</h2>
            <p class="ballot-section-desc mb-0">
              These names come from your existing BonID profile and cannot be
              edited here.
            </p>
          </div>

          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label text-muted small">First Name</label>
              <div class="form-control bg-light"><%= current_citizen.first_name %></div>
            </div>
            <div class="col-md-4">
              <label class="form-label text-muted small">Middle Name</label>
              <div class="form-control bg-light"><%= current_citizen.middle_name.presence || "—" %></div>
            </div>
            <div class="col-md-4">
              <label class="form-label text-muted small">Last Name</label>
              <div class="form-control bg-light"><%= current_citizen.last_name %></div>
            </div>
          </div>
        </div>
      </div>

      <%# New Name %>
      <div class="ballot-section card border-0 shadow-sm mb-4">
        <div class="card-body p-4">

          <div class="ballot-section-head mb-4">
            <h2 class="ballot-section-title">New Name</h2>
            <p class="ballot-section-desc mb-0">
              Enter the legal name you would like on file going forward.
            </p>
          </div>

          <div class="row g-3">
            <div class="col-md-4">
              <%= f.input :new_first_name, required: true,
                input_html: {
                  placeholder: "e.g. Marie",
                  class: "form-control",
                  autocomplete: "given-name"
                },
                label: "First Name",
                label_html: { class: "form-label" } %>
            </div>
            <div class="col-md-4">
              <%= f.input :new_middle_name,
                input_html: {
                  placeholder: "e.g. Claudette (optional)",
                  class: "form-control",
                  autocomplete: "additional-name"
                },
                label: "Middle Name",
                label_html: { class: "form-label" } %>
            </div>
            <div class="col-md-4">
              <%= f.input :new_last_name, required: true,
                input_html: {
                  placeholder: "e.g. Dupont",
                  class: "form-control",
                  autocomplete: "family-name"
                },
                label: "Last Name",
                label_html: { class: "form-label" } %>
            </div>
          </div>
        </div>
      </div>

      <%# Reason & Document %>
      <div class="ballot-section card border-0 shadow-sm mb-4" data-controller="name-change-reason">
        <div class="card-body p-4">

          <div class="ballot-section-head mb-4">
            <h2 class="ballot-section-title">Reason &amp; Supporting Document</h2>
            <p class="ballot-section-desc mb-0">
              Select why you are changing your name and upload a document that
              proves the change.
            </p>
          </div>

          <div class="row g-3">
            <div class="col-md-6">
              <%= f.input :reason, required: true,
                collection: NameChangeRequest::REASONS.map { |k, v| [v, k] },
                include_blank: "Select a reason",
                input_html: {
                  class: "form-select",
                  data: {
                    name_change_reason_target: "reason",
                    action: "change->name-change-reason#toggle"
                  }
                },
                label: "Reason for Name Change",
                label_html: { class: "form-label" } %>
            </div>

            <div class="col-md-6" data-name-change-reason-target="otherField" style="display: none;">
              <%= f.input :other_reason,
                input_html: {
                  placeholder: "Please describe...",
                  class: "form-control",
                  rows: 2
                },
                label: "Other Reason",
                label_html: { class: "form-label" } %>
            </div>

            <div class="col-12">
              <%= f.input :supporting_document, as: :file, required: true,
                input_html: {
                  class: "form-control",
                  accept: ".pdf,.jpg,.jpeg,.png"
                },
                label: "Supporting Document",
                label_html: { class: "form-label" },
                hint: "Upload a marriage certificate, court order, or official document (PDF, JPG, or PNG)." %>
            </div>
          </div>
        </div>
      </div>

      <%# Privacy Notice — highlighted using the wizard's tip-box idiom %>
      <div class="enroll-helpful-tip mb-4">
        <i class="ri-shield-check-line"></i>
        <div>
          <strong>Your request is encrypted and secure.</strong>
          Only authorized administrators can review name change requests.
          You will be notified by email once your request is reviewed.
        </div>
      </div>

      <%# Submit %>
      <div class="d-flex justify-content-between align-items-center">
        <%= link_to edit_citizens_profile_path,
              class: "btn btn-outline-secondary fw-semibold px-4 py-2",
              style: "font-size: 0.85rem;" do %>
          <i class="ri-arrow-left-line me-1"></i> Cancel
        <% end %>

        <%= f.submit "Submit Request",
            class: "btn btn-primary fw-semibold px-4 py-2",
            style: "font-size: 0.85rem;",
            data: { disable_with: "Submitting..." } %>
      </div>
    <% end %>

    <div class="mt-4 text-center small text-muted">
      <i class="ri-lock-2-fill text-success me-2"></i>Encrypted • Haiti Government Compliant
    </div>
  </div>
</div>
