<%# app/views/citizens/name_change_requests/new.html.erb %>

<%# Header chrome matches the Anrejistre wizard (.ballot-wrap / .ballot-head)
    so the name-change flow reads as part of the same citizen wizard. %>
<div class="ballot-wrap px-0" style="padding-bottom: 0;">

  <%# ── Page Header (wizard style) ── %>
  <div class="ballot-head text-center">
    <h1 class="ballot-title">
      <i class="ri-edit-line me-2"></i><%= t("citizen_portal.name_change.title") %>
    </h1>
    <p class="ballot-subtitle mb-0">
      <%= t("citizen_portal.name_change.subtitle") %>
    </p>
  </div>

  <div class="complaint-form-wrapper">
    <%= simple_form_for @name_change_request,
          url: citizens_name_change_requests_path,
          html: { class: "profile-form", multipart: true, data: { turbo: false } } do |f| %>

      <%# Current Name (read-only) %>
      <div class="ballot-section card border-0 shadow-sm mb-4">
        <div class="card-body p-4">

          <div class="ballot-section-head mb-4">
            <h2 class="ballot-section-title"><%= t("citizen_portal.name_change.current_name") %></h2>
            <p class="ballot-section-desc mb-0">
              <%= t("citizen_portal.name_change.current_name_desc") %>
            </p>
          </div>

          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label text-muted small"><%= t("citizen_portal.name_change.first_name") %></label>
              <div class="form-control bg-light"><%= current_citizen.first_name %></div>
            </div>
            <div class="col-md-4">
              <label class="form-label text-muted small"><%= t("citizen_portal.name_change.middle_name") %></label>
              <div class="form-control bg-light"><%= current_citizen.middle_name.presence || "—" %></div>
            </div>
            <div class="col-md-4">
              <label class="form-label text-muted small"><%= t("citizen_portal.name_change.last_name") %></label>
              <div class="form-control bg-light"><%= current_citizen.last_name %></div>
            </div>
          </div>
        </div>
      </div>

      <%# New Name %>
      <div class="ballot-section card border-0 shadow-sm mb-4">
        <div class="card-body p-4">

          <div class="ballot-section-head mb-4">
            <h2 class="ballot-section-title"><%= t("citizen_portal.name_change.new_name") %></h2>
            <p class="ballot-section-desc mb-0">
              <%= t("citizen_portal.name_change.new_name_desc") %>
            </p>
          </div>

          <div class="row g-3">
            <div class="col-md-4">
              <%= f.input :new_first_name, required: true,
                input_html: {
                  placeholder: t("citizen_portal.name_change.ph_first"),
                  class: "form-control",
                  autocomplete: "given-name"
                },
                label: t("citizen_portal.name_change.first_name"),
                label_html: { class: "form-label" } %>
            </div>
            <div class="col-md-4">
              <%= f.input :new_middle_name,
                input_html: {
                  placeholder: t("citizen_portal.name_change.ph_middle"),
                  class: "form-control",
                  autocomplete: "additional-name"
                },
                label: t("citizen_portal.name_change.middle_name"),
                label_html: { class: "form-label" } %>
            </div>
            <div class="col-md-4">
              <%= f.input :new_last_name, required: true,
                input_html: {
                  placeholder: t("citizen_portal.name_change.ph_last"),
                  class: "form-control",
                  autocomplete: "family-name"
                },
                label: t("citizen_portal.name_change.last_name"),
                label_html: { class: "form-label" } %>
            </div>
          </div>
        </div>
      </div>

      <%# Reason & Document %>
      <div class="ballot-section card border-0 shadow-sm mb-4" data-controller="name-change-reason">
        <div class="card-body p-4">

          <div class="ballot-section-head mb-4">
            <h2 class="ballot-section-title"><%= t("citizen_portal.name_change.reason_title") %></h2>
            <p class="ballot-section-desc mb-0">
              <%= t("citizen_portal.name_change.reason_desc") %>
            </p>
          </div>

          <div class="row g-3">
            <div class="col-md-6">
              <%= f.input :reason, required: true,
                collection: NameChangeRequest::REASONS.map { |k, v| [t("citizen_portal.name_change.reasons.#{k}", default: v), k] },
                include_blank: t("citizen_portal.name_change.select_reason"),
                input_html: {
                  class: "form-select",
                  data: {
                    name_change_reason_target: "reason",
                    action: "change->name-change-reason#toggle"
                  }
                },
                label: t("citizen_portal.name_change.reason_label"),
                label_html: { class: "form-label" } %>
            </div>

            <div class="col-md-6" data-name-change-reason-target="otherField" style="display: none;">
              <%= f.input :other_reason,
                input_html: {
                  placeholder: t("citizen_portal.name_change.other_placeholder"),
                  class: "form-control",
                  rows: 2
                },
                label: t("citizen_portal.name_change.other_reason"),
                label_html: { class: "form-label" } %>
            </div>

            <div class="col-12">
              <%= f.input :supporting_document, as: :file, required: true,
                input_html: {
                  class: "form-control",
                  accept: ".pdf,.jpg,.jpeg,.png"
                },
                label: t("citizen_portal.name_change.supporting_document"),
                label_html: { class: "form-label" },
                hint: t("citizen_portal.name_change.supporting_hint") %>
            </div>
          </div>
        </div>
      </div>

      <%# Privacy Notice — highlighted using the wizard's tip-box idiom %>
      <div class="enroll-helpful-tip mb-4">
        <i class="ri-shield-check-line"></i>
        <div>
          <%= t("citizen_portal.name_change.secure_html") %>
        </div>
      </div>

      <%# Submit %>
      <div class="d-flex justify-content-between align-items-center">
        <%= link_to edit_citizens_profile_path,
              class: "btn btn-outline-secondary fw-semibold px-4 py-2",
              style: "font-size: 0.85rem;" do %>
          <i class="ri-arrow-left-line me-1"></i> <%= t("citizen_portal.common.cancel") %>
        <% end %>

        <%= f.submit t("citizen_portal.name_change.submit"),
            class: "btn btn-primary fw-semibold px-4 py-2",
            style: "font-size: 0.85rem;",
            data: { disable_with: t("citizen_portal.submission.submitting") } %>
      </div>
    <% end %>

    <div class="mt-4 text-center small text-muted">
      <i class="ri-lock-2-fill text-success me-2"></i><%= t("citizen_portal.profile.encrypted_footer") %>
    </div>
  </div>
</div>
