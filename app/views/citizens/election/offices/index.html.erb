<%# BED/BEK locator — citizen-facing %>

<div class="ballot-wrap px-0" style="padding-bottom: 0;">

  <div class="ballot-head text-center">
    <h1 class="ballot-title">
      <i class="ri-map-pin-line me-2"></i>Biwo BED / BEK
    </h1>
    <p class="ballot-subtitle mb-0">
      Biwo CEP kote w ka ale pou èd ak enskripsyon
    </p>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-9">

      <% all_groups = [
        ["BEK — nan komin ou a", @bek_offices, "ri-community-line"],
        ["BED — nan depatman ou a", @bed_offices, "ri-building-line"],
        ["Lòt biwo ki louvri", @fallback_offices, "ri-map-2-line"]
      ] %>

      <% if all_groups.all? { |_, list, _| list.empty? } %>
        <div class="card election-card">
          <div class="card-body p-4 text-center">
            <div class="election-icon-circle" style="background: #FEF3C7;">
              <i class="ri-information-line" style="color: #D97706;"></i>
            </div>
            <h5 class="fw-bold mb-2">Pa gen biwo ki disponib</h5>
            <p class="text-muted mb-0 small">
              CEP poko ajoute BED/BEK yo nan sistèm BonID. Tcheke retounen
              byento oswa vizite <a href="https://cephaiti.ht" target="_blank" rel="noopener">cephaiti.ht</a>.
            </p>
          </div>
        </div>
      <% else %>
        <% all_groups.each do |title, offices, icon| %>
          <% next if offices.empty? %>
          <h6 class="fw-bold mt-4 mb-3"><i class="<%= icon %> me-1"></i><%= title %></h6>
          <% offices.each do |o| %>
            <div class="card election-card mb-2">
              <div class="card-body p-3 d-flex align-items-start">
                <div class="election-icon-circle me-3"
                     style="background: <%= o.bed? ? '#DBEAFE' : '#DCFCE7' %>; width: 44px; height: 44px;">
                  <i class="<%= o.bed? ? 'ri-building-line' : 'ri-community-line' %>"
                     style="color: <%= o.bed? ? '#1D4ED8' : '#16A34A' %>;"></i>
                </div>
                <div class="flex-grow-1">
                  <div class="fw-bold"><%= o.name %></div>
                  <div class="small text-muted">
                    <span class="badge <%= o.bed? ? 'bg-info-subtle text-info' : 'bg-success-subtle text-success' %> me-1">
                      <%= o.office_type.upcase %>
                    </span>
                    <%= o.bed? ? o.department&.name : o.commune&.name %>
                  </div>
                  <% if o.address&.full_label.present? %>
                    <div class="small text-muted mt-1">
                      <i class="ri-map-pin-2-line me-1"></i><%= o.address.full_label %>
                    </div>
                  <% end %>
                  <div class="small text-muted mt-1 d-flex gap-3 flex-wrap">
                    <% if o.phone.present? %>
                      <span><i class="ri-phone-line me-1"></i><%= o.phone %></span>
                    <% end %>
                    <% if o.hours_note.present? %>
                      <span><i class="ri-time-line me-1"></i><%= o.hours_note %></span>
                    <% end %>
                    <span>
                      <i class="ri-circle-fill me-1"
                         style="color: <%= o.status == 'open' ? '#16A34A' : '#D97706' %>; font-size: 0.5rem;"></i>
                      <%= o.status.titleize %>
                    </span>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      <% end %>

      <div class="text-center mt-4">
        <%= link_to "Retounen Eleksyon Mwen", citizens_election_enrollment_path,
                    class: "btn btn-outline-primary" %>
      </div>
    </div>
  </div>
</div>
