<%# Election Results — Citizen view %>

<div class="ballot-wrap px-0" style="padding-bottom: 0;">

  <%# ── Page Header (wizard style — matches whole election flow) ── %>
  <div class="ballot-head text-center">
    <h1 class="ballot-title">
      <i class="ri-bar-chart-box-line me-2"></i><%= t("citizens.election.results_title") %>
    </h1>
    <p class="ballot-subtitle mb-0">
      <% if @election %>
        <%= @election.title.presence || @election.id %>
      <% else %>
        <%= t("citizens.election.results_subtitle", default: "View vote totals and certified results.") %>
      <% end %>
    </p>

    <% if @election %>
      <div class="mt-2">
        <% case @election.status
           when "certified" %>
          <span class="election-badge election-badge--lg election-badge--green">
            <i class="ri-checkbox-circle-fill me-1"></i><%= t("citizens.election.certified") %>
          </span>
        <% when "closed" %>
          <span class="election-badge election-badge--lg election-badge--blue">
            <i class="ri-loader-4-line me-1"></i><%= t("citizens.election.counting") %>
          </span>
        <% when "open" %>
          <span class="election-badge election-badge--lg election-badge--green">
            <i class="ri-radio-button-line me-1"></i><%= t("citizens.election.voting_open") %>
          </span>
        <% when "cancelled" %>
          <span class="election-badge election-badge--lg election-badge--past">
            <i class="ri-close-circle-line me-1"></i><%= t("citizens.election.cancelled") %>
          </span>
        <% else %>
          <span class="election-badge election-badge--lg election-badge--past">
            <i class="ri-time-line me-1"></i><%= t("citizens.election.not_started") %>
          </span>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-9">
      <% if @election %>
        <%# ── Stats Grid ── %>
        <div class="election-stats-grid">
          <div class="card election-card--sm">
            <div class="card-body p-3 text-center">
              <div class="election-stat-value"><%= number_with_delimiter(@total_votes) %></div>
              <div class="election-stat-label">Total Vot</div>
            </div>
          </div>
          <div class="card election-card--sm">
            <div class="card-body p-3 text-center">
              <div class="election-stat-value"><%= number_with_delimiter(@remote_votes) %></div>
              <div class="election-stat-label">Remot</div>
            </div>
          </div>
          <div class="card election-card--sm">
            <div class="card-body p-3 text-center">
              <div class="election-stat-value"><%= number_with_delimiter(@consulate_votes) %></div>
              <div class="election-stat-label">Konsila</div>
            </div>
          </div>
          <div class="card election-card--sm">
            <div class="card-body p-3 text-center">
              <div class="election-stat-value"><%= @countries_count %></div>
              <div class="election-stat-label">Peyi</div>
            </div>
          </div>
        </div>

        <%# ── Actions ── %>
        <div class="d-flex flex-wrap gap-3 justify-content-center">
          <a href="/election/results" target="_blank" class="election-results-link">
            <i class="ri-external-link-line"></i>
            <%= t("citizens.election.view_full_results") %>
          </a>

          <% if @certified %>
            <a href="/election/celebration" target="_blank" class="election-celebration-link">
              <i class="ri-trophy-line"></i>
              <%= t("citizens.election.view_celebration") %>
            </a>
          <% end %>
        </div>

      <% else %>
        <div class="card election-card">
          <div class="card-body p-4 text-center">
            <i class="ri-bar-chart-line election-empty-icon"></i>
            <p class="election-empty-text"><%= t("citizens.election.no_results") %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
