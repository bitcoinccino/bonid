<%# CEP postponement notice — April 8, 2026 communiqué
    Dismiss persists in session cookie so a citizen who read it once isn't
    nagged on every page load. Remove this partial once CEP announces the
    new registration window. %>

<% unless cookies[:cep_postponement_banner_dismissed] == "1" %>
  <div id="cep-postponement-banner"
       class="alert alert-warning d-flex align-items-start gap-3 mb-4 shadow-sm border-0"
       role="status">
    <i class="ri-megaphone-line" style="font-size: 1.4rem; color: #B45309;"></i>
    <div class="flex-grow-1">
      <div class="fw-bold mb-1">Enskripsyon Elektoral — Ranpòte</div>
      <div class="small text-muted">
        Daprè kominike CEP 8 avril 2026, operasyon enskripsyon elektoral
        yo ranpòte jiskaske CEP anonse nouvo dat yo. N ap mete paj sa a ajou
        lè nouvèl la vini.
      </div>
      <div class="small mt-2">
        <a href="https://cephaiti.ht/autour-de-lapplication-de-larrete-du-24-mars-2026/"
           target="_blank" rel="noopener" class="text-decoration-none">
          <i class="ri-external-link-line me-1"></i>Li kominike ofisyèl CEP la
        </a>
      </div>
    </div>
    <button type="button" class="btn-close" aria-label="Fèmen"
            onclick="(function(b){document.cookie='cep_postponement_banner_dismissed=1;path=/;max-age=2592000;samesite=lax';b.parentElement.remove();})(this)"></button>
  </div>
<% end %>
