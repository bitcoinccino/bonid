<%# Eleksyon Mwen — unified registration state page
    Chrome matches the ballot wizard (.ballot-head / .ballot-section) so the
    whole election flow reads as one continuous wizard, not two disjoint pages. %>

<div class="ballot-wrap px-0" style="padding-bottom: 0;">

  <%# ── Page Header (wizard style) ── %>
  <div class="ballot-head text-center">
    <h1 class="ballot-title">
      <i class="ri-user-voice-line me-2"></i><%= t("citizen_portal.election.enrollment.title") %>
    </h1>
    <%# Registered voters see the election name in the hero card below —
        don't repeat it here. %>
    <% unless @state == :registered %>
      <p class="ballot-subtitle mb-0">
        <% if @election %>
          <%= @election.title %>
        <% else %>
          <%= t("citizen_portal.election.enrollment.subtitle") %>
        <% end %>
      </p>
    <% end %>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-9">

      <%# Site-wide CEP postponement banner — embedded into the unified
          status header for the :registered state, so render standalone
          only on other states. Remove partial once CEP announces dates. %>
      <% unless @state == :registered %>
        <%= render "citizens/election/enrollment/postponement_banner" %>
      <% end %>

      <% case @state
         when :no_election %>
        <%# ─── NO ELECTION ─── %>
        <div class="card election-card">
          <div class="card-body p-4 text-center">
            <div class="election-icon-circle" style="background: #F1F5F9;">
              <i class="ri-calendar-close-line" style="color: #64748B;"></i>
            </div>
            <h5 class="fw-bold mb-2"><%= t("citizen_portal.election.enrollment.no_election_title") %></h5>
            <p class="text-muted mb-3" style="font-size: 0.88rem;">
              <%= t("citizen_portal.election.enrollment.no_election_body") %>
            </p>
            <%= link_to citizens_election_calendar_path, class: "election-btn-primary election-btn-primary--sm" do %>
              <i class="ri-calendar-event-line"></i> <%= t("citizen_portal.election.enrollment.see_calendar") %>
            <% end %>
          </div>
        </div>

      <% when :voted %>
        <%# ─── ALREADY VOTED ─── %>
        <div class="card election-card">
          <div class="card-body p-4 text-center">
            <div class="election-icon-circle" style="background: #DCFCE7;">
              <i class="ri-checkbox-circle-fill" style="color: #16A34A;"></i>
            </div>
            <h5 class="fw-bold mb-2 text-success"><%= t("citizen_portal.election.enrollment.voted_title") %></h5>
            <p class="text-muted mb-3" style="font-size: 0.88rem;">
              <%= t("citizen_portal.election.enrollment.voted_body") %>
              <% if @record.voted_at %>
                <br>
                <span class="small">
                  <%= l(@record.voted_at, format: :short) %>
                  <% if @record.voted_channel.present? %>
                    — <%= t("citizen_portal.election.enrollment.channel") %>: <strong><%= @record.voted_channel.humanize %></strong>
                  <% end %>
                </span>
              <% end %>
            </p>
            <%= link_to citizens_election_verify_path, class: "election-btn-primary election-btn-primary--sm" do %>
              <i class="ri-shield-check-line"></i> <%= t("citizen_portal.election.enrollment.verify_my_vote") %>
            <% end %>
          </div>
        </div>

      <% when :registered %>
        <%# ─── REGISTERED ─── %>
        <% geo = @record.geographic_chain %>

        <% if flash[:just_registered] %>
          <%# First render after a successful enroll: play the success reveal.
              The JS hides the overlay after ~1.6s and reveals the card. %>
          <div class="enroll-success-overlay" id="enroll-success-overlay">
            <div class="enroll-success-inner">
              <div class="enroll-success-check">
                <svg viewBox="0 0 64 64" aria-hidden="true">
                  <circle class="enroll-success-circle" cx="32" cy="32" r="28"></circle>
                  <path class="enroll-success-tick" d="M20 33 l9 9 l16 -18" fill="none"></path>
                </svg>
              </div>
              <div class="enroll-success-title"><%= t("citizen_portal.election.enrollment.success_title") %></div>
              <div class="enroll-success-subtitle"><%= t("citizen_portal.election.enrollment.success_subtitle") %></div>
            </div>
          </div>
          <script>
            (function() {
              const overlay = document.getElementById('enroll-success-overlay');
              if (!overlay) return;
              document.body.classList.add('enroll-success-active');
              setTimeout(function() {
                overlay.classList.add('is-leaving');
                document.body.classList.remove('enroll-success-active');
              }, 1600);
              setTimeout(function() {
                overlay.parentNode && overlay.parentNode.removeChild(overlay);
              }, 2200);
            })();
          </script>
        <% end %>

        <%# ── 1. Hero: election + status + voter number + date ─────────
            Everything a voter needs to confirm in two seconds. Channel,
            timestamps and the CEP notice live in the history below. %>
        <div class="voter-hero mb-3">
          <div class="voter-hero__top">
            <span class="voter-hero__election"><%= @election.title %></span>
            <span class="voter-hero__status">
              <i class="ri-checkbox-circle-fill"></i><%= t("citizen_portal.election.enrollment.registered_title") %>
            </span>
          </div>

          <div class="voter-hero__label">
            <%= t("citizen_portal.election.enrollment.voter_number") %>
            <span class="voter-id-card__verified">
              <i class="ri-verified-badge-fill"></i><%= t("citizen_portal.election.enrollment.verified") %>
            </span>
          </div>
          <div class="voter-id-card__value-row">
            <div class="voter-id-card__value"><%= @record.voter_reference %></div>
            <button type="button"
                    class="voter-id-card__copy"
                    data-copy="<%= @record.voter_reference %>"
                    aria-label="<%= t("citizen_portal.election.enrollment.copy_number") %>">
              <i class="ri-file-copy-line"></i>
            </button>
          </div>

          <% if !@election.open? && @election.election_date %>
            <div class="voter-hero__date">
              <i class="ri-calendar-event-line"></i>
              <span>
                <%= t("citizen_portal.election.enrollment.voting_starts") %>
                <strong><%= l(@election.election_date, format: :long) %></strong>
              </span>
            </div>
          <% end %>
        </div>

        <%# Voting-day CTA — honors the citizen's declared channel preference.
            Someone who enrolled as in-person must go to their assigned BV;
            we don't surface the online path to them even on an open election. %>
        <% if @election.open? %>
          <div class="mb-3">
            <% if @record.preferred_channel == "online" && @election.allows_online_voting %>
              <%= link_to citizens_election_vote_path, class: "election-btn-primary w-100" do %>
                <i class="ri-checkbox-circle-line"></i> <%= t("citizen_portal.election.enrollment.go_vote") %>
              <% end %>
            <% else %>
              <div class="election-in-person-cta">
                <div class="election-in-person-cta__icon">
                  <i class="ri-map-pin-line"></i>
                </div>
                <div>
                  <div class="election-in-person-cta__title"><%= t("citizen_portal.election.enrollment.in_person_title") %></div>
                  <div class="election-in-person-cta__desc">
                    <%= t("citizen_portal.election.enrollment.in_person_go") %>
                    <% if @record.polling_station&.polling_center&.name.present? %>
                      (<strong><%= @record.polling_station.polling_center.name %></strong>)
                    <% end %>
                    <%= t("citizen_portal.election.enrollment.in_person_bring_id") %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>

        <%# ── 2. Where & when to vote ───────────────────────────────────
            Venue + BV + hours + short address up front; the administrative
            hierarchy (department → section) is collapsed for poll workers. %>
        <div class="voter-info-card voter-where-card mb-3">
          <div class="voter-info-card__head">
            <i class="ri-map-pin-2-line voter-info-card__head-icon"></i>
            <span><%= t("citizen_portal.election.enrollment.where_when") %></span>
            <% if @record.diaspora? %>
              <span class="badge bg-info-subtle text-info ms-auto"><%= t("citizen_portal.election.enrollment.diaspora") %></span>
            <% end %>
          </div>
          <div class="voter-info-card__body">
            <% if @record.polling_station.present? %>
              <% station = @record.polling_station %>
              <% center  = station.polling_center %>
              <%
                addr_lines = center.formatted_haiti_display.to_s.split("\n").map(&:strip).reject(&:blank?)
                addr_lines -= [ center.communal_section&.name, "HAITI" ] unless center.diaspora?
                maps_query = ([ center.name ] + addr_lines).join(", ")
              %>

              <div class="voter-where__venue">
                <div class="voter-where__center"><%= center.name %></div>
                <span class="voter-where__bv">BV #<%= station.bv_number %></span>
              </div>

              <% if center.contact_hours.present? %>
                <% hours_value = center.contact_hours.sub(/\A\s*Jou\s+eleksyon(?:\s+an)?\s*[:\-–—]?\s*/i, "").strip %>
                <div class="voter-where__line">
                  <i class="ri-time-line"></i>
                  <span>
                    <strong><%= hours_value.presence || center.contact_hours %></strong>
                    <span class="voter-where__muted">· <%= t("citizen_portal.election.enrollment.election_day_only") %></span>
                  </span>
                </div>
              <% end %>

              <% if addr_lines.any? %>
                <div class="voter-where__line">
                  <i class="ri-map-pin-line"></i>
                  <span>
                    <%= safe_join(addr_lines, tag.br) %>
                    <br>
                    <%= link_to "https://www.google.com/maps/search/?api=1&query=#{ERB::Util.url_encode(maps_query)}",
                                class: "voter-info-row__link", target: "_blank", rel: "noopener" do %>
                      <i class="ri-external-link-line"></i> <%= t("citizen_portal.election.enrollment.open_in_maps") %>
                    <% end %>
                  </span>
                </div>
              <% end %>

              <% if center.contact_phone.present? %>
                <div class="voter-where__line">
                  <i class="ri-phone-line"></i>
                  <%= link_to center.contact_phone, "tel:#{center.contact_phone.gsub(/[^\d+]/, "")}",
                              class: "voter-info-row__link" %>
                </div>
              <% end %>

              <% if @record.preferred_channel == "online" && !@election.allows_online_voting %>
                <div class="voter-info-warn">
                  <i class="ri-alert-line"></i>
                  <%= t("citizen_portal.election.enrollment.online_unavailable") %>
                </div>
              <% end %>
            <% else %>
              <div class="voter-info-pending">
                <i class="ri-time-line"></i>
                <div>
                  <div class="voter-info-pending__title"><%= t("citizen_portal.election.enrollment.not_assigned") %></div>
                  <div class="voter-info-pending__desc"><%= t("citizen_portal.election.enrollment.assigning_soon") %></div>
                </div>
              </div>
            <% end %>

            <details class="voter-details">
              <summary><%= t("citizen_portal.election.enrollment.admin_details") %></summary>
              <div class="voter-info-row">
                <span class="voter-info-row__key"><%= t("citizen_portal.election.enrollment.department") %></span>
                <span class="voter-info-row__val"><%= geo[:department] %></span>
              </div>
              <% if geo[:arrondissement].present? %>
                <div class="voter-info-row">
                  <span class="voter-info-row__key"><%= t("citizen_portal.election.enrollment.arrondissement") %></span>
                  <span class="voter-info-row__val"><%= geo[:arrondissement] %></span>
                </div>
              <% end %>
              <% if geo[:commune].present? %>
                <div class="voter-info-row">
                  <span class="voter-info-row__key"><%= t("citizen_portal.election.enrollment.commune") %></span>
                  <span class="voter-info-row__val"><%= geo[:commune] %></span>
                </div>
              <% end %>
              <% if geo[:section].present? %>
                <div class="voter-info-row">
                  <span class="voter-info-row__key"><%= t("citizen_portal.election.enrollment.section") %></span>
                  <span class="voter-info-row__val"><%= geo[:section] %></span>
                </div>
              <% end %>
              <% if @record.constituency_name.present? && @record.constituency_name != @record.department_code %>
                <div class="voter-info-row">
                  <span class="voter-info-row__key"><%= t("citizen_portal.election.enrollment.constituency") %></span>
                  <span class="voter-info-row__val"><%= @record.constituency_name %></span>
                </div>
              <% end %>
            </details>
          </div>
        </div>

        <%# ── 3. Receipt actions — save before losing signal on election day %>
        <div class="voter-action-bar mb-3">
          <%= link_to citizens_election_receipt_download_path(format: :pdf),
                      class: "voter-action-bar__btn voter-action-bar__btn--primary" do %>
            <i class="ri-download-2-line"></i>
            <span><%= t("citizen_portal.election.enrollment.download_receipt") %></span>
          <% end %>
          <%= link_to citizens_election_receipt_print_path(format: :pdf),
                      class: "voter-action-bar__btn voter-action-bar__btn--ghost",
                      target: "_blank", rel: "noopener" do %>
            <i class="ri-printer-line"></i>
            <span><%= t("citizen_portal.election.enrollment.print_receipt") %></span>
          <% end %>
        </div>

        <%# ── 4. Security & verification: compact QR + registration history %>
        <% verify_url = @record.receipt_qr_url(host: request.host_with_port, protocol: request.protocol.sub("://", "")) %>
        <% qr_svg_b64 = QrCodeGenerator.generate_base64_svg(url: verify_url) %>
        <div class="voter-verify-card mb-4">
          <div class="voter-verify-card__head">
            <i class="ri-shield-check-line"></i>
            <span><%= t("citizen_portal.election.enrollment.security_title") %></span>
          </div>
          <div class="voter-verify-card__body voter-verify-card__body--compact">
            <div class="voter-verify-card__qr">
              <img src="data:image/svg+xml;base64,<%= qr_svg_b64 %>"
                   alt="<%= t("citizen_portal.election.enrollment.qr_alt") %>">
            </div>
            <div class="voter-verify-card__copy">
              <p class="voter-verify-card__desc"><%= t("citizen_portal.election.enrollment.scan_to_confirm") %></p>
              <%= link_to election_verify_receipt_path(d: Base64.urlsafe_encode64(@record.receipt_qr_payload.to_json, padding: false)),
                          class: "voter-verify-card__btn",
                          target: "_blank", rel: "noopener" do %>
                <i class="ri-external-link-line"></i> <%= t("citizen_portal.election.enrollment.check_now") %>
              <% end %>
            </div>
          </div>

          <details class="voter-details voter-details--history">
            <summary><%= t("citizen_portal.election.enrollment.history") %></summary>
            <ol class="voter-timeline">
              <li>
                <span class="voter-timeline__dot"></span>
                <div>
                  <div class="voter-timeline__title">
                    <% if @record.registered_by_partner_id.present? %>
                      <%= t("citizen_portal.election.enrollment.registered_by", name: @record.registered_by_partner&.name.presence || t("citizen_portal.election.enrollment.cep_consulate")) %>
                    <% else %>
                      <%= t("citizen_portal.election.enrollment.registered_online") %>
                    <% end %>
                    · <%= t(@record.preferred_channel == "online" ? "citizen_portal.election.enrollment.online" : "citizen_portal.election.enrollment.in_person") %>
                  </div>
                  <% if @record.registered_at.present? %>
                    <div class="voter-timeline__time"><%= l(@record.registered_at, format: "%d %B %Y, %H:%M") %></div>
                  <% end %>
                </div>
              </li>
              <li>
                <span class="voter-timeline__dot voter-timeline__dot--warn"></span>
                <div>
                  <div class="voter-timeline__title"><%= t("citizen_portal.election.enrollment.postponed_badge") %></div>
                  <div class="voter-timeline__time"><%= t("citizen_portal.election.enrollment.postponed_tooltip") %></div>
                </div>
              </li>
            </ol>
          </details>
        </div>

        <%# Lightweight copy-to-clipboard for the voter reference. %>
        <script>
          (function() {
            document.querySelectorAll('.voter-id-card__copy').forEach(function(btn) {
              btn.addEventListener('click', function() {
                const val = btn.getAttribute('data-copy');
                if (!val) return;
                if (navigator.clipboard) {
                  navigator.clipboard.writeText(val).then(function() {
                    btn.classList.add('is-copied');
                    setTimeout(function(){ btn.classList.remove('is-copied'); }, 1500);
                  });
                }
              });
            });
          })();
        </script>

      <% when :registrable_digital %>
        <%# ─── CAN ENROLL ONLINE ─── %>
        <%
          addr              = current_citizen.address
          citizen_name      = current_citizen.full_name.presence || current_citizen.first_name.presence || t("citizen_portal.election.enrollment.citizen_fallback")
          commune_name      = addr&.commune&.name.presence
          dept_full         = addr&.department&.name.presence
          context_loc       = [commune_name, dept_full].compact.join(", ").presence
          online_ok         = @election.allows_online_voting
          digital_enroll_ok = @election.respond_to?(:allows_digital_enrollment) && @election.allows_digital_enrollment
        %>

        <% unless digital_enroll_ok %>
          <%# Admin temporarily paused self-service for this election.
              Send citizens to the BonID in-person locator instead. %>
          <div class="card election-card mb-3">
            <div class="card-body p-4 text-center">
              <div class="election-icon-circle" style="background: #DBEAFE;">
                <i class="ri-map-pin-line" style="color: #1D4ED8;"></i>
              </div>
              <h5 class="fw-bold mb-2"><%= t("citizen_portal.election.enrollment.online_paused_title") %></h5>
              <p class="text-muted mb-3" style="font-size: 0.88rem;">
                <%= t("citizen_portal.election.enrollment.online_paused_body") %>
              </p>
              <%= link_to citizens_election_offices_path, class: "election-btn-primary mb-2" do %>
                <i class="ri-map-pin-line me-1"></i><%= t("citizen_portal.election.enrollment.find_office") %>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if digital_enroll_ok %>
        <div class="ballot-section card border-0 shadow-sm mb-4">
          <div class="card-body p-4">

            <%# Wizard-style section head: bold title + subdued desc + divider %>
            <div class="ballot-section-head mb-4">
              <h2 class="ballot-section-title"><%= t("citizen_portal.election.enrollment.register_title") %></h2>
              <p class="ballot-section-desc mb-0">
                <%= t("citizen_portal.election.enrollment.register_desc_html", election: @election.title) %>
              </p>
            </div>

            <%# Citizen context strip — "system already knows who you are" %>
            <div class="enroll-context-strip">
              <div>
                <div class="enroll-context-strip-name"><%= citizen_name %></div>
                <% if context_loc %>
                  <div class="enroll-context-strip-loc">
                    <i class="ri-map-pin-line"></i>
                    <span><%= context_loc %></span>
                  </div>
                <% end %>
              </div>
              <span class="enroll-context-strip-verified">
                <i class="ri-verified-badge-line"></i>
                <%= t("citizen_portal.election.enrollment.bonid_verified") %>
              </span>
            </div>

            <%= form_with url: citizens_election_enrollment_path, method: :post, local: true,
                          class: "enroll-form" do |f| %>
              <label class="election-form-label mb-2"><%= t("citizen_portal.election.enrollment.how_vote") %></label>

              <%# ── Method Card: In-person (reuses .candidate-card wizard style) ── %>
              <label class="ballot-candidate-label mb-2">
                <input class="ballot-radio" type="radio" name="preferred_channel"
                       id="channel_in_person" value="in_person" checked
                       onchange="selectEnrollMethod(this)">
                <div class="enroll-method-card is-selected">
                  <div class="enroll-method-icon">
                    <i class="ri-archive-drawer-line"></i>
                  </div>
                  <div class="candidate-meta">
                    <div class="enroll-method-title"><%= t("citizen_portal.election.enrollment.method_in_person") %></div>
                    <div class="enroll-method-desc">
                      <%= t("citizen_portal.election.enrollment.method_in_person_desc") %>
                    </div>
                  </div>
                  <div class="candidate-card-check">
                    <i class="ri-check-line"></i>
                  </div>
                </div>
              </label>

              <%# ── Method Card: Online (locked when unavailable) ── %>
              <label class="ballot-candidate-label">
                <input class="ballot-radio" type="radio" name="preferred_channel"
                       id="channel_online" value="online"
                       <%= "disabled" unless online_ok %>
                       onchange="selectEnrollMethod(this)">
                <div class="enroll-method-card <%= 'enroll-method-card--locked' unless online_ok %>">
                  <div class="enroll-method-icon">
                    <% if online_ok %>
                      <i class="ri-smartphone-line"></i>
                    <% else %>
                      <i class="ri-lock-2-line"></i>
                    <% end %>
                  </div>
                  <div class="candidate-meta">
                    <div class="enroll-method-title">
                      <%= t("citizen_portal.election.enrollment.method_online") %>
                      <% unless online_ok %>
                        <span class="enroll-method-badge"><%= t("citizen_portal.election.enrollment.coming_soon") %></span>
                      <% end %>
                    </div>
                    <div class="enroll-method-desc">
                      <% if online_ok %>
                        <%= t("citizen_portal.election.enrollment.method_online_desc") %>
                      <% else %>
                        <%= t("citizen_portal.election.enrollment.method_online_unavailable") %>
                      <% end %>
                    </div>
                  </div>
                  <div class="candidate-card-check">
                    <i class="ri-check-line"></i>
                  </div>
                </div>
              </label>

              <%# Helpful tip — surfaced just above CTA (was footer before) %>
              <div class="enroll-helpful-tip">
                <i class="ri-information-line"></i>
                <div>
                  <%= t("citizen_portal.election.enrollment.tip_html") %>
                </div>
              </div>

              <%# Strengthened CTA with shield + spinner %>
              <button type="submit" class="election-btn-primary w-100 enroll-submit">
                <span class="enroll-submit-default">
                  <i class="ri-shield-check-line"></i>
                  <span><%= t("citizen_portal.election.enrollment.confirm_registration") %></span>
                </span>
                <span class="enroll-submit-loading" aria-hidden="true">
                  <span class="enroll-spinner"></span>
                  <span><%= t("citizen_portal.election.enrollment.registering") %></span>
                </span>
              </button>
            <% end %>
          </div>
        </div>
        <% end %>
        <%# /digital_enroll_ok %>

        <script>
          (function() {
            // Mirror the ballot wizard's selectCandidate pattern: toggle
            // .is-selected on the enroll-method-card for the chosen radio.
            window.selectEnrollMethod = function(radio) {
              const form = radio.closest('form');
              if (!form) return;
              form.querySelectorAll('input[name="preferred_channel"]').forEach(function(r) {
                const card = r.closest('label').querySelector('.enroll-method-card');
                card && card.classList.remove('is-selected');
              });
              const card = radio.closest('label').querySelector('.enroll-method-card');
              card && card.classList.add('is-selected');
            };

            // Scoped handler: disable + swap label to spinner on submit so the
            // ~1s FOR UPDATE SKIP LOCKED BV-assignment window can't be double-clicked.
            const form = document.querySelector('.enroll-form');
            if (!form) return;
            form.addEventListener('submit', function() {
              const btn = form.querySelector('.enroll-submit');
              if (!btn) return;
              btn.classList.add('is-submitting');
              btn.disabled = true;
            });
          })();
        </script>

      <% when :ineligible %>
        <%# ─── INELIGIBLE ─── %>
        <div class="card election-card">
          <div class="card-body p-4 text-center">
            <div class="election-icon-circle" style="background: #FEF3C7;">
              <i class="ri-error-warning-line" style="color: #D97706;"></i>
            </div>
            <h5 class="fw-bold mb-2"><%= t("citizen_portal.election.enrollment.ineligible_title") %></h5>

            <% if @ineligibility_reason == "underage" %>
              <p class="text-muted mb-3" style="font-size: 0.88rem;">
                <%= t("citizen_portal.election.enrollment.underage") %>
              </p>
            <% elsif @ineligibility_reason == "no_cin" && !current_citizen.bonid_verified? %>
              <p class="text-muted mb-3" style="font-size: 0.88rem;">
                <%= t("citizen_portal.election.enrollment.finish_verification_body") %>
              </p>
              <%= link_to citizens_identity_submissions_path, class: "election-btn-primary election-btn-primary--sm" do %>
                <i class="ri-id-card-line"></i> <%= t("citizen_portal.election.enrollment.finish_verification") %>
              <% end %>
            <% elsif @ineligibility_reason == "no_cin" %>
              <p class="text-muted mb-3" style="font-size: 0.88rem;">
                <%= t("citizen_portal.election.enrollment.add_cin_body") %>
              </p>
              <%= link_to citizens_profile_path, class: "election-btn-primary election-btn-primary--sm" do %>
                <i class="ri-user-settings-line"></i> <%= t("citizen_portal.election.enrollment.update_profile") %>
              <% end %>
            <% else %>
              <p class="text-muted mb-0" style="font-size: 0.88rem;">
                <%= t("citizen_portal.election.enrollment.contact_cep") %>
              </p>
            <% end %>
          </div>
        </div>

      <% end %>

    </div>
  </div>
</div>
