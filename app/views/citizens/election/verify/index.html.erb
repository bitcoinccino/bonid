<%# Vote Verification — enter ballot hash %>

<div class="ballot-wrap px-0" style="padding-bottom: 0;">

  <%# ── Page Header (wizard style — matches whole election flow) ── %>
  <div class="ballot-head text-center">
    <h1 class="ballot-title">
      <i class="ri-shield-check-line me-2"></i><%= t("citizens.election.verify_title") %>
    </h1>
    <p class="ballot-subtitle mb-0">
      <%= t("citizens.election.verify_desc") %>
    </p>
  </div>

  <% if @error %>
    <div class="alert alert-warning" style="font-size: 0.82rem; border-radius: 0.75rem;">
      <%= @error %>
    </div>
  <% end %>

  <div class="row justify-content-center">
    <div class="col-lg-6">
      <div class="card election-card">
        <div class="card-body p-4">
          <%# Disable verify input + button until the citizen has actually cast a
              ballot for this election. No ballot = no hash to verify, so letting
              the user submit just returns "not found" and feels broken. %>
          <% unless @has_voted %>
            <div class="verify-not-voted mb-3" role="status">
              <i class="ri-information-line"></i>
              <div>
                <strong>Ou poko vote.</strong>
                <span>
                  Ou ka verifye vòt ou apre w fin vote. Resi w la ap pote kle
                  verifikasyon an.
                </span>
              </div>
            </div>
          <% end %>

          <%= form_with url: citizens_election_verify_check_path, method: :post, local: true do |f| %>
            <label class="election-form-label">
              <%= t("citizens.election.ballot_hash_label") %>
            </label>
            <%= f.text_area :ballot_hash,
                            value: @prefill_hash,
                            placeholder: t("citizens.election.hash_placeholder"),
                            rows: 3,
                            class: "election-hash-input",
                            required: true,
                            disabled: !@has_voted %>

            <button type="submit"
                    class="election-btn-primary election-btn-primary--sm mt-3"
                    <%= "disabled" unless @has_voted %>>
              <i class="ri-search-line"></i>
              <%= t("citizens.election.verify_button") %>
            </button>
          <% end %>
        </div>
      </div>

      <%# ── What is a Ballot Hash / Where to find it ── %>
      <% if @prefill_hash.blank? %>
      <div class="verify-help mt-4">
        <h5 class="verify-help-title">
          <i class="ri-search-eye-line"></i>
          <%= t("citizens.election.hash_explain_title") %>
        </h5>

        <p class="verify-help-lede">
          <%= t("citizens.election.hash_explain_what_is_it").html_safe %>
        </p>

        <p class="verify-help-privacy">
          <%= t("citizens.election.hash_privacy_note") %>
        </p>

        <div class="verify-help-where">
          <strong><%= t("citizens.election.where_to_find_title") %></strong>
          <ul>
            <li><%= t("citizens.election.where_to_find_step1") %></li>
            <li><%= t("citizens.election.where_to_find_step2") %></li>
            <li><%= t("citizens.election.where_to_find_step3") %></li>
          </ul>
        </div>

        <div class="verify-help-tip">
          <i class="ri-lightbulb-flash-line"></i>
          <span><%= t("citizens.election.hash_tip") %></span>
        </div>
      </div>
      <% end %>

      <p class="election-footnote mt-3">
        <%= t("citizens.election.verify_note") %>
      </p>
    </div>
  </div>
</div>

<style>
  .verify-help {
    background: #fff;
    border: 1px solid #e9ecef;
    border-radius: 0.875rem;
    padding: 1.25rem;
  }
  .verify-help-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--primary);
    margin: 0 0 0.75rem;
  }
  .verify-help-title i {
    color: var(--primary);
    font-size: 1.15rem;
  }
  .verify-help-lede {
    font-size: 0.92rem;
    color: #334155;
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }
  .verify-help-lede strong {
    color: #1a1a2e;
  }
  .verify-help-privacy {
    font-size: 0.85rem;
    color: #64748B;
    line-height: 1.5;
    margin-bottom: 1rem;
  }
  .verify-help-where {
    background: #FFFBEB;
    border: 1px solid #FDE68A;
    border-radius: 0.625rem;
    padding: 0.75rem 1rem;
    margin-bottom: 0.85rem;
    font-size: 0.85rem;
    color: #78350F;
  }
  .verify-help-where strong {
    display: block;
    margin-bottom: 0.4rem;
    color: #78350F;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.82rem;
  }
  .verify-help-where ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .verify-help-where li {
    padding: 0.2rem 0 0.2rem 1rem;
    position: relative;
    line-height: 1.5;
    color: #92400E;
  }
  .verify-help-where li::before {
    content: "•";
    position: absolute;
    left: 0.25rem;
    color: #B45309;
    font-weight: 700;
  }
  .verify-help-tip {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.78rem;
    color: #64748B;
    line-height: 1.5;
  }
  .verify-help-tip i {
    color: #D97706;
    font-size: 1rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  /* "You haven't voted yet" notice shown above the disabled verify form. */
  .verify-not-voted {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    background: #FEF9C3;
    border: 1px solid transparent;
    border-radius: 0.625rem;
    padding: 0.7rem 0.9rem;
    font-size: 0.85rem;
    color: #78350F;
    line-height: 1.5;
  }
  .verify-not-voted i {
    flex-shrink: 0;
    font-size: 1.1rem;
    color: #B45309;
    margin-top: 0.1rem;
  }
  .verify-not-voted strong {
    display: block;
    color: #78350F;
    font-weight: 700;
    margin-bottom: 0.1rem;
  }

  /* Greyed-out state for the hash input + submit when no vote exists yet. */
  .election-hash-input:disabled {
    background: #F8FAFC;
    color: #94A3B8;
    cursor: not-allowed;
  }
  .election-btn-primary--sm[disabled],
  .election-btn-primary[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
    filter: grayscale(0.2);
  }
</style>
