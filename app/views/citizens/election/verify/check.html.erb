<%# Vote Verification Result %>

<div class="ballot-wrap px-0" style="padding-bottom: 0;">

  <%# ── Page Header (wizard style — matches whole election flow) ── %>
  <div class="ballot-head text-center">
    <h1 class="ballot-title">
      <i class="ri-shield-check-line me-2"></i><%= t("citizens.election.verify_title") %>
    </h1>
    <p class="ballot-subtitle mb-0">
      <%= t("citizens.election.verify_desc") %>
    </p>
  </div>

  <div class="row">
    <div class="col-lg-6">
      <% if @result && @result[:found] %>
        <%# ── Found ── %>
        <div class="card border-0 shadow-sm election-card election-card--found mb-3">
          <div class="card-body p-4">
            <div class="d-flex align-items-center gap-3 mb-3">
              <div class="election-status-icon election-status-icon--pass">
                <i class="ri-checkbox-circle-fill"></i>
              </div>
              <div>
                <div class="election-status-title"><%= t("citizens.election.vote_found") %></div>
                <div class="election-status-desc"><%= t("citizens.election.vote_found_desc") %></div>
              </div>
            </div>

            <div class="mb-3">
              <label class="election-form-label--sm">Hash</label>
              <div class="election-hash-display"><%= @ballot_hash %></div>
            </div>

            <% if @result[:timestamp] %>
              <div class="election-detail-row" style="border-top: 1px solid #F1F5F9; padding-top: 0.75rem;">
                <span>Dat</span>
                <span class="election-detail-value">
                  <%= Time.parse(@result[:timestamp]).strftime("%d %b %Y, %H:%M") rescue @result[:timestamp] %>
                </span>
              </div>
            <% end %>
            <% if @result[:position] %>
              <div class="election-detail-row mt-2">
                <span>Pozisyon</span>
                <span class="election-detail-value"><%= @result[:position]&.capitalize %></span>
              </div>
            <% end %>
          </div>
        </div>

      <% else %>
        <%# ── Not Found ── %>
        <div class="card border-0 shadow-sm election-card mb-3">
          <div class="card-body p-4">
            <div class="d-flex align-items-center gap-3">
              <div class="election-status-icon election-status-icon--fail">
                <i class="ri-close-circle-fill"></i>
              </div>
              <div>
                <div class="election-status-title"><%= t("citizens.election.vote_not_found") %></div>
                <div class="election-status-desc"><%= t("citizens.election.vote_not_found_desc") %></div>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <a href="<%= citizens_election_verify_path %>" class="election-back-link">
        <i class="ri-arrow-left-line"></i>
        <%= t("citizens.election.try_again") %>
      </a>
    </div>
  </div>
</div>
