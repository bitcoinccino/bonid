<%# Vote Verification Result %>

<div class="container-fluid py-4" style="max-width: 560px; margin: 0 auto;">

  <% if @result && @result[:found] %>
    <%# ── Found ── %>
    <div class="text-center mb-4">
      <div style="width: 64px; height: 64px; border-radius: 50%; margin: 0 auto 1rem;
                  background: #D1FAE5; display: flex; align-items: center; justify-content: center;">
        <i class="ri-checkbox-circle-fill" style="font-size: 2rem; color: #065F46;"></i>
      </div>
      <h2 style="font-size: 1.3rem; font-weight: 800; color: #065F46; margin-bottom: 4px;">
        <%= t("citizens.election.vote_found") %>
      </h2>
      <p style="font-size: 0.85rem; color: #64748B;">
        <%= t("citizens.election.vote_found_desc") %>
      </p>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius: 1rem; border-left: 3px solid #10B981;">
      <div class="card-body p-4">
        <div style="margin-bottom: 1rem;">
          <label style="font-size: 0.65rem; font-weight: 700; color: #94A3B8; text-transform: uppercase;
                        letter-spacing: 0.08em;">Hash</label>
          <div style="font-family: 'Courier New', monospace; font-size: 0.72rem; color: #1E293B;
                      word-break: break-all; margin-top: 4px;">
            <%= @ballot_hash %>
          </div>
        </div>
        <% if @result[:timestamp] %>
          <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: #64748B;
                      border-top: 1px solid #F1F5F9; padding-top: 0.75rem;">
            <span>Dat</span>
            <span style="font-weight: 600; color: #1E293B;">
              <%= Time.parse(@result[:timestamp]).strftime("%d %b %Y, %H:%M") rescue @result[:timestamp] %>
            </span>
          </div>
        <% end %>
        <% if @result[:position] %>
          <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: #64748B; margin-top: 6px;">
            <span>Pozisyon</span>
            <span style="font-weight: 600; color: #1E293B;"><%= @result[:position]&.capitalize %></span>
          </div>
        <% end %>
      </div>
    </div>

  <% else %>
    <%# ── Not Found ── %>
    <div class="text-center mb-4">
      <div style="width: 64px; height: 64px; border-radius: 50%; margin: 0 auto 1rem;
                  background: #FEE2E2; display: flex; align-items: center; justify-content: center;">
        <i class="ri-close-circle-fill" style="font-size: 2rem; color: #991B1B;"></i>
      </div>
      <h2 style="font-size: 1.3rem; font-weight: 800; color: #991B1B; margin-bottom: 4px;">
        <%= t("citizens.election.vote_not_found") %>
      </h2>
      <p style="font-size: 0.85rem; color: #64748B; line-height: 1.5;">
        <%= t("citizens.election.vote_not_found_desc") %>
      </p>
    </div>
  <% end %>

  <%# ── Try Again ── %>
  <div class="mt-4 text-center">
    <a href="<%= citizens_election_verify_path %>"
       style="font-size: 0.85rem; font-weight: 600; color: #00209F; text-decoration: none;">
      <i class="ri-arrow-left-line" style="margin-right: 4px;"></i>
      <%= t("citizens.election.try_again") %>
    </a>
  </div>
</div>
