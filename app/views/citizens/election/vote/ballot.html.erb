<%# Step 3: Ballot — Candidate selection (multi-section wizard) %>

<div class="ballot-wrap">

  <%# ── Page Header ── %>
  <div class="ballot-head text-center">
    <h1 class="ballot-title">
      <i class="ri-checkbox-multiple-line me-2"></i><%= t("citizens.election.ballot_title", default: "Bilten Vòt") %>
    </h1>
    <p class="ballot-subtitle mb-0">
      <%= @election.title.presence || @election.id %>
    </p>
    <div class="ballot-timer mt-2 d-inline-flex align-items-center">
      <i class="ri-time-line me-1"></i><span id="ballot-countdown">10:00</span>
    </div>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-9">

      <%# ── Stepper (position progress) ── %>
      <ol class="ballot-stepper" id="section-tabs" role="tablist">
        <% @sections.each_with_index do |section, i| %>
          <li class="ballot-step <%= 'is-active' if i == 0 %>"
              id="tab-<%= i %>"
              data-step-index="<%= i %>"
              role="tab"
              tabindex="0"
              onclick="showSection(<%= i %>)">
            <span class="ballot-step-bubble">
              <span class="ballot-step-num"><%= i + 1 %></span>
              <i class="ballot-step-check ri-check-line"></i>
            </span>
            <span class="ballot-step-label"><%= section[:title] %></span>
          </li>
        <% end %>
      </ol>

      <%# ── Ballot form ── %>
      <%= form_with url: citizens_election_vote_cast_path, method: :post, local: true, id: "ballot-form",
                    data: { controller: "vote-encryption" } do |f| %>

        <%# Hidden fields for encrypted payload %>
        <%= f.hidden_field :position, value: "president", id: "vote-position" %>
        <input type="hidden" name="encrypted_choice[encrypted_choice]" id="enc-choice" value="">
        <input type="hidden" name="encrypted_choice[encrypted_key]" id="enc-key" value="">
        <input type="hidden" name="encrypted_choice[iv]" id="enc-iv" value="">
        <input type="hidden" name="encrypted_choice[auth_tag]" id="enc-auth-tag" value="">

        <%# ── Candidate sections ── %>
        <% @sections.each_with_index do |section, si| %>
          <div class="ballot-section card border-0 shadow-sm mb-4"
               id="section-<%= si %>"
               data-position="<%= section[:position] %>"
               style="<%= 'display:none;' unless si == 0 %>">
            <div class="card-body p-4">

              <%# Section heading (larger typography) %>
              <div class="ballot-section-head mb-4">
                <h2 class="ballot-section-title"><%= section[:title] %></h2>
                <p class="ballot-section-desc mb-0"><%= section[:description] %></p>
              </div>

              <%# ── Candidate grid ── %>
              <% if section[:candidates].present? %>
                <div class="row g-3 ballot-candidate-grid">
                  <% section[:candidates].each do |candidate| %>
                    <div class="col-12 col-md-6">
                      <label class="ballot-candidate-label">
                        <input type="radio"
                               name="selection_<%= section[:position] %>"
                               value="<%= candidate[:id] %>"
                               data-position="<%= section[:position] %>"
                               data-ballot-number="<%= candidate[:ballot_number] %>"
                               data-name="<%= candidate[:name] %>"
                               class="ballot-radio"
                               onchange="selectCandidate(this)">

                        <div class="candidate-card" data-candidate-id="<%= candidate[:id] %>">
                          <div class="candidate-card-check">
                            <i class="ri-check-line"></i>
                          </div>

                          <div class="candidate-photo">
                            <% if candidate[:photo_url].present? %>
                              <img src="<%= candidate[:photo_url] %>" alt="<%= candidate[:name] %>">
                            <% else %>
                              <i class="ri-user-line"></i>
                            <% end %>
                          </div>

                          <div class="candidate-meta">
                            <div class="candidate-name"><%= candidate[:name] %></div>
                            <div class="candidate-party">
                              <% if candidate[:party].present? %>
                                <%= candidate[:party] %><% if candidate[:party_acronym].present? %> <span class="candidate-party-acronym">(<%= candidate[:party_acronym] %>)</span><% end %>
                              <% else %>
                                Endepandan
                              <% end %>
                            </div>
                            <% if candidate[:ballot_number] %>
                              <span class="candidate-ballot-num">#<%= candidate[:ballot_number] %></span>
                            <% end %>
                          </div>
                        </div>
                      </label>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <div class="ballot-empty">
                  <div class="ballot-empty-icon">
                    <i class="ri-inbox-line"></i>
                  </div>
                  <p class="ballot-empty-text">
                    <%# President is national-scope; "in your area" would be misleading. %>
                    <% empty_key = section[:position].to_s == "president" ? "no_candidates_national" : "no_candidates" %>
                    <%= t("citizens.election.#{empty_key}") %>
                  </p>
                </div>
              <% end %>

              <%# ── Vòt Blanch (abstain) option — legal right to not choose ── %>
              <label class="ballot-blank-vote mt-3">
                <input type="radio"
                       name="selection_<%= section[:position] %>"
                       value="blank"
                       data-position="<%= section[:position] %>"
                       data-name="<%= t('citizens.election.blank_vote_confirm') %>"
                       class="ballot-radio"
                       onchange="selectCandidate(this)">
                <div class="ballot-blank-vote-card">
                  <i class="ri-prohibited-line ballot-blank-vote-icon"></i>
                  <div>
                    <div class="ballot-blank-vote-title"><%= t("citizens.election.blank_vote") %></div>
                    <div class="ballot-blank-vote-desc"><%= t("citizens.election.blank_vote_desc") %></div>
                  </div>
                  <div class="candidate-card-check ballot-blank-vote-check">
                    <i class="ri-check-line"></i>
                  </div>
                </div>
              </label>
            </div>
          </div>
        <% end %>

        <%# ── Confirmation overlay ── %>
        <div id="confirmation-overlay" class="ballot-section card border-0 shadow-sm" style="display: none;">
          <div class="card-body p-4">
            <div class="text-center mb-4">
              <div class="election-icon-circle election-icon-circle--blue mx-auto">
                <i class="ri-file-shield-2-line"></i>
              </div>
              <h2 class="ballot-section-title mt-3"><%= t("citizens.election.confirm_title") %></h2>
              <p class="ballot-section-desc"><%= t("citizens.election.confirm_desc") %></p>
            </div>

            <div id="choices-summary" class="mb-4"></div>

            <div class="alert alert-success d-flex align-items-start gap-2" style="font-size: 0.82rem;">
              <i class="ri-lock-line mt-1"></i>
              <%= t("citizens.election.encryption_notice") %>
            </div>
          </div>
        </div>

        <%# ── Sticky Footer Action Bar ── %>
        <div class="ballot-footer" id="ballot-footer">
          <div class="ballot-footer-inner">
            <button type="button" id="footer-back" class="btn-ballot btn-ballot--ghost" style="visibility: hidden;" onclick="goBack()">
              <i class="ri-arrow-left-line"></i>
              <span><%= t("citizens.election.back") %></span>
            </button>

            <div class="ballot-footer-status" id="footer-status">
              <i class="ri-information-line me-1"></i>
              <span id="footer-status-text"></span>
            </div>

            <button type="button" id="footer-next" class="btn-ballot btn-ballot--primary" onclick="goNext()">
              <span id="footer-next-label"><%= t("citizens.election.next_section") %></span>
              <i class="ri-arrow-right-line"></i>
            </button>

            <button type="submit" id="footer-cast" class="btn-ballot btn-ballot--success" style="display:none;">
              <i class="ri-shield-check-line"></i>
              <span><%= t("citizens.election.cast_vote") %></span>
            </button>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  (function() {
    const TOTAL_SECTIONS = <%= @sections.size %>;
    let currentIndex = 0;
    let confirmationActive = false;

    window.showSection = function(index) {
      confirmationActive = false;
      currentIndex = index;

      document.querySelectorAll('.ballot-section').forEach(s => s.style.display = 'none');
      const section = document.getElementById('section-' + index);
      if (section) section.style.display = 'block';

      // Stepper state: active / completed
      document.querySelectorAll('.ballot-step').forEach((step, i) => {
        step.classList.remove('is-active');
        if (i === index) step.classList.add('is-active');
      });

      document.getElementById('confirmation-overlay').style.display = 'none';
      updateFooter();
    };

    window.selectCandidate = function(radio) {
      const position = radio.dataset.position;
      const section = radio.closest('.ballot-section');

      section.querySelectorAll('input[name="selection_' + position + '"]').forEach(r => {
        const card = r.closest('label').querySelector('.candidate-card, .ballot-blank-vote-card');
        card?.classList.remove('is-selected');
      });

      const card = radio.closest('label').querySelector('.candidate-card, .ballot-blank-vote-card');
      card?.classList.add('is-selected');

      // Mark this step as completed
      const sectionIndex = Array.from(document.querySelectorAll('.ballot-section')).indexOf(section);
      const step = document.querySelector('.ballot-step[data-step-index="' + sectionIndex + '"]');
      step?.classList.add('is-completed');

      updateFooter();
    };

    window.goBack = function() {
      if (confirmationActive) {
        showSection(TOTAL_SECTIONS - 1);
        return;
      }
      if (currentIndex > 0) showSection(currentIndex - 1);
    };

    window.goNext = function() {
      if (currentIndex < TOTAL_SECTIONS - 1) {
        showSection(currentIndex + 1);
      } else {
        showConfirmation();
      }
    };

    function showConfirmation() {
      confirmationActive = true;
      const summary = document.getElementById('choices-summary');
      let html = '';

      document.querySelectorAll('.ballot-section').forEach((section) => {
        if (section.id === 'confirmation-overlay') return;
        const checked = section.querySelector('input[type="radio"]:checked');
        const titleEl = section.querySelector('.ballot-section-title');
        const title = titleEl ? titleEl.textContent.trim() : '';

        if (checked) {
          const name = checked.dataset.name || '';
          const number = checked.dataset.ballotNumber;
          html += '<div class="ballot-summary-row">' +
                  '<i class="ri-check-line ballot-summary-check"></i>' +
                  '<div class="ballot-summary-body">' +
                    '<div class="ballot-summary-position">' + title + '</div>' +
                    '<div class="ballot-summary-name">' + name + (number ? ' · #' + number : '') + '</div>' +
                  '</div></div>';
        } else {
          html += '<div class="ballot-summary-row ballot-summary-row--skipped">' +
                  '<i class="ri-question-line ballot-summary-check"></i>' +
                  '<div class="ballot-summary-body">' +
                    '<div class="ballot-summary-position">' + title + '</div>' +
                    '<div class="ballot-summary-name ballot-summary-name--muted">—</div>' +
                  '</div></div>';
        }
      });

      if (html === '') {
        html = '<div class="text-center text-muted p-3" style="font-size: 0.82rem;">' +
               '<%= j t("citizens.election.no_selection") %></div>';
      }

      summary.innerHTML = html;
      document.querySelectorAll('.ballot-section').forEach(s => {
        if (s.id !== 'confirmation-overlay') s.style.display = 'none';
      });
      document.getElementById('confirmation-overlay').style.display = 'block';
      updateFooter();
    }

    function updateFooter() {
      const back = document.getElementById('footer-back');
      const next = document.getElementById('footer-next');
      const nextLabel = document.getElementById('footer-next-label');
      const cast = document.getElementById('footer-cast');
      const statusEl = document.getElementById('footer-status');
      const statusText = document.getElementById('footer-status-text');

      if (confirmationActive) {
        back.style.visibility = 'visible';
        next.style.display = 'none';
        cast.style.display = 'inline-flex';
        statusEl.style.display = 'none';
        return;
      }

      cast.style.display = 'none';
      next.style.display = 'inline-flex';

      back.style.visibility = currentIndex > 0 ? 'visible' : 'hidden';

      if (currentIndex === TOTAL_SECTIONS - 1) {
        nextLabel.textContent = '<%= j t("citizens.election.review_choices") %>';
      } else {
        nextLabel.textContent = '<%= j t("citizens.election.next_section") %>';
      }

      // Per-section status
      const section = document.getElementById('section-' + currentIndex);
      const checked = section?.querySelector('input[type="radio"]:checked');
      if (checked) {
        const name = checked.dataset.name || '';
        statusEl.style.display = 'flex';
        statusEl.classList.remove('ballot-footer-status--warn');
        statusEl.classList.add('ballot-footer-status--ok');
        statusText.textContent = name;
      } else {
        statusEl.style.display = 'flex';
        statusEl.classList.remove('ballot-footer-status--ok');
        statusEl.classList.add('ballot-footer-status--warn');
        statusText.textContent = '<%= j t("citizens.election.no_selection") %>';
      }
    }

    // ── Countdown timer (10 minutes) ──
    (function startCountdown() {
      let remaining = 10 * 60;
      const el = document.getElementById('ballot-countdown');
      const tick = () => {
        const m = Math.floor(remaining / 60);
        const s = remaining % 60;
        if (el) el.textContent = m + ':' + String(s).padStart(2, '0');
        if (remaining > 0) {
          remaining--;
          setTimeout(tick, 1000);
        }
      };
      tick();
    })();

    updateFooter();
  })();
</script>
