<%# Step 5: Receipt — Ballot confirmation with hash + QR + share %>

<div class="ballot-wrap px-0" style="padding-bottom: 0;">

  <%# ── Page Header (wizard style — matches whole election flow) ── %>
  <div class="ballot-head text-center">
    <h1 class="ballot-title">
      <i class="ri-checkbox-circle-line me-2"></i><%= t("citizens.election.vote_registered") %>
    </h1>
    <p class="ballot-subtitle mb-0">
      <%= t("citizens.election.thank_you") %>
    </p>
  </div>

  <div class="row">
    <div class="col-lg-6">
      <%# ── Proof Banner ── %>
      <div class="receipt-proof-banner mb-3">
        <i class="ri-shield-star-line"></i>
        <span><%= t("citizens.election.receipt_proof_banner") %></span>
      </div>

      <%# ── Receipt Card ── %>
      <div class="card election-card mb-4">
        <div class="card-body p-4">

          <%# Channel badge %>
          <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
              <div style="font-family: 'Montserrat', sans-serif; font-size: 0.72rem; font-weight: 800; color: var(--primary); letter-spacing: 1px;">
                BONID &middot; ELEKSYON 2026
              </div>
              <div class="text-muted" style="font-size: 0.7rem;"><%= @receipt["election_id"] %></div>
            </div>
            <span class="election-badge election-badge--lg election-badge--green">
              <%= t("citizens.election.remote") %>
            </span>
          </div>

          <%# Receipt hash %>
          <div class="mb-3">
            <label class="election-form-label--sm" style="margin-bottom: 0.5rem;">
              <%= t("citizens.election.receipt_number") %>
            </label>
            <div class="receipt-hash-box">
              <%= @receipt["ballot_hash"] %>
            </div>
          </div>

          <%# QR Code %>
          <div class="text-center mb-3">
            <div class="receipt-qr-wrapper">
              <% qr = RQRCode::QRCode.new(@verify_url, size: 6, level: :m) %>
              <%= raw qr.as_svg(
                module_size: 3,
                use_path: true,
                fill: "ffffff",
                color: "1E293B",
                shape_rendering: "crispEdges",
                viewbox: true
              ) %>
            </div>
          </div>

          <p class="text-muted text-center" style="font-size: 0.72rem;">
            <%= t("citizens.election.scan_qr") %>
          </p>

          <%# Timestamp + receipt ID %>
          <div style="border-top: 1px solid #E2E8F0; padding-top: 1rem;" class="mt-3">
            <div class="receipt-detail-row">
              <span>Dat</span>
              <span class="receipt-detail-value">
                <%= Time.parse(@receipt["timestamp"]).strftime("%d %b %Y, %H:%M") rescue Time.current.strftime("%d %b %Y, %H:%M") %>
              </span>
            </div>
            <div class="receipt-detail-row mt-2">
              <span>Resi ID</span>
              <span class="receipt-detail-value--mono">
                <%= @receipt["receipt_id"].to_s[0..7].upcase %>
              </span>
            </div>

            <%# Oath chain — shows the citizen the legal artifact that
                preceded this ballot. Quiet line, not a CTA. %>
            <% if @oath&.accepted_at.present? %>
              <div class="receipt-oath-line">
                <i class="ri-quill-pen-line"></i>
                <span>
                  Ou te siyen sèman vòt la
                  <strong><%= l(@oath.accepted_at, format: "%d %b %Y, %H:%M") %></strong>
                  <% if @election&.title.present? %>pou <strong><%= @election.title %></strong><% end %>.
                </span>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <%# ── Action Buttons ── %>
      <% share_text = t("citizens.election.share_text") %>

      <%# PRIMARY — Copy hash (the proof) %>
      <button type="button"
              class="receipt-copy-btn mb-2"
              data-hash="<%= @receipt['ballot_hash'] %>"
              data-toast-success="<%= t('citizens.election.copy_toast_success') %>"
              onclick="copyBallotHash(this)">
        <i class="ri-file-copy-line"></i>
        <span class="receipt-copy-btn__label"><%= t("citizens.election.copy_hash_button") %></span>
      </button>

      <%# Secondary — WhatsApp share %>
      <a href="https://wa.me/?text=<%= CGI.escape(share_text) %>"
         target="_blank" rel="noopener"
         class="btn btn-outline-success rounded-pill w-100 py-2 mb-2">
        <i class="ri-whatsapp-line me-2" style="font-size: 1.1rem;"></i>
        <%= t("citizens.election.share_whatsapp") %>
      </a>

      <a href="<%= citizens_election_verify_path %>" class="btn btn-outline-primary rounded-pill w-100 py-2 mb-2">
        <i class="ri-shield-check-line me-1"></i>
        <%= t("citizens.election.verify_my_vote") %>
      </a>

      <a href="<%= citizens_dashboard_path %>" class="d-block text-center text-muted py-2" style="font-size: 0.78rem;">
        <%= t("citizens.election.return_home") %>
      </a>

      <%# ── Toast ── %>
      <div id="receipt-toast" class="receipt-toast" role="status" aria-live="polite"></div>

      <script>
        (function() {
          window.copyBallotHash = function(btn) {
            var hash = btn.getAttribute('data-hash');
            var msg  = btn.getAttribute('data-toast-success');
            navigator.clipboard.writeText(hash).then(function() {
              btn.classList.add('is-copied');
              var label = btn.querySelector('.receipt-copy-btn__label');
              if (label) label.textContent = '✓';
              var toast = document.getElementById('receipt-toast');
              toast.textContent = msg;
              toast.classList.add('is-visible');
              setTimeout(function() { toast.classList.remove('is-visible'); }, 2400);
            });
          };
        })();
      </script>

      <style>
        /* Proof banner — impossible to miss */
        .receipt-proof-banner {
          display: flex;
          align-items: center;
          gap: 0.6rem;
          padding: 0.875rem 1.1rem;
          background: linear-gradient(90deg, #FEF3C7, #FDE68A);
          border: 1px solid #F59E0B;
          border-radius: 0.75rem;
          color: #78350F;
          font-family: 'Montserrat', sans-serif;
          font-size: 0.88rem;
          font-weight: 700;
          line-height: 1.3;
        }
        .receipt-proof-banner i {
          color: #B45309;
          font-size: 1.25rem;
          flex-shrink: 0;
        }

        /* Primary copy button — big, pulsing */
        .receipt-copy-btn {
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 0.6rem;
          width: 100%;
          padding: 1rem 1.25rem;
          background: var(--primary);
          color: #fff;
          border: none;
          border-radius: 1rem;
          font-family: 'Montserrat', sans-serif;
          font-size: 1.02rem;
          font-weight: 700;
          cursor: pointer;
          box-shadow: 0 6px 18px rgba(0, 32, 159, 0.25);
          transition: all 0.2s ease;
          animation: receiptCopyPulse 2.2s ease-in-out infinite;
        }
        .receipt-copy-btn:hover {
          background: #001570;
          transform: translateY(-1px);
          box-shadow: 0 8px 22px rgba(0, 32, 159, 0.32);
        }
        .receipt-copy-btn i { font-size: 1.2rem; }
        .receipt-copy-btn.is-copied {
          background: #059669;
          animation: none;
          box-shadow: 0 4px 14px rgba(5, 150, 105, 0.25);
        }
        @keyframes receiptCopyPulse {
          0%, 100% { box-shadow: 0 6px 18px rgba(0, 32, 159, 0.25); }
          50%      { box-shadow: 0 6px 22px rgba(0, 32, 159, 0.45); }
        }
        @media (prefers-reduced-motion: reduce) {
          .receipt-copy-btn { animation: none; }
        }

        /* Oath chain — quiet, footnote-tone confirmation that the
           sworn-oath legal artifact exists for this ballot. */
        .receipt-oath-line {
          display: flex;
          align-items: flex-start;
          gap: 0.45rem;
          margin-top: 0.85rem;
          padding-top: 0.75rem;
          border-top: 1px dashed #E2E8F0;
          font-family: 'Inter', system-ui, sans-serif;
          font-size: 0.74rem;
          line-height: 1.4;
          color: #475569;
        }
        .receipt-oath-line i {
          color: #00209F;
          font-size: 0.95rem;
          line-height: 1.2;
          flex-shrink: 0;
          margin-top: 1px;
        }
        .receipt-oath-line strong {
          color: #1E293B;
          font-weight: 600;
        }

        /* Toast */
        .receipt-toast {
          position: fixed;
          left: 50%;
          bottom: 24px;
          transform: translate(-50%, 20px);
          background: #1a1a2e;
          color: #fff;
          padding: 0.7rem 1.1rem;
          border-radius: 999px;
          font-size: 0.85rem;
          font-weight: 600;
          box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
          opacity: 0;
          pointer-events: none;
          transition: opacity 0.2s ease, transform 0.2s ease;
          z-index: 1080;
          max-width: 90vw;
          text-align: center;
        }
        .receipt-toast.is-visible {
          opacity: 1;
          transform: translate(-50%, 0);
        }
      </style>

      <p class="election-footnote mt-3">
        <i class="ri-lock-line me-1"></i>
        <%= t("citizens.election.privacy_footer") %>
      </p>
    </div>
  </div>
</div>
