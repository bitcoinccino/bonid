<%# Electoral Calendar — Citizen view %>

<div class="ballot-wrap px-0" style="padding-bottom: 0;">

  <%# ── Page Header (wizard style — matches whole election flow) ── %>
  <div class="ballot-head text-center">
    <h1 class="ballot-title">
      <i class="ri-calendar-event-line me-2"></i><%= t("citizens.election.calendar_title") %>
    </h1>
    <p class="ballot-subtitle mb-0">
      <% if @election %>
        <%= @election.title.presence || @election.id %>
      <% else %>
        <%= t("citizens.election.calendar_subtitle", default: "View the timeline and phases for upcoming elections.") %>
      <% end %>
    </p>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-9">
      <% if @phases.any? %>
        <div class="election-timeline">
          <div class="election-timeline-line"></div>

          <% @phases.each do |phase| %>
            <% is_current = phase == @current_phase %>
            <% is_past = phase.end_date && phase.end_date < Date.current %>
            <div class="election-timeline-item">
              <div class="election-timeline-dot election-timeline-dot--<%= is_current ? 'current' : (is_past ? 'past' : 'future') %>"></div>

              <div class="card election-timeline-card <%= 'election-timeline-card--current' if is_current %>">
                <div class="card-body p-3">
                  <div class="d-flex align-items-center justify-content-between mb-1">
                    <h5 class="election-phase-name"><%= phase.name %></h5>
                    <% if is_current %>
                      <span class="election-badge election-badge--blue"><%= t("citizens.election.current_phase") %></span>
                    <% elsif is_past %>
                      <span class="election-badge election-badge--green"><i class="ri-check-line"></i></span>
                    <% end %>
                  </div>
                  <p class="election-phase-date">
                    <%= phase.start_date.strftime("%d %b %Y") %>
                    <% if phase.end_date %>
                      &mdash; <%= phase.end_date.strftime("%d %b %Y") %>
                    <% end %>
                  </p>
                  <% if phase.description.present? %>
                    <p class="election-phase-desc"><%= phase.description %></p>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="card election-card">
          <div class="card-body p-4 text-center">
            <i class="ri-calendar-line election-empty-icon"></i>
            <p class="election-empty-text"><%= t("citizens.election.no_calendar") %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
