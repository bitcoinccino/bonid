<%# Step 1: ID Type, Upload & Supporting Document %>

<%# ── Country of Residence — captured during onboarding gate, no longer
    asked here. Falls back to profile address country when the citizen
    predates the gate. The hidden field still posts the canonical ISO
    code so server-side params validation is unchanged. %>
<%
  inferred_diaspora = current_citizen.is_diaspora
  if inferred_diaspora.nil?
    profile_country = current_citizen.address&.country&.upcase == "HAITI" ? "HT" : (current_citizen.address&.country || "HT")
    inferred_diaspora = profile_country.present? && profile_country != "HT"
    resolved_country  = profile_country
  else
    resolved_country = inferred_diaspora ? (current_citizen.address&.country.presence || "OTHER") : "HT"
  end
  is_diaspora = inferred_diaspora
%>
<%= f.hidden_field :country_of_residence, value: resolved_country %>

<%# Pre-filled-from-profile summary — shown when the wizard is about to
    auto-use the citizen's profile document data. Surfaces exactly what
    will be submitted so the citizen can confirm before continuing,
    instead of the wizard silently injecting values they can't see. %>
<%
  profile_has_doc_preview = current_citizen.id_number.present? &&
                            current_citizen.id_type.present? &&
                            current_citizen.id_issued_on.present? &&
                            current_citizen.id_expires_on.present?
%>
<% if profile_has_doc_preview %>
  <div class="d-flex align-items-start gap-2 mb-4 p-3 rounded-3"
       style="background: rgba(0, 32, 159, 0.04); border: 1px solid rgba(0, 32, 159, 0.12); font-size: 0.82rem; line-height: 1.5;">
    <i class="ri-shield-check-line flex-shrink-0 mt-1" style="color: var(--primary); font-size: 1.1rem;"></i>
    <div class="flex-grow-1">
      <strong style="color: var(--primary);"><%= t("citizen_portal.submission.id_upload.profile_doc_title") %></strong>
      <div class="mt-1 text-dark">
        <%= t("citizen_portal.submission.id_upload.profile_doc_summary_html",
              type: (current_citizen.id_type.to_s == "cin" ? "CIN" : t("citizen_portal.submission.id_upload.id_types.#{current_citizen.id_type}", default: current_citizen.id_type.to_s.titleize)),
              number: current_citizen.id_number,
              issued: current_citizen.id_issued_on.strftime("%d/%m/%Y"),
              expires: current_citizen.id_expires_on.strftime("%d/%m/%Y")) %>
      </div>
      <%= link_to edit_citizens_profile_path,
                  class: "small fw-semibold text-decoration-none mt-2 d-inline-block",
                  style: "color: var(--primary);" do %>
        <i class="ri-edit-line me-1"></i> <%= t("citizen_portal.submission.id_upload.edit_in_profile") %>
      <% end %>
    </div>
  </div>
<% end %>

<div id="diaspora_fields"
     data-id-switcher-target="diasporaFields"
     class="mb-4"
     style="<%= 'display: none;' unless is_diaspora %>">
  <h6 style="font-family: 'Montserrat', sans-serif; font-size: 0.82rem; font-weight: 600; color: var(--primary);"
      class="mb-3">
    <i class="ri-global-line me-1"></i> <%= t("citizen_portal.submission.id_upload.residence_title") %>
  </h6>
  <p style="font-size: 0.78rem; color: #666; margin-bottom: 1rem; line-height: 1.5;">
    <%= t("citizen_portal.submission.id_upload.residence_desc") %>
  </p>

  <div class="row g-3">
    <div class="col-12 col-md-6">
      <%= f.input :host_country_id_type,
            label: t("citizen_portal.submission.id_upload.residence_type"),
            collection: [
              [t("citizen_portal.submission.id_upload.residence_types.green_card"), "green_card"],
              [t("citizen_portal.submission.id_upload.residence_types.state_id"), "state_id"],
              [t("citizen_portal.submission.id_upload.residence_types.drivers_license"), "drivers_license"],
              [t("citizen_portal.submission.id_upload.residence_types.cedula"), "cedula"],
              [t("citizen_portal.submission.id_upload.residence_types.pr_card"), "pr_card"],
              [t("citizen_portal.submission.id_upload.residence_types.residence_permit"), "residence_permit"],
              [t("citizen_portal.submission.id_upload.residence_types.other"), "other"]
            ],
            prompt: t("citizen_portal.submission.id_upload.residence_type_prompt"),
            input_html: { class: "form-select form-select-lg" },
            label_html: { class: "form-label fw-semibold" } %>
    </div>
    <div class="col-12 col-md-6" data-controller="image-quality">
      <%= f.input :host_country_id,
            as: :file,
            label: t("citizen_portal.submission.id_upload.upload_document"),
            input_html: {
              accept: "image/jpeg,image/png",
              capture: "environment",
              class: "form-control form-control-lg",
              data: { "image-quality-target": "input" }
            },
            label_html: { class: "form-label fw-semibold" } %>
      <div data-image-quality-target="status"></div>
      <div data-image-quality-target="thumbnail"></div>
      <% if submission.persisted? && submission.host_country_id.attached? %>
        <small class="text-success d-block mt-1"><i class="ri-checkbox-circle-line me-1"></i><%= t("citizen_portal.submission.id_upload.uploaded") %></small>
      <% end %>
    </div>
  </div>

  <%# Scan tips — same Rekognition best practices for the host-country ID %>
  <div class="mt-3">
    <%= render "citizens/identity_submissions/scan_tips" %>
  </div>
</div>

<%# Diaspora proof-of-address now lives in Step 2 (Dokiman Sipò) so this
    step stays focused on the primary government ID. %>

<% prefilled_id_type = submission.id_type.presence || current_citizen.id_type.presence %>
<% id_type_labels = %w[cin passport license voter_id driver_license national_card nif].index_with { |k| t("citizen_portal.submission.id_upload.id_types.#{k}") } %>
<% if prefilled_id_type %>
  <%# ID type already known from profile — carry it as a hidden field. %>
  <input type="hidden" name="identity_submission[id_type]" value="<%= prefilled_id_type %>">
<% else %>
  <div class="mb-3">
    <%= f.input :id_type,
          required: true,
          label: t("citizen_portal.submission.id_upload.select_id_type_label"),
          collection: [[t("citizen_portal.submission.id_upload.id_types.cin"), "cin"], [t("citizen_portal.submission.id_upload.id_types.passport"), "passport"]],
          prompt: t("citizen_portal.submission.id_upload.select_id_type"),
          input_html: {
            id: "id_type_select",
            class: "form-select form-select-lg",
            data: {
              action: "change->id-switcher#toggle",
              "id-switcher-target": "idType"
            }
          },
          label_html: { class: "form-label fw-semibold" } %>
  </div>
<% end %>

<%# CIN Uploads %>
<div id="cin_fields"
     data-id-switcher-target="cinFields"
     class="mb-4"
     style="<%= 'display: none;' unless prefilled_id_type == 'cin' || prefilled_id_type.blank? %>">
  <%# Scan tips — Amazon Rekognition best practices %>
  <%= render "citizens/identity_submissions/scan_tips" %>

  <div class="row g-3">
    <div class="col-12 col-md-6" data-controller="image-quality">
      <%= f.input :cin_front,
            as: :file,
            label: t("citizen_portal.submission.id_upload.cin_front"),
            required: !submission.cin_front.attached?,
            input_html: {
              accept: "image/jpeg,image/png",
              capture: "environment",
              class: "form-control form-control-lg",
              required: !submission.cin_front.attached?,
              data: { "image-quality-target": "input" }
            },
            label_html: { class: "form-label fw-semibold" } %>
      <div data-image-quality-target="status"></div>
      <div data-image-quality-target="thumbnail"></div>
      <% if submission.persisted? && submission.cin_front.attached? %>
        <small class="text-success d-block mt-1"><i class="ri-checkbox-circle-line me-1"></i><%= t("citizen_portal.submission.id_upload.uploaded") %></small>
      <% end %>
    </div>
    <div class="col-12 col-md-6" data-controller="image-quality">
      <%= f.input :cin_back,
            as: :file,
            label: t("citizen_portal.submission.id_upload.cin_back"),
            required: !submission.cin_back.attached?,
            input_html: {
              accept: "image/jpeg,image/png",
              capture: "environment",
              class: "form-control form-control-lg",
              required: !submission.cin_back.attached?,
              data: { "image-quality-target": "input" }
            },
            label_html: { class: "form-label fw-semibold" } %>
      <div data-image-quality-target="status"></div>
      <div data-image-quality-target="thumbnail"></div>
      <% if submission.persisted? && submission.cin_back.attached? %>
        <small class="text-success d-block mt-1"><i class="ri-checkbox-circle-line me-1"></i><%= t("citizen_portal.submission.id_upload.uploaded") %></small>
      <% end %>
    </div>
  </div>


</div>

<%# Passport Upload %>
<div id="passport_field"
     data-id-switcher-target="passportField"
     class="mb-4"
     style="<%= 'display: none;' unless prefilled_id_type == 'passport' %>">
  <%# Scan tips — Amazon Rekognition best practices %>
  <%= render "citizens/identity_submissions/scan_tips" %>

  <div data-controller="image-quality">
    <%= f.input :passport,
          as: :file,
          label: t("citizen_portal.submission.id_upload.passport_page"),
          required: !submission.passport.attached?,
          input_html: {
            accept: "image/jpeg,image/png",
            capture: "environment",
            class: "form-control form-control-lg",
            required: !submission.passport.attached?,
            data: { "image-quality-target": "input" }
          },
          label_html: { class: "form-label fw-semibold" } %>
    <div data-image-quality-target="status"></div>
    <% if submission.persisted? && submission.passport.attached? %>
      <small class="text-success d-block mt-1"><i class="ri-checkbox-circle-line me-1"></i><%= t("citizen_portal.submission.id_upload.uploaded") %></small>
    <% end %>
  </div>


</div>

<%# ── Document Number & Dates ──
    Skipped when the profile already holds the four document fields
    (id_type, id_number, id_issued_on, id_expires_on). Format validity
    is intentionally NOT checked here — citizens with legacy CINs see
    the legacy-CIN banner on the dashboard instead, and the submission
    validator rejects bad formats at submit time with a clear pointer
    back to the profile. Otherwise we'd re-ask citizens for fields they
    already filled out, which feels like the form forgot. %>
<% profile_has_doc = current_citizen.id_number.present? &&
                     current_citizen.id_type.present? &&
                     current_citizen.id_issued_on.present? &&
                     current_citizen.id_expires_on.present? %>
<% unless profile_has_doc || submission.submission_type.to_s == "resubmission" %>
<div id="document_details_fields"
     data-id-switcher-target="documentFields"
     class="mb-3">
  <h6 style="font-family: 'Montserrat', sans-serif; font-size: 0.82rem; font-weight: 600; color: var(--primary);"
      class="mb-3">
    <i class="ri-file-text-line me-1"></i> <%= t("citizen_portal.submission.id_upload.document_details") %>
  </h6>
  <div class="row g-3">
    <div class="col-12 col-md-4">
      <%= f.input :document_number,
            required: true,
            label: t("citizen_portal.submission.id_upload.document_number"),
            placeholder: "Ex: 1234567890",
            input_html: {
              class: "form-control form-control-lg",
              id: "document_number_input",
              maxlength: 20,
              autocomplete: "off"
            },
            hint: t("citizen_portal.submission.id_upload.document_number_hint"),
            label_html: { class: "form-label fw-semibold", id: "document_number_label" } %>
    </div>
    <div class="col-12 col-md-4">
      <%= f.input :document_issue_date,
            as: :string,
            required: true,
            label: t("citizen_portal.submission.id_upload.issue_date"),
            input_html: { class: "form-control form-control-lg", type: "date", max: Date.current.iso8601 },
            label_html: { class: "form-label fw-semibold" } %>
    </div>
    <div class="col-12 col-md-4">
      <%= f.input :document_expiry_date,
            as: :string,
            required: true,
            label: t("citizen_portal.submission.id_upload.expiry_date"),
            input_html: { class: "form-control form-control-lg", type: "date", min: Date.current.iso8601 },
            label_html: { class: "form-label fw-semibold" } %>
    </div>
  </div>
</div>
<% end %>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    var idSelect = document.getElementById("id_type_select");
    var prefilledType = document.querySelector("input[type='hidden'][name='identity_submission[id_type]']");
    var idValue = idSelect ? idSelect.value : (prefilledType ? prefilledType.value : null);

    function updateDocFields() {
      var label = document.getElementById("document_number_label");
      var input = document.getElementById("document_number_input");
      var hint = input ? input.closest(".form-group, .mb-3")?.querySelector(".form-text") : null;
      var val = idSelect ? idSelect.value : idValue;

      if (val === "cin") {
        if (label) label.textContent = "<%= j t("citizen_portal.submission.id_upload.cin_number_label") %> *";
        if (input) { input.placeholder = "Ex: 1234567890"; input.inputMode = "numeric"; input.maxLength = 10; input.style.textTransform = ""; }
        if (hint) hint.textContent = "<%= j t("citizen_portal.submission.id_upload.cin_number_hint") %>";
      } else if (val === "passport") {
        if (label) label.textContent = "<%= j t("citizen_portal.submission.id_upload.passport_number_label") %> *";
        if (input) { input.placeholder = "Ex: AB123456"; input.inputMode = "text"; input.maxLength = 9; input.style.textTransform = "uppercase"; }
        if (hint) hint.textContent = "<%= j t("citizen_portal.submission.id_upload.passport_number_hint") %>";
      }
    }

    if (idSelect) idSelect.addEventListener("change", updateDocFields);
    updateDocFields();
  });
</script>

<%# Supporting document + warnings now live in Step 2 (Dokiman Sipò). %>

<%# ── ID Photo Blob Cache (Layer 1 of 3-Layer Validation) ──
  Caches the ID photo as a DataURL in sessionStorage the MOMENT the user
  selects it in Step 1. This ensures the liveness-detector controller in
  Step 2 can always retrieve it for face comparison, even when:
    - iOS Safari clears file inputs on hidden elements (d-none)
    - The liveness controller connects after the file was already selected
    - DOM state changes between wizard steps
%>
<script>
  (function() {
    function cacheIdPhoto(input) {
      if (!input || !input.files || input.files.length === 0) return;
      var file = input.files[0];
      var reader = new FileReader();
      reader.onload = function() {
        try {
          sessionStorage.setItem("bonid_id_photo_data", reader.result);
          sessionStorage.setItem("bonid_id_photo_name", file.name);
          sessionStorage.setItem("bonid_id_photo_type", file.type);
          console.info("[id-upload] Cached ID photo to sessionStorage:", file.name);
        } catch(e) {
          console.warn("[id-upload] sessionStorage cache failed:", e.message);
        }
      };
      reader.readAsDataURL(file);
    }

    document.addEventListener("DOMContentLoaded", function() {
      var cinInput = document.querySelector("input[name='identity_submission[cin_front]']");
      var passportInput = document.querySelector("input[name='identity_submission[passport]']");

      if (cinInput) {
        cinInput.addEventListener("change", function() { cacheIdPhoto(cinInput); });
      }
      if (passportInput) {
        passportInput.addEventListener("change", function() { cacheIdPhoto(passportInput); });
      }
    });
  })();
</script>
