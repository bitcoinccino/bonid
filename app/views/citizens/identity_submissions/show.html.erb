
<section class="container py-5 content-with-fixed-header" role="main" aria-labelledby="bonid-summary-title">
  <div class="form-container mx-auto">
    <%= render "identity_submissions/shared/header",
               submission: @submission,
               dashboard_path: citizens_identity_submissions_path %>

    <%= render "identity_submissions/shared/main_content",
               submission: @submission,
               role: :citizen,
               dashboard_path: citizens_identity_submissions_path %>
  </div>
</section>


<style>
