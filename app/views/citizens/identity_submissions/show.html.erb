}
.content-with-fixed-header {
  padding-top: 80px;
}
.fixed-header .card {
  margin: 0;
}
@media (max-width: 576px) {
  .fixed-header .card-body {
    flex-wrap: wrap;
    gap: 1rem;
  }
  .fixed-header .flex-shrink-0 {
    min-width: 100px;
  }
  .fixed-header .text-center {
    margin: 0.5rem 0;
  }
  .content-with-fixed-header {
    padding-top: 120px;
  }
}
.modal-body img {
  max-width: 100%;
  object-fit: contain;
}
