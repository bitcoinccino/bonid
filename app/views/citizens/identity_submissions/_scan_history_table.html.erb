<% if submission.qr_scan_logs.any? %>

  <h5 class="fw-bold text-haitian-blue mb-3 d-flex align-items-center gap-2">
    <i class="ri-history-line"></i>
    QR Scan Logs (<%= submission.qr_scan_logs.count %>)
  </h5>

  <div class="table-responsive shadow-sm rounded-3">
    <table class="table table-bordered table-hover table-striped table-sm align-middle mb-0">
      <thead class="table-light text-center">
        <tr>
          <th>#</th>
          <th>IP</th>
          <th>Country</th>
          <th>City</th>
          <th>Region</th>
          <th>ISP</th>
          <th>Device</th>
          <th>Scanned At</th>
          <th>Source</th>
        </tr>
      </thead>

      <tbody>
        <% submission.qr_scan_logs.order(scanned_at: :desc).each_with_index do |scan, index| %>
          <tr class="<%= index.zero? ? 'table-primary' : '' %>">
            <td class="text-center fw-semibold">
              <%= index + 1 %>
              <% if index.zero? %>
                <span class="badge bg-primary ms-1">Last</span>
              <% end %>
            </td>
            <td><%= scan.ip_address %></td>
            <td><%= scan.country || "N/A" %></td>
            <td><%= scan.city || "-" %></td>
            <td><%= scan.region || "-" %></td>
            <td><%= scan.organization || "-" %></td>
            <td><%= extract_browser_name(scan.user_agent) %></td>
            <td><%= scan.scanned_at.strftime("%b %d, %Y %I:%M %p") %></td>
            <td>
              <span class="badge bg-light text-dark border border-primary rounded-pill">
                <%= scan.source&.humanize || "Unknown" %>
              </span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

<% else %>
  <div class="alert alert-secondary text-center py-2 small mb-0">
    <i class="ri-information-line me-1"></i>
    No scan history available for this BonID.
  </div>
<% end %>
