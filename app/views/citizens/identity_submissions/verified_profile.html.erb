<%# Public BonID verification — what anyone sees after scanning a citizen's
    wallet QR or opening a shared link. No login. Shows only what's needed to
    confirm identity: photo, name, status, masked BonID, dates.
    Deliberately NOT shown: date of birth, address, full BonID (its P####
    segment is the last 4 CIN digits), signature, internal codes. %>
<%
  status = @verification_status
  user   = @submission.user
  show_person = %i[valid expired].include?(status)

  # Same mask as the wallet card: initials + last 6 characters (lookup suffix),
  # e.g. DL-****-*-**-697C56.
  bonid_stripped = user&.bonid.to_s.delete("-")
  masked_bonid = bonid_stripped.length >= 8 ? "#{bonid_stripped[0..1]}-****-*-**-#{bonid_stripped.last(6)}" : "****"

  fmt = ->(t) { t&.strftime("%d/%m/%Y") }

  photo =
    if @submission.selfie.attached?
      @submission.selfie.variant(resize_to_fill: [ 220, 220 ])
    elsif user&.photo&.attached?
      user.photo
    end

  badge_icon = { valid: "ri-checkbox-circle-fill", expired: "ri-time-line",
                 suspended: "ri-forbid-2-line", not_valid: "ri-close-circle-fill" }[status]
%>

<div class="pv-wrap">
  <div class="pv-card pv-card--<%= status %>">

    <div class="pv-status">
      <i class="<%= badge_icon %>" aria-hidden="true"></i>
      <span><%= t("main.public_verify.badge.#{status}") %></span>
    </div>

    <% if show_person %>
      <div class="pv-person">
        <% if photo %>
          <%= image_tag photo, class: "pv-photo", alt: t("main.public_verify.photo_alt") %>
        <% else %>
          <div class="pv-photo pv-photo--empty"><i class="ri-user-3-fill"></i></div>
        <% end %>

        <h1 class="pv-name"><%= [ user.first_name, user.last_name ].compact.join(" ") %></h1>
        <p class="pv-bonid">BonID <span><%= masked_bonid %></span></p>
      </div>

      <p class="pv-message"><%= t("main.public_verify.message.#{status}", date: fmt.(@submission.expires_at)) %></p>

      <dl class="pv-dates">
        <div>
          <dt><%= t("main.public_verify.verified_on") %></dt>
          <dd><%= fmt.(@submission.verified_at) || "—" %></dd>
        </div>
        <div>
          <dt><%= t(status == :expired ? "main.public_verify.expired_on" : "main.public_verify.valid_until") %></dt>
          <dd><%= fmt.(@submission.expires_at) || "—" %></dd>
        </div>
      </dl>

      <% if status == :valid %>
        <div class="pv-tip">
          <i class="ri-eye-line" aria-hidden="true"></i>
          <span><%= t("main.public_verify.photo_check") %></span>
        </div>
      <% end %>
    <% else %>
      <p class="pv-message"><%= t("main.public_verify.message.#{status}") %></p>
    <% end %>

    <p class="pv-meta">
      <%= t("main.public_verify.checked_at", time: Time.current.strftime("%d/%m/%Y %H:%M")) %>
    </p>
  </div>

  <p class="pv-privacy">
    <i class="ri-lock-line" aria-hidden="true"></i>
    <%= t("main.public_verify.privacy_note") %>
  </p>
</div>

<style>
  .pv-wrap { max-width: 440px; margin: 2rem auto; padding: 0 16px; font-family: 'Inter', sans-serif; }
  .pv-card {
    background: #fff; border-radius: 20px; padding: 28px 24px 22px; text-align: center;
    border: 1px solid #E2E8F0; box-shadow: 0 14px 40px rgba(0, 32, 159, 0.10);
    border-top: 6px solid var(--pv-accent);
  }
  .pv-card--valid     { --pv-accent: #15803D; --pv-soft: #DCFCE7; }
  .pv-card--expired   { --pv-accent: #B45309; --pv-soft: #FEF3C7; }
  .pv-card--suspended,
  .pv-card--not_valid { --pv-accent: #B91C1C; --pv-soft: #FEE2E2; }

  .pv-status {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 18px; border-radius: 999px;
    background: var(--pv-soft); color: var(--pv-accent);
    font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 1.1rem;
  }
  .pv-status i { font-size: 1.4rem; }

  .pv-person { margin-top: 22px; }
  .pv-photo {
    width: 140px; height: 140px; border-radius: 50%; object-fit: cover; object-position: center top;
    border: 4px solid #fff; box-shadow: 0 0 0 3px var(--pv-accent); display: block; margin: 0 auto;
  }
  .pv-photo--empty { display: flex; align-items: center; justify-content: center; background: #F1F5F9; color: #94A3B8; font-size: 3rem; }
  .pv-name { font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 1.5rem; color: #0F172A; margin: 16px 0 4px; }
  .pv-bonid { color: #64748B; font-size: 0.9rem; margin: 0; }
  .pv-bonid span { font-family: ui-monospace, monospace; color: #00209F; font-weight: 600; letter-spacing: 0.04em; }

  .pv-message { color: #334155; margin: 18px 0 0; line-height: 1.5; }

  .pv-dates { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 20px 0 0; }
  .pv-dates div { background: #F8FAFC; border-radius: 12px; padding: 10px; }
  .pv-dates dt { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: #64748B; font-weight: 600; }
  .pv-dates dd { margin: 2px 0 0; font-weight: 700; color: #0F172A; }

  .pv-tip {
    display: flex; gap: 8px; align-items: flex-start; text-align: left;
    margin-top: 16px; padding: 10px 12px; border-radius: 10px;
    background: #EFF6FF; color: #1E3A8A; font-size: 0.85rem;
  }
  .pv-tip i { font-size: 1.05rem; line-height: 1.3; }

  .pv-meta { margin: 18px 0 0; font-size: 0.75rem; color: #94A3B8; }
  .pv-privacy { text-align: center; color: #64748B; font-size: 0.8rem; margin: 14px 8px 0; }
</style>
