<div class="container py-5">

  <%# --- Page Header --- %>
  <header class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
    <div>
      <h2 class="h3 fw-bold text-haitian-blue mb-1">
        <i class="ri-shield-keyhole-line me-2"></i>Security & Scan History
      </h2>
      <p class="text-muted small mb-0">
        Monitor every time your digital identity is accessed or verified.
      </p>
    </div>
  </header>

  <% if @submissions.any? { |s| s.qr_scan_logs.exists? } %>
    <% @submissions.each do |submission| %>
      <% logs = submission.qr_scan_logs.order(scanned_at: :desc) %>
      <% next if logs.empty? %>

      <div class="card border-0 shadow-sm rounded-4 mb-5 overflow-hidden bg-white">
        <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center">
            <div class="bg-primary rounded-circle p-2 me-3 text-white">
              <i class="ri-fingerprint-line fs-4"></i>
            </div>
            <div>
              <label class="text-muted small fw-bold text-uppercase mb-0" style="font-size: 0.65rem; letter-spacing: 1px;">Digital Identity</label>
              <span class="fw-bold text-dark d-block"><%= submission.user.bonid %></span>
            </div>
          </div>
          <div class="text-end">
            <span class="h4 fw-bold text-primary mb-0"><%= logs.count %></span>
            <small class="text-muted d-block fw-bold" style="font-size: 0.65rem;">TOTAL SCANS</small>
          </div>
        </div>

        <div class="card-body p-0">
          <div class="list-group list-group-flush">
            <% logs.each_with_index do |scan, index| %>
              <div class="list-group-item p-4 border-0 <%= 'bg-light' if index.zero? %>" style="border-left: 4px solid <%= index.zero? ? 'var(--primary)' : 'transparent' %> !important;">
                <div class="row align-items-center g-3">
                  
                  <%# Icon based on Source %>
                  <div class="col-auto">
                    <div class="rounded-circle bg-white shadow-sm d-flex align-items-center justify-content-center border" style="width: 48px; height: 48px;">
                      <i class="fs-4 <%= index.zero? ? 'text-primary' : 'text-muted' %> 
                        <%= case scan.source
                            when 'officer_scan' then 'ri-police-car-line'
                            when 'partner_scan' then 'ri-bank-line'
                            else 'ri-qr-scan-2-line'
                            end %>"></i>
                    </div>
                  </div>

                  <%# Info %>
                  <div class="col">
                    <div class="d-flex justify-content-between align-items-start">
                      <div>
                        <h6 class="fw-bold mb-1 text-dark">
                          <%= scan.organization.presence || "Verification Point" %>
                          <% if index.zero? %>
                            <span class="badge bg-primary rounded-pill ms-2 small" style="font-size: 0.6rem;">LATEST</span>
                          <% end %>
                        </h6>
                        <p class="text-muted small mb-0">
                          <i class="ri-map-pin-2-line me-1"></i>
                          <%= [scan.city, scan.country].select(&:present?).join(", ") %> 
                          <span class="mx-2 opacity-25">|</span>
                          <i class="ri-global-line me-1"></i><%= scan.ip_address.to_s.sub(/\.\d+$/, ".***") %>
                        </p>
                      </div>
                      <div class="text-end">
                        <time class="small fw-bold text-dark d-block"><%= scan.scanned_at.strftime("%I:%M %p") %></time>
                        <time class="small text-muted d-block"><%= scan.scanned_at.strftime("%b %d, %Y") %></time>
                      </div>
                    </div>
                  </div>

                  <%# Badges %>
                  <div class="col-12 col-md-auto text-end">
                    <span class="badge rounded-pill bg-white border text-dark px-3 py-2 small me-2">
                      <i class="ri-smartphone-line me-1 text-primary"></i> <%= extract_browser_name(scan.user_agent) %>
                    </span>
                    <span class="badge rounded-pill px-3 py-2 small fw-bold 
                      <%= case scan.source
                          when 'officer_scan' then 'bg-danger text-white'
                          when 'partner_scan' then 'bg-success text-white'
                          else 'bg-info text-white'
                          end %>">
                      <%= scan.source&.humanize || "Scan" %>
                    </span>
                  </div>

                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

  <% else %>
    <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-4 bg-white">
      <i class="ri-radar-line display-4 text-light mb-3"></i>
      <h4 class="fw-bold">No activity detected</h4>
      <p class="text-muted mb-0">Your BonID activity will appear here in real-time.</p>
    </div>
  <% end %>

</div>

<style>
  .ls-1 { letter-spacing: 1px; font-size: 0.65rem; }
  .text-silver { color: #cbd5e1; }
  .bg-primary-light-subtle { background-color: rgba(0, 32, 159, 0.02); }
  
  .list-group-item {
    transition: background-color 0.2s ease;
  }
  
  /* Vertical indicator on desktop for the latest scan */
  @media (min-width: 992px) {
    .border-start-lg-4 {
      border-left: 4px solid transparent !important;
    }
  }

  .scan-icon-wrapper i {
    transition: transform 0.3s ease;
  }
  
  .list-group-item:hover .scan-icon-wrapper i {
    transform: scale(1.1);
  }

  /* Status Colors */
  .bg-success-subtle { background: #E6F4E8; color: #1A936F; }
  .bg-warning-subtle { background: #FEF6E6; color: #EDB95E; }
  .bg-danger-subtle { background: #FCE7EA; color: #E53E3E; }
  .bg-info-subtle { background: #E0F2FE; color: #00209F; }
</style>
