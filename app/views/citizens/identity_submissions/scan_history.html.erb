<div class="ballot-wrap px-0" style="padding-bottom: 0;">

  <%# ── Page Header (wizard style — matches Anrejistre / Kalandriye / Aktivite) ── %>
  <div class="ballot-head text-center">
    <h1 class="ballot-title">
      <i class="ri-shield-keyhole-line me-2"></i>Security & Scan History
    </h1>
    <p class="ballot-subtitle mb-0">
      Monitor every time your digital identity is accessed or verified.
    </p>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-9">

  <% if @submissions.any? { |s| s.qr_scan_logs.exists? } %>
    <% @submissions.each do |submission| %>
      <% logs = submission.qr_scan_logs.order(scanned_at: :desc) %>
      <% next if logs.empty? %>

      <div class="scan-history-card mb-4">
        <%# ── Summary header ── %>
        <div class="scan-history-card-header">
          <div class="scan-history-card-header-left">
            <div class="scan-history-card-header-icon">
              <i class="ri-fingerprint-line"></i>
            </div>
            <div class="scan-history-card-header-bonid"><%= submission.user.bonid %></div>
          </div>
          <div class="scan-history-card-header-right">
            <span class="scan-history-card-header-count"><%= logs.count %></span>
            <span class="scan-history-card-header-label">scans</span>
          </div>
        </div>

        <%# ── Scan log list ── %>
        <ul class="scan-log-list">
          <% logs.each_with_index do |scan, index| %>
            <% scan_icon = case scan.source
                           when 'officer_scan' then 'ri-police-car-line'
                           when 'partner_scan' then 'ri-bank-line'
                           else 'ri-qr-scan-2-line'
                           end %>
            <% source_color = case scan.source
                              when 'officer_scan' then 'danger'
                              when 'partner_scan' then 'success'
                              else 'info'
                              end %>
            <% location = [scan.city, scan.country].select(&:present?).join(", ") %>

            <li class="scan-log-item <%= 'scan-log-item--latest' if index.zero? %>">
              <div class="scan-log-icon">
                <i class="<%= scan_icon %> <%= index.zero? ? 'text-primary' : 'text-muted' %>"></i>
              </div>
              <div class="scan-log-body">
                <div class="scan-log-title">
                  <%= scan.organization.presence || "Verification Point" %>
                  <% if index.zero? %>
                    <span class="badge bg-primary rounded-pill ms-1" style="font-size: 0.55rem; vertical-align: middle;">NEW</span>
                  <% end %>
                </div>
                <div class="scan-log-meta">
                  <% if location.present? %>
                    <i class="ri-map-pin-2-line me-1"></i><%= location %>
                  <% end %>
                  <span class="badge bg-<%= source_color %> rounded-pill ms-1" style="font-size: 0.58rem; font-weight: 600;"><%= scan.source&.humanize || "Scan" %></span>
                </div>
              </div>
              <div class="scan-log-time">
                <div class="scan-log-time-hour"><%= scan.scanned_at.strftime("%I:%M %p") %></div>
                <div class="scan-log-time-date"><%= scan.scanned_at.strftime("%b %d, %Y") %></div>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

  <% else %>
    <div class="scan-history-card">
      <div class="scan-empty">
        <i class="ri-radar-line scan-empty-icon"></i>
        <h5 class="fw-bold">No activity detected</h5>
        <p class="text-muted mb-0" style="font-size: 0.82rem;">Your BonID activity will appear here in real-time.</p>
      </div>
    </div>
  <% end %>

    </div>
  </div>

</div>
