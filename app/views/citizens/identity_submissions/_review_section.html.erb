<%# STEP 5 — Review & Confirm.
    Same layout as the profile review: section title + "Modifier" on one
    line, then label-over-value cells. Sections follow the wizard order
    (1 ID, 2 proof of address, 3 face, 4 signature) and each "Modifier"
    jumps to its own step. The server renders a fallback; JS
    (submission_review_controller) refreshes it from the live form. %>

<% id_type_label = { "cin" => "CIN", "passport" => t("citizen_portal.submission.review.passport") }[submission.id_type.to_s] || submission.id_type.to_s.titleize %>
<% uploaded = capture do %><span class="text-success"><i class="ri-checkbox-circle-line me-1"></i><%= t("citizen_portal.submission.review.uploaded") %></span><% end %>
<% todo = ->(key) { tag.span(t("citizen_portal.submission.review.#{key}"), class: "review-todo") } %>
<% cell = ->(label_key, value_html) do %>
  <div class="review-item">
    <span class="review-label"><%= t("citizen_portal.submission.review.#{label_key}") %></span>
    <span class="review-value"><%= value_html %></span>
  </div>
<% end %>
<% edit_btn = ->(step) do %>
  <button type="button" class="review-edit" data-action="click->wizard#goToStep" data-step="<%= step %>">
    <i class="ri-pencil-line" aria-hidden="true"></i><%= t("citizen_portal.profile.review.edit") %>
  </button>
<% end %>
<% reused_pill = ->(key) { tag.span(class: "review-reused") { safe_join([ tag.i(class: "ri-checkbox-circle-line", "aria-hidden": true), t("citizen_portal.submission.review.#{key}") ]) } } %>

<%# ── 1. Government ID ── %>
<div class="review-block">
  <div class="review-head">
    <h3 class="review-head__title"><i class="ri-id-card-line" aria-hidden="true"></i><%= t("citizen_portal.submission.review.gov_id") %></h3>
    <%= edit_btn.(1) %>
  </div>
  <div data-submission-review-target="reviewId" class="review-grid">
    <%= cell.("id_type", id_type_label.presence || todo.("select_file_step1")) %>
    <% if submission.id_type.to_s == "cin" %>
      <%= cell.("cin_front", submission.persisted? && submission.cin_front.attached? ? uploaded : todo.("select_file_step1")) %>
      <%= cell.("cin_back",  submission.persisted? && submission.cin_back.attached?  ? uploaded : todo.("select_file_step1")) %>
    <% else %>
      <%= cell.("passport", submission.persisted? && submission.passport.attached? ? uploaded : todo.("select_file_step1")) %>
    <% end %>
  </div>
</div>

<%# ── 2. Proof of address ── %>
<div class="review-block">
  <div class="review-head">
    <h3 class="review-head__title"><i class="ri-folder-3-line" aria-hidden="true"></i><%= t("citizen_portal.submission.review.supporting_section") %></h3>
    <%= edit_btn.(2) %>
  </div>
  <div data-submission-review-target="reviewSupporting" class="review-grid">
    <%= cell.("document_type", todo.("select_in_step2")) %>
    <%= cell.("file", todo.("select_in_step2")) %>
  </div>
</div>

<%# ── 3. Face check ── %>
<div class="review-block">
  <div class="review-head">
    <h3 class="review-head__title"><i class="ri-shield-check-line" aria-hidden="true"></i><%= t("citizen_portal.submission.review.face_section") %></h3>
    <%= @skip_liveness ? reused_pill.("verified_reused") : edit_btn.(3) %>
  </div>
  <div data-submission-review-target="reviewSelfie" class="review-grid">
    <% if @skip_liveness %>
      <p class="review-note mb-0" data-reused="true"><%= t("citizen_portal.submission.review.face_carried") %></p>
    <% else %>
      <%= cell.("face_liveness", todo.("complete_in_step3")) %>
    <% end %>
  </div>
</div>

<%# ── 4. Signature ── %>
<div class="review-block">
  <div class="review-head">
    <h3 class="review-head__title"><i class="ri-ball-pen-line" aria-hidden="true"></i><%= t("citizen_portal.submission.review.signature") %></h3>
    <%= @skip_signature ? reused_pill.("on_file_reused") : edit_btn.(4) %>
  </div>
  <div data-submission-review-target="reviewSignature" class="review-grid">
    <% if @skip_signature %>
      <p class="review-note mb-0" data-reused="true"><%= t("citizen_portal.submission.review.signature_carried") %></p>
    <% else %>
      <%= cell.("signature", todo.("provide_in_step4")) %>
    <% end %>
  </div>
</div>

<%# ── Confirmation ── %>
<div class="review-confirm">
  <div class="form-check mb-0">
    <input type="checkbox" class="form-check-input" id="submission_confirmation"
           data-submission-review-target="confirmCheckbox"
           data-action="change->submission-review#toggleSubmit"
           required>
    <label class="form-check-label" for="submission_confirmation">
      <%= t("citizen_portal.submission.review.confirm_html") %>
    </label>
  </div>
</div>
