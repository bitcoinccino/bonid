<%# STEP 4 — Review & Confirm %>
<%# Server renders fallback content; JS overwrites with live form data when available %>

<% id_type_label = { "cin" => "CIN", "passport" => t("citizen_portal.submission.review.passport") }[submission.id_type.to_s] || submission.id_type.to_s.titleize %>

<%# ── Section 1: Government ID ── %>
<div class="mb-3 p-3 rounded-3" style="border: 1px solid #e4e7ec;">
  <div class="d-flex justify-content-between align-items-center mb-2">
    <h6 style="font-size: 0.82rem; font-weight: 600; color: var(--primary); margin: 0;">
      <i class="ri-id-card-line me-1"></i><%= t("citizen_portal.submission.review.gov_id") %>
    </h6>
    <button type="button" class="btn btn-sm btn-outline-primary" style="font-size: 0.72rem;"
            data-action="click->wizard#goToStep" data-step="1">
      <i class="ri-edit-line me-1"></i><%= t("citizen_portal.profile.review.edit") %>
    </button>
  </div>
  <div data-submission-review-target="reviewId" style="color: #344054;">
    <%# Server-side fallback (JS overwrites on normal flow) %>
    <div class="row g-2" style="font-size:0.82rem;">
      <div class="col-12"><strong><%= t("citizen_portal.submission.review.id_type") %>:</strong> <%= id_type_label.presence || "—" %></div>
      <% if submission.id_type.to_s == "cin" %>
        <div class="col-sm-6"><strong><%= t("citizen_portal.submission.review.cin_front") %>:</strong>
          <% if submission.persisted? && submission.cin_front.attached? %>
            <span class="text-success"><i class="ri-checkbox-circle-line me-1"></i><%= t("citizen_portal.submission.review.uploaded") %></span>
          <% else %>
            <span class="text-muted"><%= t("citizen_portal.submission.review.select_file_step1") %></span>
          <% end %>
        </div>
        <div class="col-sm-6"><strong><%= t("citizen_portal.submission.review.cin_back") %>:</strong>
          <% if submission.persisted? && submission.cin_back.attached? %>
            <span class="text-success"><i class="ri-checkbox-circle-line me-1"></i><%= t("citizen_portal.submission.review.uploaded") %></span>
          <% else %>
            <span class="text-muted"><%= t("citizen_portal.submission.review.select_file_step1") %></span>
          <% end %>
        </div>
      <% else %>
        <div class="col-sm-6"><strong><%= t("citizen_portal.submission.review.passport") %>:</strong>
          <% if submission.persisted? && submission.passport.attached? %>
            <span class="text-success"><i class="ri-checkbox-circle-line me-1"></i><%= t("citizen_portal.submission.review.uploaded") %></span>
          <% else %>
            <span class="text-muted"><%= t("citizen_portal.submission.review.select_file_step1") %></span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%# ── Section 2: Live Selfie ── %>
<div class="mb-3 p-3 rounded-3" style="border: 1px solid #e4e7ec;">
  <div class="d-flex justify-content-between align-items-center mb-2">
    <h6 style="font-size: 0.82rem; font-weight: 600; color: var(--primary); margin: 0;">
      <i class="ri-shield-check-line me-1"></i><%= t("citizen_portal.submission.review.face_section") %>
    </h6>
    <% if @skip_liveness %>
      <span class="badge rounded-pill px-3 py-1" style="background: #e8f5e9; color: #198754; font-size: 0.72rem; font-weight: 600;">
        <i class="ri-checkbox-circle-line me-1"></i><%= t("citizen_portal.submission.review.verified_reused") %>
      </span>
    <% else %>
      <button type="button" class="btn btn-sm btn-outline-primary" style="font-size: 0.72rem;"
              data-action="click->wizard#goToStep" data-step="2">
        <i class="ri-edit-line me-1"></i><%= t("citizen_portal.profile.review.edit") %>
      </button>
    <% end %>
  </div>
  <div data-submission-review-target="reviewSelfie" style="color: #344054;">
    <% if @skip_liveness %>
      <p class="mb-0 small text-muted" data-reused="true">
        <i class="ri-information-line me-1"></i>
        <%= t("citizen_portal.submission.review.face_carried") %>
      </p>
    <% else %>
      <%# Server-side fallback %>
      <div style="font-size:0.82rem;">
        <strong><%= t("citizen_portal.submission.review.face_liveness") %>:</strong>
        <span class="text-muted"><i class="ri-information-line me-1"></i><%= t("citizen_portal.submission.review.complete_in_step2") %></span>
      </div>
    <% end %>
  </div>
</div>

<%# ── Section 3: Supporting Document ── %>
<div class="mb-3 p-3 rounded-3" style="border: 1px solid #e4e7ec;">
  <div class="d-flex justify-content-between align-items-center mb-2">
    <h6 style="font-size: 0.82rem; font-weight: 600; color: var(--primary); margin: 0;">
      <i class="ri-folder-3-line me-1"></i><%= t("citizen_portal.submission.review.supporting_section") %>
    </h6>
    <button type="button" class="btn btn-sm btn-outline-primary" style="font-size: 0.72rem;"
            data-action="click->wizard#goToStep" data-step="1">
      <i class="ri-edit-line me-1"></i><%= t("citizen_portal.profile.review.edit") %>
    </button>
  </div>
  <div data-submission-review-target="reviewSupporting" style="color: #344054;">
    <%# Server-side fallback %>
    <div class="row g-2" style="font-size:0.82rem;">
      <div class="col-sm-6"><strong><%= t("citizen_portal.submission.review.document_type") %>:</strong> <span class="text-muted"><%= t("citizen_portal.submission.review.select_in_step1") %></span></div>
      <div class="col-sm-6"><strong><%= t("citizen_portal.submission.review.file") %>:</strong> <span class="text-muted"><%= t("citizen_portal.submission.review.select_file_step1") %></span></div>
    </div>
  </div>
</div>

<%# ── Section 4: Signature ── %>
<div class="mb-3 p-3 rounded-3" style="border: 1px solid #e4e7ec;">
  <div class="d-flex justify-content-between align-items-center mb-2">
    <h6 style="font-size: 0.82rem; font-weight: 600; color: var(--primary); margin: 0;">
      <i class="ri-ball-pen-line me-1"></i><%= t("citizen_portal.submission.review.signature") %>
    </h6>
    <% if @skip_signature %>
      <span class="badge rounded-pill px-3 py-1" style="background: #e8f5e9; color: #198754; font-size: 0.72rem; font-weight: 600;">
        <i class="ri-checkbox-circle-line me-1"></i><%= t("citizen_portal.submission.review.on_file_reused") %>
      </span>
    <% else %>
      <button type="button" class="btn btn-sm btn-outline-primary" style="font-size: 0.72rem;"
              data-action="click->wizard#goToStep" data-step="3">
        <i class="ri-edit-line me-1"></i><%= t("citizen_portal.profile.review.edit") %>
      </button>
    <% end %>
  </div>
  <div data-submission-review-target="reviewSignature" style="color: #344054;">
    <% if @skip_signature %>
      <p class="mb-0 small text-muted" data-reused="true">
        <i class="ri-information-line me-1"></i>
        <%= t("citizen_portal.submission.review.signature_carried") %>
      </p>
    <% else %>
      <%# Server-side fallback %>
      <div style="font-size:0.82rem;">
        <strong><%= t("citizen_portal.submission.review.signature") %>:</strong>
        <span class="text-muted"><i class="ri-information-line me-1"></i><%= t("citizen_portal.submission.review.provide_in_step3") %></span>
      </div>
    <% end %>
  </div>
</div>

<%# ── Confirmation Checkbox ── %>
<div class="mt-4 p-3 rounded-3" style="background: #f8f9fc; border: 1px solid #e4e7ec;">
  <div class="d-flex gap-3 align-items-start">
    <i class="ri-shield-check-line flex-shrink-0" style="font-size: 1.3rem; color: var(--primary); margin-top: 2px;"></i>
    <div>
      <div class="form-check">
        <input type="checkbox" class="form-check-input" id="submission_confirmation"
               data-submission-review-target="confirmCheckbox"
               data-action="change->submission-review#toggleSubmit"
               required>
        <label class="form-check-label" for="submission_confirmation"
               style="font-size: 0.78rem; color: #344054; line-height: 1.6;">
          <%= t("citizen_portal.submission.review.confirm_html") %>
        </label>
      </div>
    </div>
  </div>
</div>
