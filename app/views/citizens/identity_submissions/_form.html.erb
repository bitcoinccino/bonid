<%
submission      = @identity_submission
is_resubmission = submission.submission_type.to_s == "resubmission"
is_edit         = submission.persisted?
%>

<%# Load the React liveness bundle (separate from main app bundle) %>
<%= stylesheet_link_tag "liveness", media: "all" %>
<%= javascript_include_tag "liveness", type: "module", defer: true %>

<%# Header chrome matches the Anrejistre wizard (.ballot-wrap / .ballot-head)
    so verification reads as one continuous wizard with the rest of the
    citizen flow. The page title lives inside Step 1 so it disappears once
    the citizen advances past the first panel. %>
<div class="ballot-wrap px-0" style="padding-bottom: 0;">

  <div class="complaint-form-wrapper">
    <%= simple_form_for [:citizens, submission],
        html: { class: "needs-validation", novalidate: true, multipart: true,
                data: { controller: "wizard submission-review form-handler wizard-persistence",
                        submission_review_labels_value: %w[id_type cin_front cin_back passport face_liveness verified not_completed
                                                           document_type file signature drawn not_provided previously_uploaded not_uploaded]
                                                          .index_with { |k| t("citizen_portal.submission.review.#{k}") }.to_json,
                        wizard_current_step_value: "1",
                        wizard_persistence_key_value: "identity-submission",
                        wizard_skip_steps_value: [].tap { |s|
                          # Step indices reflect the 5-step wizard:
                          #   1 = Documents, 2 = Dokiman Sipò, 3 = Face Check,
                          #   4 = Signature, 5 = Review.
                          s << 3 if @skip_liveness
                          s << 4 if @skip_signature
                        }.to_json,
                        action: "wizard:stepChanged->submission-review#onStepChanged submit->wizard#beforeSubmit submit->wizard-persistence#clear submit->wizard#clear" } } do |f| %>

      <%# ── Step Indicator ── %>
      <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2" style="max-width: 600px; margin: 0 auto;">
          <% submission_steps = [
            { icon: "ri-id-card-line",        label: t("citizen_portal.submission.steps.documents") },
            { icon: "ri-file-list-3-line",    label: t("citizen_portal.submission.steps.supporting") },
            { icon: "ri-emotion-happy-line",  label: t("citizen_portal.submission.steps.face") },
            { icon: "ri-quill-pen-line",      label: t("citizen_portal.submission.steps.signature") },
            { icon: "ri-checkbox-circle-line", label: t("citizen_portal.submission.steps.review") }
          ] %>
          <% submission_steps.each_with_index do |step, i| %>
            <div data-wizard-target="stepIndicator" class="text-center" style="flex: 1;">
              <div class="step-circle mx-auto d-flex align-items-center justify-content-center rounded-circle <%= 'active' if i == 0 %>">
                <i class="<%= step[:icon] %>" style="font-size: 0.9rem;"></i>
              </div>
              <div style="font-size: 0.62rem; color: #98a2b3; margin-top: 4px; font-weight: 500;">
                <%= step[:label] %>
              </div>
            </div>
          <% end %>
        </div>
        <div style="height: 4px; background: #e4e7ec; border-radius: 4px; max-width: 600px; margin: 0 auto;">
          <div data-wizard-target="progressBar"
               style="height: 100%; width: 0%; background: linear-gradient(90deg, var(--primary), #1a4fa8);
                      border-radius: 4px; transition: width 0.4s ease;">
          </div>
        </div>
      </div>

      <%# Step-specific alerts have moved INSIDE each step <section> below
          (just above the .ballot-section card) so they sit next to the
          actual upload action instead of at the top of the page. The
          wizard's stepAlertTargets.forEach loop becomes harmless when
          no targets are present at the form-level. %>

      <%# Preserve submission_type so create knows initial vs resubmission %>
      <%= f.hidden_field :submission_type, value: submission.submission_type %>

      <%# ══════════ STEP 1 ══════════ %>
      <section data-wizard-target="step" data-step="1" class="wizard-step active">
        <%# Page header lives inside step 1 only — wizard hides this section
            on advance so "Verify Your Identity" disappears past the first panel. %>
        <div class="ballot-head text-center">
          <h1 class="ballot-title">
            <i class="ri-shield-user-line me-2"></i><%= t("citizen_portal.submission.title") %>
          </h1>
          <p class="ballot-subtitle mb-0">
            <%= t("citizen_portal.submission.subtitle") %>
          </p>
        </div>

        <%# One short, calm note for the whole flow (the per-step yellow
            "Important" boxes repeated each section's own description). %>
        <div class="pf-lock-note mb-3">
          <i class="ri-information-line" aria-hidden="true"></i>
          <span><%= t("citizen_portal.submission.important_match_html") %></span>
        </div>

        <div class="ballot-section card border-0 shadow-sm mb-4">
          <div class="card-body p-4">

            <div class="ballot-section-head mb-4">
              <h2 class="ballot-section-title"><%= t("citizen_portal.submission.gov_id_title") %></h2>
              <p class="ballot-section-desc mb-0">
                <%= t("citizen_portal.submission.gov_id_desc") %>
              </p>
            </div>

            <div data-controller="id-switcher">
              <%= render "citizens/identity_submissions/id_upload_section", f: f, submission: submission %>
            </div>
          </div>
        </div>

        <div class="d-flex justify-content-end profile-wizard-nav">
          <button type="button" class="btn btn-primary fw-semibold px-4 py-2"
                  style="font-size: 0.85rem;"
                  data-action="wizard#next">
            <%= t("citizen_portal.profile.continue") %> <i class="ri-arrow-right-line ms-1"></i>
          </button>
        </div>
      </section>

      <%# ══════════ STEP 2 — Dokiman Sipò ══════════ %>
      <section data-wizard-target="step" data-step="2" class="wizard-step d-none" style="display:none">
        <div class="ballot-section card border-0 shadow-sm mb-4">
          <div class="card-body p-4">

            <div class="ballot-section-head mb-4">
              <h2 class="ballot-section-title"><%= t("citizen_portal.submission.supporting_title") %></h2>
              <p class="ballot-section-desc mb-0">
                <% if current_citizen.is_diaspora %>
                  <%= t("citizen_portal.submission.supporting_desc_diaspora") %>
                <% else %>
                  <%= t("citizen_portal.submission.supporting_desc") %>
                <% end %>
              </p>
            </div>

            <%= render "citizens/identity_submissions/proof_documents_section",
                  f: f, submission: submission %>
          </div>
        </div>

        <div class="d-flex justify-content-between profile-wizard-nav">
          <button type="button" class="btn btn-outline-secondary fw-semibold px-4 py-2"
                  style="font-size: 0.85rem;"
                  data-action="wizard#previous">
            <i class="ri-arrow-left-line me-1"></i> <%= t("citizen_portal.profile.back") %>
          </button>
          <button type="button" class="btn btn-primary fw-semibold px-4 py-2"
                  style="font-size: 0.85rem;"
                  data-action="wizard#next">
            <%= t("citizen_portal.profile.continue") %> <i class="ri-arrow-right-line ms-1"></i>
          </button>
        </div>
      </section>

      <%# ══════════ STEP 3 — Face Check ══════════ %>
      <section data-wizard-target="step" data-step="3" class="wizard-step d-none" style="display:none">
        <div class="ballot-section card border-0 shadow-sm mb-4">
          <div class="card-body p-4">

            <div class="ballot-section-head mb-4">
              <%# Always-visible way back: the liveness box fills the viewport,
                  pushing the bottom Back button off screen on phones. %>
              <button type="button" class="btn btn-link p-0 mb-2 text-decoration-none small"
                      data-action="wizard#previous">
                <i class="ri-arrow-left-line me-1"></i> <%= t("citizen_portal.profile.back") %>
              </button>
              <h2 class="ballot-section-title"><%= t("citizen_portal.submission.face_title") %></h2>
              <p class="ballot-section-desc mb-0">
                <% if @skip_liveness %>
                  <%= t("citizen_portal.submission.face_reused") %>
                <% else %>
                  <%= t("citizen_portal.submission.face_desc") %>
                <% end %>
              </p>
            </div>

            <%= render "citizens/identity_submissions/additional_documents_section",
                  f: f, submission: submission %>
          </div>
        </div>

        <div class="d-flex justify-content-between profile-wizard-nav">
          <button type="button" class="btn btn-outline-secondary fw-semibold px-4 py-2"
                  style="font-size: 0.85rem;"
                  data-action="wizard#previous">
            <i class="ri-arrow-left-line me-1"></i> <%= t("citizen_portal.profile.back") %>
          </button>
          <button type="button" class="btn btn-primary fw-semibold px-4 py-2"
                  style="font-size: 0.85rem;"
                  data-action="wizard#next">
            <%= t("citizen_portal.submission.next") %> <i class="ri-arrow-right-line ms-1"></i>
          </button>
        </div>
      </section>

      <%# ══════════ STEP 4 — Signature ══════════ %>
      <section data-wizard-target="step" data-step="4" class="wizard-step d-none" style="display:none">
        <div class="ballot-section card border-0 shadow-sm mb-4">
          <div class="card-body p-4">

            <div class="ballot-section-head mb-4">
              <h2 class="ballot-section-title"><%= t("citizen_portal.submission.signature_title") %></h2>
              <p class="ballot-section-desc mb-0">
                <% if @skip_signature %>
                  <%= t("citizen_portal.submission.signature_reused") %>
                <% else %>
                  <%= t("citizen_portal.submission.signature_desc") %>
                <% end %>
              </p>
            </div>

            <%= render "citizens/identity_submissions/signature_submit_section",
                  f: f, submission: submission %>
          </div>
        </div>

        <div class="d-flex justify-content-between align-items-center profile-wizard-nav">
          <button type="button" class="btn btn-outline-secondary fw-semibold px-4 py-2"
                  style="font-size: 0.85rem;"
                  data-action="wizard#previous">
            <i class="ri-arrow-left-line me-1"></i> <%= t("citizen_portal.profile.back") %>
          </button>
          <button type="button" class="btn btn-primary fw-semibold px-4 py-2"
                  style="font-size: 0.85rem;"
                  data-action="wizard#next">
            <%= t("citizen_portal.submission.steps.review") %> <i class="ri-arrow-right-line ms-1"></i>
          </button>
        </div>
      </section>

      <%# ══════════ STEP 5 — Review & Confirm ══════════ %>
      <section data-wizard-target="step" data-step="5" class="wizard-step d-none" style="display:none">
        <div class="ballot-section card border-0 shadow-sm mb-4">
          <div class="card-body p-4">

            <div class="ballot-section-head mb-4">
              <h2 class="ballot-section-title"><%= t("citizen_portal.submission.review_title") %></h2>
              <p class="ballot-section-desc mb-0">
                <%= t("citizen_portal.submission.review_desc") %>
              </p>
            </div>

            <%= render "citizens/identity_submissions/review_section", submission: submission %>
          </div>
        </div>

        <div class="d-flex justify-content-between align-items-center profile-wizard-nav">
          <button type="button" class="btn btn-outline-secondary fw-semibold px-4 py-2"
                  style="font-size: 0.85rem;"
                  data-action="wizard#previous">
            <i class="ri-arrow-left-line me-1"></i> <%= t("citizen_portal.profile.back") %>
          </button>

          <%= f.submit (is_edit ? t("citizen_portal.submission.update") : t("citizen_portal.submission.submit")),
              class: "btn btn-success fw-semibold px-4 py-2",
              style: "font-size: 0.85rem;",
              disabled: true,
              data: { disable_with: t("citizen_portal.submission.submitting"),
                      submission_review_target: "submitButton" } %>
        </div>
      </section>

    <% end %>

    <div class="mt-4 text-center small text-muted">
      <i class="ri-lock-2-fill text-success me-2"></i><%= t("citizen_portal.profile.encrypted_footer") %>
    </div>
  </div>
</div>

<%# Reset wizard to Step 1 after server-side validation errors.
    Without this, sessionStorage restores Step 4 but all form data is lost. %>
<% if flash[:alert].present? || (submission.errors.any? rescue false) %>
  <script>
    sessionStorage.removeItem("wizard-step:" + window.location.pathname);
  </script>
<% end %>
