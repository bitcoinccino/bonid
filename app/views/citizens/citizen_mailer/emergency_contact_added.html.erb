<% content_for :title, "You've been added as an Emergency Contact" %>

<div style="font-family:'Inter',Arial,sans-serif; color:#101828;">
  <div style="margin:0 0 10px;">
    <div style="font-family:'Montserrat','Inter',Arial,sans-serif; font-weight:700; font-size:20px; color:#00209F; margin:0;">
      Emergency Contact Notification
    </div>
    <div style="margin-top:6px; font-size:13px; color:#475467; line-height:1.6;">
      Someone has added you as their emergency contact on BonID.
    </div>
  </div>

  <!-- NOTIFICATION CARD -->
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
         style="margin:14px 0 16px; background:#ffffff; border-radius:14px;
                border:1px solid rgba(0,32,159,0.18); overflow:hidden;">
    <tr>
      <td style="padding:14px 14px; background:#f7f9ff;">
        <div style="font-size:12px; letter-spacing:0.6px; color:#344054; text-transform:uppercase;">
          Added By
        </div>
        <div style="margin-top:8px; font-family:'Montserrat',Arial,sans-serif;
                    font-size:18px; font-weight:700; color:#00209F;">
          <%= @added_by.full_name %>
        </div>
        <div style="margin-top:4px; font-size:14px; color:#475467;">
          as their <strong><%= @relation&.titleize || "Emergency Contact" %></strong>
        </div>
      </td>
    </tr>
  </table>

  <div style="font-size:14px; line-height:1.75; color:#101828;">
    <p style="margin:0 0 10px;">
      Dear <strong><%= @contact_user.first_name %></strong>,
    </p>

    <p style="margin:0 0 10px;">
      <strong><%= @added_by.full_name %></strong> has added you as their
      <strong><%= @relation&.titleize || "emergency contact" %></strong> on BonID.
    </p>

    <p style="margin:0 0 10px;">
      As an emergency contact, authorized responders may reach out to you in case of an emergency
      involving <%= @added_by.first_name %>. Your contact information is securely stored and only
      shared with verified emergency responders.
    </p>

    <p style="margin:0 0 10px; padding:12px; background:#fff3cd; border-radius:8px; border-left:4px solid #ffc107;">
      <strong>What this means:</strong><br>
      In an emergency, responders may contact you at the phone number or email associated with your BonID.
    </p>

    <p style="margin:0 0 10px;">
      If you have questions or concerns, please contact
      <a href="mailto:support@verifyem.ht" style="color:#00209F; text-decoration:none; font-weight:600;">support@verifyem.ht</a>.
    </p>

    <p style="margin:14px 0 0; color:#475467;">
      — BonID Security Team
    </p>
  </div>
</div>
