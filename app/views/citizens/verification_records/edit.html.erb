<%# ===============================================================
  BonID — Edit Verification Record (Turbo-Enabled)
  ---------------------------------------------------------------
  ✅ Uses same dynamic form loader as “new”
  ✅ Auto-loads correct partial based on record_type + category
  ✅ SPA-style updates with Turbo Streams
================================================================ %>
<%# ===============================================================
  BonID — Citizen Verification Record Edit Page
  ---------------------------------------------------------------
  ✅ Dynamically loads the proper form partial
  ✅ Maintains Bootstrap styling
================================================================ %>

<div class="px-0">
  <%# ── Page Header ── %>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h3 class="citizen-page-title mb-1">
        <i class="ri-pencil-line me-2"></i>Edit <%= @record.record_type.titleize %> Record
      </h3>
      <p class="text-muted mb-0" style="font-size: 0.78rem;">
        Update your verification record details.
      </p>
    </div>
    <%= link_to citizens_verification_records_path, class: "btn btn-outline-secondary btn-sm rounded-pill px-3" do %>
      <i class="ri-arrow-left-line me-1"></i>
      Back
    <% end %>
  </div>

  <!-- 🧩 Form Loader -->
  <% unless turbo_frame_request? %>
    <%= turbo_frame_tag "record_form_frame" do %>
      <%= render partial: "citizens/verification_records/form",
                 locals: { record: @record } %>
    <% end %>
  <% else %>
    <%= render partial: "citizens/verification_records/form",
               locals: { record: @record } %>
  <% end %>
</div>
