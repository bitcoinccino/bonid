  BonID — Citizen Verification Record Show Page
  ---------------------------------------------------------------
  ✅ Renders correct detail partial per record_type + category
  ✅ Uses Bootstrap cards + Haitian color accents
================================================================ %>

<%# BonID — View Verification Record %>
<%# ===============================================================
  BonID — Citizen Verification Record Show Page
  ---------------------------------------------------------------
  ✅ Dynamically renders correct detail partial based on type + category
  ✅ Uses Bootstrap card layout with Haitian accent colors
  ✅ Safe fallback if no matching partial exists
================================================================ %>
<%# ===============================================================
  BonID — Citizen Verification Record Show Page
  ---------------------------------------------------------------
  ✅ Dynamically loads details partial from subfolders
  ✅ Fallback message if not found
================================================================ %>

<div class="px-0">
  <%# ── Page Header ── %>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h3 class="citizen-page-title mb-1">
        <i class="ri-eye-line me-2"></i>View <%= @record.record_type.titleize %> Record
      </h3>
      <p class="text-muted mb-0" style="font-size: 0.78rem;">
        Record details and verification status.
      </p>
    </div>
    <%= link_to citizens_verification_records_path, class: "btn btn-outline-secondary btn-sm rounded-pill px-3" do %>
      <i class="ri-arrow-left-line me-1"></i>Back to Records
    <% end %>
  </div>

  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
      <% record_type = @record.record_type.to_s.downcase.presence %>
      <% record_category = @record.category.to_s.downcase.presence %>

      <%
        specific_partial = "citizens/verification_records/#{record_type}/#{record_type}_#{record_category}_details" if record_type && record_category
        base_partial     = "citizens/verification_records/#{record_type}/#{record_type}_details" if record_type
      %>

      <% if record_type.present? && specific_partial && lookup_context.exists?(specific_partial, [], true) %>
        <%= render partial: specific_partial, locals: { record: @record } %>
      <% elsif record_type.present? && base_partial && lookup_context.exists?(base_partial, [], true) %>
        <%= render partial: base_partial, locals: { record: @record } %>
      <% else %>
        <div class="alert alert-dismissible fade show alert-warning">
          <i class="ri-alert-line me-2"></i>
          No details template found for <strong><%= @record.record_type %></strong> record.
        </div>
      <% end %>
    </div>
  </div>
</div>
