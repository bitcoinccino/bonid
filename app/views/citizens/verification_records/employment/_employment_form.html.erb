<%= form_with model: record,
              url: form_url,
              data: { turbo_frame: "record_form_frame" },
              html: { class: "p-3" } do |f| %>
  <div class="mb-3">
    <%= f.label :data_position, "Position", class: "form-label fw-semibold" %>
    <%= f.text_field :data_position, class: "form-control rounded-3" %>
  </div>

  <div class="mb-3">
    <%= f.label :data_employer, "Employer", class: "form-label fw-semibold" %>
    <%= f.text_field :data_employer, class: "form-control rounded-3" %>
  </div>

  <div class="text-end">
    <%= f.submit record.persisted? ? "Update Record" : "Create Record",
                 class: "btn btn-primary rounded-3 fw-semibold px-4" %>
  </div>
<% end %>
