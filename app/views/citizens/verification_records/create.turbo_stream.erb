<%= turbo_stream.append "verification_records_table" do %>
  <%= render partial: "citizens/verification_records/shared/table_row", locals: { record: @record } %>
<% end %>

<%= turbo_stream.replace "record_form_frame" do %>
  <div class="alert alert-dismissible fade show alert-success small text-center mb-0 rounded-3">
    <i class="ri-check-double-line me-1"></i>
    ✅ Record created successfully.
  </div>
<% end %>

<%= turbo_stream.replace "flash" do %>
  <%= render partial: "shared/flash", locals: { notice: "✅ Record created successfully." } %>
<% end %>
