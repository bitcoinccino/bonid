<!-- app/views/citizens/verification_records/_education_details.html.erb -->
<div class="border rounded-3 bg-white p-3 shadow-sm small">
  <h6 class="fw-semibold text-primary mb-3">
    <i class="ri-graduation-cap-line me-1"></i>
    Education Record — <%= record.data["institution"] || "Unknown Institution" %>
  </h6>

  <!-- 🎓 Basic Info -->
  <details open>
    <summary class="fw-semibold text-dark mb-2">
      <i class="ri-information-line me-1"></i> Academic Information
    </summary>

    <div class="row mt-2 mb-2">
      <div class="col-md-6 mb-2">
        <p class="mb-1"><strong>Degree:</strong> <%= record.data["degree"] || "N/A" %></p>
        <p class="mb-1"><strong>Major:</strong> <%= record.data["major"] || "N/A" %></p>
        <p class="mb-1"><strong>Minor:</strong> <%= record.data["minor"] || "N/A" %></p>
      </div>

      <div class="col-md-6 mb-2">
        <p class="mb-1"><strong>GPA:</strong> <%= record.data["gpa"] || "N/A" %></p>
        <p class="mb-1"><strong>Graduation Year:</strong> <%= record.data["graduation_year"] || "N/A" %></p>
        <p class="mb-1"><strong>Honors:</strong> <%= record.data["honors"] || "N/A" %></p>
      </div>
    </div>
  </details>

  <!-- 🧑‍🏫 Advisor -->
  <% if record.data["advisor_name"].present? %>
    <hr>
    <details>
      <summary class="fw-semibold text-dark mb-2">
        <i class="ri-user-3-line me-1"></i> Advisor
      </summary>
      <p class="mt-2 mb-1"><strong>Name:</strong> <%= record.data["advisor_name"] %></p>
      <% if record.data["advisor_contact"].present? %>
        <p class="mb-1"><strong>Contact:</strong> <%= record.data["advisor_contact"] %></p>
      <% end %>
    </details>
  <% end %>

  <!-- 📄 Documents -->
  <% if record.data["document_links"].present? && record.data["document_links"].is_a?(Array) %>
    <hr>
    <details>
      <summary class="fw-semibold text-dark mb-2">
        <i class="ri-attachment-2 me-1"></i> Documents
      </summary>
      <ul class="list-unstyled mt-2 mb-0 small">
        <% record.data["document_links"].each do |doc| %>
          <li>
            📎 <%= doc["name"] || "Document" %> —
            <% if doc["url"].present? %>
              <%= link_to "View", doc["url"], target: "_blank", rel: "noopener", class: "text-decoration-none text-primary" %>
            <% else %>
              <span class="text-muted">N/A</span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </details>
  <% end %>

  <!-- 🌍 Additional Info -->
  <hr>
  <details>
    <summary class="fw-semibold text-dark mb-2">
      <i class="ri-calendar-line me-1"></i> Enrollment & Location
    </summary>
    <p class="mt-2 mb-1">
      📅 Enrolled: <%= record.data["enrollment_date"] || "N/A" %>
    </p>
    <p class="mb-1">
      📍 Campus: <%= record.data["campus"] || "N/A" %>
    </p>
    <p class="mb-1">
      🌎 Country: <%= record.data["country"] || "Haiti" %>
    </p>
  </details>

  <!-- 🔗 Verification -->
  <% if record.data["verification_url"].present? %>
    <hr>
    <details open>
      <summary class="fw-semibold text-dark mb-2">
        <i class="ri-link-m me-1"></i> Verification
      </summary>
      <p class="mt-2 mb-0">
        🔗
        <%= link_to "Verify Record", record.data["verification_url"], target: "_blank", rel: "noopener", class: "text-primary text-decoration-none" %>
      </p>
    </details>
  <% end %>
</div>
