<%= turbo_stream.replace dom_id(@record) do %>
  <%= render partial: "citizens/verification_records/shared/table_row", locals: { record: @record } %>
<% end %>

<%= turbo_stream.replace "record_form_frame" do %>
  <div class="alert alert-dismissible fade show alert-info small text-center mb-0 rounded-3">
    <i class="ri-pencil-line me-1"></i>
    ✅ Record successfully updated and revalidated.
  </div>
<% end %>

<%= turbo_stream.replace "flash" do %>
  <%= render partial: "shared/flash", locals: { notice: "✅ Record successfully updated and revalidated." } %>
<% end %>
