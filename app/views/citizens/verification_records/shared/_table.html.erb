

<%# ===============================================================
  BonID — Citizen Verification Records Table
  ---------------------------------------------------------------
  ✅ Supports all record types & categories
  ✅ Turbo-friendly actions (inline form loading)
  ✅ Consistent BonID badge colors & icons
================================================================ %>
<%# ===============================================================
  BonID — Citizen Verification Records Table
  ---------------------------------------------------------------
  ✅ Renders dynamic table rows via shared/_table_row
  ✅ Turbo Stream safe
================================================================ %>

<table class="table table-sm table-hover align-middle mb-0">
  <thead class="table-light align-middle">
    <tr>
      <th><i class="ri-database-2-line me-1"></i> Type</th>
      <th><i class="ri-price-tag-3-line me-1"></i> Category</th>
      <th><i class="ri-information-line me-1"></i> Key Info</th>
      <th class="text-center"><i class="ri-eye-line me-1"></i> Visibility</th>
      <th class="text-center"><i class="ri-shield-check-line me-1"></i> Status</th>
      <th class="text-center"><i class="ri-time-line me-1"></i> Created</th>
      <th class="text-end"><i class="ri-tools-line me-1"></i> Actions</th>
    </tr>
  </thead>

  <tbody id="verification_records_table">
    <% if records.any? %>
      <% records.each do |record| %>
        <%= render "citizens/verification_records/shared/table_row", record: record %>
      <% end %>
    <% else %>
      <tr>
        <td colspan="7" class="text-center py-5 text-muted">
          <i class="ri-folder-warning-line fs-4 d-block mb-2"></i>
          No verification records found.
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
