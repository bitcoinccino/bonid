<%= turbo_stream.remove dom_id(@record) %>

<%= turbo_stream.replace "record_form_frame" do %>
  <div class="alert alert-dismissible fade show alert-light small text-center mb-0 rounded-3 text-muted border">
    <i class="ri-information-line me-1"></i>
    Record deleted — select another to edit or add a new one.
  </div>
<% end %>

<%= turbo_stream.replace "flash" do %>
  <%= render partial: "shared/flash", locals: { notice: "🗑️ Record deleted successfully." } %>
<% end %>
