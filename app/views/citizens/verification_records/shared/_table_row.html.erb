<%# ===============================================================
  BonID — Citizen Verification Records Table Row
  ---------------------------------------------------------------
  ✅ Consistent Bootstrap & BonID color system
  ✅ Rich summaries per record type (property, business, etc.)
  ✅ Expandable details for deep data inspection
  ✅ Turbo + Remix-icon compatible
================================================================ %>
<%# ===============================================================
  BonID — Citizen Verification Records Table Row
  ---------------------------------------------------------------
  ✅ Works with Turbo + record_form_frame
  ✅ Supports Edit, Delete, and optional View
  ✅ Clean Bootstrap 5 layout with Remix Icons
===<%# ===============================================================
  BonID — Citizen Verification Records Table Row
  ---------------------------------------------------------------
  ✅ Inline Turbo Edit & View (record_form_frame)
  ✅ Turbo Stream Delete
  ✅ Expandable Details Section
================================================================ %>
<%# app/views/citizens/verification_records/shared/_table_row.html.erb %>
<tr id="<%= dom_id(record) %>" class="align-middle">
  <!-- === Type === -->
  <td>
    <% icon_class = case record.record_type
      when "education"  then "ri-graduation-cap-line text-success"
      when "employment" then "ri-briefcase-line text-primary"
      when "business"   then "ri-store-2-line text-info"
      when "property"   then "ri-home-4-line text-danger"
      when "health"     then "ri-hospital-line text-warning"
      else "ri-database-2-line text-secondary"
    end %>
    <i class="<%= icon_class %> me-1"></i>
    <%= record.record_type.titleize %>
  </td>

  <!-- === Category === -->
  <td>
    <% category_badge =
      case record.category
      when "land_transaction"
        tag.span("Land Transaction", class: "badge bg-success-subtle text-success border border-success")
      when "registration"
        tag.span("Registration", class: "badge bg-info-subtle text-info border border-info")
      when "patient_record"
        tag.span("Patient Record", class: "badge bg-warning-subtle text-warning border border-warning")
      else
        tag.span(record.category&.titleize || "Base", class: "badge bg-light border text-muted")
      end %>
    <%= category_badge %>
  </td>

  <!-- === Summary / Key Info === -->
  <td class="text-truncate" style="max-width: 280px;">
    <% data = record.data || {} %>
    <% summary =
      case record.record_type
      when "business"
        [data["business_name"], data["business_type"], data["sector"]&.titleize].compact.join(" — ").presence || "—"
      when "education"
        [data["institution"], data["degree"], data["year"]].compact.join(" — ").presence || "—"
      when "employment"
        [data["employer"], data["position"], data["start_date"]].compact.join(" — ").presence || "—"
      when "property"
        if record.category == "land_transaction"
          buyer   = data.dig("buyer", "name")
          seller  = data.dig("seller", "name")
          location = data.dig("property", "location")
          cost     = data["total_cost_htg"]
          [
            ("Buyer: #{buyer}" if buyer.present?),
            ("Seller: #{seller}" if seller.present?),
            location,
            ("HTG #{number_with_delimiter(cost)}" if cost.present?)
          ].compact.join(" — ").presence || "Land Transaction"
        else
          [data["address"], data["title_number"], data["property_type"]].compact.join(" — ").presence || "—"
        end
      when "health"
        [data["provider_name"], data["service_type"]].compact.join(" — ").presence || "—"
      else
        data["description"].presence || "—"
      end %>
    <%= summary %>
  </td>

  <!-- === Visibility === -->
  <td class="text-center">
    <% access_class =
      case record.access_level
      when "public_access"  then "primary"
      when "partner_access" then "info"
      when "private_access" then "secondary"
      else "secondary"
      end %>
    <span class="badge bg-<%= access_class %>-subtle text-<%= access_class %> border border-<%= access_class %>">
      <%= record.access_level.humanize %>
    </span>
  </td>

  <!-- === Status === -->
  <td class="text-center">
    <% status_badge =
      case record.status
      when "verified"
        tag.span("Verified", class: "badge bg-success-subtle text-success border border-success")
      when "pending"
        tag.span("Pending", class: "badge bg-warning-subtle text-warning border border-warning")
      when "rejected"
        tag.span("Rejected", class: "badge bg-danger-subtle text-danger border border-danger")
      when "revoked"
        tag.span("Revoked", class: "badge bg-secondary-subtle text-secondary border border-secondary")
      else
        tag.span("Unknown", class: "badge bg-light text-muted border")
      end %>
    <%= status_badge %>
  </td>

  <!-- === Created === -->
  <td class="text-center text-muted small">
    <%= record.created_at.strftime("%b %d, %Y") %>
  </td>

  <!-- === Actions === -->
  <td class="text-end">
    <div class="btn-group btn-group-sm">
      <!-- 👁 View -->
      <%= link_to citizens_verification_record_path(record),
                  class: "btn btn-outline-primary",
                  data: { turbo_frame: "record_form_frame", bs_toggle: "tooltip" },
                  title: "View Details" do %>
        <i class="ri-eye-line"></i>
      <% end %>

      <!-- ✏️ Edit -->
      <%= link_to edit_citizens_verification_record_path(record, record_type: record.record_type),
                  class: "btn btn-outline-secondary",
                  data: { turbo_frame: "record_form_frame", bs_toggle: "tooltip" },
                  title: "Edit Record" do %>
        <i class="ri-pencil-line"></i>
      <% end %>

      <!-- 🗑️ Delete -->
      <%= link_to citizens_verification_record_path(record),
                  method: :delete,
                  data: {
                    turbo_confirm: "Are you sure you want to delete this record?",
                    turbo_stream: true,
                    bs_toggle: "tooltip"
                  },
                  title: "Delete Record",
                  class: "btn btn-outline-danger" do %>
        <i class="ri-delete-bin-line"></i>
      <% end %>
    </div>
  </td>
</tr>

<!-- === Expandable Details === -->
<tr class="border-top-0">
  <td colspan="7" class="bg-light-subtle ps-5 py-3 small">
    <details>
      <summary class="fw-semibold text-primary" style="cursor:pointer;">
        <i class="ri-arrow-down-s-line me-1"></i> View Details
      </summary>
      <div class="mt-3">
        <% case record.record_type %>
        <% when "property" %>
          <% if record.category == "land_transaction" %>
            <%= render "citizens/verification_records/property/land_transaction_details", record: record %>
          <% else %>
            <%= render "citizens/verification_records/property/property_details", record: record %>
          <% end %>
        <% when "education" %>
          <%= render "citizens/verification_records/education/education_details", record: record %>
        <% when "employment" %>
          <%= render "citizens/verification_records/employment/employment_details", record: record %>
        <% when "business" %>
          <%= render "citizens/verification_records/business/business_details", record: record %>
        <% when "health" %>
          <%= render "citizens/verification_records/health/health_details", record: record %>
        <% else %>
          <pre class="bg-white border rounded-3 p-2 text-muted small" style="max-height:240px;overflow:auto;">
<%= JSON.pretty_generate(record.data) %>
          </pre>
        <% end %>
      </div>
    </details>
  </td>
</tr>
