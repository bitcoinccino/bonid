<% place = [ @scan_log.city.presence, @scan_log.country.presence ].compact.join(", ").presence -%>
<%= t("mailers.qr_scan.heading") %>

<%= t("mailers.citizen_common.greeting", name: @user.first_name.presence || @user.full_name) %>

<%= t("mailers.qr_scan.body") %>

<%= t("mailers.qr_scan.who") %> <%= @officer ? t("mailers.qr_scan.who_police", name: @officer.full_name.presence || t("mailers.qr_scan.police_default")) : (@partner&.name || t("mailers.qr_scan.who_camera")) %>
<%= t("mailers.qr_scan.when") %> <%= I18n.l(@scan_log.scanned_at, format: t("mailers.qr_scan.time_format")) %>
<% if place %><%= t("mailers.qr_scan.where") %> <%= t("mailers.qr_scan.where_value", place: place) %>
<% end %>
<%= t("mailers.qr_scan.not_you_title") %> <%= t("mailers.qr_scan.not_you") %>

<%= t("mailers.qr_scan.button") %>: <%= citizens_activity_url %>
