<%# Plain-English scan alert on the shared Haitian-blue layout (layouts/mailer). %>
<%
  who =
    if @officer then "#{@officer.full_name.presence || 'A police officer'} (police)"
    elsif @partner then @partner.name
    else "Someone using a phone camera"
    end
  place = [ @scan_log.city.presence, @scan_log.country.presence ].compact.join(", ").presence
%>
<div style="font-family:'Montserrat','Inter',Arial,sans-serif; font-size:20px; font-weight:700; color:#00209F; margin-bottom:12px;">
  Your BonID was checked
</div>
<p style="margin:0 0 16px;">Hi <%= @user.first_name.presence || @user.full_name %>,</p>
<p style="margin:0 0 16px;">Someone just checked your BonID to confirm who you are.</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F1F5FB; border-radius:10px; margin:0 0 16px;">
  <tr><td style="padding:14px 18px; font-size:14px; color:#1E293B; line-height:1.9;">
    <strong>Who:</strong> <%= who %><br>
    <strong>When:</strong> <%= @scan_log.scanned_at.strftime("%b %-d, %Y at %-I:%M %p") %><br>
    <% if place %><strong>Where:</strong> about <%= place %><% end %>
  </td></tr>
</table>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#FEF3C7; border-radius:10px; margin:0 0 20px;">
  <tr><td style="padding:12px 16px; font-size:13px; color:#78350F;">
    <strong>Wasn't you?</strong> Someone may have a photo of your QR code. Contact support@bonid.ht right away.
  </td></tr>
</table>

<div style="text-align:center;">
  <a href="<%= citizens_activity_url %>" style="display:inline-block; background:#00209F; color:#FFFFFF; text-decoration:none; font-weight:700; font-size:14px; padding:12px 22px; border-radius:8px;">
    See your activity
  </a>
</div>
