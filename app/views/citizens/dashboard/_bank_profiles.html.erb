<!-- app/views/citizens/profiles/_bank_profile_fields.html.erb -->

<% profile = f.object %>

<div class="border rounded-3 p-3 mb-3 nested-fields shadow-sm
            <%= 'border-danger' if profile.errors.any? %>"
     data-new-record="<%= profile.new_record? %>">

  <%= f.hidden_field :id if profile.persisted? %>

  <div class="row g-3">
    <div class="col-md-6">
      <%= f.input :bank_name %>
    </div>

    <div class="col-md-6">
      <%= f.input :account_number %>
    </div>

    <div class="col-md-6">
      <%= f.input :wallet_provider,
            label: "Wallet Provider (e.g., MonCash)" %>
    </div>

    <div class="col-md-6">
      <%= f.input :phone_number %>
    </div>
  </div>

  <div class="text-end mt-3">
    <%= link_to "Remove",
          "#",
          class: "text-danger small",
          data: { action: "click->nested-form#remove" } %>
  </div>
</div>
