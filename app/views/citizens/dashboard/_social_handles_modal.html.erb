<!-- app/views/citizens/dashboard/_social_handles_modal.html.erb -->
<div class="modal fade" id="socialModal" data-modal-portal tabindex="-1" aria-labelledby="socialModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content" data-controller="modal-form">

      <!-- HEADER -->
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="socialModalLabel" style="font-family: 'Montserrat', sans-serif; font-size: 1rem; font-weight: 600; color: #fff;">
          <i class="ri-links-line me-2"></i>
          <%= t("citizen_portal.modals.social_title") %>
        </h5>
        <button type="button"
                class="btn-close btn-close-white"
                data-bs-dismiss="modal"
                aria-label="<%= t("citizen_portal.common.close") %>"></button>
      </div>

      <!-- FORM -->
      <%= simple_form_for current_citizen,
            as: :user,
            url: citizens_profile_path,
            method: :patch,
            html: { data: { turbo: false } } do |f| %>

        <div class="modal-body">

     
          <%= render "citizens/profiles/social_handles", f: f %>

        </div>

        <!-- FOOTER -->
        <%= render "shared/modal_footer", form: f, confirm_label: t("citizen_portal.common.save") %>

      <% end %>
    </div>
  </div>
</div>
