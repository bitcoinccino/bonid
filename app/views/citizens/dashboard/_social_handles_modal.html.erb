<!-- app/views/citizens/dashboard/_social_handles_modal.html.erb -->
<div class="modal fade" id="socialModal" tabindex="-1" aria-labelledby="socialModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">

      <!-- HEADER -->
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="socialModalLabel" style="font-family: 'Montserrat', sans-serif; font-size: 1rem; font-weight: 600; color: #fff;">
          <i class="ri-links-line me-2"></i>
          Social Media
        </h5>
        <button type="button"
                class="btn-close btn-close-white"
                data-bs-dismiss="modal"
                aria-label="Close"></button>
      </div>

      <!-- FORM -->
      <%= simple_form_for current_citizen,
            as: :user,
            url: citizens_profile_path,
            method: :patch,
            html: { data: { turbo: false } } do |f| %>

        <div class="modal-body">

     
          <%= render "citizens/profiles/social_handles", f: f %>

        </div>

        <!-- FOOTER -->
        <div class="modal-footer" style="border-top: 1px solid #e4e7ec;">
          <button type="button"
                  class="btn btn-outline-secondary fw-semibold px-4 py-2"
                  style="font-size: 0.85rem; border-radius: 0.5rem;"
                  data-bs-dismiss="modal">
            Cancel
          </button>

          <%= f.submit "Save",
                class: "btn btn-primary fw-semibold px-4 py-2",
                style: "font-size: 0.85rem; border-radius: 0.5rem;" %>
        </div>

      <% end %>
    </div>
  </div>
</div>
