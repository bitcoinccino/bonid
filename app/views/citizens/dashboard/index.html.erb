<%# app/views/citizens/dashboard/index.html.erb %>
<%# Clean Apple Wallet-style BonID Dashboard %>

<%
  # Widen the dashboard layout for the get-started state to match the submission form width
  dashboard_class = "citizen-dashboard"
  dashboard_class += " citizen-dashboard--wide" unless @approved_submission.present? || @submissions&.any?(&:status_pending?)
%>
<%= turbo_stream_from "citizen_#{current_citizen.id}_family" %>
<%= turbo_stream_from "citizen_#{current_citizen.id}_consents" %>

<% if @approved_submission.present? %>
  <%# Dashboard Title — rendered OUTSIDE .citizen-dashboard so it can span the
      layout's full width. .citizen-dashboard is capped at ~400px for the wallet
      aesthetic, which caused the h1 + subtitle to stack awkwardly. %>
  <div class="ballot-head text-center mb-4">
    <h1 class="ballot-title">
      <i class="ri-dashboard-line me-2"></i><%= t("citizen_portal.dashboard.wallet_title") %>
    </h1>
    <p class="ballot-subtitle mb-0">
      <%= t("citizen_portal.dashboard.wallet_subtitle") %>
    </p>
  </div>
<% end %>

<section class="<%= dashboard_class %>" data-controller="wallet-stack">

  <%# Legacy-CIN migration banner — shown above ANY dashboard state when the
      citizen's profile holds a non-NINU CIN. Until they update, BonID
      submission can't accept their ID. %>
  <%= render "citizens/dashboard/legacy_cin_alert" %>

  <% if @approved_submission.present? %>
    <%# ========== VERIFIED USER - WALLET VIEW ========== %>
    <% submission = @approved_submission %>

    <%# ========== ALERTS — Pending transactions + BonID status ========== %>
    <%= render "citizens/dashboard/pending_alerts" %>

    <%# ========== WALLET STACK - Interactive Card Stack ========== %>
    <%
      has_health = current_citizen.health_profile.present?
      has_bank = current_citizen.bank_profiles.any?
      # Only count contacts that have a name (valid contacts)
      valid_emergency_contacts = current_citizen.emergency_contacts.select { |ec| ec.name.present? }
      has_emergency = valid_emergency_contacts.any?
      # Only count social handles that have both platform and handle
      valid_social_handles = current_citizen.social_handles.select { |sh| sh.platform.present? && sh.handle.present? }
      has_social = valid_social_handles.any?
      has_physical = current_citizen.physical_profile.present?
      profile_cards = [has_health, has_bank, has_emergency, has_social, has_physical].count(true)
    %>

    <div class="wallet-stack-container">
      <%# BonID Card - Always visible, can be pushed back %>
      <div class="wallet-card-wrapper active" data-wallet-stack-target="card" data-card="bonid">
        <div class="bonid-wallet-card">
          <div class="wallet-card-header">
            <div class="wallet-brand">
              <i class="ri-shield-check-fill"></i>
              <span>BonID</span>
            </div>
            <div class="wallet-status">
              <span class="status-badge active">
                <i class="ri-checkbox-circle-fill"></i> <%= t("citizen_portal.dashboard.active") %>
              </span>
            </div>
          </div>

          <div class="wallet-card-body">
            <div class="wallet-photo">
              <% if current_citizen.photo.attached? %>
                <%= image_tag url_for(current_citizen.photo),
                              alt: t("citizen_portal.dashboard.profile_photo"), class: "photo-img",
                              style: "width: 120px; height: 120px; object-fit: cover; object-position: center top;" %>
              <% else %>
                <div class="photo-placeholder">
                  <i class="ri-user-3-fill"></i>
                </div>
              <% end %>
            </div>

            <div class="wallet-info">
              <h2 class="wallet-name">
                <%= [current_citizen.first_name, current_citizen.last_name].compact.join(" ") %>
              </h2>
              <%# Mask BonID: show initials + mask middle + show lookup suffix (last 6 stripped chars) %>
              <% bonid_stripped = current_citizen.bonid.to_s.gsub("-", "") %>
              <% if bonid_stripped.length >= 8 %>
                <% lookup_suffix = bonid_stripped.last(6) %>
                <% masked_bonid = "#{bonid_stripped[0..1]}-****-*-**-#{lookup_suffix}" %>
              <% else %>
                <% masked_bonid = current_citizen.bonid %>
              <% end %>
              <p class="wallet-bonid"><%= masked_bonid %></p>
            </div>
          </div>

          <%# Signature Section %>
          <% if submission.signature.attached? %>
            <div class="wallet-signature-section">
              <%= image_tag submission.signature, alt: t("citizen_portal.dashboard.signature"), class: "signature-image" %>
            </div>
          <% end %>

          <%# QR Code Button - Opens Modal %>
          <div class="wallet-qr-action">
            <button type="button"
                    class="view-qr-btn"
                    data-bs-toggle="modal"
                    data-bs-target="#qrCodeModal_<%= submission.id %>">
              <i class="ri-qr-code-line"></i>
              <span><%= t("citizen_portal.dashboard.view_qr") %></span>
            </button>
          </div>

          <div class="wallet-card-footer">
            <div class="footer-item">
              <span class="footer-label"><%= t("citizen_portal.dashboard.issued") %></span>
              <span class="footer-value"><%= l(submission.updated_at.to_date, format: :long) %></span>
            </div>
            <div class="footer-item">
              <span class="footer-label"><%= t("citizen_portal.dashboard.expires") %></span>
              <span class="footer-value"><%= submission.expires_at ? l(submission.expires_at.to_date, format: :long) : t("citizen_portal.dashboard.not_available") %></span>
            </div>
          </div>
        </div>
      </div>

      <%# Health Card - Always show (with empty state if no profile) %>
        <div class="wallet-card-wrapper stacked" data-wallet-stack-target="card" data-card="health">
          <div class="profile-detail-card health-card">
            <div class="detail-card-header">
              <button type="button" class="back-btn" data-action="click->wallet-stack#showBonid">
                <i class="ri-arrow-left-line"></i>
              </button>
              <div class="detail-card-icon">
                <i class="ri-heart-pulse-fill"></i>
              </div>
              <h5><%= t("citizen_portal.dashboard.health.title") %></h5>
              <button type="button" class="edit-btn" data-bs-toggle="modal" data-bs-target="#healthModal">
                <i class="ri-pencil-line"></i>
              </button>
            </div>
            <div class="detail-card-body">
              <% hp = current_citizen.health_profile if has_health %>
              <% health_has_data = hp && (hp.blood_type.present? || hp.allergies_list.any? || hp.chronic_conditions_list.any? || hp.medications_list.any?) %>
              <% if health_has_data %>
                <div class="detail-row">
                  <span class="detail-label"><%= t("citizen_portal.dashboard.health.blood_type") %></span>
                  <span class="detail-value"><%= hp.blood_type&.upcase || "—" %></span>
                </div>
                <% if hp.allergies_list.any? %>
                  <div class="detail-row">
                    <span class="detail-label"><%= t("citizen_portal.dashboard.health.allergies") %></span>
                    <span class="detail-value"><%= hp.allergies_list.map { |a| t("citizen_portal.profile.health.allergy_options.#{a.parameterize(separator: '_')}", default: a) }.join(", ") %></span>
                  </div>
                <% end %>
                <% if hp.chronic_conditions_list.any? %>
                  <div class="detail-row">
                    <span class="detail-label"><%= t("citizen_portal.dashboard.health.conditions") %></span>
                    <span class="detail-value"><%= hp.chronic_conditions_list.map { |c| t("citizen_portal.profile.health.condition_options.#{c.parameterize(separator: '_')}", default: c) }.join(", ") %></span>
                  </div>
                <% end %>
                <% if hp.medications_list.any? %>
                  <div class="detail-row">
                    <span class="detail-label"><%= t("citizen_portal.dashboard.health.medications") %></span>
                    <span class="detail-value"><%= hp.medications_list.join(", ") %></span>
                  </div>
                <% end %>
              <% else %>
                <div class="text-center text-muted py-4">
                  <i class="ri-heart-pulse-line ri-2x mb-2 d-block opacity-50"></i>
                  <p class="mb-2"><%= t("citizen_portal.dashboard.health.empty") %></p>
                  <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#healthModal">
                    <i class="ri-add-line me-1"></i> <%= t("citizen_portal.dashboard.health.add") %>
                  </button>
                </div>
              <% end %>
            </div>
          </div>
          <div class="stack-tab health-bg" data-action="click->wallet-stack#showCard" data-card-type="health"></div>
        </div>

      <%# Bank Card - Always show (with empty state if no profiles) %>
        <div class="wallet-card-wrapper stacked" data-wallet-stack-target="card" data-card="bank">
          <div class="profile-detail-card bank-card">
            <div class="detail-card-header">
              <button type="button" class="back-btn" data-action="click->wallet-stack#showBonid">
                <i class="ri-arrow-left-line"></i>
              </button>
              <div class="detail-card-icon">
                <i class="ri-bank-fill"></i>
              </div>
              <h5><%= t("citizen_portal.dashboard.financial.title") %></h5>
              <button type="button" class="edit-btn" data-bs-toggle="modal" data-bs-target="#bankModal">
                <i class="ri-pencil-line"></i>
              </button>
            </div>
            <div class="detail-card-body">
              <% bank_profiles_list = current_citizen.bank_profiles.select { |bp| bp.account_source.present? && (bp.bank_name.present? || bp.wallet_provider.present? || bp.wallet_address.present? || bp.account_number.present?) } %>
              <% if bank_profiles_list.any? %>
                <% bank_profiles_list.each do |bp| %>
                  <div class="bank-account-item">
                    <div class="bank-icon">
                      <% if bp.account_source == "bank" %>
                        <i class="ri-bank-line"></i>
                      <% elsif bp.account_source == "mobile_wallet" %>
                        <i class="ri-smartphone-line"></i>
                      <% elsif bp.account_source == "crypto_wallet" %>
                        <i class="ri-bit-coin-line"></i>
                      <% else %>
                        <i class="ri-question-line"></i>
                      <% end %>
                    </div>
                    <div class="bank-info">
                      <% if bp.account_source == "bank" %>
                        <span class="bank-name"><%= bp.bank_name.presence || t("citizen_portal.dashboard.financial.bank_account") %></span>
                        <%# Mask account number - show only last 4 characters %>
                        <% masked_acct = bp.account_number.present? ? "••••••" + bp.account_number.gsub(/[^0-9A-Za-z]/, "").last(4).to_s : "" %>
                        <span class="bank-details">
                          <%= bp.account_type&.titleize %> • <%= bp.currency&.upcase %>
                          <% if masked_acct.present? %>
                            <span class="font-monospace ms-1"><%= masked_acct %></span>
                          <% end %>
                        </span>
                      <% elsif bp.account_source == "mobile_wallet" %>
                        <span class="bank-name"><%= bp.wallet_provider.presence&.titleize || t("citizen_portal.dashboard.financial.mobile_wallet") %></span>
                        <%# Mask phone - show only last 4 digits %>
                        <% masked_phone = bp.wallet_address.present? ? "••••••" + bp.wallet_address.gsub(/[^0-9]/, "").last(4).to_s : "" %>
                        <span class="bank-details">
                          <%= bp.currency&.upcase %>
                          <% if masked_phone.present? %>
                            <span class="font-monospace ms-1"><%= masked_phone %></span>
                          <% end %>
                        </span>
                      <% elsif bp.account_source == "crypto_wallet" %>
                        <span class="bank-name"><%= bp.wallet_provider.presence&.titleize || t("citizen_portal.dashboard.financial.crypto_wallet") %></span>
                        <%# Mask wallet address - show first 4 and last 4 characters %>
                        <% addr = bp.wallet_address.to_s %>
                        <% masked_addr = addr.length > 8 ? "#{addr.first(4)}...#{addr.last(4)}" : addr %>
                        <span class="bank-details">
                          <%= bp.chain&.titleize %> • <%= bp.currency&.upcase %>
                          <% if masked_addr.present? %>
                            <span class="font-monospace ms-1"><%= masked_addr %></span>
                          <% end %>
                        </span>
                      <% else %>
                        <span class="bank-name"><%= t("citizen_portal.dashboard.financial.unknown_type") %></span>
                        <span class="bank-details"><%= t("citizen_portal.dashboard.financial.source") %>: <%= bp.account_source.inspect %></span>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              <% else %>
                <div class="text-center text-muted py-4">
                  <i class="ri-bank-line ri-2x mb-2 d-block opacity-50"></i>
                  <p class="mb-2"><%= t("citizen_portal.dashboard.financial.empty") %></p>
                  <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#bankModal">
                    <i class="ri-add-line me-1"></i> <%= t("citizen_portal.dashboard.financial.add") %>
                  </button>
                </div>
              <% end %>
            </div>
          </div>
          <div class="stack-tab bank-bg" data-action="click->wallet-stack#showCard" data-card-type="bank"></div>
        </div>

      <%# Emergency Card - Always show (with empty state if no contacts) %>
        <div class="wallet-card-wrapper stacked" data-wallet-stack-target="card" data-card="emergency">
          <div class="profile-detail-card emergency-card">
            <div class="detail-card-header">
              <button type="button" class="back-btn" data-action="click->wallet-stack#showBonid">
                <i class="ri-arrow-left-line"></i>
              </button>
              <div class="detail-card-icon">
                <i class="ri-contacts-book-fill"></i>
              </div>
              <h5><%= t("citizen_portal.dashboard.emergency.title") %></h5>
              <button type="button" class="edit-btn" data-bs-toggle="modal" data-bs-target="#emergencyModal">
                <i class="ri-pencil-line"></i>
              </button>
            </div>
            <div class="detail-card-body">
              <% if valid_emergency_contacts.any? %>
                <% valid_emergency_contacts.each do |ec| %>
                  <div class="contact-item">
                    <div class="contact-avatar">
                      <% if ec.bonid_photo %>
                        <%= image_tag ec.bonid_photo, class: "rounded-circle", style: "width: 100%; height: 100%; object-fit: cover;" %>
                      <% elsif ec.bonid.present? %>
                        <i class="ri-shield-check-fill"></i>
                      <% else %>
                        <i class="ri-user-line"></i>
                      <% end %>
                    </div>
                    <div class="contact-info">
                      <span class="contact-name"><%= ec.name %></span>
                      <span class="contact-details">
                        <%= ec.relation.present? ? t("citizen_portal.relations.#{ec.relation.downcase}", default: ec.relation.titleize) : t("citizen_portal.dashboard.emergency.contact_fallback") %>
                        <% if ec.phone.present? %> • <%= ec.phone %><% end %>
                      </span>
                    </div>
                  </div>
                <% end %>
              <% else %>
                <div class="text-center text-muted py-4">
                  <i class="ri-contacts-book-line ri-2x mb-2 d-block opacity-50"></i>
                  <p class="mb-2"><%= t("citizen_portal.dashboard.emergency.empty") %></p>
                  <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#emergencyModal">
                    <i class="ri-add-line me-1"></i> <%= t("citizen_portal.dashboard.emergency.add") %>
                  </button>
                </div>
              <% end %>
            </div>
          </div>
          <div class="stack-tab emergency-bg" data-action="click->wallet-stack#showCard" data-card-type="emergency"></div>
        </div>

      <%# Family Card - Optional (parents, guardians) %>
        <% valid_family = current_citizen.family_members.select { |fm| fm.first_name.present? } %>
        <div class="wallet-card-wrapper stacked" data-wallet-stack-target="card" data-card="family">
          <div class="profile-detail-card family-card">
            <div class="detail-card-header">
              <button type="button" class="back-btn" data-action="click->wallet-stack#showBonid">
                <i class="ri-arrow-left-line"></i>
              </button>
              <div class="detail-card-icon">
                <i class="ri-parent-fill"></i>
              </div>
              <h5><%= t("citizen_portal.dashboard.family.title") %></h5>
              <button type="button" class="edit-btn" data-bs-toggle="modal" data-bs-target="#familyModal">
                <i class="ri-pencil-line"></i>
              </button>
            </div>
            <div class="detail-card-body">
              <% if valid_family.any? %>
                <% valid_family.each do |fm| %>
                  <%= render "citizens/dashboard/family_member_item", fm: fm %>
                <% end %>
              <% else %>
                <div class="text-center text-muted py-4">
                  <i class="ri-parent-line ri-2x mb-2 d-block opacity-50"></i>
                  <p class="mb-2"><%= t("citizen_portal.dashboard.family.empty") %></p>
                  <small class="d-block mb-3 px-3"><%= t("citizen_portal.dashboard.family.hint") %></small>
                  <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#familyModal">
                    <i class="ri-add-line me-1"></i> <%= t("citizen_portal.dashboard.family.add") %>
                  </button>
                </div>
              <% end %>
            </div>
          </div>
          <div class="stack-tab family-bg" data-action="click->wallet-stack#showCard" data-card-type="family"></div>
        </div>

      <%# Social Card - Always show (with empty state if no handles) %>
        <div class="wallet-card-wrapper stacked" data-wallet-stack-target="card" data-card="social">
          <div class="profile-detail-card social-card">
            <div class="detail-card-header">
              <button type="button" class="back-btn" data-action="click->wallet-stack#showBonid">
                <i class="ri-arrow-left-line"></i>
              </button>
              <div class="detail-card-icon">
                <i class="ri-share-fill"></i>
              </div>
              <h5><%= t("citizen_portal.dashboard.social.title") %></h5>
              <button type="button" class="edit-btn" data-bs-toggle="modal" data-bs-target="#socialModal">
                <i class="ri-pencil-line"></i>
              </button>
            </div>
            <div class="detail-card-body">
              <% if valid_social_handles.any? %>
                <% valid_social_handles.each do |sh| %>
                  <div class="social-item">
                    <div class="social-icon">
                      <i class="ri-<%= sh.platform&.downcase %>-fill"></i>
                    </div>
                    <div class="social-info">
                      <span class="social-platform"><%= sh.platform&.titleize %></span>
                      <span class="social-handle">@<%= sh.handle %></span>
                    </div>
                  </div>
                <% end %>
              <% else %>
                <div class="text-center text-muted py-4">
                  <i class="ri-share-line ri-2x mb-2 d-block opacity-50"></i>
                  <p class="mb-2"><%= t("citizen_portal.dashboard.social.empty") %></p>
                  <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#socialModal">
                    <i class="ri-add-line me-1"></i> <%= t("citizen_portal.dashboard.social.add") %>
                  </button>
                </div>
              <% end %>
            </div>
          </div>
          <div class="stack-tab social-bg" data-action="click->wallet-stack#showCard" data-card-type="social"></div>
        </div>

      <%# Physical Card - Always show (with empty state if no profile) %>
        <div class="wallet-card-wrapper stacked" data-wallet-stack-target="card" data-card="physical">
          <div class="profile-detail-card physical-card">
            <div class="detail-card-header">
              <button type="button" class="back-btn" data-action="click->wallet-stack#showBonid">
                <i class="ri-arrow-left-line"></i>
              </button>
              <div class="detail-card-icon">
                <i class="ri-body-scan-fill"></i>
              </div>
              <h5><%= t("citizen_portal.dashboard.physical.title") %></h5>
              <button type="button" class="edit-btn" data-bs-toggle="modal" data-bs-target="#physicalModal">
                <i class="ri-pencil-line"></i>
              </button>
            </div>
            <div class="detail-card-body">
              <% pp = current_citizen.physical_profile if has_physical %>
              <% physical_has_data = pp && (pp.height_cm.present? || pp.weight_kg.present? || pp.eye_color.present? || pp.hair_color.present?) %>
              <% if physical_has_data %>
                <div class="detail-row">
                  <span class="detail-label"><%= t("citizen_portal.dashboard.physical.height") %></span>
                  <span class="detail-value"><%= pp.height_cm.present? ? "#{pp.height_cm} cm" : "—" %></span>
                </div>
                <div class="detail-row">
                  <span class="detail-label"><%= t("citizen_portal.dashboard.physical.weight") %></span>
                  <span class="detail-value"><%= pp.weight_kg.present? ? "#{pp.weight_kg} kg" : "—" %></span>
                </div>
                <div class="detail-row">
                  <span class="detail-label"><%= t("citizen_portal.dashboard.physical.eye_color") %></span>
                  <span class="detail-value"><%= pp.eye_color.present? ? t("citizen_portal.profile.physical.options.eye_color.#{pp.eye_color}", default: pp.eye_color.titleize) : "—" %></span>
                </div>
                <div class="detail-row">
                  <span class="detail-label"><%= t("citizen_portal.dashboard.physical.hair_color") %></span>
                  <span class="detail-value"><%= pp.hair_color.present? ? t("citizen_portal.profile.physical.options.hair_color.#{pp.hair_color}", default: pp.hair_color.titleize) : "—" %></span>
                </div>
              <% else %>
                <div class="text-center text-muted py-4">
                  <i class="ri-body-scan-line ri-2x mb-2 d-block opacity-50"></i>
                  <p class="mb-2"><%= t("citizen_portal.dashboard.physical.empty") %></p>
                  <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#physicalModal">
                    <i class="ri-add-line me-1"></i> <%= t("citizen_portal.dashboard.physical.add") %>
                  </button>
                </div>
              <% end %>
            </div>
          </div>
          <div class="stack-tab physical-bg" data-action="click->wallet-stack#showCard" data-card-type="physical"></div>
        </div>
    </div>

    <%# Preview of the PUBLIC verification page — exactly what anyone sees
        after scanning the wallet QR (photo, name, status, masked BonID). %>
    <div class="certificate-action">
      <%= link_to verified_profile_citizens_identity_submission_path(submission.public_token),
                  class: "certificate-btn" do %>
        <i class="ri-award-line"></i> <%= t("citizen_portal.dashboard.view_certificate") %>
      <% end %>
      <p class="small text-muted mt-2 mb-0"><%= t("citizen_portal.dashboard.certificate_hint") %></p>
    </div>

  <% elsif (pending = @submissions.find(&:status_pending?)) %>
    <%# ========== PENDING VERIFICATION ========== %>

    <div class="pending-container">
      <div class="pending-card">
        <div class="pending-icon">
          <i class="ri-time-line"></i>
        </div>
        <h3><%= t("citizen_portal.dashboard.pending.title") %></h3>
        <p><%= t("citizen_portal.dashboard.pending.submitted_on", date: l(pending.created_at.to_date, format: :long)) %></p>
        <p class="pending-note"><%= t("citizen_portal.dashboard.pending.note") %></p>
      </div>
    </div>

  <% elsif (rejected = @submissions.find(&:status_rejected?)) %>
    <%# ========== SUBMISSION REJECTED ========== %>

    <div class="rejected-container">
      <div class="rejected-card">
        <div class="rejected-icon">
          <i class="ri-close-circle-line"></i>
        </div>
        <h3><%= t("citizen_portal.dashboard.rejected.title") %></h3>
        <p><%= t("citizen_portal.dashboard.rejected.body") %></p>

        <% if rejected.rejection_reason.present? || rejected.other_reason.present? %>
          <div class="rejected-reason">
            <div class="reason-label">
              <i class="ri-information-line me-1"></i> <%= t("citizen_portal.dashboard.rejected.reason") %>
            </div>
            <div class="reason-text">
              <%= rejected.rejection_reason&.humanize || t("citizen_portal.dashboard.rejected.not_specified") %>
              <% if rejected.other_reason.present? %>
                <br><%= rejected.other_reason %>
              <% end %>
            </div>
          </div>
        <% end %>

        <div class="rejected-actions">
          <%= link_to new_citizens_identity_submission_path(resubmission_from: rejected.public_token),
                      class: "gs-cta-btn" do %>
            <i class="ri-refresh-line me-1"></i> <%= t("citizen_portal.dashboard.rejected.resubmit") %>
          <% end %>
        </div>

        <p class="rejected-note">
          <i class="ri-mail-line me-1"></i>
          <%= t("citizen_portal.dashboard.rejected.email_note") %>
        </p>
      </div>
    </div>

  <% else %>
    <%# ========== NO BONID YET — Anrejistre wizard chrome ==========
        Header chrome matches the Anrejistre wizard (.ballot-wrap /
        .ballot-head / .ballot-section). %>
    <div class="ballot-wrap px-0" style="padding-bottom: 0;">

      <%# ── Page Header (wizard style) ── %>
      <div class="ballot-head text-center">
        <h1 class="ballot-title">
          <i class="ri-shield-check-line me-2"></i><%= t("citizen_portal.dashboard.get_started.title") %>
        </h1>
        <p class="ballot-subtitle mb-0">
          <% if @is_diaspora %>
            <%= t("citizen_portal.dashboard.get_started.subtitle_diaspora") %>
          <% else %>
            <%= t("citizen_portal.dashboard.get_started.subtitle") %>
          <% end %>
        </p>
      </div>

      <div class="row justify-content-center">
        <div class="col-12 col-xl-11">

        <%# Three steps — each lists only what the citizen needs for that step. %>
        <%
          docs = [
            { icon: "ri-id-card-line",   label: t("citizen_portal.dashboard.get_started.doc_id_label"), detail: t("citizen_portal.dashboard.get_started.doc_id_detail") },
            { icon: "ri-camera-line",    label: t("citizen_portal.dashboard.get_started.selfie_label"), detail: t("citizen_portal.dashboard.get_started.selfie_detail") }
          ]
          if @is_diaspora
            docs << { icon: "ri-bank-card-line", label: t("citizen_portal.dashboard.get_started.res_id_label"), detail: t("citizen_portal.dashboard.get_started.res_id_detail") }
            docs << { icon: "ri-file-text-line", label: t("citizen_portal.dashboard.get_started.res_address_label"), detail: t("citizen_portal.dashboard.get_started.res_address_detail") }
          else
            docs << { icon: "ri-file-text-line", label: t("citizen_portal.dashboard.get_started.address_label"), detail: t("citizen_portal.dashboard.get_started.address_detail") }
          end

          steps = [
            (if current_citizen.profile_complete?
               { num: "1", title: t("citizen_portal.dashboard.get_started.step1_title"), desc: t("citizen_portal.dashboard.get_started.step1_done"), items: [], done: true }
             else
               { num: "1", title: t("citizen_portal.dashboard.get_started.step1_title"), desc: t("citizen_portal.dashboard.get_started.step1_desc"), items: [] }
             end),
            { num: "2", title: t("citizen_portal.dashboard.get_started.step2_title"), desc: t("citizen_portal.dashboard.get_started.step2_desc"),           items: docs },
            { num: "3", title: t("citizen_portal.dashboard.get_started.step3_title"), desc: t("citizen_portal.dashboard.get_started.step3_desc"), items: [] }
          ]
        %>
        <div class="row g-3 mb-4">
          <% steps.each do |s| %>
            <div class="col-md-4">
              <div class="ballot-section card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                  <div class="d-flex align-items-center gap-2 mb-2">
                    <% if s[:done] %>
                      <div class="gs-step-num" style="background:#10B981;color:#fff;" aria-label="<%= t("citizen_portal.dashboard.get_started.done") %>"><i class="ri-check-line"></i></div>
                    <% else %>
                      <div class="gs-step-num"><%= s[:num] %></div>
                    <% end %>
                    <h2 class="ballot-section-title mb-0" style="font-size: 1.05rem;"><%= s[:title] %></h2>
                  </div>
                  <p class="ballot-section-desc mb-2"><%= s[:desc] %></p>

                  <% if s[:num] == "2" && @is_diaspora %>
                    <span style="font-size: 0.72rem; font-weight: 600; color: #00209F;">
                      <i class="ri-global-line me-1"></i> <%= t("citizen_portal.dashboard.get_started.diaspora_application") %>
                      <% if @residence_country && @residence_country != "HT" %>
                        <span style="color: #64748B; font-weight: 400;">(<%= ISO3166::Country[@residence_country]&.translations&.dig(I18n.locale.to_s == "ht" ? "fr" : I18n.locale.to_s) || @residence_country %>)</span>
                      <% end %>
                    </span>
                  <% end %>

                  <% s[:items].each do |req| %>
                    <div class="gs-row">
                      <div class="gs-row-icon"><i class="<%= req[:icon] %>"></i></div>
                      <div class="gs-row-text">
                        <span class="gs-row-label"><%= req[:label] %></span>
                        <span class="gs-row-detail"><%= req[:detail] %></span>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <%# Primary CTA — after the three steps. %>
        <div class="text-center mb-4">
          <% if current_citizen.profile_complete? %>
            <%= link_to new_citizens_identity_submission_path,
                        class: "election-btn-primary" do %>
              <i class="ri-send-plane-line me-1"></i> <%= t("citizen_portal.dashboard.get_started.start") %>
            <% end %>
          <% else %>
            <%= link_to edit_citizens_profile_path,
                        class: "election-btn-primary" do %>
              <i class="ri-edit-line me-1"></i> <%= t("citizen_portal.dashboard.get_started.start") %>
            <% end %>
          <% end %>
        </div>

        </div><%# /col-xl-11 %>
      </div><%# /row justify-content-center %>
    </div><%# /ballot-wrap %>
  <% end %>

  <%# QR Code Modal %>
  <% if @approved_submission.present? %>
    <%= render "citizens/identity_submissions/qrcode_modal", submission: @approved_submission %>
  <% end %>

  <%# Profile Modals %>
  <%= render "citizens/dashboard/health_modal" %>
  <%= render "citizens/dashboard/physical_modal" %>
  <%= render "citizens/dashboard/family_modal" %>
  <%= render "citizens/dashboard/emergency_contacts_modal" %>
  <%= render "citizens/dashboard/bank_profiles_modal" %>
  <%= render "citizens/dashboard/social_handles_modal" %>
  <% if @approved_submission.present? %>
    <%= render "citizens/identity_submissions/request_modal",
                profile_complete: @profile_complete,
                submissions: @submissions %>
  <% end %>
</section>
