<!-- app/views/citizens/dashboard/_bank_profiles_modal.html.erb -->
<div class="modal fade" id="bankModal" tabindex="-1" aria-labelledby="bankModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="bankModalLabel" style="font-family: 'Montserrat', sans-serif; font-size: 1rem; font-weight: 600; color: #fff;">
          <i class="ri-bank-line me-2"></i>
          Financial Accounts
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <%= simple_form_for current_citizen,
            as: :user,
            url: citizens_profile_path,
            method: :patch,
            html: { data: { turbo: false }, class: "needs-validation", novalidate: true },
            wrapper: :vertical_form do |f| %>

        <div class="modal-body" data-controller="nested-form" data-nested-form-wrapper-class="bank-profile-wrapper">
          <%# Compact Info Banner (dismissible) %>
          <div class="alert alert-info alert-dismissible d-flex align-items-start mb-4 rounded-3 compact-info-banner" role="alert">
            <i class="ri-shield-check-line me-2 mt-1"></i>
            <span>
              <strong>Your financial information is encrypted and secure.</strong>
              Link accounts for <strong>faster identity verification</strong>. BonID shares your data <strong>only with your explicit consent</strong>.
            </span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>

          <div data-nested-form-target="wrapper" class="bank-profile-wrapper">
            <% if current_citizen.bank_profiles.any? %>
              <%= f.simple_fields_for :bank_profiles do |bp| %>
                <%= render "citizens/dashboard/bank_profile_entry", f: bp %>
              <% end %>
            <% else %>
              <% empty_profile = current_citizen.bank_profiles.build(account_source: nil, currency: nil) %>
              <%= f.simple_fields_for :bank_profiles, empty_profile do |bp| %>
                <%= render "citizens/dashboard/bank_profile_entry", f: bp %>
              <% end %>
            <% end %>
          </div>

          <div class="text-center mt-3">
            <button type="button"
                    class="btn btn-outline-primary btn-sm fw-semibold px-4"
                    style="border-radius: 0.5rem;"
                    data-action="click->nested-form#addAssociation">
              <i class="ri-add-line me-1"></i> Add Another Account
            </button>
          </div>

          <!-- Template for new entries -->
          <template data-nested-form-target="template">
            <% new_profile = BankProfile.new(account_source: nil, currency: nil) %>
            <%= f.simple_fields_for :bank_profiles, new_profile, child_index: "NEW_RECORD" do |bp| %>
              <%= render "citizens/dashboard/bank_profile_entry", f: bp %>
            <% end %>
          </template>
        </div>

        <div class="modal-footer" style="border-top: 1px solid #e4e7ec;">
          <button type="button"
                  class="btn btn-outline-secondary fw-semibold px-4 py-2"
                  style="font-size: 0.85rem; border-radius: 0.5rem;"
                  data-bs-dismiss="modal">
            Cancel
          </button>
          <%= f.submit "Save",
                class: "btn btn-primary fw-semibold px-4 py-2",
                style: "font-size: 0.85rem; border-radius: 0.5rem;" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
