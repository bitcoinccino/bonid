<!-- app/views/citizens/dashboard/_health_modal.html.erb -->
<div class="modal fade" id="healthModal" tabindex="-1" aria-labelledby="healthModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header bg-haitian-blue text-white">
        <h5 class="modal-title" id="healthModalLabel">
          <i class="ri-heart-pulse-line me-2"></i>
          <%= current_citizen.health_profile.present? ? "Edit" : "Add" %> Health Information
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <%= simple_form_for current_citizen,
            as: :user,
            url: citizens_profile_path,
            method: :patch,
            html: { data: { turbo: false } } do |f| %>

        <%= f.simple_fields_for :health_profile do |hp| %>
          <div class="modal-body">
            <%= render "citizens/profiles/health_fields", f: hp %>
          </div>
        <% end %>

        <div class="modal-footer" style="border-top: none; position: sticky; bottom: 0; background: #fff; z-index: 1;">
          <button type="button"
                  class="btn btn-ghost-cancel rounded-pill px-4"
                  data-bs-dismiss="modal">
            Cancel
          </button>
          <%= f.submit "Save",
                class: "btn btn-haitian-primary fw-semibold rounded-pill px-4" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
