<!-- app/views/citizens/dashboard/_health_modal.html.erb -->
<div class="modal fade" id="healthModal" tabindex="-1" aria-labelledby="healthModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <%= simple_form_for current_citizen,
            as: :user,
            url: citizens_profile_path,
            method: :patch,
            html: { data: { turbo: false }, class: "d-flex flex-column", style: "min-height: 0; max-height: 100%; overflow: hidden;" } do |f| %>

        <div class="modal-header bg-primary text-white">
          <h5 class="modal-title" id="healthModalLabel" style="font-family: 'Montserrat', sans-serif; font-size: 1rem; font-weight: 600; color: #fff;">
            <i class="ri-heart-pulse-line me-2"></i>
            <%= t("citizen_portal.modals.health_title") %>
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="<%= t("citizen_portal.common.close") %>"></button>
        </div>

        <div class="modal-body" style="overflow-y: auto; flex: 1 1 auto;">
          <%= f.simple_fields_for :health_profile do |hp| %>
            <%= render "citizens/profiles/health_fields", f: hp %>
          <% end %>
        </div>

        <div class="modal-footer" style="border-top: 1px solid #e4e7ec;">
          <button type="button"
                  class="btn btn-outline-secondary fw-semibold px-4 py-2"
                  style="font-size: 0.85rem; border-radius: 0.5rem;"
                  data-bs-dismiss="modal">
            <%= t("citizen_portal.common.cancel") %>
          </button>
          <%= f.submit t("citizen_portal.common.save"),
                class: "btn btn-primary fw-semibold px-4 py-2",
                style: "font-size: 0.85rem; border-radius: 0.5rem;" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
