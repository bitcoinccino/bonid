<div class="modal fade" id="emergencyModal" tabindex="-1" aria-labelledby="emergencyModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <%= simple_form_for current_citizen,
            as: :user,
            url: citizens_profile_path,
            method: :patch,
            html: { data: { turbo: false, controller: "emergency-contacts", "emergency-contacts-user-bonid-value": current_citizen&.bonid } } do |f| %>
        <div class="modal-header bg-primary text-white">
          <h5 class="modal-title" id="emergencyModalLabel" style="font-family: 'Montserrat', sans-serif; font-size: 1rem; font-weight: 600; color: #fff;">
            <i class="ri-contacts-book-2-line me-2"></i><%= t("citizen_portal.modals.emergency.title") %>
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="<%= t("citizen_portal.common.close") %>"></button>
        </div>
        <div class="modal-body">
          <%# Compact Info Banner (dismissible) %>
          <div class="alert alert-info alert-dismissible d-flex align-items-start mb-4 rounded-3 compact-info-banner" role="alert">
            <i class="ri-shield-user-line me-2 mt-1"></i>
            <span>
              <%= t("citizen_portal.modals.emergency.banner_html") %>
            </span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t("citizen_portal.common.close") %>"></button>
          </div>

          <%# Container for contacts - REQUIRED for Stimulus controller %>
          <% valid_contacts = current_citizen.emergency_contacts.select { |ec| ec.name.present? } %>
          <div data-emergency-contacts-target="contacts">
            <% if valid_contacts.any? %>
              <%= f.fields_for :emergency_contacts do |ec_form| %>
                <% next if ec_form.object.name.blank? %>
                <%= render "citizens/profiles/emergency_contact", ec_form: ec_form %>
              <% end %>
            <% else %>
              <div class="text-center py-4 text-muted" data-emergency-contacts-target="empty">
                <i class="ri-contacts-book-line ri-3x mb-2"></i>
                <p class="mb-0"><%= t("citizen_portal.modals.emergency.empty") %></p>
                <small><%= t("citizen_portal.modals.emergency.empty_hint") %></small>
              </div>
            <% end %>
          </div>

          <%# Template for adding new contacts %>
          <template data-emergency-contacts-target="template">
            <div class="border rounded-3 p-3 mb-4 bg-light nested-fields" data-new-record="true">
              <div class="row g-3 align-items-end">
                <div class="col-md-6">
                  <label class="form-label fw-semibold"><%= t("citizen_portal.modals.emergency.bonid_optional") %></label>
                  <input type="text"
                         name="user[emergency_contacts_attributes][NEW_RECORD][bonid]"
                         class="form-control rounded-3"
                         placeholder="<%= t("citizen_portal.modals.emergency.bonid_placeholder") %>"
                         data-action="blur->emergency-contacts#fetchBonid"
                         data-emergency-contacts-target="bonid" />
                  <small class="text-muted fst-italic"><%= t("citizen_portal.modals.emergency.bonid_hint") %></small>
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-semibold"><%= t("citizen_portal.modals.emergency.name") %></label>
                  <input type="text"
                         name="user[emergency_contacts_attributes][NEW_RECORD][name]"
                         class="form-control rounded-3"
                         placeholder="<%= t("citizen_portal.modals.emergency.full_name") %>"
                         data-emergency-contacts-target="name" />
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-semibold"><%= t("citizen_portal.modals.emergency.phone") %></label>
                  <input type="text"
                         name="user[emergency_contacts_attributes][NEW_RECORD][phone]"
                         class="form-control rounded-3"
                         placeholder="<%= t("citizen_portal.modals.emergency.phone_number") %>"
                         data-emergency-contacts-target="phone" />
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-semibold"><%= t("citizen_portal.modals.emergency.email") %></label>
                  <input type="email"
                         name="user[emergency_contacts_attributes][NEW_RECORD][email]"
                         class="form-control rounded-3"
                         placeholder="<%= t("citizen_portal.modals.emergency.email") %>" />
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-semibold"><%= t("citizen_portal.modals.emergency.relation") %></label>
                  <select name="user[emergency_contacts_attributes][NEW_RECORD][relation]"
                          class="form-select rounded-3">
                    <option value=""><%= t("citizen_portal.modals.emergency.select_relation") %></option>
                    <% EmergencyContact::RELATIONS.each do |rel| %>
                      <option value="<%= rel %>"><%= t("citizen_portal.relations.#{rel.downcase}", default: rel) %></option>
                    <% end %>
                  </select>
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-semibold"><%= t("citizen_portal.modals.emergency.address") %></label>
                  <input type="text"
                         name="user[emergency_contacts_attributes][NEW_RECORD][address]"
                         class="form-control rounded-3"
                         placeholder="<%= t("citizen_portal.modals.emergency.address") %>"
                         data-emergency-contacts-target="address" />
                </div>
                <div class="col-12 text-end">
                  <button type="button"
                          class="btn btn-sm btn-outline-danger rounded-pill px-3"
                          data-action="click->emergency-contacts#remove">
                    <i class="ri-delete-bin-line me-1"></i> <%= t("citizen_portal.modals.emergency.remove") %>
                  </button>
                </div>
              </div>
            </div>
          </template>

          <%# Add Another Button %>
          <div class="text-end mt-3">
            <button type="button"
                    class="btn btn-outline-primary rounded-pill"
                    data-action="click->emergency-contacts#add">
              <i class="ri-add-line me-1"></i> <%= t("citizen_portal.modals.emergency.add_another") %>
            </button>
          </div>
        </div>
        <div class="modal-footer" style="border-top: 1px solid #e4e7ec;">
          <button type="button"
                  class="btn btn-outline-secondary fw-semibold px-4 py-2"
                  style="font-size: 0.85rem; border-radius: 0.5rem;"
                  data-bs-dismiss="modal">
            <%= t("citizen_portal.common.cancel") %>
          </button>
          <%= f.submit t("citizen_portal.common.save"),
                class: "btn btn-primary fw-semibold px-4 py-2",
                style: "font-size: 0.85rem; border-radius: 0.5rem;" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
