<!-- app/views/citizens/dashboard/_profile_progress.html.erb -->
<div id="profile_progress" class="mb-5">
  <% 
    # Calculate completion
    sections = {
      'Health Information' => citizen.health_profile.present?,
      'Physical Characteristics' => citizen.physical_profile.present?,
      'Financial Profile' => citizen.bank_profiles.any?,
      'Emergency Contacts' => citizen.emergency_contacts.any?,
      'Social Media' => citizen.social_handles.any?
    }
    
    total_sections = sections.count
    completed_sections = sections.values.count(true)
    progress = ((completed_sections.to_f / total_sections) * 100).round
  %>

  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-4">
      <!-- Header -->
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0 d-flex align-items-center">
          <i class="ri-profile-line text-primary me-2"></i>
          Profile Completion
          <i class="ri-information-line ms-2 text-muted" 
             data-bs-toggle="tooltip" 
             title="Complete your profile to unlock all BonID features and build trust with partners"></i>
        </h6>
        <span class="badge bg-primary-subtle text-primary fw-bold fs-6 px-3 py-2">
          <%= progress %>%
        </span>
      </div>

      <!-- Progress Bar -->
      <div class="progress mb-3" style="height: 12px;">
        <div class="progress-bar bg-gradient <%= progress == 100 ? 'bg-success' : 'bg-primary' %> progress-bar-striped <%= progress < 100 ? 'progress-bar-animated' : '' %>"
             role="progressbar"
             style="width: <%= progress %>%"
             aria-valuenow="<%= progress %>"
             aria-valuemin="0"
             aria-valuemax="100">
        </div>
      </div>

      <!-- Status Message -->
      <% if progress == 100 %>
        <div class="alert alert-success border-success-subtle mb-3 py-2">
          <i class="ri-check-double-line me-2"></i>
          <strong>Profile Complete!</strong> You've added all optional information. 🎉
        </div>
      <% elsif progress >= 60 %>
        <div class="alert alert-info border-info-subtle mb-3 py-2">
          <i class="ri-thumb-up-line me-2"></i>
          <strong>Good progress!</strong> Complete <%= total_sections - completed_sections %> more <%= 'section'.pluralize(total_sections - completed_sections) %> to finish.
        </div>
      <% else %>
        <div class="alert alert-warning border-warning-subtle mb-3 py-2">
          <i class="ri-information-line me-2"></i>
          <strong>Get started!</strong> Add more information to build your BonID profile.
        </div>
      <% end %>

      <!-- Section Breakdown (Collapsible) -->
      <div class="accordion accordion-flush" id="profileSections">
        <div class="accordion-item border-0">
          <h2 class="accordion-header">
            <button class="accordion-button collapsed bg-transparent p-0 shadow-none small text-primary fw-semibold" 
                    type="button" 
                    data-bs-toggle="collapse" 
                    data-bs-target="#sectionDetails">
              <i class="ri-arrow-down-s-line me-1"></i>
              See what's included (<%= completed_sections %>/<%= total_sections %> sections complete)
            </button>
          </h2>
          <div id="sectionDetails" class="accordion-collapse collapse" data-bs-parent="#profileSections">
            <div class="accordion-body px-0 pt-3 pb-0">
              <ul class="list-unstyled mb-0">
                <% sections.each do |section_name, is_complete| %>
                  <li class="mb-2 d-flex align-items-center">
                    <% if is_complete %>
                      <i class="ri-checkbox-circle-fill text-success me-2"></i>
                      <span class="text-muted text-decoration-line-through"><%= section_name %></span>
                    <% else %>
                      <i class="ri-checkbox-blank-circle-line text-muted me-2"></i>
                      <span class="fw-semibold text-dark"><%= section_name %></span>
                      <span class="badge bg-warning-subtle text-warning ms-2 small">Incomplete</span>
                    <% end %>
                  </li>
                <% end %>
              </ul>

              <% if progress < 100 %>
                <div class="mt-3 p-3 bg-light rounded-3">
                  <p class="small text-muted mb-2">
                    <i class="ri-lightbulb-line text-warning me-1"></i>
                    <strong>Why complete your profile?</strong>
                  </p>
                  <ul class="small text-muted mb-0 ps-3">
                    <li>Share verified data with partners you trust</li>
                    <li>Pre-fill forms automatically at banks, hospitals, etc.</li>
                    <li>Unlock premium features and partner benefits</li>
                  </ul>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Initialize tooltips
  document.addEventListener("turbo:load", () => {
    const tooltips = document.querySelectorAll('[data-bs-toggle="tooltip"]');
    tooltips.forEach(el => new bootstrap.Tooltip(el));
  });
</script>
