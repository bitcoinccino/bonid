<%# app/views/citizens/transaction_consents/decide.turbo_stream.erb %>
<%# Replaces the consent card/focus card with updated status after OTP approve/deny %>

<% is_approved = @consent.approved? %>
<% status_color = is_approved ? '#198754' : '#dc3545' %>
<% status_bg = is_approved ? '#f0fdf4' : '#fef2f2' %>
<% icon_bg = is_approved ? '#dcfce7' : '#fee2e2' %>
<% icon_class = is_approved ? 'ri-check-double-line text-success' : 'ri-close-circle-line text-danger' %>
<% status_class = is_approved ? 'text-success' : 'text-danger' %>

<%# Replace the focus card with compact result %>
<%= turbo_stream.replace "focus-consent-#{@consent.consent_token}" do %>
  <div class="consent-focus-card d-flex align-items-center gap-3 py-3 px-3" style="border-color: <%= status_color %>; background: <%= status_bg %>;">
    <div class="flex-shrink-0">
      <div class="d-flex align-items-center justify-content-center rounded-circle"
           style="width:48px; height:48px; background:<%= icon_bg %>;">
        <i class="<%= icon_class %>" style="font-size:1.5rem;"></i>
      </div>
    </div>
    <div class="flex-grow-1">
      <p class="fw-bold mb-0 <%= status_class %>" style="font-family:'Montserrat',sans-serif; font-size:0.95rem;">
        <%= is_approved ? t("transaction_consents.tabs.approved") : t("transaction_consents.tabs.denied") %>
      </p>
      <p class="text-muted small mb-0">
        <%= is_approved ?
          t("transaction_consents.approved_message", partner: @consent.partner.name) :
          t("transaction_consents.denied_message", partner: @consent.partner.name) %>
      </p>
    </div>
    <% if @consent.amount.present? && @consent.amount > 0 %>
      <div class="flex-shrink-0 text-end">
        <span class="fw-bold" style="font-family:'Montserrat',sans-serif; color:var(--primary); font-size:1.1rem;">
          <%= number_to_currency(@consent.amount, unit: @consent.currency == "HTG" ? "G " : "$ ", precision: 0) %>
        </span>
      </div>
    <% end %>
  </div>
<% end %>

<%# Update the card in the history list %>
<%= turbo_stream.replace "consent-#{@consent.consent_token}" do %>
  <%= render "citizens/transaction_consents/history_item", consent: @consent %>
<% end %>

<%# Update filter chip counts %>
<%= turbo_stream.update "consent-count-pending" do %><%= @pending_count %><% end %>
<%= turbo_stream.update "consent-count-approved" do %><%= @approved_count %><% end %>
<%= turbo_stream.update "consent-count-denied" do %><%= @denied_count %><% end %>
<%= turbo_stream.update "consent-count-expired" do %><%= @expired_count %><% end %>

<%# Show flash notice %>
<% if flash[:notice] %>
  <%= turbo_stream.prepend "flash-messages" do %>
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-3" style="border: 1px solid <%= status_color %>;" role="alert">
      <i class="<%= icon_class %> me-2"></i><%= flash[:notice] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>
<% end %>
