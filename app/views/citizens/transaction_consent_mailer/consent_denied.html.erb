<%# Transaction Consent Denied Confirmation %>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0">
  <tr>
    <td style="text-align:center; padding-bottom:16px;">
      <div style="font-family:'Montserrat','Inter',Arial,sans-serif; font-size:18px; font-weight:700; color:#dc2626;">
        <%= t("mailers.transaction_consent.consent_denied.heading") %>
      </div>
    </td>
  </tr>

  <tr>
    <td style="padding-bottom:16px; text-align:center;">
      <div style="font-family:'Inter',Arial,sans-serif; font-size:14px; color:#0F172A;">
        <%= t("mailers.transaction_consent.consent_denied.body_html",
              partner_name: @partner.name,
              transaction_type: t("transaction_consents.types.#{@consent.transaction_type}", default: @consent.transaction_type.titleize)).html_safe %>
      </div>
    </td>
  </tr>

  <tr>
    <td style="padding-bottom:16px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
             style="background:#fef2f2; border-radius:10px; border:1px solid rgba(220,38,38,0.15);">
        <tr>
          <td style="padding:12px; text-align:center;">
            <div style="font-family:'Inter',Arial,sans-serif; font-size:12px; color:#64748b;">
              <%= t("mailers.transaction_consent.consent_denied.denied_at") %> <strong><%= @consent.decided_at&.strftime("%B %d, %Y at %I:%M %p") %></strong>
            </div>
            <div style="font-family:'Inter',Arial,sans-serif; font-size:12px; color:#64748b; margin-top:4px;">
              <%= t("mailers.transaction_consent.consent_denied.reference") %> <strong><%= @consent.reference_id || "N/A" %></strong>
            </div>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <tr>
    <td style="padding-top:8px; border-top:1px solid #e2e8f0;">
      <div style="font-family:'Inter',Arial,sans-serif; font-size:12px; color:#94a3b8; text-align:center; padding-top:12px;">
        <%= t("mailers.transaction_consent.consent_denied.partner_notified") %>
        <br>
        <%= t("mailers.transaction_consent.consent_denied.support_warning") %>
      </div>
    </td>
  </tr>
</table>
