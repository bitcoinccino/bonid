<%# app/views/citizens/shared/_sidebar_content.html.erb %>

<%# Navigation links — matches partner portal sidebar style %>
<ul class="nav flex-column sidebar-nav">

  <%# ── OPERASYON ────────────────────────────── %>
  <li class="sidebar-section-label">Operasyon</li>

  <li class="nav-item">
    <%= link_to citizens_dashboard_path,
                class: "nav-link #{'active' if current_page?(citizens_dashboard_path) || current_page?(citizens_root_path)}" do %>
      <i class="ri-dashboard-line"></i>
      <span>Dashboard</span>
    <% end %>
  </li>

  <li class="nav-item">
    <%= link_to citizens_activity_path,
                class: "nav-link #{'active' if request.path.start_with?(citizens_activity_path)}" do %>
      <i class="ri-pulse-line"></i>
      <span>Aktivite</span>
    <% end %>
  </li>

  <%# ── Mobile-only: Sèvis and Aplikasyon Mwen also appear in the desktop topbar ── %>
  <li class="nav-item d-lg-none">
    <%= link_to citizens_services_path,
                class: "nav-link #{'active' if request.path.start_with?(citizens_services_path)}" do %>
      <i class="ri-apps-2-line"></i>
      <span>Sèvis</span>
    <% end %>
  </li>

  <li class="nav-item d-lg-none">
    <%= link_to citizens_service_applications_path,
                class: "nav-link #{'active' if request.path.start_with?(citizens_service_applications_path) || request.path.include?('/apply/')}" do %>
      <i class="ri-file-list-3-line"></i>
      <span>Aplikasyon Mwen</span>
      <% draft_count = current_citizen&.service_applications&.drafts&.count || 0 %>
      <% if draft_count > 0 %>
        <span class="badge bg-warning text-dark ms-auto"><%= draft_count %></span>
      <% end %>
    <% end %>
  </li>

  <%# ── ELEKSYON ──────────────────────────────
      Links are ordered + badged based on the active election's lifecycle
      (draft → open → closed → certified) by CitizenElectionSidebarPresenter.
      The "Vote" link carries a live day-countdown so every login reinforces
      the election date. %>
  <li class="sidebar-section-label">Eleksyon</li>

  <% CitizenElectionSidebarPresenter.for_today.links.each do |link| %>
    <li class="nav-item">
      <%= link_to link.path,
                  class: "nav-link #{'active' if request.path.include?(link.active_match)}" do %>
        <i class="<%= link.icon %>"></i>
        <span><%= link.label %></span>
        <% if link.badge.present? %>
          <span class="sidebar-badge <%= link.badge_class %>"><%= link.badge %></span>
        <% end %>
      <% end %>
    </li>
  <% end %>

  <%# ── SIPÒ ────────────────────────────── %>
  <li class="sidebar-section-label">Sipò</li>

  <li class="nav-item">
    <%= link_to citizens_officer_complaints_path,
                class: "nav-link #{'active' if request.path.start_with?(citizens_officer_complaints_path)}" do %>
      <i class="ri-file-shield-2-line"></i>
      <span>Plent</span>
    <% end %>
  </li>

  <li class="nav-item">
    <%= link_to citizens_support_path,
                class: "nav-link #{'active' if current_page?(citizens_support_path)}" do %>
      <i class="ri-customer-service-2-line"></i>
      <span>Sipò</span>
    <% end %>
  </li>
</ul>

<%# Logout button %>
<div class="sidebar-logout">
  <%= button_to destroy_citizen_session_path,
                method: :delete,
                class: "logout-btn",
                data: { turbo: false } do %>
    <i class="ri-logout-box-r-line"></i>
    <span>Dekonekte</span>
  <% end %>
</div>
