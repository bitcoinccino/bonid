<%# app/views/citizens/shared/_sidebar_content.html.erb %>

<%# Profile section - centered vertically %>
<div class="citizen-logo-section">
  <div class="citizen-logo-wrapper">
    <% if current_citizen&.photo&.attached? %>
      <%= image_tag url_for(current_citizen.photo),
                    class: "citizen-logo-img",
                    alt: "#{current_citizen&.full_name} photo",
                    style: "width: 120px; height: 120px; object-fit: cover; object-position: center top;" %>
    <% else %>
      <div class="citizen-logo-placeholder">
        <i class="ri-user-line"></i>
      </div>
    <% end %>
  </div>
  <div class="citizen-name"><%= current_citizen&.full_name || "Citizen" %></div>
  <% if current_citizen&.identity_submissions&.approved&.exists? %>
    <div class="citizen-status">
      <i class="ri-verified-badge-fill text-success me-1"></i>Verified
    </div>
  <% else %>
    <div class="citizen-status text-muted">Pending Verification</div>
  <% end %>
</div>

<%# Navigation links %>
<ul class="nav flex-column sidebar-nav">
  <%# 1. Dashboard %>
  <li class="nav-item">
    <%= link_to citizens_dashboard_path,
                class: "nav-link #{'active' if current_page?(citizens_dashboard_path) || current_page?(citizens_root_path)}" do %>
      <i class="ri-dashboard-line"></i>
      <span>Dashboard</span>
    <% end %>
  </li>

  <%# 2. BonID Scans %>
  <li class="nav-item">
    <%= link_to scan_history_citizens_identity_submissions_path,
                class: "nav-link #{'active' if current_page?(scan_history_citizens_identity_submissions_path)}" do %>
      <i class="ri-qr-scan-2-line"></i>
      <span>BonID Scans</span>
      <% if @total_scans && @total_scans > 0 %>
        <span class="badge bg-danger ms-auto"><%= @total_scans %></span>
      <% end %>
    <% end %>
  </li>

  <%# 3. Manage BonID %>
  <li class="nav-item">
    <%= link_to citizens_consents_path,
                class: "nav-link #{'active' if request.path.start_with?(citizens_consents_path)}" do %>
      <i class="ri-id-card-line"></i>
      <span>Manage BonID</span>
    <% end %>
  </li>

  <%# 4. Transaction Approvals %>
  <li class="nav-item">
    <%= link_to citizens_transaction_consents_path,
                class: "nav-link #{'active' if request.path.start_with?(citizens_transaction_consents_path)}" do %>
      <i class="ri-exchange-funds-line"></i>
      <span>Transactions</span>
      <% pending_txn = Rails.cache.fetch("citizen_pending_txn_#{current_citizen&.id}", expires_in: 30.seconds) { current_citizen&.transaction_consents&.active&.count || 0 } %>
      <% if pending_txn > 0 %>
        <span class="badge bg-danger ms-auto"><%= pending_txn %></span>
      <% end %>
    <% end %>
  </li>

  <%# 5. Name Change (only for verified citizens) %>
  <% if current_citizen&.identity_submissions&.approved&.exists? %>
    <li class="nav-item">
      <%= link_to new_citizens_name_change_request_path,
                  class: "nav-link #{'active' if request.path.start_with?('/citizens/name_change_requests')}" do %>
        <i class="ri-edit-line"></i>
        <span>Name Change</span>
      <% end %>
    </li>
  <% end %>

  <%# 5. File a Complaint %>
  <li class="nav-item">
    <%= link_to citizens_officer_complaints_path,
                class: "nav-link #{'active' if request.path.start_with?(citizens_officer_complaints_path)}" do %>
      <i class="ri-file-shield-2-line"></i>
      <span>File a Complaint</span>
    <% end %>
  </li>

  <%# 5. Support %>
  <li class="nav-item">
    <%= link_to citizens_support_path,
                class: "nav-link #{'active' if current_page?(citizens_support_path)}" do %>
      <i class="ri-customer-service-2-line"></i>
      <span>Support</span>
    <% end %>
  </li>
</ul>

<%# Logout button %>
<div class="sidebar-logout">
  <%= button_to destroy_citizen_session_path,
                method: :delete,
                class: "logout-btn",
                data: { turbo: false } do %>
    <i class="ri-logout-box-r-line"></i>
    <span>Log Out</span>
  <% end %>
</div>
