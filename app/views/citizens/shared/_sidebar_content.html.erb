<%# app/views/citizens/shared/_sidebar_content.html.erb %>

<%# Navigation links — matches partner portal sidebar style %>
<ul class="nav flex-column sidebar-nav">

  <%# ── OPERASYON ────────────────────────────── %>
  <li class="sidebar-section-label">Operasyon</li>

  <li class="nav-item">
    <%= link_to citizens_dashboard_path,
                class: "nav-link #{'active' if current_page?(citizens_dashboard_path) || current_page?(citizens_root_path)}" do %>
      <i class="ri-dashboard-line"></i>
      <span>Dashboard</span>
    <% end %>
  </li>

  <li class="nav-item">
    <%= link_to citizens_services_path,
                class: "nav-link #{'active' if request.path.start_with?(citizens_services_path)}" do %>
      <i class="ri-apps-2-line"></i>
      <span>Sèvis</span>
    <% end %>
  </li>

  <li class="nav-item">
    <%= link_to citizens_service_applications_path,
                class: "nav-link #{'active' if request.path.start_with?(citizens_service_applications_path) || request.path.include?('/apply/')}" do %>
      <i class="ri-file-list-3-line"></i>
      <span>Aplikasyon Mwen</span>
      <% draft_count = current_citizen&.service_applications&.drafts&.count || 0 %>
      <% if draft_count > 0 %>
        <span class="badge bg-warning text-dark ms-auto"><%= draft_count %></span>
      <% end %>
    <% end %>
  </li>

  <li class="nav-item">
    <%= link_to scan_history_citizens_identity_submissions_path,
                class: "nav-link #{'active' if current_page?(scan_history_citizens_identity_submissions_path)}" do %>
      <i class="ri-qr-scan-2-line"></i>
      <span>BonID Scans</span>
      <% if @total_scans && @total_scans > 0 %>
        <span class="badge bg-danger ms-auto"><%= @total_scans %></span>
      <% end %>
    <% end %>
  </li>

  <li class="nav-item">
    <%= link_to citizens_consents_path,
                class: "nav-link #{'active' if request.path.start_with?(citizens_consents_path)}" do %>
      <i class="ri-id-card-line"></i>
      <span>Manage BonID</span>
    <% end %>
  </li>

  <li class="nav-item">
    <%= link_to citizens_transaction_consents_path,
                class: "nav-link #{'active' if request.path.start_with?(citizens_transaction_consents_path)}" do %>
      <i class="ri-exchange-funds-line"></i>
      <span>Transactions</span>
      <% pending_txn = Rails.cache.fetch("citizen_pending_txn_#{current_citizen&.id}", expires_in: 30.seconds) { current_citizen&.transaction_consents&.active&.count || 0 } %>
      <% if pending_txn > 0 %>
        <span class="badge bg-danger ms-auto"><%= pending_txn %></span>
      <% end %>
    <% end %>
  </li>

  <%# ── ELEKSYON ────────────────────────────── %>
  <li class="sidebar-section-label">Eleksyon</li>

  <li class="nav-item">
    <%= link_to citizens_election_vote_path,
                class: "nav-link #{'active' if request.path.include?('election/vote')}" do %>
      <i class="ri-checkbox-circle-line"></i>
      <span>Vote</span>
    <% end %>
  </li>

  <li class="nav-item">
    <%= link_to citizens_election_calendar_path,
                class: "nav-link #{'active' if request.path.include?('election/kalandriye')}" do %>
      <i class="ri-calendar-event-line"></i>
      <span>Kalandriye</span>
    <% end %>
  </li>

  <li class="nav-item">
    <%= link_to citizens_election_verify_path,
                class: "nav-link #{'active' if request.path.include?('election/verifye')}" do %>
      <i class="ri-shield-check-line"></i>
      <span>Verifye Vòt Mwen</span>
    <% end %>
  </li>

  <li class="nav-item">
    <%= link_to citizens_election_results_path,
                class: "nav-link #{'active' if request.path.include?('election/rezilta')}" do %>
      <i class="ri-bar-chart-box-line"></i>
      <span>Rezilta</span>
    <% end %>
  </li>

  <%# ── SIPÒ ────────────────────────────── %>
  <li class="sidebar-section-label">Sipò</li>

  <li class="nav-item">
    <%= link_to citizens_officer_complaints_path,
                class: "nav-link #{'active' if request.path.start_with?(citizens_officer_complaints_path)}" do %>
      <i class="ri-file-shield-2-line"></i>
      <span>Plent</span>
    <% end %>
  </li>

  <li class="nav-item">
    <%= link_to citizens_support_path,
                class: "nav-link #{'active' if current_page?(citizens_support_path)}" do %>
      <i class="ri-customer-service-2-line"></i>
      <span>Sipò</span>
    <% end %>
  </li>
</ul>

<%# Logout button %>
<div class="sidebar-logout">
  <%= button_to destroy_citizen_session_path,
                method: :delete,
                class: "logout-btn",
                data: { turbo: false } do %>
    <i class="ri-logout-box-r-line"></i>
    <span>Dekonekte</span>
  <% end %>
</div>
