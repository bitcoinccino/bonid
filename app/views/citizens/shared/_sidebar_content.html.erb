<%# app/views/citizens/shared/_sidebar_content.html.erb %>

<%# Navigation links — matches partner portal sidebar style %>
<ul class="nav flex-column sidebar-nav">

  <%# ── OPERASYON ────────────────────────────── %>
  <li class="sidebar-section-label"><%= t("citizen_portal.nav.operations") %></li>

  <li class="nav-item">
    <%= link_to citizens_dashboard_path,
                class: "nav-link #{'active' if nav_path_active?(citizens_dashboard_path) || nav_path_active?(citizens_root_path, exact: true)}" do %>
      <i class="ri-home-5-line"></i>
      <span><%= t("citizen_portal.nav.dashboard") %></span>
    <% end %>
  </li>

  <%# Konsantman — approve/deny partner transaction requests. Badge = requests
      still waiting (they expire in 5–15 min, so citizens need to see them). %>
  <li class="nav-item">
    <%= link_to citizens_transaction_consents_path,
                class: "nav-link #{'active' if nav_path_active?(citizens_transaction_consents_path) || nav_path_active?(citizens_consents_path)}" do %>
      <i class="ri-shield-check-line"></i>
      <span><%= t("citizen_portal.nav.consents") %></span>
      <% pending_consents = current_citizen&.transaction_consents&.active&.count.to_i %>
      <% if pending_consents > 0 %>
        <span class="badge bg-warning text-dark ms-auto"><%= pending_consents %></span>
      <% end %>
    <% end %>
  </li>

  <li class="nav-item">
    <%= link_to citizens_activity_path,
                class: "nav-link #{'active' if nav_path_active?(citizens_activity_path)}" do %>
      <i class="ri-pulse-line"></i>
      <span><%= t("citizen_portal.nav.activity") %></span>
    <% end %>
  </li>

  <%# ── Mobile-only: Sèvis and Aplikasyon Mwen also appear in the desktop topbar ── %>
  <%# NOTE: paused for the v1 launch: no partner has published an application  %>
  <%# form yet. Re-enable with CITIZEN_SERVICES_ENABLED=true (see              %>
  <%# app/controllers/concerns/citizen_services_pausable.rb).                 %>
  <% if citizen_services_enabled? %>
  <li class="nav-item d-lg-none">
    <%= link_to citizens_services_path,
                class: "nav-link #{'active' if nav_path_active?(citizens_services_path)}" do %>
      <i class="ri-apps-2-line"></i>
      <span><%= t("citizen_portal.nav.services") %></span>
    <% end %>
  </li>

  <li class="nav-item d-lg-none">
    <%= link_to citizens_service_applications_path,
                class: "nav-link #{'active' if nav_path_active?(citizens_service_applications_path) || request.path.include?('/apply/')}" do %>
      <i class="ri-file-list-3-line"></i>
      <span><%= t("citizen_portal.nav.my_applications") %></span>
      <% draft_count = current_citizen&.service_applications&.drafts&.count || 0 %>
      <% if draft_count > 0 %>
        <span class="badge bg-warning text-dark ms-auto"><%= draft_count %></span>
      <% end %>
    <% end %>
  </li>
  <% end %>

  <%# ── ELEKSYON ──────────────────────────────
      Links are ordered + badged based on the active election's lifecycle
      (draft → open → closed → certified) by CitizenElectionSidebarPresenter.
      The "Vote" link carries a live day-countdown so every login reinforces
      the election date. %>
  <li class="sidebar-section-label"><%= t("citizen_portal.nav.election") %></li>

  <% CitizenElectionSidebarPresenter.for_today.links.each do |link| %>
    <li class="nav-item">
      <%= link_to link.path,
                  class: "nav-link #{'active' if request.path.include?(link.active_match)}" do %>
        <i class="<%= link.icon %>"></i>
        <span><%= link.label %></span>
        <% if link.badge.present? %>
          <span class="sidebar-badge <%= link.badge_class %>"><%= link.badge %></span>
        <% end %>
      <% end %>
    </li>
  <% end %>

  <%# ── SIPÒ ────────────────────────────── %>
  <li class="sidebar-section-label"><%= t("citizen_portal.nav.support_section") %></li>

  <% if idpol_extras_enabled? %>
    <li class="nav-item">
      <%= link_to citizens_officer_complaints_path,
                  class: "nav-link #{'active' if nav_path_active?(citizens_officer_complaints_path)}" do %>
        <i class="ri-file-shield-2-line"></i>
        <span><%= t("citizen_portal.nav.complaints") %></span>
      <% end %>
    </li>
  <% end %>

  <li class="nav-item">
    <%= link_to citizens_support_path,
                class: "nav-link #{'active' if nav_path_active?(citizens_support_path)}" do %>
      <i class="ri-customer-service-2-line"></i>
      <span><%= t("citizen_portal.nav.support") %></span>
    <% end %>
  </li>
</ul>

<%# Logout button %>
<div class="sidebar-logout">
  <%= button_to destroy_citizen_session_path,
                method: :delete,
                class: "logout-btn",
                data: { turbo: false } do %>
    <i class="ri-logout-box-r-line"></i>
    <span><%= t("citizen_portal.nav.sign_out") %></span>
  <% end %>
</div>
