<% path = local_assigns[:dashboard_path] || citizens_dashboard_path %>

<div class="card shadow-sm rounded-3">
  <div class="card-body">
    <p class="text-muted small">
      Submission for <%= role.to_s.humanize %>
    </p>

    <!-- Submission details -->
    <%= render "shared/submission_status_card", submission: submission %>

    <div class="mt-3">
      <%= link_to "Back to Dashboard",
                  path,
                  class: "btn btn-secondary btn-sm rounded-3" %>
    </div>
  </div>
</div>
