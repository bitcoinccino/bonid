<!-- Mobile Offcanvas Sidebar — VISIBLE ON SMALL SCREENS -->
<div class="offcanvas offcanvas-start bg-white" 
     tabindex="-1" 
     id="sidebarOffcanvas" 
     aria-labelledby="sidebarOffcanvasLabel">
  <div class="offcanvas-header justify-content-end">
    <%# Title hidden visually; kept for screen readers (labels the menu). %>
    <h5 class="offcanvas-title visually-hidden" id="sidebarOffcanvasLabel"><%= t("citizen_portal.nav.menu") %></h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="<%= t("citizen_portal.nav.close") %>"></button>
  </div>
  <div class="offcanvas-body p-0">
    <div class="d-flex flex-column h-100 citizen-sidebar-nav">
      <%= render "citizens/shared/sidebar_content" %>
    </div>
  </div>
</div>

<!-- Desktop Sidebar — VISIBLE ONLY ON LARGE SCREENS (CSS handles visibility) -->
<aside id="citizen-sidebar" class="citizen-sidebar citizen-sidebar-nav">
  <%= render "citizens/shared/sidebar_content" %>
</aside>