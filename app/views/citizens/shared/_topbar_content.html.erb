<%# Citizen Topbar — matches partner navbar style %>
<nav id="citizen-topbar" class="navbar fixed-top px-3"
     style="background: linear-gradient(135deg, var(--primary) 0%, #001570 100%); border-bottom: 4px solid #D21034;">
  <div class="container-fluid justify-content-between align-items-center">

    <%# Left: Mobile Sidebar Toggle only %>
    <div class="d-flex align-items-center gap-3">
      <button class="btn d-lg-none text-white p-0"
              type="button"
              data-bs-toggle="offcanvas"
              data-bs-target="#sidebarOffcanvas"
              aria-controls="sidebarOffcanvas"
              aria-label="Toggle sidebar">
        <i class="ri-menu-line ri-xl"></i>
      </button>
    </div>

    <style>
      /* Single "Menu" icon that groups the system-level links
         (Sèvis, Aplikasyon Mwen). Shown on desktop only — mobile users
         reach these via the hamburger → sidebar. */
      .citizen-topbar-menu-btn {
        display: none;
      }
      @media (min-width: 992px) {
        .citizen-topbar-menu-btn { display: inline-flex !important; }
      }
      .citizen-topbar-menu-btn {
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        padding: 0;
        border-radius: 0.55rem;
        background: rgba(255, 255, 255, 0.10);
        color: #fff !important;
        border: none;
        position: relative;
        transition: background 0.15s ease-in-out;
      }
      .citizen-topbar-menu-btn:hover,
      .citizen-topbar-menu-btn[aria-expanded="true"] {
        background: rgba(255, 255, 255, 0.22);
      }
      .citizen-topbar-menu-btn i { font-size: 1.2rem; }

      .citizen-topbar-menu-badge {
        position: absolute;
        top: 2px;
        right: 2px;
        min-width: 0.95rem;
        height: 0.95rem;
        padding: 0 0.25rem;
        font-size: 0.55rem;
        font-weight: 700;
        background: #FBBF24;
        color: #78350F;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #001570;
      }

      .citizen-topbar-menu-panel {
        min-width: 240px;
        padding: 0.4rem;
        border: 1px solid rgba(0, 32, 159, 0.12);
        border-radius: 0.85rem;
        box-shadow: 0 12px 32px rgba(15, 23, 42, 0.12);
      }
      .citizen-topbar-menu-item {
        display: flex !important;
        align-items: center;
        gap: 0.65rem;
        padding: 0.6rem 0.75rem !important;
        border-radius: 0.55rem !important;
        font-size: 0.88rem;
        font-weight: 600;
        color: #1E293B !important;
        transition: background 0.12s ease-in-out;
      }
      .citizen-topbar-menu-item i {
        font-size: 1.1rem;
        color: #00209F;
      }
      .citizen-topbar-menu-item:hover {
        background: rgba(0, 32, 159, 0.08) !important;
      }
      .citizen-topbar-menu-item--active {
        background: rgba(0, 32, 159, 0.1) !important;
        color: #00209F !important;
      }
      .citizen-topbar-menu-item .badge {
        margin-left: auto;
      }

      /* ── Inline primary nav links (Sèvis / Aplikasyon Mwen) ─────────────
         Shown on desktop (≥992px). On mobile these links are reached via
         the hamburger → sidebar, so we hide them to avoid duplication. */
      .citizen-topbar-nav {
        display: none;
      }
      @media (min-width: 992px) {
        .citizen-topbar-nav {
          display: inline-flex;
          align-items: center;
          gap: 0.25rem;
        }
      }
      .citizen-topbar-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.75rem;
        border-radius: 0.55rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.85) !important;
        text-decoration: none;
        line-height: 1;
        position: relative;
        transition: background 0.15s ease-in-out, color 0.15s ease-in-out;
      }
      .citizen-topbar-link i {
        font-size: 1.05rem;
      }
      .citizen-topbar-link:hover,
      .citizen-topbar-link:focus {
        background: rgba(255, 255, 255, 0.12);
        color: #fff !important;
      }
      .citizen-topbar-link--active {
        background: rgba(255, 255, 255, 0.18);
        color: #fff !important;
      }
      .citizen-topbar-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 1.1rem;
        height: 1.1rem;
        padding: 0 0.35rem;
        font-size: 0.62rem;
        font-weight: 700;
        background: #FBBF24;
        color: #78350F;
        border-radius: 999px;
        margin-left: 0.1rem;
      }
    </style>

    <%# Right: Primary nav links (desktop) + Greeting + Notifications + Profile %>
    <% if current_citizen %>
      <div class="d-flex align-items-center gap-3">

        <%# Primary nav links — desktop only, shown at the right side of the navbar %>
        <div class="citizen-topbar-nav">
          <%= link_to citizens_services_path,
                      class: "citizen-topbar-link #{'citizen-topbar-link--active' if request.path.start_with?(citizens_services_path)}" do %>
            <i class="ri-apps-2-line"></i>
            <span>Sèvis</span>
          <% end %>

          <%= link_to citizens_service_applications_path,
                      class: "citizen-topbar-link #{'citizen-topbar-link--active' if request.path.start_with?(citizens_service_applications_path) || request.path.include?('/apply/')}" do %>
            <i class="ri-file-list-3-line"></i>
            <span>Aplikasyon Mwen</span>
            <% draft_count = current_citizen&.service_applications&.drafts&.count || 0 %>
            <% if draft_count > 0 %>
              <span class="citizen-topbar-badge"><%= draft_count %></span>
            <% end %>
          <% end %>
        </div>

        <span class="d-none d-md-inline" style="font-size: 0.82rem; color: rgba(255,255,255,0.7);">
          Byenveni, <strong style="color: #fff;"><%= current_citizen.first_name || "Sitwayen" %></strong>
        </span>

        <%# Notifications %>
        <%
          total_alerts = Rails.cache.fetch("citizen_alerts_#{current_citizen.id}", expires_in: 30.seconds) do
            n = current_citizen.notifications.unread.count rescue 0
            t = current_citizen.transaction_consents.where(status: :pending).where("expires_at > ?", Time.current).count rescue 0
            b = (current_citizen.identity_submissions.order(created_at: :desc).pick(:status) == "rejected") ? 1 : 0 rescue 0
            n + t + b
          end
        %>
        <%= link_to citizens_transaction_consents_path, class: "text-white position-relative text-decoration-none" do %>
          <i class="ri-notification-3-line fs-4"></i>
          <% if total_alerts.positive? %>
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger small">
              <%= total_alerts > 99 ? "99+" : total_alerts %>
            </span>
          <% end %>
        <% end %>

        <%# Profile Dropdown %>
        <div class="dropdown">
          <a class="d-flex align-items-center text-white text-decoration-none"
             href="#"
             id="citizenDropdown"
             role="button"
             data-bs-toggle="dropdown"
             aria-expanded="false">
            <% if current_citizen.photo.attached? %>
              <%= image_tag url_for(current_citizen.photo),
                    class: "rounded-circle shadow-sm",
                    style: "width: 36px; height: 36px; object-fit: cover; border: 2px solid rgba(255,255,255,0.3);",
                    alt: "#{current_citizen.full_name || 'Citizen'}" %>
            <% else %>
              <div class="rounded-circle d-flex justify-content-center align-items-center shadow-sm"
                   style="width: 36px; height: 36px; border: 2px solid rgba(255,255,255,0.3); background: rgba(255,255,255,0.15);">
                <i class="ri-user-line ri-lg text-white"></i>
              </div>
            <% end %>
          </a>

          <ul class="dropdown-menu dropdown-menu-end mt-2 shadow-sm" aria-labelledby="citizenDropdown"
              style="border: 1px solid rgba(0,32,159,0.12); border-radius: 0.75rem;">
            <li class="px-3 py-2 border-bottom">
              <div class="fw-semibold"><%= current_citizen.full_name || "Sitwayen" %></div>
              <small class="text-muted">BonID Portal</small>
            </li>
            <li>
              <%= link_to citizens_dashboard_path, class: "dropdown-item" do %>
                <i class="ri-dashboard-line me-2"></i> Dashboard
              <% end %>
            </li>
            <li>
              <%= link_to edit_citizens_profile_path, class: "dropdown-item" do %>
                <i class="ri-user-line me-2"></i> Profile
              <% end %>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <%= button_to destroy_citizen_session_path,
                  method: :delete,
                  class: "dropdown-item text-danger",
                  data: { turbo: false } do %>
                <i class="ri-logout-box-r-line me-2"></i> Log Out
              <% end %>
            </li>
          </ul>
        </div>
      </div>
    <% end %>

  </div>
</nav>
