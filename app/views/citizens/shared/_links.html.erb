<div class="text-center mt-3">
  <!-- Login Link -->
  <%= link_to " Log In",
              login_path,
              class: "citizen-link small d-block mb-2" %>

  <!-- Partner-Aware Registration Link -->
  <% if params[:partner].present? %>
    <%= link_to "New to BonID? Register",
                signup_path(partner: params[:partner]),
                class: "citizen-link small" %>
  <% end %>
</div>
