<div class="text-center mt-3">
  <!-- Login Link -->
  <%= link_to " Log In",
              citizens_otp_sign_in_path,
              class: "text-primary small text-decoration-none fw-semibold d-block mb-2" %>

  <!-- Partner-Aware Registration Link -->
  <% if params[:partner].present? %>
    <%= link_to "New to BonID? Register",
                new_citizen_registration_path(partner: params[:partner]),
                class: "text-primary small text-decoration-none fw-semibold" %>
  <% end %>
</div>
