<% content_for :title, "Signed out everywhere – BonID" %>

<div class="login-card">
  <div class="text-center mb-4">
    <div class="auth-icon-badge">
      <i class="ri-checkbox-circle-line"></i>
    </div>
  </div>

  <h1 class="h4 fw-bold text-center mb-2">You're signed out everywhere</h1>
  <p class="text-muted text-center small mb-4">
    Every device has been signed out of your BonID and unused login codes were cancelled.
  </p>

  <div class="auth-privacy-note mb-4">
    <i class="ri-alert-line"></i><strong>Change your email password now.</strong>
    BonID sign-in codes go to your email, so whoever got in may still be able to read it.
  </div>

  <%= link_to "Sign in again", login_path, class: "btn btn-haitian-primary w-100" %>

  <div class="auth-help-link">
    <a href="mailto:support@bonid.ht">Need help?</a>
  </div>
</div>
