<% content_for :title, t("citizen_portal.revocation.done_page_title") %>

<div class="login-card">
  <div class="text-center mb-4">
    <div class="auth-icon-badge">
      <i class="ri-checkbox-circle-line"></i>
    </div>
  </div>

  <h1 class="h4 fw-bold text-center mb-2"><%= t("citizen_portal.revocation.done_title") %></h1>
  <p class="text-muted text-center small mb-4">
    <%= t("citizen_portal.revocation.done_body") %>
  </p>

  <div class="auth-privacy-note mb-4">
    <i class="ri-alert-line"></i><%= t("citizen_portal.revocation.done_warning_html") %>
  </div>

  <%= link_to t("citizen_portal.revocation.sign_in_again"), login_path, class: "btn btn-haitian-primary w-100" %>

  <div class="auth-help-link">
    <a href="mailto:support@bonid.ht"><%= t("citizen_portal.revocation.need_help") %></a>
  </div>
</div>
