<% content_for :title, t("citizen_portal.revocation.page_title") %>

<div class="login-card">
  <div class="text-center mb-4">
    <div class="auth-icon-badge">
      <i class="ri-shield-keyhole-line"></i>
    </div>
  </div>

  <% if @valid %>
    <h1 class="h4 fw-bold text-center mb-2"><%= t("citizen_portal.revocation.confirm_title") %></h1>
    <p class="text-muted text-center small mb-4">
      <%= t("citizen_portal.revocation.confirm_body") %>
    </p>

    <%= form_with url: citizens_session_revocation_path, method: :post, local: true,
                  html: { data: { turbo: false } } do %>
      <%= hidden_field_tag :token, @token %>
      <%= submit_tag t("citizen_portal.revocation.sign_out_everywhere"),
            class: "btn btn-haitian-primary w-100",
            data: { disable_with: t("citizen_portal.revocation.signing_out") } %>
    <% end %>

    <div class="auth-privacy-note mt-3">
      <i class="ri-lock-line"></i><%= t("citizen_portal.revocation.change_password_note") %>
    </div>
  <% else %>
    <h1 class="h4 fw-bold text-center mb-2"><%= t("citizen_portal.revocation.expired_title") %></h1>
    <p class="text-muted text-center small mb-4">
      <%= t("citizen_portal.revocation.expired_body") %>
    </p>
    <%= link_to t("citizen_portal.revocation.go_sign_in"), login_path, class: "btn btn-ghost-haitian w-100" %>
  <% end %>

  <div class="auth-help-link">
    <a href="mailto:support@bonid.ht"><%= t("citizen_portal.revocation.need_help") %></a>
  </div>
</div>
