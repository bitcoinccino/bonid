<% content_for :title, t("mailers.consent.request_notification.page_title") %>

<div style="font-family:'Inter',Arial,sans-serif; color:#101828;">
  <div style="margin:0 0 10px;">
    <div style="font-family:'Montserrat','Inter',Arial,sans-serif; font-weight:800; font-size:18px; color:#00209F; margin:0;">
      <%= t("mailers.consent.request_notification.heading") %> 🔐
    </div>
    <div style="margin-top:6px; font-size:13px; color:#475467; line-height:1.6;">
      <%= t("mailers.consent.request_notification.subtitle") %>
    </div>
  </div>

  <div style="margin:14px 0 12px; font-size:14px; line-height:1.75; color:#101828;">
    <p style="margin:0 0 10px;">
      <%= t("mailers.consent.request_notification.greeting", first_name: @citizen.first_name) %>
    </p>

    <p style="margin:0 0 10px;">
      <strong><%= @partner.name %></strong> <%= t("mailers.consent.request_notification.request_access") %>
    </p>
  </div>

  <!-- SCOPES (chips) -->
  <div style="margin:10px 0 14px;">
    <% @grant.requested_scopes.each do |scope| %>
      <span style="display:inline-block; margin:0 8px 8px 0; padding:8px 12px;
                   background:#eef2ff; border:1px solid rgba(0,32,159,0.16);
                   border-radius:999px; color:#00209F; font-weight:800; font-size:12px;">
        <%= scope.to_s.humanize %>
      </span>
    <% end %>
  </div>

  <div style="margin:0 0 12px; font-size:13px; color:#475467; line-height:1.6;">
    <%= t("mailers.consent.request_notification.choose_option") %>
  </div>

  <!-- BUTTONS -->
  <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 10px;">
    <tr>
      <td style="padding:0 10px 10px 0;">
        <a href="<%= api_v1_citizen_approve_consent_url(grant_token: @grant.grant_token, decision: 'approve', scopes: @grant.requested_scopes) %>"
           style="display:inline-block; padding:12px 18px; background:#00209F; color:#ffffff;
                  text-decoration:none; font-weight:900; border-radius:999px;
                  font-family:'Montserrat','Inter',Arial,sans-serif; font-size:14px;">
          <%= t("mailers.consent.request_notification.approve") %> ✅
        </a>
      </td>

      <td style="padding:0 0 10px 0;">
        <a href="<%= api_v1_citizen_approve_consent_url(grant_token: @grant.grant_token, decision: 'reject') %>"
           style="display:inline-block; padding:12px 18px; background:#E53E3E; color:#ffffff;
                  text-decoration:none; font-weight:900; border-radius:999px;
                  font-family:'Montserrat','Inter',Arial,sans-serif; font-size:14px;">
          <%= t("mailers.consent.request_notification.reject") %> ❌
        </a>
      </td>
    </tr>
  </table>

  <div style="margin-top:6px; font-size:12px; color:#475467; line-height:1.6;">
    <%= t("mailers.consent.request_notification.safety_notice") %>
  </div>

  <div style="margin-top:12px; font-size:13px; color:#475467;">
    <%= t("mailers.consent.request_notification.signature") %>
  </div>
</div>
