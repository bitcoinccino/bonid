<% content_for :title, t("mailers.consent.denial_notification.page_title") %>

<div style="font-family:'Inter',Arial,sans-serif; color:#101828;">
  <div style="margin:0 0 10px;">
    <div style="font-family:'Montserrat','Inter',Arial,sans-serif; font-weight:800; font-size:18px; color:#E53E3E; margin:0;">
      <%= t("mailers.consent.denial_notification.heading") %> ❌
    </div>
    <div style="margin-top:6px; font-size:13px; color:#475467; line-height:1.6;">
      <%= t("mailers.consent.denial_notification.subtitle") %>
    </div>
  </div>

  <div style="margin:14px 0 12px; font-size:14px; line-height:1.75;">
    <p style="margin:0 0 10px;">
      <%= t("mailers.consent.denial_notification.greeting", first_name: @grant.citizen.first_name) %>
    </p>

    <p style="margin:0 0 10px;">
      <%= t("mailers.consent.denial_notification.body", partner_name: @grant.partner.name) %>
    </p>

    <p style="margin:0 0 10px;">
      <%= t("mailers.consent.denial_notification.recovery") %>
    </p>
  </div>

  <div style="font-size:13px; line-height:1.6; color:#475467;">
    <%= t("mailers.consent.denial_notification.need_help") %> <a href="mailto:support@verifyem.ht" style="color:#00209F; text-decoration:none; font-weight:800;">support@verifyem.ht</a>
  </div>

  <div style="margin-top:12px; font-size:13px; color:#475467;">
    <%= t("mailers.consent.denial_notification.signature") %>
  </div>
</div>
