<%# app/views/citizens/settings/edit.html.erb
    Settings as two grouped lists of rows:
      * Sekirite  — Imel (opens email-change modal), 2FA (K AP VINI),
                    Jere aparèy (expands device list + sign-out-others)
      * Preferans — Notifikasyon (expands channel picker), Lang (dropdown)
    Every control saves on its own (auto-submit), so there's no global
    Save button. Header chrome matches the Anrejistre wizard. %>
<% sk = "citizen_portal.settings." %>

<style>
  .settings-group { border-radius: 0.85rem; overflow: hidden; }
  .settings-group-head { padding: 1.25rem 1.5rem 0.75rem; }
  .settings-group-title {
    font-family: "Montserrat", sans-serif; font-weight: 700;
    font-size: 1.1rem; color: #0F172A; margin: 0 0 0.2rem;
  }
  .settings-group-desc { font-size: 0.82rem; color: #64748B; line-height: 1.45; margin: 0; }
  .settings-list { border-top: 1px solid #EEF2F7; }

  .settings-row {
    display: flex; align-items: center; gap: 0.9rem;
    width: 100%; padding: 0.95rem 1.5rem;
    background: #fff; border: 0; border-bottom: 1px solid #EEF2F7;
    text-align: left; color: inherit; text-decoration: none;
    transition: background 0.12s ease-in-out;
  }
  .settings-list > :last-child,
  .settings-list > .collapse:last-child { border-bottom: 0; }
  button.settings-row:hover,
  label.settings-row:hover { background: #F8FAFC; }
  button.settings-row:focus-visible {
    outline: 2px solid rgba(0, 32, 159, 0.4); outline-offset: -2px;
  }
  .settings-row.is-disabled { cursor: default; }
  .settings-row.is-disabled .settings-row-icon,
  .settings-row.is-disabled .settings-row-label { opacity: 0.6; }

  .settings-row-icon {
    flex-shrink: 0; width: 38px; height: 38px; border-radius: 0.6rem;
    display: inline-flex; align-items: center; justify-content: center;
    background: rgba(0, 32, 159, 0.07); color: var(--primary);
    font-size: 1.15rem;
  }
  .settings-row-text { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; }
  .settings-row-label {
    font-weight: 600; font-size: 0.9rem; color: #0F172A;
    display: flex; align-items: center; gap: 0.5rem;
  }
  .settings-row-value {
    font-size: 0.78rem; color: #64748B;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .settings-row-chevron {
    flex-shrink: 0; font-size: 1.25rem; color: #94A3B8;
    transition: transform 0.15s ease-in-out;
  }
  .settings-row[aria-expanded="true"] .settings-row-chevron { transform: rotate(90deg); }

  .settings-soon-badge {
    background: #FEF3C7; color: #92400E;
    font-size: 0.6rem; font-weight: 700; letter-spacing: 0.02em;
  }

  .settings-row-panel {
    padding: 0.25rem 1.5rem 1.1rem calc(1.5rem + 38px + 0.9rem);
    border-bottom: 1px solid #EEF2F7; background: #fff;
  }
  @media (max-width: 575.98px) {
    .settings-row { padding: 0.9rem 1rem; }
    .settings-group-head { padding: 1.1rem 1rem 0.6rem; }
    .settings-row-panel { padding: 0.25rem 1rem 1rem; }
  }

  .settings-lang-select {
    flex-shrink: 0; width: auto; min-width: 9.5rem;
    font-size: 0.85rem; font-weight: 500;
  }
  /* Phones: the language dropdown drops onto its own full-width line
     under the label instead of squeezing beside it. */
  @media (max-width: 575.98px) {
    .settings-group-title { font-size: 1rem; }
    .settings-group-desc { font-size: 0.78rem; }
    .settings-row--select { flex-wrap: wrap; row-gap: 0.65rem; }
    .settings-row--select .settings-row-text { flex: 1 1 calc(100% - 38px - 0.9rem); }
    .settings-row--select .settings-row-value { white-space: normal; }
    .settings-row--select .settings-lang-select {
      flex: 1 1 100%; width: 100%; min-width: 0;
      font-size: 0.9rem; padding-top: 0.5rem; padding-bottom: 0.5rem;
    }
  }
</style>

<div class="ballot-wrap px-0" style="padding-bottom: 0;">

  <%# ── Page Header (wizard style) ── %>
  <div class="ballot-head text-center">
    <h1 class="ballot-title">
      <i class="ri-settings-3-line me-2"></i><%= t("#{sk}title") %>
    </h1>
    <p class="ballot-subtitle mb-0"><%= t("#{sk}subtitle") %></p>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-8">

      <%# ── 1. SEKIRITE ─────────────────────────────────────── %>
      <section class="settings-group card border-0 shadow-sm mb-4" aria-labelledby="settings-security-title">
        <div class="settings-group-head">
          <h2 class="settings-group-title" id="settings-security-title"><%= t("#{sk}security.title") %></h2>
          <p class="settings-group-desc"><%= t("#{sk}security.desc") %></p>
        </div>

        <div class="settings-list">
          <%# Imel — opens the two-phase email-change modal below. %>
          <button type="button" class="settings-row"
                  data-bs-toggle="modal" data-bs-target="#emailChangeModal">
            <span class="settings-row-icon"><i class="ri-mail-line"></i></span>
            <span class="settings-row-text">
              <span class="settings-row-label"><%= t("#{sk}email.label") %></span>
              <span class="settings-row-value">
                <% if @email_change_pending && @pending_new_email.present? %>
                  <%= t("#{sk}email.pending", email: @pending_new_email) %>
                <% else %>
                  <%= mask_email(@citizen.email) %>
                <% end %>
              </span>
            </span>
            <i class="ri-arrow-right-s-line settings-row-chevron" aria-hidden="true"></i>
          </button>

          <%# Otantifikasyon 2 faktè — not built yet (see staff 2FA plan). %>
          <div class="settings-row is-disabled" aria-disabled="true">
            <span class="settings-row-icon"><i class="ri-shield-keyhole-line"></i></span>
            <span class="settings-row-text">
              <span class="settings-row-label">
                <%= t("#{sk}two_factor.label") %>
                <span class="badge rounded-pill settings-soon-badge"><%= t("citizen_portal.common.coming_soon") %></span>
              </span>
              <span class="settings-row-value"><%= t("#{sk}two_factor.desc") %></span>
            </span>
          </div>

          <%# Jere aparèy — expands the known-devices list. %>
          <button type="button" class="settings-row"
                  data-bs-toggle="collapse" data-bs-target="#settings-devices-panel"
                  aria-expanded="false" aria-controls="settings-devices-panel">
            <span class="settings-row-icon"><i class="ri-device-line"></i></span>
            <span class="settings-row-text">
              <span class="settings-row-label"><%= t("#{sk}devices.label") %></span>
              <span class="settings-row-value"><%= t("#{sk}devices.count", count: @known_devices.size) %></span>
            </span>
            <i class="ri-arrow-right-s-line settings-row-chevron" aria-hidden="true"></i>
          </button>
          <div class="collapse" id="settings-devices-panel">
            <div class="settings-row-panel">
              <p class="ballot-section-desc small mb-2"><%= t("#{sk}devices.desc") %></p>

              <% if @known_devices.any? %>
                <ul class="list-unstyled mb-0" id="known-devices">
                  <% @known_devices.each do |device| %>
                    <% this_device = device.token_digest == @current_device_digest %>
                    <li class="d-flex align-items-start gap-2 py-2"
                        style="border-top: 1px solid #E5E7EB;">
                      <i class="<%= device.mobile? ? 'ri-smartphone-line' : 'ri-computer-line' %>"
                         style="font-size: 1.1rem; color: #64748b;"></i>
                      <div style="font-size: 0.82rem; min-width: 0;">
                        <div class="fw-semibold" style="color: #0F172A;">
                          <%= device.label %>
                          <% if this_device %>
                            <span class="badge rounded-pill ms-1"
                                  style="background: #DCFCE7; color: #166534; font-size: 0.6rem; font-weight: 700;">
                              <%= t("#{sk}devices.this_device") %>
                            </span>
                          <% end %>
                        </div>
                        <div class="text-muted" style="font-size: 0.75rem;">
                          <%= [ device.location,
                                this_device ? t("#{sk}devices.now") : t("#{sk}devices.last_seen", time: time_ago_in_words(device.last_seen_at)) ]
                                .compact.join(" · ") %>
                        </div>
                      </div>
                    </li>
                  <% end %>
                </ul>
              <% end %>

              <%= button_to citizens_sign_out_other_devices_path,
                    method: :delete,
                    form: { data: { turbo: false } },
                    class: "btn btn-outline-danger btn-sm mt-2",
                    style: "font-size: 0.78rem;" do %>
                <i class="ri-logout-box-r-line me-1"></i> <%= t("#{sk}devices.sign_out_others") %>
              <% end %>
            </div>
          </div>
        </div>
      </section>

      <%# ── 2. PREFERANS ────────────────────────────────────── %>
      <section class="settings-group card border-0 shadow-sm mb-4" aria-labelledby="settings-preferences-title">
        <div class="settings-group-head">
          <h2 class="settings-group-title" id="settings-preferences-title"><%= t("#{sk}preferences.title") %></h2>
          <p class="settings-group-desc"><%= t("#{sk}preferences.desc") %></p>
        </div>

        <div class="settings-list">
          <%# Notifikasyon — expands the channel picker; saves on change. %>
          <% channel_labels = { "email" => t("#{sk}notifications.by_email"), "phone" => t("#{sk}notifications.by_phone") } %>
          <button type="button" class="settings-row"
                  data-bs-toggle="collapse" data-bs-target="#settings-notifications-panel"
                  aria-expanded="false" aria-controls="settings-notifications-panel">
            <span class="settings-row-icon"><i class="ri-notification-3-line"></i></span>
            <span class="settings-row-text">
              <span class="settings-row-label"><%= t("#{sk}notifications.label") %></span>
              <span class="settings-row-value"><%= channel_labels[@citizen.notification_channel.to_s] || channel_labels["email"] %></span>
            </span>
            <i class="ri-arrow-right-s-line settings-row-chevron" aria-hidden="true"></i>
          </button>
          <div class="collapse" id="settings-notifications-panel">
            <div class="settings-row-panel">
              <%= form_with url: citizens_settings_path, method: :patch, scope: :user,
                            data: { controller: "auto-submit", turbo: false } do |f| %>
                <% channel_choices = [
                  { value: "email", icon: "ri-mail-line", disabled: false,
                    sub: t("#{sk}notifications.by_email_desc_html", email: mask_email(@citizen.email)) },
                  { value: "phone", icon: "ri-smartphone-line", disabled: true,
                    sub: t("#{sk}notifications.by_phone_desc") }
                ] %>
                <% channel_choices.each do |opt| %>
                  <% disabled = opt[:disabled] %>
                  <% selected = @citizen.notification_channel.to_s == opt[:value] && !disabled %>
                  <label class="d-flex align-items-start gap-3 p-3 rounded-3 mb-2"
                         style="border: 1px solid #E5E7EB;
                                <%= disabled ? 'cursor: not-allowed; opacity: 0.55;' : 'cursor: pointer;' %>
                                <%= 'background: rgba(0, 32, 159, 0.04); border-color: rgba(0, 32, 159, 0.4);' if selected %>">
                    <%= f.radio_button :notification_channel, opt[:value],
                          checked: @citizen.notification_channel.to_s == opt[:value],
                          disabled: disabled,
                          class: "form-check-input mt-1 flex-shrink-0",
                          data: { action: "change->auto-submit#submit" } %>
                    <div>
                      <div class="fw-semibold d-flex align-items-center gap-2" style="font-size: 0.88rem;">
                        <i class="<%= opt[:icon] %>"></i>
                        <%= channel_labels[opt[:value]] %>
                        <% if disabled %>
                          <span class="badge rounded-pill settings-soon-badge"><%= t("citizen_portal.common.coming_soon") %></span>
                        <% end %>
                      </div>
                      <small class="text-muted"><%= opt[:sub] %></small>
                    </div>
                  </label>
                <% end %>
              <% end %>
            </div>
          </div>

          <%# Lang — dropdown saves on change and reloads the portal in that
              language. Names are shown in their own language on purpose. %>
          <%= form_with url: citizens_settings_path, method: :patch, scope: :user,
                        class: "settings-row settings-row--select",
                        data: { controller: "auto-submit", turbo: false } do |f| %>
            <span class="settings-row-icon"><i class="ri-global-line"></i></span>
            <span class="settings-row-text">
              <label for="settings-locale-select" class="settings-row-label mb-0"><%= t("#{sk}language.label") %></label>
              <span class="settings-row-value"><%= t("#{sk}language.desc") %></span>
            </span>
            <%= f.select :preferred_locale,
                  options_for_select(
                    [["Kreyòl Ayisyen", "ht"], ["Français", "fr"], ["English", "en"]],
                    @citizen.portal_locale
                  ),
                  {},
                  id: "settings-locale-select",
                  class: "form-select form-select-sm settings-lang-select",
                  data: { action: "change->auto-submit#submit" } %>
            <noscript>
              <%= f.submit t("#{sk}language.save"), class: "btn btn-primary btn-sm" %>
            </noscript>
          <% end %>
        </div>
      </section>

    </div>
  </div>
</div>

<%# ── Email-change modal (two phases) — segmented OTP, countdown, resend.
    Phase 1: enter new email → Voye kòd. Server mails 6-digit code.
    Phase 2: enter code (segmented boxes via otp-input controller) →
             Konfime. Server verifies + swaps the account email.
    Resend = re-submit Phase 1 with the same email (server overwrites cache).
    Modifye imel = DELETE cancel_email_change → drops cache + reopens Phase 1. %>
<style>
  /* Modal-only OTP styles. Typography uses the project's canonical
     classes: .ballot-section-title (heading), .ballot-section-desc (body),
     .form-label (inputs), .text-muted (helpers), .enroll-helpful-tip
     (info pill) — defined in citizens/pages/_election.scss. */
  .otp-input-row { display: flex; gap: 0.5rem; justify-content: center; }
  .otp-input-row input.otp-box {
    width: 2.6rem; height: 3rem; padding: 0; text-align: center;
    font-size: 1.35rem; font-weight: 700;
    border: 1px solid #d1d5db; border-radius: 0.55rem;
    background: #fff; color: #111827;
    font-family: 'Inter', sans-serif;
    transition: border-color 0.12s ease, box-shadow 0.12s ease;
  }
  .otp-input-row input.otp-box:focus {
    outline: none; border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(0, 32, 159, 0.18);
  }
  .otp-input-row input.otp-box.is-invalid {
    border-color: #dc3545; box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.15);
  }
  @keyframes otpShake {
    0%,100% { transform: translateX(0); }
    20% { transform: translateX(-6px); } 40% { transform: translateX(6px); }
    60% { transform: translateX(-4px); } 80% { transform: translateX(4px); }
  }
  .otp-shake { animation: otpShake 0.36s ease-in-out; }
</style>
<div class="modal fade" id="emailChangeModal" tabindex="-1" aria-labelledby="emailChangeModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius: 0.75rem; border: none;">
      <div class="modal-header" style="border-bottom: 1px solid #E5E7EB;">
        <h5 class="modal-title fw-bold" id="emailChangeModalTitle"
            style="font-family: 'Montserrat', sans-serif; color: #1E293B; font-size: 1.05rem;">
          <i class="ri-mail-settings-line me-2" style="color: var(--primary);"></i>
          <% if @email_change_pending %><%= t("citizen_portal.settings.email_modal.enter_code_title") %><% else %><%= t("citizen_portal.settings.email_modal.change_title") %><% end %>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("citizen_portal.common.close") %>"></button>
      </div>

      <% if @email_change_pending %>
        <%# ── Phase 2 — code entry (segmented OTP) ── %>
        <div data-controller="otp-input"
             data-otp-input-length-value="6"
             data-otp-input-expires-at-value="<%= @pending_expires_at.to_i %>"
             data-otp-input-resend-after-seconds-value="60"
             data-otp-input-expires-in-text-value="<%= t("citizen_portal.settings.email_modal.expires_in", time: "%{time}") %>"
             data-otp-input-expired-text-value="<%= t("citizen_portal.settings.email_modal.expired") %>">
          <%= form_with url: citizens_settings_path, method: :patch,
                        html: { data: { turbo: false } } do %>
            <div class="modal-body">
              <p class="ballot-section-desc mb-2">
                <%= t("citizen_portal.settings.email_modal.code_sent_to") %>
              </p>
              <%# Email "pill" with edit affordance docked at the right —
                  separates the address from the prose so a typo is easy
                  to spot, and gives the edit icon a real container so it
                  doesn't float on the paragraph baseline. %>
              <div class="d-flex align-items-center justify-content-between gap-2 mb-3 px-3 py-2 rounded-3"
                   style="background: #F3F4F6; border: 1px solid #E5E7EB;">
                <span style="color: #111827; font-weight: 600; font-size: 0.9rem; word-break: break-all; line-height: 1.3;">
                  <%= @pending_new_email %>
                </span>
                <%# data-turbo: true re-enables Turbo for this link — the
                    parent <form data-turbo="false"> would otherwise make
                    the click a plain GET, ignoring data-turbo-method. %>
                <%= link_to citizens_cancel_email_change_path,
                      data: { turbo: true, turbo_method: :delete },
                      class: "btn btn-sm py-1 px-2 flex-shrink-0",
                      title: t("citizen_portal.settings.email_modal.edit_email"),
                      style: "color: var(--primary); line-height: 1; background: #fff; border: 1px solid #E5E7EB;" do %>
                  <i class="ri-edit-line" style="font-size: 0.95rem;"></i>
                <% end %>
              </div>
              <p class="ballot-section-desc mb-3 small">
                <%= t("citizen_portal.settings.email_modal.check_inbox") %>
              </p>

              <input type="hidden" name="user[email]" value="<%= @pending_new_email %>">

              <label class="form-label fw-semibold mb-2"><%= t("citizen_portal.settings.email_modal.code_label") %></label>
              <div class="otp-input-row mb-2" data-otp-input-target="row">
                <% 6.times do %>
                  <input type="text" class="otp-box"
                         inputmode="numeric" pattern="\d" maxlength="1"
                         autocomplete="off"
                         data-otp-input-target="box"
                         data-action="input->otp-input#onInput keydown->otp-input#onKeydown paste->otp-input#onPaste">
                <% end %>
              </div>
              <input type="hidden" name="user[email_change_code]"
                     data-otp-input-target="hidden">

              <div class="text-center mt-2">
                <span class="badge rounded-pill text-bg-light"
                      data-otp-input-target="timer"
                      style="font-size: 0.75rem; font-weight: 500; padding: 0.4rem 0.75rem;">
                  <%= t("citizen_portal.settings.email_modal.expires_in", time: "15:00") %>
                </span>
              </div>

              <div class="text-center mt-2">
                <button type="submit" formnovalidate
                        class="btn btn-link p-0 align-baseline"
                        data-otp-input-target="resend"
                        hidden
                        style="font-size: 0.8rem; text-decoration: underline; color: var(--primary);">
                  <%= t("citizen_portal.settings.email_modal.resend") %>
                </button>
              </div>
            </div>

            <div class="modal-footer" style="border-top: 1px solid #E5E7EB;">
              <%# "Verifye pi ta" framing reads as postponement, not
                  cancelation — keeps the citizen on the dashboard with
                  the pending state intact, less off-ramping than "Anile". %>
              <button type="button" class="btn btn-link btn-sm" data-bs-dismiss="modal"
                      style="color: #6b7280; text-decoration: none;">
                <%= t("citizen_portal.settings.email_modal.verify_later") %>
              </button>
              <button type="submit" class="btn btn-primary btn-sm fw-semibold px-4">
                <i class="ri-check-line me-1"></i> <%= t("citizen_portal.settings.email_modal.confirm") %>
              </button>
            </div>
          <% end %>
        </div>

        <%# Auto-open the modal in Phase 2 so the citizen lands directly
            in code-entry. Stimulus controller waits for window.bootstrap
            (the inline-script approach raced with the deferred ESM bundle
            and silently no-op'd, leaving the modal markup rendered inline
            without backdrop) and re-parents the modal to <body> so the
            fixed-position backdrop isn't clipped by the layout shell. %>
        <div data-controller="auto-modal" data-auto-modal-target-id-value="emailChangeModal"></div>
      <% else %>
        <%# ── Phase 1 — request code ── %>
        <%= form_with url: citizens_settings_path, method: :patch,
                      html: { data: { turbo: false } } do %>
          <div class="modal-body">
            <p class="ballot-section-desc mb-3">
              <%= t("citizen_portal.settings.email_modal.intro") %>
            </p>

            <label for="email_change_new_email" class="form-label fw-semibold"><%= t("citizen_portal.settings.email_modal.new_email_label") %></label>
            <div class="input-group">
              <span class="input-group-text bg-light" style="border-right: 0;">
                <i class="ri-mail-line" style="color: var(--primary);"></i>
              </span>
              <input type="email"
                     id="email_change_new_email"
                     name="user[email]"
                     class="form-control"
                     autocomplete="email"
                     placeholder="<%= t("citizen_portal.settings.email_modal.placeholder") %>"
                     style="color: #000; font-weight: 500; border-left: 0;"
                     required autofocus>
            </div>
            <small class="text-muted d-block mt-2">
              <%= t("citizen_portal.settings.email_modal.current_email_html", email: mask_email(@citizen.email)) %>
            </small>
          </div>
          <div class="modal-footer" style="border-top: 1px solid #E5E7EB;">
            <button type="button" class="btn btn-link btn-sm" data-bs-dismiss="modal"
                    style="color: #6b7280; text-decoration: none;">
              <%= t("citizen_portal.common.cancel") %>
            </button>
            <button type="submit" class="btn btn-primary btn-sm fw-semibold px-4">
              <i class="ri-mail-send-line me-1"></i> <%= t("citizen_portal.settings.email_modal.send_code") %>
            </button>
          </div>
        <% end %>

        <%# Citizen just clicked Modifye-imel — reopen modal in Phase 1. %>
        <% if flash[:reopen_email_modal] %>
          <div data-controller="auto-modal" data-auto-modal-target-id-value="emailChangeModal"></div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
