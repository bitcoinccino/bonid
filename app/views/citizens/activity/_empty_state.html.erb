<% icons = { "scans" => "ri-qr-scan-2-line", "consents" => "ri-id-card-line",
              "transactions" => "ri-exchange-funds-line", "applications" => "ri-file-list-3-line",
              "sessions" => "ri-login-box-line" } %>
<% empty_key = icons.key?(tab) ? tab : "all" %>
<% copy = { icon:  icons.fetch(tab, "ri-pulse-line"),
            title: t("citizen_portal.activity.empty.#{empty_key}.title"),
            body:  t("citizen_portal.activity.empty.#{empty_key}.body") } %>

<div class="activity-empty">
  <i class="<%= copy[:icon] %> activity-empty-icon"></i>
  <h5 class="fw-bold"><%= copy[:title] %></h5>
  <p class="text-muted mb-1" style="font-size: 0.82rem;"><%= copy[:body] %></p>
  <% if @from && @to %>
    <p class="text-muted mb-0" style="font-size: 0.72rem;">
      <i class="ri-calendar-2-line"></i>
      <%= t("citizen_portal.activity.period") %>: <%= l(@from, format: :long) rescue @from %> — <%= l(@to, format: :long) rescue @to %>.
      <br>
      <%= t("citizen_portal.activity.empty.widen_period") %>
    </p>
  <% end %>
</div>
