<%# Citizen Portal — Peye Fakti (Bill Payments) %>
<%# Utility billing aggregator — EDH, DINEPA %>

<div class="bongouv-dashboard" id="bill-payments-main">

  <%# ── Page Header ── %>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h3 class="citizen-page-title mb-1">
        <i class="ri-bill-line me-2"></i>Peye Fakti
      </h3>
      <p class="text-muted mb-0" style="font-size: 0.78rem;">
        Peye fakti sèvis piblik ou yo anliy — elektrisite, dlo, ak plis ankò.
      </p>
    </div>
    <span class="dgi-verification-badge dgi-verification-badge--<%= @verified ? 'verified' : 'pending' %>">
      <i class="<%= @verified ? 'ri-verified-badge-fill' : 'ri-time-line' %> me-1"></i>
      BonID <%= @verified ? 'Verifye' : 'Annatant' %>
    </span>
  </div>

  <% unless @verified %>
    <div class="sèvis-alert sèvis-alert--warning">
      <i class="ri-error-warning-line"></i>
      <div>
        <strong>BonID ou poko verifye.</strong>
        Ou dwe genyen yon BonID verifye pou peye fakti anliy.
        <%= link_to "Kòmanse verifikasyon", new_citizens_identity_submission_path, class: "citizen-link-alert" %>
      </div>
    </div>
  <% end %>

  <%# ── How it works ── %>
  <div class="sèvis-how-it-works">
    <h6 class="sèvis-section-title"><i class="ri-road-map-line me-2"></i>Kijan sa Fonksyone</h6>
    <div class="sèvis-steps-row">
      <div class="sèvis-step-card">
        <div class="sèvis-step-card__number">1</div>
        <div class="sèvis-step-card__content">
          <strong>Chwazi Sèvis</strong>
          <p>Chwazi konpayi sèvis piblik la (EDH, DINEPA).</p>
        </div>
      </div>
      <div class="sèvis-step-connector"><i class="ri-arrow-right-line"></i></div>
      <div class="sèvis-step-card">
        <div class="sèvis-step-card__number">2</div>
        <div class="sèvis-step-card__content">
          <strong>Antre Nimewo Kont</strong>
          <p>Antre nimewo kliyan oswa nimewo kontè ou.</p>
        </div>
      </div>
      <div class="sèvis-step-connector"><i class="ri-arrow-right-line"></i></div>
      <div class="sèvis-step-card">
        <div class="sèvis-step-card__number">3</div>
        <div class="sèvis-step-card__content">
          <strong>Peye Anliy</strong>
          <p>Peye ak MonCash oswa kat debi — resi imedyat.</p>
        </div>
      </div>
    </div>
  </div>

  <%# ── Utility Providers ── %>
  <h6 class="sèvis-section-title mt-4"><i class="ri-lightbulb-flash-line me-2"></i>Sèvis Piblik yo</h6>

  <div class="sèvis-provider-grid">
    <% @providers.each do |provider| %>
      <div class="sèvis-provider-card">
        <div class="sèvis-provider-card__header" style="border-left: 4px solid <%= provider[:color] %>;">
          <div class="sèvis-provider-card__icon" style="background: <%= provider[:color] %>15; color: <%= provider[:color] %>;">
            <i class="<%= provider[:icon] %>"></i>
          </div>
          <div>
            <h6 class="sèvis-provider-card__name"><%= provider[:name] %></h6>
            <span class="sèvis-provider-card__fullname"><%= provider[:full_name] %></span>
            <% if provider[:status] == :coming_soon %>
              <span class="sèvis-coming-soon-badge">Byento disponib</span>
            <% end %>
          </div>
        </div>
        <p class="sèvis-provider-card__desc"><%= provider[:description] %></p>
        <div class="sèvis-provider-card__footer">
          <% if provider[:status] == :coming_soon %>
            <button class="btn sèvis-btn-disabled" disabled>
              <i class="ri-time-line me-1"></i>Byento
            </button>
          <% else %>
            <button class="btn sèvis-btn-primary" <%= 'disabled' unless @verified %>>
              Peye Kounye a <i class="ri-arrow-right-line ms-1"></i>
            </button>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <%# ── FAQ / Info Section ── %>
  <div class="sèvis-info-section">
    <h6 class="sèvis-section-title"><i class="ri-question-line me-2"></i>Kesyon Souvan</h6>
    <div class="sèvis-faq-list">
      <div class="sèvis-faq-item">
        <strong>Ki metòd peman ki disponib?</strong>
        <p>Nou aksepte MonCash ak kat debi/kredi (Visa, Mastercard).</p>
      </div>
      <div class="sèvis-faq-item">
        <strong>Konbyen tan sa pran pou peman an anrejistre?</strong>
        <p>Peman an anrejistre imedyatman. Ou resevwa yon resi dijital otomatikman.</p>
      </div>
      <div class="sèvis-faq-item">
        <strong>Èske mwen ka peye pou yon lòt moun?</strong>
        <p>Wi, ou jis bezwen nimewo kont oswa nimewo kontè moun nan.</p>
      </div>
    </div>
  </div>

  <%# ── Trust Footer ── %>
  <div class="sèvis-trust-footer" role="contentinfo">
    <div class="d-flex align-items-center justify-content-center gap-3 flex-wrap">
      <span><i class="ri-lock-line me-1"></i>Done ou yo chifre ak pwoteje</span>
      <span class="sèvis-trust-footer__divider"></span>
      <span><i class="ri-shield-check-line me-1"></i>Verifye pa BonID</span>
      <span class="sèvis-trust-footer__divider"></span>
      <span>Powered by <strong>BonGouv</strong>, a product of <strong>Verifyem</strong></span>
    </div>
  </div>
</div>

