<div style="font-family:'Montserrat','Inter',Arial,sans-serif; font-size:20px; font-weight:700; color:#00209F; margin-bottom:12px;">
  <%= t("mailers.access.removed.heading", partner_name: @partner.name) %>
</div>
<p style="margin:0 0 16px;"><%= t("mailers.access.greeting", name: @citizen.first_name) %></p>
<p style="margin:0 0 16px;">
  <%= t("mailers.access.removed.body", partner_name: @partner.name,
        date: l((@grant.revoked_at || Time.current).to_date, format: :consent)) %>
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F1F5FB; border-radius:10px; margin:0 0 16px;">
  <tr><td style="padding:14px 18px; font-size:14px; color:#1E293B; line-height:1.7;">
    • <%= t("mailers.access.removed.point_stop", partner_name: @partner.name) %><br>
    • <%= t("mailers.access.removed.point_delete") %><br>
    • <%= t("mailers.access.removed.point_again") %>
  </td></tr>
</table>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#FEF3C7; border-radius:10px; margin:0 0 20px;">
  <tr><td style="padding:12px 16px; font-size:13px; color:#78350F;">
    <strong><%= t("mailers.access.not_you_title") %></strong> <%= t("mailers.access.removed.not_you_body") %>
  </td></tr>
</table>

<div style="text-align:center;">
  <a href="<%= citizens_consents_url %>" style="display:inline-block; background:#00209F; color:#FFFFFF; text-decoration:none; font-weight:700; font-size:14px; padding:12px 22px; border-radius:8px;">
    <%= t("mailers.access.manage_button") %>
  </a>
</div>
