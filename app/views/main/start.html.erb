
<section class="container start-section py-5" role="main" style="margin-top: 80px;">
  <div class="row justify-content-center">
    <div class="col-lg-10 col-xl-8">
      <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
        <div class="text-center">

          <% if @partner %>
            <!-- 🎯 Partner-Based Verification -->
            <div class="mb-4">
              <!-- Partner Logo -->
              <div class="partner-logo-container mb-3 d-flex justify-content-center">
                <% if @partner.logo.attached? %>
                  <%= image_tag @partner.logo.variant(resize_to_limit: [100, 100]),
                        class: "img-fluid rounded-circle shadow-sm",
                        style: "width: 100px; height: 100px; object-fit: cover;",
                        alt: "#{@partner.name} logo",
                        loading: "lazy" %>
                <% else %>
                  <div class="rounded-circle bg-light d-flex align-items-center justify-content-center"
                       style="width: 100px; height: 100px;">
                    <i class="ri-image-line text-muted" style="font-size: 2rem;"></i>
                  </div>
                <% end %>
              </div>

              <!-- Partner Title -->
              <h2 class="h4 fw-bold mb-2 text-primary">
                BonID + <%= @partner.name %>
                <% if @partner.verified_at.present? %>
                  <i class="ri-verified-badge-fill ms-1 text-success" title="Verified Partner"></i>
                <% end %>
              </h2>

              <!-- Main Heading -->
              <h1 class="display-6 fw-bold mb-3 text-dark">
                Verify Your Identity for <%= @partner.name %>
              </h1>

              <p class="lead text-muted mb-4">
                To access services from <strong><%= @partner.name %></strong>,
                you must first verify your identity with BonID.
              </p>

              <!-- CTA Buttons -->
              <%= render "shared/cta_buttons", partner: @partner %>
              </div>
            </div>

          <% else %>
            <!-- 🌐 General BonID Access -->
            <div class="mb-4">
              <h1 class="display-5 fw-bold mb-3 text-primary">
                Get Your BonID
              </h1>
              <p class="lead text-muted mb-4">
                BonID is your secure, reusable digital identity across Haiti.<br>
                Accepted by top banks, government agencies, and service providers.
              </p>

              <%= render "shared/cta_buttons" %>

          <!-- 🔙 Back to Home -->
          <div class="mt-5">
            <%= link_to root_path, class: "text-decoration-none text-secondary" do %>
              <i class="ri-arrow-left-line me-1"></i> Back to BonID Home
            <% end %>
          </div>
     <%end%>
        </div>
      </div>
    </div>
  </div>
</section>
