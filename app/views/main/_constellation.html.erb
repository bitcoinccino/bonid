<!-- ======================================================
     HERO — DATA CONSTELLATION (PURE CIRCLES)
     - No swinging (no in/out radius wave)
     - Center = "Verifyem" text
     - Brand logo becomes one of the orbiting logos
====================================================== -->
<section class="hero-section-constellation text-white position-relative overflow-hidden">
  <canvas id="constellationCanvas"></canvas>

  <div class="container position-relative z-3 py-6">
    <div class="row align-items-center">

      <div class="col-lg-5">
        <h2 class="display-5 fw-bold"><%= t("main.constellation.title") %></h2>
        <p class="lead opacity-90"><%= t("main.constellation.subtitle") %></p>

        <div class="mt-4">
          <a href="#enskri" data-enskri="citizen"
             class="btn btn-outline-light btn-lg fw-semibold rounded-pill px-5 py-3">
            <%= t("main.constellation.cta", default: "Get Early Access") %>
          </a>
        </div>
      </div>

      <div class="col-lg-7">
        <div class="data-nodes" data-orbit>

          <!-- CENTER: Verifyem TEXT (no logo here) -->
          <div class="center-hub verifyem-hub" data-role="hub">
            <span class="verifyem-word">Verifyem</span>
          </div>

          <!-- ORBITING LOGOS -->
          <div class="orbit-ring" data-orbit-ring="main">

            <!-- ✅ Brand logo moved into orbit -->
            <div class="data-node partner-node" data-role="node">
              <%= image_tag "bonid/logo.svg", alt: "Verifyem" %>
            </div>

            <div class="data-node partner-node" data-role="node">
              <%= image_tag "partners/unibank.svg", alt: "Unibank" %>
            </div>

            <div class="data-node partner-node" data-role="node">
              <%= image_tag "partners/sogebank.svg", alt: "Sogebank" %>
            </div>

            <div class="data-node partner-node" data-role="node">
              <%= image_tag "partners/digicel.svg", alt: "Digicel" %>
            </div>

            <div class="data-node partner-node" data-role="node">
              <%= image_tag "partners/faes.svg", alt: "FAES" %>
            </div>

            <div class="data-node partner-node" data-role="node">
              <%= image_tag "partners/pnh.svg", alt: "PNH" %>
            </div>

            <div class="data-node partner-node" data-role="node">
              <%= image_tag "partners/us_embassy.svg", alt: "US Embassy" %>
            </div>

            <div class="data-node partner-node" data-role="node">
              <%= image_tag "partners/france_embassy.svg", alt: "France Embassy" %>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>
