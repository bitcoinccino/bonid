<!-- ============================================================
     BonID Public Pricing Page — Credits / Pay-As-You-Go
     app/views/main/pricing.html.erb
=============================================================== -->

<section class="pricing-hero text-center py-5 bg-bonid-gradient text-white">
  <div class="container py-5">
    <h1 class="fw-bold mb-3 display-4 font-heading">
      BonID Partner Pricing
    </h1>
    <p class="lead mb-0 opacity-90">
      Pay-as-you-go credits. No subscriptions. Rechaje lè w bezwen.
    </p>
  </div>
</section>

<section class="pricing-section py-5">
  <div class="container">

    <div class="text-center mb-5">
      <h2 class="fw-bold text-haitian-blue">Simple Credit Tiers</h2>
      <p class="text-muted">1 Credit = $0.01 USD. Top up via Stripe or MonCash.</p>
    </div>

    <div class="row g-4 justify-content-center">

      <%# Standard Tier %>
      <div class="col-xl col-lg-4 col-md-6 d-flex">
        <div class="pricing-card h-100 rounded-4 shadow-card position-relative overflow-hidden flex-grow-1 d-flex flex-column">
          <div class="pricing-header text-center py-4">
            <h3 class="fw-bold text-haitian-blue mb-1">Standard</h3>
            <p class="small text-muted mb-0 px-3">QR scans & status checks</p>
            <div class="mt-3">
              <span class="display-6 fw-bold text-haitian-blue-deep">49</span>
              <span class="text-muted small d-block">credits ($0.49)</span>
            </div>
          </div>
          <hr class="m-0">
          <div class="pricing-body p-4 flex-grow-1">
            <ul class="list-unstyled mb-3">
              <li class="d-flex align-items-start mb-2 small">
                <i class="ri-check-line text-palm-green me-2"></i>
                <span>QR code scanning</span>
              </li>
              <li class="d-flex align-items-start mb-2 small">
                <i class="ri-check-line text-palm-green me-2"></i>
                <span>BonID status verification</span>
              </li>
              <li class="d-flex align-items-start mb-2 small">
                <i class="ri-check-line text-palm-green me-2"></i>
                <span>Basic identity lookups</span>
              </li>
            </ul>
          </div>
          <div class="pricing-footer text-center p-4 mt-auto">
            <%= link_to "Get Started", new_partner_path,
              class: "btn btn-haitian-blue rounded-pill px-4 py-2 fw-semibold shadow-sm" %>
          </div>
        </div>
      </div>

      <%# Health & Biometric Tier %>
      <div class="col-xl col-lg-4 col-md-6 d-flex">
        <div class="pricing-card h-100 rounded-4 shadow-card position-relative overflow-hidden flex-grow-1 d-flex flex-column">
          <div class="pricing-header text-center py-4">
            <h3 class="fw-bold text-haitian-blue mb-1">Health</h3>
            <p class="small text-muted mb-0 px-3">Biometric & medical data</p>
            <div class="mt-3">
              <span class="display-6 fw-bold text-haitian-blue-deep">99</span>
              <span class="text-muted small d-block">credits ($0.99)</span>
            </div>
          </div>
          <hr class="m-0">
          <div class="pricing-body p-4 flex-grow-1">
            <ul class="list-unstyled mb-3">
              <li class="d-flex align-items-start mb-2 small">
                <i class="ri-check-line text-palm-green me-2"></i>
                <span>Blood type & allergies</span>
              </li>
              <li class="d-flex align-items-start mb-2 small">
                <i class="ri-check-line text-palm-green me-2"></i>
                <span>Medical conditions</span>
              </li>
              <li class="d-flex align-items-start mb-2 small">
                <i class="ri-check-line text-palm-green me-2"></i>
                <span>Physical profile</span>
              </li>
            </ul>
          </div>
          <div class="pricing-footer text-center p-4 mt-auto">
            <%= link_to "Get Started", new_partner_path,
              class: "btn btn-haitian-blue rounded-pill px-4 py-2 fw-semibold shadow-sm" %>
          </div>
        </div>
      </div>

      <%# Civil & Social Tier %>
      <div class="col-xl col-lg-4 col-md-6 d-flex">
        <div class="pricing-card h-100 rounded-4 shadow-card position-relative overflow-hidden flex-grow-1 d-flex flex-column">
          <div class="pricing-header text-center py-4">
            <h3 class="fw-bold text-haitian-blue mb-1">Civil</h3>
            <p class="small text-muted mb-0 px-3">Family & social records</p>
            <div class="mt-3">
              <span class="display-6 fw-bold text-haitian-blue-deep">129</span>
              <span class="text-muted small d-block">credits ($1.29)</span>
            </div>
          </div>
          <hr class="m-0">
          <div class="pricing-body p-4 flex-grow-1">
            <ul class="list-unstyled mb-3">
              <li class="d-flex align-items-start mb-2 small">
                <i class="ri-check-line text-palm-green me-2"></i>
                <span>Family records & dependents</span>
              </li>
              <li class="d-flex align-items-start mb-2 small">
                <i class="ri-check-line text-palm-green me-2"></i>
                <span>Emergency contacts</span>
              </li>
              <li class="d-flex align-items-start mb-2 small">
                <i class="ri-check-line text-palm-green me-2"></i>
                <span>Social trust score</span>
              </li>
            </ul>
          </div>
          <div class="pricing-footer text-center p-4 mt-auto">
            <%= link_to "Get Started", new_partner_path,
              class: "btn btn-haitian-blue rounded-pill px-4 py-2 fw-semibold shadow-sm" %>
          </div>
        </div>
      </div>

      <%# Verification Tier %>
      <div class="col-xl col-lg-4 col-md-6 d-flex">
        <div class="pricing-card h-100 rounded-4 shadow-card position-relative overflow-hidden flex-grow-1 d-flex flex-column">
          <div class="pricing-ribbon">Popular</div>
          <div class="pricing-header text-center py-4">
            <h3 class="fw-bold text-haitian-blue mb-1">Verification</h3>
            <p class="small text-muted mb-0 px-3">Full identity & consent</p>
            <div class="mt-3">
              <span class="display-6 fw-bold text-haitian-blue-deep">149</span>
              <span class="text-muted small d-block">credits ($1.49)</span>
            </div>
          </div>
          <hr class="m-0">
          <div class="pricing-body p-4 flex-grow-1">
            <ul class="list-unstyled mb-3">
              <li class="d-flex align-items-start mb-2 small">
                <i class="ri-check-line text-palm-green me-2"></i>
                <span>Full identity details</span>
              </li>
              <li class="d-flex align-items-start mb-2 small">
                <i class="ri-check-line text-palm-green me-2"></i>
                <span>Consent-based data requests</span>
              </li>
              <li class="d-flex align-items-start mb-2 small">
                <i class="ri-check-line text-palm-green me-2"></i>
                <span>Transaction approvals</span>
              </li>
            </ul>
          </div>
          <div class="pricing-footer text-center p-4 mt-auto">
            <%= link_to "Get Started", new_partner_path,
              class: "btn btn-haitian-blue rounded-pill px-4 py-2 fw-semibold shadow-sm" %>
          </div>
        </div>
      </div>

      <%# Premium Tier %>
      <div class="col-xl col-lg-4 col-md-6 d-flex">
        <div class="pricing-card h-100 rounded-4 shadow-card position-relative overflow-hidden flex-grow-1 d-flex flex-column">
          <div class="pricing-header text-center py-4">
            <h3 class="fw-bold text-haitian-blue mb-1">Premium</h3>
            <p class="small text-muted mb-0 px-3">Liveness, crime & crypto</p>
            <div class="mt-3">
              <span class="display-6 fw-bold text-haitian-blue-deep">199</span>
              <span class="text-muted small d-block">credits ($1.99)</span>
            </div>
          </div>
          <hr class="m-0">
          <div class="pricing-body p-4 flex-grow-1">
            <ul class="list-unstyled mb-3">
              <li class="d-flex align-items-start mb-2 small">
                <i class="ri-check-line text-palm-green me-2"></i>
                <span>Liveness + face match</span>
              </li>
              <li class="d-flex align-items-start mb-2 small">
                <i class="ri-check-line text-palm-green me-2"></i>
                <span>Crime status & reports</span>
              </li>
              <li class="d-flex align-items-start mb-2 small">
                <i class="ri-check-line text-palm-green me-2"></i>
                <span>Crypto KYC/AML compliance</span>
              </li>
            </ul>
          </div>
          <div class="pricing-footer text-center p-4 mt-auto">
            <%= link_to "Get Started", new_partner_path,
              class: "btn btn-haitian-blue rounded-pill px-4 py-2 fw-semibold shadow-sm" %>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>


<style>
.bg-bonid-gradient { background: linear-gradient(135deg, #00209F 20%, #00E4FF 90%); }
.pricing-card { background:#fff;border:1px solid rgba(0,0,0,.05);box-shadow:0 0 30px rgba(0,0,0,.25);transition:all .25s ease;}
.pricing-card:hover { transform:translateY(-8px);box-shadow:0 16px 40px rgba(0,0,0,.20);}
.pricing-header { background:rgba(255,255,255,.15);min-height:180px;display:flex;flex-direction:column;justify-content:center;}
.pricing-footer { background:rgba(255,255,255,.06); }
.btn-haitian-blue { background:#00209F;color:white; } .btn-haitian-blue:hover { background:#001B7A;color:white; }
.pricing-ribbon { position:absolute;top:12px;right:-40px;background:#E53E3E;color:white;font-weight:700;font-size:.75rem;padding:6px 40px;transform:rotate(45deg);box-shadow:0 0 30px rgba(0,0,0,.25);}
.text-haitian-blue{color:#00209F;} .text-haitian-blue-deep{color:#001B7A;} .text-palm-green{color:#1A936F;}
</style>
