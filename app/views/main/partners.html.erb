<div class="partners-page min-vh-100">

  <%# ── Blue Header Banner ── %>
  <div class="partners-header-banner" style="background: #00209F !important; background-image: none !important;">
    <div class="container py-5 text-center">
      <% if flash[:redirected_to_verified] %>
        <div class="alert alert-dismissible fade show alert-light text-center fw-semibold rounded-3 border-0 mx-auto mb-4" style="max-width: 650px; font-size: 0.85rem;">
          <i class="ri-information-line me-2"></i>
          Please start your verification by selecting a verified partner below.
          <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <h1 class="fw-bold text-white mb-2" style="font-family: 'Montserrat', sans-serif; font-size: 1.75rem;">
        <i class="ri-verified-badge-line me-2"></i>Verified BonID Partners
      </h1>
      <p class="text-white-50 mx-auto mb-3" style="max-width: 600px; font-size: 0.92rem; line-height: 1.6;">
        BonID registrations begin through a verified partner. These trusted institutions confirm your identity and ensure your information is securely validated.
      </p>
      <% if @partners.any? %>
        <span class="badge rounded-pill bg-white text-primary px-3 py-2 fw-bold" style="font-size: 0.75rem;">
          <%= @partners.size %> <%= @partners.size == 1 ? "Partner" : "Partners" %> Available
        </span>
      <% end %>
    </div>
  </div>

  <%# ── Search + Filter ── %>
  <div class="partners-filter-bar px-3">
    <div class="rounded-3 bg-white p-2 border">
      <%= form_with url: partners_path, method: :get, class: "d-flex align-items-center gap-2" do |f| %>
        <div class="flex-grow-1">
          <div class="input-group">
            <span class="input-group-text bg-transparent border-0 pe-0"><i class="ri-search-line text-muted"></i></span>
            <%= f.text_field :search, value: params[:search], placeholder: "Search by name...",
                class: "form-control border-0 shadow-none bg-transparent py-2" %>
          </div>
        </div>

        <div class="d-none d-md-block border-start ps-2" style="min-width: 160px;">
          <%= f.select :sector,
            grouped_options_for_select(Partner::SECTORS.transform_values { |v| v.map { |s| [s.titleize, s] } }, params[:sector]),
            { prompt: "All Sectors" },
            class: "form-select form-select-sm border-0 shadow-none bg-transparent", onchange: "this.form.submit()" %>
        </div>

        <%= f.submit "Filter", class: "btn btn-primary btn-sm rounded-pill px-4 py-2 fw-bold" %>
      <% end %>
    </div>
  </div>

  <%# ── Partners Grid ── %>
  <section class="container pb-5 pt-2">
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <% @partners.each do |partner| %>
        <div class="col">
          <div class="card partner-card h-100 border rounded-3">

            <%# Logo + Name Row %>
            <div class="card-body d-flex flex-column p-4">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="partner-logo-sm rounded-circle d-flex align-items-center justify-content-center overflow-hidden flex-shrink-0">
                  <% if partner.logo.attached? %>
                    <% if partner.logo.content_type.in?(%w[image/jpeg image/png image/gif image/webp]) && partner.logo.variable? %>
                      <%= image_tag partner.logo.variant(resize_to_fill: [80, 80]), class: "img-fluid", alt: partner.name %>
                    <% else %>
                      <%= image_tag url_for(partner.logo), class: "img-fluid", alt: partner.name %>
                    <% end %>
                  <% else %>
                    <i class="ri-building-2-line text-muted" style="font-size: 1.2rem;"></i>
                  <% end %>
                </div>

                <div>
                  <h6 class="fw-bold mb-0" style="font-family: 'Montserrat', sans-serif; font-size: 0.95rem; color: #0F172A;">
                    <%= partner.name %>
                    <% if partner.verified_at.present? %>
                      <i class="ri-verified-badge-fill text-primary ms-1" title="Verified Partner" data-bs-toggle="tooltip"></i>
                    <% end %>
                  </h6>
                  <span class="badge bg-light text-secondary border px-2 py-1 rounded-pill mt-1" style="font-size: 0.7rem;">
                    <i class="<%= sector_icon(partner.sector) %> me-1"></i>
                    <%= sector_group_label(partner.sector) %>
                  </span>
                </div>
              </div>

              <%# Benefits (first 2) %>
              <div class="mb-3 flex-grow-1">
                <% (partner_benefits(partner.sector) || []).first(2).each do |benefit| %>
                  <div class="d-flex align-items-start mb-2">
                    <i class="ri-checkbox-circle-line text-success me-2 mt-1" style="font-size: 0.8rem;"></i>
                    <span class="text-muted" style="font-size: 0.8rem; line-height: 1.4;"><%= benefit %></span>
                  </div>
                <% end %>
              </div>

              <%# CTA %>
              <div class="mt-auto">
                <% if citizen_signed_in? %>
                  <%= link_to citizens_dashboard_path, class: "btn btn-primary rounded-pill fw-semibold w-100 py-2" do %>
                    <i class="ri-dashboard-line me-1"></i> Go to Dashboard
                  <% end %>
                <% else %>
                  <%= link_to new_citizen_registration_path(partner: partner.slug), class: "btn btn-primary rounded-pill fw-semibold w-100 py-2" do %>
                    <i class="ri-shield-check-line me-1"></i> Get Verified
                  <% end %>
                <% end %>
              </div>
            </div>

          </div>
        </div>
      <% end %>
    </div>

    <% if @partners.empty? %>
      <div class="text-center text-muted mt-5 py-5">
        <div class="bg-white p-4 rounded-circle shadow-sm d-inline-block mb-3">
          <i class="ri-building-2-line display-4 text-secondary"></i>
        </div>
        <h5 class="mt-3 fw-bold text-dark">No Partners Found</h5>
        <p class="mb-3">Try adjusting your filters or search criteria.</p>
        <%= link_to "Clear Filters", partners_path, class: "btn btn-outline-secondary btn-sm rounded-pill px-4" %>
      </div>
    <% end %>
  </section>
</div>
