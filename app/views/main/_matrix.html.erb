
<!-- ========================= -->
<!-- SECTION 2 — MATRIX MESH -->
<!-- ========================= -->
<section id="how-it-works" class="bonid-matrix-section position-relative overflow-hidden py-5">

  <canvas id="meshCanvas" class="mesh-canvas" aria-hidden="true"></canvas>
  <div class="matrix-overlay"></div>

  <div class="container position-relative py-5">

    <!-- Header -->
    <div class="text-center mb-5">
      <h2 class="display-5 fw-bold text-white mb-3">
        <%= t("main.matrix.title", default: "Get Your BonID in 3 Simple Steps") %>
      </h2>

      <p class="lead text-light opacity-75 col-lg-8 mx-auto">
        <%= t("main.matrix.subtitle_html", default: "").html_safe %>
      </p>
    </div>

    <!-- Steps -->
    <div class="row g-5 justify-content-center">

      <!-- STEP 1 -->
      <div class="col-md-4 text-center">
        <div class="step-card-matrix h-100 position-relative">
          <div class="step-icon mb-4 mx-auto">
            <i class="ri-upload-cloud-2-line ri-4x text-white"></i>
          </div>

          <h4 class="fw-bold text-white mb-3">
            <%= t("main.matrix.steps.step1.title", default: "1. Upload Documents") %>
          </h4>

          <p class="text-light px-3">
            <%= t("main.matrix.steps.step1.desc_html", default: "").html_safe %>
          </p>

          <div class="step-number-matrix">1</div>
        </div>
      </div>

      <!-- STEP 2 -->
      <div class="col-md-4 text-center">
        <div class="step-card-matrix h-100 position-relative">
          <div class="step-icon mb-4 mx-auto">
            <i class="ri-shield-check-line ri-4x text-white"></i>
          </div>

          <h4 class="fw-bold text-white mb-3">
            <%= t("main.matrix.steps.step2.title", default: "2. Get Verified") %>
          </h4>

          <p class="text-light opacity-90 px-3">
            <%= t("main.matrix.steps.step2.desc_html", default: "").html_safe %>
          </p>

          <div class="step-number-matrix">2</div>
        </div>
      </div>

      <!-- STEP 3 -->
      <div class="col-md-4 text-center">
        <div class="step-card-matrix h-100 position-relative">
          <div class="step-icon mb-4 mx-auto">
            <i class="ri-qr-scan-2-line ri-4x text-white"></i>
          </div>

          <h4 class="fw-bold text-white mb-3">
            <%= t("main.matrix.steps.step3.title", default: "3. Use Anywhere") %>
          </h4>

          <p class="text-light px-3">
            <%= t("main.matrix.steps.step3.desc", default: "") %>
          </p>

          <div class="step-number-matrix">3</div>
        </div>
      </div>

    </div>

    <!-- CTA -->
    <div class="text-center mt-5">
      <p class="text-light fs-5 mb-4">
        <%= t("main.matrix.cta_line_html", default: "").html_safe %>
      </p>

      <a href="#enskri" data-enskri="citizen"
         class="btn btn-light btn-lg rounded-pill px-6 py-3 fw-bold shadow-lg">
        <%= t("main.matrix.cta_button", default: "Join the Waitlist") %>
      </a>
    </div>

  </div>
</section>
