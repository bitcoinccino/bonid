
<!-- ========================= -->
<!-- SECTION 2 — HOW IT WORKS  -->
<!-- (Light, citizen-style)    -->
<!-- ========================= -->
<section id="how-it-works" class="bonid-matrix-section py-5">
  <div class="container py-5">

    <!-- Header -->
    <div class="ballot-head text-center mb-5">
      <h2 class="ballot-title">
        <%= t("main.matrix.title", default: "Secure Your Identity in 3 Steps") %>
      </h2>
      <p class="ballot-subtitle col-lg-8 mx-auto mb-0">
        <%= t("main.matrix.subtitle_html", default: "").html_safe %>
      </p>
    </div>

    <!-- Steps -->
    <%
      steps = [
        {
          num: "1",
          icon: "ri-upload-cloud-2-line",
          title: t("main.matrix.steps.step1.title", default: "1. Submit Your Documents"),
          desc:  t("main.matrix.steps.step1.desc_html", default: "")
        },
        {
          num: "2",
          icon: "ri-shield-check-line",
          title: t("main.matrix.steps.step2.title", default: "2. AI + Human Verification"),
          desc:  t("main.matrix.steps.step2.desc_html", default: "")
        },
        {
          num: "3",
          icon: "ri-qr-scan-2-line",
          title: t("main.matrix.steps.step3.title", default: "3. One QR Code. Everywhere."),
          desc:  t("main.matrix.steps.step3.desc",      default: "")
        }
      ]
    %>

    <div class="row g-4 justify-content-center">
      <% steps.each do |step| %>
        <div class="col-md-6 col-lg-4 d-flex">
          <div class="ballot-section card border-0 shadow-sm matrix-step-card w-100">
            <div class="card-body p-4 text-center d-flex flex-column">

              <div class="matrix-step-icon mx-auto mb-3">
                <i class="<%= step[:icon] %>"></i>
              </div>

              <div class="matrix-step-num mx-auto mb-3"><%= step[:num] %></div>

              <h3 class="matrix-step-title mb-2">
                <%= step[:title].to_s.sub(/\A\d+\.\s*/, "") %>
              </h3>

              <p class="matrix-step-desc mb-0">
                <%= step[:desc].to_s.html_safe %>
              </p>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- CTA -->
    <div class="text-center mt-5">
      <p class="matrix-cta-line mb-4">
        <%= t("main.matrix.cta_line_html", default: "").html_safe %>
      </p>

      <a href="#enskri" data-enskri="citizen" class="matrix-cta-btn election-btn-primary">
        <%= t("main.matrix.cta_button", default: "Join the Waitlist") %>
      </a>
    </div>

  </div>
</section>
