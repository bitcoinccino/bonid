  <span style="color: #86efac;">"consent_token"</span>: <span style="color: #86efac;">"81f81ef7b9f5339085b7..."</span>,
  <span style="color: #86efac;">"transaction_type"</span>: <span style="color: #86efac;">"wire_transfer"</span>,
  <span style="color: #86efac;">"expires_at"</span>: <span style="color: #86efac;">"2026-03-23T23:35:38Z"</span>,
  <span style="color: #86efac;">"ttl_seconds"</span>: <span style="color: #7dd3fc;">299</span>,
  <span style="color: #86efac;">"message"</span>: <span style="color: #86efac;">"Consent request sent. Awaiting approval."</span>
