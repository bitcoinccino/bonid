<!-- =============================== -->
<!-- SECTION 4 — DEVELOPER API DOCS  -->
<!-- (Light section, dark code pane) -->
<!-- =============================== -->
<section
  id="developers"
  class="developer-section py-5 position-relative overflow-hidden"
>

  <div class="container position-relative py-5">

    <!-- Header -->
    <div class="ballot-head text-center mb-5">
      <h2 class="ballot-title">
        <%= t("main.developers.title_html").html_safe %>
      </h2>
      <p class="ballot-subtitle col-lg-8 mx-auto mb-0">
        <%= t("main.developers.subtitle") %>
      </p>
    </div>

    <div class="row g-4 align-items-stretch">

      <!-- LEFT — Feature list card -->
      <div class="col-lg-5 d-flex">
        <div class="ballot-section card border-0 shadow-sm dev-info-card w-100">
          <div class="card-body p-4 p-lg-5 d-flex flex-column">

            <h3 class="dev-info-title mb-4">
              <%= t("main.developers.card.title") %>
            </h3>

            <%
              bullets = [
                { icon: "ri-flashlight-line",      label: "Instant response under 200ms",                  detail: "Sub-second verification at scale" },
                { icon: "ri-shield-keyhole-line",  label: "OAuth 2.0 + HMAC secured dual auth",            detail: "Defense in depth for sensitive scopes" },
                { icon: "ri-database-2-line",      label: "Full JSON identity + biometrics profile",       detail: "Everything you need, structured" },
                { icon: "ri-body-scan-line",       label: "AWS Rekognition liveness + face match scores",  detail: "Battle-tested vendor stack" },
                { icon: "ri-bar-chart-box-line",   label: "Risk Score API with raw confidence",            detail: "You set the thresholds, not us" },
                { icon: "ri-rocket-2-line",        label: "Sandbox + production environments",             detail: "Build safely, ship confidently" },
                { icon: "ri-code-s-slash-line",    label: "Works with Rails, Node, Go, Python, PHP",       detail: "Plain HTTPS — bring your stack" }
              ]
            %>

            <div class="mb-4">
              <% bullets.each do |b| %>
                <div class="gs-row">
                  <div class="gs-row-icon"><i class="<%= b[:icon] %>"></i></div>
                  <div class="gs-row-text">
                    <span class="gs-row-label"><%= b[:label] %></span>
                    <span class="gs-row-detail"><%= b[:detail] %></span>
                  </div>
                </div>
              <% end %>
            </div>

            <div class="mt-auto">
              <%= link_to t("main.developers.card.cta", default: "View API Docs"),
                    "/api-docs/index.html",
                    class: "election-btn-primary dev-info-cta",
                    target: "_blank",
                    rel: "noopener" %>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT — Tabbed API code pane (intentionally dark) -->
      <div class="col-lg-7 d-flex">
        <div class="dev-code-card w-100 d-flex flex-column">

          <%# Tabs %>
          <div class="dev-tabs">
            <% tabs = [
              { id: "identity", icon: "ri-user-search-line",     label: "Identity" },
              { id: "consent",  icon: "ri-shield-check-line",    label: "Consent"  },
              { id: "crime",    icon: "ri-alarm-warning-line",   label: "Crime"    },
              { id: "qr",       icon: "ri-qr-scan-2-line",       label: "QR Scan"  },
              { id: "webhook",  icon: "ri-link",                 label: "Webhook"  },
              { id: "vote",     icon: "ri-checkbox-circle-line", label: "BonVote"  }
            ] %>
            <% tabs.each_with_index do |tab, i| %>
              <button
                type="button"
                class="dev-tab <%= 'is-active' if i.zero? %>"
                onclick="showApiTab('<%= tab[:id] %>', this)"
              >
                <i class="<%= tab[:icon] %>"></i>
                <span><%= tab[:label] %></span>
              </button>
            <% end %>
          </div>

          <button
            type="button"
            class="copy-btn"
            data-copy-target="#api-identity"
            aria-label="<%= t("main.developers.copy_aria") %>"
          >
            <i class="ri-file-copy-line"></i>
            <%= t("main.developers.copy") %>
          </button>

          <%# Identity Lookup %>
          <pre id="api-identity" class="dev-code-block mb-0 flex-grow-1"><code><span style="color: #7dd3fc;">GET</span> /api/v1/identity/<span style="color: #86efac;">{bonid}</span>/status
<span style="color: #94a3b8;">Headers:</span> X-Partner-Api-Key: YOUR_KEY

<span style="color: #94a3b8;">Response:</span> <span style="color: #7dd3fc;">200 OK</span>
{
  <span style="color: #86efac;">"status"</span>: <span style="color: #86efac;">"success"</span>,
  <span style="color: #86efac;">"bonid"</span>: <span style="color: #86efac;">"BZ-1970-M-ND-P2334-0B6"</span>,
  <span style="color: #86efac;">"verification"</span>: {
    <span style="color: #86efac;">"found"</span>: <span style="color: #7dd3fc;">true</span>,
    <span style="color: #86efac;">"id_type"</span>: <span style="color: #86efac;">"BonID"</span>,
    <span style="color: #86efac;">"verified"</span>: <span style="color: #7dd3fc;">true</span>,
    <span style="color: #86efac;">"status"</span>: <span style="color: #86efac;">"approved"</span>,
    <span style="color: #86efac;">"expires_at"</span>: <span style="color: #86efac;">"2036-03-08T15:30:00Z"</span>
  },
  <span style="color: #86efac;">"partner"</span>: <span style="color: #86efac;">"Zellus"</span>,
  <span style="color: #86efac;">"timestamp"</span>: <span style="color: #86efac;">"2026-03-23T23:30:37-04:00"</span>
}</code></pre>

          <%# Transaction Consent %>
          <pre id="api-consent" class="dev-code-block mb-0 flex-grow-1" style="display: none;"><code><span style="color: #7dd3fc;">POST</span> /api/v1/transaction_consents
<span style="color: #94a3b8;">Headers:</span> X-Partner-Api-Key: YOUR_KEY

<span style="color: #94a3b8;">Body:</span>
{
  <span style="color: #86efac;">"bonid"</span>: <span style="color: #86efac;">"BZ-1970-M-ND-P2334-0B6"</span>,
  <span style="color: #86efac;">"transaction_type"</span>: <span style="color: #86efac;">"wire_transfer"</span>,
  <span style="color: #86efac;">"amount"</span>: <span style="color: #7dd3fc;">5000</span>,
  <span style="color: #86efac;">"currency"</span>: <span style="color: #86efac;">"HTG"</span>,
  <span style="color: #86efac;">"scopes"</span>: [<span style="color: #86efac;">"identity"</span>],
  <span style="color: #86efac;">"description"</span>: <span style="color: #86efac;">"Wire transfer verification"</span>,
  <span style="color: #86efac;">"callback_url"</span>: <span style="color: #86efac;">"https://your-app.com/webhook"</span>
}

<span style="color: #94a3b8;">Response:</span> <span style="color: #7dd3fc;">201 Created</span>
{
  <span style="color: #86efac;">"status"</span>: <span style="color: #86efac;">"pending"</span>,
  <span style="color: #86efac;">"consent_token"</span>: <span style="color: #86efac;">"81f81ef7b9f5339085b7..."</span>,
  <span style="color: #86efac;">"transaction_type"</span>: <span style="color: #86efac;">"wire_transfer"</span>,
  <span style="color: #86efac;">"expires_at"</span>: <span style="color: #86efac;">"2026-03-23T23:35:38Z"</span>,
  <span style="color: #86efac;">"ttl_seconds"</span>: <span style="color: #7dd3fc;">299</span>,
  <span style="color: #86efac;">"message"</span>: <span style="color: #86efac;">"Consent request sent. Awaiting approval."</span>
}</code></pre>

          <%# Crime Status %>
          <pre id="api-crime" class="dev-code-block mb-0 flex-grow-1" style="display: none;"><code><span style="color: #7dd3fc;">GET</span> /api/v1/crime_status/<span style="color: #86efac;">NB-1769-M-OU-P0815-C4R</span>
<span style="color: #94a3b8;">Headers:</span> X-Partner-Api-Key + Authorization: Bearer TOKEN
<span style="color: #94a3b8;">(Dual auth required — crime:status scope)</span>

<span style="color: #94a3b8;">Response:</span> <span style="color: #7dd3fc;">200 OK</span>
{
  <span style="color: #86efac;">"status"</span>: <span style="color: #86efac;">"success"</span>,
  <span style="color: #86efac;">"bonid"</span>: <span style="color: #86efac;">"NB-1769-M-OU-P0815-C4R"</span>,
  <span style="color: #86efac;">"crime_status"</span>: {
    <span style="color: #86efac;">"has_criminal_record"</span>: <span style="color: #fc8181;">true</span>,
    <span style="color: #86efac;">"is_suspect_in_any"</span>: <span style="color: #fc8181;">true</span>,
    <span style="color: #86efac;">"active_warrants"</span>: <span style="color: #fc8181;">true</span>,
    <span style="color: #86efac;">"highest_severity_level"</span>: <span style="color: #fc8181;">6</span>,
    <span style="color: #86efac;">"severity_label"</span>: <span style="color: #fc8181;">"Critical"</span>,
    <span style="color: #86efac;">"involvement_count"</span>: <span style="color: #7dd3fc;">2</span>,
    <span style="color: #86efac;">"roles"</span>: [<span style="color: #86efac;">"suspect"</span>],
    <span style="color: #86efac;">"crime_types"</span>: {
      <span style="color: #86efac;">"Crimes Against Humanity"</span>: <span style="color: #7dd3fc;">1</span>,
      <span style="color: #86efac;">"Genocide"</span>: <span style="color: #7dd3fc;">1</span>
    },
    <span style="color: #86efac;">"incidents"</span>: [
      {
        <span style="color: #86efac;">"report_id"</span>: <span style="color: #86efac;">"PNH-DDO-HIST-18020520-NB17"</span>,
        <span style="color: #86efac;">"case_number"</span>: <span style="color: #86efac;">"BON-CASE-1802-000001"</span>,
        <span style="color: #86efac;">"crime_type"</span>: <span style="color: #86efac;">"Crimes Against Humanity"</span>,
        <span style="color: #86efac;">"severity_label"</span>: <span style="color: #fc8181;">"Critical"</span>,
        <span style="color: #86efac;">"involvement"</span>: {
          <span style="color: #86efac;">"role"</span>: <span style="color: #86efac;">"suspect"</span>,
          <span style="color: #86efac;">"status"</span>: <span style="color: #86efac;">"wanted"</span>
        },
        <span style="color: #86efac;">"occurred_at"</span>: <span style="color: #86efac;">"1802-05-20"</span>
      }
    ],
    <span style="color: #86efac;">"risk_assessment"</span>: {
      <span style="color: #86efac;">"risk_level"</span>: <span style="color: #fc8181;">"critical"</span>,
      <span style="color: #86efac;">"score"</span>: <span style="color: #fc8181;">100</span>,
      <span style="color: #86efac;">"has_active_warrant"</span>: <span style="color: #fc8181;">true</span>
    }
  },
  <span style="color: #86efac;">"access_tier"</span>: <span style="color: #86efac;">"tier_3"</span>,
  <span style="color: #86efac;">"partner"</span>: <span style="color: #86efac;">"Police Nationale d'Haiti"</span>,
  <span style="color: #86efac;">"timestamp"</span>: <span style="color: #86efac;">"2026-03-23T23:30:00Z"</span>
}</code></pre>

          <%# QR Scan %>
          <pre id="api-qr" class="dev-code-block mb-0 flex-grow-1" style="display: none;"><code><span style="color: #7dd3fc;">POST</span> /api/v1/qr_scan
<span style="color: #94a3b8;">Headers:</span> X-Partner-Api-Key: YOUR_KEY

<span style="color: #94a3b8;">Body:</span>
{
  <span style="color: #86efac;">"qr_payload"</span>: <span style="color: #86efac;">"bonid://BZ-1970-M-ND-P2334-0B6?sig=hmac..."</span>
}

<span style="color: #94a3b8;">Response:</span> <span style="color: #7dd3fc;">200 OK</span>
{
  <span style="color: #86efac;">"status"</span>: <span style="color: #86efac;">"verified"</span>,
  <span style="color: #86efac;">"bonid"</span>: <span style="color: #86efac;">"BZ-1970-M-ND-P2334-0B6"</span>,
  <span style="color: #86efac;">"citizen"</span>: {
    <span style="color: #86efac;">"first_name"</span>: <span style="color: #86efac;">"Benworth"</span>,
    <span style="color: #86efac;">"last_name"</span>: <span style="color: #86efac;">"Zoff"</span>,
    <span style="color: #86efac;">"photo_url"</span>: <span style="color: #86efac;">"https://bonid.app/photos/..."</span>
  },
  <span style="color: #86efac;">"signature_valid"</span>: <span style="color: #7dd3fc;">true</span>,
  <span style="color: #86efac;">"credits_charged"</span>: <span style="color: #7dd3fc;">49</span>
}</code></pre>

          <%# Webhook %>
          <pre id="api-webhook" class="dev-code-block mb-0 flex-grow-1" style="display: none;"><code><span style="color: #94a3b8;">// BonID sends to your callback_url when citizen decides</span>

<span style="color: #7dd3fc;">POST</span> https://your-app.com/bonid_webhook
<span style="color: #94a3b8;">Headers:</span>
  X-BonID-Signature: HMAC-SHA256(body, your_api_key)
  Content-Type: application/json

<span style="color: #94a3b8;">Body:</span>
{
  <span style="color: #86efac;">"event"</span>: <span style="color: #86efac;">"transaction_consent.approved"</span>,
  <span style="color: #86efac;">"consent_token"</span>: <span style="color: #86efac;">"81f81ef7b9f5339085b7..."</span>,
  <span style="color: #86efac;">"bonid"</span>: <span style="color: #86efac;">"BZ-1970-M-ND-P2334-0B6"</span>,
  <span style="color: #86efac;">"decision"</span>: <span style="color: #86efac;">"approved"</span>,
  <span style="color: #86efac;">"approved_scopes"</span>: [<span style="color: #86efac;">"identity"</span>],
  <span style="color: #86efac;">"liveness_verified"</span>: <span style="color: #7dd3fc;">true</span>,
  <span style="color: #86efac;">"liveness_confidence"</span>: <span style="color: #7dd3fc;">99.65</span>,
  <span style="color: #86efac;">"decided_at"</span>: <span style="color: #86efac;">"2026-03-23T23:35:00Z"</span>
}

<span style="color: #94a3b8;">// Verify signature before processing:</span>
<span style="color: #94a3b8;">// expected = HMAC-SHA256(raw_body, your_api_key)</span>
<span style="color: #94a3b8;">// compare with X-BonID-Signature header</span></code></pre>

          <%# BonVote — Election %>
          <pre id="api-vote" class="dev-code-block mb-0 flex-grow-1" style="display: none;"><code><span style="color: #94a3b8;">// 1. Check voter eligibility</span>
<span style="color: #7dd3fc;">GET</span> /api/v1/election/<span style="color: #86efac;">2026-presidential-round1</span>/eligibility
<span style="color: #94a3b8;">Headers:</span> X-BonID-Voter-Token (biometric-verified)

<span style="color: #94a3b8;">Response:</span>
{
  <span style="color: #86efac;">"eligible"</span>: <span style="color: #7dd3fc;">true</span>,
  <span style="color: #86efac;">"voter_type"</span>: <span style="color: #86efac;">"diaspora"</span>,
  <span style="color: #86efac;">"ballot_type"</span>: <span style="color: #86efac;">"presidential"</span>,
  <span style="color: #86efac;">"country_code"</span>: <span style="color: #86efac;">"US"</span>
}

<span style="color: #94a3b8;">// 2. Cast encrypted vote (ZKP + Pedersen Commitment)</span>
<span style="color: #7dd3fc;">POST</span> /api/v1/election/<span style="color: #86efac;">2026-presidential-round1</span>/cast
{
  <span style="color: #86efac;">"nullifier"</span>: <span style="color: #86efac;">"a8f3b2c1d4e5..."</span>,
  <span style="color: #86efac;">"encrypted_choice"</span>: <span style="color: #86efac;">"AES-256-GCM(...)"</span>,
  <span style="color: #86efac;">"zkp_commitment"</span>: <span style="color: #86efac;">"pedersen(...)"</span>,
  <span style="color: #86efac;">"zkp_proof"</span>: <span style="color: #86efac;">"schnorr(...)"</span>
}

<span style="color: #94a3b8;">Response:</span> <span style="color: #7dd3fc;">201 Created</span>
{ <span style="color: #86efac;">"ballot_hash"</span>: <span style="color: #86efac;">"sha256..."</span>, <span style="color: #86efac;">"position"</span>: <span style="color: #7dd3fc;">4523</span> }

<span style="color: #94a3b8;">// 3. Public verification (no auth required)</span>
<span style="color: #7dd3fc;">GET</span> /api/v1/election/<span style="color: #86efac;">2026-presidential-round1</span>/verify/<span style="color: #86efac;">sha256...</span>
{ <span style="color: #86efac;">"verified"</span>: <span style="color: #7dd3fc;">true</span>, <span style="color: #86efac;">"message"</span>: <span style="color: #86efac;">"Vot ou konte"</span> }</code></pre>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  function showApiTab(tab, btn) {
    ['identity', 'consent', 'crime', 'qr', 'webhook', 'vote'].forEach(function(t) {
      var el = document.getElementById('api-' + t);
      if (el) el.style.display = 'none';
    });
    var active = document.getElementById('api-' + tab);
    if (active) active.style.display = 'block';

    var copyBtn = btn.closest('.dev-code-card').querySelector('.copy-btn');
    if (copyBtn) copyBtn.setAttribute('data-copy-target', '#api-' + tab);

    btn.closest('.dev-tabs').querySelectorAll('.dev-tab').forEach(function(t) {
      t.classList.remove('is-active');
    });
    btn.classList.add('is-active');
  }

  document.addEventListener("click", async (e) => {
    const btn = e.target.closest("[data-copy-target]");
    if (!btn) return;
    const selector = btn.getAttribute("data-copy-target");
    const el = document.querySelector(selector);
    if (!el) return;
    const text = el.innerText || el.textContent || "";
    try {
      await navigator.clipboard.writeText(text);
      const labelEl = btn.querySelector(":scope > :not(i)") || btn;
      const original = labelEl.textContent;
      labelEl.textContent = "Copied";
      setTimeout(() => (labelEl.textContent = original), 900);
    } catch (err) {
      const ta = document.createElement("textarea");
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      document.body.removeChild(ta);
    }
  });
</script>
