      }
    ],
    <span style="color: #86efac;">"risk_assessment"</span>: {
      <span style="color: #86efac;">"risk_level"</span>: <span style="color: #fbbf24;">"elevated"</span>,
      <span style="color: #86efac;">"score"</span>: <span style="color: #fbbf24;">50</span>,
      <span style="color: #86efac;">"factors"</span>: { <span style="color: #86efac;">"has_active_warrant"</span>: <span style="color: #7dd3fc;">false</span> }
