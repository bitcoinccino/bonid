  },
  <span style="color: #86efac;">"access_tier"</span>: <span style="color: #86efac;">"tier_3"</span>,
  <span style="color: #86efac;">"partner"</span>: <span style="color: #86efac;">"Police Nationale d'Haiti"</span>,
  <span style="color: #86efac;">"timestamp"</span>: <span style="color: #86efac;">"2026-11-10T14:30:00Z"</span>
