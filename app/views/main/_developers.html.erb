<!-- =============================== -->
<!-- SECTION 4 — DEVELOPER API DOCS -->
<!-- =============================== -->
<section
  id="developers"
  class="developer-section text-white py-5 position-relative bg-dev-blue overflow-hidden"
>

  <!-- Decorative grid (full bleed) -->
  <div class="dev-grid"></div>

  <!-- Constrained content -->
  <div class="container position-relative py-5">

    <!-- Header -->
    <div class="text-center mb-5">
      <h2 class="display-5 fw-bold text-white mb-3">
        <%= t("main.developers.title_html").html_safe %>
      </h2>

      <p class="lead text-light opacity-75 col-lg-8 mx-auto">
        <%= t("main.developers.subtitle") %>
      </p>
    </div>

    <div class="row g-5 align-items-stretch">

      <!-- LEFT -->
      <div class="col-lg-5">
        <div class="dev-info-card p-4 p-lg-5 rounded-4 h-100">
          <h4 class="fw-bold text-white mb-3">
            <%= t("main.developers.card.title") %>
          </h4>

          <ul class="list-unstyled text-light lh-lg mb-4" style="font-size: 14px;">
            <li class="d-flex align-items-start gap-3 mb-2">
              <i class="ri-flashlight-line" style="font-size: 22px; color: #7dd3fc; min-width: 24px;"></i>
              <span>Instant response under 200ms</span>
            </li>
            <li class="d-flex align-items-start gap-3 mb-2">
              <i class="ri-shield-keyhole-line" style="font-size: 22px; color: #7dd3fc; min-width: 24px;"></i>
              <span>OAuth 2.0 + HMAC secured dual auth</span>
            </li>
            <li class="d-flex align-items-start gap-3 mb-2">
              <i class="ri-database-2-line" style="font-size: 22px; color: #7dd3fc; min-width: 24px;"></i>
              <span>Full JSON identity + biometrics profile</span>
            </li>
            <li class="d-flex align-items-start gap-3 mb-2">
              <i class="ri-body-scan-line" style="font-size: 22px; color: #7dd3fc; min-width: 24px;"></i>
              <span>AWS Rekognition liveness + face match scores</span>
            </li>
            <li class="d-flex align-items-start gap-3 mb-2">
              <i class="ri-bar-chart-box-line" style="font-size: 22px; color: #7dd3fc; min-width: 24px;"></i>
              <span>Risk Score API with raw confidence for your thresholds</span>
            </li>
            <li class="d-flex align-items-start gap-3 mb-2">
              <i class="ri-rocket-2-line" style="font-size: 22px; color: #7dd3fc; min-width: 24px;"></i>
              <span>Sandbox + production environments</span>
            </li>
            <li class="d-flex align-items-start gap-3 mb-2">
              <i class="ri-code-s-slash-line" style="font-size: 22px; color: #7dd3fc; min-width: 24px;"></i>
              <span>Works with Rails, Node, Go, Python, PHP</span>
            </li>
          </ul>

          <%= link_to t("main.developers.card.cta"),
            "/api-docs/index.html",
            class: "btn btn-light btn-lg rounded-pill px-4 py-2 fw-bold shadow",
            target: "_blank",
            rel: "noopener" %>
        </div>
      </div>

      <!-- RIGHT — Tabbed API Examples -->
      <div class="col-lg-7">
        <div class="dev-code-card rounded-4 position-relative h-100 d-flex flex-column">

          <%# API Tabs %>
          <div class="d-flex flex-wrap gap-1 p-3 pb-0" style="border-bottom: 1px solid rgba(255,255,255,0.08);">
            <button class="dev-tab active" onclick="showApiTab('identity', this)" style="background: rgba(255,255,255,0.1); border: none; color: #fff; padding: 10px 16px; border-radius: 8px 8px 0 0; font-size: 14px; font-weight: 600; font-family: 'Inter', sans-serif; cursor: pointer;">
              <i class="ri-user-search-line me-1" style="font-size: 20px;"></i> Identity
            </button>
            <button class="dev-tab" onclick="showApiTab('consent', this)" style="background: none; border: none; color: rgba(255,255,255,0.5); padding: 10px 16px; border-radius: 8px 8px 0 0; font-size: 14px; font-weight: 600; font-family: 'Inter', sans-serif; cursor: pointer;">
              <i class="ri-shield-check-line me-1" style="font-size: 20px;"></i> Consent
            </button>
            <button class="dev-tab" onclick="showApiTab('crime', this)" style="background: none; border: none; color: rgba(255,255,255,0.5); padding: 10px 16px; border-radius: 8px 8px 0 0; font-size: 14px; font-weight: 600; font-family: 'Inter', sans-serif; cursor: pointer;">
              <i class="ri-alarm-warning-line me-1" style="font-size: 20px;"></i> Crime
            </button>
            <button class="dev-tab" onclick="showApiTab('qr', this)" style="background: none; border: none; color: rgba(255,255,255,0.5); padding: 10px 16px; border-radius: 8px 8px 0 0; font-size: 14px; font-weight: 600; font-family: 'Inter', sans-serif; cursor: pointer;">
              <i class="ri-qr-scan-2-line me-1" style="font-size: 20px;"></i> QR Scan
            </button>
            <button class="dev-tab" onclick="showApiTab('webhook', this)" style="background: none; border: none; color: rgba(255,255,255,0.5); padding: 10px 16px; border-radius: 8px 8px 0 0; font-size: 14px; font-weight: 600; font-family: 'Inter', sans-serif; cursor: pointer;">
              <i class="ri-link me-1" style="font-size: 20px;"></i> Webhook
            </button>
            <button class="dev-tab" onclick="showApiTab('vote', this)" style="background: none; border: none; color: rgba(255,255,255,0.5); padding: 10px 16px; border-radius: 8px 8px 0 0; font-size: 14px; font-weight: 600; font-family: 'Inter', sans-serif; cursor: pointer;">
              <i class="ri-checkbox-circle-line me-1" style="font-size: 20px;"></i> BonVote
            </button>
          </div>

          <button
            type="button"
            class="copy-btn"
            data-copy-target="#dev-code"
            aria-label="<%= t("main.developers.copy_aria") %>"
          >
            <%= t("main.developers.copy") %>
          </button>

          <%# Identity Lookup %>
          <pre id="api-identity" class="dev-code-block mb-0 flex-grow-1"><code><span style="color: #7dd3fc;">GET</span> /api/v1/identity/<span style="color: #86efac;">{bonid}</span>/status
<span style="color: #94a3b8;">Headers:</span> X-Partner-Api-Key: YOUR_KEY

<span style="color: #94a3b8;">Response:</span> <span style="color: #7dd3fc;">200 OK</span>
{
  <span style="color: #86efac;">"status"</span>: <span style="color: #86efac;">"success"</span>,
  <span style="color: #86efac;">"bonid"</span>: <span style="color: #86efac;">"BZ-1970-M-ND-P2334-0B6"</span>,
  <span style="color: #86efac;">"verification"</span>: {
    <span style="color: #86efac;">"found"</span>: <span style="color: #7dd3fc;">true</span>,
    <span style="color: #86efac;">"id_type"</span>: <span style="color: #86efac;">"BonID"</span>,
    <span style="color: #86efac;">"verified"</span>: <span style="color: #7dd3fc;">true</span>,
    <span style="color: #86efac;">"status"</span>: <span style="color: #86efac;">"approved"</span>,
    <span style="color: #86efac;">"expires_at"</span>: <span style="color: #86efac;">"2036-03-08T15:30:00Z"</span>
  },
  <span style="color: #86efac;">"partner"</span>: <span style="color: #86efac;">"Zellus"</span>,
  <span style="color: #86efac;">"timestamp"</span>: <span style="color: #86efac;">"2026-03-23T23:30:37-04:00"</span>
}</code></pre>

