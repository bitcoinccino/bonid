<span style="color: #7dd3fc;">GET</span> /api/v1/transaction_consents/<span style="color: #86efac;">{consent_token}</span>
<span style="color: #94a3b8;">Headers:</span> X-Partner-Api-Key: YOUR_KEY</code></pre>

          <%# BonVote — Election %>
          <pre id="api-vote" class="dev-code-block mb-0 flex-grow-1" style="display: none;"><code><span style="color: #94a3b8;">// 1. Check that a voter is eligible</span>
<span style="color: #7dd3fc;">GET</span> /api/v1/election/<span style="color: #86efac;">2026-presidential-round1</span>/eligibility
<span style="color: #94a3b8;">Headers:</span> X-BonID-Voter-Token (face-verified in the BonID app)

<span style="color: #94a3b8;">Response:</span> <span style="color: #7dd3fc;">200 OK</span>
{
