    <span style="color: #86efac;">"crime_types"</span>: {
      <span style="color: #86efac;">"Gang Activity"</span>: <span style="color: #7dd3fc;">1</span>,
      <span style="color: #86efac;">"Extortion"</span>: <span style="color: #7dd3fc;">1</span>
