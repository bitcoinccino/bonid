  <span style="color: #86efac;">"election_id"</span>: <span style="color: #86efac;">"2026-presidential-round1"</span>,
  <span style="color: #86efac;">"bonid"</span>: <span style="color: #86efac;">"BZ-1970-M-ND-P2334-0B6"</span>,
  <span style="color: #86efac;">"country"</span>: <span style="color: #86efac;">"HT"</span>,
  <span style="color: #86efac;">"ballot"</span>: {
    <span style="color: #86efac;">"type"</span>: <span style="color: #86efac;">"domestic"</span>,
    <span style="color: #86efac;">"department"</span>: <span style="color: #86efac;">"Nord"</span>
  }
}

<span style="color: #94a3b8;">// 2. Anyone can check a receipt — no login needed</span>
<span style="color: #7dd3fc;">GET</span> /api/v1/election/<span style="color: #86efac;">2026-presidential-round1</span>/verify/<span style="color: #86efac;">{receipt_hash}</span>

<span style="color: #94a3b8;">Response:</span> <span style="color: #7dd3fc;">200 OK</span>
{
