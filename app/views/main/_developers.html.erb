  <span style="color: #86efac;">"message"</span>: <span style="color: #86efac;">"Vòt ou konte"</span>,
  <span style="color: #86efac;">"election_id"</span>: <span style="color: #86efac;">"2026-presidential-round1"</span>,
  <span style="color: #86efac;">"timestamp"</span>: <span style="color: #86efac;">"2026-11-29T15:42:10Z"</span>
}</code></pre>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  function showApiTab(tab, btn) {
    ['identity', 'consent', 'crime', 'qr', 'webhook', 'vote'].forEach(function(t) {
      var el = document.getElementById('api-' + t);
      if (el) el.style.display = 'none';
    });
    var active = document.getElementById('api-' + tab);
    if (active) active.style.display = 'block';

    var copyBtn = btn.closest('.dev-code-card').querySelector('.copy-btn');
    if (copyBtn) copyBtn.setAttribute('data-copy-target', '#api-' + tab);

    var caption = btn.closest('.dev-code-card').querySelector('.dev-tab-caption span');
    if (caption) caption.textContent = btn.getAttribute('data-caption') || '';

    btn.closest('.dev-tabs').querySelectorAll('.dev-tab').forEach(function(t) {
      t.classList.remove('is-active');
      t.setAttribute('aria-selected', 'false');
    });
    btn.classList.add('is-active');
    btn.setAttribute('aria-selected', 'true');
  }

  document.addEventListener("click", async (e) => {
    const btn = e.target.closest("[data-copy-target]");
    if (!btn) return;
    const selector = btn.getAttribute("data-copy-target");
    const el = document.querySelector(selector);
    if (!el) return;
    const text = el.innerText || el.textContent || "";
    try {
      await navigator.clipboard.writeText(text);
      const labelEl = btn.querySelector(":scope > :not(i)") || btn;
      const original = labelEl.textContent;
      labelEl.textContent = "Copied";
      setTimeout(() => (labelEl.textContent = original), 900);
    } catch (err) {
      const ta = document.createElement("textarea");
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      document.body.removeChild(ta);
    }
  });
</script>
