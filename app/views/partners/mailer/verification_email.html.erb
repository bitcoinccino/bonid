<!DOCTYPE html>
<html>
  <body style="font-family: Inter, sans-serif; background:#f3f4f6; margin:0; padding:40px;">

    <div style="
      max-width:600px;
      margin:0 auto;
      background:white;
      padding:32px;
      border-radius:14px;
      border:1px solid #e2e8f0;
      box-shadow:0 4px 16px rgba(0,0,0,0.06);
    ">

      <!-- HEADER -->
      <h2 style="
        margin-top:0;
        margin-bottom:16px;
        color:#00209F;
        font-family: Montserrat, sans-serif;
      ">
        BonID – Partner Verification Required
      </h2>

      <p style="font-size:16px; color:#2d3748; margin-bottom:20px;">
        Hello <strong><%= @partner.name %></strong>,
      </p>

      <p style="font-size:16px; color:#4a5568; line-height:1.6;">
        Thank you for applying to become a verified partner on
        <strong>BonID</strong> — Haiti’s Digital Identity Platform.
        To complete your partner onboarding, click the button below:
      </p>

      <!-- BUTTON WITH TOKEN -->
      <p style="margin:28px 0; text-align:center;">
        <a href="<%= partners_verify_url(token: @partner.email_verification_token) %>"
           style="
             background:#1A936F;
             color:white;
             padding:14px 28px;
             font-size:16px;
             font-weight:600;
             border-radius:8px;
             text-decoration:none;
             display:inline-block;
           ">
          Verify Your Partner Account
        </a>
      </p>

      <p style="font-size:15px; color:#718096; margin-top:30px;">
        If you did not request this verification link, please ignore this message.
      </p>

      <hr style="border-top:1px solid #e2e8f0; margin:35px 0;">

      <!-- FOOTER -->
      <p style="font-size:13px; color:#a0aec0; text-align:center;">
        © <%= Time.zone.now.year %> BonID / Verifyem • All Rights Reserved
      </p>

    </div>
  </body>
</html>
