<%= render "layouts/mailer/header", title: "Your Partner Account is Approved" %>

<p style="font-size:16px; color:#2D3748;">
  Hello <strong><%= @partner.contact_person || @partner.name %></strong>,
</p>

<p style="font-size:16px; color:#4A5568; line-height:26px;">
  Your BonID Partner Account has been approved.  
  You may now activate your portal and begin verifying identities.
</p>

<!-- BUTTON -->
<p style="margin:30px 0; text-align:center;">
  <a href="<%= @start_url %>"
     style="background:#00209F; color:white; padding:14px 32px;
            border-radius:50px; text-decoration:none; font-weight:600;">
    Activate Your Partner Portal
  </a>
</p>

<hr style="margin:40px 0;">

<h3 style="font-size:20px; color:#1A202C;">Your Referral QR Code</h3>

<p style="font-size:15px; color:#4A5568;">
  Share this QR code with your customers so they can sign up to BonID under your institution.
</p>

<div style="text-align:center; margin:20px 0;">
  <img src="data:image/png;base64,<%= @qr_png_base64 %>"
       style="width:260px; height:260px; border-radius:12px;">
</div>

<%= render "layouts/mailer/footer" %>
