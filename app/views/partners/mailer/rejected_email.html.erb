<%= render "layouts/mailer/header", title: "Your Application Was Not Approved" %>

<p style="font-size:16px; color:#2D3748;">
  Dear <strong><%= @partner.name %></strong>,
</p>

<p style="font-size:16px; line-height:26px; color:#4A5568;">
  After reviewing your partner application, we were unable to approve it at this time.
</p>

<h3 style="margin-top:20px; color:#C53030;">Reason for Rejection</h3>

<p style="font-size:15px; color:#4A5568;">
  <strong><%= @reason.presence || "No specific reason provided." %></strong>
</p>

<% if @comment.present? %>
  <p style="font-size:15px; color:#4A5568;">
    <%= @comment %>
  </p>
<% end %>

<p style="margin-top:28px; font-size:16px; color:#4A5568;">
  You may reapply at any time by visiting:
</p>

<p style="font-size:16px; font-weight:600; color:#00209F;">
  <%= partners_url %>
</p>

<%= render "layouts/mailer/footer" %>
