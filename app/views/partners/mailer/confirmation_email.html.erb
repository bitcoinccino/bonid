<div style="font-family: Inter, sans-serif; padding: 20px;">

  <h2 style="color: #00209F; font-weight: 700;">
    Welcome to BonID
  </h2>

  <p style="font-size: 15px; color: #333;">
    Hello <strong><%= @partner.contact_person.presence || @partner.name %></strong>,
  </p>

  <p style="font-size: 15px; color: #333;">
    Your partner application has been received successfully.
    Our partnerships team will review your information and follow up shortly.
  </p>

  <p style="font-size: 15px; color: #333; margin-top: 20px;">
    <strong>Organization:</strong> <%= @partner.name %><br>
    <strong>Sector:</strong> <%= @partner.sector.to_s.humanize %>
  </p>

  <p style="font-size: 15px; color: #333;">
    Thank you for choosing BonID.
  </p>

  <p style="margin-top: 30px; font-size: 13px; color: #888;">
    — The BonID Partnerships Team
  </p>

</div>
