
<h1 class="mb-4">Edit Partner</h1>

<%= form_with model: @partner, url: admin_partner_path(@partner.uuid), method: :patch, local: true, data: { controller: "form-handler" } do |f| %>
  <!-- Logo Upload -->
  <div class="mb-4 text-center">
    <label for="partner_logo"
           class="logo-upload-circle position-relative d-inline-block"
           data-controller="logo-preview"
           data-logo-preview-target="label"
           style="width: 140px; height: 140px; border-radius: 50%; background-color: #f0f4ff; box-shadow: 0 0 10px rgba(9,44,115,0.15); overflow: hidden; cursor: pointer;">
      <% if @partner.logo.attached? %>
        <%= image_tag @partner.logo.variant(resize_to_fill: [140, 140]), alt: "Logo", class: "w-100 h-100 object-fit-cover rounded-circle logo-preview-img", data: { logo_preview_target: "image" } %>
      <% else %>
        <div class="placeholder-icon" data-logo-preview-target="image"
             style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #092C73; font-size: 3rem;">
          <i class="ri-image-line"></i>
        </div>
      <% end %>

      <%= f.file_field :logo, accept: "image/*", class: "visually-hidden", data: { action: "logo-preview#preview", logo_preview_target: "input" } %>
    </label>
    <div class="form-text mt-2" style="color: #555;">PNG, JPG, or SVG — shown on public listings.</div>
  </div>

  <!-- Partner Name -->
  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control", required: true %>
  </div>

  <!-- Sector -->
  <div class="mb-3">
    <%= f.label :sector, class: "form-label" %>
    <%= f.select :sector, Partner.sectors.keys.map { |s| [s.humanize, s] }, {}, class: "form-select" %>
  </div>

  <!-- Email -->
  <div class="mb-3">
    <%= f.label :email, class: "form-label" %>
    <%= f.email_field :email, class: "form-control" %>
  </div>

  <!-- Phone Number -->
  <div class="mb-3">
    <%= f.label :phone_number, class: "form-label" %>
    <%= f.telephone_field :phone_number, class: "form-control" %>
  </div>

  <!-- Website -->
  <div class="mb-3">
    <%= f.label :website, class: "form-label" %>
    <%= f.url_field :website, class: "form-control" %>
  </div>

  <!-- Description -->
  <div class="mb-3">
    <%= f.label :description, class: "form-label" %>
    <%= f.text_area :description, class: "form-control", rows: 4 %>
  </div>

  <!-- Admin User -->
  <div class="mb-3">
    <%= f.label :admin_user_id, "Admin User", class: "form-label" %>
    <%= f.collection_select :admin_user_id, User.all, :id, :email, include_blank: "None", class: "form-select" %>
  </div>

  <!-- Verified At -->
  <div class="mb-3">
    <%= f.label :verified_at, class: "form-label" %>
    <%= f.datetime_select :verified_at, class: "form-control" %>
  </div>

  <!-- Submit Button -->
  <div class="mt-4 text-center">
    <%= f.submit "Update Partner", class: "btn btn-primary", data: { form_handler_target: "submit" } %>
    <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true" data-form-handler-target="spinner"></span>
    <span data-form-handler-target="submitText" class="ms-2"></span>
  </div>

  <!-- Error Message -->
  <div data-form-handler-target="error" class="d-none mt-3 alert alert-danger text-center small"></div>
<% end %>

<style>
  .logo-upload-circle:hover {
    background-color: #e3ecff;
    box-shadow: 0 0 12px rgba(9, 44, 115, 0.3);
    transition: all 0.3s ease;
  }
  .logo-upload-circle img.logo-preview-img {
    object-fit: cover;
    border-radius: 50%;
    width: 100%;
    height: 100%;
  }
</style>
