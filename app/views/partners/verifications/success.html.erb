<div class="container py-5 text-center">
  <h1 class="fw-bold text-success mb-3">Email Verified!</h1>

  <p class="lead mb-4">
    Thank you. Your partner application has been updated and is now under review.
  </p>

  <p class="small text-muted">
    Redirecting you to the home page in <span id="countdown">5</span> seconds…
  </p>

  <a href="/" class="btn btn-primary mt-3">Go Home Now</a>
</div>

<script>
  let seconds = 5;
  const el = document.getElementById("countdown");

  const timer = setInterval(() => {
    seconds--;
    el.textContent = seconds;

    if (seconds <= 0) {
      clearInterval(timer);
      window.location.href = "/";
    }
  }, 1000);
</script>
