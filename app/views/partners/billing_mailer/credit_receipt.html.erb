<%# app/views/partners/billing_mailer/credit_receipt.html.erb %>
<%# Uses unified mailer layout %>

<%# Greeting %>
<p style="color: #1a1a2e; line-height: 1.6; margin-top: 0; font-size: 15px;">
  Bonjou <strong><%= @partner.contact_person || @partner.name %></strong>,
</p>
<p style="color: #4a5568; line-height: 1.6; font-size: 14px;">
  Rechaj ou a reyisi. Men resi ou:
</p>

<%# Credits Added — Big number %>
<div style="background: #F0FFF4; border: 2px solid #C6F6D5; border-radius: 12px; padding: 24px; text-align: center; margin: 24px 0;">
  <div style="color: #198754; font-size: 14px; font-weight: 500; margin-bottom: 4px;">Credits Added</div>
  <div style="color: #198754; font-size: 42px; font-weight: 800; line-height: 1;">
    +<%= @credits.to_s.reverse.gsub(/(\d{3})(?=\d)/, '\\1,').reverse %>
  </div>
  <div style="color: #6C757D; font-size: 13px; margin-top: 8px;">
    New Balance: <strong style="color: #00209F;"><%= @new_balance.to_s.reverse.gsub(/(\d{3})(?=\d)/, '\\1,').reverse %> Credits</strong>
  </div>
</div>

<%# Receipt Details Table %>
<table style="width: 100%; border-collapse: collapse; margin: 20px 0; font-size: 14px;">
  <tr>
    <td style="padding: 12px 0; color: #6C757D; border-bottom: 1px solid #f0f0f0;">Dat</td>
    <td style="padding: 12px 0; font-weight: 600; border-bottom: 1px solid #f0f0f0; text-align: right;">
      <%= @receipt_date.strftime("%d %B %Y, %H:%M") %>
    </td>
  </tr>
  <tr>
    <td style="padding: 12px 0; color: #6C757D; border-bottom: 1px solid #f0f0f0;">Montan</td>
    <td style="padding: 12px 0; font-weight: 600; border-bottom: 1px solid #f0f0f0; text-align: right;">
      <%= @payment.formatted_amount rescue "$#{'%.2f' % @credits}" %>
      <% if @payment.respond_to?(:currency) && @payment.currency == "HTG" %>
        <span style="color: #6C757D; font-weight: 400; font-size: 12px;">(&asymp; $<%= @usd_amount %> USD)</span>
      <% end %>
    </td>
  </tr>
  <tr>
    <td style="padding: 12px 0; color: #6C757D; border-bottom: 1px solid #f0f0f0;">Metòd Peman</td>
    <td style="padding: 12px 0; font-weight: 600; border-bottom: 1px solid #f0f0f0; text-align: right;">
      <% if @payment.payment_method == "moncash" %>
        <span style="background: #FFF3CD; color: #856404; padding: 3px 10px; border-radius: 12px; font-size: 12px;">MonCash</span>
      <% else %>
        <span style="background: #CCE5FF; color: #004085; padding: 3px 10px; border-radius: 12px; font-size: 12px;">Stripe</span>
      <% end %>
    </td>
  </tr>
  <tr>
    <td style="padding: 12px 0; color: #6C757D; border-bottom: 1px solid #f0f0f0;">Nimewo Komand</td>
    <td style="padding: 12px 0; font-weight: 600; border-bottom: 1px solid #f0f0f0; text-align: right; font-family: monospace; font-size: 13px;">
      <%= @payment.respond_to?(:order_id) ? @payment.order_id : @payment.id %>
    </td>
  </tr>
  <tr>
    <td style="padding: 12px 0; color: #6C757D;">Patnè</td>
    <td style="padding: 12px 0; font-weight: 600; text-align: right;"><%= @partner.name %></td>
  </tr>
</table>

<%# What you can do with these credits %>
<div style="background: #F8F9FA; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px; margin: 24px 0;">
  <div style="font-weight: 700; color: #00209F; font-size: 14px; margin-bottom: 12px;">
    Sa ou ka fè ak <%= @credits.to_s.reverse.gsub(/(\d{3})(?=\d)/, '\\1,').reverse %> Credits:
  </div>
  <table style="width: 100%; font-size: 13px; border-collapse: collapse;">
    <tr>
      <td style="padding: 6px 0; color: #198754;">Standard Checks</td>
      <td style="padding: 6px 0; color: #1a1a2e; text-align: right; font-weight: 600;"><%= (@credits.to_d / BigDecimal("0.49")).floor %></td>
      <td style="padding: 6px 0; color: #6C757D; text-align: right; font-size: 12px;">$0.49 chak</td>
    </tr>
    <tr>
      <td style="padding: 6px 0; color: #00209F;">Verifications</td>
      <td style="padding: 6px 0; color: #1a1a2e; text-align: right; font-weight: 600;"><%= (@credits.to_d / BigDecimal("1.49")).floor %></td>
      <td style="padding: 6px 0; color: #6C757D; text-align: right; font-size: 12px;">$1.49 chak</td>
    </tr>
    <tr>
      <td style="padding: 6px 0; color: #DC3545;">Premium</td>
      <td style="padding: 6px 0; color: #1a1a2e; text-align: right; font-weight: 600;"><%= (@credits.to_d / BigDecimal("1.99")).floor %></td>
      <td style="padding: 6px 0; color: #6C757D; text-align: right; font-size: 12px;">$1.99 chak</td>
    </tr>
  </table>
</div>

<%# CTA Button %>
<div style="text-align: center; margin: 28px 0 12px;">
  <a href="<%= @wallet_url %>"
     style="display: inline-block; background: #00209F; color: #FFFFFF; padding: 14px 36px; border-radius: 25px; text-decoration: none; font-weight: 700; font-size: 15px;">
    Wè Wallet Ou
  </a>
</div>

<div style="text-align: center; margin-top: 16px;">
  <span style="color: #a0aec0; font-size: 12px;">1 Credit = $1.00 USD</span>
</div>
