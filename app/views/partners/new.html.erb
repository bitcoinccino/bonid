<%= simple_form_for @partner,
      url: partners_path,
      html: {
        multipart: true,
        class: "partner-signup-form",
        data: {
          controller: "form-handler",
          action: "turbo:submit-start->form-handler#submitStart turbo:submit-end->form-handler#submitEnd turbo:submit-error->form-handler#submitError"
        }
      } do |f| %>

  <%# Waitlist lead attribution (set on the hand-off from the landing modal) %>
  <%= f.hidden_field :waitlist_signup_id if @partner.waitlist_signup_id.present? %>

  <!-- Main Form -->
  <%= render "form", f: f %>

<% end %>
