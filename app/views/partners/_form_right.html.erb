<%# app/views/partners/_form_right.html.erb %>
<%# Right column: White form card %>

<div class="partner-form-column">
  <h2 class="form-section-title">Partner Application</h2>

  <!-- Unified Partner Form Fields -->
  <%= render "partner_portal/shared/components/unified_partner_form", f: f %>

  <!-- Logo Upload -->
  <div class="form-group mt-4">
    <label class="form-label">Organization Logo <small class="text-muted">(Optional)</small></label>
    <%= f.file_field :logo,
        accept: "image/png,image/jpeg,image/jpg,image/webp",
        class: "form-control" %>
    <small class="form-text">PNG or JPG, max 2MB</small>
  </div>

  <!-- Terms and Submit -->
  <div class="mt-4">
    <div class="form-check mb-3">
      <%= f.check_box :terms_accepted, class: "form-check-input", id: "terms_accepted" %>
      <label class="form-check-label small" for="terms_accepted">
        I agree to the BonID <a href="#" target="_blank" class="text-decoration-underline">Terms of Service</a>
        and <a href="#" target="_blank" class="text-decoration-underline">Privacy Policy</a>
        <span class="text-danger">*</span>
      </label>
    </div>
    <div class="text-end">
      <%= f.submit "Submit Application", class: "btn-partner-submit" %>
    </div>
  </div>
</div>
