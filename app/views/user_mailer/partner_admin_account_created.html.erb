<% content_for :title, "Welcome to BonID Partner Portal" %>

<div style="font-family:'Inter',Arial,sans-serif; color:#101828;">
  <div style="margin:0 0 10px;">
    <div style="font-family:'Montserrat','Inter',Arial,sans-serif; font-weight:800; font-size:18px; color:#00209F; margin:0;">
      Welcome to BonID Partner Portal
    </div>
    <div style="margin-top:6px; font-size:13px; color:#475467; line-height:1.6;">
      You’ve been invited to manage your organization on the BonID Partner Portal.
    </div>
  </div>

  <div style="margin:14px 0 12px; font-size:14px; line-height:1.75;">
    <p style="margin:0 0 10px;">
      Hello <strong><%= @user.full_name.presence || @user.email %></strong>,
    </p>

    <p style="margin:0 0 10px;">
      You’ve been invited to manage
      <strong><%= @partner&.name || "your organization" %></strong>
      on the BonID Partner Portal.
    </p>

    <p style="margin:0 0 10px;">
      Click the button below to accept the invitation and set up your account:
    </p>
  </div>

  <div style="margin:10px 0 14px;">
    <a href="<%= accept_user_invitation_url(invitation_token: @token) %>"
       style="display:inline-block; padding:12px 18px; background:#00209F; color:#ffffff;
              text-decoration:none; font-weight:900; border-radius:999px;
              font-family:'Montserrat','Inter',Arial,sans-serif; font-size:14px;">
      Accept Invitation
    </a>
  </div>

  <div style="margin-top:8px; font-size:12px; color:#475467; line-height:1.6;">
    If you do not wish to join, you can ignore this email. Your account will not be created until you accept.
  </div>

  <div style="margin-top:12px; font-size:13px; color:#475467;">
    — BonID Partner Team
  </div>
</div>
