<% content_for :title, "Reset your password — BonID" %>

<div style="font-family:'Inter',Arial,sans-serif; color:#101828;">
  <div style="margin:0 0 10px;">
    <div style="font-family:'Montserrat','Inter',Arial,sans-serif; font-weight:800; font-size:18px; color:#00209F; margin:0;">
      Reset your password 
    </div>
    <div style="margin-top:6px; font-size:13px; color:#475467; line-height:1.6;">
      Use the button below to reset your password securely.
    </div>
  </div>

  <!-- OPTIONAL: “security chip” like visitor vibe -->
  <div style="margin:10px 0 12px;">
    <span style="display:inline-block; padding:7px 10px; border-radius:999px;
                 background:#eef2ff; border:1px solid rgba(0,32,159,0.16);
                 color:#00209F; font-weight:900; font-size:12px;
                 font-family:'Montserrat','Inter',Arial,sans-serif;">
      Secure Action
    </span>
  </div>

  <div style="margin:12px 0 12px; font-size:14px; line-height:1.75;">
    <p style="margin:0 0 10px;">
      Hello <strong><%= @resource.try(:first_name).presence || "there" %></strong>,
    </p>

    <p style="margin:0 0 10px;">
      We received a request to reset your BonID password. If this was you, click below:
    </p>
  </div>

  <div style="margin:10px 0 14px;">
    <!-- IMPORTANT: use your role-based redirect URL if present -->
    <a href="<%= (defined?(@redirect_url) && @redirect_url.present?) ? @redirect_url : edit_password_url(@resource, reset_password_token: @token) %>"
       style="display:inline-block; padding:12px 18px; background:#00209F; color:#ffffff;
              text-decoration:none; font-weight:900; border-radius:999px;
              font-family:'Montserrat','Inter',Arial,sans-serif; font-size:14px;">
      Reset Password
    </a>
  </div>

  <div style="margin-top:8px; font-size:12px; color:#475467; line-height:1.6;">
    If you didn’t request this, you can safely ignore this email.
  </div>

  <div style="margin-top:12px; font-size:13px; color:#475467;">
    — BonID Security Team
  </div>
</div>
