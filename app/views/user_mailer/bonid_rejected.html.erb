<% content_for :title, "BonID Submission Rejected" %>

<div style="font-family:'Inter',Arial,sans-serif; color:#101828;">
  <div style="margin:0 0 10px;">
    <div style="font-family:'Montserrat','Inter',Arial,sans-serif; font-weight:800; font-size:18px; color:#E53E3E; margin:0;">
      Submission Rejected 
    </div>
    <div style="margin-top:6px; font-size:13px; color:#475467; line-height:1.6;">
      Your BonID submission was not approved. Please review the reason below and resubmit.
    </div>
  </div>

  <div style="margin:14px 0 12px; font-size:14px; line-height:1.75;">
    <p style="margin:0 0 10px;">
      Bonjou <strong><%= @user.first_name %></strong>,
    </p>
  </div>

  <!-- SUBMISSION CHIP -->
  <div style="margin:0 0 12px;">
    <span style="display:inline-block; padding:7px 10px; border-radius:999px;
                 background:#fff5f5; border:1px solid rgba(229,62,62,0.22);
                 color:#E53E3E; font-weight:900; font-size:12px;
                 font-family:'Montserrat','Inter',Arial,sans-serif;">
      Submission #<%= @submission.id %>
    </span>
  </div>

  <!-- ENGLISH -->
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
         style="margin:10px 0 12px; background:#ffffff; border-radius:14px;
                border:1px solid rgba(229,62,62,0.22); overflow:hidden;">
    <tr>
      <td style="padding:14px; background:#fff5f5;">
        <div style="font-size:12px; letter-spacing:0.6px; color:#7a1f1f; text-transform:uppercase; font-weight:900;">
          English
        </div>

        <div style="margin-top:8px; font-size:14px; line-height:1.75; color:#101828;">
          Unfortunately, your BonID submission has been <strong>rejected</strong>.
        </div>

        <div style="margin-top:10px; font-size:13px; line-height:1.6; color:#475467;">
          <strong style="color:#101828;">Reason:</strong>
          <%= @submission.rejection_reason&.humanize || "Not specified" %>
        </div>
      </td>
    </tr>
  </table>

  <!-- KREYÒL -->
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
         style="margin:0 0 12px; background:#ffffff; border-radius:14px;
                border:1px solid rgba(0,32,159,0.16); overflow:hidden;">
    <tr>
      <td style="padding:14px; background:#f7f9ff;">
        <div style="font-size:12px; letter-spacing:0.6px; color:#1b2559; text-transform:uppercase; font-weight:900;">
          Kreyòl
        </div>

        <div style="margin-top:8px; font-size:14px; line-height:1.75; color:#101828;">
          Malerezman, demann BonID ou a <strong>rejte</strong> ❌.
        </div>

        <div style="margin-top:10px; font-size:13px; line-height:1.6; color:#475467;">
          <strong style="color:#101828;">Rezon:</strong>
          <%= @submission.rejection_reason&.humanize || "Pa presize" %>
        </div>
      </td>
    </tr>
  </table>

  <div style="margin-top:6px; font-size:13px; line-height:1.6; color:#475467;">
    You may log in to your account to resubmit documents.<br>
    Ou ka konekte nan kont ou pou soumèt dokiman ankò.
  </div>

  <div style="margin-top:12px; font-size:13px; color:#475467;">
    — The BonID Team
  </div>
</div>
