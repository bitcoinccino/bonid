
<% main_navigation_links.each do |link| %>
  <li class="nav-item">
    <%= link_to link[:path],
      class: "nav-link #{link[:classes]} fw-semibold font-montserrat",
      data: link[:data] || {} do %>

      <% if link[:icon] %>
        <i class="<%= link[:icon] %> me-1"></i>
      <% end %>

      <%= link[:title] %>
    <% end %>
  </li>
<% end %>
