
<li class="nav-item dropdown">
  <a
    class="nav-link dropdown-toggle fw-semibold"
    href="#"
    role="button"
    data-bs-toggle="dropdown"
    aria-expanded="false"
  >
    <i class="ri-function-line me-1 text-haitian-blue"></i>
    <%= t("main.navbar.products") %>
  </a>

  <ul class="dropdown-menu bonid-dropdown">

    <% product_groups.each_with_index do |group, idx| %>
      <% if idx > 0 %>
        <li><hr class="dropdown-divider"></li>
      <% end %>

      <div class="dropdown-label<%= ' mt-2' if idx > 0 %>"><%= t(group[:label_key]) %></div>

      <% group[:items].each do |product| %>
        <li>
          <%= link_to product[:path],
            class: "dropdown-item d-flex align-items-center gap-3" do %>
            <i class="<%= product[:icon] %> dropdown-icon"></i>
            <div>
              <strong><%= product[:name] %></strong>
              <small class="d-block text-muted"><%= product[:description] %></small>
            </div>
            <% if product[:badge] %>
              <span class="badge <%= product[:badge_class] %> ms-auto"><%= product[:badge] %></span>
            <% end %>
          <% end %>
        </li>
      <% end %>
    <% end %>

    <li><hr class="dropdown-divider"></li>

    <li class="px-3 py-2">
      <div class="d-grid gap-2">
        <% getting_started_links.each do |link| %>
          <%= link_to link[:path],
            class: "btn btn-sm fw-semibold text-white d-flex align-items-center justify-content-center gap-2",
            style: "background-color: #00209F; border-color: #00209F;",
            data: link[:data] || {} do %>
            <i class="<%= link[:icon] %>"></i> <%= link[:title] %>
          <% end %>
        <% end %>
      </div>
    </li>

    <li class="px-3 pb-2 text-center">
      <%= link_to partners_login_path, class: "small text-muted text-decoration-none" do %>
        <%= t("main.navbar.partner_login_prompt") %>
        <span class="fw-semibold" style="color: #00209F;"><%= t("main.navbar.partner_login") %></span>
      <% end %>
    </li>

  </ul>
</li>
