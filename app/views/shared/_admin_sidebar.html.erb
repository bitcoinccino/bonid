<%# app/views/shared/_admin_sidebar.html.erb %>
<%# Admin sidebar — grouped by domain %>

<%# Mobile backdrop %>
<div class="admin-sidebar-backdrop d-lg-none" id="sidebarBackdrop"></div>

<%# Sidebar %>
<nav class="admin-sidebar" id="adminSidebar" aria-label="Admin Sidebar">
  <%# Mobile close button %>
  <button type="button"
          class="sidebar-close-btn d-lg-none"
          id="sidebarCloseBtn"
          aria-label="Close sidebar">
    <i class="ri-close-line"></i>
  </button>

  <%# Admin logo and info %>
  <div class="admin-logo-section">
    <div class="admin-logo-wrapper">
      <div class="admin-logo-placeholder">
        <i class="ri-shield-star-line"></i>
      </div>
    </div>
    <div class="admin-name">BonID Admin</div>
    <div class="admin-role"><%= current_admin_user&.email&.split("@")&.first&.titleize || "Administrator" %></div>
  </div>

  <%# Navigation links %>
  <ul class="nav flex-column sidebar-nav">

    <%# ── Dashboard ── %>
    <li class="nav-item">
      <%= link_to admin_root_path,
                  class: "nav-link #{'active' if current_page?(admin_root_path)}" do %>
        <i class="ri-dashboard-line"></i>
        <span>Dashboard</span>
      <% end %>
    </li>

    <%# ══════════════════════════════════════════════ %>
    <%# ── IDANTITE / IDENTITY ── %>
    <%# ══════════════════════════════════════════════ %>
    <li class="nav-item mt-3">
      <small class="nav-section-label text-muted text-uppercase px-3" style="font-size: 10px; letter-spacing: 1px;">Idantite</small>
    </li>
    <li class="nav-item">
      <%= link_to admin_identity_submissions_path,
                  class: "nav-link #{'active' if current_page?(admin_identity_submissions_path)}" do %>
        <i class="ri-id-card-line"></i>
        <span>BonIDs</span>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to admin_name_change_requests_path,
                  class: "nav-link #{'active' if current_page?(admin_name_change_requests_path)}" do %>
        <i class="ri-edit-line"></i>
        <span>Name Changes</span>
        <% pending_count = NameChangeRequest.pending.count %>
        <% if pending_count > 0 %>
          <span class="badge bg-warning text-dark rounded-pill ms-auto"><%= pending_count %></span>
        <% end %>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to admin_qr_scan_logs_path,
                  class: "nav-link #{'active' if current_page?(admin_qr_scan_logs_path)}" do %>
        <i class="ri-scan-line"></i>
        <span>BonID Scans</span>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to admin_reviewers_path,
                  class: "nav-link #{'active' if current_page?(admin_reviewers_path)}" do %>
        <i class="ri-user-search-line"></i>
        <span>Reviewers</span>
      <% end %>
    </li>

    <%# ══════════════════════════════════════════════ %>
    <%# ── PATNE / PARTNERS ── %>
    <%# ══════════════════════════════════════════════ %>
    <li class="nav-item mt-3">
      <small class="nav-section-label text-muted text-uppercase px-3" style="font-size: 10px; letter-spacing: 1px;">Patnè</small>
    </li>
    <li class="nav-item">
      <%= link_to admin_partners_path,
                  class: "nav-link #{'active' if current_page?(admin_partners_path)}" do %>
        <i class="ri-building-line"></i>
        <span>Partners</span>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to admin_partner_schemas_path,
                  class: "nav-link #{'active' if current_page?(admin_partner_schemas_path)}" do %>
        <i class="ri-folder-line"></i>
        <span>Schemas</span>
      <% end %>
    </li>

    <%# ══════════════════════════════════════════════ %>
    <%# ── FINANS / BILLING ── %>
    <%# ══════════════════════════════════════════════ %>
    <li class="nav-item mt-3">
      <small class="nav-section-label text-muted text-uppercase px-3" style="font-size: 10px; letter-spacing: 1px;">Finans</small>
    </li>
    <li class="nav-item">
      <%= link_to admin_billing_path,
                  class: "nav-link #{'active' if current_page?(admin_billing_path)}" do %>
        <i class="ri-money-dollar-circle-line"></i>
        <span>Billing</span>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to admin_billing_credit_ledger_path,
                  class: "nav-link #{'active' if current_page?(admin_billing_credit_ledger_path)}" do %>
        <i class="ri-file-list-3-line"></i>
        <span>Credit Ledger</span>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to admin_billing_payments_path,
                  class: "nav-link #{'active' if current_page?(admin_billing_payments_path)}" do %>
        <i class="ri-bank-card-line"></i>
        <span>Payments</span>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to admin_api_usage_index_path,
                  class: "nav-link #{'active' if current_page?(admin_api_usage_index_path)}" do %>
        <i class="ri-bar-chart-2-line"></i>
        <span>API Usage</span>
      <% end %>
    </li>

    <%# ══════════════════════════════════════════════ %>
    <%# ── TOURIS / VISITORS ── %>
    <%# ══════════════════════════════════════════════ %>
    <li class="nav-item mt-3">
      <small class="nav-section-label text-muted text-uppercase px-3" style="font-size: 10px; letter-spacing: 1px;">Touris</small>
    </li>
    <li class="nav-item">
      <%= link_to admin_visitor_submissions_path,
                  class: "nav-link #{'active' if current_page?(admin_visitor_submissions_path)}" do %>
        <i class="ri-passport-line"></i>
        <span>Visitors</span>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to admin_visitor_analytics_path,
                  class: "nav-link #{'active' if current_page?(admin_visitor_analytics_path)}" do %>
        <i class="ri-bar-chart-line"></i>
        <span>Visitor Analytics</span>
      <% end %>
    </li>

    <%# ══════════════════════════════════════════════ %>
    <%# ── SEKIRITE / LAW ENFORCEMENT ── %>
    <%# ══════════════════════════════════════════════ %>
    <li class="nav-item mt-3">
      <small class="nav-section-label text-muted text-uppercase px-3" style="font-size: 10px; letter-spacing: 1px;">Sekirite</small>
    </li>
    <li class="nav-item">
      <%= link_to admin_identity_submissions_path(rejection_reason: "duplicate_identity"),
                  class: "nav-link #{'active' if params[:rejection_reason] == 'duplicate_identity'}" do %>
        <i class="ri-shield-cross-line"></i>
        <span>Fraud Alerts</span>
        <% if (@fraud_alerts_count || 0) > 0 %>
          <span class="badge bg-danger rounded-pill ms-auto"><%= @fraud_alerts_count %></span>
        <% end %>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to admin_incident_reports_path,
                  class: "nav-link #{'active' if current_page?(admin_incident_reports_path)}" do %>
        <i class="ri-alert-line"></i>
        <span>Incident Reports</span>
      <% end %>
    </li>

    <%# ══════════════════════════════════════════════ %>
    <%# ── ELEKSYON / CEP ── %>
    <%# ══════════════════════════════════════════════ %>
    <li class="nav-item mt-3">
      <small class="nav-section-label text-muted text-uppercase px-3" style="font-size: 10px; letter-spacing: 1px;">Eleksyon / CEP</small>
    </li>
    <% election = BonvoteElection.order(created_at: :desc).first %>
    <% election_id = election&.id || "1" %>
    <li class="nav-item">
      <%= link_to admin_election_election_path(election_id),
                  class: "nav-link #{'active' if request.path.start_with?('/admin/election') && !request.path.include?('multi_sig') && !request.path.include?('results')}" do %>
        <i class="ri-pie-chart-line"></i>
        <span>Tablo CEP</span>
        <% if election&.open? %>
          <span class="badge bg-success rounded-pill ms-auto" style="font-size: 9px;">LIVE</span>
        <% end %>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to admin_election_election_multi_sig_path(election_id),
                  class: "nav-link #{'active' if request.path.include?('multi_sig')}" do %>
        <i class="ri-key-2-line"></i>
        <span>Seremoni Siyati</span>
        <% sig_count = ElectionSignature.where(election_id: election_id).count rescue 0 %>
        <% if sig_count > 0 %>
          <span class="badge bg-warning text-dark rounded-pill ms-auto"><%= sig_count %>/<%= ElectionSignature::QUORUM %></span>
        <% end %>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to admin_election_election_results_path(election_id),
                  class: "nav-link #{'active' if request.path.include?('results') && request.path.include?('election')}" do %>
        <i class="ri-bar-chart-box-line"></i>
        <span>Rezilta</span>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to admin_electoral_offices_path,
                  class: "nav-link #{'active' if request.path.start_with?('/admin/electoral_offices')}" do %>
        <i class="ri-building-2-line"></i>
        <span>Biwo BED / BEK</span>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to admin_election_election_candidates_path(election_id),
                  class: "nav-link #{'active' if request.path.include?('/candidates')}" do %>
        <i class="ri-user-star-line"></i>
        <span>Kandida</span>
        <% pending_cands = ElectionCandidate.where(election_id: election_id).pending_review.count rescue 0 %>
        <% if pending_cands > 0 %>
          <span class="badge bg-warning text-dark rounded-pill ms-auto" style="font-size: 9px;"><%= pending_cands %></span>
        <% end %>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to admin_election_election_party_registrations_path(election_id),
                  class: "nav-link #{'active' if request.path.include?('/party_registrations')}" do %>
        <i class="ri-flag-2-line"></i>
        <span>Pati Politik</span>
        <% pending_parties = ElectionPartyRegistration.where(election_id: election_id).pending_review.count rescue 0 %>
        <% if pending_parties > 0 %>
          <span class="badge bg-warning text-dark rounded-pill ms-auto" style="font-size: 9px;"><%= pending_parties %></span>
        <% end %>
      <% end %>
    </li>

    <%# ══════════════════════════════════════════════ %>
    <%# ── API / TEKNIK ── %>
    <%# ══════════════════════════════════════════════ %>
    <li class="nav-item mt-3">
      <small class="nav-section-label text-muted text-uppercase px-3" style="font-size: 10px; letter-spacing: 1px;">API / Teknik</small>
    </li>
    <li class="nav-item">
      <%= link_to admin_oauth_events_path,
                  class: "nav-link #{'active' if current_page?(admin_oauth_events_path)}" do %>
        <i class="ri-key-2-line"></i>
        <span>OAuth Events</span>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to admin_partner_access_logs_path,
                  class: "nav-link #{'active' if current_page?(admin_partner_access_logs_path)}" do %>
        <i class="ri-file-list-3-line"></i>
        <span>Access Logs</span>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to admin_webhook_events_path,
                  class: "nav-link #{'active' if current_page?(admin_webhook_events_path)}" do %>
        <i class="ri-webhook-line"></i>
        <span>Webhooks</span>
      <% end %>
    </li>

    <%# ══════════════════════════════════════════════ %>
    <%# ── LIS DATANT / WAITLIST ── %>
    <%# ══════════════════════════════════════════════ %>
    <li class="nav-item mt-3">
      <small class="nav-section-label text-muted text-uppercase px-3" style="font-size: 10px; letter-spacing: 1px;">Lis Datant</small>
    </li>
    <li class="nav-item">
      <%= link_to admin_waitlist_signups_path,
                  class: "nav-link #{'active' if current_page?(admin_waitlist_signups_path)}" do %>
        <i class="ri-list-check-3"></i>
        <span>Signups</span>
        <% waiting = WaitlistSignup.waiting.count %>
        <% if waiting > 0 %>
          <span class="badge bg-primary rounded-pill ms-auto"><%= waiting %></span>
        <% end %>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to admin_invite_codes_path,
                  class: "nav-link #{'active' if current_page?(admin_invite_codes_path)}" do %>
        <i class="ri-key-2-line"></i>
        <span>Invite Codes</span>
      <% end %>
    </li>

  </ul>

  <%# Logout button %>
  <div class="sidebar-logout">
    <%= button_to destroy_admin_user_session_path,
                  method: :delete,
                  form: { data: { turbo: false } },
                  class: "logout-btn" do %>
      <i class="ri-logout-box-r-line"></i>
      <span>Log Out</span>
    <% end %>
  </div>
</nav>

<script>
document.addEventListener("turbo:load", () => {
  const sidebar = document.getElementById("adminSidebar");
  const backdrop = document.getElementById("sidebarBackdrop");
  const mobileToggle = document.getElementById("sidebarToggle");
  const closeBtn = document.getElementById("sidebarCloseBtn");

  function openSidebar() {
    sidebar?.classList.add("show");
    backdrop?.classList.add("show");
  }

  function closeSidebar() {
    sidebar?.classList.remove("show");
    backdrop?.classList.remove("show");
  }

  mobileToggle?.addEventListener("click", openSidebar);
  closeBtn?.addEventListener("click", closeSidebar);
  backdrop?.addEventListener("click", closeSidebar);
});
</script>
