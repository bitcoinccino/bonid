<div data-controller="cookie-consent"
     data-cookie-consent-target="banner"
     class="cookie-banner shadow-lg">

  <div class="cookie-content">

    <div class="cookie-left">
      <h5 class="fw-semibold mb-2 text-white">
        <i class="ri-shield-check-line me-1"></i> We Value Your Privacy
      </h5>

      <p class="small mb-2 text-white-85">
        BonID uses cookies to keep the platform secure, remember your preferences, and improve your experience.
        We never sell your data. You can customize your choices below.
      </p>

      <!-- Preferences -->
      <div class="cookie-options mb-3">
        <div class="form-check text-white-85">
          <input class="form-check-input" type="checkbox" checked disabled id="cookie-essential">
          <label class="form-check-label small" for="cookie-essential">
            <strong>Essential Cookies</strong> (required)
            <span class="d-block" style="font-size: 11px; opacity: 0.7;">
              Authentication, security, session management. BonID cannot function without these.
            </span>
          </label>
        </div>

        <div class="form-check text-white-85 mt-2">
          <input data-cookie-consent-target="analytics"
                class="form-check-input"
                type="checkbox"
                id="cookie-analytics">
          <label class="form-check-label small" for="cookie-analytics">
            <strong>Analytics Cookies</strong>
            <span class="d-block" style="font-size: 11px; opacity: 0.7;">
              Help us understand how users interact with BonID so we can improve the platform. No personal data is shared.
            </span>
          </label>
        </div>

        <div class="form-check text-white-85 mt-2">
          <input data-cookie-consent-target="marketing"
                class="form-check-input"
                type="checkbox"
                id="cookie-marketing">
          <label class="form-check-label small" for="cookie-marketing">
            <strong>Marketing Cookies</strong>
            <span class="d-block" style="font-size: 11px; opacity: 0.7;">
              Used to deliver relevant updates about BonID launches and features. You can opt out at any time.
            </span>
          </label>
        </div>
      </div>
    </div>

    <!-- Buttons -->
    <div class="cookie-right d-flex gap-2 align-items-start">
      <button class="btn btn-accept fw-semibold px-4 py-2"
              data-action="cookie-consent#acceptAll">
        Accept All
      </button>

      <button class="btn btn-preferences fw-semibold px-4 py-2"
              data-action="cookie-consent#savePreferences">
        Save Preferences
      </button>
    </div>

  </div>
</div>
