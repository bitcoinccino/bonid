<%# Cookie banner. Lists only what BonID actually uses (see main/cookie_policy):
    - No analytics configured → essential-only notice with a single "Got it".
    - GA_MEASUREMENT_ID set → adds the analytics choice (off by default)
      and Accept all / Save / Reject. Analytics loads only after consent. %>
<% analytics = ENV["GA_MEASUREMENT_ID"].present? %>
<div data-controller="cookie-consent"
     data-cookie-consent-target="banner"
     class="cookie-banner shadow-lg"
     role="dialog"
     aria-live="polite"
     aria-label="<%= t('main.cookie_banner.aria_label', default: 'Cookie preferences') %>">

  <div class="cookie-content">

    <div class="cookie-left">
      <h5 class="cookie-title mb-2">
        <i class="ri-shield-check-line me-1"></i>
        <%= t("main.cookie_banner.title", default: "We value your privacy") %>
      </h5>

      <p class="cookie-body mb-3">
        <% if analytics %>
          <%= t("main.cookie_banner.body") %>
        <% else %>
          <%= t("main.cookie_banner.body_essential_only") %>
        <% end %>
        <%= link_to t("main.cookie_banner.learn_more"), cookie_policy_path, class: "fw-semibold" %>
      </p>

      <% if analytics %>
        <div class="cookie-options mb-3">
          <div class="form-check cookie-option">
            <input class="form-check-input" type="checkbox" checked disabled id="cookie-essential">
            <label class="form-check-label" for="cookie-essential">
              <strong><%= t("main.cookie_banner.essential.label") %></strong>
              <span class="cookie-option-tag"><%= t("main.cookie_banner.required") %></span>
              <span class="cookie-option-desc"><%= t("main.cookie_banner.essential.desc") %></span>
            </label>
          </div>

          <div class="form-check cookie-option">
            <input data-cookie-consent-target="analytics" class="form-check-input" type="checkbox" id="cookie-analytics">
            <label class="form-check-label" for="cookie-analytics">
              <strong><%= t("main.cookie_banner.analytics.label") %></strong>
              <span class="cookie-option-desc"><%= t("main.cookie_banner.analytics.desc") %></span>
            </label>
          </div>
        </div>
      <% end %>
    </div>

    <div class="cookie-actions">
      <% if analytics %>
        <button class="cookie-btn cookie-btn-accept" type="button" data-action="cookie-consent#acceptAll">
          <i class="ri-check-line"></i>
          <%= t("main.cookie_banner.accept_all") %>
        </button>
        <button class="cookie-btn cookie-btn-save" type="button" data-action="cookie-consent#savePreferences">
          <%= t("main.cookie_banner.save_preferences") %>
        </button>
        <button class="cookie-btn cookie-btn-reject" type="button" data-action="cookie-consent#rejectNonEssential">
          <%= t("main.cookie_banner.reject_non_essential") %>
        </button>
      <% else %>
        <button class="cookie-btn cookie-btn-accept" type="button" data-action="cookie-consent#rejectNonEssential">
          <i class="ri-check-line"></i>
          <%= t("main.cookie_banner.ok") %>
        </button>
      <% end %>
    </div>

  </div>
</div>
