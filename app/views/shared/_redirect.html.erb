<turbo-stream action="replace" target="turbo-redirect">
  <template>
    <%# flash notice/alert injection if provided %>
    <% if local_assigns[:notice] %>
      <div class="alert alert-dismissible fade show alert-success"><%= notice %></div>
    <% elsif local_assigns[:alert] %>
      <div class="alert alert-dismissible fade show alert-danger"><%= alert %></div>
    <% end %>

    <script>
      window.location.href = "<%= path %>";
    </script>
  </template>
</turbo-stream>
