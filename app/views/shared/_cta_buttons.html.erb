<!-- app/views/shared/_cta_buttons.html.erb -->
<div class="mt-4 d-flex justify-content-center gap-3 flex-wrap">
  <% case current_role %>
  <% when :citizen %>
    <%= link_to "Go to Dashboard",
                citizens_identity_submissions_path,
                class: "btn btn-lg btn-primary rounded-pill px-4" %>
  <% when :officer %>
    <%= link_to "Go to Dashboard",
                officers_dashboard_path,
                class: "btn btn-lg btn-primary rounded-pill px-4",
                style: "background-color: var(--haitian-blue); border-color: var(--haitian-blue);",
                aria: { label: "Go to officer dashboard" } %>
  <% when :partner_admin %>
    <%= link_to "Go to Dashboard",
                partner_portal_root_path,
                class: "btn btn-lg btn-primary rounded-pill px-4",
                style: "background-color: var(--haitian-blue); border-color: var(--haitian-blue);",
                aria: { label: "Go to partner dashboard" } %>
  <% when :admin %>
    <%= link_to "Go to Dashboard",
                admin_root_path,
                class: "btn btn-lg btn-primary rounded-pill px-4",
                style: "background-color: var(--haitian-blue); border-color: var(--haitian-blue);",
                aria: { label: "Go to admin dashboard" } %>
  <% else %>
    <%= link_to "Sign Up as Citizen",
                signup_path(partner: local_assigns[:partner]&.slug),
                class: "btn btn-lg btn-primary rounded-pill px-4",
                style: "background-color: var(--haitian-blue); border-color: var(--haitian-blue);",
                aria: { label: "Sign up as citizen" } %>

    <%= link_to "Already have an account? Sign In",
                login_path(from_partner: local_assigns[:partner]&.slug),
                class: "btn btn-lg btn-outline-primary rounded-pill px-4",
                aria: { label: "Sign in as citizen" } %>
  <% end %>
</div>
