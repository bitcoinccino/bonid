<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400..900&family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">

<nav class="navbar navbar-expand-lg fixed-top bonid-navbar navbar-dark">
  <div class="container-fluid">

    <%= render "shared/navbar/brand" %>

    <!-- Phone-only hamburger -->
    <%= render "shared/navbar/mobile_toggle" %>

    <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
      <ul class="navbar-nav align-items-center gap-3">

        <%= render "shared/navbar/products_dropdown" %>
        <%= render "shared/navbar/main_links" %>

        <!-- LANGUAGE -->
        <li class="nav-item dropdown language-switcher">
          <a class="nav-link dropdown-toggle nav-link-polished fw-semibold d-flex align-items-center gap-2"
             href="#"
             role="button"
             data-bs-toggle="dropdown"
             aria-expanded="false"
             aria-label="Change language">

            <span class="lang-pill text-uppercase"><%= I18n.locale.to_s %></span>
          </a>

          <ul class="dropdown-menu dropdown-menu-end bonid-dropdown bonid-dropdown-sm shadow-sm">
            <% [["Kreyòl", "ht"], ["Français", "fr"], ["English", "en"]].each do |label, locale| %>
              <% query = request.query_parameters.to_h.merge("lang" => locale) %>
              <% href  = query.present? ? "#{request.path}?#{query.to_query}" : request.path %>

              <li>
                <%= link_to href,
                  class: "dropdown-item d-flex align-items-center justify-content-between #{'active' if I18n.locale.to_s == locale}" do %>
                  <span><%= label %></span>
                  <span class="badge bg-light text-dark text-uppercase"><%= locale %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </li>

      </ul>
    </div>
  </div>
</nav>
