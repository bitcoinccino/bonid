<% if @user.errors.any? %>
  <div class="bonid-error-card rounded-3 shadow-sm fade-in mt-3 p-3">
    <div class="d-flex align-items-start gap-2">
      <i class="ri-error-warning-line text-danger fs-5"></i>

      <div>
        <h6 class="fw-bold text-danger small mb-1">Form Errors</h6>
        <ul class="small text-muted ps-3 mb-0">
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>

      <button type="button"
              class="btn-close ms-auto"
              data-action="click->flash#close"
              aria-label="Close"></button>
    </div>
  </div>
<% end %>
