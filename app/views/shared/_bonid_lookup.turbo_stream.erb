<turbo-stream target="bonidScanResult" action="replace">
  <template>
    <% if @status == :success && @submission && @user %>
      <%= render partial: "officers/incident_reports/scan_result_valid", locals: { submission: @submission, user: @user } %>
    <% else %>
      <%= render partial: "officers/incident_reports/scan_result_invalid", locals: { bonid: @bonid, status: @status, error: @error } %>
    <% end %>
  </template>
</turbo-stream>


