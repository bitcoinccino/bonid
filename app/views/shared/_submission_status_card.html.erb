
<% submission = local_assigns[:submission] %>
<% current = local_assigns[:user] || current_citizen %>
<% profile_ok = current && (profile_complete?(current) || current.identity_submissions.approved.exists?) %>

<% has_any_submission = current.identity_submissions.exists? %>
<% has_pending = current.identity_submissions.pending.exists? %>
<% rejected_submission = current.identity_submissions.rejected.first %>

<%# 🚫 EXIT EARLY if there's truly nothing to show %>
<% unless submission.present? || !profile_ok || has_any_submission %>
  <%# Do not render anything at all %>
  <% return %>
<% end %>

<%# =====================================================
  🟢 CASE 1 — No Submissions Yet
===================================================== %>
<% if submission.nil? && !has_any_submission %>
  <div class="card submission-status-card rounded-3 mt-2 shadow-sm animate__animated animate__fadeIn" role="region" aria-live="polite">
    <div class="card-body p-3">
      <h5 class="card-title fw-bold text-haitian-blue d-flex align-items-center gap-2 mb-2">
        <i class="ri-fingerprint-line fs-5 text-warning"></i>
        <span class="badge bg-warning text-dark rounded-pill pulse-glow small">
          Get Started
        </span>
      </h5>
      <p class="card-text small mb-2">
        You haven’t started your BonID verification yet. Begin the process to unlock verified services.
      </p>

      <div class="d-flex gap-2 flex-wrap">
        <% if profile_ok %>
          <%= link_to "Start Verification",
                      new_citizens_identity_submission_path,
                      class: "btn btn-sm btn-haitian-blue fw-semibold",
                      role: "button" %>
        <% else %>
          <%= link_to "Complete Profile First",
                      edit_citizens_profile_path,
                      class: "btn btn-sm btn-outline-secondary fw-semibold",
                      role: "button" %>
        <% end %>
      </div>
    </div>
  </div>

<%# =====================================================
  🟡 CASE 2 — Has Previous Submissions but None Pending
===================================================== %>
<% elsif submission.nil? && has_any_submission && !has_pending %>
  <div class="card submission-status-card rounded-3 mt-2 shadow-sm animate__animated animate__fadeIn" role="region" aria-live="polite">
    <div class="card-body p-3">
      <h5 class="card-title fw-bold text-haitian-blue d-flex align-items-center gap-2 mb-2">
        <i class="ri-time-line fs-5 text-info"></i>
        <span class="badge bg-info text-white rounded-pill pulse-glow small">
          No Active Submission
        </span>
      </h5>
      <p class="card-text small mb-2">
        Your previous submission is complete or rejected. Start a new one if needed.
      </p>

      <div class="d-flex gap-2 flex-wrap">
        <% if rejected_submission %>
          <%= link_to "Resubmit Rejected",
                      new_citizens_identity_submission_path(resubmission_from: rejected_submission.public_token),
                      class: "btn btn-sm btn-warning fw-semibold",
                      role: "button" %>
        <% end %>

        <% if eligible_for_new_bonid_request?(current, current.identity_submissions) %>
          <%= button_tag "Request Reissue",
                         type: "button",
                         class: "btn btn-sm btn-outline-gold fw-semibold pulse-glow",
                         data: {
                           bs_toggle: "modal",
                           bs_target: "#requestNewBonIDModal"
                         },
                         aria_label: "Request a new BonID reissue",
                         id: "requestNewBonIDButton_global" %>
        <% end %>
      </div>
    </div>
  </div>

<%# =====================================================
  🔵 CASE 3 — Specific Submission Provided
===================================================== %>
<% elsif submission.present? %>
  <% status_info = submission_status_info(submission) %>

  <div class="card submission-status-card rounded-3 mt-2 shadow-sm animate__animated animate__fadeIn" role="region" aria-live="polite">
    <div class="card-body p-3">
      <h5 class="card-title fw-bold text-haitian-blue d-flex align-items-center gap-2 mb-2">
        <i class="<%= status_icon(submission) %> fs-5"></i>
        <span class="badge <%= status_info[:badge_class] %> rounded-pill pulse-glow small">
          <%= status_info[:text] %>
        </span>
      </h5>

      <p class="card-text small mb-2"><%= status_message(submission) %></p>
      <p class="card-text small text-muted mb-2"><%= submission_type_description(submission) %></p>

      <% if submission.rejection_reason.present? && (submission.status == "rejected" || submission.reset_request_status == "rejected") %>
        <p class="card-text small text-muted mb-2">
          <span class="fw-semibold">Reason:</span>
          <%= user_friendly_rejection_reason(submission.rejection_reason) %>.
        </p>
      <% end %>

      <div class="d-flex gap-2 flex-wrap">
        <% if submission.reset_request_status == "rejected" %>
          <%= link_to "Resubmit",
                      edit_identity_submission_path(submission),
                      class: "btn btn-sm btn-haitian-blue fw-semibold",
                      role: "button" %>
        <% end %>

        <% if profile_ok && eligible_for_new_bonid_request?(current, [submission]) %>
          <%= button_tag "Request New BonID",
                         type: "button",
                         class: "btn btn-sm btn-outline-gold fw-semibold pulse-glow",
                         data: {
                           bs_toggle: "modal",
                           bs_target: "#requestNewBonIDModal",
                           submission_status: submission.status,
                           submission_type: submission.submission_type
                         },
                         aria_label: "Request a new BonID reissue",
                         id: "requestNewBonIDButton_#{submission.id}" %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>


