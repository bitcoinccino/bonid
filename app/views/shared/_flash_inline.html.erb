app/views/shared/_flash_inline.html.erb
<% if alert.present? %>
  <div class="bonid-flash bonid-flash-danger small py-2 px-3 mb-3 rounded-2 fade-in">
    <i class="ri-close-circle-line me-1"></i>
    <%= alert %>
  </div>
<% elsif notice.present? %>
  <div class="bonid-flash bonid-flash-success small py-2 px-3 mb-3 rounded-2 fade-in">
    <i class="ri-checkbox-circle-line me-1"></i>
    <%= notice %>
  </div>
<% end %>
