<!-- ================================
     GLOBAL CONFIRMATION MODAL
     Intercepts all data-turbo-confirm dialogs app-wide.
     Redesigned: clean, centered, Haitian Creole.
================================ -->
<div class="modal fade bonid-confirmation-modal"
     id="confirmationModal"
     tabindex="-1"
     aria-labelledby="confirmationModalTitle"
     aria-hidden="true">

  <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
    <div class="modal-content border-0 overflow-hidden bonid-confirm-content">

      <!-- ICON + TITLE -->
      <div class="bonid-confirm-top">
        <div class="bonid-confirm-icon-circle">
          <i class="ri-error-warning-line"></i>
        </div>
        <h6 class="bonid-confirm-title" id="confirmationModalTitle">
          Èske ou sèten?
        </h6>
      </div>

      <!-- BODY — populated dynamically by Turbo.config.forms.confirm -->
      <div class="modal-body bonid-confirm-body" id="confirmationModalBody">
        Èske ou vle kontinye ak aksyon sa a?
      </div>

      <!-- FOOTER -->
      <div class="bonid-confirm-footer">
        <button type="button"
                class="bonid-confirm-cancel-btn"
                data-bs-dismiss="modal">
          Non, Anile
        </button>
        <button type="button"
                id="confirmationModalConfirmBtn"
                class="bonid-confirm-btn">
          Wi, Kontinye
        </button>
      </div>

    </div>
  </div>
</div>
