<footer class="footer pt-5">
  <div class="container pb-4">
    <div class="row g-4 align-items-start">

      <!-- Brand -->
      <div class="col-lg-4 col-md-6 mb-4">
        <%= link_to root_path, class: "navbar-brand font-orbitron fs-brand d-inline-block mb-3", style: "text-decoration:none;color:#fff;" do %>
          Verifyem
        <% end %>
        <p class="text-white-75 small">
          <%= t("main.footer.description") %>
        </p>
      </div>

      <!-- Quick Links -->
      <div class="col-lg-2 col-md-6 mb-4">
        <h6 class="fw-semibold text-uppercase small mb-3"><%= t("main.footer.quick_links") %></h6>
        <ul class="list-unstyled">
          <li class="mb-2"><%= link_to t("main.footer.terms"), terms_path, class:"footer-link" %></li>
          <li class="mb-2"><%= link_to t("main.footer.privacy"), privacy_path, class:"footer-link" %></li>
          <li class="mb-2"><%= link_to t("main.footer.faq"), "/faq", class:"footer-link" %></li>
        </ul>
      </div>

      <!-- Contact -->
      <div class="col-lg-3 col-md-6 mb-4">
        <h6 class="fw-semibold text-uppercase small mb-3"><%= t("main.footer.contact") %></h6>
        <ul class="list-unstyled small text-white-75">
          <li class="mb-2">
            <i class="ri-mail-line me-2"></i>
            <a href="mailto:support@verifyem.ht" class="footer-link">support@verifyem.ht</a>
          </li>
        </ul>
      </div>

      <!-- Social -->
      <div class="col-lg-3 col-md-6 mb-4">
        <h6 class="fw-semibold text-uppercase small mb-3"><%= t("main.footer.follow") %></h6>
        <div class="d-flex gap-3 mt-2">
          <a href="https://x.com/bonidht" target="_blank" rel="noopener" class="footer-social"><i class="ri-twitter-x-line"></i></a>
        </div>
      </div>

    </div>
  </div>

  <div class="footer-bottom text-center py-3 mt-3">
    <small class="text-white-75">
      v1.0.0 © <%= Time.current.year %> <%= t("main.footer.copyright") %>
    </small>
  </div>
</footer>


  <style>
.footer {
  background: var(--haiti-space, #00209f);
  color: #ffffff;
}

/* 🔥 Brand logo FIX */
.footer .footer-brand,
.footer .footer-brand.font-orbitron {
  font-family: "Glock Grotesque", "Inter", sans-serif;
  font-size: 2.1rem;
  line-height: 1.15;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #ffffff !important;
}

.text-white-75 {
  color: rgba(255,255,255,0.75);
}

.footer-link {
  color: rgba(255,255,255,0.85);
  text-decoration: none;
}

.footer-link:hover {
  color: #ffffff;
  text-decoration: underline;
}

.footer-social {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: rgba(255,255,255,0.12);
  color: #ffffff;
}

.footer-social:hover {
  background: rgba(0,255,255,0.35);
}

.footer-bottom {
  border-top: 1px solid rgba(255,255,255,0.2);
  background: rgba(0,0,0,0.15);
}

</style>

