<%# Flash Messages — Fixed top-center floating toasts %>
<%# `enskri_error` is shown inline in the signup wizard's own banner — skip it here. %>
<% messages = flash.select { |k, v| v.is_a?(String) && v.present? && k.to_s != "enskri_error" } %>
<% if messages.any? %>
  <div class="bonid-toast-stack">
    <% messages.each do |type, message| %>
      <% css_class = {
           notice: "success",
           alert:  "danger",
           error:  "danger"
         }[type.to_sym] || "info" %>

      <% icon = case type.to_sym
        when :notice then "ri-checkbox-circle-fill"
        when :alert  then "ri-error-warning-fill"
        when :error  then "ri-close-circle-fill"
        else "ri-information-fill"
      end %>

      <div class="bonid-toast bonid-toast-<%= css_class %>" role="alert" data-controller="flash">
        <div class="bonid-toast-icon">
          <i class="<%= icon %>"></i>
        </div>
        <div class="bonid-toast-content">
          <%= message %>
        </div>
        <button type="button" class="bonid-toast-close" aria-label="Close"
                data-action="click->flash#dismiss">
          <i class="ri-close-line"></i>
        </button>
      </div>
    <% end %>
  </div>
<% end %>
