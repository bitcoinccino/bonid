<%# Global Loading Overlay — Starts HIDDEN, JS shows during navigation %>
<div class="bonid-loading-overlay d-none"
     data-global-loading-target="overlay"
     aria-hidden="true"
     aria-label="Loading"
     role="status">
  <div class="bonid-loading-spinner" data-global-loading-target="spinner">
    <div class="bonid-loading-ring" data-global-loading-target="ring"></div>
    <span class="bonid-loading-text" data-global-loading-target="text">Loading...</span>
  </div>
</div>
