<%# app/views/landing/index.html.erb %>
<%# Same as homepage + signup modal %>

<%= render "main/hero" %>
<%= render "main/matrix" %>
<%= render "main/constellation" %>
<%= render "main/developers" %>
<%= render "main/faq" %>

<%# ═══════════ SIGNUP MODAL (single step) ═══════════ %>
<div class="modal fade" id="enskriModal" data-modal-portal tabindex="-1" aria-labelledby="enskriModalLabel" aria-hidden="true"
     data-total-signups="<%= @total_signups || 0 %>"
     data-social-proof="<%= t('main.signup_form.social_proof') %>"
     data-social-proof-first="<%= t('main.signup_form.social_proof_first') %>"
     data-social-proof-total="<%= t('main.signup_form.social_proof_total') %>"
     data-social-proof-threshold="<%= Commune::SOCIAL_PROOF_THRESHOLD %>"
     data-error-email="<%= t('main.signup_form.error_email') %>"
     data-error-org="<%= t('main.signup_form.error_org') %>"
     data-error-sector="<%= t('main.signup_form.error_sector') %>"
     data-error-state="<%= t('main.signup_form.error_state') %>"
     data-error-city="<%= t('main.signup_form.error_city') %>"
     data-error-commune="<%= t('main.signup_form.error_commune') %>"
     data-error-country="<%= t('main.signup_form.error_country') %>"
     data-error-unit="<%= t('main.signup_form.error_unit') %>"
     data-bonid-available="<%= t('main.signup_form.bonid_available') %>"
     data-coming-soon="<%= t('main.signup_form.coming_soon') %>"
     data-active-label="<%= t('main.signup_form.active') %>"
     data-choose="<%= t('main.signup_form.choose') %>"
     data-auto-open="<%= @referrer ? "1" : "0" %>">
  <div class="modal-dialog modal-dialog-centered" style="max-width: 640px;">
    <div class="modal-content" style="border: none; border-radius: 16px; overflow: hidden;">

      <%# Modal Header — Haitian Blue %>
      <div style="background: #00209F; padding: 20px 28px; color: #fff;">
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <div style="flex: 1; text-align: center;">
            <div id="enskriModalLabel" style="font-family: 'Montserrat', sans-serif; font-size: 20px; font-weight: 800;"><%= t("main.signup_form.modal_title") %></div>
          </div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" style="position: absolute; right: 20px; top: 20px;"></button>
        </div>
      </div>

      <%# Modal Body %>
      <div class="modal-body" style="padding: 24px; background: #F3F4F6; overflow-y: auto;">

        <% if flash[:success] %>
          <div class="alert alert-success"><i class="ri-check-line me-1"></i><%= flash[:success] %></div>
        <% end %>
        <%= render "landing/enskri_error", message: flash[:enskri_error] %>

        <%# Arrived through someone's share link %>
        <% if @referrer %>
          <div style="display: flex; align-items: center; gap: 8px; background: #ECFDF5; border: 1px solid #A7F3D0; color: #065F46; border-radius: 10px; padding: 10px 14px; margin-bottom: 18px; font-size: 14px; font-weight: 600;">
            <i class="ri-user-heart-line" style="font-size: 18px;" aria-hidden="true"></i>
            <span><%= @referrer.first_name.present? ? t("main.signup_form.invited_by", name: @referrer.first_name) : t("main.signup_form.invited_by_friend") %></span>
          </div>
        <% end %>

        <%= form_with model: @waitlist_signup, url: enskri_signup_path(lang: params[:lang]), id: "enskri-form", data: { turbo: false } do |f| %>
          <%= f.hidden_field :signup_type, id: "modal_signup_type", value: "citizen" %>
          <%= f.hidden_field :referred_by_code %>

          <%# Honeypot: hidden from humans, bots fill it %>
          <div style="position: absolute; left: -9999px;" aria-hidden="true">
            <label for="website_url">Leave this empty</label>
            <input type="text" name="website_url" id="website_url" tabindex="-1" autocomplete="off">
          </div>
          <input type="hidden" name="signup_ts" value="<%= Time.current.to_i %>">

          <%# ── Account type ── %>
          <%# Toggle: Citizen / Business %>
          <div style="display: flex; background: #E5E7EB; border-radius: 50px; padding: 4px; margin-bottom: 24px;">
            <button type="button" id="modal-btn-citizen" onclick="modalSetType('citizen')"
                    class="enskri-toggle-btn enskri-toggle-active">
              <i class="ri-user-line me-1"></i> <%= t("main.signup_form.citizen") %>
            </button>
            <button type="button" id="modal-btn-business" onclick="modalSetType('business')"
                    class="enskri-toggle-btn">
              <i class="ri-building-2-line me-1"></i> <%= t("main.signup_form.business") %>
            </button>
          </div>

          <%# Business fields (hidden by default) %>
          <div id="modal-business-fields" style="display: none;">
            <div class="mb-3">
              <label class="form-label fw-semibold enskri-label"><%= t("main.signup_form.org_name") %></label>
              <%= f.text_field :organization_name, class: "form-control enskri-input", placeholder: t("main.signup_form.org_placeholder"), id: "modal_org_name" %>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold enskri-label"><%= t("main.signup_form.sector") %></label>
              <%= f.select :sector,
                  grouped_options_for_select(Partner.department_sectors.map { |g, items| [g, items] }),
                  { prompt: t("main.signup_form.choose") },
                  { class: "form-select enskri-input", id: "modal_sector", onchange: "modalSectorChange(this.value)" } %>
            </div>
            <div class="mb-3" id="modal-sector-country" style="display: none;">
              <label class="form-label fw-semibold enskri-label"><%= t("main.signup_form.country") %></label>
              <%
                priority_countries = HaitianDiplomaticMissions::PRIORITY_COUNTRY_CODES.filter_map { |code| c = ISO3166::Country[code]; [c&.common_name || c&.name, code] if c }
                other_countries = ISO3166::Country.all.map { |c| [c.common_name || c.name, c.alpha2] }.sort_by(&:first) - priority_countries
              %>
              <%= f.select :country_of_residence,
                  grouped_options_for_select({ t("main.signup_form.country_group_priority") => priority_countries,
                                               t("main.signup_form.country_group_other") => other_countries }),
                  { prompt: t("main.signup_form.choose") },
                  { class: "form-select enskri-input", id: "modal_sector_country", disabled: true } %>
            </div>

            <%# PNH fields (shown only when sector = pnh) %>
            <div id="modal-pnh-fields" style="display: none;">
              <div class="mb-3">
                <label class="form-label fw-semibold enskri-label">Inite / Unit Type</label>
                <%= f.select :unit_type,
                    OfficerConstants::UNIT_OPTIONS.keys.map { |k| [k, k] },
                    { prompt: t("main.signup_form.choose") },
                    { class: "form-select enskri-input", id: "modal_unit_type", onchange: "modalLoadUnitNames(this.value)" } %>
              </div>
              <div class="mb-3">
                <label class="form-label fw-semibold enskri-label">Non Inite / Unit Name</label>
                <select name="waitlist_signup[unit_name]" class="form-select enskri-input" id="modal_unit_name" disabled>
                  <option value=""><%= t("main.signup_form.choose") %></option>
                </select>
              </div>
            </div>
          </div>

          <%# Email %>
          <div class="mb-3">
            <label class="form-label fw-semibold enskri-label"><%= t("main.signup_form.email") %></label>
            <%= f.email_field :email, class: "form-control enskri-input", placeholder: t("main.signup_form.email_placeholder"), id: "modal_email", autocomplete: "email" %>
          </div>

        <%# ── Location ── %>
          <%# Residence toggle: "I currently live in" Haiti / Abroad (sets diaspora) %>
          <div class="mb-3">
            <label class="form-label fw-semibold enskri-label"><%= t("main.signup_form.country_label") %></label>
            <div style="display: flex; background: #E5E7EB; border-radius: 50px; padding: 4px;">
              <button type="button" id="loc-btn-haiti" onclick="modalSetLocation('haiti')"
                      class="enskri-toggle-btn enskri-toggle-active">
                <i class="ri-map-pin-line me-1"></i> <%= t("main.signup_form.live_haiti") %>
              </button>
              <button type="button" id="loc-btn-abroad" onclick="modalSetLocation('abroad')"
                      class="enskri-toggle-btn">
                <i class="ri-global-line me-1"></i> <%= t("main.signup_form.other_country") %>
              </button>
            </div>
            <%= f.hidden_field :diaspora, id: "modal_diaspora", value: "0" %>
          </div>

          <%# Haiti fields: Department, then Commune once a department is picked %>
          <div id="modal-haiti-fields">
            <div class="row g-3 mb-3">
              <div class="col-12">
                <label class="form-label fw-semibold enskri-label"><%= t("main.signup_form.department") %></label>
                <select class="form-select enskri-input" id="modal_dept" onchange="modalLoadCommunes(this.value)">
                  <option value=""><%= t("main.signup_form.choose") %></option>
                  <% @departments.each do |d| %>
                    <option value="<%= d.id %>"><%= d.name %></option>
                  <% end %>
                </select>
              </div>
              <div class="col-12" id="modal-commune-wrap" style="display: none;">
                <label class="form-label fw-semibold enskri-label"><%= t("main.signup_form.commune") %></label>
                <select name="waitlist_signup[commune_id]" class="form-select enskri-input" id="modal_commune" disabled>
                  <option value=""><%= t("main.signup_form.choose") %></option>
                </select>
                <div id="modal-commune-status" style="font-size: 12px; margin-top: 4px;"></div>
              </div>
            </div>
          </div>

          <%# Abroad fields: the United States is the only country open for
              now (DiasporaLocations::SIGNUP_COUNTRIES), so it is shown as a
              pill and posted from a hidden field (enabled only for Abroad). %>
          <div id="modal-abroad-fields" style="display: none;">
            <div class="mb-3">
              <span class="form-label fw-semibold enskri-label d-block"><%= t("main.signup_form.country") %></span>
              <% us_name = DiasporaLocations.country_options.to_h.invert["US"] %>
              <span style="display: inline-flex; align-items: center; gap: 8px; background: #EEF2FF; border: 1px solid #C7D2FE; color: #00209F; border-radius: 999px; padding: 6px 14px; font-weight: 600; font-size: 14px;">
                <span aria-hidden="true">🇺🇸</span> <%= us_name %>
              </span>
              <%= f.hidden_field :country_of_residence, value: "US", id: "modal_diaspora_country", disabled: true %>
              <p style="color: #6B7280; font-size: 12px; margin: 8px 0 0;"><%= t("main.signup_form.abroad_note") %></p>
            </div>

            <%# United States: State → City (curated cities for the largest
                Haitian communities, free text everywhere else) %>
            <div id="modal-us-fields" style="display: none;">
              <div class="mb-3">
                <label class="form-label fw-semibold enskri-label" for="modal_us_state"><%= t("main.signup_form.state") %></label>
                <% state_groups = DiasporaLocations.state_groups %>
                <%= f.select :residence_state,
                    grouped_options_for_select({ t("main.signup_form.state_group_priority") => state_groups[:priority],
                                                 t("main.signup_form.state_group_other") => state_groups[:other] }),
                    { prompt: t("main.signup_form.choose_state") },
                    { class: "form-select enskri-input", id: "modal_us_state", disabled: true,
                      onchange: "modalStateChange(this.value)" } %>
              </div>
              <div class="mb-3" id="modal-us-city-wrap" style="display: none;">
                <label class="form-label fw-semibold enskri-label" for="modal_us_city"><%= t("main.signup_form.city") %></label>
                <%# Type-to-search over the state's cities (own white list, not the
                    browser's datalist); any typed city is accepted %>
                <div style="position: relative;">
                  <input type="text" name="waitlist_signup[residence_city]" id="modal_us_city"
                         class="form-control enskri-input" maxlength="80" autocomplete="off"
                         role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="modal-us-city-suggest"
                         placeholder="<%= t("main.signup_form.city_placeholder") %>" disabled>
                  <ul id="modal-us-city-suggest" role="listbox" class="enskri-suggest" hidden></ul>
                </div>
              </div>
            </div>
          </div>

          <%# Social proof (updates when a commune is picked) %>
          <div class="enskri-social-proof">
            <i class="ri-group-line" style="font-size: 20px; color: #166534;"></i>
            <span id="enskri-social-text"></span>
          </div>

          <%# Client-side validation error %>
          <div id="enskri-form-error" class="enskri-error" role="alert" style="display: none;">
            <i class="ri-error-warning-line me-1"></i> <span></span>
          </div>

          <button type="submit" class="btn w-100 fw-bold rounded-3 enskri-btn-submit">
            <%= t("main.signup_form.submit") %> <i class="ri-arrow-right-line ms-1"></i>
          </button>

        <% end %>
      </div>

    </div>
  </div>
</div>

<%# ═══════════ MODAL STYLES ═══════════ %>
<style>
  /* City suggestions under the City field (white, like the form) */
  .enskri-suggest {
    position: absolute; top: calc(100% + 4px); left: 0; right: 0; z-index: 20;
    margin: 0; padding: 4px; list-style: none;
    background: #fff; border: 1px solid #E2E8F0; border-radius: 10px;
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.12);
    max-height: 240px; overflow-y: auto;
  }
  .enskri-suggest li {
    padding: 9px 12px; border-radius: 8px; cursor: pointer;
    color: #111827; font-size: 14px;
  }
  .enskri-suggest li[aria-selected="true"], .enskri-suggest li:hover { background: #EEF2FF; color: #00209F; }

  /* No background on the card itself: its white showed as a thin halo
     around the blue header's rounded corners. Header and body each carry
     their own background and corner radius instead. */
  #enskriModal .modal-content {
    overflow: hidden;
    background: transparent;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.45);
  }
  #enskriModal .modal-content > :first-child { border-radius: 16px 16px 0 0; }
  #enskriModal .modal-content > :last-child  { border-radius: 0 0 16px 16px; }
  /* The hero behind is already dark, so plain dimming barely shows and the
     modal looked like a layer on the page. Blur + tint make it read as a
     modal. (Backdrop is appended to <body>, hence :has.) */
  body:has(#enskriModal.show) > .modal-backdrop.show {
    opacity: 1 !important;
    background: rgba(8, 15, 40, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  #enskriModal .modal-body {
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    max-height: calc(100vh - 180px);
    padding: 28px 36px !important;
  }
  .enskri-input { min-height: 44px; font-size: 16px !important; border-radius: 8px !important; }
  .enskri-label { font-size: 13px; color: #374151; }
  .enskri-toggle-btn {
    flex: 1; padding: 12px; border: 2px solid transparent; border-radius: 50px;
    font-weight: 600; font-size: 14px; cursor: pointer;
    font-family: 'Inter', sans-serif;
    background: none; color: #6C757D;
    min-height: 48px; transition: all 0.2s;
  }
  .enskri-toggle-active {
    background: #00209F !important; color: #fff !important;
    border-color: #00209F !important;
    border-radius: 50px;
    box-shadow: none;
  }
  .enskri-btn-submit {
    background: #00209F; color: #fff;
    padding: 16px; font-size: 16px;
    font-family: 'Montserrat', sans-serif;
    min-height: 52px;
    animation: enskri-pulse 2s infinite;
    text-decoration: none !important;
  }
  .enskri-btn-submit:hover {
    background: #001a80; color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(0,32,159,0.4);
  }
  @keyframes enskri-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(0,32,159,0.4); }
    50% { box-shadow: 0 0 0 8px rgba(0,32,159,0); }
  }
  .enskri-btn-submit.enskri-btn-incomplete {
    background: #9CA3AF; color: #fff; opacity: 1;
    animation: none; transform: none; box-shadow: none;
  }
  .enskri-field-error { color: #B91C1C; font-size: 12px; font-weight: 500; margin-top: 4px; }
  .enskri-error {
    background: #FEF2F2; color: #991B1B;
    border: 1px solid #FECACA; border-radius: 8px;
    padding: 10px 14px; font-size: 13px;
    font-weight: 500; margin-bottom: 16px;
  }
  .enskri-social-proof {
    display: flex; align-items: center; justify-content: center;
    gap: 10px; padding: 12px 16px;
    background: #f0fdf4; border: 1px solid #bbf7d0;
    border-radius: 8px; margin-bottom: 20px;
    font-size: 13px; font-weight: 600; color: #166534;
  }
  .enskri-social-avatars { display: flex; margin-right: 4px; }
  .enskri-avatar {
    width: 28px; height: 28px; border-radius: 50%;
    background: #00209F; color: #fff;
    font-size: 11px; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    border: 2px solid #f0fdf4; margin-left: -8px;
  }
  .enskri-avatar:first-child { margin-left: 0; }
  @media (max-width: 576px) {
    /* Phones: a card over the dimmed page (not full-screen white). */
    #enskriModal { --bs-modal-margin: 12px; }
    #enskriModal .modal-dialog { max-width: none !important; }
    #enskriModal .modal-body { max-height: calc(100vh - 170px); }
  }
</style>

<%# ═══════════ JS: Modal Logic ═══════════ %>
<script>
  var countrySectors = <%= PartnerSectorConstants::COUNTRY_REQUIRED_SECTORS.to_json.html_safe %>;
  var modalData = document.getElementById('enskriModal').dataset;

  /* ── Validation (live; submit enabled only when complete) ── */
  function enskriShowError(msg) {
    var errDiv = document.getElementById('enskri-form-error');
    errDiv.querySelector('span').textContent = msg || '';
    errDiv.style.display = msg ? 'block' : 'none';
  }

  // Every missing/invalid field at once: [{ id: field to mark, msg }]
  function enskriErrors() {
    var errs = [];
    var val = function(id) { return document.getElementById(id).value.trim(); };
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val('modal_email'))) errs.push({ id: 'modal_email', msg: modalData.errorEmail });

    if (val('modal_signup_type') === 'business') {
      var sector = val('modal_sector');
      if (!val('modal_org_name')) errs.push({ id: 'modal_org_name', msg: modalData.errorOrg });
      if (!sector) errs.push({ id: 'modal_sector', msg: modalData.errorSector });
      if (countrySectors.includes(sector) && !val('modal_sector_country')) errs.push({ id: 'modal_sector_country', msg: modalData.errorCountry });
      if (sector === 'pnh' && !(val('modal_unit_type') && val('modal_unit_name'))) {
        errs.push({ id: val('modal_unit_type') ? 'modal_unit_name' : 'modal_unit_type', msg: modalData.errorUnit });
      }
      return errs;
    }

    // Individuals: where they live
    if (val('modal_diaspora') === '1') {
      if (!val('modal_us_state')) errs.push({ id: 'modal_us_state', msg: modalData.errorState });
      else if (!val('modal_us_city')) errs.push({ id: 'modal_us_city', msg: modalData.errorCity });
    } else if (!val('modal_commune')) {
      errs.push({ id: val('modal_dept') ? 'modal_commune' : 'modal_dept', msg: modalData.errorCommune });
    }
    return errs;
  }

  // Fields the visitor has left (or all of them after a submit attempt) show
  // their error; untouched ones stay quiet. Submit is enabled only when
  // nothing is missing.
  var enskriTouched = {};
  var enskriSubmitTried = false;

  function enskriRefresh() {
    var errs = enskriErrors();
    var form = document.getElementById('enskri-form');
    form.querySelectorAll('.is-invalid').forEach(function(el) { el.classList.remove('is-invalid'); });
    form.querySelectorAll('.enskri-field-error').forEach(function(el) { el.remove(); });
    errs.forEach(function(e) {
      if (!enskriSubmitTried && !enskriTouched[e.id]) return;
      var el = document.getElementById(e.id);
      el.classList.add('is-invalid');
      var msg = document.createElement('div');
      msg.className = 'enskri-field-error';
      msg.textContent = e.msg;
      (el.closest('.col-12, .col-md-6, .mb-3') || el.parentNode).appendChild(msg);
    });
    // Looks disabled but stays clickable: a click on it shows every missing
    // field instead of doing nothing.
    var btn = form.querySelector('.enskri-btn-submit');
    btn.classList.toggle('enskri-btn-incomplete', errs.length > 0);
    btn.setAttribute('aria-disabled', errs.length > 0 ? 'true' : 'false');
    return errs;
  }

  function enskriValidate() {
    enskriShowError(null);
    enskriSubmitTried = true;
    var errs = enskriRefresh();
    if (errs.length) document.getElementById(errs[0].id).focus();
    return errs.length === 0;
  }

  /* ── Social proof line ── */
  function enskriUpdateSocialProof() {
    var text = document.getElementById('enskri-social-text');
    var communeSel = document.getElementById('modal_commune');
    var selectedOpt = communeSel.options[communeSel.selectedIndex];
    var communeCount = selectedOpt ? parseInt(selectedOpt.dataset.signups) || 0 : 0;
    var communeName = selectedOpt && selectedOpt.value ? selectedOpt.textContent : '';
    var threshold = parseInt(modalData.socialProofThreshold) || 0;
    var total = parseInt(modalData.totalSignups) || 0;

    if (communeName && communeCount >= threshold) {
      // Healthy local count — show the real number.
      text.textContent = modalData.socialProof.replace('COUNT', communeCount.toLocaleString()).replace('COMMUNE', communeName);
    } else if (communeName) {
      // Commune chosen but few signups — exclusivity framing, no fake number.
      text.textContent = modalData.socialProofFirst.replace('COMMUNE', communeName);
    } else {
      // No commune (e.g. diaspora) — honest national total for scale.
      text.textContent = modalData.socialProofTotal.replace('COUNT', total.toLocaleString());
    }
  }

  /* ── Type Toggle ── */
  function modalSetType(type) {
    document.getElementById('modal_signup_type').value = type;
    document.getElementById('modal-btn-citizen').classList.toggle('enskri-toggle-active', type === 'citizen');
    document.getElementById('modal-btn-business').classList.toggle('enskri-toggle-active', type === 'business');
    document.getElementById('modal-business-fields').style.display = type === 'business' ? 'block' : 'none';
    var sector = document.getElementById('modal_sector');
    if (type === 'citizen') sector.value = '';
    modalSectorChange(sector.value);
  }

  var unitOptions = <%= OfficerConstants::UNIT_OPTIONS.to_json.html_safe %>;

  function modalSectorChange(val) {
    // Both country pickers post country_of_residence; only the visible one
    // may be enabled, or the hidden blank one overwrites the real answer.
    var needsCountry = countrySectors.includes(val);
    document.getElementById('modal-sector-country').style.display = needsCountry ? 'block' : 'none';
    document.getElementById('modal_sector_country').disabled = !needsCountry;
    document.getElementById('modal-pnh-fields').style.display = val === 'pnh' ? 'block' : 'none';
    if (val !== 'pnh') {
      document.getElementById('modal_unit_type').value = '';
      var unitName = document.getElementById('modal_unit_name');
      unitName.innerHTML = '<option value="">' + modalData.choose + '</option>';
      unitName.disabled = true;
    }
  }

  function modalLoadUnitNames(unitType) {
    var sel = document.getElementById('modal_unit_name');
    sel.innerHTML = '<option value="">' + modalData.choose + '</option>';
    sel.disabled = true;
    if (!unitType || !unitOptions[unitType]) return;
    unitOptions[unitType].forEach(function(name) {
      var opt = document.createElement('option');
      opt.value = name;
      opt.textContent = name;
      sel.appendChild(opt);
    });
    sel.disabled = false;
  }

  /* ── Location Toggle: Haiti vs Abroad ── */
  function modalSetLocation(loc) {
    var btnH = document.getElementById('loc-btn-haiti');
    var btnA = document.getElementById('loc-btn-abroad');
    var haitiFields = document.getElementById('modal-haiti-fields');
    var abroadFields = document.getElementById('modal-abroad-fields');
    var diasporaField = document.getElementById('modal_diaspora');

    if (loc === 'haiti') {
      btnH.classList.add('enskri-toggle-active');
      btnA.classList.remove('enskri-toggle-active');
      haitiFields.style.display = 'block';
      abroadFields.style.display = 'none';
      diasporaField.value = '0';
      document.getElementById('modal_diaspora_country').disabled = true;
      modalCountryChange('');
    } else {
      btnA.classList.add('enskri-toggle-active');
      btnH.classList.remove('enskri-toggle-active');
      haitiFields.style.display = 'none';
      abroadFields.style.display = 'block';
      diasporaField.value = '1';
      var country = document.getElementById('modal_diaspora_country');
      country.disabled = false;
      modalCountryChange(country.value);
      document.getElementById('modal_dept').value = '';
      document.getElementById('modal-commune-wrap').style.display = 'none';
      var commune = document.getElementById('modal_commune');
      commune.innerHTML = '<option value="">' + modalData.choose + '</option>';
      commune.disabled = true;
      document.getElementById('modal-commune-status').innerHTML = '';
    }
    enskriUpdateSocialProof();
  }

  /* ── Abroad: United States State → City ── */
  function modalCountryChange(code) {
    var isUS = code === 'US';
    var state = document.getElementById('modal_us_state');
    document.getElementById('modal-us-fields').style.display = isUS ? '' : 'none';
    state.disabled = !isUS;
    if (!isUS) state.value = '';
    modalStateChange(state.value);
  }

  // City suggestions: the state's cities (curated diaspora cities first,
  // then every Census place) filtered as the visitor types. Any typed city
  // is still accepted.
  var usCityNames = [];
  var usCityActive = -1;

  function cityFold(str) {
    return (str || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
  }

  function modalStateChange(stateCode) {
    var wrap = document.getElementById('modal-us-city-wrap');
    var input = document.getElementById('modal_us_city');

    input.value = '';
    usCityNames = [];
    cityHideSuggest();
    wrap.style.display = stateCode ? '' : 'none';
    input.disabled = !stateCode;
    if (!stateCode) return;

    fetch('/enskri/us_cities?state=' + encodeURIComponent(stateCode))
      .then(function(r) { return r.json(); })
      .then(function(cities) {
        // Ignore a late answer for a state the visitor already changed
        if (document.getElementById('modal_us_state').value === stateCode) usCityNames = cities;
      })
      .catch(function() { /* suggestions are optional; typing still works */ });
  }

  function cityShowSuggest() {
    var input = document.getElementById('modal_us_city');
    var list = document.getElementById('modal-us-city-suggest');
    var q = cityFold(input.value);
    var starts = [], contains = [];
    for (var i = 0; i < usCityNames.length && starts.length < 8; i++) {
      var name = cityFold(usCityNames[i]);
      if (!q || name.indexOf(q) === 0) starts.push(usCityNames[i]);
      else if (contains.length < 8 && name.indexOf(q) > 0) contains.push(usCityNames[i]);
    }
    var matches = starts.concat(contains).slice(0, 8);

    list.innerHTML = '';
    usCityActive = -1;
    if (!matches.length || (matches.length === 1 && cityFold(matches[0]) === q)) { cityHideSuggest(); return; }
    matches.forEach(function(name, idx) {
      var li = document.createElement('li');
      li.id = 'modal-us-city-opt-' + idx;
      li.setAttribute('role', 'option');
      li.textContent = name;
      // mousedown fires before the input's blur, so the pick is not lost
      li.addEventListener('mousedown', function(e) { e.preventDefault(); cityPick(name); });
      list.appendChild(li);
    });
    list.hidden = false;
    input.setAttribute('aria-expanded', 'true');
  }

  function cityHideSuggest() {
    var list = document.getElementById('modal-us-city-suggest');
    var input = document.getElementById('modal_us_city');
    list.hidden = true;
    list.innerHTML = '';
    usCityActive = -1;
    input.setAttribute('aria-expanded', 'false');
    input.removeAttribute('aria-activedescendant');
  }

  function cityPick(name) {
    document.getElementById('modal_us_city').value = name;
    cityHideSuggest();
    enskriRefresh();
  }

  function cityMove(step) {
    var items = document.querySelectorAll('#modal-us-city-suggest li');
    if (!items.length) return;
    usCityActive = (usCityActive + step + items.length) % items.length;
    items.forEach(function(li, idx) { li.setAttribute('aria-selected', idx === usCityActive ? 'true' : 'false'); });
    items[usCityActive].scrollIntoView({ block: 'nearest' });
    document.getElementById('modal_us_city').setAttribute('aria-activedescendant', items[usCityActive].id);
  }

  document.addEventListener('DOMContentLoaded', function() {
    var input = document.getElementById('modal_us_city');
    if (!input) return;
    input.addEventListener('input', cityShowSuggest);
    input.addEventListener('focus', cityShowSuggest);
    input.addEventListener('blur', cityHideSuggest);
    input.addEventListener('keydown', function(e) {
      var open = !document.getElementById('modal-us-city-suggest').hidden;
      if (e.key === 'ArrowDown') { e.preventDefault(); open ? cityMove(1) : cityShowSuggest(); }
      else if (e.key === 'ArrowUp' && open) { e.preventDefault(); cityMove(-1); }
      else if (e.key === 'Enter' && open && usCityActive >= 0) {
        e.preventDefault(); // pick the highlighted city, don't submit the form
        cityPick(document.querySelectorAll('#modal-us-city-suggest li')[usCityActive].textContent);
      } else if (e.key === 'Escape' && open) {
        e.preventDefault();
        e.stopPropagation(); // close the list, not the whole modal
        cityHideSuggest();
      }
    });
  });

  /* ── Commune AJAX ── */
  function modalLoadCommunes(deptId) {
    // Commune appears only once a department is chosen
    document.getElementById('modal-commune-wrap').style.display = deptId ? '' : 'none';
    var sel = document.getElementById('modal_commune');
    sel.innerHTML = '<option value="">' + modalData.choose + '</option>';
    sel.disabled = true;
    document.getElementById('modal-commune-status').innerHTML = '';
    enskriUpdateSocialProof();
    if (!deptId) return;

    fetch('/enskri/communes?department_id=' + deptId)
      .then(function(r) { return r.json(); })
      .then(function(data) {
        data.forEach(function(c) {
          var badge = c.launched ? ' (' + modalData.activeLabel + ')' : '';
          var opt = document.createElement('option');
          opt.value = c.id;
          opt.textContent = c.name + badge;
          opt.dataset.launched = c.launched;
          opt.dataset.signups = c.signups || 0;
          sel.appendChild(opt);
        });
        sel.disabled = false;
        sel.onchange = function() {
          var opt = sel.options[sel.selectedIndex];
          var st = document.getElementById('modal-commune-status');
          if (opt && opt.dataset.launched === 'true') {
            st.innerHTML = '<span style="color:#1A936F;font-weight:600;"><i class="ri-checkbox-circle-fill"></i> ' + modalData.bonidAvailable + '</span>';
          } else if (opt && opt.value) {
            st.innerHTML = '<span style="color:#EDB95E;font-weight:600;"><i class="ri-time-line"></i> ' + modalData.comingSoon + '</span>';
          } else { st.innerHTML = ''; }
          enskriUpdateSocialProof();
        };
      });
  }

  /* ── Modal open triggers ── */
  document.addEventListener('DOMContentLoaded', function() {
    enskriUpdateSocialProof();

    // Re-check on every edit and toggle; mark a field touched once left
    var liveForm = document.getElementById('enskri-form');
    ['input', 'change', 'click', 'keyup'].forEach(function(evt) {
      liveForm.addEventListener(evt, function() { setTimeout(enskriRefresh, 0); });
    });
    liveForm.addEventListener('focusout', function(e) {
      if (e.target.id) enskriTouched[e.target.id] = true;
      setTimeout(enskriRefresh, 0);
    });
    enskriRefresh();
    document.getElementById('enskriModal').addEventListener('shown.bs.modal', enskriRefresh);

    if (window.location.hash === '#enskri' || modalData.autoOpen === '1' ||
        document.querySelector('#enskriModal .alert-danger')) {
      // Move it to <body> before showing (what the data-modal-portal hook
      // does on turbo:load, which runs after this), so it opens where it
      // will stay.
      var modalEl = document.getElementById('enskriModal');
      if (modalEl.parentElement !== document.body) document.body.appendChild(modalEl);
      bootstrap.Modal.getOrCreateInstance(modalEl).show();
    }

    document.getElementById('enskriModal').addEventListener('hidden.bs.modal', function() {
      enskriShowError(null);
      // Safety net: remove any stray backdrop / body lock Bootstrap left behind,
      // so the dimmed background can't linger after the modal closes.
      document.querySelectorAll('.modal-backdrop').forEach(function(el) { el.remove(); });
      document.body.classList.remove('modal-open');
      document.body.style.removeProperty('overflow');
      document.body.style.removeProperty('padding-right');
    });

    // Submit the form via fetch so validation errors render in place (modal
    // stays open, no reload). Falls back to a native submit on any failure.
    var enskriForm = document.getElementById('enskri-form');
    if (enskriForm) {
      enskriForm.addEventListener('submit', function(e) {
        e.preventDefault();
        // Stop the global-loading controller's native-submit handler from showing
        // its overlay — we handle this submission with fetch and never navigate.
        e.stopPropagation();
        if (!enskriValidate()) return;
        var banner = document.getElementById('enskri-error-banner');
        fetch(enskriForm.action, {
          method: 'POST',
          body: new FormData(enskriForm),
          headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data && data.ok && data.redirect) {
            window.location.href = data.redirect;
          } else if (banner) {
            banner.innerHTML = (data && data.error)
              ? '<div class="alert alert-danger alert-dismissible fade show" role="alert"><i class="ri-error-warning-line me-1"></i>' + data.error + '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>'
              : '';
          }
        })
        .catch(function() {
          // Network/parse failure → degrade to the reliable native submit.
          HTMLFormElement.prototype.submit.call(enskriForm);
        });
      });

      // Clear errors as soon as the user starts fixing the form.
      enskriForm.addEventListener('input', function() {
        enskriShowError(null);
        var b = document.getElementById('enskri-error-banner');
        if (b) b.innerHTML = '';
      });
    }
  });

  document.addEventListener('click', function(e) {
    var trigger = e.target.closest('[data-enskri]');
    if (trigger) {
      e.preventDefault();
      bootstrap.Modal.getOrCreateInstance(document.getElementById('enskriModal')).show();
      var type = trigger.dataset.enskri;
      if (type === 'citizen' || type === 'business') modalSetType(type);
    }
  });
</script>
