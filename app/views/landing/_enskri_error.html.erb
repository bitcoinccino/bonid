<%# Server-side error banner for the signup wizard. Replaced in place via
    Turbo Stream so the modal stays open. `message` may be nil (clears it). %>
<div id="enskri-error-banner">
  <% if message.present? %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="ri-error-warning-line me-1"></i><%= message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>
</div>
