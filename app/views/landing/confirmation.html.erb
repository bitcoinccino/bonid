<%# Waitlist confirmation — one goal: share your link. Rendered in the
    visitor's locale (en/fr/ht); copy lives in main.signup_confirmation. %>
<% c = ->(key, **opts) { t("main.signup_confirmation.#{key}", **opts) } %>
<% content_for :title, c.(:page_title) %>
<% share_text = c.(:share_text, url: @share_url) %>
<% commune_name = @commune&.name %>

<%# Same palette as the sign-up form people arrive from: Haitian-blue
    backdrop, content on a white card. %>
<section style="min-height: 100vh; background: #00209F; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px 16px; box-sizing: border-box;">
  <div style="max-width: 480px; width: 100%; text-align: center; background: #fff; border-radius: 20px; padding: 32px 24px; box-sizing: border-box;">

    <%# Success icon + title %>
    <div style="width: 72px; height: 72px; border-radius: 50%; background: #ECFDF5; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
      <i class="ri-checkbox-circle-fill" style="font-size: 40px; color: #16a34a;" aria-hidden="true"></i>
    </div>

    <h1 style="font-family: 'Montserrat', sans-serif; font-size: 28px; font-weight: 700; color: #00209F; margin: 0 0 8px;">
      <%= c.(:title) %>
    </h1>
    <p style="color: #4B5563; font-size: 15px; margin: 0 0 24px;">
      <% if @commune %>
        <%= c.(:subtitle_commune, commune: commune_name, department: @commune.department.name) %>
      <% else %>
        <%= c.(:subtitle) %>
      <% end %>
    </p>

    <%# Commune progress — the reason to share %>
    <div style="background: #ECFDF5; border: 1px solid #A7F3D0; border-radius: 12px; padding: 14px 18px; margin-bottom: 20px; text-align: left;">
      <% if @commune && @commune_count.to_i >= Commune::SOCIAL_PROOF_THRESHOLD %>
        <p style="color: #065F46; font-size: 15px; font-weight: 600; margin: 0 0 4px;">
          <i class="ri-map-pin-2-fill" style="color: #16a34a; margin-right: 6px;" aria-hidden="true"></i><%= c.(:count, commune: commune_name, count: number_with_delimiter(@commune_count)) %>
        </p>
      <% elsif @commune %>
        <p style="color: #065F46; font-size: 15px; font-weight: 600; margin: 0 0 4px;">
          <i class="ri-map-pin-2-fill" style="color: #16a34a; margin-right: 6px;" aria-hidden="true"></i><%= c.(:first, commune: commune_name) %>
        </p>
      <% elsif @commune_count.to_i >= Commune::SOCIAL_PROOF_THRESHOLD %>
        <p style="color: #065F46; font-size: 15px; font-weight: 600; margin: 0 0 4px;">
          <i class="ri-group-fill" style="color: #16a34a; margin-right: 6px;" aria-hidden="true"></i><%= c.(:total, count: number_with_delimiter(@commune_count)) %>
        </p>
      <% end %>
      <p style="color: #065F46; font-size: 14px; margin: 0;">
        <%= @commune ? c.(:nudge, commune: commune_name) : c.(:nudge_general) %>
      </p>
    </div>

    <% if @referrals_count.positive? %>
      <p style="color: #00209F; font-size: 15px; font-weight: 700; margin: 0 0 14px;">
        <i class="ri-user-heart-line" aria-hidden="true"></i> <%= c.(:referrals, count: @referrals_count) %>
      </p>
    <% end %>

    <%# One Share button; its menu offers copy / WhatsApp / message / X %>
    <div class="share-wrap" style="position: relative; margin-bottom: 28px;">
      <button type="button" id="share-btn" aria-haspopup="true" aria-expanded="false" aria-controls="share-menu"
              style="display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; background: #00209F; color: #fff; border: none; padding: 15px 20px; border-radius: 12px; font-weight: 700; font-size: 16px; font-family: 'Montserrat', sans-serif; cursor: pointer;">
        <i class="ri-share-forward-line" style="font-size: 20px;" aria-hidden="true"></i> <%= c.(:share) %>
      </button>

      <div id="share-menu" role="menu" hidden
           style="position: absolute; top: calc(100% + 8px); left: 0; right: 0; z-index: 10; background: #fff; border: 1px solid #E2E8F0; border-radius: 12px; padding: 6px; text-align: left; box-shadow: 0 8px 20px rgba(15, 23, 42, 0.10);">
        <button type="button" role="menuitem" class="share-item" id="share-copy"
                data-url="<%= @share_url %>" data-label="<%= c.(:copy) %>" data-copied="<%= c.(:copied) %>">
          <i class="ri-file-copy-line" style="color: #00209F;" aria-hidden="true"></i> <span><%= c.(:copy) %></span>
        </button>
        <a role="menuitem" class="share-item" target="_blank" rel="noopener"
           href="https://wa.me/?text=<%= ERB::Util.url_encode(share_text) %>">
          <i class="ri-whatsapp-line" style="color: #25D366;" aria-hidden="true"></i> WhatsApp
        </a>
        <a role="menuitem" class="share-item" href="sms:?&body=<%= ERB::Util.url_encode(share_text) %>">
          <i class="ri-message-2-line" style="color: #6366f1;" aria-hidden="true"></i> <%= c.(:message) %>
        </a>
        <a role="menuitem" class="share-item" target="_blank" rel="noopener"
           href="https://twitter.com/intent/tweet?text=<%= ERB::Util.url_encode(share_text) %>">
          <i class="ri-twitter-x-line" style="color: #111827;" aria-hidden="true"></i> X (Twitter)
        </a>
      </div>
    </div>

    <%# What happens next %>
    <div style="border-top: 1px solid #E5E7EB; padding-top: 20px; text-align: left;">
      <p style="color: #111827; font-size: 14px; font-weight: 600; margin: 0 0 10px;"><%= c.(:next_title) %></p>
      <p style="color: #374151; font-size: 14px; margin: 0 0 8px; display: flex; gap: 8px;">
        <i class="ri-mail-check-line" style="color: #00209F;" aria-hidden="true"></i>
        <span><%= c.(:next_email, email: @masked_email) %></span>
      </p>
      <p style="color: #374151; font-size: 14px; margin: 0; display: flex; gap: 8px;">
        <i class="ri-notification-3-line" style="color: #00209F;" aria-hidden="true"></i>
        <span><%= @commune ? c.(:next_launch_commune, commune: commune_name) : c.(:next_launch) %></span>
      </p>
    </div>

  </div>

  <%= link_to root_path, style: "color: #fff; opacity: 0.85; font-size: 14px; text-decoration: none; margin-top: 20px;" do %>
    <i class="ri-arrow-left-line" aria-hidden="true"></i> <%= c.(:back) %>
  <% end %>
</section>

<style>
  .share-item {
    display: flex; align-items: center; gap: 12px; width: 100%;
    padding: 12px 14px; border: none; border-radius: 8px; background: none;
    color: #111827; font-size: 15px; font-weight: 600; text-decoration: none; cursor: pointer;
  }
  .share-item i { font-size: 20px; }
  .share-item:hover, .share-item:focus-visible { background: #EEF2FF; color: #00209F; outline: none; }
</style>

<script>
  (function () {
    var btn = document.getElementById('share-btn');
    var menu = document.getElementById('share-menu');
    var copy = document.getElementById('share-copy');
    if (!btn || !menu) return;

    function setOpen(open) {
      menu.hidden = !open;
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) menu.querySelector('.share-item').focus();
    }

    btn.addEventListener('click', function () { setOpen(menu.hidden); });
    document.addEventListener('click', function (e) {
      if (!menu.hidden && !menu.contains(e.target) && e.target !== btn && !btn.contains(e.target)) setOpen(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !menu.hidden) { setOpen(false); btn.focus(); }
    });
    // Close after picking WhatsApp / Message / X
    menu.querySelectorAll('a.share-item').forEach(function (a) {
      a.addEventListener('click', function () { setOpen(false); });
    });

    // Copy link: shows "Copied!" briefly, keeps the menu open so it is seen
    var label = copy.querySelector('span');
    function copied() {
      label.textContent = copy.dataset.copied;
      setTimeout(function () { label.textContent = copy.dataset.label; setOpen(false); }, 1200);
    }
    copy.addEventListener('click', function () {
      var url = copy.dataset.url;
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(url).then(copied);
      } else {
        var ta = document.createElement('textarea');
        ta.value = url;
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); copied(); } catch (e) {}
        document.body.removeChild(ta);
      }
    });
  })();
</script>
