<%# Waitlist confirmation — one goal: share your link. Rendered in the
    visitor's locale (en/fr/ht); copy lives in main.signup_confirmation. %>
<% c = ->(key, **opts) { t("main.signup_confirmation.#{key}", **opts) } %>
<% content_for :title, c.(:page_title) %>
<% share_text = c.(:share_text, url: @share_url) %>
<% commune_name = @commune&.name %>

<%# Same palette as the sign-up form people arrive from: Haitian-blue
    backdrop, content on a white card. %>
<section style="min-height: 100vh; background: #00209F; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px 16px; box-sizing: border-box;">
  <div style="max-width: 480px; width: 100%; text-align: center; background: #fff; border-radius: 20px; padding: 32px 24px; box-sizing: border-box; box-shadow: 0 24px 64px rgba(0, 0, 0, 0.35);">

    <%# Success icon + title %>
    <div style="width: 72px; height: 72px; border-radius: 50%; background: #ECFDF5; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
      <i class="ri-checkbox-circle-fill" style="font-size: 40px; color: #16a34a;" aria-hidden="true"></i>
    </div>

    <h1 style="font-family: 'Montserrat', sans-serif; font-size: 28px; font-weight: 700; color: #00209F; margin: 0 0 8px;">
      <%= c.(:title) %>
    </h1>
    <p style="color: #4B5563; font-size: 15px; margin: 0 0 24px;">
      <% if @commune %>
        <%= c.(:subtitle_commune, commune: commune_name, department: @commune.department.name) %>
      <% else %>
        <%= c.(:subtitle) %>
      <% end %>
    </p>

    <%# Commune progress — the reason to share %>
    <div style="background: #ECFDF5; border: 1px solid #A7F3D0; border-radius: 12px; padding: 14px 18px; margin-bottom: 20px; text-align: left;">
      <% if @commune && @commune_count.to_i >= Commune::SOCIAL_PROOF_THRESHOLD %>
        <p style="color: #065F46; font-size: 15px; font-weight: 600; margin: 0 0 4px;">
          <i class="ri-map-pin-2-fill" style="color: #16a34a; margin-right: 6px;" aria-hidden="true"></i><%= c.(:count, commune: commune_name, count: number_with_delimiter(@commune_count)) %>
        </p>
      <% elsif @commune %>
        <p style="color: #065F46; font-size: 15px; font-weight: 600; margin: 0 0 4px;">
          <i class="ri-map-pin-2-fill" style="color: #16a34a; margin-right: 6px;" aria-hidden="true"></i><%= c.(:first, commune: commune_name) %>
        </p>
      <% elsif @commune_count.to_i >= Commune::SOCIAL_PROOF_THRESHOLD %>
        <p style="color: #065F46; font-size: 15px; font-weight: 600; margin: 0 0 4px;">
          <i class="ri-group-fill" style="color: #16a34a; margin-right: 6px;" aria-hidden="true"></i><%= c.(:total, count: number_with_delimiter(@commune_count)) %>
        </p>
      <% end %>
      <p style="color: #065F46; font-size: 14px; margin: 0;">
        <%= @commune ? c.(:nudge, commune: commune_name) : c.(:nudge_general) %>
      </p>
    </div>

    <% if @referrals_count.positive? %>
      <p style="color: #00209F; font-size: 15px; font-weight: 700; margin: 0 0 14px;">
        <i class="ri-user-heart-line" aria-hidden="true"></i> <%= c.(:referrals, count: @referrals_count) %>
      </p>
    <% end %>

    <%# Primary: WhatsApp %>
    <a href="https://wa.me/?text=<%= ERB::Util.url_encode(share_text) %>"
       target="_blank" rel="noopener"
       style="display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; box-sizing: border-box; background: #25D366; color: #fff; padding: 15px 20px; border-radius: 12px; text-decoration: none; font-weight: 700; font-size: 16px; font-family: 'Montserrat', sans-serif; margin-bottom: 14px;">
      <i class="ri-whatsapp-line" style="font-size: 22px;" aria-hidden="true"></i> <%= c.(:whatsapp) %>
    </a>

    <%# Link + copy %>
    <label for="share-link" style="display: block; text-align: left; color: #6B7280; font-size: 12px; margin: 0 0 6px;"><%= c.(:link_label) %></label>
    <div style="display: flex; gap: 8px; margin-bottom: 14px;">
      <input id="share-link" type="text" readonly value="<%= @share_url %>"
             style="flex: 1; min-width: 0; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 10px; padding: 12px; color: #374151; font-size: 13px; font-family: monospace;"
             onclick="this.select()">
      <button type="button" id="copy-btn"
              data-label="<%= c.(:copy) %>" data-copied="<%= c.(:copied) %>"
              style="flex-shrink: 0; background: #00209F; color: #fff; border: none; padding: 0 16px; border-radius: 10px; font-weight: 600; cursor: pointer; font-size: 14px; white-space: nowrap;">
        <i class="ri-file-copy-line" aria-hidden="true"></i> <span><%= c.(:copy) %></span>
      </button>
    </div>

    <%# Secondary shares %>
    <div style="display: flex; gap: 10px; justify-content: center; margin-bottom: 28px;">
      <a href="sms:?&body=<%= ERB::Util.url_encode(share_text) %>"
         style="display: inline-flex; align-items: center; gap: 6px; background: #fff; border: 1px solid #D1D5DB; color: #374151; padding: 9px 20px; border-radius: 10px; text-decoration: none; font-weight: 600; font-size: 13px;">
        <i class="ri-message-2-line" aria-hidden="true"></i> SMS
      </a>
      <a href="https://twitter.com/intent/tweet?text=<%= ERB::Util.url_encode(share_text) %>"
         target="_blank" rel="noopener"
         style="display: inline-flex; align-items: center; gap: 6px; background: #fff; border: 1px solid #D1D5DB; color: #374151; padding: 9px 20px; border-radius: 10px; text-decoration: none; font-weight: 600; font-size: 13px;">
        <i class="ri-twitter-x-line" aria-hidden="true"></i> X
      </a>
    </div>

    <%# What happens next %>
    <div style="border-top: 1px solid #E5E7EB; padding-top: 20px; text-align: left;">
      <p style="color: #111827; font-size: 14px; font-weight: 600; margin: 0 0 10px;"><%= c.(:next_title) %></p>
      <p style="color: #374151; font-size: 14px; margin: 0 0 8px; display: flex; gap: 8px;">
        <i class="ri-mail-check-line" style="color: #00209F;" aria-hidden="true"></i>
        <span><%= c.(:next_email, email: @masked_email) %></span>
      </p>
      <p style="color: #374151; font-size: 14px; margin: 0; display: flex; gap: 8px;">
        <i class="ri-notification-3-line" style="color: #00209F;" aria-hidden="true"></i>
        <span><%= @commune ? c.(:next_launch_commune, commune: commune_name) : c.(:next_launch) %></span>
      </p>
    </div>

  </div>

  <%= link_to root_path, style: "color: #fff; opacity: 0.85; font-size: 14px; text-decoration: none; margin-top: 20px;" do %>
    <i class="ri-arrow-left-line" aria-hidden="true"></i> <%= c.(:back) %>
  <% end %>
</section>

<script>
  (function () {
    var btn = document.getElementById('copy-btn');
    var input = document.getElementById('share-link');
    if (!btn || !input) return;
    var label = btn.querySelector('span');

    function done() {
      label.textContent = btn.dataset.copied;
      btn.style.background = '#16a34a';
      setTimeout(function () {
        label.textContent = btn.dataset.label;
        btn.style.background = '#00209F';
      }, 2000);
    }

    btn.addEventListener('click', function () {
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(input.value).then(done);
      } else {
        input.select();
        try { document.execCommand('copy'); done(); } catch (e) {}
      }
    });
  })();
</script>
