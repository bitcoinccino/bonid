<div class="container py-4">
  <h1 class="h3 fw-bold mb-4">Reviewer Dashboard</h1>

  <div class="row g-3">
    <div class="col-md-3">
      <div class="card shadow-sm p-3 text-center">
        <h5>Pending</h5>
        <h2 class="text-warning"><%= @pending %></h2>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card shadow-sm p-3 text-center">
        <h5>Approved</h5>
        <h2 class="text-success"><%= @approved %></h2>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card shadow-sm p-3 text-center">
        <h5>Rejected</h5>
        <h2 class="text-danger"><%= @rejected %></h2>
      </div>
    </div>
  </div>

  <h3 class="h5 mt-4 fw-bold">Recent Submissions</h3>
  <%= render "reviewers/shared/submission_table", submissions: @recent %>
</div>
