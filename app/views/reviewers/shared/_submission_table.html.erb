<table class="table table-hover align-middle">
  <thead>
    <tr>
      <th>BonID</th>
      <th>User</th>
      <th>Status</th>
      <th>Submitted</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% submissions.each do |s| %>
      <tr>
        <td><%= s.bonid %></td>
        <td><%= s.user.full_name %></td>
        <td><%= s.status.humanize %></td>
        <td><%= time_ago_in_words(s.created_at) %> ago</td>
        <td>
          <%= link_to "View", reviewers_identity_submission_path(s), class: "btn btn-sm btn-primary" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
