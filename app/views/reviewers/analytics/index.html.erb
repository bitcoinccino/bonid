<div class="container py-4">
  <h1 class="h3 fw-bold mb-3">Analytics</h1>

  <div class="card shadow-sm p-4 mb-4">
    <h5 class="fw-semibold mb-3">Review Activity</h5>
    <pre><%= @reviews_per_day.to_json %></pre>
  </div>

  <div class="row g-4">
    <div class="col-md-6">
      <div class="card shadow-sm p-4 text-center">
        <h4 class="fw-bold"><%= @approval_rate %></h4>
        <p class="text-muted">Approved</p>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card shadow-sm p-4 text-center">
        <h4 class="fw-bold"><%= @rejection_rate %></h4>
        <p class="text-muted">Rejected</p>
      </div>
    </div>
  </div>
</div>
