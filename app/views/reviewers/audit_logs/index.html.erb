<div class="container py-4">
  <h1 class="h3 fw-bold mb-3">Audit Logs</h1>

  <% @logs.each do |log| %>
    <div class="card shadow-sm p-3 mb-3">
      <p class="fw-semibold mb-1"><%= log.event %></p>
      <p class="small mb-0 text-muted"><%= log.details %></p>
      <small class="text-muted"><%= log.created_at.strftime("%Y-%m-%d %H:%M") %></small>
    </div>
  <% end %>
</div>
